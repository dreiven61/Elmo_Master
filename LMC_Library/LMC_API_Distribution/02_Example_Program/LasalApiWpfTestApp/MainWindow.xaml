                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity (raw DINT)" />
                                            <TextBox x:Name="TextQualificationVelocity" Text="10000" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Acceleration (raw DINT)" />
                                            <TextBox x:Name="TextQualificationAcceleration" Text="100000" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Deceleration / Stop (raw DINT)" />
                                            <TextBox x:Name="TextQualificationDeceleration" Text="100000" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Jerk (raw DINT)" />
