<Window
    x:Class="LasalMotionControlApiExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LASAL Motion Control API Example [Generic SDO Write / LIVE Diagnostics]"
    Width="1180"
    Height="860"
    MinWidth="980"
    MinHeight="720"
    FontFamily="Segoe UI"
    Closed="Window_TopologyIoClosed"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#445066" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,10">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Top"
                DockPanel.Dock="Right">
                <TextBlock
                    Style="{StaticResource FieldLabel}"
                    Text="Language" />
                <ComboBox
                    x:Name="ComboUiLanguage"
                    MinWidth="120"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="ComboUiLanguage_SelectionChanged" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="LASAL Motion Control API Example" />
                <TextBlock
                    Margin="0,3,0,0"
                    Foreground="#55657A"
                    Text="Motion controls remain PLC-active. Diagnostics controls are enabled only after the PLC advertises the required capability. Values use the selected application UNIT or pass through as raw DINT." />
            </StackPanel>
        </DockPanel>

        <Grid
            x:Name="GridWorkspaceLayout"
            Grid.Row="1"
            ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Connection / RPC callback">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PLC IP" />
                    <TextBox x:Name="TextRemoteIp" Text="10.10.150.1" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TCP port" />
                    <TextBox x:Name="TextRemotePort" Width="90" Text="4000" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PC local IPv4" />
                    <TextBox x:Name="TextLocalIp" Text="10.10.150.13" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Callback UDP port" />
                    <TextBox x:Name="TextCallbackPort" Width="100" Text="5000" />
                </StackPanel>

                <Button
                    x:Name="ButtonConnect"
                    Grid.Row="0"
                    Grid.Column="4"
                    VerticalAlignment="Bottom"
                    Click="ButtonConnect_Click"
                    Content="Connect" />
                <Button
                    x:Name="ButtonCloseConnection"
                    Grid.Row="0"
                    Grid.Column="5"
                    VerticalAlignment="Bottom"
                    Click="ButtonCloseConnection_Click"
                    Content="Close" />

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Connection state" />
                    <TextBlock
                        x:Name="TextConnectionState"
                        Style="{StaticResource ValueText}"
                        Text="Disconnected" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="7">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Callback listener" />
                    <TextBlock
                        x:Name="TextCallbackState"
                        Width="230"
                        Style="{StaticResource ValueText}"
                        Text="Stopped"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Expander
                    x:Name="ExpanderRpcCallbackEvidence"
                    Grid.Row="1"
                    Grid.ColumnSpan="8"
                    Margin="0,8,0,0"
                    Header="RPC initialization / callback evidence"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="RPC initialization evidence" />
                            <TextBlock
                                x:Name="TextRpcInitialization"
                                Style="{StaticResource ValueText}"
                                Tag="UiLocalization.Preserve"
                                Text="No RPC initialization attempt"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Callback v2 registration" />
                            <TextBlock
                                x:Name="TextCallbackRegistration"
                                Style="{StaticResource ValueText}"
                                Tag="UiLocalization.Preserve"
                                Text="Not registered"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PC callback receiver evidence" />
                            <TextBlock
                                x:Name="TextCallbackCounters"
                                Style="{StaticResource ValueText}"
                                Tag="UiLocalization.Preserve"
                                Text="Accepted=0, Rejected=0, Duplicate=0, OutOfOrder=0"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TextCallbackLastDecision"
                                Foreground="#5F6B7A"
                                Tag="UiLocalization.Preserve"
                                Text="Last decision=None"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Foreground="#5F6B7A"
                            Text="Connect performs RPC session initialization and callback registration automatically. UDP wake hints are non-authoritative; operation state changes only after the matching TCP status response."
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander>
            </Grid>
        </GroupBox>

        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="12,9"
            Background="#FFF6DF"
            BorderBrush="#E0B34B"
            BorderThickness="1"
            CornerRadius="4">
            <Expander
                x:Name="ExpanderSafetyAndRecoveryDetails"
                Header="Safety / recovery details"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
                <StackPanel Margin="0,7,0,0">
                    <TextBlock
                        x:Name="TextMotionWarning"
                        VerticalAlignment="Center"
                        Foreground="#8A4A00"
                        Text="Power On, Reset, motion, and group preparation commands are sent immediately without a confirmation dialog. Stop and axis Power Off remain available while connected. Closing the connection does not stop motion."
                        TextWrapping="Wrap" />
                    <Border
                        x:Name="PanelRecoveryIdentityRetirement"
                        Margin="0,9,0,0"
                        Padding="10"
                        Background="#FFFFFBF0"
                        BorderBrush="#D59A22"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Archive and retire stale recovery evidence"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="TextRecoveryIdentityRetirementSnapshot"
                                Height="112"
                                Margin="0,7,0,6"
                                FontFamily="Consolas"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="No stale recovery snapshot is available."
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                            <CheckBox
                                x:Name="CheckConfirmStaleRecoveryRetirement"
                                Margin="0,3,0,8"
                                Checked="RecoveryIdentityRetirementConfirmation_Changed"
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="False"
                                Unchecked="RecoveryIdentityRetirementConfirmation_Changed">
                                <CheckBox.Content>
                                    <TextBlock
                                        Text="I independently verified the machine and drive physical state. I accept that every listed old-PLC command outcome remains unknown, and I want to archive and retire only the listed stale recovery records."
                                        TextWrapping="Wrap" />
                                </CheckBox.Content>
                            </CheckBox>
                            <Button
                                x:Name="ButtonArchiveAndRetireStaleRecovery"
                                HorizontalAlignment="Left"
                                Click="ButtonArchiveAndRetireStaleRecovery_Click"
                                Content="Archive and Retire Stale Recovery"
                                IsEnabled="False"
                                ToolTip="No PLC command is sent. The current RPC connection must close, and a fresh reconnect must validate the current PLC identity before control or write is permitted." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>

        <TabControl
            x:Name="TabsMotion"
            Grid.Row="2"
            Margin="0,0,0,5"
            SelectionChanged="MotionTabs_SelectionChanged">
            <TabItem Header="Single Axis">
                <ScrollViewer
                    x:Name="ScrollSingleAxis"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Axis object">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LASAL object name" />
                                    <DockPanel>
                                        <Button
                                            x:Name="ButtonLookupAxis"
                                            DockPanel.Dock="Right"
                                            Click="ButtonLookupAxis_Click"
                                            Content="Load Axis" />
                                        <TextBox
                                            x:Name="TextAxisName"
                                            Text="_LMCAxis1"
                                            TextChanged="TextAxisName_TextChanged" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Axis reference:" />
                                        <TextBlock
                                            x:Name="TextAxisReference"
                                            Margin="8,0,0,0"
                                            FontWeight="SemiBold"
                                            Text="not loaded" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Read / control">
                                <WrapPanel>
                                    <Button
                                        x:Name="ButtonReadStatus"
                                        Click="ButtonReadStatus_Click"
                                        Content="Read Status" />
                                    <Button
                                        x:Name="ButtonReadPosition"
                                        Click="ButtonReadPosition_Click"
                                        Content="Read Position" />
                                    <Button
                                        x:Name="ButtonPowerOn"
                                        Click="ButtonPowerOn_Click"
                                        Content="Power On" />
                                    <Button
                                        x:Name="ButtonPowerOff"
                                        Click="ButtonPowerOff_Click"
                                        Content="Power Off" />
                                    <Button
                                        x:Name="ButtonReset"
                                        Click="ButtonReset_Click"
                                        Content="Reset" />
                                    <Button
                                        x:Name="ButtonStop"
                                        Click="ButtonStop_Click"
                                        Content="Stop" />
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Header="Latest axis result">
                                <TextBox
                                    x:Name="TextAxisResult"
                                    MinHeight="130"
                                    IsReadOnly="True"
                                    Text="Load an axis object, then start with Read Status."
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <GroupBox Header="Engineering values">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLC application UNIT" />
                                        <ComboBox x:Name="ComboAxisUnit" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Position / distance" />
                                        <TextBox
                                            x:Name="TextPosition"
                                            Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity" />
                                        <TextBox
                                            x:Name="TextVelocity"
                                            Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Acceleration" />
                                        <TextBox
                                            x:Name="TextAcceleration"
                                            Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Deceleration / Stop" />
                                        <TextBox
                                            x:Name="TextDeceleration"
                                            Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jerk (axis unit/s^3/1000)" />
                                        <TextBox
                                            x:Name="TextJerk"
                                            Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity direction" />
                                        <ComboBox
                                            x:Name="ComboDirection" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,8"
                                        VerticalAlignment="Center"
                                        Foreground="#5F6B7A"
                                        Text="PC values use mm (x10000); the saved axis transmission is 8388608 counts per 10 mm. Re-reference after downloading the new scale. None / raw DINT sends an already converted integer. Velocity/acceleration/deceleration must be positive. Enter physical jerk / 1000; the UI applies the selected UNIT."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Motion">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button
                                            x:Name="ButtonMoveAbsolute"
                                            Click="ButtonMoveAbsolute_Click"
                                            Content="Move Absolute" />
                                        <Button
                                            x:Name="ButtonMoveRelative"
                                            Click="ButtonMoveRelative_Click"
                                            Content="Move Relative" />
                                        <Button
                                            x:Name="ButtonMoveVelocity"
                                            Click="ButtonMoveVelocity_Click"
                                            Content="Move Velocity" />
                                    </WrapPanel>
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="Absolute/Relative use Shortest. Relative direction comes from the distance sign. Velocity runs until Stop or PowerOff is verified."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Home (explicit one-shot actions)">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="Both Home routes set the current coordinate to zero without physical motion, a Home switch, or a limit switch. Refresh capabilities and verify the exact stationary axis before the one-shot confirmation."
                                        TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button
                                            x:Name="ButtonRefreshHomeCapabilities"
                                            Click="ButtonRefreshMaintenanceCapabilities_Click"
                                            Content="Refresh Home Capabilities" />
                                        <Button
                                            x:Name="ButtonReadHomeStatus"
                                            Click="ButtonReadHomeStatus_Click"
                                            Content="Read Home Status (no replay)" />
                                    </WrapPanel>

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        Text="LMC Home - Current Position Zero (0x7D13)" />
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="The app reads the current actual position as an exact stale-read guard, then requests TargetPosition=0. Start acceptance is not completion; Read Home Status queries the retained 0x7D18 outcome and retires a terminal record with 0x7D19."
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <StackPanel Width="135">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout (ms)" />
                                            <TextBox x:Name="TextLmcHomeTimeout" Text="5000" TextChanged="MaintenanceInput_Changed" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        Text="DS402 Home (0x7D15)" />
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="This route is fixed to DS402 method 37 and Home offset 0. Method 37 takes the current position as Home without enabling motion or seeking a switch; offset 0 makes the completed actual position zero."
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <StackPanel Width="230">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fixed semantic" />
                                            <TextBlock Text="Method=37; HomeOffset=0; no motion" />
                                        </StackPanel>
                                        <StackPanel Width="135">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout (ms)" />
                                            <TextBox x:Name="TextDs402HomeTimeout" Text="60000" TextChanged="MaintenanceInput_Changed" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <CheckBox
                                        x:Name="CheckHomeOneShotConfirmed"
                                        Margin="0,4,0,0"
                                        Checked="MaintenanceConfirmation_Changed"
                                        Unchecked="MaintenanceConfirmation_Changed">
                                        <CheckBox.Content>
                                            <TextBlock
                                                Text="I verified the exact stationary axis, its current actual position, raw units, and the coordinate-zero effect. Send the selected Home route once only and never replay it after an uncertain result."
                                                TextWrapping="Wrap" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button x:Name="ButtonLmcHome" Click="ButtonLmcHome_Click" Content="Execute LMC Home Once" />
                                        <Button x:Name="ButtonDs402Home" Click="ButtonDs402Home_Click" Content="Execute DS402 Home Once" />
                                    </WrapPanel>
                                    <TextBlock
                                        x:Name="TextHomeResult"
                                        Margin="0,4,0,0"
                                        FontFamily="Consolas"
                                        Text="No Home action has been sent."
                                        TextWrapping="Wrap" />
                                    <Border Margin="0,6,0,0" Padding="6" Background="#FFF7E6" BorderBrush="#E6B85C" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock
                                                x:Name="TextMaintenanceRecoveryStatus"
                                                FontFamily="Consolas"
                                                Text="Opening the durable Home/encoder-maintenance recovery journal..."
                                                TextWrapping="Wrap" />
                                            <CheckBox
                                                x:Name="CheckMaintenanceRecoveryPhysicallyVerified"
                                                Checked="MaintenanceRecoveryConfirmation_Changed"
                                                Content="I independently verified the physical axis/drive state and understand that resolving this record sends no command and does not prove the previous action result."
                                                IsEnabled="False"
                                                Unchecked="MaintenanceRecoveryConfirmation_Changed" />
                                            <Button
                                                x:Name="ButtonResolveMaintenanceRecovery"
                                                HorizontalAlignment="Left"
                                                Click="ButtonResolveMaintenanceRecovery_Click"
                                                Content="Resolve Recovery Record (no command)"
                                                IsEnabled="False" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Single Axis live qualification (Power / relative Move / Stop / Power Off)">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="LIVE AXIS MOTION. This runner sends real 0x2023, 0x20A0, 0x2022, and 0x2023 commands. Stop is sent after the planned move reaches standstill; it proves accepted-once/stable Stop handling, not an in-motion halt."
                                        TextWrapping="Wrap" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Relative delta (raw DINT, nonzero, |value| &lt;= 1000000)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationDelta"
                                                Text="10000"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity (raw DINT, positive)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationVelocity"
                                                Text="10000"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Acceleration (raw DINT, positive)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationAcceleration"
                                                Text="100000"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Deceleration / Stop (raw DINT, positive)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationDeceleration"
                                                Text="100000"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Jerk (raw DINT; first live slice requires 0)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationJerk"
                                                Text="0"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Final position tolerance (raw DINT, positive)" />
                                            <TextBox
                                                x:Name="TextAxisQualificationTolerance"
                                                Text="100"
                                                TextChanged="AxisQualificationInput_Changed" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox
                                        x:Name="CheckAxisQualificationTravelSafe"
                                        Margin="0,4,0,0"
                                        Checked="AxisQualificationSafetyConfirmation_Changed"
                                        Unchecked="AxisQualificationSafetyConfirmation_Changed">
                                        <CheckBox.Content>
                                            <TextBlock
                                                Text="I verified E-stop/STO, software limits, and clear travel for this exact nonzero relative delta."
                                                TextWrapping="Wrap" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="CheckAxisQualificationIdentitySafe"
                                        Checked="AxisQualificationSafetyConfirmation_Changed"
                                        Unchecked="AxisQualificationSafetyConfirmation_Changed">
                                        <CheckBox.Content>
                                            <TextBlock
                                                Text="I independently verified the loaded axis name/reference, direction, raw units, target, and tolerance."
                                                TextWrapping="Wrap" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="CheckAxisQualificationExclusiveOwner"
                                        Checked="AxisQualificationSafetyConfirmation_Changed"
                                        Unchecked="AxisQualificationSafetyConfirmation_Changed">
                                        <CheckBox.Content>
                                            <TextBlock
                                                Text="I have exclusive motion ownership; people/tooling are clear and PLC/packet evidence capture is running. Keep the capture running for at least two seconds after PASS."
                                                TextWrapping="Wrap" />
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button
                                            x:Name="ButtonRunAxisQualification"
                                            Click="ButtonRunAxisQualification_Click"
                                            Content="Run LIVE Axis Qualification" />
                                        <Button
                                            x:Name="ButtonCancelAxisQualification"
                                            Click="ButtonCancelQualification_Click"
                                            Content="Cancel / Safe Cleanup" />
                                        <Button
                                            x:Name="ButtonSaveAxisQualificationLog"
                                            Click="ButtonSaveQualificationLog_Click"
                                            Content="Save Axis QTEST Log" />
                                    </WrapPanel>
                                    <ProgressBar
                                        x:Name="ProgressAxisQualification"
                                        Height="18"
                                        Margin="0,2,8,4"
                                        Maximum="100"
                                        Minimum="0" />
                                    <TextBlock
                                        x:Name="TextAxisQualificationProgress"
                                        Margin="0,0,0,4"
                                        FontFamily="Consolas"
                                        Text="No Single Axis qualification has run yet."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="TextAxisQualificationSummary"
                                        Height="145"
                                        FontFamily="Consolas"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
