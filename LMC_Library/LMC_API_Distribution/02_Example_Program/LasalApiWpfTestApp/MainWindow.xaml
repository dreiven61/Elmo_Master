                                <TextBlock
                                    x:Name="TextAdminAxisParameterResult"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    FontFamily="Consolas"
                                    Text="No axis parameter result."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Margin="0,4,0,0"
                                    Foreground="#5F6B7A"
                                    Text="The key is semantic; native LASAL MotionLib enum values are not exposed on the PC wire."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Semantic group parameters (group reference fixed at 0x0100)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Selection" />
                                    <ComboBox x:Name="ComboAdminGroupSelection" Width="240" />
                                </StackPanel>
                                <Button
                                    x:Name="ButtonReadAdminGroupParameters"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="8,20,8,8"
                                    HorizontalAlignment="Left"
                                    Click="ButtonReadAdminGroupParameters_Click"
                                    Content="Read Group Parameters" />
                                <TextBlock
                                    x:Name="TextAdminGroupParameterResult"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    FontFamily="Consolas"
                                    Text="No group parameter result."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Physical drive reads">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Physical axis reference (1..4)" />
                                    <ComboBox x:Name="ComboDriveReadAxisReference" Width="150" />
                                </StackPanel>
                                <Button
                                    x:Name="ButtonGetDriveOperationMode"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="8,20,8,8"
                                    Click="ButtonGetDriveOperationMode_Click"
                                    Content="1 Get Drive Operation Mode" />
                                <Button
                                    x:Name="ButtonReadDriveStatus"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,20,8,8"
                                    HorizontalAlignment="Left"
                                    Click="ButtonReadDriveStatus_Click"
                                    Content="2 Read Drive Status" />
                                <Button
                                    x:Name="ButtonGetDriveErrorCode"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="0,20,8,8"
                                    HorizontalAlignment="Left"
                                    Click="ButtonGetDriveErrorCode_Click"
                                    Content="3 Get Drive Error Code" />
                                <TextBlock
                                    x:Name="TextDriveReadResult"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="4"
                                    FontFamily="Consolas"
                                    Text="No drive read result."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.ColumnSpan="4"
                                    Margin="0,4,0,0"
                                    Foreground="#8A4A00"
                                    Text="Read Drive Status is explicitly non-atomic: LASAL axis status, DS402 0x6041:0, and DS402 0x6061:0 are read sequentially and may come from different PLC/EtherCAT cycles. Get Drive Error Code is a separate one-ticket 0x603F:0 read. LASAL 0x2028 StatusWord is reserved zero and is not DS402 0x6041 evidence."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>

        <Expander
            x:Name="ExpanderExecutionLog"
            Grid.Row="2"
            Margin="0,2,0,4"
            Header="Execution log / callback diagnostics"
            IsExpanded="False">
            <Border
                Padding="8"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="2">
                <Grid Height="135">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Click="ButtonCopyLog_Click" Content="Copy Log" />
                        <Button Click="ButtonClearLog_Click" Content="Clear Log" />
                    </StackPanel>
                    <TextBox
                        x:Name="TextExecutionLog"
                        Grid.Row="1"
                        Margin="0"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Expander>

        <StatusBar
            x:Name="StatusOperationBar"
            Grid.Row="3"
            Margin="0,2,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TextOperationState" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
