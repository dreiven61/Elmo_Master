<Window
    x:Class="LasalMotionControlLibTestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LASAL Motion Control Lib Test (No Elmo DLL)"
    Width="1180"
    Height="820">
    <DockPanel Margin="10">
        <GroupBox
            DockPanel.Dock="Top"
            Header="LMC Connection"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Remote IP" />
                    <TextBox x:Name="RemoteIp" Text="192.168.99.20" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Port" />
                    <TextBox x:Name="RemotePort" Text="4000" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Local IP" />
                    <TextBox x:Name="LocalIp" Text="192.168.99.14" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="UDP Callback" />
                    <TextBox x:Name="CallbackPort" Text="5003" />
                </StackPanel>

                <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button
                        x:Name="ConnectButton"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Click="Connect_Click"
                        Content="RpcInitConnection" />
                    <Button
                        x:Name="CloseButton"
                        Padding="12,5"
                        Click="Close_Click"
                        Content="CloseConnection" />
                </WrapPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
                    <TextBlock Text="State: " FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStateText" Text="Disconnected" />
                    <TextBlock Text="   Callback: " FontWeight="SemiBold" />
                    <TextBlock x:Name="CallbackStateText" Text="Stopped" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox
            DockPanel.Dock="Top"
            Header="Target / API"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Target" />
                    <ComboBox
                        x:Name="TargetMode"
                        SelectionChanged="TargetMode_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Axis" />
                    <TextBox
                        x:Name="AxisName"
                        Text="_LMCAxis1"
                        TextChanged="TargetIdentity_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Group members" />
                    <TextBox
                        x:Name="MemberNames"
                        Text="_LMCAxis1,_LMCAxis2,_LMCAxis3,_LMCAxis4"
                        TextChanged="TargetIdentity_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Group" />
                    <TextBox
                        x:Name="GroupName"
                        Text="_LMCRobotBase1"
                        TextChanged="TargetIdentity_Changed" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="API" />
                    <ComboBox
                        x:Name="ApiOperation"
                        SelectionChanged="ApiOperation_SelectionChanged" />
                </StackPanel>

                <TextBlock
                    x:Name="ApiSupportText"
                    Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="#AA660000" />
            </Grid>
        </GroupBox>

        <GroupBox
            DockPanel.Dock="Top"
            Header="Group command options"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="ReadActualPosition coord (MCS captured)" />
                    <ComboBox x:Name="ReadCoordinateSystem" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Move coordinate" />
                    <ComboBox x:Name="MotionCoordinateSystem" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Transition mode" />
                    <ComboBox x:Name="TransitionMode" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Buffer mode" />
                    <ComboBox x:Name="BufferMode" />
                </StackPanel>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Bottom"
                    TextWrapping="Wrap"
                    Foreground="#AA660000"
                    Text="SetKinTransformCartesian4Axis uses the first four group members as X/Y/Z/U. The current wire profile is the captured four-axis identity-shift profile." />
            </Grid>
        </GroupBox>

        <GroupBox
            DockPanel.Dock="Top"
            Header="Engineering values (PC multiplies each value by the configured PLC UNIT)"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Position/Distance" />
                    <TextBox x:Name="Position" Text="0.1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Velocity" />
                    <TextBox x:Name="Velocity" Text="0.1" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Acceleration" />
                    <TextBox x:Name="Acceleration" Text="1" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Deceleration" />
                    <TextBox x:Name="Deceleration" Text="1" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Jerk" />
                    <TextBox x:Name="Jerk" Text="0" />
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="Velocity direction" />
                    <ComboBox x:Name="Direction" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Group positions (engineering CSV)" />
                    <TextBox x:Name="GroupPositions" Text="0.1,0.1,0.1,0.1" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel
            DockPanel.Dock="Top"
            Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="PLC UNIT multiplier"
                    Margin="0,0,8,0" />
                <TextBox
                    x:Name="UnitMultiplier"
                    Width="130"
                    Text="10000"
                    Margin="0,0,16,0" />
                <Button
                    x:Name="ExecuteButton"
                    Width="220"
                    Padding="12,6"
                    Click="Execute_Click"
                    Content="Execute Selected LMC API" />
                <Button
                    x:Name="CancelButton"
                    Width="165"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"
                    Content="Cancel (outcome unknown)" />
                <Button
                    x:Name="StopVelocityButton"
                    Width="170"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Click="StopVelocity_Click"
                    Content="Stop active velocity" />
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <CheckBox
                    x:Name="AllowHazardousCommand"
                    VerticalAlignment="Center"
                    Checked="AllowHazardousCommand_Changed"
                    Unchecked="AllowHazardousCommand_Changed"
                    Content="Arm one power/motion/state command" />
                <CheckBox
                    x:Name="AllowUnsupportedNegativeTest"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Checked="AllowUnsupportedNegativeTest_Changed"
                    Unchecked="AllowUnsupportedNegativeTest_Changed"
                    Content="Allow unsupported -5 negative test" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#AA660000"
                    Margin="18,0,0,0"
                    Text="UNIT 10000 is only the current rotary-axis profile. Cancel aborts PC transport/wait, is not Stop, and may leave PLC outcome unknown." />
            </WrapPanel>
        </StackPanel>

        <TextBox
            x:Name="Log"
            IsReadOnly="True"
            AcceptsReturn="True"
            FontFamily="Consolas"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
