<Window
    x:Class="LasalMotionControlLibTestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LASAL Motion Control Lib Test (No Elmo DLL)"
    Width="1120"
    Height="760">
    <DockPanel Margin="10">
        <GroupBox
            DockPanel.Dock="Top"
            Header="LMC Connection"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Remote IP" />
                    <TextBox x:Name="RemoteIp" Text="192.168.99.20" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Port" />
                    <TextBox x:Name="RemotePort" Text="4000" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Local IP" />
                    <TextBox x:Name="LocalIp" Text="192.168.99.14" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="UDP Callback" />
                    <TextBox x:Name="CallbackPort" Text="5003" />
                </StackPanel>

                <WrapPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Click="Connect_Click"
                        Content="RpcInitConnection" />
                    <Button
                        Padding="12,5"
                        Click="Close_Click"
                        Content="CloseConnection" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox
            DockPanel.Dock="Top"
            Header="Target / API"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Target" />
                    <ComboBox
                        x:Name="TargetMode"
                        SelectionChanged="TargetMode_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Axis" />
                    <TextBox x:Name="AxisName" Text="_LMCAxis1" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Group members" />
                    <TextBox x:Name="MemberNames" Text="_LMCAxis1,_LMCAxis2,_LMCAxis3,_LMCAxis4" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Group" />
                    <TextBox x:Name="GroupName" Text="_LMCRobotBase1" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="API" />
                    <ComboBox x:Name="ApiOperation" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox
            DockPanel.Dock="Top"
            Header="Dummy 23-bit encoder profile (app converts rev/rps to raw DINT)"
            Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Position/Distance (rev)" />
                    <TextBox x:Name="Position" Text="0.1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Velocity (rps)" />
                    <TextBox x:Name="Velocity" Text="0.1" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Acceleration (rev/s²)" />
                    <TextBox x:Name="Acceleration" Text="1" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Deceleration (rev/s²)" />
                    <TextBox x:Name="Deceleration" Text="1" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Jerk (rev/s³)" />
                    <TextBox x:Name="Jerk" Text="1" />
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="Velocity direction" />
                    <ComboBox x:Name="Direction" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Group positions (rev CSV)" />
                    <TextBox x:Name="GroupPositions" Text="0.1,0.1,0.1,0.1" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Margin="0,0,0,8">
            <TextBlock
                VerticalAlignment="Center"
                Text="Dummy encoder counts/rev (2^23)"
                Margin="0,0,8,0" />
            <TextBox
                x:Name="CountsPerRev"
                Width="130"
                Text="8388608"
                Margin="0,0,16,0" />
            <Button
                Width="220"
                Padding="12,6"
                Click="Execute_Click"
                Content="Execute Selected LMC API" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#AA660000"
                Margin="18,0,0,0"
                Text="예제 전용 프로파일입니다. DLL은 UNIT/CPR 변환을 하지 않습니다. MoveVelocity는 Stop 전까지 계속 동작합니다." />
        </StackPanel>

        <TextBox
            x:Name="Log"
            IsReadOnly="True"
            AcceptsReturn="True"
            FontFamily="Consolas"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
