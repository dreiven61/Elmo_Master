<Window
    x:Class="LasalMotionControlApiExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LASAL Motion Control API Example"
    Width="1180"
    Height="860"
    MinWidth="980"
    MinHeight="720"
    FontFamily="Segoe UI"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,3,12,8" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#445066" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="LASAL Motion Control API Example" />
                <TextBlock
                    Margin="0,3,0,0"
                    Foreground="#55657A"
                    Text="Only PLC-active APIs are exposed. Values use the selected application UNIT or pass through as raw DINT." />
            </StackPanel>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Connection / RPC callback">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PLC IP" />
                    <TextBox x:Name="TextRemoteIp" Text="10.10.150.1" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TCP port" />
                    <TextBox x:Name="TextRemotePort" Width="90" Text="4000" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PC local IPv4" />
                    <TextBox x:Name="TextLocalIp" Text="10.10.150.13" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Callback UDP port" />
                    <TextBox x:Name="TextCallbackPort" Width="100" Text="5000" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom">
                    <Button
                        x:Name="ButtonConnect"
                        Click="ButtonConnect_Click"
                        Content="Connect" />
                    <Button
                        x:Name="ButtonCloseConnection"
                        Click="ButtonCloseConnection_Click"
                        Content="Close" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Connection state" />
                    <TextBlock
                        x:Name="TextConnectionState"
                        Style="{StaticResource ValueText}"
                        Text="Disconnected" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="7">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Callback listener" />
                    <TextBlock
                        x:Name="TextCallbackState"
                        Width="230"
                        Style="{StaticResource ValueText}"
                        Text="Stopped"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="8"
                    Foreground="#5F6B7A"
                    Text="Connect performs RPC session initialization and callback registration automatically. Callback payloads are logged as raw diagnostic data." />
            </Grid>
        </GroupBox>

        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Padding="12,9"
            Background="#FFF6DF"
            BorderBrush="#E0B34B"
            BorderThickness="1"
            CornerRadius="4">
            <DockPanel>
                <TextBlock
                    x:Name="TextMotionWarning"
                    VerticalAlignment="Center"
                    Foreground="#8A4A00"
                    Text="Power On, Reset, motion, and group preparation commands are sent immediately without a confirmation dialog. Stop and axis Power Off remain available while connected. Closing the connection does not stop motion."
                    TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TabControl
            x:Name="TabsMotion"
            Grid.Row="3"
            Margin="0,0,0,5"
            SelectionChanged="MotionTabs_SelectionChanged">
            <TabItem Header="Single Axis">
                <ScrollViewer
                    x:Name="ScrollSingleAxis"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Axis object">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LASAL object name" />
                                    <DockPanel>
                                        <Button
                                            x:Name="ButtonLookupAxis"
                                            DockPanel.Dock="Right"
                                            Click="ButtonLookupAxis_Click"
                                            Content="Load Axis" />
                                        <TextBox
                                            x:Name="TextAxisName"
                                            Text="_LMCAxis1"
                                            TextChanged="TextAxisName_TextChanged" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Axis reference:" />
                                        <TextBlock
                                            x:Name="TextAxisReference"
                                            Margin="8,0,0,0"
                                            FontWeight="SemiBold"
                                            Text="not loaded" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Read / control">
                                <WrapPanel>
                                    <Button
                                        x:Name="ButtonReadStatus"
                                        Click="ButtonReadStatus_Click"
                                        Content="Read Status" />
                                    <Button
                                        x:Name="ButtonReadPosition"
                                        Click="ButtonReadPosition_Click"
                                        Content="Read Position" />
                                    <Button
                                        x:Name="ButtonPowerOn"
                                        Click="ButtonPowerOn_Click"
                                        Content="Power On" />
                                    <Button
                                        x:Name="ButtonPowerOff"
                                        Click="ButtonPowerOff_Click"
                                        Content="Power Off" />
                                    <Button
                                        x:Name="ButtonReset"
                                        Click="ButtonReset_Click"
                                        Content="Reset" />
                                    <Button
                                        x:Name="ButtonStop"
                                        Click="ButtonStop_Click"
                                        Content="Stop" />
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Header="Latest axis result">
                                <TextBox
                                    x:Name="TextAxisResult"
                                    MinHeight="130"
                                    IsReadOnly="True"
                                    Text="Load an axis object, then start with Read Status."
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <GroupBox Header="Engineering values">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLC application UNIT" />
                                        <ComboBox x:Name="ComboAxisUnit" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Position / distance" />
                                        <TextBox
                                            x:Name="TextPosition"
                                            Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity" />
                                        <TextBox
                                            x:Name="TextVelocity"
                                            Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Acceleration" />
                                        <TextBox
                                            x:Name="TextAcceleration"
                                            Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Deceleration / Stop" />
                                        <TextBox
                                            x:Name="TextDeceleration"
                                            Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jerk (axis unit/s^3/1000)" />
                                        <TextBox
                                            x:Name="TextJerk"
                                            Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity direction" />
                                        <ComboBox
                                            x:Name="ComboDirection" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,6,0,8"
                                        VerticalAlignment="Center"
                                        Foreground="#5F6B7A"
                                        Text="PC values use mm (x10000); the saved axis transmission is 8388608 counts per 10 mm. Re-reference after downloading the new scale. None / raw DINT sends an already converted integer. Velocity/acceleration/deceleration must be positive. Enter physical jerk / 1000; the UI applies the selected UNIT."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Motion">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button
                                            x:Name="ButtonMoveAbsolute"
                                            Click="ButtonMoveAbsolute_Click"
                                            Content="Move Absolute" />
                                        <Button
                                            x:Name="ButtonMoveRelative"
                                            Click="ButtonMoveRelative_Click"
                                            Content="Move Relative" />
                                        <Button
                                            x:Name="ButtonMoveVelocity"
                                            Click="ButtonMoveVelocity_Click"
                                            Content="Move Velocity" />
                                    </WrapPanel>
                                    <TextBlock
                                        Foreground="#8A4A00"
                                        Text="Absolute/Relative use Shortest. Relative direction comes from the distance sign. Velocity runs until Stop or PowerOff is verified."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Group Motion">
                <ScrollViewer
                    x:Name="ScrollGroupMotion"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Group object">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LASAL object name" />
                                    <DockPanel>
                                        <Button
                                            x:Name="ButtonLookupGroup"
                                            DockPanel.Dock="Right"
                                            Click="ButtonLookupGroup_Click"
                                            Content="Load Group" />
                                        <TextBox
                                            x:Name="TextGroupName"
                                            Text="_LMCRobotBase1"
                                            TextChanged="TextGroupName_TextChanged" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Group reference:" />
                                        <TextBlock
                                            x:Name="TextGroupReference"
                                            Margin="8,0,0,0"
                                            FontWeight="SemiBold"
                                            Text="not loaded" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Group commands">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="TextGroupPreparationState"
                                        Margin="4,2,4,6"
                                        Foreground="#315A86"
                                        Text="Preparation: load the group first."
                                        TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <Button
                                            x:Name="ButtonGetMembers"
                                            Click="ButtonGetMembers_Click"
                                            Content="Get Members" />
                                        <Button
                                            x:Name="ButtonGroupPowerOn"
                                            Click="ButtonGroupPowerOn_Click"
                                            Content="1 Power On" />
                                        <Button
                                            x:Name="ButtonGroupReadStatus"
                                            Click="ButtonGroupReadStatus_Click"
                                            Content="2 / 5 Read Status (Power Ready / Lock Ready)" />
                                        <Button
                                            x:Name="ButtonGroupEnable"
                                            Click="ButtonGroupEnable_Click"
                                            Content="4 Enable (Lock Profile)" />
                                        <Button
                                            x:Name="ButtonGroupDisable"
                                            Click="ButtonGroupDisable_Click"
                                            Content="Disable (Unlock Profile)" />
                                        <Button
                                            x:Name="ButtonGroupPowerOff"
                                            Click="ButtonGroupPowerOff_Click"
                                            Content="Power Off" />
                                        <Button
                                            x:Name="ButtonGroupReadPosition"
                                            Click="ButtonGroupReadPosition_Click"
                                            Content="Read Position" />
                                        <Button
                                            x:Name="ButtonGroupReset"
                                            Click="ButtonGroupReset_Click"
                                            Content="Reset" />
                                        <Button
                                            x:Name="ButtonGroupStop"
                                            Click="ButtonGroupStop_Click"
                                            Content="Stop" />
                                    </WrapPanel>
                                    <TextBlock
                                        Margin="4,2,4,0"
                                        Foreground="#8A4A00"
                                        Text="Required order: 1 Power On -> 2 Read Status until PowerOn=True -> 3 Set Identity (automatic Home Check) -> 4 Enable (Lock Profile) -> 5 Read Status until Enabled/Locked Standby=True -> 6 Move -> Disable (Unlock Profile) -> Power Off -> Read Status until PowerOn=False."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Latest group result">
                                <TextBox
                                    x:Name="TextGroupResult"
                                    MinHeight="90"
                                    IsReadOnly="True"
                                    Text="Load a group object, then read status or members."
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <GroupBox Header="Linear motion values">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLC application UNIT" />
                                        <ComboBox x:Name="ComboGroupUnit" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="X target" />
                                        <TextBox x:Name="TextGroupPositionX" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Y target" />
                                        <TextBox x:Name="TextGroupPositionY" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Z target" />
                                        <TextBox x:Name="TextGroupPositionZ" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="U target" />
                                        <TextBox x:Name="TextGroupPositionU" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocity" />
                                        <TextBox x:Name="TextGroupVelocity" Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Acceleration" />
                                        <TextBox x:Name="TextGroupAcceleration" Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Deceleration / Stop" />
                                        <TextBox x:Name="TextGroupDeceleration" Text="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jerk" />
                                        <TextBox x:Name="TextGroupJerk" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Coordinate system" />
                                        <ComboBox x:Name="ComboGroupCoordinate" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Transition" />
                                        <ComboBox x:Name="ComboGroupTransition" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Buffer mode" />
                                        <ComboBox x:Name="ComboGroupBuffer" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                        <WrapPanel>
                                            <Button
                                                x:Name="ButtonGroupMoveLinear"
                                                Click="ButtonGroupMoveLinear_Click"
                                                Content="6 Move Linear Absolute" />
                                        </WrapPanel>
                                        <TextBlock
                                            Foreground="#8A4A00"
                                            Text="Positions and dynamics use the selected group application UNIT. The current PLC group uses mm (x10000). Select None / raw DINT for values already converted by the caller. This PLC adapter currently accepts Coordinate=None."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Cartesian 4-axis identity kinematics">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="X axis object" />
                                        <TextBox
                                            x:Name="TextKinAxisX"
                                            Text="_LMCAxis1"
                                            TextChanged="TextKinAxis_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Y axis object" />
                                        <TextBox
                                            x:Name="TextKinAxisY"
                                            Text="_LMCAxis2"
                                            TextChanged="TextKinAxis_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Z axis object" />
                                        <TextBox
                                            x:Name="TextKinAxisZ"
                                            Text="_LMCAxis3"
                                            TextChanged="TextKinAxis_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="U axis object" />
                                        <TextBox
                                            x:Name="TextKinAxisU"
                                            Text="_LMCAxis4"
                                            TextChanged="TextKinAxis_TextChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                                        <WrapPanel>
                                            <Button
                                                x:Name="ButtonCheckKinHome"
                                                Click="ButtonCheckKinHome_Click"
                                                Content="Home Check (X/Y/Z/U)" />
                                            <Button
                                                x:Name="ButtonSetKinTransform"
                                                Click="ButtonSetKinTransform_Click"
                                                Content="3 Set Identity (Auto Home Check + Configure)" />
                                        </WrapPanel>
                                        <TextBlock
                                            Foreground="#5F6B7A"
                                            Text="Home Check reads _LMCAXIS_STATUS.IsReferenced for the four identity axes. Set Identity repeats the check automatically and is blocked when any selected axis is not referenced."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Identity axis Home status" />
                                        <TextBox
                                            x:Name="TextKinHomeStatus"
                                            MinHeight="95"
                                            MaxHeight="155"
                                            FontFamily="Consolas"
                                            IsReadOnly="True"
                                            Text="Home Check: not checked."
                                            TextWrapping="NoWrap"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Expander
            Grid.Row="4"
            Margin="0,2,0,4"
            Header="Execution log / raw callback diagnostics"
            IsExpanded="False">
            <Border
                Padding="8"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="2">
                <Grid Height="135">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Click="ButtonCopyLog_Click" Content="Copy Log" />
                        <Button Click="ButtonClearLog_Click" Content="Clear Log" />
                    </StackPanel>
                    <TextBox
                        x:Name="TextExecutionLog"
                        Grid.Row="1"
                        Margin="0"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Expander>

        <StatusBar Grid.Row="5" Margin="0,2,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TextOperationState" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
