    ECATM_EVTC_DC_SLV_OFFSET_REQ:
      //This event is generated during the IP transition of the master. The transition is held until the
    //function ecatm_dc_set_offset() is called.
    //Only Called in DC Slavemode
    //ECATM_EVTT_INFO
    //arg1   Link layer frame send timestamp: uint32_t
    //arg2   Link layer frame receive timestamp: uint32_t
    //arg3   Measured round trip time at the DC reference slave. The value is equal to the return
    //       value of _ecatm_dc_get_rtt(): uint32_t   
    
    _syncmeasureECAT1.SetDCSlaveOffset(LLSend:= evt^.arg1$UDINT
                                   , LLReceive:= evt^.arg2$UDINT
                                      , DC_RTT:= evt^.arg3$UDINT);
    
    
