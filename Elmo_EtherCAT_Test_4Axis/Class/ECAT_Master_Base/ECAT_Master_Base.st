    ECATM_EVTC_INITC_VALID_DATA:
    //Init command failed during data validation 
  
    //arg1 ... device index: int 
    //arg2 ... init cmd id: int 
    //arg3 ... byte index: int 
    //arg4 ... received byte: uint8_t 
    //txt ... Comment of init command in ENI file
  
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Init command failed during data validation. Device Index: 0x{0}",evt^.arg1$UDINT);
      LogValue("ECAT-DEBUG: init cmd id: 0x{0}, byte index: 0x{1}, received byte: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
      LogError(#evt^.txt[0]);
#endif

      //Forward callback to slave
      if evt^.arg1 >= 0 then  // device index -1 = Master 
        SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      end_if;

      if bLogInCallbackAllowed then
        LogValue("@057E (ECAT_Master_Base::EvtCallBack) Init command failed during data validation. Device Index: 0x{0}",evt^.arg1$UDINT);
        LogValue("@057E init cmd id: 0x{0}, byte index: 0x{1}, received byte: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
        HWC_LogPrintf(pThis:=this, format:="@057E: %s", p0:=#evt^.txt[0]);
      else
        bd_LogRtMessagesInCy.PostIt.InitCValidData := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[13]         := evt^.arg1$UDINT;
      end_if;
      
      if (evt^.arg1 >= 0) & (evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves) then
        pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo));
                
        //Check if slave was required
        if pCurrentSlave^.bRequired = TRUE then
          SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                          , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                          , bLogInMethAllowed := bLogInCallbackAllowed);
        end_if;
          
        // Loggin else already done in SendEvtCallBacktoSlave
//      else
//        //Invalid slave no

      end_if;
      
