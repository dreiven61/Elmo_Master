FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::CyWork
  VAR_INPUT
    EAX 	: UDINT;
  END_VAR
  VAR_OUTPUT
    state (EAX) 	: UDINT;
  END_VAR
  VAR
    pCurrentSlave : ^t_sSlaveInfo;
    i             : UDINT;
    _Para         : CmdStruct;
    _Result       : Results;
    RetCodeIPR    : iprStates;
    b_ModulInitComplete   : BOOL;
    TmpRequest    : BDINT;
    retCode       : DINT;
  END_VAR
  
  case InitSSW of
//**********************************************************************************************************************************************************
    t_e_InitSSW::_StartInit:

#ifdef ECAT_TRACE_VIEW_LOG  
      OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_START_INIT,0);
#endif

      // remember when we started (for timeout and init time measure)
      udInitStartTime := ops.tAbsolute;
    
      // check if we had an error before
      if InitError <> _ClassOk then
        // we already have a log entry from the init
        ClassState := InitError;
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;
      
      // Check if post init needs to be extended
      if StateTransitionTimeout.Read() > POST_INIT_TIMEOUT then
      
        ExtendPostInitTime(AdditionalTime:=StateTransitionTimeout);
    
      end_if;
      
      InitSSW := _Wait4ECATLink;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_Wait4ECATLink:
      
      retCode := OS_ECATM_NET_GET_STATUS(pECAT, ecatmhdl, #snetStatus);
      
      if retCode then
        LogValue("@0563 (ECAT_Master_Base::CyWork) Failed to get ECAT Link Status. Return Code: 0x{0} via InitModule-Interface", retCode$UDINT);
        
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := InitError    := _ManagerError;
        EtherCATState := ECAT_STATE_NONE;
        
        return;
      end_if;
      
      if snetStatus.flags.ECATM_NET_STATUS_MST_LINK_DOWN = FALSE then

#ifdef ECAT_DEBUG_EVENT_CALLBACKS
        LogValue("ECAT-DEBUG: Link found after 0x{0}ms", (ops.tAbsolute-udInitStartTime));
#endif
        
        //ClassState is set to NoHardware at DisconnectEvent -> Set back to _ClassOk to ensure that the Realtime functions are called
        ClassState := _ClassOk;
        
        //Go on and call the connect event methods
        InitSSW := _CallConnectEventOfModules;
      elsif ( (bd_Flags.bDisableWait4LinkTimeOut = FALSE) & 
              (ops.tAbsolute - udInitStartTime) > GetWait4LinkTimeout()) then
        
        ErrorInitStep := InitSSW;
        InitSSW       := _PrepareError;
        ClassState    := InitError     := _ManagerError;
        EtherCATState := ECAT_STATE_NONE;
        LogError("@067B (ECAT_Master_Base::CyWork) Master Link Down (Timeout)! Unable to continue with Initialisation.");

      end_if;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_CallConnectEventOfModules:
 
      //Call the Connect Event of every slave
      if sSlaveInfo.udMaxSlaves then
        pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
        for i:=0 to sSlaveInfo.udMaxSlaves-1 do
          //Only call module if no error
          if pCurrentSlave^.pThis & pCurrentSlave^.pThis^.EtherCATState <> ECAT_STATE_NONE then
            pCurrentSlave^.pThis^.ConnectEvent();
          end_if;
          pCurrentSlave += sizeof(t_sSlaveInfo);
        end_for;
      end_if;
 
      InitSSW := _PrepareNextEtherCATState;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_PrepareNextEtherCATState:
    
      //Go on with next step of initialisation
      InitSSW := _SwitchToNextEtherCATState;
      TmpRequest := 0;
      
      //Check if any slave needs an InitModule call. Otherwise we can directy request the OP State from the master
      if sSlaveInfo.udMaxSlaves then
        pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
        //Call UpdateCy of all logged in slaves
        for i:=0 to sSlaveInfo.udMaxSlaves-1 do
          if pCurrentSlave^.pThis & pCurrentSlave^.bdInitModuleFlags <> ECAT_INIT_MODULE_NO_CALL then
            TmpRequest := TmpRequest OR pCurrentSlave^.bdInitModuleFlags;
          end_if;
          pCurrentSlave += sizeof(t_sSlaveInfo);
        end_for;
      end_if;
      
      //Determine master state to request (e.g. if no module needs to be called during our InitModulePhase, we can directly request the OP State)
      if (TmpRequest AND ECAT_INIT_MODULE_CALL_INIT) = ECAT_INIT_MODULE_CALL_INIT then
        RequestMasterState := ECAT_STATE_INIT;
      elsif (TmpRequest AND ECAT_INIT_MODULE_CALL_PREOP) = ECAT_INIT_MODULE_CALL_PREOP then
        RequestMasterState := ECAT_STATE_PREOP;
      elsif (TmpRequest AND ECAT_INIT_MODULE_CALL_SAFEOP) = ECAT_INIT_MODULE_CALL_SAFEOP then
        RequestMasterState := ECAT_STATE_SAFEOP;
      else
        //No module needs an InitModule Call
        RequestMasterState := ECAT_STATE_OP;
      end_if;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_SwitchToNextEtherCATState:
      
      //Set master to determined state
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue(pString:="ECAT-DEBUG: Request New ECATMST State: 0x{0}", Value:=RequestMasterState);
#endif
      retcode := OS_ECATM_MST_REQ_STATE(pECAT, ecatmhdl, RequestMasterState, StateTransitionBehaviour);
      if retcode then
        LogValue("@0565 (ECAT_Master_Base::CyWork) Call OS_ECATM_MST_REQ_STATE() Failed with retcode 0x{0}! Unable to continue with Initialisation", ABS(retcode)$UDINT);
        // Disable Class
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := _ManagerError;
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;
      
      udCheckEtherCATStateTime := ops.tAbsolute;
      InitSSW := _CheckEtherCATState;
     
//**********************************************************************************************************************************************************
    t_e_InitSSW::_CheckEtherCATState:
    
      //Wait until master is in requested state
      if EtherCATState = RequestMasterState then
      
#ifdef ECAT_TRACE_VIEW_LOG  
        OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_CHECK_ETHERCAT_STATE,EtherCATState$UDINT);
#endif
      
        //If we are in the requested state go on with InitModule Phase
        InitSSW := _CallInitModule;
        
        udInitModuleTimeStamp := ops.tAbsolute;
        udInitModuleTimeOut   := GetCallInitModuleTimeout();
        
      elsif ( (bd_Flags.bDisableStateTransitionTimeout = FALSE) &
              (ops.tAbsolute - udCheckEtherCATStateTime) > StateTransitionTimeout.Read()) then
        LogValue("@0566 (ECAT_Master_Base::CyWork) Timeout while waiting for EtherCATState! EtherCATState: 0x{0}, RequestMasterState: 0x{1}", EtherCATState$UDINT,RequestMasterState$UDINT);
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := _TimeoutInInit;
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;

//**********************************************************************************************************************************************************
    t_e_InitSSW::_CallInitModule:
    
      // preinitialize the complete marker => is resetted if a module has to be initialized
      b_ModulInitComplete := TRUE;
    
      //Call all slaves (needed for SDO Handling)
      if sSlaveInfo.udMaxSlaves then
        pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
        
        _Para.uiCmd := ECAT_M_CALL_INIT_MODULE;
        _Para.aPara[0]$DINT           := 1;
        _Para.aPara[1]$t_e_ECAT_STATE := EtherCATState;
        
        //Call UpdateCy of all logged in slaves
        for i:=0 to sSlaveInfo.udMaxSlaves-1 do
          
          //Check if current module has to be called
          if (pCurrentSlave^.bdInitModuleFlags <> ECAT_INIT_MODULE_NO_CALL) &
            ((pCurrentSlave^.bdInitModuleFinished AND EtherCATState$BDINT) <> EtherCATState$BDINT ) then
          
            if (EtherCATState = ECAT_STATE_INIT   & ((pCurrentSlave^.bdInitModuleFlags AND ECAT_INIT_MODULE_CALL_INIT)    = ECAT_INIT_MODULE_CALL_INIT))  |
               (EtherCATState = ECAT_STATE_PREOP  & ((pCurrentSlave^.bdInitModuleFlags AND ECAT_INIT_MODULE_CALL_PREOP)   = ECAT_INIT_MODULE_CALL_PREOP)) |
               (EtherCATState = ECAT_STATE_SAFEOP & ((pCurrentSlave^.bdInitModuleFlags AND ECAT_INIT_MODULE_CALL_SAFEOP)  = ECAT_INIT_MODULE_CALL_SAFEOP)) |
               (EtherCATState = ECAT_STATE_OP     & ((pCurrentSlave^.bdInitModuleFlags AND ECAT_INIT_MODULE_CALL_OP)      = ECAT_INIT_MODULE_CALL_OP))
            then
              RetCodeIPR := pCurrentSlave^.pThis^.NewInst(#_Para,#_Result);

#ifdef ECAT_TRACE_VIEW_LOG  
              OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_CALL_INITMODULE,i);
#endif
              //Check retcode
              if RetCodeIPR = ERROR then
              
                LogValue("@0567 (ECAT_Master_Base::CyWork) Failed to initialize EtherCAT Slave 0x{0} via InitModule-Interface", i);
                
                // Set as finshed so that not required module is not called again and does not spam log
                // Disable Init callbacks for all EtherCAT States
                pCurrentSlave^.bdInitModuleFinished := pCurrentSlave^.bdInitModuleFinished OR ECAT_STATE_INIT$BDINT OR ECAT_STATE_PREOP$BDINT OR ECAT_STATE_SAFEOP$BDINT OR ECAT_STATE_OP$BDINT;
                  
                // if it's an required module => error
                if pCurrentSlave^.bRequired   then
                  SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                                  , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                                  , bLogInMethAllowed := TRUE);
                end_if;
              
              elsif RetCodeIPR = READY then
                pCurrentSlave^.bdInitModuleFinished := pCurrentSlave^.bdInitModuleFinished OR EtherCATState$BDINT;
              else
                b_ModulInitComplete := FALSE; //At least one module is not ready yet --> carry on with ModuleInit phase
              end_if;
            //else
              //Module will be called if the needed EtherCAT State is active
            end_if;
          else
            //Module has no need to be called, just set as finished
            pCurrentSlave^.bdInitModuleFinished := pCurrentSlave^.bdInitModuleFinished OR EtherCATState$BDINT;
          end_if;
          
          pCurrentSlave += sizeof(t_sSlaveInfo);
        end_for;
      end_if;
      
      //Check if every module init is finished, go on to next state
      if b_ModulInitComplete = TRUE then

        InitSSW := _SwitchToNextEtherCATState;
        
        case EtherCATState of
        //*****************************************************************************
          t_e_ECAT_STATE::ECAT_STATE_INIT:
            //Next step to request is Preop
            RequestMasterState := ECAT_STATE_PREOP;
            
        //*****************************************************************************
          t_e_ECAT_STATE::ECAT_STATE_PREOP:
            //Next step to request is SafeOP
            RequestMasterState := ECAT_STATE_SAFEOP;
            
        //*****************************************************************************
          t_e_ECAT_STATE::ECAT_STATE_SAFEOP:
            
            // Configure Synchronisation ***********************************************************************
            if ( (sDCInfo.DCModuleEnabled) &                  // Only when DC unit is enabled
                 (sDCInfo.SyncMeasureConfigOk = FALSE) ) then
              if Config_SyncMeasureECAT() <> ECAT_RETOK then
                SetRequiredError(bLogInMethAllowed := TRUE);
              end_if;
            end_if;
            // Configure Synchronisation end ********************************************************************
          
            //Next step to request is OP
            RequestMasterState := ECAT_STATE_OP;
            
        //*****************************************************************************
          t_e_ECAT_STATE::ECAT_STATE_OP:
          
            //Finished, check if we have a DC Module --> we need to wait until everything is synchron
            if sDCInfo.DCModuleEnabled = TRUE then
              
              // Configure Synchronisation ***********************************************************************
              // Check again incase SAFE_OP was skipped
              if (sDCInfo.SyncMeasureConfigOk = FALSE) then
                if Config_SyncMeasureECAT() <> ECAT_RETOK then
                  SetRequiredError(bLogInMethAllowed := TRUE);
                end_if;
              end_if;
              // Configure Synchronisation end ********************************************************************
              InitSSW := _WaitForSynchron;
              udWaitForSynchronTimeStamp := ops.tAbsolute;
            else
              InitSSW := _FinishInitialisation;
            end_if;
            
            udTimeUntilOP := ops.tAbsolute - udInitStartTime;
            
        //*****************************************************************************              
        
        end_case;
        
      elsif (bd_Flags.bDisableInitModuleTimeOut = FALSE) &
            (ops.tAbsolute - udInitModuleTimeStamp) > udInitModuleTimeOut then
        LogError("@0568 (ECAT_Master_Base::CyWork) Timeout in CallInitModule step.");
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := _TimeoutInInit;
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;
    
//**********************************************************************************************************************************************************
    t_e_InitSSW::_WaitForSynchron: //Wait until synchron
    
      //Wait until class is synchron
      if _SyncMeasureECAT1.Synchron then
#ifdef ECAT_TRACE_VIEW_LOG  
        OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_IS_SYNCRHON,0);
#endif      
        udTimeSynchron := ops.tAbsolute - udTimeUntilOP + udInitStartTime;
        InitSSW := _FinishInitialisation;
        
      elsif ( (bd_Flags.bDisableWaitForSynchronTimeOut = FALSE) &  
              ((ops.tAbsolute - udWaitForSynchronTimeStamp) > GetWait4SynchronTimeout()) ) then
        LogError("@0569 (ECAT_Master_Base::CyWork) Timeout while waiting for synchron");
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := _TimeoutInInit;
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;

//**********************************************************************************************************************************************************
    t_e_InitSSW::_FinishInitialisation:
    
      //we're finished with initializing
      bd_Flags.bPostInitFinished := TRUE;
        
      udInitDuration := ops.tAbsolute - udInitStartTime;
      
#ifdef ECAT_TRACE_VIEW_LOG  
      OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_INIT_FINISHED,0);
#endif
      
      InitSSW := _InitFinished;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_InitFinished: //Normal cyclic work
    
      if ClassState <> _ClassOk then
      
        // Error occoured at EtherCat Master
        // Sets Slaves into error state
        SendManagerErrorToSlaves();
        
        InitSSW := _PrepareError;
        
      end_if;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_PrepareError: // do error handling and then stay in _ErrorOccured-Step
    
      //we're finished with initializing
      bd_Flags.bPostInitFinished := TRUE;
      InitSSW := _ErrorOccured;
      
      if bd_Flags.bIsRequired then
        SetRequiredError(bLogInMethAllowed := TRUE);
      else
        // The following code switches off the BUS completely. 
        // Advantage: No subsequent errors because HWK is deactivated. Disadvantage: SDOs for diagnostics are disabled!
        // For the SDOs part of the Rt must continue to run, otherwise the EtherCAT states will no longer function correctly. see OS_ECATM_UpdateCyc 
        DisconnectEvent(udMasterID:=0, evt:=NIL, EventType:=0, uiCallbackInfo:=0);
        // Deactivate Master
        StartChangeMasterState(FALSE);
        InitSSW := _ErrorOccuredWait4MasterDeactivate;
      end_if;

//**********************************************************************************************************************************************************
    t_e_InitSSW::_ErrorOccuredWait4MasterDeactivate:
    
      if GetStateChangeMasterState() <> BUSY then
        InitSSW := _ErrorOccured;
      end_if;
      
//**********************************************************************************************************************************************************
    t_e_InitSSW::_ErrorOccured: // do nothing here
      //return; //No return here otherwise realtime log messages will not be logged anymore

//**********************************************************************************************************************************************************
    t_e_InitSSW::_NotConnected: 
      
      // Disable Syncregulation if active
      if _SyncMeasureECAT1.SyncRegulationEnable then
        _SyncMeasureECAT1.SyncRegulationEnable.Write(input:=0);
        sDCInfo.SyncMeasureConfigOk := FALSE;
      end_if;
    
  end_case;
  
  //Always call all slaves (needed for SDO Handling) 
  if sSlaveInfo.udMaxSlaves then
    pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
    //Call UpdateCy of all logged in slaves
    for i:=0 to sSlaveInfo.udMaxSlaves-1 do
      
      //Check if slave should be called
      if pCurrentSlave^.pThis & pCurrentSlave^.pThis^.EtherCATState <> ECAT_STATE_NONE then
        pCurrentSlave^.pThis^.UpdateCy();
      end_if;
      
      pCurrentSlave += sizeof(t_sSlaveInfo);
    end_for;
  end_if;
  
  // Call for loggin
  _SyncMeasureECAT1.CyWork(EAX:=0);
      
  //Log messages from realtime in cyclic
  LogRtMessages();

  state := READY;

END_FUNCTION

FUNCTION ECAT_Master_Base::StartChangeMasterState
	VAR_INPUT
		EnableMasterState 	: BOOL;
	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  VAR
	  astr_threadname : ARRAY [0..30] OF CHAR;
  END_VAR
  
  retcode := BUSY;
  
  if (sChangeMasterState.bdFlags.TaskActivated = FALSE) & (sChangeMasterState.bdFlags.TaskActive = FALSE) then  // Only start thread if not active
  
    sChangeMasterState.bdFlags.TaskDone      := FALSE;
    sChangeMasterState.bdFlags.TaskActivated := TRUE;
    
    sChangeMasterState.bdFlags.EnableMaster := EnableMasterState;
    
    //Create a dynamic threadname
    sigclib_strcpy(#astr_threadname[0], "ChangeMasterStateHndl");
    sigclib_htoa(#astr_threadname[sigclib_strlen(#astr_threadname[0])], this$udint);
    
    // Needs own thread because OS call is blocking
    sChangeMasterState.mtTaskHandle := toMultiTask.CREATETHREAD(taskfunction0 := #ChangeMasterState()
                                                              , priority0     := ECATM_THREAD_PRIO_DISABLE   // priority same as background
                                                              , stackSize0    := ECATM_THREAD_STACKSIZE
                                                              , flags0        := MT_TASK_SAVETHIS
                                                              , parameter0    := THIS
                                                              , name0         := #astr_threadname[0]);
    
    retcode := READY;
    
  end_if;  

END_FUNCTION

FUNCTION ECAT_Master_Base::GetStateChangeMasterState
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  
  retcode := BUSY;
  if (sChangeMasterState.bdFlags.TaskActivated = FALSE) & (sChangeMasterState.bdFlags.TaskActive = FALSE) then
    retcode := READY;
  end_if;
  
END_FUNCTION

FUNCTION ECAT_Master_Base::ChangeMasterState

  
  sChangeMasterState.bdFlags.TaskActive    := TRUE;
  sChangeMasterState.bdFlags.TaskActivated := FALSE;
  
  sChangeMasterState.retcode := OS_ECATM_MASTER_ACTIVATE(pECAT, ecatmhdl, sChangeMasterState.bdFlags.EnableMaster);
  
  sChangeMasterState.bdFlags.TaskDone   := TRUE;
  sChangeMasterState.bdFlags.TaskActive := FALSE;  
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::Synchron::Read
  VAR_OUTPUT
    output (EAX) 	: DINT;
  END_VAR

  Synchron := _SyncMeasureECAT1.Synchron.Read();
  output := Synchron;

END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::Config_SyncMeasureECAT
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  VAR    
    _Para 	      : CmdStruct;
    _Result 	    : Results;	
    ret_code 	    : IprStates;
    pCurrentSlave : ^t_sSlaveInfo;
    i             : UDINT;
    pCTI          : ^t_s_CycTaskInfo;
    bcycidxOk     : BOOL;
  END_VAR
  
  // Get ECAT Bus period (must be called in state SAFEOP or higher)
  retcode := OS_ECATM_DC_GET_STATS(pECAT, ecatmhdl, #sDC_Stats);
  
  if retcode then
    LogValue("@056A (ECAT_Master_Base::Config_SyncMeasureECAT) Call OS_ECATM_dc_get_stats() Failed with retcode: {0}!", retcode$UDINT);
  else
  
    retcode := ECAT_RETERR_CMD_INVALID_SLV;    
    if sSlaveInfo.udMaxSlaves >= sDCInfo.udSlaveIndex then
      pCurrentSlave := sSlaveInfo.pSlaves + (sDCInfo.udSlaveIndex * sizeof(t_sSlaveInfo) );
      
      if pCurrentSlave^.pThis then
    
        // Get Cycidx from DC Slave
        _Para.uiCmd     := ECAT_M_GET_SLAVE_CYCIDX;
        _Para.aPara[0]  := 1; // Version 
        
        ret_code := pCurrentSlave^.pThis^.NewInst(#_Para,#_Result);  
        retcode := ECAT_RETERR_CMD_CYCIDX_NOTFOUND; 
        if (ret_code = READY) & (_Result.uiLng = 12) & 
           (_Result.aData[0]$DINT = ECAT_RETOK) &  
           (_Result.aData[4]$DINT = 1) then // Version
           
          sDCInfo.udCyclicIndex :=  _Result.aData[8];
          
          // Search Cycle task for the tasks in which the DC time is received 
          i         := 0;
          bcycidxOk := FALSE;
          pCTI      := pCycTaskInfo;
          while i < udNoCycTasks do
          
            if pCTI^.udCycTaskId = sDCInfo.udCyclicIndex then
              
              // _SyncMeasureECAT1.Set_PeriodTimeMaster((sDC_Stats.cyctime * 1000)$DINT ); // *1000 us => ns
              
              _SyncMeasureECAT1.Set_PeriodTimeMaster((pCTI^.udCycleTime_us * 1000)$DINT ); // *1000 us => ns

              // Start synchrone data 
              _SyncMeasureECAT1.Set_PeriodTimeOwn(newPeriodTimeOwn := (pCTI^.udCycleTime_us * 1000)$DINT );
              
              if bs_syncmodes.DCSlavemodeActive then
                _SyncMeasureECAT1.SyncRegulationEnable.Write(input:=1);//The ECAT DC will be adjusted
              else
                _SyncMeasureECAT1.SyncRegulationEnable.Write(input:=2);//The Sigmatek PLL will be adjusted
              end_if;
              
              bcycidxOk := TRUE;
              sDCInfo.SyncMeasureConfigOk := TRUE;
              retcode := ECAT_RETOK; 
              exit;
            end_if;
            
            i += 1;
            pCTI += sizeof(t_s_CycTaskInfo);

          end_while;
          
          if bcycidxOk = FALSE then
            LogValue("@056B (ECAT_Master_Base::Config_SyncMeasureECAT) Failed to find sDCInfo.cycidx: 0x{0}!", sDCInfo.udCyclicIndex);
          end_if;
        else
          LogValue("@056C (ECAT_Master_Base::Config_SyncMeasureECAT) NewInstCmd: ECAT_M_GET_SLAVE_CYCIDX Failed! ret_code = 0x{0}, return code = 0x{1}, Version = 0x{2}", ret_code$UDINT, _Result.aData[0]$UDINT, _Result.aData[4]$UDINT);
        end_if;
        
      else  // if pCurrentSlave^.pThis then
        LogValue("@056D (ECAT_Master_Base::Config_SyncMeasureECAT) Invalid sDCInfo.slvidx: 0x{0}!", sDCInfo.udSlaveIndex);
      end_if;
    
    else  // if sSlaveInfo.udMaxSlaves >= sDCInfo.udSlaveIndex then
      LogValue("@056F (ECAT_Master_Base::Config_SyncMeasureECAT) Invalid sDCInfo.slvidx: 0x{0}!", sDCInfo.udSlaveIndex);
    end_if;
  end_if;
            
END_FUNCTION


FUNCTION VIRTUAL ECAT_Master_Base::LogRtMessages
  VAR
  	bPostIt : t_b_RtMessages;
  END_VAR

  // if there are some messages to post, post them (the methods in the brackets are not the actual, but the methods were the error occured)
  if bd_LogRtMessagesInCy.PostIt then
  
    bPostIt := bd_LogRtMessagesInCy.PostIt;
  
    if bPostIt.InvalidNewInstCommandReceived  then
      LogValue("@0570 (ECAT_Master_Base::EtherCATState::NewInst) Received unknown command: 0x{0}", bd_LogRtMessagesInCy.aLogValue1[0]);
    end_if;

    if bPostIt.UnknownCallbackReceived  then
      LogValue("@0571 (ECAT_Master_Base::EtherCATState::NewInst) Received unknown callback: 0x{0}", bd_LogRtMessagesInCy.aLogValue1[1]);
    end_if;

    if bPostIt.UnknownError  then
      LogValue("@0574 (ECAT_Master_Base::UpdateRt) Unknown Error occured: 0x{0}", bd_LogRtMessagesInCy.aLogValue1[4]);
    end_if;
    
    if bPostIt.SlvTransFailed then
      LogValue("@0575 (ECAT_Master_Base::EvtCallBack) State transition of required Slave 0x{0} failed.", bd_LogRtMessagesInCy.aLogValue1[5]);
    end_if;
    
    if bPostIt.SendEvtCallInvSlv then
      LogValue("@0576 (ECAT_Master_Base::SendEvtCallBacktoSlave) Invalid slave number from Event callback! evt^.arg1 = 0x{0}", bd_LogRtMessagesInCy.aLogValue1[6]);
    end_if;

    if bPostIt.SendEvtCallInvFailed then
      LogValue("@0577 (ECAT_Master_Base::SendEvtCallBacktoSlave) NewInstCmd: ECAT_M_EVENT_CALLBACK Failed! return code = 0x{0}, Version = 0x{2}", bd_LogRtMessagesInCy.aLogValue1[7]);
    end_if;
    
    if bPostIt.SetReqErrSlv then
      LogValue("@0579 (ECAT_Master_Base::SetRequiredError) Required Error on EtherCAT Slave 0x{0}.", bd_LogRtMessagesInCy.aLogValue1[8] );
    end_if;
    
    if bPostIt.SetReqErrFailed then
      LogError("@057A (ECAT_Master_Base::SetRequiredError) Failed to raise Required Error.");
    end_if;

    if bPostIt.InitCRecvTimeout then
      LogValue("@057B (ECAT_Master_Base::EvtCallBack) Init command failed with frame timeout error. Device Index: 0x{0}",bd_LogRtMessagesInCy.aLogValue1[10]);
    end_if;
    
    if bPostIt.InitCValidWKC then
      LogValue("@057C (ECAT_Master_Base::EvtCallBack) Init command failed failed with wrong working counter. Device Index: 0x{0}",bd_LogRtMessagesInCy.aLogValue1[11]);
    end_if;
    
    if bPostIt.InitCValidLen then
      LogValue("@09C8 (ECAT_Master_Base::EvtCallBack) Init command failed with invalid frame length. Device Index: 0x{0}",bd_LogRtMessagesInCy.aLogValue1[12]);
    end_if;
    
    if bPostIt.InitCValidData then
      LogValue("@057E (ECAT_Master_Base::EvtCallBack) Init command failed during data validation. Device Index: 0x{0}",bd_LogRtMessagesInCy.aLogValue1[13]);
    end_if;
    
    if bPostIt.CycPrcStatus & bd_LogRtMessagesInCy.AlreadyPosted.CycPrcStatus = FALSE then
      LogValue("@057F (ECAT_Master_Base::UpdateRt) Invalid status of cyclic context detected: prcstatus: 0x{0}",bd_LogRtMessagesInCy.aLogValue1[14]);
      bd_LogRtMessagesInCy.AlreadyPosted.CycPrcStatus := TRUE;
    end_if;
    
    if bPostIt.DCSlaveTransFailed then
      LogValue("@0580 (ECAT_Master_Base::EvtCallBack) State transition of DC Slave 0x{0} failed.", bd_LogRtMessagesInCy.aLogValue1[15]);
    end_if;    
    
    if bPostIt.InvalidDCCyclePeriod then
      LogValue("@0581 (ECAT_Master_Base::EvtCallBack) Sync0 period of the slave 0x{0} is not a multiple or fraction of the cyclic task period",bd_LogRtMessagesInCy.aLogValue1[16]);
    end_if;
    
    if bPostIt.NoFreeReceiveFrameBuffer & bd_LogRtMessagesInCy.AlreadyPosted.NoFreeReceiveFrameBuffer = FALSE then
      LogError("@0583 (ECAT_Master_Base::EvtCallBack) No free receive frame buffer (check ecatm configuration)");
      bd_LogRtMessagesInCy.AlreadyPosted.NoFreeReceiveFrameBuffer := TRUE;
    end_if;
    
    if bPostIt.InvalidCycctx & bd_LogRtMessagesInCy.AlreadyPosted.InvalidCycctx = FALSE then
      LogError("@0922 (ECAT_Master_Base::UpdateRt) Invalid Cycctx");
      bd_LogRtMessagesInCy.AlreadyPosted.InvalidCycctx := TRUE;
    end_if;
    
    if bPostIt.TimingError_1 & bd_LogRtMessagesInCy.AlreadyPosted.TimingError_1 = FALSE then
      LogError("@0923 (ECAT_Master_Base::UpdateRt) No Data available at Send time (TimeSliceErrorIRQ)");
      bd_LogRtMessagesInCy.AlreadyPosted.TimingError_1 := TRUE;
    end_if;
    
    if bPostIt.TimingError_2 & bd_LogRtMessagesInCy.AlreadyPosted.TimingError_2 = FALSE then
      LogError("@0924 (ECAT_Master_Base::UpdateRt) Time since tick is at call of UpdateCyc(Pre) higher than allowed from the IsoStartPoint (TimeSliceErrorIRQ)");
      bd_LogRtMessagesInCy.AlreadyPosted.TimingError_2 := TRUE;
    end_if;
    
    if bPostIt.DataNotSent & bd_LogRtMessagesInCy.AlreadyPosted.DataNotSent = FALSE then
      LogError("@0925 (ECAT_Master_Base::UpdateRt) Data was not sent at the time UpdateCyc was called with (Pre) (TimeSliceError)");
      bd_LogRtMessagesInCy.AlreadyPosted.DataNotSent := TRUE;
    end_if;
    
    
    bd_LogRtMessagesInCy.PostIt := bd_LogRtMessagesInCy.PostIt AND (NOT bPostIt); // Only delete flags of messages that were posted this time.
  end_if;  
  
#ifdef ECAT_DEBUG_FRAMETIME  
  if gavg_FrameTime >= gErrorLimitFT then
    ((0)$^USINT)^ := 0;
    OS_ReportTraceEvent(pSystrace, TEVENT_USER0);
  end_if;
#endif  

END_FUNCTION


FUNCTION __CDECL VIRTUAL ECAT_Master_Base::EvtCallBack
	VAR_INPUT
		udMasterID 	: UDINT;
		evt 	: ^t_st_ecatm_evt;
		EventType 	: DINT;
		uiCallbackInfo 	: UINT;
	END_VAR
  VAR
    pCurrentSlave : ^t_sSlaveInfo;
    bLogInCallbackAllowed : BOOL;   //Shows if logging is allowed in the callback
  END_VAR
  
  //Default: Log in callback is not allowed
  bLogInCallbackAllowed := FALSE;
  //Check if we are getting called from the acyclic task --> we are allowed to log in the callback (no log if we are called in realtime to avoid RtRuntime Error)
  if (uiCallbackInfo = LSL_ECATM_ACYCLIC_TASK) then
    bLogInCallbackAllowed := TRUE;
  end_if;
  
  //Check for valid event code
  if ( (evt^.evtcode > ECATM_EVTC_FIRST) & (evt^.evtcode < ECATM_EVTC_LAST) ) then
    aCntCallBacks[evt^.evtcode] += 1;
    aCntCallBacks[ECATM_EVTC_LAST] += 1; // Use Last index for global cnt
  else
    //We received an unknown event
    udUnknownEventCallback += 1;
    
    if bLogInCallbackAllowed = FALSE THEN
      //Log in cyclic
      bd_LogRtMessagesInCy.aLogValue1[1] := (evt^.evtcode)$UDINT;
      bd_LogRtMessagesInCy.PostIt.UnknownCallbackReceived := TRUE;
    else
      HWC_LogPrintf(pThis:=this, format:="@0571 (ECAT_Master_Base::EvtCallBack) Received unknown callback: %V4", #evt^.evtcode);
      HWC_LogPrintf(pThis:=this, format:="@0571 arg1: %d, arg2: %d, arg3: %d, arg4: %d", #evt^.arg1, #evt^.arg2, #evt^.arg3, #evt^.arg4);
    end_if;
  end_if;
  
#ifdef ECAT_TRACE_VIEW_LOG  
  OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_EVTCALLBACK,evt^.evtcode$UDINT);
#endif
  
  case evt^.evtcode of
//*******************************************************************************************************************************************************
    ECATM_EVTC_BUSY:
    //Function can currently not be performed. Try again. 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Function can currently not be performed. Try again");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ERR_PARAM:
    //Wrong parameter value 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Wrong parameter value");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ERR_BUFSIZE:
    //Buffer size is too small 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Buffer size is too small");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ERR_NOT_SUPPORTED:
    //Operation is not supported 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Operation is not supported");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ERR_TIMEOUT:
    //Timeout error 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Timeout error");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_MEM_ALLOC:
    //Memory allocation failed 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Memory allocation failed");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ENI_ERR:      
    //Error during ENI parsing (see eceni_file.h) 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Error during ENI parsing (see eceni_file.h) ");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ENI_WARN:
    //Warning during ENI parsing (see eceni_file.h) 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Warning during ENI parsing (see eceni_file.h) ");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_CYC_PRCSTATUS_CHG:
    //Cyclic process status changed
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS      
      LogValue(pString:="ECAT-DEBUG: Cyclic process status changed. New status 0x{0}, Old status 0x{1} ", Value:= evt^.arg2$t_stb_ecatm_prcstat, Value2 := lastPRCStatus);
#endif

    if ( (lastPRCStatus.LINK_ERROR = TRUE) & 
         (evt^.arg2$t_stb_ecatm_prcstat.LINK_ERROR = FALSE) ) then
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: New Link found.");      
#endif
      ConnectEvent(udMasterID, evt, EventType, uiCallbackInfo);
      
    end_if;

    lastPRCStatus := evt^.arg2$t_stb_ecatm_prcstat;
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_CYC_NOT_DESTROYED:
    //At least one cyclic task is not destroyed 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: At least one cyclic task is not destroyed");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_CYC_ERR_NO_RCV_TS:
    //The receive time stamp was not provided by the link layer or is marked as invalid. 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: The receive time stamp was not provided by the link layer or is marked as invalid.");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_CYC_ERR_NO_SND_TS:
    //The send time stamp was not provided by the link layer or is marked as invalid.
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: The send time stamp was not provided by the link layer or is marked as invalid.");
#endif
        
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_CFG:
    //Process variable configuration does not match to the function 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Process variable configuration does not match to the function ");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_ID:
    //iovarid is invalid 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: iovarid is invalid");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_PDO:
    //iovarpdo is invalid 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: iovarpdo is invalid");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_NAME:
    //iovarname is invalid     
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: iovarname is invalid");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_CYCIDX:
    //Cyclic task index is invalid
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Cyclic task index is invalid");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_NO_DATA:
    //No input process image is available 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: No input process image is available");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_IOVAR_BAD_CRC:
    //invalid crc
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: invalid crc");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_NO_ENICFG:
    //No ENI configuration loaded 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: No ENI configuration loaded");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_ENI_LOADED:
    //ENI shall get linked while another ENI configuration is still linked 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: ENI shall get linked while another ENI configuration is still linked");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_ACTIVATED:
    //Master is activated 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Master activated");
      LogValue("ECAT-DEBUG:Master activated after 0x{0}ms", (ops.tAbsolute-udInitStartTime));
#endif
      
//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_DEACTIVATED:
    //Master is deactivated 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Master deactivated");
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_STATE_CHANGE:
    //Master ESM transition succeeded 
    //arg1 ... old state
    //arg2 ... new state
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Master State transition succeeded. Old State: 0x{0}, New State: 0x{1}", evt^.arg1$UDINT, evt^.arg2$UDINT);
#endif
      
      if evt^.arg2$t_e_ECAT_STATE <= ECAT_STATE_INIT then
        _SyncMeasureECAT1.Reset_Measurement();
      end_if;
      
      NewMasterEtherCATState := evt^.arg2$t_e_ECAT_STATE;
      
//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_TRANS_FAILED:
    //Master ESM transition failed 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Master State transition failed. State transition: 0x{0} to 0x{1}, error code: 0x{2}", evt^.arg1$UDINT, evt^.arg2$UDINT,evt^.arg3$UDINT);
#endif

      //Error during initialisation
      if bd_Flags.bPostInitFinished = FALSE then
        ErrorInitStep := InitSSW;
        InitSSW := _PrepareError;
        ClassState := _ManagerError;
        EtherCATState := ECAT_STATE_NONE; 
      else
        if bd_Flags.bIsRequired then
          SetRequiredError( bLogInMethAllowed := bLogInCallbackAllowed);
        end_if;
      end_if;

//*******************************************************************************************************************************************************
    ECATM_EVTC_MST_ACTIVATE_ERR:
    //Master activation request failed. Master is de-activated.  
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Master activation request failed. Master is de-activated.");
#endif

//*******************************************************************************************************************************************************

    ECATM_EVTC_MST_ESM_TMO:
    //Timeout for the synchronization of the acyclic task and the cyclic tasks during an ESM
    //transition. See also the transition flag ECATM_TRANS_IGNORE_WKC_SO. 

#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Timeout for the synchronization of the acyclic task and the cyclic tasks during an ESM transition");
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_SLV_STATE_CHANGE:
    //Slave ESM transition succeeded 
      
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Slave State of Slave 0x{0} changed. Old State: 0x{1}, New State: 0x{2}", evt^.arg1$UDINT, evt^.arg2$UDINT, evt^.arg3$UDINT);
#endif

      //Forward callback to slave
      SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_SLV_TRANS_FAILED:
    //Slave ESM transition failed 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Slave State transition of Slave 0x{0} failed. Old State: 0x{1}, New State: 0x{2}", evt^.arg1$UDINT, evt^.arg2$UDINT, evt^.arg3$UDINT);
      LogValue("ECAT-DEBUG: Error Event Code: 0x{0} ", evt^.arg4$UDINT);
#endif

      //Forward callback to slave
      SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      
      if evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves then
        pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo));
        
        //Check if slave was required
        if pCurrentSlave^.bRequired = TRUE then
          
          if bLogInCallbackAllowed then
            LogValue("@0575 (ECAT_Master_Base::EvtCallBack) State transition of required Slave 0x{0} failed.",evt^.arg1$UDINT);
          else
            bd_LogRtMessagesInCy.PostIt.SlvTransFailed := TRUE;
            bd_LogRtMessagesInCy.aLogValue1[5]         := evt^.arg1$UDINT;
          end_if;
          
          SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                          , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                          , bLogInMethAllowed := bLogInCallbackAllowed);
                          
        elsif sDCInfo.DCModuleEnabled = TRUE & pCurrentSlave^.udSlaveIndex = sDCInfo.udSlaveIndex then
        
          if bLogInCallbackAllowed then
            LogValue("@0580 (ECAT_Master_Base::EvtCallBack) State transition of DC Module 0x{0} failed.",evt^.arg1$UDINT);
          else
            bd_LogRtMessagesInCy.PostIt.DCSlaveTransFailed := TRUE;
            bd_LogRtMessagesInCy.aLogValue1[15]         := evt^.arg1$UDINT;
          end_if;        
        
          //DC Module is active but transition failed --> Set master into an error state
          ClassState := _ManagerError;
          EtherCATState := ECAT_STATE_NONE; 
          InitSSW := _PrepareError;
          
        end_if;
          
          // Loggin else already done in SendEvtCallBacktoSlave
//      else          
//        //Invalid slave no

      end_if;
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_SLV_ACKERR_FAILED:
    //Slave error indication acknowledgment failed 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Slave error indication acknowledgment failed. Slave Index 0x{0}, ErrorCode: 0x{1}", evt^.arg1$UDINT, evt^.arg2$UDINT);
#endif
    
      //Forward callback to slave
      SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      
//*******************************************************************************************************************************************************
    ECATM_EVTC_ESM_BAD_CUR_STATE:
    //State request failed because of bad current state 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: State request failed because of bad current state.");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ESM_BAD_REQ_STATE:
    //Requested state does not exist 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: Requested state does not exist.");
#endif
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_ESM_REQ_BUSY:
    //ESM is currently performing a transition 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogError("ECAT-DEBUG: ESM is currently performing a transition.");
#endif
//*******************************************************************************************************************************************************
    ECATM_EVTC_INITC_RCV_TMO:
    //Init command failed with frame timeout error 
    
    //arg1 ... device index: int 
    //arg2 ... init cmd id: int 
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Init command failed with frame timeout error. Device Index: 0x{0}, Init cmd id: 0x{1}",evt^.arg1$UDINT, evt^.arg2$UDINT);
#endif
    
      //Forward callback to slave
      if evt^.arg1 >= 0 then  // device index -1 = Master 
        SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      end_if;
      
      if bLogInCallbackAllowed then
        LogValue("@057B (ECAT_Master_Base::EvtCallBack) Init command failed with frame timeout error. Device Index: 0x{0}, Init cmd id: 0x{1}",evt^.arg1$UDINT, evt^.arg2$UDINT);
      else
        bd_LogRtMessagesInCy.PostIt.InitCRecvTimeout  := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[10]           := evt^.arg1$UDINT;
      end_if;

      if (evt^.arg1 >= 0) & (evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves) then
        pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo));
                
        //Check if slave was required
        if pCurrentSlave^.bRequired = TRUE then
          
          
          SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                          , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                          , bLogInMethAllowed := bLogInCallbackAllowed);
        end_if;
          
          // Loggin else already done in SendEvtCallBacktoSlave
//      else
//        //Invalid slave no

      end_if;
    
//*******************************************************************************************************************************************************
    ECATM_EVTC_INITC_VALID_WKC:
    //Init command failed with wrong working counter 
        
    //arg1 ... device index: int 
    //arg2 ... init cmd id: int 
    //arg3 ... received WKC: int 
    //arg4 ... expected WKC: int 
    //txt ... Comment of init command in ENI file

#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Init command failed with wrong working counter. Device Index: 0x{0}",evt^.arg1$UDINT);
      LogValue("ECAT-DEBUG: init cmd id: 0x{0}, received WKC: 0x{1}, expected WKC: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
      LogError(#evt^.txt[0]);
#endif
      
      if evt^.arg1 = -1 then  // If Master
        ClassState := _WrongHardware;
      end_if;

      //Forward callback to slave
      if evt^.arg1 >= 0 then // device index -1 = Master 
        SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      end_if;
      
      if bLogInCallbackAllowed then
        if evt^.arg1 = -1 then  // If Master
          LogError("@057C (ECAT_Master_Base::EvtCallBack) Init command failed with wrong working counter. Device: Master");
        else
          LogValue("@057C (ECAT_Master_Base::EvtCallBack) Init command failed with wrong working counter. Device Index: 0x{0}",evt^.arg1$UDINT);
        end_if;
        LogValue("@057C: init cmd id: 0x{0}, received WKC: 0x{1}, expected WKC: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
        HWC_LogPrintf(pThis:=this, format:="@057C: %s", p0:=#evt^.txt[0]);
      else
        bd_LogRtMessagesInCy.PostIt.InitCValidWKC   := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[11]         := evt^.arg1$UDINT;
      end_if;

      if (evt^.arg1 >= 0) & (evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves) then
        pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo));
                
        //Check if slave was required
        if pCurrentSlave^.bRequired = TRUE then
          
          SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                          , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                          , bLogInMethAllowed := bLogInCallbackAllowed);
        end_if;
          
          // Loggin else already done in SendEvtCallBacktoSlave
//      else
//        //Invalid slave no

      end_if;
        
//*******************************************************************************************************************************************************
    ECATM_EVTC_INITC_VALID_LEN:
    //Init command failed with invalid frame length 
    
    //arg1 ... device index: int 
    //arg2 ... init cmd id: int 
    //arg3 ... received length
    //arg4 ... expected length
    //txt ... Comment of init command in ENI file
 
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Init command failed with invalid frame length. Device Index: 0x{0}",evt^.arg1$UDINT);
      LogValue("ECAT-DEBUG: init cmd id: 0x{0}, received length: 0x{1}, expected length: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
      LogError(#evt^.txt[0]);
#endif
 
      //Forward callback to slave
      if evt^.arg1 >= 0 then // device index -1 = Master 
        SendEvtCallBacktoSlave(udMasterID, evt, EventType, uiCallbackInfo);
      end_if;
      
      if bLogInCallbackAllowed then
        LogValue("@09C8 (ECAT_Master_Base::EvtCallBack) Init command failed with invalid frame length. Device Index: 0x{0}",evt^.arg1$UDINT);
        LogValue("@09C8: init cmd id: 0x{0}, received length: 0x{1}, expected length: 0x{2}",evt^.arg2$UDINT, evt^.arg3$UDINT, evt^.arg4$UDINT);
        HWC_LogPrintf(pThis:=this, format:="@09C8: %s", p0:=#evt^.txt[0]);
      else
        bd_LogRtMessagesInCy.PostIt.InitCValidLen := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[12]         := evt^.arg1$UDINT;
      end_if;

      if (evt^.arg1 >= 0) & (evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves) then
        pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo));
                
        //Check if slave was required
        if pCurrentSlave^.bRequired = TRUE then
          
          
          SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                          , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                          , bLogInMethAllowed := bLogInCallbackAllowed);
        end_if;
          
          // Loggin else already done in SendEvtCallBacktoSlave
//      else
//        //Invalid slave no

      end_if; 
 
