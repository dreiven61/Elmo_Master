	FrameTimeMaxTask0.pMeth			:= StoreMethod( #M_RD_DIRECT(), #M_WR_DIRECT() );
	IF FrameTimeMaxTask0.pMeth THEN
		ret_code	:= C_OK;
	ELSE
		ret_code	:= C_OUTOF_NEAR;
		RETURN;
	END_IF;
	Min_RtTime.pMeth			:= StoreMethod( #M_RD_DIRECT(), #M_WR_DIRECT() );
	IF Min_RtTime.pMeth THEN
		ret_code	:= C_OK;
	ELSE
		ret_code	:= C_OUTOF_NEAR;
		RETURN;
	END_IF;
	Max_RtTime.pMeth			:= StoreMethod( #M_RD_DIRECT(), #M_WR_DIRECT() );
	IF Max_RtTime.pMeth THEN
		ret_code	:= C_OK;
	ELSE
		ret_code	:= C_OUTOF_NEAR;
		RETURN;
	END_IF;
	ret_code	:= ECAT_Master_Base();

END_FUNCTION

#pragma usingLtd ECAT_Slave_Base

//{{LSL_IMPLEMENTATION
#pragma UsingLtd ECAT_Slave_Base

//Has to be activated in HwControl.h
#ifdef ECAT_DEBUG
  #pragma message("***************************************")  
  #pragma message("EtherCAT Debug is activated")
  #pragma message("***************************************")  
#endif

#ifdef ECAT_DEBUG_FRAMETIME
VAR_GLOBAL
  ga_FrameTime : array [0..99] of UDINT;
  gavg_FrameTime : UDINT;
  gindexFrameTime : DINT;
  gsum_FrameTime : UDINT;
  gErrorLimitFT : UDINT;
END_VAR
#endif

FUNCTION __CDECL ECAT_MapPDOData
VAR_INPUT 
  pThis     : pVirtualBase;
  p_cycctx  : ^t_st_ecatm_cycctx;
  noData    : DINT;
  iovar     : ^t_st_eceni_iovar;
  pData     : ^DINT;
END_VAR;

FUNCTION ECAT_Master_Base::ECAT_Master_Base
  VAR_OUTPUT
    ret_code 	: ConfStates;
  END_VAR
  
  EtherCATState           := ECAT_STATE_INIT;
  NewMasterEtherCATState  := ECAT_STATE_INIT;
  ClassState              := _NotInitialized;
  
#ifdef HWC_LogInit
  HWC_LogInit();
#else
  #pragma message("Warning! Log and trace messages of this class require a newer version of class HwControl. Please update for full functionality!")
#endif
  
  ret_code := C_OK;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::Init
VAR
  i             : UDINT;
  retcode       : DINT;
  str           : array [0..255] of char;
  pCTI          : ^t_s_CycTaskInfo;
  pCurrentSlave : ^t_sSlaveInfo;
  tempCmd       : CmdStruct;
  _result       : results;
  LowestTaskPrio : DINT;
  IndexLowPrio   : UDINT;
END_VAR

  us_InitCnt += 1;
    
  if EtherCATState = ECAT_STATE_INIT then
    
    case us_InitCnt of
//**********************************************************************************************************************************************************    
      1 :
      
        //get pointer for ECAT function
        pECAT := GetCILInterface_ECAT.GetCILECAT();

        if pECAT = NIL then
          LogError("@0543 (ECAT_Master_Base::ECAT_Master_Base) Failed to get ECATM OS-Interface. A newer OS is necessary to use ECAT");
          // Disable Class
          ClassState    := _ComponentNotExists;    
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;      
      
#ifdef ECAT_TRACE_VIEW_LOG
        OS_CILGet("SYSTRACE", #pSystrace$void);
        
        //AddTraceKeyVal is only supported with RTK and Salamander with the new kernel ( >= 9.3.0)
        if ( _RtOSVersion < 16#9100 ) | ( _RtOSversion >= 0x9300 ) then
      
          //Add Trace key values for a better visualisation in trace view
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_PRESCAN_UPDATECYC,              "ECAT_Master_Base - Prescan: Call Update Cyc (lock)");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_PRESCAN_CALLBACKS,              "ECAT_Master_Base - Prescan: Call Slave callbacks");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_PRESCAN_UPDATECYC_UNLOCK,       "ECAT_Master_Base - Prescan: Call Update Cyc (unlock)");
          
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTSCAN_UPDATECYC,             "ECAT_Master_Base - Postscan: Call Update Cyc (unlock)");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTSCAN_CALLBACKS,             "ECAT_Master_Base - Postscan: Call Slave callbacks");
                    
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTINIT_START_INIT,            "ECAT_Master_Base - PostInit: Start Init");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTINIT_CALL_INITMODULE,       "ECAT_Master_Base - PostInit: Call InitModule");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTINIT_CHECK_ETHERCAT_STATE,  "ECAT_Master_Base - PostInit: Check EtherCAT State");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTINIT_IS_SYNCRHON,           "ECAT_Master_Base - PostInit: Is Syncrhon");
          OS_AddTraceKeyVal(pSystrace, TRECGRP_USER0, ECAT_SYSTRACE_POSTINIT_INIT_FINISHED,         "ECAT_Master_Base - PostInit: Init finished");         
        end_if;        
#endif

#ifdef ECAT_DEBUG_FRAMETIME
        _memset(dest:=#ga_FrameTime[0], usByte:=0, cntr:= sizeof(ga_FrameTime) );
        gavg_FrameTime  := 0;
        gindexFrameTime := 0;
        gsum_FrameTime  := 0;
        gErrorLimitFT   := 16#FFFFFFFF;
#endif
        
        //Check if CPU has EtherCAT activated
        retcode := OS_ECATM_GET_MASTER_COUNT(pECAT,#udEtherCATMasterCount);

        MasterID := MasterID.Read();

        //Check MasterID
        if retcode = ECATM_OK then
          
          if udEtherCATMasterCount = 0 then
            LogError("@0544 (ECAT_Master_Base::Init) CPU has no activated EtherCAT Master! Unable to continue with Initialisation");
            // Disable Class
            InitError     := _ComponentNotExists;
            EtherCATState := ECAT_STATE_NONE;
            return;

          elsif MasterID > udEtherCATMasterCount then
            LogValue("@0545 (ECAT_Master_Base::Init) Client MasterID is invalid. MasterID = 0x{0}, EtherCATMasterCount = 0x{1}", MasterID, udEtherCATMasterCount);
            // Disable Class
            InitError    := _InvalidConfguration;            
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
        else
          LogValue("@0547 (ECAT_Master_Base::Init) Failed to get EtherCAT master count. Retcode = 0x{0}. Unable to continue with Initialisation", ABS(retcode)$UDINT);
          // Disable Class
          InitError    := _ComponentNotExists;          
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        //start Berste1

      
        SynchronizationMode := SynchronizationMode.Read();
        
        if SynchronizationMode = 0 | SynchronizationMode = 1 then
          
          //PLC wird auf ECAT DC aufgeregelt
          
          //Check if PLL is free
          tempCmd.uiCmd := CMD_HWC_REQ_PLLNS_REGULATION;
          tempCmd.aPara[0] := 1;//Version
  
          if ToHwControl.NewInst(#tempCmd, #_result) = READY then
            
            if _result.aData[0]$DINT > 1 | _result.aData[4]$t_HWCRetvalReturnCode <> _HWC_RETVAL_OK then
              LogError("@0543 (ECAT_Master_Base::Init) SyncRegulation is not available ");
              // Disable Class
              SynchronizationMode := -1;
              
              InitError    := _InvalidConfguration;            
              EtherCATState := ECAT_STATE_NONE;
              return;
            end_if;
          else
            LogValue("@0547 (ECAT_Master_Base::Init) Failed to request SoftSync. Retcode = 0x{0}. Unable to continue with Initialisation", ABS(retcode)$UDINT);
            // Disable Class
            InitError    := _ComponentNotExists;          
            EtherCATState := ECAT_STATE_NONE;
            return;     
          end_if;
          
          if SynchronizationMode = 1 then
            bs_Syncmodes.TimestampingActive := TRUE;
          end_if;         
          
          bs_Syncmodes.DCSlavemodeActive := FALSE;
        else
          bs_Syncmodes.TimestampingActive := TRUE;
          bs_Syncmodes.DCSlavemodeActive := TRUE;
        end_if;
        
        _SyncMeasureECAT1.UpdateDCStatus(bs_Syncmodes);
        
//end BERSTE1        
              
        // Set Event Callback     ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++        
        
        // INFO_CALLBACK: Callbacks may be received immediately after setting the callback method because EtherCAT Master may run on a different core!
        // INFO_CALLBACK: As of 15.07. Slave callback (search for SendEvtCallBacktoSlave) are not called until the first call to OS_ECATM_MST_REQ_STATE in the PostInit.
        // INFO_CALLBACK: This guarantees that the data structure needed in SendEvtCallBacktoSlave are initialized, before the 1st callback is received.
        
        //We have to install the EventCallback before we call the ENI_Load function otherwise we wouldn't get every callback (e.g. ECATM_EVTC_DC_FOUND)
        retcode := OS_ECATM_SetEventCallback(pECAT, MasterID, #EvtCallBack(), this, ECATM_EVTT_ST_INFO); // Info is needed for information on the syncunit, ECATM_EVTC_DC_FOUND
        if retcode <> ECATM_OK then
          LogValue("@054B (ECAT_Master_Base::Init) Call OS_ECATM_SetEventCallback() Failed with retcode 0x{0}! Unable to continue with Initialisation", ABS(retcode)$UDINT);
          // Disable Class
          InitError     := _ManagerError;          
          EtherCATState := ECAT_STATE_NONE;
          return;        
        end_if;        
        
        if IsClientConnected(#ENIFile) then
          ENIFile.TxtGet(pdst:=#str[0], dstsize:=sizeof(str));
          
          //Check if it is a valid string
          if sigclib_strlen(str:=#str[0]) = 0 then
            LogError("@08E7 (ECAT_Master_Base::Init) Invalid string connected to client ENIFile. Unable to continue with Initialisation");
            // Disable Class
            InitError    := _ManagerError;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;

        else
          //Load standard ENI File (is generated by Lasal and saved in the standard folder on the PLC)
          _strcpy(dest:=#str[0], src:=ECATM_STR_ENI_FILE);
        end_if;
        
        //Load the ENI File and get pointer to EtherCAT master stack from OS (ecatmhdl) ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        retcode := OS_ECATM_ENI_Load(pECAT, #ecatmhdl, #str[0], MasterID);
        if retcode <> 0 then
          HWC_LogPrintf(pThis:=this, format:="@054C (ECAT_Master_Base::Init) Call OS_ECATM_ENI_Load() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError    := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
         //Limit Isostartpoint
        IsoStartPoint := IsoStartPoint.Read();
        if( IsoStartPoint < 10 )then
          IsoStartPoint := 50;
        end_if;
        if( IsoStartPoint > 90 )then //Master shift is minimum 10 %
          IsoStartPoint := 50;
        end_if; 
        
        _SyncMeasureECAT1.SetECATMasterHandle(newecatmhdl := ecatmhdl
                                            , IsoStart    := IsoStartPoint );
        
        
        
        // Get master information ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        retcode := OS_ECATM_get_info(pECAT, ecatmhdl, #sMasterInfo$pVoid);
        if retcode <> ECATM_OK then
          HWC_LogPrintf(pThis:=this, format:="@054D (ECAT_Master_Base::Init) Call OS_ECATM_get_info() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError     := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        if sMasterInfo$pVoid <> NIL then
          strSoftwareVersion.TxtSet(dstchrsize:=1, psrc:=sMasterInfo.ver_ecatm, srcchrsize:=1);
        end_if;
        
        
        //ECAT Master deactivate, to write the DC settings 
        retcode := OS_ECATM_MASTER_ACTIVATE(pECAT, ecatmhdl, FALSE);
        if retcode <> ECATM_OK then
          HWC_LogPrintf(pThis:=this, format:="@09C7 (ECAT_Master_Base::Init) Call OS_ECATM_MASTER_ACTIVATE() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError     := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        // Get DC Config +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        retcode := OS_ECATM_dc_get_config(pECAT, ecatmhdl, #sDCCfg);
        if retcode <> ECATM_OK then
          HWC_LogPrintf(pThis:=this, format:="@06FC (ECAT_Master_Base::Init) Call OS_ECATM_dc_get_config() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError    := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        // Set DC Config +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        sDCCfg.mst_shift := to_DINT(100 - IsoStartPoint);
        
        if bs_Syncmodes.DCSlavemodeActive then
          sDCCfg.dcmode    := ECATM_DC_CFG_MODE_SLV_LL_TS;
        else
          sDCCfg.dcmode    := ECATM_DC_CFG_MODE_MST;
        end_if;
                              //ECATM_DC_CFG_MODE_NO_DC        
        
        
        retcode := OS_ECATM_dc_set_config(pECAT, ecatmhdl, #sDCCfg);
        if retcode <> ECATM_OK then
          HWC_LogPrintf(pThis:=this, format:="@06FD (ECAT_Master_Base::Init) Call OS_ECATM_dc_set_config() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError    := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        
        //ECAT Master reactivate
        retcode := OS_ECATM_MASTER_ACTIVATE(pECAT, ecatmhdl, TRUE);
        if retcode <> ECATM_OK then          
          HWC_LogPrintf(pThis:=this, format:="@09C7 (ECAT_Master_Base::Init) Call OS_ECATM_MASTER_ACTIVATE() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError     := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        bd_Flags.bMasterActive := TRUE;

        // Get Cyc and Slave numbers +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        retcode := OS_ECATM_eni_get_cfg_info(pECAT, ecatmhdl, #sENIFileConfig$pVoid);
        if retcode <> ECATM_OK then
          HWC_LogPrintf(pThis:=this, format:="@054E (ECAT_Master_Base::Init) Call OS_ECATM_eni_get_cfg_info() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
          // Disable Class
          InitError    := _ManagerError;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
        
        // Reserve memory for slaves ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        if sENIFileConfig^.numslv then
          
          sSlaveInfo.udMaxSlaves    := sENIFileConfig^.numslv$UDINT;
          sSlaveInfo.pSlaves$pVoid  := ToStdLib.Malloc( size:= sizeof(t_sSlaveInfo) * sSlaveInfo.udMaxSlaves );
          
          if sSlaveInfo.pSlaves = NIL then
            LogError("@054F (ECAT_Master_Base::Init) Failed to allocate memory for ECAT slave Info! Unable to continue with Initialisation");
            // Disable Class
            InitError    := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
          
          _memset(dest:=sSlaveInfo.pSlaves, usByte:=0, cntr:= sizeof(t_sSlaveInfo) * sSlaveInfo.udMaxSlaves);          
        else
          LogError("@0551 (ECAT_Master_Base::Init) Zero slaves specified in EniFile. Unable to continue with Initialisation");
          // Disable Class
          InitError    := _InvalidConfguration;                                
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
                
        // Init cyc tasks +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        if sENIFileConfig^.numcyc then
        
          udNoCycTasks := sENIFileConfig^.numcyc$UDINT;
          
          pCycTaskInfo$pVoid  := ToStdLib.Malloc( size    := sizeof(t_s_CycTaskInfo) * (udNoCycTasks));
          
          if pCycTaskInfo = NIL then
            LogError("@0552 (ECAT_Master_Base::Init) Failed to allocate memory for cyc tasks. Unable to continue with Initialisation");
            // Disable Class
            InitError    := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
          
          _memset(dest:=pCycTaskInfo, usByte := 0, cntr := sizeof(t_s_CycTaskInfo) * (udNoCycTasks)); 
          
          pCTI := pCycTaskInfo;
          
          LowestTaskPrio := 65; //invalid only Prio 1-62 possible
          IndexLowPrio   := 0;  
          
          // Get Cyc task infos
          for i := 1 to udNoCycTasks do
            retcode := OS_ECATM_eni_get_cyc_info(pECAT, ecatmhdl, (i-1)$DINT, (#pCTI^.eceni_cyc_info)$pVoid);
            if retcode <> ECATM_OK then
              HWC_LogPrintf(pThis:=this, format:="@0553 (ECAT_Master_Base::Init) Call OS_ECATM_eni_get_cyc_inf() Failed with retcode %d! Unable to continue with Initialisation", p0 := #retcode);
              // Disable Class
              InitError    := _ManagerError;
              EtherCATState := ECAT_STATE_NONE;
              return;
            end_if;
            
            //Point to next Cyclic Task info
            pCTI^.pNext := pCTI + sizeof(t_s_CycTaskInfo);
            pCTI^.udCycTaskId     := i-1;
            
            if pCTI^.eceni_cyc_info then
              pCTI^.udCycleTime_us  := pCTI^.eceni_cyc_info^.cyctime$UDINT;
              
              //Calculate iso start point for every cyclic task
              pCTI^.udIsoStartPoint := (IsoStartPoint * pCTI^.udCycleTime_us/100);
                            
            else
              LogError("@0554 (ECAT_Master_Base::Init) Pointer pCTI^.eceni_cyc_info is invalid! Unable to continue with Initialisation");
              // Disable Class
              InitError    := _ManagerError;                        
              EtherCATState := ECAT_STATE_NONE;
              return;
            end_if;
            
            
            //berste1: search for the task with the lowest Priority            
            if pCTI^.eceni_cyc_info^.priority < LowestTaskPrio then
              LowestTaskPrio := pCTI^.eceni_cyc_info^.priority;
              IndexLowPrio   := i;
            end_if;
            
            
#ifdef ECAT_DEBUG_TIMEMEASURE
            // Init Values for Time Measurment
            pCTI^.ud_TimePreMin   := 16#FFFFFFFF;
            pCTI^.ud_TimePostMin  := 16#FFFFFFFF;
#endif
            //Set init value for time measurement
            pCTI^.sFrameTimes.udEtherCATFrameTimeMin := 16#FFFFFFFF;
            Min_RtTime := 16#FFFFFFFF;
            
            pCTI^.bPostScanActive := FALSE; // Set in InstallCallback if needed
            
            //Calculate minimal cyclic time (is used as setting for login at HwControl)
            udMinCycTime := CalculateGGT(Var1 := udMinCycTime, Var2 := pCTI^.udCycleTime_us);
            
            if udMinCycTime < _ClockTicks then
              LogValue("@0555 (ECAT_Master_Base::Init) Minimal Cyclic time 0x{0} is smaller than maintimer 0x{1}. Unable to continue with Initialisation",udMinCycTime,_ClockTicks);
              // Disable Class
              InitError    := _InvalidConfguration;
              EtherCATState := ECAT_STATE_NONE;
              return;
            end_if;

            
            pCTI += sizeof(t_s_CycTaskInfo);  
          end_for;
          
          pCTI -= sizeof(t_s_CycTaskInfo);
          pCTI^.pNext := NIL; //Last one has no next pointer
          
          if IndexLowPrio then
            pCTI := pCycTaskInfo + (IndexLowPrio - 1) * sizeof(t_s_CycTaskInfo);            
            pCTI^.b_SyncTask := TRUE;
            
          end_if;  
                              
        else
          LogError("@0556 (ECAT_Master_Base::Init) Zero cyc tasks specified in EniFile. Unable to continue with Initialisation");
          // Disable Class
          InitError    := _InvalidConfguration;                    
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;        

//**********************************************************************************************************************************************************
      2:
          //Login slave slots to slot manager ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

//**********************************************************************************************************************************************************
      3:  
          //Login EtherCAT slave to master ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
          
//**********************************************************************************************************************************************************  
      4:
        
        // Master distributes EtherCAT Slave Info from Eni File
        
        if sSlaveInfo.udLoggedInSlaves = 0 then
          LogError("@067A (ECAT_Master_Base::Init) No EtherCAT Slave objects projected/connected to the EtherCAT Master. Unable to continue with Initialisation");
          ClassState := _NoHardware;
          InitError    := _InvalidConfguration;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;

        //Go through every slave and get slave info
        if sSlaveInfo.udMaxSlaves then
          pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave

          for i:=0 to sSlaveInfo.udMaxSlaves-1 do
            
            //Go through every slave and get info
            retcode := OS_ECATM_eni_get_slv_info(pECAT, ecatmhdl, pCurrentSlave^.udSlaveIndex, #pCurrentSlave^.pSlaveInfo);
            
            //Set correct next pointer
            pCurrentSlave^.pNext := pCurrentSlave + sizeof(t_sSlaveInfo);
                      
            if retcode then
              LogValue("@0557 (ECAT_Master_Base::Init) Call OS_ECATM_eni_get_slv_info() for Slave 0x{0} failed with retcode 0x{1}! Unable to continue with Initialisation",pCurrentSlave^.udSlaveIndex, ABS(retcode)$UDINT);
              // Disable Class
              InitError    := _ManagerError;            
              EtherCATState := ECAT_STATE_NONE;
              return;        
            end_if;
                                               
            if pCurrentSlave^.pThis then
                        
              //Distribute info to the respective slave
              tempCmd.uiCmd := ECAT_M_SET_SLAVE_INFO;
              
              tempCmd.aPara[0] := 1;  //Version of set slave info command
              tempCmd.aPara[1] := (pCurrentSlave^.pSlaveInfo)$DINT;
                        
              //Forward info to class
              if pCurrentSlave^.pThis^.NewInst(#tempCmd,#_result) = ERROR then
                LogValue("@0558 (ECAT_Master_Base::Init) Could not set slave info for Slave 0x{0}", pCurrentSlave^.udSlaveIndex);
              end_if;
              
              tempCmd.uiCmd := ECAT_M_CHECK_SLAVE;
              tempCmd.aPara[0]$DINT := 1;  //Version of set slave info command

              tempCmd.aPara[1]$UDINT := pCurrentSlave^.pSlaveInfo^.productcode; 
              tempCmd.aPara[2]$UDINT := pCurrentSlave^.pSlaveInfo^.revisionno;  
              tempCmd.aPara[3]$UDINT := pCurrentSlave^.pSlaveInfo^.vendorid;    
              tempCmd.aPara[4]$UDINT := pCurrentSlave^.pSlaveInfo^.serialno;    
              
              if pCurrentSlave^.pThis^.NewInst(#tempCmd,#_result) = ERROR then
              
                pCurrentSlave^.pThis^.ClassState := _WrongHardware;
                pCurrentSlave^.pThis^.EtherCATState := ECAT_STATE_NONE;

                //Check if slave is required (if yes, raise error)
                if pCurrentSlave^.bRequired then
                  SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                                  , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                                  , bLogInMethAllowed := TRUE);
                end_if;
              end_if;
              
            end_if;
            pCurrentSlave += sizeof(t_sSlaveInfo);
          end_for;
          
          pCurrentSlave -= sizeof(t_sSlaveInfo);
          pCurrentSlave^.pNext := NIL;  //Last slave has no next pointer
        end_if;

//**********************************************************************************************************************************************************  
      8:

        //Set PDO Settings of Slaves
        if sSlaveInfo.udMaxSlaves then
          pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave

          for i:=0 to sSlaveInfo.udMaxSlaves-1 do
            
            if pCurrentSlave^.pThis then
              //Force module to set all PDO Settings
              retcode := pCurrentSlave^.pThis^.SetPDOSettings();
                                    
              if retcode <> 0 then
                //Failed to set PDO settings
                
                pCurrentSlave^.pThis^.ClassState := _InvalidConfguration;
                pCurrentSlave^.pThis^.EtherCATState := ECAT_STATE_NONE;
                
                //Set required Error if module is required
                if pCurrentSlave^.bRequired then
                  SetRequiredError( pTargetThis       := pCurrentSlave^.pThis
                                  , udSlaveIndex      := pCurrentSlave^.udSlaveIndex
                                  , bLogInMethAllowed := TRUE);
                end_if;
                
                InitError    := _InvalidConfguration;
                EtherCATState := ECAT_STATE_NONE;
                LogValue("@0559 (ECAT_Master_Base::Init) SetPDOSettings() failed for Slave 0x{0}", pCurrentSlave^.udSlaveIndex);
                return;
              end_if;
            end_if;
            
            pCurrentSlave += sizeof(t_sSlaveInfo);
          end_for;
        end_if;

//**********************************************************************************************************************************************************  
      12:
      
        //Read in client value
        MissingFrameBehaviour := MissingFrameBehaviour.Read();
        
        //Limit client setting to max value
        if MissingFrameBehaviour > ECATM_MAX_VALUE_MISSING_FRAME_BEHAVIOUR then
          MissingFrameBehaviour := ECATM_MAX_VALUE_MISSING_FRAME_BEHAVIOUR;
          LogError("@0707 (ECAT_Master_Base::Init) Setting of client MissingFrameBehaviour is higher than the max allowed value. Client will be set to max value!");
        end_if;
      
        // Loging to HWControl after udminCycTime has been calculated and all slaves are logged in and have installed callbacks
        if HwControlLogin() = _BUS_IF_RETVAL_OK THEN
          ClassState  := _ClassOk; 
        else
          // Disable Class
          InitError := _CallBackError;
          EtherCATState := ECAT_STATE_NONE;
          // No return so that Error handling is done in 12th init!
        end_if;
        
    end_case;
  
  end_if;
  
  if (EtherCATState = ECAT_STATE_NONE) & (bd_Flags.bMasterActive) then
  
    // Deactivate Master on error, must be done here because HwControlLogin for CyWork was not called. 
    bd_Flags.bMasterActive := FALSE;
    if pECAT & ecatmhdl then
      retcode := OS_ECATM_MASTER_ACTIVATE(pECAT, ecatmhdl, FALSE);
      if retcode <> ECATM_OK then
        HWC_LogPrintf(pThis:=this, format:="@09C7 (ECAT_Master_Base::Init) Call OS_ECATM_MASTER_ACTIVATE() Failed with retcode %d!", p0 := #retcode);
        // Don't set Error state, we deactivate the master because of another error
      end_if;
    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::HwControlLogin
	VAR_OUTPUT
		RetVal 	: t_BusIFRetvalErrorcode;
	END_VAR
  VAR
    tempCmd         : CmdStruct;
    _result         : results;
    bCheckTaskTimes : BOOL;
    i               : UDINT;
    udtmp           : UDINT;
    pCTI            : ^t_s_CycTaskInfo;
  END_VAR
  
  if pECAT then
  
//  bd_CallbackSettings.RtPreScan     := TRUE;  // Set in InstallCallback
//  bd_CallbackSettings.RtPostScan    := TRUE;  // Set in InstallCallback
    bd_CallbackSettings.PostInit      := TRUE;  // Activate postinit
    bd_CallbackSettings.Cyclic        := TRUE;  // Always needed for SDO
  
    //Needed for Post Init
    bd_Flags.bPostInitFinished := FALSE;
  
    CoreSelect := CoreSelect.Read();
  
    if CoreSelect > 0 then
      bd_CallbackSettings.CoreSelect  := TRUE;
    end_if;
    
    //Default: We have to check the tasktimes we get from HwControl
    bCheckTaskTimes := TRUE;
    
    tempCmd.uiCmd := CMD_GET_SUPPORTED_FEATURES;
    if ToHwControl.NewInst(#tempCmd, #_result) = READY then
      if _result.aData$t_HWC_SupportedFeatureBits1.CalculateTaskInfo = TRUE then
        //Feature is supported from HwControl.
        bCheckTaskTimes := FALSE;  //At the beginning of the postinit phase we get a newInst Call with the task times, so we don't have to check the times here
        bd_CallbackSettings.TimeSet := TRUE;
      end_if;      
    end_if;
  
    tempCmd.uiCmd := CMD_HWCONTROL_LOGIN;
    tempCmd.aPara[0] := THIS$DINT;
    tempCmd.aPara[1] := bd_CallbackSettings$DINT;
    tempCmd.aPara[2] := HWT_ESCAPE_ECAT;  // Escape sequence
    tempCmd.aPara[3] := CoreSelect$DINT;     // Core on which the RT and Cywork should be called from the HwControl
    tempCmd.aPara[4] := (udMinCycTime)$DINT;    // Rt-Time
    tempCmd.aPara[5] := (udMinCycTime)$DINT;    // Cy-Time
    
    if ToHwControl.NewInst(#tempCmd, #_result) = READY then
      
      //Only check once and if we have to check the times now
      if bCheckTaskTimes = TRUE then
      
        if _result.uiLng = (sizeof(ud_HwControlCyTime_us) + sizeof(ud_HwControlRtTime_us)) then
          ud_HwControlRtTime_us := _result.aData[0]$UDINT / 1000;
          ud_HwControlCyTime_us := _result.aData[4]$UDINT / 1000;
          
          pCTI := pCycTaskInfo;
          
          for i := 1 to udNoCycTasks do
           
            if pCTI^.udCycleTime_us MOD ud_HwControlRtTime_us then
              LogError("@055B (ECAT_Master_Base::HwControlLogin) CycleTime of ECAT Master Cyc-Task Manager has to be a multiple of the HwControl realtime setting!");
              RetVal := _BUS_IF_RETVAL_ERROR_BUSCYCLE_TIME_NOT_AVAILABLE;
              return;
            elsif pCTI^.udCycleTime_us > ud_HwControlRtTime_us then
              // use internal prescaler
              udtmp := (pCTI^.udCycleTime_us / ud_HwControlRtTime_us) - 1;
              pCTI^.udMaxCnt            := udtmp;
              pCTI^.udRtPreScanTigger   := udtmp;
              pCTI^.udRtPostScanTrigger := udtmp;
              
              RetVal := _BUS_IF_RETVAL_OK;
            else
              // hwcontrol time and cycletime are equal
              RetVal := _BUS_IF_RETVAL_OK;
            end_if;
          
            pCTI += sizeof(t_s_CycTaskInfo);
          end_for;
        
        else
          LogValue("@055C (ECAT_Master_Base::HwControlLogin) Response of login at HwControl has an invalid size: 0x{0}",_result.uiLng);
          RetVal := _BUS_IF_RETVAL_ERROR_NOT_SUPPORTED;
        end_if;
          
      else
        RetVal := _BUS_IF_RETVAL_OK;
      end_if;
    else
      LogError("@055D (ECAT_Master_Base::HwControlLogin) Failed to install callback at HwControl");
      RetVal := _BUS_IF_RETVAL_ERROR_NOT_SUPPORTED;
    end_if;
  end_if;

END_FUNCTION

