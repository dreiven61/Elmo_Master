FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::ClassState::NewInst
  VAR_INPUT
    pPara 	: ^CmdStruct;
    pResult 	: ^results;
  END_VAR
  VAR_OUTPUT
    ret_code 	: iprStates;
  END_VAR
  VAR
    i             : UDINT;
    udtmp         : UDINT;
    pCTI          : ^t_s_CycTaskInfo;
    pTemp : ^void;
    pStr_HWTRequested     : ^CHAR;
    tmpplace      : USINT;
    pStr_HWTreeEntry : ^CHAR;
    usNextPlace   : USINT;    
    pSlaveInfo    : ^t_sSlaveInfo;
  END_VAR  
  
  ret_code := ERROR;
  pResult^.uiLng  := 0;

  CASE pPara^.uiCmd OF

//**********************************************************************************************************************************************************
    CMD_POST_INIT_CALL: // call from hwcontrol
      
      //Just return ready here because the realtime is not running yet here (we need the realtime for our initialisation)
      ret_code := READY;

//**********************************************************************************************************************************************************
    CMD_POST_INIT_RT_SYNC:  // call from hwcontrol
      
      //In this step the realtime of HWControl is already running (is needed for state changes together with the Acyc Task from the OS)
      
#ifdef ECAT_DEBUG_NO_POST_INIT
      ret_code := READY;
#else
      ret_code := READY;
              
      //Call class (Initialisation SSW)
      CyWork(0);
      
      // post init blocks the tasks in cyclic priority (the EtherCAT master Code in the OS is running in lower priority than cyclic and has no time during the postinit) => give it some time
      ToMultiTask.TASKDELAYUS(timeout0:=ECATM_WAIT_TIME_IN_POST_INIT);
      
      // if we got an error => return it
      if InitSSW = _ErrorOccured then
        ret_code := ERROR;
      // if we want to cancel PostInit => End PostInit
      elsif bd_Flags.bPostInitCancel = TRUE then
        ret_code := READY;
      // if we're not ready, return busy
      elsif InitSSW <> _InitFinished then
        ret_code := BUSY;
      end_if;      
#endif

//**********************************************************************************************************************************************************
    CMD_POST_INIT_RT_READY: // call from hwcontrol      
           
#ifdef ECAT_DEBUG_NO_POST_INIT
      ret_code := READY;
#else
      //Just return ready, all our post init initialisation is in the RT_SYNC step
      ret_code := READY;
      
      //Call class
      CyWork(0);
      
      // post init blocks the tasks in cyclic priority (the EtherCAT master Code in the OS is running in lower priority than cyclic and has no time during the postinit) => give it some time
      ToMultiTask.TASKDELAYUS(timeout0:=ECATM_WAIT_TIME_IN_POST_INIT);
#endif

//**********************************************************************************************************************************************************
    CMD_SET_POSTINIT_DONE:
        
      ret_code := READY;
    
//**********************************************************************************************************************************************************
    CMD_EXTEND_POST_INIT_TIME:
    
      // forward it to bus interface
      ret_code := ToHwControl.NewInst(pPara, pResult);

//**********************************************************************************************************************************************************
    CMD_POST_INIT_DISTRIBUTE_TASKTIMES: // call from hwcontrol
      
      if pPara^.aPara[0]$t_Distribute_TaskTimes_Cmd.udVersion = 1 then
        
        //Save cycle times of HwControl
        ud_HwControlRtTime_us := pPara^.aPara[0]$t_Distribute_TaskTimes_Cmd.udRtTaskTime_us;
        ud_HwControlCyTime_us := pPara^.aPara[0]$t_Distribute_TaskTimes_Cmd.udCyTaskTime_us;
        
        if pCycTaskInfo then
          pCTI := pCycTaskInfo;
          
          for i := 1 to udNoCycTasks do
           
            if pCTI^.udCycleTime_us MOD ud_HwControlRtTime_us then
              LogError("@055E (ECAT_Master_Base::ClassState::NewInst) CycleTime of ECAT Master Cyc-Task Manager has to be a multiple of the HwControl realtime setting!");
              ret_code := ERROR;
              return;
            elsif pCTI^.udCycleTime_us > ud_HwControlRtTime_us then
              // use internal prescaler
              udtmp := (pCTI^.udCycleTime_us / ud_HwControlRtTime_us) - 1;
              pCTI^.udMaxCnt            := udtmp;
              pCTI^.udRtPreScanTigger   := udtmp;
              pCTI^.udRtPostScanTrigger := udtmp;
              
              ret_code := READY;
            else
              // hwcontrol time and cycletime are equal
              ret_code := READY;
            end_if;
          
            pCTI += sizeof(t_s_CycTaskInfo);
            
          end_for;
        end_if;
      else
        //Not supported version
        LogError("@0188 (ECAT_Master_Base::ClassState::NewInst) Version of CMD_POST_INIT_DISTRIBUTE_TASKTIMES not supported. Bus is running in HwControl time!");
        ret_code := ERROR;
      end_if;
      
//**********************************************************************************************************************************************************    
    ECAT_M_GET_SUPPORTED_FEATURES:
      
      //Set length to be flexible for future 
      pResult^.uiLng := 12; 
      pResult^.aData[0]$DINT  := ECATM_OK;          //Return code
      pResult^.aData[4]$DINT  := 1;                 //Version
      pResult^.aData[8]$BDINT := bdSupportedFeatures; //Supported features 
      
//**********************************************************************************************************************************************************    
    ECAT_M_INSTALL_CALLBACK:
      ret_code := InstallCallback(pPara:=pPara, pResult:=pResult);
  
//**********************************************************************************************************************************************************    
    ECAT_M_LOGIN_SLAVE:
      ret_code := LoginSlaveModule(pPara:=pPara, pResult:=pResult);

//**********************************************************************************************************************************************************    
    ECAT_M_GET_HW_PATH:
    
      ret_code  := ERROR;
      pTemp     := NIL;
      
      //Check version
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;
      if (pPara^.aPara[0]$DINT = 1) | 
         (pPara^.aPara[0]$DINT = 2) then
      
        pTemp := GetPointer2ObjectPath();
        
        if pTemp then
          pResult^.aData[0]$DINT := ECAT_RETOK;
          ret_code := READY;
        else
          pResult^.aData[0]$DINT  := ECAT_RETERR;
        end_if;
      
      end_if;
      
      if (pPara^.aPara[0]$DINT = 2) then
      
        pResult^.uiLng := 14;
        pResult^.aData[4]$DINT    := 2; //Version
        pResult^.aData[8]$^void   := pTemp;
        pResult^.aData[12]$HSINT  := 0; // 0 This is Master, Value is set by EtherCAT_Hub_Base
        pResult^.aData[13]$HINT   := 0; // 0 This is Master, Value is set by EtherCAT_Hub_Base
        
      else
        
        pResult^.uiLng := 12;
        pResult^.aData[4]$DINT  := 1; //Version
        pResult^.aData[8]$^void := pTemp;
      
      end_if;

      
//**********************************************************************************************************************************************************          
    ECAT_M_GET_ECATMHDL:
       
      ret_code  := ERROR;
      pTemp     := NIL;      
      
      //Check version
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_WRONG_MST_STATE;
        if ecatmhdl then        
          pTemp := ecatmhdl;
          pResult^.aData[0]$DINT := ECAT_RETOK;
          ret_code := READY;
        end_if;      
        
      end_if;
      
      pResult^.uiLng := 12;
      pResult^.aData[4]$DINT  := 1; //Version
      pResult^.aData[8]$^void := pTemp;
      
//**********************************************************************************************************************************************************    
    CMD_GET_HARDWARE_DIAGNOSIS:
    
      //Returns module info
      ret_code := ERROR;
      pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR;

      pStr_HWTRequested := pPara^.aPara[0]$t_HWCGetHardwareDiagnosisIn.pStr_HardewareTreeEntry;
        
      if pStr_HWTRequested & 
         ( ((pStr_HWTRequested  + pPara^.aPara[0]$t_HWCGetHardwareTreeEntryIn.us_current_index  - 1)^$USINT) = HWT_ESCAPE_ECAT ) then
        
        tmpplace := (pStr_HWTRequested+pPara^.aPara[0]$t_HWCGetHardwareDiagnosisIn.us_current_index)^$USINT;  
        
        pSlaveInfo := sSlaveInfo.pSlaves + (tmpplace * sizeof(t_sSlaveInfo));

        //Check if pointer is valid
        if pSlaveInfo & pSlaveInfo^.pThis then
          ret_code := pSlaveInfo^.pThis^.NewInst(pPara,pResult);
        else
          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_ECAT_MODULE_NOT_FOUND;
        end_if;
      end_if;
    
//**********************************************************************************************************************************************************    
    CMD_GET_HARDWARE_TREE_ENTRY:
   
      //Returns module info
      ret_code := ERROR;
      pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_ERROR;
      
      pStr_HWTreeEntry := pPara^.aPara[0]$t_HWCGetHardwareTreeEntryIn.pStr_LastHardewareTreeEntry;
      
      //First HWT Path
      if pStr_HWTreeEntry = nil then

        for i:= 0 to sSlaveInfo.udMaxSlaves -1 do 
          //Point to slave
          pSlaveInfo := sSlaveInfo.pSlaves + (i * sizeof(t_sSlaveInfo));
          
          //If we found a module, just call first logged in module here
          if pSlaveInfo^.pThis then
            exit;
          end_if;
        end_for;

        if pSlaveInfo^.pThis then
          ret_code := pSlaveInfo^.pThis^.NewInst(pPara,pResult);
        else
          pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_ERROR_ECAT_MODULE_NOT_FOUND;
        end_if;

      //search next module
      elsif ( ((pStr_HWTreeEntry  + pPara^.aPara[0]$t_HWCGetHardwareTreeEntryIn.us_current_index  - 1)^$USINT) = HWT_ESCAPE_ECAT ) then
      
        // Check last modul again incase it was an extension module        
        usNextPlace := (pStr_HWTreeEntry  + pPara^.aPara[0]$t_HWCGetHardwareTreeEntryIn.us_current_index)^$USINT;      
        
        pSlaveInfo := sSlaveInfo.pSlaves + (usNextPlace * sizeof(t_sSlaveInfo));

        if pSlaveInfo^.pThis then
        
          ret_code := pSlaveInfo^.pThis^.NewInst(pPara,pResult);
        else
          ret_code := READY;
          pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_OK_END_OF_LIST;
          return;
        end_if;
        
        // Module was found, return next one
        if ret_code = READY & 
           (pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode = _HWC_RETVAL_OK_MODULE_FOUND |
            pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode = _HWC_RETVAL_OK_END_OF_LIST) then
          
          usNextPlace += 1;  
          
          pSlaveInfo := sSlaveInfo.pSlaves + (usNextPlace * sizeof(t_sSlaveInfo));
          
          if usNextPlace > sSlaveInfo.udMaxSlaves-1 then
            ret_code := READY;
            pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_OK_END_OF_LIST;
          else
            if pSlaveInfo & pSlaveInfo^.pThis then
            
              ret_code := pSlaveInfo^.pThis^.NewInst(pPara,pResult);
            else
              ret_code := READY;
              pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_OK_END_OF_LIST;
            end_if;
          end_if;
        end_if;
        
      end_if;
      
//**********************************************************************************************************************************************************    
  else
        
    pResult^.uiLng  := 4;
    pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_NOT_SUPPORTED;
    ret_code := ERROR;
    
    //Unknown command
    bd_LogRtMessagesInCy.PostIt.InvalidNewInstCommandReceived := TRUE;
    bd_LogRtMessagesInCy.aLogValue1[0] := pPara^.uiCmd;
    
  END_CASE;
  

END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::InstallCallback
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: iprStates;
	END_VAR
  VAR
    cmdver    : DINT;
    cycidx    : UDINT;
    pCTI      : ^t_s_CycTaskInfo;
    pCallBack : ^t_s_MapPDOData;
  END_VAR
  
  ret_code        := ERROR;
  pResult^.uiLng  := 8;
  
  if (EtherCATState = ECAT_STATE_INIT) & (udNoCycTasks) then // Must be in init and at least 1 cyc task must be available
    
    cmdver := pPara^.aPara[0];
    
    if (cmdver = 1) | 
       (cmdver = 2) then // Command Version
      
      pResult^.aData[4]$DINT := cmdver;  //Return version number
      
      cycidx := pPara^.aPara[1]$UDINT;   // ECAT cyc Task ID, from which to call the passed callbacks
      if (cycidx < udNoCycTasks) & (pPara^.aPara[2]) then  // Cyc task ID and this pointer must be valid
      
        pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_CYCIDX_NOTFOUND;
        
        pCTI := pCycTaskInfo + ( sizeof(t_s_CycTaskInfo) * cycidx);
      
        if pCTI^.udCycTaskId = cycidx then
          
          // Return value if neiher pre nor postscan parameters are valid
          pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_PARAMETER;
          
          // Check PreScan
          if (pPara^.aPara[3] &       // Pointer callbackmethod PreScan
              pPara^.aPara[4] &       // Number of data PreScan
              pPara^.aPara[5] &       // Pointer to mapping info PreScan, points to Para[3] elements!
              pPara^.aPara[6]) then   // Pointer to destination Data PreScan, points to Para[3] elements!
            
            // Check space for new callback
            if pCTI^.noPreCallbacks < pCTI^.maxnoPreCallbacks then
              pCTI^.noPreCallbacks += 1;
            else
              // Alloc more mem
              if pCTI^.pPreCallbacks = NIL then
                pCTI^.noPreCallbacks        := 1;
                pCTI^.maxnoPreCallbacks     := ECATM_INC_CYC_CALLBACKS;
                pCTI^.pPreCallbacks$pVoid   := ToStdLib.Malloc( size    := sizeof(t_s_MapPDOData) * (pCTI^.maxnoPreCallbacks$UDINT));
              else
                pCTI^.noPreCallbacks        += 1;
                pCTI^.maxnoPreCallbacks     += ECATM_INC_CYC_CALLBACKS;
                pCTI^.pPreCallbacks$pVoid   := ToStdLib.ReAlloc(mptr    := pCTI^.pPreCallbacks, 
                                                                        newsize := sizeof(t_s_MapPDOData) * (pCTI^.maxnoPreCallbacks$UDINT));
              end_if;
              
              if pCTI^.pPreCallbacks = NIL then
                EtherCATState := ECAT_STATE_NONE;  // Deactivat Class, noPreCallbacks, maxnoPreCallbacks are wrong
                ClassState    := _MemoryFault;                
                pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_OUT_OF_MEM;
                return;
              end_if;

            end_if;              
            
            // Get Pointer for new callback data
            pCallBack := pCTI^.pPreCallbacks + ((pCTI^.noPreCallbacks-1) * sizeof(t_s_MapPDOData) );
            
            // Added passed data
            pCallBack^.pThis      := pPara^.aPara[2]$pVirtualBase;
            pCallBack^.pCallBack  := pPara^.aPara[3]$pVoid;
            pCallBack^.noData     := pPara^.aPara[4];
            pCallBack^.iovar      := pPara^.aPara[5]$^t_st_eceni_iovar;
            pCallBack^.pData      := pPara^.aPara[6]$^DINT;
            
            if (cmdver = 2) & (pPara^.aPara[11]) then
              pCallBack^.pEtherCatState := pPara^.aPara[11]$^t_e_ECAT_STATE;
            else  // cmdver must be 1 becuase this is checked in 2nd if in this method
              pCallBack^.pEtherCatState := #pCallBack^.pThis$^ECAT_Slave_Base^.EtherCATState.dData;
            end_if;
            
            bd_CallbackSettings.RtPreScan := TRUE;
          
            ret_code := READY;
            pResult^.aData[0]$DINT  := ECAT_RETOK;
          end_if;
          
          // Check PostScan
          if (pPara^.aPara[7] &       // Pointer callbackmethod PostScan  
              pPara^.aPara[8] &       // Number of data PostScan
              pPara^.aPara[9] &       // Pointer to mapping info PostScan, points to Para[7] elements!
              pPara^.aPara[10]) then  // Pointer to source Data PostScan, points to Para[7] elements!
          
            // Check space for new callback
            if pCTI^.noPostCallbacks < pCTI^.maxnoPostCallbacks then
              pCTI^.noPostCallbacks += 1;
            else
              // Alloc more mem
              if pCTI^.pPostCallbacks = NIL then
                pCTI^.noPostCallbacks       := 1;
                pCTI^.maxnoPostCallbacks    := ECATM_INC_CYC_CALLBACKS;
                pCTI^.pPostCallbacks$pVoid  := ToStdLib.Malloc( size    := sizeof(t_s_MapPDOData) * (pCTI^.maxnoPostCallbacks$UDINT));
              else
                pCTI^.noPostCallbacks        += 1;
                pCTI^.maxnoPostCallbacks     += ECATM_INC_CYC_CALLBACKS;
                pCTI^.pPostCallbacks$pVoid   := ToStdLib.ReAlloc(mptr   := pCTI^.pPostCallbacks, 
                                                                        newsize := sizeof(t_s_MapPDOData) * (pCTI^.maxnoPostCallbacks$UDINT));
              end_if;
              
              if pCTI^.pPostCallbacks = NIL then
                EtherCATState := ECAT_STATE_NONE;  // Deactivat Class, noPreCallbacks, maxnoPreCallbacks are wrong
                ClassState    := _MemoryFault;
                pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_OUT_OF_MEM;
                return;
              end_if;

            end_if;              
            
            // Get Pointer for new callback data
            pCallBack := pCTI^.pPostCallbacks + ((pCTI^.noPostCallbacks-1) * sizeof(t_s_MapPDOData) );
            
            // Added passed data
            pCallBack^.pThis      := pPara^.aPara[2]$pVirtualBase;
            pCallBack^.pCallBack  := pPara^.aPara[7]$pVoid;
            pCallBack^.noData     := pPara^.aPara[8];
            pCallBack^.iovar      := pPara^.aPara[9]$^t_st_eceni_iovar;
            pCallBack^.pData      := pPara^.aPara[10]$^DINT;
            
            if (cmdver = 2) & (pPara^.aPara[11]) then
              pCallBack^.pEtherCatState := pPara^.aPara[11]$^t_e_ECAT_STATE;
            else  // cmdver must be 1 becuase this is checked in 2nd if in this method
              pCallBack^.pEtherCatState := #pCallBack^.pThis$^ECAT_Slave_Base^.EtherCATState.dData;
            end_if;
            
            pCTI^.bPostScanActive := TRUE;
            
            bd_CallbackSettings.RtPostScan := TRUE;
          
            ret_code := READY;
            pResult^.aData[0]$DINT  := ECAT_RETOK;
          end_if;
        
        end_if;
        
      else // if (cycidx) & (pPara^.aPara[2]) then
        pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_PARAMETER;
      end_if;    
        
    else // if pPara^.aPara[0] = 1 then // Command Version 
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;      
    end_if;
    
  else  // if (EtherCATState = ECAT_STATE_INIT) & (udNoCycTasks) then
    pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_WRONG_MST_STATE;  
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::LoginSlaveModule
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: iprStates;
	END_VAR
  VAR
    pSlaveInfo : ^t_sSlaveInfo;
  END_VAR

  ret_code        := ERROR;
  pResult^.uiLng  := 4;
  
#ifdef ECAT_DEBUG_DISABLE_REQUIRED
  bd_Flags.bDisableRequired := TRUE;
#endif
  
  if (EtherCATState = ECAT_STATE_INIT) then // Must be in init
  
    if pPara^.aPara[0] = 1 then // Command Version 
      
      pResult^.aData[4]$DINT := 1;  //return version number
      
      //Check Parameters      
      if ( (sSlaveInfo.pSlaves) &                                // Destination mem valid
           (pPara^.aPara[1]$UDINT <  sSlaveInfo.udMaxSlaves) &   // slave index valid?
           (pPara^.aPara[2]) ) then                              // This pointer valid?
       
        //Point directly to the slave info
        pSlaveInfo := sSlaveInfo.pSlaves + (pPara^.aPara[1]$UDINT * sizeof(t_sSlaveInfo));
        
        //Check if slave memory is empty
        if pSlaveInfo^.pThis = 0 then
        
          //Save slave information
          pSlaveInfo^.udSlaveIndex      := pPara^.aPara[1]$UDINT;
          pSlaveInfo^.pThis             := pPara^.aPara[2]$^ECAT_Slave_Base;
          pSlaveInfo^.bRequired := FALSE; // Overwritten in if

          if bd_Flags.bDisableRequired = FALSE then
            pSlaveInfo^.bRequired         := pPara^.aPara[3]$BOOL;
          end_if;
          
          pSlaveInfo^.bdInitModuleFlags := pPara^.aPara[4]$BDINT;
          pSlaveInfo^.pSlaveInfo        := NIL; //Will be set later
          
          //Set our required flag if at least one slave is required
          if (pSlaveInfo^.bRequired) then
            bd_Flags.bIsRequired := TRUE;
          end_if;
          
          //Set return values
          ret_code := READY;
          
          sSlaveInfo.udLoggedInSlaves += 1;
          
          pResult^.uiLng  := 12;
          pResult^.aData[0]$DINT  := ECAT_RETOK;
          pResult^.aData[8]$pVoid := ecatmhdl;
        
        else  //Check slave memory
          pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_PARAMETER; 
          LogValue("@055F (ECAT_Master_Base::LoginSlaveModule) Failed to login slave module 0x{0} to master. Slave memory not empty!",pPara^.aPara[1]$UDINT);
          
          //Login failed, check if module is required
          if (pPara^.aPara[3]$BOOL = TRUE)  & (bd_Flags.bDisableRequired = FALSE) then
            SetRequiredError( pTargetThis       := pPara^.aPara[2]$^ECAT_Slave_Base
                            , udSlaveIndex      := pPara^.aPara[1]$UDINT
                            , bLogInMethAllowed := TRUE);
          end_if;
          
          //Slave memory not emtpy (maybe two slaves with the same Slaveindex tried to login, set master into error (so user knows that something isn't right)
          ClassState := _InvalidConfguration;
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;
      else  //Check parameters
        pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_PARAMETER;      
        LogValue("@0560 (ECAT_Master_Base::LoginSlaveModule) Failed to login slave module 0x{0} to master. Invalid Parameters!",pPara^.aPara[1]$UDINT);

        //Login failed, check if module is required
        if (pPara^.aPara[3]$BOOL = TRUE) & (bd_Flags.bDisableRequired = FALSE) then
          SetRequiredError( pTargetThis       :=pPara^.aPara[2]$^ECAT_Slave_Base
                          , udSlaveIndex      :=pPara^.aPara[1]$UDINT
                          , bLogInMethAllowed := TRUE);
        end_if;
      end_if;

    else // if pPara^.aPara[0] = 1 then // Command Version 
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;
      LogValue("@0561 (ECAT_Master_Base::LoginSlaveModule) Failed to login slave module 0x{0} to master. Not supported version of NewInst command 0x{1}!",pPara^.aPara[1]$UDINT,pPara^.aPara[0]$UDINT);
    end_if;
    
  else  // if (EtherCATState = ECAT_STATE_INIT) then
    pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_WRONG_MST_STATE;
    LogValue("@0562 (ECAT_Master_Base::LoginSlaveModule) Failed to login slave module 0x{0} to master. Invalid master state 0x{1}!",pPara^.aPara[1]$UDINT,EtherCATState);
  end_if;    
  
END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::CalculateGGT
	VAR_INPUT
		Var1 	: UDINT;
		Var2 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ggT 	: UDINT;
	END_VAR

  if Var2 = 0 then
    ggT := Var1;
  else
    ggT := CalculateGGT(Var1:=Var2, Var2:=Var1 MOD Var2);
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::RtWork
  VAR_INPUT
    EAX 	: UDINT;
  END_VAR
  VAR_OUTPUT
    state (EAX) 	: UDINT;
  END_VAR
  VAR
    i : UDINT;
    ud_EAX : UDINT;
    pCTI : ^t_s_CycTaskInfo;
#ifdef ECAT_DEBUG_TIMEMEASURE
#ifndef ECAT_DEBUG_TIMEMEASURE2
    udTimeMarkus : UDINT;
#endif
#endif
  END_VAR
  
  // This must be the 1. line in this function or EAX may be overwriten by the generated AWL code
  ud_EAX := EAX;

  //Only work when class is working ok
  if (ClassState = _ClassOk) then
  
    i := 0;
    pCTI := pCycTaskInfo;
        
    // Pre scan **************************************************************
    if (EtherCATState >= ECAT_STATE_INIT) then
      if (ud_EAX = CALL_OPTION_RT_PRESCAN) then

        udPreScanTimeMark := OS_READMICROSEC();
      
        EtherCATState := NewMasterEtherCATState;
        
        //Go through all cyclic task
        while i < udNoCycTasks do
          
          if (pCTI^.udMaxCnt = 0) | // // No Prescaler
             (pCTI^.udCnt = pCTI^.udRtPreScanTigger) then
            
           
            
#ifdef ECAT_DEBUG_TIMEMEASURE
#ifndef ECAT_DEBUG_TIMEMEASURE2
            udTimeMarkus := OS_GETMICROSEC();
#endif
#endif
            // Call UpdateRT
            UpdateRt(pCTI:=pCTI);
            
#ifdef ECAT_DEBUG_TIMEMEASURE
#ifndef ECAT_DEBUG_TIMEMEASURE2
            pCTI^.ud_TimePre := OS_GETMICROSEC() - udTimeMarkus;
            if pCTI^.ud_TimePre < pCTI^.ud_TimePreMin then
              pCTI^.ud_TimePreMin := pCTI^.ud_TimePre;
            end_if;
            if pCTI^.ud_TimePre > pCTI^.ud_TimePreMax then
              pCTI^.ud_TimePreMax := pCTI^.ud_TimePre;
            end_if;
#endif
#endif
            
          end_if;
          
          //Check if we have a postscan because normally the Counter is incremented in postscan (if we dont have one we have to increment the counter here)
          if bd_CallbackSettings.RtPostScan = FALSE then
            //Counter is used as an internal prescaler
            pCTI^.udCnt += 1;
            if pCTI^.udCnt > pCTI^.udMaxCnt then
              pCTI^.udCnt := 0;
            end_if;
          end_if;
          
          i += 1;
          pCTI += sizeof(t_s_CycTaskInfo);
        end_while;
        
#ifdef ECAT_DEBUG_FRAMETIME
        
        gsum_FrameTime += pCycTaskInfo^.sFrameTimes.udEtherCATFrameTime;
        gsum_FrameTime -= ga_FrameTime[gindexFrameTime];        
        
        ga_FrameTime[gindexFrameTime] := pCycTaskInfo^.sFrameTimes.udEtherCATFrameTime;        
        
        gindexFrameTime += 1;
        if gindexFrameTime >= 100 then
          gindexFrameTime := 0;
        end_if;
        
        gavg_FrameTime := gsum_FrameTime / 100;

#endif                  
      
      // Post scan **************************************************************
      else
      
        //Go through all cyclic task      
        while i < udNoCycTasks do
        
          //Check if current cyclic task does have a postscan (postscan not needed)
          if pCTI^.bPostScanActive then

            if (EtherCATState = ECAT_STATE_OP) then
              if (pCTI^.udMaxCnt = 0) | // No Prescaler
                 (pCTI^.udCnt = pCTI^.udRtPostScanTrigger) then

#ifdef ECAT_DEBUG_TIMEMEASURE
#ifndef ECAT_DEBUG_TIMEMEASURE2
                udTimeMarkus := OS_GETMICROSEC();
#endif
#endif
                // Call UpdateRtPostScan            
                UpdateRtPostScan(pCTI:=pCTI);
                
#ifdef ECAT_DEBUG_TIMEMEASURE
#ifndef ECAT_DEBUG_TIMEMEASURE2
                pCTI^.ud_TimePost := OS_GETMICROSEC() - udTimeMarkus;
                if pCTI^.ud_TimePost < pCTI^.ud_TimePostMin then
                  pCTI^.ud_TimePostMin := pCTI^.ud_TimePost;
                end_if;
                if pCTI^.ud_TimePost > pCTI^.ud_TimePostMax then
                  pCTI^.ud_TimePostMax := pCTI^.ud_TimePost;
                end_if;
#endif
#endif
              end_if;
            end_if;
          end_if;
          
          //increment counter in postscan (is used as an internal prescaler)
          pCTI^.udCnt += 1;
          if pCTI^.udCnt > pCTI^.udMaxCnt then
            pCTI^.udCnt := 0;
          end_if;

          //Go on with next cyclic task
          i += 1;
          pCTI += sizeof(t_s_CycTaskInfo);
        
        end_while;
      
        //Calculate realtime
        Act_RtTime := ( OS_GETMICROSEC() - udPreScanTimeMark);

        //look for maximum
        if ( Act_RtTime > Max_RtTime ) then
          Max_RtTime := Act_RtTime;
        end_if;

        //look for minimum
        if ( Act_RtTime < Min_RtTime ) then
          Min_RtTime := Act_RtTime;
        end_if;
        
      end_if;
    end_if;

  end_if;

  state := READY;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::UpdateRt
  VAR_INPUT
    pCTI 	: ^t_s_CycTaskInfo;
  END_VAR
  VAR
    i                   : UDINT;
    pCallbackData       : ^t_s_MapPDOData;
    retcode             : DINT;
    CrashThisTime       : BOOL;
    aCrashMessage       : ARRAY [0..255] OF CHAR;
    bNoUnlock           : BOOL;
    dTriggerFrameError  : DINT;
#ifdef ECAT_DEBUG_TIMEMEASURE2
    udTimeMarkus : UDINT;
#endif
  END_VAR
    
  CrashThisTime   := FALSE; // init with false
  bNoUnlock       := FALSE; // init with false
  
#ifdef ECAT_TRACE_VIEW_LOG  
  OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_PRESCAN_UPDATECYC,pCTI^.udCycTaskId);
#endif
  
  //Time measurement to show on server
  OS_ECATM_GET_SEND_TIME_AMOUNT(pECAT, ecatmhdl, pCTI^.udCycTaskId, #pCTI^.sFrameTimes.udEtherCATFrameTime);
  
  //Check for maximum
  if pCTI^.sFrameTimes.udEtherCATFrameTime > pCTI^.sFrameTimes.udEtherCATFrameTimeMax then
    pCTI^.sFrameTimes.udEtherCATFrameTimeMax := pCTI^.sFrameTimes.udEtherCATFrameTime;
  end_if;

  //Check for minimum
  if pCTI^.sFrameTimes.udEtherCATFrameTime < pCTI^.sFrameTimes.udEtherCATFrameTimeMin then
    pCTI^.sFrameTimes.udEtherCATFrameTimeMin := pCTI^.sFrameTimes.udEtherCATFrameTime;
  end_if;
  
  //Show values from first cyclic on server
  if pCTI^.udCycTaskId = 0 then
    FrameTimeTask0 := pCTI^.sFrameTimes.udEtherCATFrameTime;
    FrameTimeMaxTask0 := pCTI^.sFrameTimes.udEtherCATFrameTimeMax;
  end_if;
    
  // Always Call to lock cycctx  (Call with PRE ... Receive EtherCAT Frame data)
  retcode := OS_ECATM_UpdateCyc(pECAT, ecatmhdl, pCTI^.udCycTaskId, LSL_ECATM_PRE_CYC_TASK
          , #pCTI^.ecatm_cycctx, pCTI^.udIsoStartPoint - _SyncMeasureECAT1.Frame_sendOffset$UDINT);
            
  if retcode = ECATM_OK then 
    
    
    //Check for valid cyclic context
    if pCTI^.ecatm_cycctx then
    
      // Sync Regulation
      if (pCTI^.udCycTaskId = sDCInfo.udCyclicIndex) & pCTI^.b_SyncTask & EtherCATState >= ECAT_STATE_PREOP (*ECAT_STATE_SAFEOP*) then
        
        //CyclicContext is needed for LL Rx/Tx Timestamps
        _SyncMeasureECAT1.SetCycContext(pCTI^.ecatm_cycctx,sDCInfo.udSlaveIndex);
        
        _SyncMeasureECAT1.SyncMeasurement();
          
        _SyncMeasureECAT1.SyncRegulation();
        
      end_if;
      
      //Check if we have callbacks
      if pCTI^.noPreCallbacks then
              
        //Check if we have an error
        if (pCTI^.ecatm_cycctx^.prcstatus AND ECATM_PRCSTAT_ST_MASK_ERROR_OR_WARN) = 0 then
        
          sDebugCounters.udConsecutiveMissingFrameCounter := 0; //Reset consecutive counter
        
          pCallbackData := pCTI^.pPreCallbacks; //Point to first installed Pre callback
          
#ifdef ECAT_DEBUG_TIMEMEASURE2
            udTimeMarkus := OS_GETMICROSEC();
#endif
          
          //Go through all installed callbacks from the slave modules to copy the data from recieved frame data to the HWK.
          for i := 1 to pCTI^.noPreCallbacks do
            //Call Slave module (only if EtherCATState > SAFEOP)
            if pCallbackData^.pEtherCatState^ >= ECAT_STATE_SAFEOP then
#ifdef ECAT_TRACE_VIEW_LOG
                OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_PRESCAN_CALLBACKS,pCTI^.udCycTaskId OR (i SHL 16));
#endif
              pCallbackData^.pCallBack$ECAT_MapPDOData(pCallbackData^.pThis, pCTI^.ecatm_cycctx, pCallbackData^.noData, pCallbackData^.iovar, pCallbackData^.pData); 
            end_if;
            pCallbackData += sizeof(t_s_MapPDOData); //Point to next callback
          end_for;
          
#ifdef ECAT_DEBUG_TIMEMEASURE2
          pCTI^.ud_TimePre := OS_GETMICROSEC() - udTimeMarkus;
          if pCTI^.ud_TimePre < pCTI^.ud_TimePreMin then
            pCTI^.ud_TimePreMin := pCTI^.ud_TimePre;
          end_if;
          if pCTI^.ud_TimePre > pCTI^.ud_TimePreMax then
            pCTI^.ud_TimePreMax := pCTI^.ud_TimePre;
          end_if;
#endif
        else
          
          //Check the process state if we need to raise an error
          dTriggerFrameError := ProcessFrameErrorCheck(pCTI^.ecatm_cycctx^.prcstatus);
        
          //Check if we need to trigger an error
          if dTriggerFrameError then
            ClassState := _WrongRunStatus;
            
            bd_LogRtMessagesInCy.PostIt.CycPrcStatus  := TRUE;
            bd_LogRtMessagesInCy.aLogValue1[14]       := pCTI^.ecatm_cycctx^.prcstatus;
            
            if bd_Flags.bIsRequired then
              CrashThisTime := TRUE;
              sigclib_sprintfST(pd:=#aCrashMessage[0], format:="Ethercat: Error (Invalid frame) Status 0x%X", p0:=#pCTI^.ecatm_cycctx^.prcstatus);
            end_if;
          end_if;
        end_if;
        
        MissedFrameCounter := sDebugCounters.udConsecutiveMissingFrameCounter;
        
      end_if;
    
    else
      
      sDebugCounters.udInvalidcycctx += 1;
      
      //Cyclic Context is not valid until EtherCAT State is OP or higher
      if EtherCATState >= ECAT_STATE_OP then
        //Cyclic context is invalid although the EtherCAT State is higher or equal than SAFEOP --> SET Error
        ClassState    := _WrongRunStatus;
        
        bd_LogRtMessagesInCy.PostIt.InvalidCycctx := TRUE;
        
        if bd_Flags.bIsRequired then
          CrashThisTime := TRUE;
          _strcpy(dest:=#aCrashMessage[0], src:="EtherCAT: Invalid Cycctx");
        end_if;
      end_if;
    
    end_if;
    
  else
    
    if retcode < ECATM_OK then  // retcode may be of type t_e_st_ecatm_evtc in this case we need unlock
      bNoUnlock := TRUE;
    end_if;
    
    sDebugCounters.udInvalidRetCodeUpdateCycPre += 1;
    
    CrashThisTime := UpdateCycRetcodeHandling(retcode:=retcode, pCrashMessage:=#aCrashMessage[0]);
  
  end_if;
       
  // Always Call to unlock cycctx
  if ( (pCTI^.bPostScanActive) = FALSE |    // Postscan call needed to unlock ecatm_cycctx
       (EtherCATState < ECAT_STATE_OP) |    // If EtherCATState = OP then unlock is done in postscan
       ((ClassState <> _ClassOk) & (bNoUnlock = FALSE)) ) then     // Unlock on Error, Postscan is no longer called in this state
       
#ifdef ECAT_TRACE_VIEW_LOG         
    OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_PRESCAN_UPDATECYC_UNLOCK,pCTI^.udCycTaskId);
#endif
        
    retcode := OS_ECATM_UpdateCyc(pECAT, ecatmhdl, pCTI^.udCycTaskId, LSL_ECATM_POST_CYC_TASK, #pCTI^.ecatm_cycctx,0);
    if retcode <> ECATM_OK then
    
      //Invalid retcode, raise error
      sDebugCounters.udInvalidRetCodeUpdateCycPost += 1;
      
      CrashThisTime := UpdateCycRetcodeHandling(retcode:=retcode, pCrashMessage:=#aCrashMessage[0]);
      
    end_if;
  end_if;
  
  if CrashThisTime then
    // if a required module is not available or doesn't work properly, the system should crash
    OS_ECATM_raise_error(pECAT,0,#aCrashMessage[0]);
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::UpdateRtPostScan
  VAR_INPUT
    pCTI 	: ^t_s_CycTaskInfo;
  END_VAR
  VAR
    i               : UDINT;
    pCallbackData   : ^t_s_MapPDOData;
    CrashThisTime   : BOOL;
    aCrashMessage   : ARRAY [0..255] OF CHAR;
    retcode         : DINT;
    dTriggerFrameError  : DINT;
    prcstatus       : UDINT;
#ifdef ECAT_DEBUG_TIMEMEASURE2
    udTimeMarkus : UDINT;
#endif
  END_VAR
  
  CrashThisTime   := FALSE; // init with false
    
  //Check if we have postscan callbacks and a valid frame
  if pCTI^.noPostCallbacks & pCTI^.ecatm_cycctx then
  
    pCallbackData := pCTI^.pPostCallbacks;
    prcstatus := pCTI^.ecatm_cycctx^.prcstatus; // Save prcstatus as it is checked more than once
    if (prcstatus AND ECATM_PRCSTAT_ST_FRAME_NOT_SENT) = 0 then // ECATM_PRCSTAT_ST_FRAME_NOT_SENT: The link layer driver failed to send the last TX frame. 
                                                                //                                  The frame is still owned by the hardware of the MAC. 
                                                                //                                  THE APPLICATION SHALL NOT ALTER THE TRANSMIT FRAME!
                                                                // Check the sample-simple and sample-all implementation for usaage and compatibility patch.
                                                                // See ECATM_Programmers_Guide and ECATM_Reference_Manual for detailed information

#ifdef ECAT_DEBUG_TIMEMEASURE2
      udTimeMarkus := OS_GETMICROSEC();
#endif
      
      //Go through all installed callbacks from the slave modules HWK to fetch the data and copy it to the transmit frame.
      for i := 1 to pCTI^.noPostCallbacks do
        
        if pCallbackData^.pEtherCatState^ >= ECAT_STATE_OP then

#ifdef ECAT_TRACE_VIEW_LOG
            OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTSCAN_CALLBACKS,pCTI^.udCycTaskId OR (i SHL 16));
#endif

          pCallbackData^.pCallBack$ECAT_MapPDOData(pCallbackData^.pThis, pCTI^.ecatm_cycctx, pCallbackData^.noData, pCallbackData^.iovar, pCallbackData^.pData);
        end_if;
        
        pCallbackData += sizeof(t_s_MapPDOData);
      end_for;
      
#ifdef ECAT_DEBUG_TIMEMEASURE2
      pCTI^.ud_TimePost := OS_GETMICROSEC() - udTimeMarkus;
      if pCTI^.ud_TimePost < pCTI^.ud_TimePostMin then
        pCTI^.ud_TimePostMin := pCTI^.ud_TimePost;
      end_if;
      if pCTI^.ud_TimePost > pCTI^.ud_TimePostMax then
        pCTI^.ud_TimePostMax := pCTI^.ud_TimePost;
      end_if;
#endif  
    end_if;
    
    if (prcstatus AND ECATM_PRCSTAT_ST_MASK_ERROR_OR_WARN) then
    
      //Check only if no Prescan is used - otherwise this check is done in prescan
      if pCTI^.noPreCallbacks = 0 then
      
        //Check the process state if we need to raise an error
        dTriggerFrameError := ProcessFrameErrorCheck(prcstatus);
        
        if dTriggerFrameError then
          ClassState := _WrongRunStatus;
          
          bd_LogRtMessagesInCy.PostIt.CycPrcStatus  := TRUE;
          bd_LogRtMessagesInCy.aLogValue1[14]       := prcstatus;
          
          if bd_Flags.bIsRequired then
            CrashThisTime := TRUE;
            sigclib_sprintfST(pd:=#aCrashMessage[0], format:="Ethercat: Error (Invalid frame) Status 0x%X", p0:=#prcstatus);
          end_if;  
        end_if;
      end_if;
    end_if;
    
    MissedFrameCounter := sDebugCounters.udConsecutiveMissingFrameCounter;
    
  end_if;

#ifdef ECAT_TRACE_VIEW_LOG  
  OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTSCAN_UPDATECYC,pCTI^.udCycTaskId);
#endif  

  // Always Call to unlock cyctx
  retcode := OS_ECATM_UpdateCyc(pECAT, ecatmhdl, pCTI^.udCycTaskId, LSL_ECATM_POST_CYC_TASK, #pCTI^.ecatm_cycctx,0);
  
  if udDisconnectEventTime then
    udDisconnectEventTime := 0;
    ClassState := _NoHardware;
    EtherCATState := ECAT_STATE_INIT;
    NewMasterEtherCATState  := ECAT_STATE_INIT;
    InitSSW := _Wait4EcatLink;
  end_if;

  
  if retcode <> ECATM_OK then
    //Invalid retcode, raise error
    sDebugCounters.udInvalidRetCodeUpdateCycPost += 1;
    
    CrashThisTime := UpdateCycRetcodeHandling(retcode:=retcode, pCrashMessage:=#aCrashMessage[0]);
    
  end_if;
  
  if CrashThisTime then
    // if a required module is not available or doesn't work properly, the system should crash
    OS_ECATM_raise_error(pECAT,0,#aCrashMessage[0]);
  end_if;

END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::UpdateCycRetcodeHandling
  VAR_INPUT
    retcode 	: DINT;
    pCrashMessage : ^Char;  
  END_VAR
  VAR_OUTPUT
    bFatalError : BOOL;
  END_VAR
  
  bFatalError := FALSE;
  
  //Difference the single errors
  case retcode of
    //*****************************************************************************
    ECATM_TIMING_ERROR_1:
    
      //No Data available at send time (last cycle)
      ClassState := _TimesliceErrorIRQ;
      bd_LogRtMessagesInCy.PostIt.TimingError_1 := TRUE;
              
      if bd_Flags.bIsRequired then
        bFatalError := TRUE;
        _strcpy(dest:=pCrashMessage, src:="No Data available at Send time (TimeSliceErrorIRQ)");
      end_if;
    
    //*****************************************************************************
    ECATM_TIMING_ERROR_2:
    
      //Time since tick is at call of UpdateCyc(Pre) higher than allowed from the IsoStartPoint
      ClassState := _TimesliceErrorIRQ;
      bd_LogRtMessagesInCy.PostIt.TimingError_2 := TRUE;
           
      if bd_Flags.bIsRequired then
        bFatalError := TRUE;
        _strcpy(dest:=pCrashMessage, src:="Time since tick is at call of UpdateCyc(Pre) higher than allowed from the IsoStartPoint (TimeSliceErrorIRQ)");
      end_if;
    
    //*****************************************************************************
    ECATM_DATA_NOT_SENT:
  
      //Data was not sent at the time UpdateCyc was called with (Pre)
      ClassState := _TimesliceError;
      bd_LogRtMessagesInCy.PostIt.DataNotSent := TRUE;
      
      if bd_Flags.bIsRequired then
        bFatalError := TRUE;
        _strcpy(dest:=pCrashMessage, src:="Data was not sent at the time UpdateCyc was called with (Pre) (TimeSliceError)");
      end_if;
  
    //*****************************************************************************
    else
    
      if retcode = ECATM_EVTC_MST_DEACTIVATED$DINT & InitSSW <> _InitFinished then
        //Ignore master deactivated error during initialisation (maybe master is not activated yet (takes a while in OS)

      else
        ClassState := _ManagerError;
        bd_LogRtMessagesInCy.PostIt.UnknownError := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[4] := (ABS(retcode))$UDINT;
        if bd_Flags.bIsRequired then
          bFatalError := TRUE;
          sigclib_sprintfST(pd:=pCrashMessage, format:="Unknown Error in EtherCAT handling occured: %d", p0:=#retcode);
        end_if;
      end_if;
    
    //*****************************************************************************
  end_case;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::SoftwareVersion::Read
  VAR_OUTPUT
    output (EAX) 	: UDINT;
  END_VAR

  SoftwareVersion := strSoftwareVersion.Data.Read();
