FUNCTION VIRTUAL ECAT_Master_Base::ProcessFrameErrorCheck
	VAR_INPUT
		udPrcstate 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dTriggerFrameError 	: DINT;
	END_VAR

  dTriggerFrameError := 1;
  
  aFrameErrorLogBuffer[udCurrentLogEntry].udTimeStamp     := ops.tAbsolute;
  aFrameErrorLogBuffer[udCurrentLogEntry].bdProcessState  := udPrcstate$BDINT;
    
  udCurrentLogEntry += 1;
  
  //Check for array limit
  if udCurrentLogEntry > ECATM_MAX_SIZE_FRAME_ERROR_LOGBUFFER-1 then
    udCurrentLogEntry := 0;
  end_if;
  
  //It is possible and allowed that sometimes a frame is missing. With this check the user can set how many consecutive missing frames 
  //are going to raise an error. 
  sDebugCounters.udConsecutiveMissingFrameCounter += 1;
  sDebugCounters.udTotalMissingFrameCounter += 1;
  
  case MissingFrameBehaviour of
  
    0 : dTriggerFrameError := 0;  //If dTriggerFrameError is zero, no error will be raised and the application will work with the data from the last valid frame/cycle
                                  //Do not trigger an error due to client setting
    
    1 : dTriggerFrameError := 1;   //trigger an error due to client setting
    
    else
      //Check for number of missing frames and client setting
      if MissingFrameBehaviour > sDebugCounters.udConsecutiveMissingFrameCounter  then
        dTriggerFrameError := 0;  //no error due to client setting
      end_if;
  end_case;

END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::ExtendPostInitTime
	VAR_INPUT
		AdditionalTime 	: UDINT;
	END_VAR
  VAR
  	MyPara          : CmdStruct;
    MyResult        : results;
  END_VAR

  MyPara.uiCmd    := CMD_EXTEND_POST_INIT_TIME;
  MyPara.aPara[0] := AdditionalTime$DINT;  
  
  if ToHwControl.NewInst(#MyPara, #MyResult) <> READY then
    // Just log, default Postinit may be enough anyway. Otherwise it will timeout in postinit.
    LogValue("@084B (ECAT_Master_Base::ExtendPostInitTime) Failed to increase Postinit-Timeout by 0x{0}.", AdditionalTime);
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL ECAT_Master_Base::SendManagerErrorToSlaves	
  VAR
    pCurrentSlave : ^t_sSlaveInfo;
    i             : UDINT;
  	MyPara          : CmdStruct;
    MyResult        : results;
  END_VAR
  
  pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
  
  MyPara.uiCmd     := ECAT_M_SET_CLASSSTATE;
  MyPara.aPara[0]  := 1; // Version
  
  //Call Update all logged in slaves
  for i:=0 to sSlaveInfo.udMaxSlaves-1 do
    
    //Check if slave can be called
    if pCurrentSlave^.pThis then
      if pCurrentSlave^.pThis^.ClassState = _ClassOk then
        MyPara.aPara[1]$t_e_VaranErrors := _ManagerError;  // ClassState
      else
        // Do not overwrite already existing error state on client
        MyPara.aPara[1]$t_e_VaranErrors := pCurrentSlave^.pThis^.ClassState; // ClassState
      end_if;
      
      MyPara.aPara[2]$DINT := 0; // Online
      
      pCurrentSlave^.pThis^.NewInst(#MyPara, #MyResult);
      
    end_if;
    
    pCurrentSlave += sizeof(t_sSlaveInfo);
  end_for;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::DisableInitBusTimeouts
	VAR_INPUT
		AllTimeouts 	: BOOL;(* := TRUE *)
		Wait4LinkTimeOut 	: BOOL;(* := FALSE *)
		StateTransitionTimeout 	: BOOL;(* := FALSE *)
		InitModuleTimeOut 	: BOOL;(* := FALSE *)
		WaitForSynchronTimeOut 	: BOOL;(* := FALSE *)
		PostInitTimeout 	: BOOL;(* := FALSE *)
	END_VAR
  
  if Alltimeouts then
    
    bd_Flags.bDisableWait4LinkTimeOut       := TRUE;
    bd_Flags.bDisableStateTransitionTimeout := TRUE;
    bd_Flags.bDisableInitModuleTimeOut      := TRUE;
    bd_Flags.bDisableWaitForSynchronTimeOut := TRUE;
    bd_Flags.bPostInitCancel                := TRUE;
  
  else
    
    bd_Flags.bDisableWait4LinkTimeOut       := Wait4LinkTimeOut;
    bd_Flags.bDisableStateTransitionTimeout := StateTransitionTimeout;
    bd_Flags.bDisableInitModuleTimeOut      := InitModuleTimeOut;
    bd_Flags.bDisableWaitForSynchronTimeOut := WaitForSynchronTimeOut;
    bd_Flags.bPostInitCancel                := PostInitTimeout;
    
  end_if;
  
END_FUNCTION


FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::DisableRequiredError
	VAR_OUTPUT
		retval 	: DINT;
	END_VAR
  
  retval := -1;
  
  if us_InitCnt <= 1 then
    bd_Flags.bDisableRequired := TRUE;
    retval := 0;
  end_if;

END_FUNCTION
