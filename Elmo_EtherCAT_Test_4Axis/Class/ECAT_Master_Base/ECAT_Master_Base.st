    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: slave index: %d The mailbox protocol (ECAT_MBX_TYPE…): %V1.", #evt^.arg1, #evt^.arg2);
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: The mailbox error reason (lower layer): %d.", #evt^.arg3);
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_ESM_INVALID_WKC_SO:
    // The working counter check during SafeOP hit a timeout. This can happen for some devices that do not handle outputs or inputs correctly during SafeOP.
    // The ecat master continues in this case after a timeout with this warning.
    // arg1 cyclic task idx: int (index of cyclic task with invalid WKC)
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: The WKC check during SafeOP hit a timeout. This can happen for some devices that do not handle outputs or inputs correctly during SafeOP.");
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: cyclic task idx: int (index of cyclic task with invalid WKC): %d.", #evt^.arg1);
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_SDOINFO_BAD_RESPONE:
    // A SDO info response with a bad length was received
    // arg1 slave index: int
    // arg2 Length of the bad response: int
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: MA SDO info response with a bad length was received");
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: slave index: %d Length of the bad response:: %d.", #evt^.arg1, #evt^.arg2);
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_SDOINFO_UNEXP:
    // A valid SDO info response/request was received but no waiting handle is attached
    // arg1 slave index: int
    // arg2 SdoInfo opcode: uint8_t
    // arg3 Length of the bad response: int
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: A valid SDO info response/request was received but no waiting handle is attached");
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: slave index: %d SdoInfo opcode: %V1.", #evt^.arg1, #evt^.arg2);
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: Length of the bad response: %d.", #evt^.arg3);
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_SDOINFO_BAD_FRG:
    // Received a unexpected and bad fragment number
    // arg1 slave index: int
    // arg2 fragleft received: int
    // arg3 fragleft expected: int
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: Received a unexpected and bad fragment number");
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: slave index: %d", #evt^.arg1);
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: ragleft received: %d. fragleft expected: %d", #evt^.arg2, #evt^.arg3);
#endif

//*******************************************************************************************************************************************************
    ECATM_EVTC_SDOINFO_EMPTY:
    // Return code only. The error is set when an SDO info transfer is succeeded without any payload was received.
    // This is a workaround for the SSC which can be seen when a transfer is aborted through a INIT transition.
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
    HWC_LogPrintf(pThis:=this, format:="@ECAT-DEBUG: The error is set when an SDO info transfer is succeeded without any payload was received.");
#endif

  end_case;

END_FUNCTION

FUNCTION __CDECL VIRTUAL ECAT_Master_Base::SendEvtCallBacktoSlave
	VAR_INPUT
		udMasterID 	: UDINT;
		evt 	: ^t_st_ecatm_evt;
		EventType 	: DINT;
		uiCallbackInfo 	: UINT;
	END_VAR
  VAR
    pCurrentSlave : ^t_sSlaveInfo;
    _Para 	  : CmdStruct;
    _Result 	: Results;	
    ret_code 	: IprStates;  	
  END_VAR
  
  // INFO_CALLBACK: Callbacks may be received immediately after setting the callback method because EtherCAT Master may run on a different core!
  // INFO_CALLBACK: As of 15.07. Slave callback (search for SendEvtCallBacktoSlave) are not called until the first call to OS_ECATM_MST_REQ_STATE in the PostInit.
  // INFO_CALLBACK: This guarantees that the data structure needed in SendEvtCallBacktoSlave are initialized, before the 1st callback is received.
  
  //Check if we got a valid slave number
  if evt^.arg1$UDINT <= sSlaveInfo.udMaxSlaves then
    
    pCurrentSlave := sSlaveInfo.pSlaves + (evt^.arg1$UDINT * sizeof(t_sSlaveInfo)); //Set pointer to correct slave
    
    if (pCurrentSlave) & (pCurrentSlave^.pThis) then
      
      _Para.uiCmd                     := ECAT_M_EVENT_CALLBACK;
      _Para.aPara[0]                  := 1;
      _Para.aPara[1]$UDINT            := udMasterID;
      _Para.aPara[2]$^t_st_ecatm_evt  := evt;
      _Para.aPara[3]                  := EventType;
      _Para.aPara[4]                  := uiCallbackInfo;
      
      //Forward event callback via newinst to respective Slave
      ret_code := pCurrentSlave^.pThis^.NewInst(#_Para,#_Result);
       
      if (ret_code <> READY) |(_Result.uiLng <> 8) | 
         (_Result.aData[0]$DINT <> ECAT_RETOK) |  
         (_Result.aData[4]$DINT <> 1) then // Version
       
        if (uiCallbackInfo = LSL_ECATM_ACYCLIC_TASK) then
          LogValue("@0577 (ECAT_Master_Base::SendEvtCallBacktoSlave) NewInstCmd: ECAT_M_EVENT_CALLBACK Failed! ret_code = 0x{0}, return code = 0x{1}, Version = 0x{2}", ret_code$UDINT, _Result.aData[0]$UDINT, _Result.aData[4]$UDINT);
        else
          bd_LogRtMessagesInCy.PostIt.SendEvtCallInvFailed := TRUE;
          bd_LogRtMessagesInCy.aLogValue1[7] := _Result.aData[0]$UDINT;
        end_if;
      
      end_if;
    end_if;
  else
  
    if (uiCallbackInfo = LSL_ECATM_ACYCLIC_TASK) then
      LogValue("@0576 (ECAT_Master_Base::SendEvtCallBacktoSlave) Invalid slave number from Event callback! evt^.arg1 = 0x{0}, sSlaveInfo.udMaxSlaves = 0x{1}, Event: 0x{2}", evt^.arg1$UDINT, sSlaveInfo.udMaxSlaves, evt^.evtcode$UDINT);
    else
      bd_LogRtMessagesInCy.PostIt.SendEvtCallInvSlv := TRUE;
      bd_LogRtMessagesInCy.aLogValue1[6] := evt^.arg1$UDINT;
    end_if;
    
  end_if;
    
END_FUNCTION


FUNCTION VIRTUAL ECAT_Master_Base::SetRequiredError
	VAR_INPUT
		pTargetThis 	: ^ECAT_Slave_Base;(* := NIL *)
		udSlaveIndex 	: UDINT;(* := 16#FFFFFFFF *)
		bLogInMethAllowed 	: BOOL;(* := FALSE *)
	END_VAR

  if pTargetThis & udSlaveIndex <> 16#FFFFFFFF then
    pTargetThis^.ClassState := _RequiredError;  
    
    if bLogInMethAllowed then
      LogValue("@0579 (ECAT_Master_Base::SetRequiredError) Required Error on EtherCAT Slave 0x{0}.", udSlaveIndex);
    else
      bd_LogRtMessagesInCy.PostIt.SetReqErrSlv := TRUE;
      bd_LogRtMessagesInCy.aLogValue1[8] := udSlaveIndex;
    end_if;
    
  else  
  
    // general required error (initialisation failed)
    // if no required module => don't crash
    if (bd_Flags.bIsRequired = FALSE) then
      return;
    end_if;
        
  end_if;
  
  ClassState := _RequiredError;
  
  //Set off the HardwareControl class
  ToHwControl.SetHardwareOff(e_error:=_RequiredError);
  
  if pECAT then
    // if a required module is not available or doesn't work properly, the system should crash
    OS_ECATM_raise_error(pECAT,0,"Required Error");
  else
    
    if bLogInMethAllowed then
      LogError("@057A (ECAT_Master_Base::SetRequiredError) Failed to raise Required Error.");
    else
      bd_LogRtMessagesInCy.PostIt.SetReqErrFailed := TRUE;
    end_if;
    
  end_if;

END_FUNCTION

