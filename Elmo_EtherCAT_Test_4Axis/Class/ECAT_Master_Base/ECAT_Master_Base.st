FUNCTION VIRTUAL ECAT_Master_Base::DisconnectEvent
	VAR_INPUT
		udMasterID 	: UDINT;
		evt 	: ^t_st_ecatm_evt;
		EventType 	: DINT;
		uiCallbackInfo 	: UINT;
	END_VAR
  VAR
  	pCurrentSlave : ^t_sSlaveInfo;
    i : UDINT;
  END_VAR
  
  if (InitSSW <> _InitFinished) & 
     (InitSSW <> _PrepareError) & 
     (InitSSW <> _ErrorOccured)  then
    return;
  end_if;

  
  InitSSW := _NotConnected;
  udDisconnectEventTime := ops.tAbsolute;
  
  // if there is a required error, we would disguise it, if we call the disconnect interfaces
  if ClassState <> _RequiredError then
  
    // tell all the connected modules
    if sSlaveInfo.udMaxSlaves then
      pCurrentSlave := sSlaveInfo.pSlaves; //Point to current slave
      for i:=0 to sSlaveInfo.udMaxSlaves-1 do
        if pCurrentSlave^.pThis then
          pCurrentSlave^.pThis^.DisconnectEvent();
        end_if;
        pCurrentSlave += sizeof(t_sSlaveInfo);
      end_for;
    end_if;
  end_if;
  
END_FUNCTION


FUNCTION VIRTUAL GLOBAL ECAT_Master_Base::GetFrameTimesPointer
	VAR_INPUT
		udCycTaskID 	: UDINT;
	END_VAR
	VAR_OUTPUT
		pEtherCATFrameTimes 	: ^t_s_EtherCATFrameTimes;
	END_VAR

  pEtherCATFrameTimes := NIL;
  
  //Check for valid Task ID
  if udNoCycTasks & pCycTaskInfo then
    if udCycTaskID > udNoCycTasks-1 then
      return; // Return default NIL
    end_if;
  
    pEtherCATFrameTimes := #pCycTaskInfo^.sFrameTimes + ( sizeof(t_s_CycTaskInfo) * udCycTaskID);
  end_if;

END_FUNCTION


