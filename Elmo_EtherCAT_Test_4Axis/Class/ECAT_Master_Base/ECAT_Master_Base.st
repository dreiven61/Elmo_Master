    ECATM_EVTC_DC_CYCLE_PERIOD:
    //The sync0 period of the slave is not a multiple or a fraction of the cyclic task period. The cyclic 
    //task period is probably configured wrong or the slave is assigned to a sync unit of another 
    //cyclic task (not supported by the master stack). 
    //arg1 ... slave index
    
#ifdef ECAT_DEBUG_EVENT_CALLBACKS
      LogValue("ECAT-DEBUG: Event ECATM_EVTC_DC_CYCLE_PERIOD occured. SlaveIndex = 0x{0}", evt^.arg1$UDINT);
#endif

      ClassState := _InvalidConfguration;
      EtherCATState := ECAT_STATE_NONE;
      
      if bLogInCallbackAllowed then
        LogValue("@0581 (ECAT_Master_Base::EvtCallBack) Sync0 period of the slave 0x{0} is not a multiple or fraction of the cyclic task period",evt^.arg1$UDINT);
      else
        bd_LogRtMessagesInCy.PostIt.InvalidDCCyclePeriod := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[16]              := evt^.arg1$UDINT;
      end_if;
      
      
