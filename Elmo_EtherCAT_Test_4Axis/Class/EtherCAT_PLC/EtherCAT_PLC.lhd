<?xml version="1.0" encoding="ISO-8859-1" ?>
<HWClassInfo>
  <Class Name="EtherCAT_PLC" SingleObject="EtherCAT_PLC" NeedClasses="HwControl" BusTypePLC="ETHERCAT" >
    <Uplink Name="Ethercat" Channel="ToHwControl" BusType="HWCONTROL_ETM" />
    <Downlink Name="EtherCATOut_1" BusType="Ethercat_ETHERNET" Port="0" />
    
    <IOState Name="EtherCAT Class State"            Channel="ClassState"         Desc="This server shows the status of the hardware class. If the state is not equal than _ClassOK, an error has occurred "/>
    <IOState Name="EtherCAT State"                  Channel="EtherCATState"      Desc="Shows the State of the EtherCAT master."/>
    <IOState Name="EtherCAT Software Version"       Channel="SoftwareVersion"    Desc="Shows the software version of the EtherCAT master."/>
    <IOState Name="EtherCAT Synchron"               Channel="Synchron"           Desc="Shows the synchronisation state of the EtherCAT system.&#13;&#10;0 ... not synchron&#13;&#10;1 ... synchron."/>
    <IOState Name="EtherCAT Frame Time Task 0"      Channel="FrameTimeTask0"     Desc="Shows the current EtherCAT frame transmit time of the first task from the OS in µs.&#13;&#10;For more details see the documentation of the class."/>
    <IOState Name="EtherCAT Frame Time Task 0 Max"  Channel="FrameTimeMaxTask0"  Desc="Shows the maximum EtherCAT frame transmit time of the first task from the OS in µs.&#13;&#10;Can be reset by writing to this server.&#13;&#10;For more details see the documentation of the class."/>
    <IOState Name="EtherCAT Act Realtime Time"      Channel="Act_RtTime"         Desc="Shows the current Realtime time measurement in µs.&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan."/>
    <IOState Name="EtherCAT Min Realtime Time"      Channel="Min_RtTime"         Desc="Shows the minimum Realtime time measurement in µs.&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan."/>
    <IOState Name="EtherCAT Max Realtime Time"      Channel="Max_RtTime"         Desc="Shows the maximum Realtime time measurement in µs.&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan."/>
    <IOState Name="EtherCAT Missed Frame Counter"   Channel="MissedFrameCounter" Desc="Number of successive frames that have been lost. &#13;&#10;If this server is greater that 0, the PDO Data on the EtherCAT-Slave classes has not been updated since the server was 0. &#13;&#10;This server resets to 0 when a valid frame is received."/>

    <Property Name="EtherCAT Iso Start Point"       Channel="IsoStartPoint"       Editor="Range:10..90;Empty"                                        Type ="Analog"  DefaultValue="50"
              Desc="Time of the EtherCAT frame as a percentage of the EtherCAT bus cycle time 
                    &#13;&#10;defines the offset between start of realtime-task and start of Ethercat frame data transfer
                    &#13;&#10;&#13;&#10;Value range between 10 and 90 % (default: 50)
                    &#13;&#10;As an initialization value"  />
    
    <Property Name="EtherCAT Core Select"                 Channel="CoreSelect"                Desc="Set the CPU-core on which the Realtime and the Cylic Task of the Ethercat Master should be executed. Only supported on CPUs with more than one core. " Editor="EditNumber:Signed;Dec" />

    <Property Name="EtherCAT Master ID"                   Channel="MasterID"                  Desc="MasterID of the EtherCAT master. (Default = 1)." Editor="EditNumber:Signed;Dec" />

    <Property Name="EtherCAT state transition behaviour"  Channel="StateTransitionBehaviour"  Desc="The behaviour of the master state transition can be set with this client.&#13;&#10;Bit 1 ... perform a re-init request: current state-> INIT -> requested state&#13;&#10;Bit 2 ... continue with master ESM transition although a slave ESM failed.&#13;&#10;Bit 3 ... ignore invalid WKC during SAFEOP -> OP transition" Editor="EditNumber:Signed;Dec" />

    <Property Name="EtherCAT state transition timeout"    Channel="StateTransitionTimeout"    Desc="Timeout for the maximum duration of a state transition between the individual EtherCAT state transitions in ms.&#13;&#10;Default: 20000 ms. " Editor="EditNumber:Signed;Dec" />

    <Property Name="EtherCAT synchronization mode"        Channel="SynchronizationMode"       Desc="0 ...  DC mastermode without timestamps.&#13;&#10;1 ...  DC mastermode with timestamps&#13;&#10;2 ...  DC slavemode with timestamps (default)" Editor="Combo:0=DC mastermode without timestamps;1=DC mastermode with timestamps;2=DC slavemode with timestamps" />

    <Property Name="EtherCAT phase regulation damping"    Channel="PhaseRegDamping"           Desc="Phase regulation damping&#13;&#10;As initialisation value.&#13;&#10;0 .. 100.00% Regulation. No damping (default)&#13;&#10;1 ..   93.75% Regulation.&#13;&#10;2 ..   87.50% Regulation.&#13;&#10;3 ..   81.25% Regulation.&#13;&#10;4 ..   75.00% Regulation.&#13;&#10;5 ..   68.75% Regulation.&#13;&#10;6 ..   62.50% Regulation.&#13;&#10;7 ..   56.25% Regulation.&#13;&#10;8 ..   50.00% Regulation.&#13;&#10;9 ..   43.75% Regulation.&#13;&#10;10 .. 37.50% Regulation.&#13;&#10;11 .. 31.25% Regulation.&#13;&#10;12 .. 25.00% Regulation.&#13;&#10;13 .. 18.75% Regulation.&#13;&#10;14 ..  12.50% Regulation.&#13;&#10;15 ..    6.25% Regulation.&#13;&#10;&#13;&#10;Fore more information see the documentation of this class." Editor="Combo:0=100.00% Regulation. No damping;1=93.75% Regulation;2=87.50% Regulation;3=81.25% Regulation;4=75.00% Regulation;5=68.75% Regulation;6=62.50% Regulation;7=56.25% Regulation;8=50.00% Regulation;9=43.75% Regulation;10=37.50% Regulation;11=31.25% Regulation;12=25.00% Regulation;13=18.75% Regulation;14=12.50% Regulation;15=6.25% Regulation;" />

    <Property Name="EtherCAT missing frame behaviour"     Channel="MissingFrameBehaviour"     Desc="
Behaviour of the class if a EtherCAT frame is missing.&#13;&#10;
Possible settings:&#13;&#10;
0 = no timeslice error will be triggered &#13;&#10;
1 = a timeslice error will be triggered on the 1st missing frame&#13;&#10;
2...31 = a timeslice error will be triggerd if n successive frames are missing, where n is the value of the property &#13;&#10;
If an EtherCAT frame is missing the application will work with the old data from the last cycle." 
Editor="Range:0..31;Empty" />

    <Script Name="EtherCAT_PLC">
      <Parameter DisplayName="EtherCAT bus cycle time in µs" Name="EtherCATBusCycleTime" Type="Variable" Channel="EtherCATBusCycleTime" Desc="EtherCAT bus cycle time in µs" Editor="Combo:50=50;100=100;125=125;200=200;250=250;500=500;1000=1000;2000=2000;3000=3000;4000=4000;5000=5000;6000=6000;7000=7000;8000=8000;9000=9000;10000=10000;11000=11000;12000=12000;13000=13000;14000=14000;15000=15000;16000=16000;17000=17000;18000=18000;19000=19000;20000=20000;21000=21000;22000=22000;23000=23000;24000=24000;25000=25000;26000=26000;27000=27000;28000=28000;29000=29000;30000=30000;31000=31000;32000=32000" DefValue="1000"/>
    </Script>
  </Class>
</HWClassInfo>