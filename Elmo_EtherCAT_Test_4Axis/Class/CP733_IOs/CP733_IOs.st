	VAR_INPUT
		uiVoltage 	: UINT;
		Offset 	: DINT;
	END_VAR
	VAR_OUTPUT
		Voltage 	: DINT;
	END_VAR
  
  //12 Bit Value is stored in the MSB bits in the 16bit register -> shift right 4  
  Voltage := TO_DINT( TO_REAL(((uiVoltage SHR 4) * CP733_VOLTAGE_MULTIPLIER * CP733_CONVERT_V_TO_MV) / CP733_TEMP_DIVISIOR));
  Voltage += Offset;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL CP733_IOs::RunLED::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  if p_XREGS then
    if input >= 0 & input <= 3 then
      RunLED := input;
      bsLedValue := (RunLED$USINT AND 0x3) OR ((StatusLED$USINT AND 0x3) SHL 2) OR ((ErrorLED$USINT AND 0x3) SHL 4);
      p_XREGS^.LED_funct$funct_XREGS_SETLeds(val:= bsLedValue);
    end_if;
  end_if;

	result := RunLED;

END_FUNCTION


