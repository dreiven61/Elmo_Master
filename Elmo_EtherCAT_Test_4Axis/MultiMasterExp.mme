		<RemoteServer Name="EtherCAT_PLC1.Act_RtTime" Name_DESC="Name" GUID_Svr="{3209A070-B9D9-4AB4-8C15-2484EEA8C289}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the current Realtime time measurement in µs&#13;&#10;&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan." Comment_DESC="Comment of server"/>
		<RemoteServer Name="EtherCAT_PLC1.Min_RtTime" Name_DESC="Name" GUID_Svr="{B7B75AD3-D503-4918-9CA6-577B780CFED9}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}" GUID_Obj_DESC="GUID of the object" Comment="Shows the minimum Realtime time measurement in µs&#13;&#10;&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan." Comment_DESC="Comment of server"/>
		<RemoteServer Name="EtherCAT_PLC1.Max_RtTime" Name_DESC="Name" GUID_Svr="{F9407679-A8B8-4583-B936-F1C764F9CA30}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}" GUID_Obj_DESC="GUID of the object" Comment="Shows the maximum Realtime time measurement in µs&#13;&#10;&#13;&#10;Time Measurement starts with beginning of the realtime prescan and stops with the end of realtime postscan." Comment_DESC="Comment of server"/>
		<RemoteServer Name="EtherCAT_PLC1.MissedFrameCounter" Name_DESC="Name" GUID_Svr="{0B3663E5-EAE7-4B09-B451-68827781240C}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Number of successive frames that have been lost. &#13;&#10;If this server is greater that 0, the PDO Data on the EtherCAT-Slave classes has not been updated since the server was 0.&#13;&#10;This server resets to 0 when a valid frame is received." Comment_DESC="Comment of server"/>
		<RemoteServer Name="EtherCAT_PLC1\_base\_SyncMeasureECAT1.ClassSvr" Name_DESC="Name" GUID_Svr="{953B4719-0172-494B-A5FD-C697B296FD58}" GUID_Svr_DESC="GUID of the server" Class="_SyncMeasure" Class_DESC="Class" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}\{85FB5D5E-6C85-4854-868E-5A0D78B5564A}\{415E0AF8-BF80-42E0-A922-10810BA9504A}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server"/>
		<RemoteServer Name="EtherCAT_PLC1\_base\_SyncMeasureECAT1.SyncRegulationEnable" Name_DESC="Name" GUID_Svr="{2BE5C689-1C94-47FD-9ED7-5D4CBF123D79}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{52EAFA73-AB9C-4D0B-8B19-F533C65655D5}\{85FB5D5E-6C85-4854-868E-5A0D78B5564A}\{415E0AF8-BF80-42E0-A922-10810BA9504A}" GUID_Obj_DESC="GUID of the object" Comment="This Server En/Disables the Sync regulation of the main CPU depending on the &quot;PLL Sync Delta Measurement&quot; component. &#13;&#10;This allows the synchronization of the main CPU to external Sync signals. &#13;&#10;&#13;&#10;-1 .. OS Interface not available. Sync Regulation can not be used. &#13;&#10;0 .. Disabled &#13;&#10;1 .. Measurement Enabled &#13;&#10;2 .. Phase Regulation Enabled &#13;&#10;3 .. Phase and Frequency Regulation Enabled (Disabled)" Comment_DESC="Comment of server"/>
