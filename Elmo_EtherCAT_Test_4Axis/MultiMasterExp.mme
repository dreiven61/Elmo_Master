		<RemoteServer Name="Elmo_11.ClassState" Name_DESC="Name" GUID_Svr="{55939D13-31EB-4F92-87E9-37432CD73662}" GUID_Svr_DESC="GUID of the server" Class="ECAT_Slave_Base" Class_DESC="Class" DataType="t_e_VaranErrors" DataType_DESC="DataType" GUID_Obj="{47F87ED0-D0EE-486E-BC7A-A70547F6C0D9}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Server shows the current Status of the Hardware Class.&#13;&#10;If the state is not _ClassOK, the class is not functional.&#13;&#10;&#13;&#10;_ClassOK ... Class is functional.&#13;&#10;_NotInitialised ... Initialisation of the class has not yet been completed.&#13;&#10;_CallBackError ... Callback login to the EtherCAT_PLC has failed.&#13;&#10;_RootError ... An unsupported interface version was returned.&#13;&#10;_NoHardware ... No hardware connected.&#13;&#10;_ManagerError ... Error during EtherCAT master initialisation.&#13;&#10;_MemoryFault ... Memory allocation failed.&#13;&#10;_ClientNotready ... Configured PDO data was not found in the ENI configuration.&#13;&#10;                                 EtherCAT state transitions failed (e.g. PreOP =&gt; SafeOP)&#13;&#10;                                 Error during initialisation of the module&#13;&#10;_InvalidConfguration ... Different frame configured in the PDO data and module.&#13;&#10;                                          SSC buffer is configured and SSC protocol is not supported by the ECAT master.&#13;&#10;_ParameterInvalid ... PDO configuration has failed." Comment_DESC="Comment of server"/>
		<RemoteServer Name="Elmo_11.EtherCATState" Name_DESC="Name" GUID_Svr="{F6712724-204E-45FE-896A-455A32D34092}" GUID_Svr_DESC="GUID of the server" DataType="t_e_ECAT_STATE" DataType_DESC="DataType" GUID_Obj="{47F87ED0-D0EE-486E-BC7A-A70547F6C0D9}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the current EtherCAT state of the module.&#13;&#10;&#13;&#10;ECAT_STATE_NONE  ... Module in error or not initialized.&#13;&#10;ECAT_STATE_INIT ... Module is in initialization.&#13;&#10;ECAT_STATE_PREOP ... Module is in PreoOP state.&#13;&#10;ECAT_STATE_SAFEOP ... Module is in SafeOP state.&#13;&#10;ECAT_STATE_OP ... Module is in operational state.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="Elmo_11.SlaveState" Name_DESC="Name" GUID_Svr="{59B4BBD8-B774-43D6-83F9-D4F09EB8EB41}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{47F87ED0-D0EE-486E-BC7A-A70547F6C0D9}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Displays the current status of the module.&#13;&#10;&#13;&#10;0x___1 = Slave in &apos;INIT&apos; state&#13;&#10;0x___2 = Slave in &apos;PREOP&apos; state&#13;&#10;0x___3 = Slave in &apos;BOOT&apos; state&#13;&#10;0x___4 = Slave in &apos;SAFEOP&apos; state&#13;&#10;0x___8 = Slave in &apos;OP&apos; state&#13;&#10;0x001_ = Slave signals error&#13;&#10;0x002_ = Invalid vendorId, productCode... read&#13;&#10;0x004_ = Initialization error occurred&#13;&#10;0x010_ = Slave not present&#13;&#10;0x020_ = Slave signals link error&#13;&#10;0x040_ = Slave signals missing link&#13;&#10;0x080_ = Slave signals unexpected link&#13;&#10;0x100_ = Communication port A&#13;&#10;0x200_ = Communication port B&#13;&#10;0x400_ = Communication port C&#13;&#10;0x800_ = Communication port D" Comment_DESC="Comment of server"/>
