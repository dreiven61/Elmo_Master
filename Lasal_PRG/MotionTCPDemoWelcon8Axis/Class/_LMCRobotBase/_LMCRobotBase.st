			Jerk 	: DINT;			//! <Variable Comment="Constant Jerk to be used for the movement, the value is specified in (Application Units /s^3 / 1000).&#13;&#10;&#13;&#10;Possible Values:&#13;&#10;Jerk &gt; 0 - Specified Jerk is used for the motion calculation.&#13;&#10;Jerk = 0 - The maximum allowed jerk is used for the motion calculation." Name="MoveCurveSpline.Jerk"/>
		END_VAR
		VAR_OUTPUT
			RetCode 	: _LMCPROFERRORTYPES;			//! <Variable Comment="Return code specifying the success of the move command." Name="MoveCurveSpline.RetCode"/>
		END_VAR;
				//! <Function Comment="Linear movement with the coupled axes to the first software limit intersection&#13;&#10;&#13;&#10;This method is only allowed to be called from a thread running on the same Core as the Realtime Thread for the _LMCProfile instance which has an equal or lower priority than the Realtime Thread." Name="MoveEndless"/>
