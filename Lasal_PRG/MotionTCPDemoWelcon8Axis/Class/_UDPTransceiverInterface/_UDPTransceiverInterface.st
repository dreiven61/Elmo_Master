FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::InfoCallback
	VAR_INPUT
		FSM_UDP 	: _UDPTransceiver::_FSM_UDP_USER;
		InfoPara1 	: DINT;
		InfoPara2 	: DINT;
	END_VAR

  case FSM_UDP of
    _UDPTransceiver::_FSM_UDP_USER::_STATE_SEND_UDP,
    _UDPTransceiver::_FSM_UDP_USER::_STATE_BIND_SOCK_UDP:
      if (InfoPara1 = UDP_CLT_INFO_ADDED) then
        State := _STATE_ADDED_SOCKET;
      end_if;

	_UDPTransceiver::_FSM_UDP_USER::_STATE_RECV_UDP:
      if (InfoPara1 = UDP_CLT_INFO_BOUND) then
        State := _STATE_BOUND_SOCKET;
      end_if;

	_UDPTransceiver::_FSM_UDP_USER::_STATE_CLOSE_SOCK_UDP:
      if (InfoPara1 = UDP_CLT_INFO_CLOSED) then
        State := _STATE_CLOSED_SOCKET;
      end_if;

  end_case;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::ErrorCallback
	VAR_INPUT
		FSM_UDP 	: _UDPTransceiver::_FSM_UDP_USER;
		UdpError 	: _UDPTransceiver::_UDP_ERROR;
		ErrCode 	: DINT;
	END_VAR

  ErrorState    := FSM_UDP;
  ErrorMessage  := UdpError;
  ErrorCode     := ErrCode;

END_FUNCTION


FUNCTION VIRTUAL _UDPTransceiverInterface::ResetErrorStates

  ErrorState    := _UDPTransceiver::_FSM_UDP_USER::_STATE_IDLE_UDP;
  ErrorMessage  := _UDPTransceiver::_UDP_ERROR::_NO_ERROR_UDP_ERROR;
  ErrorCode     := 0;

END_FUNCTION
