//{{LSL_IMPLEMENTATION

FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::AddSocket
	VAR_OUTPUT
		dHandle 	: DINT;
	END_VAR

  dHandle := 0;

  //Check the Object state and get a new socket handle if ready
  if (State = _STATE_NO_SOCKET) then


    Socket := _UDPTransceiver.AddSocket(this);

    if (Socket <> 0) then

      dHandle := Socket;
      State := _STATE_INIT_SOCKET;

    else

      ErrorMessage := _UDPTransceiver.GetLastError();

    end_if;
  end_if;


END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::BindSocket
	VAR_INPUT
		pIpAddress 	: ^CHAR;
		udPort 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR

  dRetcode := _UDPTransceiver.BindSocket(Socket, pIpAddress, udPort);
  if dRetcode = 1 then
    State := _STATE_BOUND_SOCKET;
  elsif dRetcode < 0 then
    ErrorMessage$DINT := dRetcode;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::DelSocket
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR

  retcode := _UDPTransceiver.DelSocket(Socket);
  if retcode = 0 then
    Socket := 0;
    State := _STATE_NO_SOCKET;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::SendData
	VAR_INPUT
		pData 	: ^void;
		udSize 	: UDINT;
		bDirect 	: BOOL;
		udIpAddress 	: UDINT;
		udPort 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR

  dRetcode := UDP_CLT_INVALID_HANDLE;
  if (Socket <> 0) then   // V.1.2
    dRetcode := _UDPTransceiver.SendData(Socket,
                              pData,
                              udSize,
                              bDirect,
                              udIpAddress,
                              udPort);
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::FLUSHRingbuffer

  _UDPTransceiver.FLUSHRingbuffer(Socket);

END_FUNCTION


FUNCTION VIRTUAL GLOBAL _UDPTransceiverInterface::IsOpen
	VAR_OUTPUT
		bRetcode 	: BOOL;
	END_VAR

  bRetcode := _UDPTransceiver.IsOpen(Socket);

END_FUNCTION


