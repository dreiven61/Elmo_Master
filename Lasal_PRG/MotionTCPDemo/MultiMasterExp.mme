		<RemoteServer Name="_LMCRobotBase1.Position8" Name_DESC="Name" GUID_Svr="{E61AABC7-BF52-4F1E-8D5D-2534E998784B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 8 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Position9" Name_DESC="Name" GUID_Svr="{5EC9D165-75FA-4C50-90E4-E649B3B528FF}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 9 [Application units]." Comment_DESC="Comment of server"/>
