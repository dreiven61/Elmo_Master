					</OutputParameter>
				</Function>
				<Function Name="IPRMoveSpline" Comment="Spline movement will be executed.&#13;&#10;The points that are to be driven are defined in an external MoveSplineTable.">
				</Function>
				<Function Name="IPRGetNoMainAxes" Comment="Number of connected axes to the first three clients of the profile object.">
				</Function>
				<Function Name="IPRProfStopMoveDecel">
					<InputParameter>
						<Parameter Name="Decel"/>
						<Parameter Name="Jerk"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="Index"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRLimitProfileDynamics" Comment="NewInst method to set dynamic limits of the path dynamic of the path calculated.&#13;&#10;The feature allows to limit the speed, acceleration and deceleration on the fly.&#13;&#10;Additionally the limitations can be automatically deactivated after a certain distance. The automatic limitation distance is started again after a break and restart of movement.">
					<InputParameter>
						<Parameter Name="Mode" Comment="Mode of profile dynamics limitation.&#13;&#10;Bit 1 ... 0=Deactivate; 1=Activate the partial limitation. Activating an active limtation again resets the actual distance.&#13;&#10;Bit 2 ... 0=StopMove(1..4) ignores the limitation to allow performing a stop of profile movement with original dynamic; 1=StopMove(1..4) dynamic is limited by given dynamic limits too."/>
						<Parameter Name="VLimit" Comment="Speed limit in given in application units per second. &#13;&#10;VLimit = 0 deactivates the speed limit."/>
						<Parameter Name="ALimit" Comment="Acceleration limit in given in application units per second. &#13;&#10;ALimit = 0 deactivates the acceleration limit."/>
						<Parameter Name="DLimit" Comment="Deceleration limit in given in application units per second.&#13;&#10;When the profile is already braking to its destination the deceleration can not be limited further. The reason is that, the destination could not be reached when deceleration is limited while braking.&#13;&#10;DLimit = 0 deactivates the deceleration limit."/>
						<Parameter Name="Distance" Comment="Optional distance check given in application units per second.&#13;&#10;When Distance = 0 the dynamic limits are active until the feature is deactivated manually&#13;&#10;When Distance &lt; 0 the feature is deactivated (similar as resetting the bit in Mode input)&#13;&#10;When Distance &gt; 0 the dynamic limits are active for a movement distance given by the value. The actual path restarts, when the profile is stopped by StopMove(1..4)."/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode" Comment="Return code of method to mark if setting new limit for the profile dynamics was successful.&#13;&#10;_LMCPROF_NoError ... new profile dynamic limit settings set"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRDynamicPositionCorrection" Comment="Method to configure unfiltered pressure correction feature for the given axis.&#13;&#10;The position for the given axis is then calculated by:&#13;&#10;dynamically corrected position = nomimal position + (dynamic correction factor * nominal velocity)">
					<InputParameter>
						<Parameter Name="AxisNo" Comment="Axis number to identify which axis should be handled. The feature can be activated on multiple extruders at the same time.&#13;&#10;AxisNo = 1 ... Axis 1&#13;&#10;AxisNo = 7 ... Axis 7 (Axis U)"/>
						<Parameter Name="PressureCorrectionFactor" Comment="Dynamic correction factor. The scaling factor is given in mm/s in application units considering resolution.&#13;&#10;The dynamic correction can be deactivated by setting the value to 0.&#13;&#10;The dynamic correction gets activated with all other values."/>
						<Parameter Name="Mode" Comment="Parameter to define different modes of pressure correction application.&#13;&#10;Following Mode settings are supported:&#13;&#10;Mode = 0 ... default - dynamic position correction is applied for every move&#13;&#10;Bit 1 = 1 ... no dynamic position correction when axis moves in negative direction&#13;&#10;Bit 2 = 1 ... no dynamic position correction when only this axis is moving&#13;&#10;Bit 3 = 1 ... no dynamic position correction when axis is moving in negative direction in following command"/>
						<Parameter Name="pDetailConfig" Comment="Input parameter using type t_s_DynamicPosCorrectionDetail to set up the dynamic position correction in more detail"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode" Comment="Return code of method:&#13;&#10; _LMCPROF_NoError ... Activating / Deactivating EPC for given axis number was successful.&#13;&#10;_LMCPROF_AXIS_NOT_CONNECTED ... Given axis number is not allowed or connected&#13;&#10;_LMCPROF_PARAMETER_ERROR ... Given Mode is not supported&#13;&#10;"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRGetBufferData_EndPos" Comment="Get the end positions out of an entry from the user buffer">
					<InputParameter>
						<Parameter Name="Index"/>
						<Parameter Name="pData"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRGetBufferData_VMax" Comment="Get the vmax out of an entry from the user buffer">
					<InputParameter>
						<Parameter Name="Index"/>
						<Parameter Name="pData"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRSetAxesPositionsG92Direct" Comment="NewInst method to add a SetProfPos entry to set the axis position and the profile position to the same position. &#13;&#10;Is used by _LMCCNCIPRBase to perform a G92 set profile positions command, when a following move command exists.">
					<InputParameter>
						<Parameter Name="pAxPos" Comment="Pointer to the new profile / axis positions "/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode" Comment="Return code of method. Shows if method was successfull.&#13;&#10;READY ... method executed successfully&#13;&#10;ERROR ... method failed"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRIsSetProfPosLastCmd" Comment="Checks if the last cmd is a SetProfPos command to trigger finishing the command in RtTask of _LMCCNCIPRBase.">
					<OutputParameter>
						<Parameter Name="IsLastCmd" Comment="Return value of method. Shows if a SetProfPos is in profile buffer which is the last command without any following command."/>
					</OutputParameter>
				</Function>
				<Function Name="IPRReadAxisCoupleCheck" Comment="NewInst method to check various states for the given axis number.">
					<InputParameter>
						<Parameter Name="AxisNo" Comment="AxisNo gives the current axis number for axis couple check. The AxisNo can also be a special value to check group of axis.&#13;&#10;0 ... all axes&#13;&#10;-1 ... all axes which are connected to a hardware controller&#13;&#10;-2 ... all axes which are connected to a calc model controller&#13;&#10;-3 ... all axes which are coupled to _LMCProfile / _LMCRobotBase&#13;&#10;-4 ... all axes which are coupled to kinematic class&#13;&#10;1-9 ... axis 1 to axis 9 coupled to _LMCProfile / _LMCRobotBase&#13;&#10;101-109 ... axis 1 to axis 9 coupled to kinematic class"/>
						<Parameter Name="Parameter" Comment="Parameter is used to define which value exactly shoule be returned.&#13;&#10;LMCPROF_ACCS_CheckActive ... returns if an axis couple check should be performed for the given AxisNo.&#13;&#10;LMCPROF_ACCS_ProfileStopActive ... returns if the given AxisNo currently triggers a profile stop. For queries with special AxisNo the information is bitwised masked which axis triggers profile stop at the moment.&#13;&#10;LMCPROF_ACCS_CurrentConfig ... returns the current axis check category (NoReaction, Stop, Error) for the given AxisNo. For queries with special AxisNo the strictest reaction is returned (NoReaction &lt; Stop &lt; Error)."/>
						<Parameter Name="pRetCode" Comment="Pointer to the return code of the internal queries or internal checks. Returns the error type of the internal error."/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="Value" Comment="Output parameter of method returning the result of the query defined by the Parameter value."/>
					</OutputParameter>
				</Function>
				<Function Name="IPRSetAxisCoupleCheck" Comment="Public method to set the active setting for axis couple check feature.">
					<InputParameter>
						<Parameter Name="AxisNo" Comment="AxisNo gives the current axis number for axis couple check. The AxisNo can also be a special value to check group of axis.&#13;&#10;0 ... all axes&#13;&#10;-1 ... all axes which are connected to a hardware controller&#13;&#10;-2 ... all axes which are connected to a calc model controller&#13;&#10;-3 ... all axes which are coupled to _LMCProfile / _LMCRobotBase&#13;&#10;-4 ... all axes which are coupled to kinematic class&#13;&#10;1-9 ... axis 1 to axis 9 coupled to _LMCProfile / _LMCRobotBase&#13;&#10;101-109 ... axis 1 to axis 9 coupled to kinematic class"/>
						<Parameter Name="CheckSetting" Comment="Input parameter defining the axis check reaction for the given axis number."/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="RetCode" Comment="Return code of the method marking of the change of axis couple check setting was successful.&#13;&#10;_LMCPROF_NoError ... axis check couple setting applied succesfully&#13;&#10;_LMCPROF_AXIS_NOT_CONNECTED ... invalid AxisNo"/>
					</OutputParameter>
				</Function>
			</NewInst>
		</RemoteServer>
		<RemoteServer Name="_LMCRobotBase1.ProfileStatus" Name_DESC="Name" GUID_Svr="{E057A4C3-5546-4C75-BBC3-9962453C9B57}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFILESTATES" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="bit field displaying various information about the profile state" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ActCmd" Name_DESC="Name" GUID_Svr="{3E9BF934-F95B-4283-98B1-92183FD09AE3}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFCMDTYPES" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Display of move-commands:&#13;&#10;======================&#13;&#10;&#13;&#10;CMD_Nothing&#13;&#10;No command registered in the Buffer&#13;&#10;&#13;&#10;CMD_Linear&#13;&#10;Linear Movement&#13;&#10;&#13;&#10;CMD_CircleCW&#13;&#10;Clockwise Circular Movement in 2D&#13;&#10;&#13;&#10;CMD_CircleCCW&#13;&#10;Counter-clockwise Circular Movement in 2D&#13;&#10;&#13;&#10;CMD_Circle3D&#13;&#10;Circular Movement in 3D&#13;&#10;&#13;&#10;CMD_SetProfPos&#13;&#10;Set the profile positions. (Waiting for a new move command to execute.)&#13;&#10;&#13;&#10;CMD_MoveCurve&#13;&#10;Evasive movement with MoveCurve()" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ActCmdNo" Name_DESC="Name" GUID_Svr="{AE8D6138-2B18-4F63-B41C-23D76FBB21E6}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Index of the current move command" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.SumIndex" Name_DESC="Name" GUID_Svr="{3F650052-A8F9-47BB-BA36-08F1B3D4FF51}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Number of entries in the UserBuffer remaining to be traversed." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ProfileError" Name_DESC="Name" GUID_Svr="{07832EB3-E99C-437C-93E6-E4EBB2D9829D}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFERRORTYPES" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errormessages:&#13;&#10;=======================================================================================================================================&#13;&#10;_LMCPROF_NoError              - No error occured&#13;&#10;_LMCPROF_INIT_ERROR           - Not enough memory for the profile buffer&#13;&#10;_LMCPROF_MOVECMD_ERROR        - Unknown move command&#13;&#10;_LMCPROF_INT_POINTER_ERROR    - Internal pointer error&#13;&#10;_LMCPROF_JUMP_CMD_ERROR       - After a jump active command there is no active entry in the buffer&#13;&#10;_LMCPROF_POS_OVERRUN_ERROR    - Set position overrun&#13;&#10;_LMCPROF_AXIS_ERROR           - One of the coupled axes has an error&#13;&#10;_LMCPROF_SWE_ERROR            - SW end position violation while loading the command&#13;&#10;_LMCPROF_CIRDEF_ERROR         - The circle definition is wrong&#13;&#10;_LMCPROF_NO_POS_CHANGE        - Move command without any axes travel&#13;&#10;_LMCPROF_GROUP_ERROR          - Change Command to this Group is not possible because the Set Group has no Distance / SubError: Set GroupNr&#13;&#10;_LMCPROF_KOFAC_ERROR          - Division error in the calculation of the coupling factors / Sub error shows the axis number&#13;&#10;_LMCPROF_VEL_CMD_ERROR        - Movement speed &lt; 1&#13;&#10;_LMCPROF_ACC_CMD_ERROR        - Movement acceleration / deceleration &lt; 1&#13;&#10;_LMCPROF_JERK_CMD_ERROR       - Movement jerk &lt; 1&#13;&#10;_LMCPROF_RESOLUTION_ERROR     - Error occured while loading the command,the entries are bigger than 2^31 when multiplied by the resolution factor.&#13;&#10;_LMCPROF_SAFETY_ZONES_REACHED - User has reached a safety zone&#13;&#10;_LMCPROF_INSERT_ERROR         - The profile buffer is full&#13;&#10;_LMCPROF_AXIS_NOT_CONNECTED   - Selected axis was not found or is not connected&#13;&#10;_LMCPROF_GROUP_NOT_FOUND      - Selected group is not configured in the system&#13;&#10;_LMCPROF_PARAMETER_NOT_FOUND  - Selected parameter was not found in the settings&#13;&#10;_LMCPROF_PARAMETER_ERROR      - Enable/disable of the selected function is impossible&#13;&#10;_LMCPROF_ERROR_BUSY           - Changeing a parameter is not allowed in this mode&#13;&#10;_LMCPROF_OUT_OF_RANGE         - Set value was too big or too small&#13;&#10;_LMCPROF_RADIUS_ERROR         - Circle radius is out of range (radius &gt; 2^31 - 1 [internal units]).&#13;&#10;_LMCPROF_ARCLEN_ERROR         - Circle arc length is out of range (arc length &gt; 2^31 - 1 [internal units]).&#13;&#10;_LMCPROF_RES_PATHLEN_ERROR    - The residual path length is out of range (residual path length &gt; 2^31 - 1 [internal units]).&#13;&#10;_LMCPROF_ENDPOS_ERROR       - The end position of a move is out of range (end position &gt; 2^31 - 1 [Internal units]).&#13;&#10;_LMCPROF_AXTRAVEL_ERROR       - The axis travel distance is out of range (end position - start position &gt; 2^31 - 1 [Internal units]).&#13;&#10;_LMCPROF_AX_COUPLE_ERROR      - Some axis coupling command (CoupleGearAbsolute etc.) returned an error.&#13;&#10;_LMCPROF_PLAINEDEF_ERROR      - The Plaine of the Circle is not defined&#13;&#10;_LMCPROF_VEC_ERROR       - Coordinates of Vecotrs used for Calcualtion of a Circle are out of Range&#13;&#10;_LMCPROF_LOCKGROUP_ERROR      - Slave-Group of an Axis is undefined.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Override" Name_DESC="Name" GUID_Svr="{C6DBEFFA-6BB6-4FCD-B978-3E828C45EF40}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" Comment="This server is used to adjust the actual speed (1000 corresponds to 100%).&#13;&#10;By default, the range is defined between 0 - 100%. This can also be adjusted with the SetProfileParameter() method." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.OpMode" Name_DESC="Name" GUID_Svr="{94EC5842-EA0F-4DE5-B309-9D73F54F1B55}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROF_OPMODE" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" Comment="AUTOMATIC:&#13;&#10;In the automatic mode, a movement is processed and set values for the individual axes are calculated as soon as it is loaded.&#13;&#10;&#13;&#10;MANUAL&#13;&#10;In manual operation, the loaded movement-commands are not started automatically. A command to the start must be given. &#13;&#10;Once given, the axes moves to the next end point and stops according to the command mode.&#13;&#10;If the axes are in idle status, a new start command must be sent in order to continue." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Start" Name_DESC="Name" GUID_Svr="{D7035C4C-EFD0-4473-8E26-0723D6AC757B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" Comment="An input of &quot;1&quot; into this server initiates the movement. &#13;&#10;If a point is approached, whereby the speed of all axes is zero, a new start command must be sent.&#13;&#10;The type of the next move command is shown on the server ActCmd, the index of the command on server ActCmdNo.&#13;&#10;&#13;&#10;This server is active in manual mode only." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Position1" Name_DESC="Name" GUID_Svr="{DCA68108-72D5-4FEE-9D3C-B382E6E4313B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 1 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Position2" Name_DESC="Name" GUID_Svr="{8793CC89-67FE-4CC0-A44B-56E6B8051A84}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 2 [Application units]." Comment_DESC="Comment of server"/>
