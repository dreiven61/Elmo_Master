<?xml version="1.0" encoding="ISO-8859-1" ?>
<RemoteStation
	PrjRev        = "0.0"
	PrjRev_DESC   = "Version of the project"
	Project       = "MotionTCPDemo"
	Project_DESC  = "Name of the project"
	Filename      = "D:\01_Kunden\02_Archiv\Servostar\Semics\02_Project\MotionTCPDemo\MotionTCPDemo.lcp"
	Filename_DESC = "File name to project">
	<RemoteServers>
		<RemoteServer Name="_LMCAxis1.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis1.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{3E7AF1DF-A1BB-4302-8A18-6584D666E187}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis10.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{FCF935E1-D4F0-4D63-BE7F-21605B3C527C}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis11.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CD301F28-9DD2-453A-966C-1BDFBD774B26}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis12.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{ABD6BD3E-68FA-42B1-AB56-A16D3FDDA5D8}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis2.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{BF365EE8-C502-43E9-9B3F-23B565F86B39}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis3.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{636AC676-B363-467E-967C-F5AD58E0544D}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis4.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{9EB762F3-DCD1-457A-8118-24D7BAB51802}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis5.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{552DA71B-CCBF-4E06-8460-BA4B8997E4B4}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis6.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{CF5FC4F9-9840-4B50-9156-6DC81D173C6D}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis7.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{968A82FE-1121-4CC4-994C-A24F23161293}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis8.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{54324559-75E1-49CD-A2DC-BD44C94449E8}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis9.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{36405FFE-9466-4DF8-A5E4-A005DCDCBAF2}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Control" Name_DESC="Name" GUID_Svr="{813CA014-8D4F-4BB9-954A-F20F4611CBBF}" GUID_Svr_DESC="GUID of the server" Class="_AxisBase" Class_DESC="Class" DataType="_LMCAXIS_OPMODE" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="This server is the interface to the user application, so that &#13;&#10;axis commands can be sent.&#13;&#10;&#13;&#10;Operation mode of the axis&#13;&#10;=========================&#13;&#10;&#13;&#10;PASSIVE_LMCAXIS  - The axis is in the passive rest state according to a reset&#13;&#10;WAITIDLE_LMCAXIS - The axis is in the passive rest state according to call of the methode &quot;PowerOn&quot;&#13;&#10;IDLE_LMCAXIS     - The axis is in an active rest state and ready for move-instructions&#13;&#10;MOVE_LMCAXIS     - The axis carries out a movement&#13;&#10;FOLLOW_LMCAXIS   - The axis is in the status: Follow&#13;&#10;STOPED_LMCAXIS   - The axis stops for the standstill&#13;&#10;LOCKED_LMCAXIS   - The slave axis couples to a master axis or is already coupled&#13;&#10;REFRUN_LMCAXIS   - The axis carries out a reference movement&#13;&#10;TUNEPOS_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the positive direction&#13;&#10;TUNENEG_LMCAXIS  - The axis carries out a tune movement - in this case, it moves in the negative direction&#13;&#10;ERROR_LMCAXIS    - An error occurred" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.AxisStatus" Name_DESC="Name" GUID_Svr="{68B6CC31-3184-4BD8-9AEF-5517DF33D4FB}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_STATUS" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Stateflags of the axis&#13;&#10;======================&#13;&#10;&#13;&#10;Bit 1: PowerOn - Set if the Axis is activated  &#13;&#10;Bit 2: IsReferenced - Set if the Axis is referenced&#13;&#10;Bit 3: InPosition - Set if the axis is in the correct position&#13;&#10;Bit 4: FiltRdy - Set if the Axis is in position and jerk filter is ready&#13;&#10;Bit 5: Decell - Set if the axis brakes; calculated by tic for tic&#13;&#10;Bit 6: PosLimActive - Set if the axis has achieved one of its end-positions&#13;&#10;Bit 7: SetFlg - Set by calling the SetPositon, CNCRefRun and NCRefRun functions Reset after activating the controller&#13;&#10;Bit 8: EnLesFlg - Set if the axis moves endless / infinitely&#13;&#10;Bit 9: DirFlg - Set if the Speed of the axis is negative&#13;&#10;Bit 10: EmergStop - Set if the axis stops, because an error occurs or the axis is deactivated&#13;&#10;Bit 11: Overflow- Set if a position overflow occurs&#13;&#10;Bit 12: MasterLock - Set if the slave-axis is coupled onto the master-axis&#13;&#10;Bit 13: AutoRun - Set if autotuning is running&#13;&#10;Bit 14: AutoStop - Set if autotuning is ready done&#13;&#10;Bit 15: ActDirFlag - Set if the Speed of the axis is negative&#13;&#10;Bit 16: HandFlag - Set if the function &quot;MoveHand&quot; or &quot;PowerOff&quot; is called.&#13;&#10;Bit 17: ModuloFlg - Set if the axis is defined as a modulo-axis&#13;&#10;Bit 18: NCMotion - Is set by the controller if the axis is in the NC positioning-mode&#13;&#10;Bit 19: NoActPosMeth - Set if the client &quot;ActPosition&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 20: NoControlMeth - Set if the client &quot;LMCController&quot; is not connected or the simulation mode is acting&#13;&#10;Bit 21: NoRefMeth - Set if the client &quot;LMCReference&quot; is not connected or the Bit 19: &quot;NoActPosMeth&quot; is set&#13;&#10;Bit 22: NoActPosChk - Set if the client &quot;LMCSafety&quot; is not connected or HWReady is not connected (simulation mode is acting)&#13;&#10;Bit 23: NoPreCyclic - Set if the client &quot;LMCPreCyclicTrigger&quot; is not connected&#13;&#10;Bit 24: NoPostCyclic - Set if the client &quot;LMCPostCyclicTrigger&quot; is not connected&#13;&#10;Bit 25: DelayedMasterLock - configureable, alternative version of the MasterLock bit&#13;&#10;Bit 26: Standstill - Set if the axis is currently not moving.&#13;&#10;Bit 27: BrakeForPowerOff - Set, if the axis is currently stoping for power off.&#13;&#10;Bit 28: MasterError - Set, if some error of the master axis occured.&#13;&#10;Bit 29: SlaveError - Set, if some error of a coupled slave axis occured." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.PosMode" Name_DESC="Name" GUID_Svr="{CDFCD1F3-6AB5-4624-A6A9-C75262DE1C51}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_POSMODE" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Positioning mode of the axis&#13;&#10;==================&#13;&#10;&#13;&#10;_Positioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_NCPositioning&#13;&#10;The Axis is not coupled and acts depending on a command defined by the user&#13;&#10;&#13;&#10;&#13;&#10;_StdSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis in some standard-mode&#13;&#10;&#13;&#10;&#13;&#10;_UserSyncPositioning&#13;&#10;The slave-axis couples a position defined by the user to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_CAMSyncPositioning&#13;&#10;The slave-axis couples onto a master-axis by means of a user-defined curve&#13;&#10;&#13;&#10;&#13;&#10;_ProfileSyncPositioning&#13;&#10;The axis couples on a disk-table&#13;&#10;&#13;&#10;&#13;&#10;_SyncVelocity&#13;&#10;The slave-axis couples its speedrate to the master-axis&#13;&#10;&#13;&#10;&#13;&#10;_StartPolynomPositioning&#13;&#10;The slave-axis links up to a master-axis by means of splines&#13;&#10;&#13;&#10;&#13;&#10;_SyncPolynomPositioning&#13;&#10;The salve-axis is coupled onto a master-axis by means of splines" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.AxisError" Name_DESC="Name" GUID_Svr="{D915F1B2-0033-45ED-95CD-98E5AC15454C}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Errorflags of the axis&#13;&#10;=====================&#13;&#10;&#13;&#10;Bit 1: HwError&#13;&#10;Set if a general Hardware-error occured&#13;&#10;&#13;&#10;Bit 2: SwMinError&#13;&#10;Set if the Software endswitch minimum active&#13;&#10;&#13;&#10;Bit 3: SwMaxError&#13;&#10;Set if the Software endswitch maximum active&#13;&#10;&#13;&#10;Bit 4: HwMinError&#13;&#10;Set if the minimal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 5: HwMaxError&#13;&#10;Set if the maximal-position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 6: ReferenceError&#13;&#10;Set if an error occurred during the reference-run&#13;&#10;&#13;&#10;Bit 7: ContouringError&#13;&#10;Set if a tracking error occured&#13;&#10;&#13;&#10;Bit 8: ActPosError&#13;&#10;Set if the position of the hardware is invalid &#13;&#10;&#13;&#10;Bit 9: AbsOffsetError&#13;&#10;AxisError.AbsOffsetError&#13;&#10;&#13;&#10;Bit 10: OverFlowError&#13;&#10;Set if a Position-overflow occured&#13;&#10;&#13;&#10;Bit 11 EmergencyError&#13;&#10;Set if the _LMCSafety.Emergency is active&#13;&#10;&#13;&#10;Bit 12 ResolutionError&#13;&#10;Set if the Resolution causes an overflow error&#13;&#10;&#13;&#10;Bit 13, 14, 15&#13;&#10;Unsused&#13;&#10;&#13;&#10;Bit 16: GlobErr&#13;&#10;Set if some global error is active&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.ActPos" Name_DESC="Name" GUID_Svr="{864367D4-AA4F-4D63-B05E-6A13737A7360}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Actual position of the axis [Application units]&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SetPos" Name_DESC="Name" GUID_Svr="{A24425E6-4E11-412C-83A7-960537ADB33E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Actual calculated position set value of the axis [application units].&#13;&#10;&#13;&#10;The Write methode will call a SetPostion() command." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Destination" Name_DESC="Name" GUID_Svr="{291661D9-1815-4147-8350-8B61B9B02D38}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual target position [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Override" Name_DESC="Name" GUID_Svr="{FF96B1A2-F449-4E94-BD43-CD91AB79A05F}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="The override is a percentage reduction of the assigned speed &#13;&#10;for the actual motion command. (1000 = 100.0%)." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.ActVelocity" Name_DESC="Name" GUID_Svr="{43EADA72-7000-4485-8C9B-A3472AA6CA4E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Filtered / unfiltered actual speed [Application units/s]. See SetParameter()." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SetVelocity" Name_DESC="Name" GUID_Svr="{7691CDA2-0D42-445A-8364-865F948A8BAB}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated speed set value of the axis [Application units/s]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SimulateMode" Name_DESC="Name" GUID_Svr="{22BE35A3-9C0D-4FF6-B5E2-4ECB033D46B6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="activate (1) / deactivate (0) a simulation mode (virtual axis mode) &#13;&#10;during the application runs.&#13;&#10;The server must be initialized.&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.ExUnits" Name_DESC="Name" GUID_Svr="{9FE2BF63-FF3B-4C14-B568-13EB87B3E07C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.IntUnits" Name_DESC="Name" GUID_Svr="{FA32FE70-022F-4ED1-8CFE-BDD41F6AD0D7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="This value is a part of the transmission ratio. &#13;&#10;InternalPosition [Application Unit] = ExternalPosition [Encoder value] * InternalUnit / ExternalUnit&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.VMax" Name_DESC="Name" GUID_Svr="{26F9E93C-F21E-4BA6-AED9-4EF7C79E11F7}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Maxmimum speed of the axis [Application units / s]&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.AMax" Name_DESC="Name" GUID_Svr="{ADBEB5C9-4395-4FCF-80BA-D40753878DA4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Maximum acceleration and deceleration [Application units / s²].&#13;&#10;The server must be initialized. " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Tjerk" Name_DESC="Name" GUID_Svr="{57A5493C-1735-4622-BB13-42B699CCBC9D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Time for the acceleration to attain its maximum value [ms]&#13;&#10;&#13;&#10;The meaning of this value depends on the server MoveType:&#13;&#10;_RAMP_PROFILE: no effect&#13;&#10;_SCURVE_PROFILE: filter size for the SCURVE buffer&#13;&#10;_JERK_PROFILE: If the server JMax=0, then this value defines the maximal jerk of the axis by AMax / TJerk. &#13;&#10;               Otherwise, if JMax&lt;&gt;0, then this value has no effect." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.MoveType" Name_DESC="Name" GUID_Svr="{69DE3781-2054-4C7E-94C1-D8816EBD029B}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_MOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Moving profile of the axis&#13;&#10;_RAMP_PROFILE - axis moves without jerk limitation&#13;&#10;_SCURVE_PROFILE - jerk limitation through position filtering&#13;&#10;_JERK_PROFILE - jerk limitation through computed trapezoid acceleration/deceleration&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Resolution" Name_DESC="Name" GUID_Svr="{DAF3A77D-F362-45C0-9B72-8734F61E4225}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Internal resolution factor.&#13;&#10;All entries are internally multiplied with this factor. Through this value, a more precise &#13;&#10;profile calculation is made. If the resolution factor is changed, the value of the internal &#13;&#10;unit must also be raised by the same factor. If axis parameters like the modulo or software &#13;&#10;limits have already been defined, these parameters must also be checked and adjusted. &#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.Modulo" Name_DESC="Name" GUID_Svr="{384697FA-6383-4042-B2B5-869B06B81AC4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Modulo value of the axis [Application units]. If the value is &lt;&gt; 0, the actual position is converted &#13;&#10;to a modulo position using the Modulo function.&#13;&#10;The server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SWMinPos" Name_DESC="Name" GUID_Svr="{61F22F0F-46A7-49AA-A29C-03B86C420418}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Minimum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is smaller than -MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SWMaxPos" Name_DESC="Name" GUID_Svr="{BDE8F6A7-C046-4CA2-BA01-A8416D226E14}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Maximum software end position [Application units].&#13;&#10;&#13;&#10;To deactivate SW-Limit, set value which is bigger than MaxModulo.&#13;&#10;&#13;&#10;Value can be set if Axis is disabled.&#13;&#10;&#13;&#10;Further information about the allowed values are to be found in the class documentation." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.ErrorConfig" Name_DESC="Name" GUID_Svr="{161823E3-9952-44E8-B3A0-9B1AD627E0F6}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAXIS_ERROR_CONFIG" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="With this server an user-defined&#13;&#10;error configuration can be adjusted" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.AEmergency" Name_DESC="Name" GUID_Svr="{804104B7-F4D7-40B5-855F-6D0F785617EC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="deceleration if Emergency &lt;&gt; 0 [Application units / s²]&#13;&#10;if AEmergency is smaller AMax, the deceleration is AMax" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.JMax" Name_DESC="Name" GUID_Svr="{F40EF8AA-6964-4819-9DA6-F1FBB2CBF180}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="Defines the maximal jerk of the axis [Application units / sec^3 / 1000]&#13;&#10;&#13;&#10;for MoveType=_JERK_PROFILE only&#13;&#10;&#13;&#10;If this value equals 0, then the maximal jerk is computed by Amax / TJerk." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.SafeAxisState" Name_DESC="Name" GUID_Svr="{5E791631-FB9C-4D2A-A438-488E91177476}" GUID_Svr_DESC="GUID of the server" DataType="_LMCAxisBase::t_s_LMCAxis_SafetyState" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The server shows the general safety info of the connected hardware axis. The server only shows the basic info and not the detailed information.&#13;&#10;Bit 1 ... SafeAxis - Connected axis supports safety features&#13;&#10;Bit 2 ... SpeedLimited - Safety limits the maximum allowed speed of the axis&#13;&#10;Bit 3 ... AxisReady - Axis can be enabled&#13;&#10;Bit 4 ... AxisOperational - Safety is fully operational - normal functional behaviour&#13;&#10;Bit 5 ... AxisError - Safety FW of drive is in error state&#13;&#10;Bit 6 ... ServiceModePending - Service mode will be activated soon&#13;&#10;Bit 7 ... SafeErrorQuitPending - Drive is doing a safety error quit before functional error quit&#13;&#10;Bit 8 ... AxisVerified - Connected axis verified or doesn&apos;t need to be verified&#13;&#10;Bit 9 ... AxisVerifyFailed - Verify or clear verification of axis failed&#13;&#10;Bit 10 ... AxisReferenced - Connected axis referenced or doesn&apos;t need to be referenced&#13;&#10;Bit 11 ... AxisReferenceActive - Axis reference movement is currently active. Bit is only set, when safe reference movement is done via _LMCAxis.&#13;&#10;Bit 12 ... AxisReferenceNeeded - Connected axis must be safe referenced. The reference state is available on bit AxisReferenced&#13;&#10;Bit 13 ... AxisReferenceFailed - Reference or clear reference of axis failed&#13;&#10;Bit 14 ... SBTAvailable - Connected axis supports SBT&#13;&#10;Bit 15 ... SBTActive - Automatic SBT is currently active&#13;&#10;Bit 16 ... SBTFailed - Automatic SBT failed" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCAxis_Master_6_7_8.AbsEncoder" Name_DESC="Name" GUID_Svr="{67A9C60B-7109-4A29-B034-0B874C9F507E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{EE4E3EFE-DE9A-487C-AE81-60BAFD3C143E}" GUID_Obj_DESC="GUID of the object" Comment="With this server absolute&#13;&#10;encoder-values can be read in" Comment_DESC="Comment of server"/>
		<RemoteServer
			Name                = "_LMCRobotBase1.Control"
			Name_DESC           = "Name"
			GUID_Svr            = "{85FC2FCB-E70A-45C9-8EE4-9A9C0977DE2E}"
			GUID_Svr_DESC       = "GUID of the server"
			Class               = "_LMCProfileBase"
			Class_DESC          = "Class"
			DataType            = "ProfileCommandStatus"
			DataType_DESC       = "DataType"
			GUID_Obj            = "{C84CFA5E-955F-4078-813B-A3CC0235FEE0}"
			GUID_Obj_DESC       = "GUID of the object"
			Type                = "Object Channel"
			Type_DESC           = "Type"
			HasNewInst          = "true"
			HasNewInst_DESC     = "Multimaster server has NewInst commands"
			WriteProtected      = "true"
			WriteProtected_DESC = "Write protection of multimaster server"
			Comment             = "Serves an interface for the LMCProfile class to call the application methods &#13;&#10;and displays the actual status of the LMCProfile class&#13;&#10;============================================================================&#13;&#10;&#13;&#10;PassiveProfile:&#13;&#10;Axis are unlocked in passive mode&#13;&#10;&#13;&#10;IdleProfile:&#13;&#10;Axis are locked in idle mode - no motion sequences are available&#13;&#10;&#13;&#10;IdleProfileRestart:&#13;&#10;Restart or Start at Line Number is active&#13;&#10;&#13;&#10;RunProfile:&#13;&#10;Axes are in motion to generate a profile&#13;&#10;&#13;&#10;ErrorProfile:&#13;&#10;An error occured&#13;&#10;&#13;&#10;IdleProfileRestart:&#13;&#10;waiting for end of restart&#13;&#10;&#13;&#10;WaitProfileRestart:&#13;&#10;waiting for end of delay time after calling ContinueNCProg()&#13;&#10;&#13;&#10;WaitProfileForAxInPos:&#13;&#10;Profile is waiting for the actual axis positions to be in position at an exact stop"
			Comment_DESC        = "Comment of server">
			<NewInst>
				<Function Name="IPRSetBasicParameter">
					<InputParameter>
						<Parameter Name="Vmax"/>
						<Parameter Name="AMax"/>
						<Parameter Name="JMax"/>
						<Parameter Name="TangError"/>
						<Parameter Name="PosOffset1"/>
						<Parameter Name="PosOffset2"/>
						<Parameter Name="PosOffset3"/>
						<Parameter Name="PosOffset4"/>
						<Parameter Name="PosOffset5"/>
						<Parameter Name="PosOffset6"/>
