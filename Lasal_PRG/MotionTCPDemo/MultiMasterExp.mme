					<OutputParameter>
						<Parameter Name="RetValue"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRSetAxesPositionsG92Immediate" Comment="This function inserts a buffer entry with the command type &quot;_LMCMT_SetProfPos&quot; and the given start positions into the profile buffer. Additionally the axes positions are set immediately with SetPosition() and SetParameter(). &#13;&#10;This function can be used if the position of one or more locked axes have to be set to a defined position immediately.   ">
					<InputParameter>
						<Parameter Name="pAxPos"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="enRetCode"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRTangAxisConfig" Comment="This function is used to configure the tangential axis.">
					<InputParameter>
						<Parameter Name="TangAxisIdx" Comment="Index of the tangential axis."/>
						<Parameter Name="FirstAxisIdx" Comment="Index of first transversal axis."/>
						<Parameter Name="SecondAxisIdx" Comment="Index of second transversal axis."/>
						<Parameter Name="AngleOffset" Comment="Offset of the tangential axis to the tangental direction defined by the two transversal axes."/>
						<Parameter Name="MaxDeltaAngle" Comment="Maximum change of the angle of the transversal axis before an additional move command gets included."/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="Success" Comment="Configuration of the tangential axis succeeded."/>
					</OutputParameter>
				</Function>
				<Function Name="IPRTangAxisActivate" Comment="This function activates the tangential axis.">
					<InputParameter>
						<Parameter Name="TangAxis" Comment="Index of the specificied tangential axis."/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="Success" Comment="Activation succeeded."/>
					</OutputParameter>
				</Function>
				<Function Name="IPRTangAxisDeactivate" Comment="This function deactivates the tangential axis.">
					<InputParameter>
						<Parameter Name="TangAxis"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="Success" Comment="Deactivation succeeded."/>
					</OutputParameter>
				</Function>
