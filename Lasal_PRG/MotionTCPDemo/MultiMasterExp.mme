						<Parameter Name="Destination9"/>
					</OutputParameter>
				</Function>
				<Function Name="IPRStopMoveEndOfMovement" Comment="Stops the profile at the end of a movement with an exact stop. The movement where the exact stop is performed is determined by calculating the brake distance that is needed to stop with the handed over deceleration or the maximum deceleration. The remaining buffer entries after the stop are removed.">
					<InputParameter>
						<Parameter Name="Decel"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="StopCmdNo"/>
					</OutputParameter>
				</Function>
