		<RemoteServer Name="_LMCRobotBase1.Destination4" Name_DESC="Name" GUID_Svr="{E09384B4-5250-482E-9B9F-55B1B3B2A15D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 4 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination5" Name_DESC="Name" GUID_Svr="{EA6285EE-B626-4485-AD87-85CC4D5D2D7B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 5 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination6" Name_DESC="Name" GUID_Svr="{D01889CA-3DF2-449B-9D8D-4D646B72D5F6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 6 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination7" Name_DESC="Name" GUID_Svr="{E813B2B9-964C-45AD-9815-9EB9CDC3399B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 7 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination8" Name_DESC="Name" GUID_Svr="{FE5329CF-3B1B-4669-BF24-D1111443585D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 8 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination9" Name_DESC="Name" GUID_Svr="{657CBEE9-2800-4232-89A5-0627E7A93BC1}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 9 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Resolution" Name_DESC="Name" GUID_Svr="{9AEB3D1A-07D8-4EE6-BA95-4809B3656348}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The resolution factor, which is applied to position, speed and acceleration values, is read over this server.&#13;&#10;All inputs are internally multiplied with this resolution factor. The LMCProfile class and the connected LMCAxis objects must have the same resolution factor.&#13;&#10;This server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.MoveType" Name_DESC="Name" GUID_Svr="{79C05DC3-6DB8-4C6F-987B-542F38196821}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFMOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" Comment="With this server a motion-type can be selected:&#13;&#10;RAMP_PROFILE -&gt; the motion is defined by a ramp limiting velocity and acceleraation / deceleration&#13;&#10;JERK_PROFILE -&gt; the motion is defined by a smooth function limiting velocity, acceleraation / deceleration and jerk &#13;&#10;This server must be initialized.&#13;&#10; " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ErrorConfig" Name_DESC="Name" GUID_Svr="{C926A1B5-3FE9-495F-8D16-6690F0A1CF2E}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFERRWARNCONFIG" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="By setting or clearing individual bits, error messages can be enabled or&#13;&#10;disabled. This server must be initialized.&#13;&#10;============================================================================&#13;&#10;&#13;&#10;Case: a movement-command carries out no movement of the axis&#13;&#10;Bit 1: bPosChangeWarning&#13;&#10;FALSE ... error is ignored&#13;&#10;TRUE  ... a warning is displayed&#13;&#10;&#13;&#10;Case: while calculating a parameter with the intern resolution-factor, an overflow error occurred&#13;&#10;Bit 2: bResolutionError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: an axis has achieved a limiting position or a Safety-Position&#13;&#10;Bit 3: bPosLimitError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: the definition of circle-parameters is erroneous &#13;&#10;Bit 4: bCircleError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: one of the parameters: Velocity, Acceleration or Jerk is less than 1  &#13;&#10;Bit 5: bCmdLimitError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: while calculating the coupling-factors of an axis, an overflow error occurred&#13;&#10;Bit 6: bKoFacError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: the endpoint of a movement is inside of a safety zone&#13;&#10;Bit 7: bSafetyZonesError&#13;&#10;FALSE: a warning is issued when the endpoint of a movement is inside of a safety zone&#13;&#10;TRUE : an error is issued when the endpoint of a movement is inside of a safety zone" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ResidualPath" Name_DESC="Name" GUID_Svr="{59F4AC50-1674-4403-B5FB-86361EF27BDF}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Residual path is the sum of all loaded path length minus &#13;&#10;the distance travelled so far." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ActProfileVelocity" Name_DESC="Name" GUID_Svr="{A05E320B-3AFF-4631-98CE-97C6E633B93C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The velocity of the profile is announced in mm/sec" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_SigTCPDataManager1.TCPComm" Name_DESC="Name" GUID_Svr="{D74D586B-E6F7-44C6-AF41-E206D251EB7D}" GUID_Svr_DESC="GUID of the server" Class="TCPCommunication" Class_DESC="Class" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{952F2B1C-4294-417D-9612-E4B6335874CB}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" Comment="Object server of the class TCPCommunication. &#13;&#10;Can be used to call the global methods of the TCPCommunication class.&#13;&#10;The class TCPCommunicationLogViewer can be connected to this server in order to read and export the log entries." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_SigTCPDataManager1.ComPort" Name_DESC="Name" GUID_Svr="{C43EE6EC-E9B6-4E85-AB26-070D60A414FF}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{952F2B1C-4294-417D-9612-E4B6335874CB}" GUID_Obj_DESC="GUID of the object" Comment="The TCP Port which is used for communication has to be configured here. &#13;&#10;Sender and Receiver have to use the same port.&#13;&#10;&#13;&#10;If there are multiple senders or receivers in the same project, different ports must be used.&#13;&#10;&#13;&#10;e.g.: Sender1 - Receiver1 -&gt; 500&#13;&#10;       Sender2 - Receiver2 -&gt; 600" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_SigTCPDataManager1.Online" Name_DESC="Name" GUID_Svr="{6FC2E8F2-0F35-4DC2-84EA-CCC083ADA24C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{952F2B1C-4294-417D-9612-E4B6335874CB}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="State of the connection &#13;&#10;0 = Offline&#13;&#10;1 = Online" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_SigTCPDataManager1.LogEnable" Name_DESC="Name" GUID_Svr="{7BD6337D-190E-4903-BB6C-D94C673ED1B5}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{952F2B1C-4294-417D-9612-E4B6335874CB}" GUID_Obj_DESC="GUID of the object" Comment="0 = Logging is deactivated&#13;&#10;1 = Logging is active" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_SigTCPDataManager1.ResetLogBuffer" Name_DESC="Name" GUID_Svr="{0607D514-E186-434E-8884-DF5BE0C9B4CF}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{952F2B1C-4294-417D-9612-E4B6335874CB}" GUID_Obj_DESC="GUID of the object" Comment="Write() on this Server deletes the internal log buffer. &#13;&#10;Can only be executed if the server LogEnable is set to 0." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_UDPTransceiver1.sControl" Name_DESC="Name" GUID_Svr="{EC8E176D-59FF-4FBB-9FC3-3761C0306EB6}" GUID_Svr_DESC="GUID of the server" Class="_UDPTransceiver" Class_DESC="Class" DataType="_UDPTransceiver::_FSM_UDP_USER" DataType_DESC="DataType" GUID_Obj="{4BF48E7F-EC93-4007-833C-36CD969CECD7}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Object Channel&#13;&#10;-) use the channel to call global functions from external&#13;&#10;-) this server shows the UDP state" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_UDPTransceiver1.sError" Name_DESC="Name" GUID_Svr="{78B4FD40-2202-4C76-991A-03D3A831608C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{4BF48E7F-EC93-4007-833C-36CD969CECD7}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0 = no error&#13;&#10;1 = error" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_UDPTransceiver1.sErrorMessage" Name_DESC="Name" GUID_Svr="{BF78ABBE-5D26-4106-BC8D-263E5593F747}" GUID_Svr_DESC="GUID of the server" DataType="_UDPTransceiver::_UDP_ERROR" DataType_DESC="DataType" GUID_Obj="{4BF48E7F-EC93-4007-833C-36CD969CECD7}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="  0 = _NO_ERROR_UDP_ERROR&#13;&#10; -1 = _INIT_TCP_USER_UDP_ERROR&#13;&#10; -2 = _NO_IP_ADDRESS_UDP_ERROR&#13;&#10; -3 = _NO_MEMORY_CONNECTION_UDP_ERROR&#13;&#10; -4 = _NO_MEMORY_SENDBUFFER_UDP_ERROR&#13;&#10; -5 = _INVALID_HANDLE_UDP_ERROR&#13;&#10; -6 = _SHUTDOWN_UDP_ERROR&#13;&#10; -7 = _CLOSESOCKET_UDP_ERROR&#13;&#10; -8 = _ALLOCATE_SOCKET_UDP_ERROR&#13;&#10; -9 = _SET_BIND_UDP_ERROR&#13;&#10;-10 = _RECV_UDP_ERROR&#13;&#10;-11 = _SEND_UDP_ERROR&#13;&#10;-12 = _NO_LOCAL_IP_UDP_ERROR&#13;&#10;-13 = _NO_DESTINATION_IP_UDP_ERROR&#13;&#10;-14 = _NO_MEMORY_RECVBUFFER_UDP_ERROR" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_UDPTransceiver1.sErrorNoOS" Name_DESC="Name" GUID_Svr="{492ADA87-B5C8-443C-91C3-58899E35EC87}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{4BF48E7F-EC93-4007-833C-36CD969CECD7}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="TCP_NOT_READY           -2000&#13;&#10;TCP_INVALID_SOCKSTATE   -2001&#13;&#10;TCP_NOMEM_ERROR         -2002&#13;&#10;TCP_BUFFER_TO_SMALL     -2003&#13;&#10;TCP_MAXSOCKETS_ERROR    -2004&#13;&#10;TCP_INVALID_SOCKNUM     -2005&#13;&#10;TCP_INVALID_NUMBER      -2007&#13;&#10;TCP_SYSTEM_ERROR        -2008&#13;&#10;TCP_NOIF_ERROR          -2009&#13;&#10;&#13;&#10;//getlasterror codes&#13;&#10;TCP_ADDR_NOT_AVAIL      -3000   //endpoint address not available&#13;&#10;TCP_ADDR_IN_USE         -3001   //address in use&#13;&#10;TCP_AF_NO_SUPPORT       -3002   //family not supported&#13;&#10;TCP_ARP_TABLE_FULL      -3003   //arp table full&#13;&#10;TCP_INVALID_BAUD        -3004   //invalid baud rate &#13;&#10;TCP_INVALID_COMM_PORT   -3005   //invalid comm port number&#13;&#10;TCP_INVALID_DEVICE      -3006   //invalid device type&#13;&#10;TCP_INVALID_IFACE       -3007   //invalid interface number&#13;&#10;TCP_INVALID_MASK        -3008   //invalid mask (ether must not be all fs)&#13;&#10;TCP_INVALID_PING        -3009   //invalid ping response&#13;&#10;TCP_CONN_REFUSED        -3010   //endpoint refused connection&#13;&#10;TCP_DEST_ADDR_REQ       -3011   //destination address is required&#13;&#10;TCP_DEST_UNREACH        -3012   //destination unreachable (ICMP)&#13;&#10;TCP_INVALID_PARAM       -3013   //invalid parameter (pointer is 0)&#13;&#10;TCP_IFACE_CLOSED        -3014   //interface closed&#13;&#10;TCP_IFACE_TABLE_FULL    -3015   //interface table full&#13;&#10;TCP_IFACE_OPEN_FAIL     -3016   //interface open failed&#13;&#10;TCP_IN_PROGRESS         -3017   //operation (connect) is in progress&#13;&#10;TCP_INVALID_FUNC        -3018   //invalid function call (parameter)&#13;&#10;TCP_SOCKET_CONNECTED    -3019   //socket is already connected&#13;&#10;TCP_MC_TABLE_FULL       -3020   //multicast table full&#13;&#10;TCP_MC_ADDR_NOT_FOUND   -3021   //multicast address not found&#13;&#10;TCP_OUT_OF_PORTS        -3022   //out of ports &#13;&#10;TCP_NET_DOWN            -3023   //network is down (send failed)&#13;&#10;TCP_NET_UNREACH         -3024   //network unreachable (keepalive failed)&#13;&#10;TCP_OUT_OF_DCUS         -3025   //out of DCUs (packets)&#13;&#10;TCP_OPTPARAM_INVALID    -3026   //option parameter is invalid&#13;&#10;TCP_SOCK_NOT_CONNECTED  -3027   //socket is not connected&#13;&#10;TCP_RTIP_NOT_INST       -3028   //RTIP not initialized (i.e. xn_rtip_init not called)&#13;&#10;TCP_INVALID_SOCKET      -3029   //invalid socket descriptor&#13;&#10;TCP_NUM_DEVICE          -3030   //not enough devices (see CFG_NUM_ED,CFG_NUM_SMCX, NUM_3C, NUM_RS232 etc)&#13;&#10;TCP_OP_NOT_SUPPORT      -3031   //socket type or specified operation not supported for this function&#13;&#10;TCP_OUTPUT_FULL         -3032   //send failed due to output list being full&#13;&#10;TCP_PROBE_FAIL          -3033   //could not determine device&#13;&#10;TCP_RENTRANT            -3034   //non-reentrancy error&#13;&#10;TCP_ROUTE_NOT_FOUND     -3035   //routing table entry not found&#13;&#10;TCP_ROUTE_FULL          -3036   //routing table full&#13;&#10;TCP_RSC_INIT_FAIL       -3037   //resource initialization failed&#13;&#10;TCP_SHUTDOWN            -3038   //illegal operation due to socket shutdown&#13;&#10;TCP_TIMEOUT             -3039   //timeout&#13;&#10;TCP_TYPE_NOT_SUPPORT    -3040   //type not supported (only SOCK_STREAM and SOCK_DGRAM are supported)&#13;&#10;TCP_WOULD_ARP           -3041   //send needs to ARP but ARP is disabled (see INCLUDE_ARP)&#13;&#10;TCP_WOULD_BLOCK         -3042   //socket non-blocking but function would block&#13;&#10;TCP_UNKNOWN_ERROR       -3043" Comment_DESC="Comment of server"/>
