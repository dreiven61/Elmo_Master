		<RemoteServer Name="_LMCRobotBase1.Position4" Name_DESC="Name" GUID_Svr="{267D81D8-E234-4751-9A00-FECF71F67648}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 4 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Position5" Name_DESC="Name" GUID_Svr="{BA365A76-A746-41FE-BA44-6C3B1EADD5AA}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 5 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Position6" Name_DESC="Name" GUID_Svr="{5810250B-D27B-49E2-86C1-94DF7029E5B5}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C84CFA5E-955F-4078-813B-A3CC0235FEE0}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 6 [Application units]." Comment_DESC="Comment of server"/>
