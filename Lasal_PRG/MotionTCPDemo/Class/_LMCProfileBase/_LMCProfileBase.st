			pObstacle 	: ^_LMCPROF_OBSTACLE;			//! <Variable Comment="This input parameter specifies the evasive movement properties (Obstacle to swerve around).&#13;&#10;&#13;&#10;Possible Values:&#13;&#10;pObstacle &lt;&gt; NIL - MoveCurve type movement is performed.&#13;&#10;pObstacle = NIL - MoveLinear type movement is performed." Name="MoveCurveSpline.pObstacle"/>
