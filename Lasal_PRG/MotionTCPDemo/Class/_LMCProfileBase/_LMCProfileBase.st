		VAR_INPUT
			FactorMul 	: UDINT;			//! <Variable Comment="Factor for increasing the moving time. E.g. If FactorMul=2, FactorDiv = 1, the movement will take double the time." Name="StretchLastMove.FactorMul"/>
			FactorDiv 	: UDINT;			//! <Variable Comment="Factor for decreasing the moving time. E.g. If FactorMul=1, FactorDiv=2, the movement will take half of the time." Name="StretchLastMove.FactorDiv"/>
