				//! <Function Comment="Global method to set dynamic limits of the path dynamic of the path calculated.&#13;&#10;The feature allows to limit the speed, acceleration and deceleration on the fly.&#13;&#10;Additionally the limitations can be automatically deactivated after a certain distance. The automatic limitation distance is started again after a break and restart of movement." Name="LimitProfileDynamics"/>
	FUNCTION VIRTUAL GLOBAL LimitProfileDynamics
		VAR_INPUT
			Mode 	: t_s_PartialDynParaLimitModes;			//! <Variable Comment="Mode of profile dynamics limitation.&#13;&#10;Bit 1 ... 0=Deactivate; 1=Activate the partial limitation. Activating an active limtation again resets the actual distance.&#13;&#10;Bit 2 ... 0=StopMove(1..4) ignores the limitation to allow performing a stop of profile movement with original dynamic; 1=StopMove(1..4) dynamic is limited by given dynamic limits too." Name="LimitProfileDynamics.Mode"/>
			VLimit 	: DINT;			//! <Variable Comment="Speed limit in given in application units per second. &#13;&#10;VLimit = 0 deactivates the speed limit." Name="LimitProfileDynamics.VLimit"/>
			ALimit 	: DINT;			//! <Variable Comment="Acceleration limit in given in application units per second. &#13;&#10;ALimit = 0 deactivates the acceleration limit." Name="LimitProfileDynamics.ALimit"/>
			DLimit 	: DINT;			//! <Variable Comment="Deceleration limit in given in application units per second.&#13;&#10;When the profile is already braking to its destination the deceleration can not be limited further. The reason is that, the destination could not be reached when deceleration is limited while braking.&#13;&#10;DLimit = 0 deactivates the deceleration limit." Name="LimitProfileDynamics.DLimit"/>
			Distance 	: DINT;			//! <Variable Comment="Optional distance check given in application units per second.&#13;&#10;When Distance = 0 the dynamic limits are active until the feature is deactivated manually&#13;&#10;When Distance &lt; 0 the feature is deactivated (similar as resetting the bit in Mode input)&#13;&#10;When Distance &gt; 0 the dynamic limits are active for a movement distance given by the value. The actual path restarts, when the profile is stopped by StopMove(1..4)." Name="LimitProfileDynamics.Distance"/>
		END_VAR
		VAR_OUTPUT
			RetCode 	: _LMCPROFERRORTYPES;			//! <Variable Comment="Return code of method&#13;&#10;_LMCPROF_NoError ... no error - method successful" Name="LimitProfileDynamics.RetCode"/>
		END_VAR;
				//! <Function Comment="This method defines which axes are coupled.&#13;&#10;&#13;&#10;This method is only allowed to be called from a thread running on the same Core as the Realtime Thread for the _LMCProfile instance which has an equal or lower priority than the Realtime Thread." Name="LockProfile"/>
