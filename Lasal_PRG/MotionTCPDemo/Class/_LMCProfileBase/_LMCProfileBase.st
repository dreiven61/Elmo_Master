				//! <Function Comment="This method stops / restarts the movement, the axes remain locked.&#13;&#10;&#13;&#10;The following parameters can be specified using the Mode Input Parameter:&#13;&#10;1. Whether the motion can be restarted or not.&#13;&#10;2. Whether the deceleration for the current move is used or the specified deceleration (Decel Input Parameter) is used to decelerate.&#13;&#10;&#13;&#10;Mode:&#13;&#10;0 - Restart the motion, the value in the Decel input parameter has no effect.&#13;&#10;1 - The movement is stopped using the deceleration set in the current movement.&#13;&#10;2 - When Decel &lt;&gt; 0, the movement is stopped using the deceleration specified in the Decel input parameter, here it is important to note the setting of the Parameter _LMCPROF_DynamicType as Decel can be specified in per mill or AppUnits/sec. If Decel = 0, the movement is stopped using the deceleration set in the actual move command.&#13;&#10;3 - As in option 2, however the Profile Buffer is also cleared, therefore the current movement cannot be restarted.&#13;&#10;&#13;&#10;This method is only allowed to be called from a thread running on the same Core as the Realtime Thread for the _LMCProfile instance which has an equal or lower priority than the Realtime Thread." Name="StopMove"/>
	FUNCTION VIRTUAL GLOBAL StopMove
		VAR_INPUT
			Mode 	: DINT;			//! <Variable Comment="The following parameters can be specified using the Mode Input Parameter:&#13;&#10;1. Whether the motion can be restarted or not.&#13;&#10;2. Whether the deceleration for the current move is used or the specified deceleration (Decel Input Parameter) is used to decelerate.&#13;&#10;&#13;&#10;Mode:&#13;&#10;0 - Restart the motion, the value in the Decel input parameter has no effect.&#13;&#10;1 - The movement is stopped using the deceleration set in the current movement.&#13;&#10;2 - When Decel &lt;&gt; 0, the movement is stopped using the deceleration specified in the Decel input parameter, here it is important to note the setting of the Parameter _LMCPROF_DynamicType as Decel can be specified in per mill or AppUnits/sec. If Decel = 0, the movement is stopped using the deceleration set in the actual move command.&#13;&#10;3 - As in option 2, however the Profile Buffer is also cleared, therefore the current movement cannot be restarted.&#13;&#10;4 - The profile stops at the end of the earliest possible move command with an exact stop. The earliest possible move command is determined with the Decel input parameter or with the deceleration specified for the move command if Decel is 0. The profile buffer after the exact stop is cleared. " Name="StopMove.Mode"/>
			Decel 	: DINT := 0;			//! <Variable Comment="This input parameter should contain the braking deceleration to be used. Decel = 0 uses the actual deceleration of the move command.&#13;&#10;The value is only considered if Mode = 2 / 3 / 4." Name="StopMove.Decel"/>
			Jerk 	: DINT := 0;			//! <Variable Comment="This input parameter can be used to define a command specific jerk limit. Jerk = 0 uses the actual jerk limit of the move command.&#13;&#10;When a command specific jerk limit is used the decel must be given too.&#13;&#10;This value is only applied for Mode = 2 / 3 / 4." Name="StopMove.Jerk"/>
		END_VAR
		VAR_OUTPUT
			StopCmdNo 	: UDINT;			//! <Variable Comment="Return value of method&#13;&#10;Gives the stop index. The stop index is the profile buffer entry where the movement will stop." Name="StopMove.StopCmdNo"/>
		END_VAR;
