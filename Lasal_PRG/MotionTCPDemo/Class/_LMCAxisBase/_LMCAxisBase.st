		<Client Name="LMCPostRtWorkTrigger" Required="false" Internal="false" Comment="With this client, a connection to a user class can be established so &#13;&#10;that it can run with the same task time as the application. Over this &#13;&#10;client, the RtWork method of a user class is called as the last task in RtWork."/>
		<Client Name="LMCPreRtWorkTrigger" Required="false" Internal="false" Comment="With this client, a connection to a user class can be established so &#13;&#10;that it can run with the same task time as the application. Over this &#13;&#10;client, the RtWork method of a user class is called as first Task in RtWork."/>
		<Client Name="LMCPublisher" Required="false" Internal="false" Comment="This client is an object channel to _LMCPublisher"/>
		<Client Name="LMCReference" Required="false" Internal="false" Comment="This client is used for communication between the reference class (RefStandaard) &#13;&#10;and the profile generator (_LMCAxisBase)."/>
		<Client Name="LMCSafety" Required="false" Internal="false" Comment="Connection to an object of the class _WatchProtCubes. With this connection, a safety zone monitor is activated for linear movements"/>
		<Client Name="TaskObjectControl" Required="false" Internal="false" Comment="This client is an object channel for _TaskObjectControl to call operating system methods."/>
	</Channels>
