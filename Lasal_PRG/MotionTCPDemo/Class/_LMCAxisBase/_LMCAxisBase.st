	  t_s_SafetyData : STRUCT  //! <Type Comment="Private type to store all safety data which is linked to safe axis handling including reading / writing info, all Flags and SBT Data." Revision="1.0" Name="t_s_SafetyData"> <RevDoku>  <Owner Company="Sigmatek"/>  <Dokumentation Revision="1.0" Date="2023-07-17" Author="StePhi" Company="Sigmatek" Description="Initial version of type"/> </RevDoku></Type>
	    VerifyCmd : DINT;  //! <Type Comment="Stores the verify command value of the last read of the verify state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_VERIFYSTATE). For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.VerifyCmd"/>
	    VerifyState : DINT;  //! <Type Comment="Stores the verify state value of the last read of the verify state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_VERIFYSTATE).  For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.VerifyState"/>
	    ReferenceCmd : DINT;  //! <Type Comment="Stores the reference command value of the last read of the reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE). For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.ReferenceCmd"/>
	    ReferenceState : DINT;  //! <Type Comment="Stores the reference state value of the last read of the reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE). For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.ReferenceState"/>
	    SafetyRunState : t_e_AxisSafety_SafetyRunState;  //! <Type Comment="Read SafetyRunState from the hw - the safety run state is read once at bootup of class." Name="t_s_SafetyData.SafetyRunState"/>
	    SafeErrorCodeSC1 : DINT;  //! <Type Comment="Read safety error code from safety controller 1 - to determine if a safety error is active." Name="t_s_SafetyData.SafeErrorCodeSC1"/>
	    SafeQuitTimeMark : UDINT;  //! <Type Comment="Time mark of request to quit the safety error" Name="t_s_SafetyData.SafeQuitTimeMark"/>
	    CmdState : iprStates;  //! <Type Comment="Stores the command state of the last read of the verify or reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE).&#13;&#10;Allowed values:&#13;&#10;READY ... the command was successfully processed&#13;&#10;BUSY ... the command is still processing&#13;&#10;ERROR ... processing the command failed -  async communication failed" Name="t_s_SafetyData.CmdState"/>
	    ExecState : iprStates;  //! <Type Comment="Stores the execution state of the last read of the verify or reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE).&#13;&#10;Allowed values:&#13;&#10;READY ... the execution value is valid and the request was processed successfully.&#13;&#10;BUSY ... the command is still processing and the execution value is not updated&#13;&#10;ERROR ... processing the command failed -  async communication failed" Name="t_s_SafetyData.ExecState"/>
	    DriveAxisState : DINT;  //! <Type Comment="Value of DriveAxis is updated in Background task cyclically. The last read value of AxisState server of connected DriveAxis is available here." Name="t_s_SafetyData.DriveAxisState"/>
	    DriveExecState : iprStates;  //! <Type Comment="AxisState of DriveAxis is updated in Background task cyclically. The execution state shows if the stored value is valid.&#13;&#10;READY ... AxisState is valid and read in Background-Task&#13;&#10;BUSY ... AxisState is read at the moment&#13;&#10;ERROR ... can not read AxisState - value of AxisState is not valid" Name="t_s_SafetyData.DriveExecState"/>
	    ActiveSafeFnct : t_e_AxisSafety_ActiveSafeFnct;  //! <Type Comment="Bit field copy of HWK bit field to show the active safety function. The type of this variable is a copy of MDD2000 HWK server type for general usage in DriveSafetyIF.h." Name="t_s_SafetyData.ActiveSafeFnct"/>
	    ActiveSafeFnctValid : DINT;  //! <Type Comment="Marks if the values of ActiveSafeFunct are valid.&#13;&#10;READY ... valid data&#13;&#10;ERROR ... reading of data failed&#13;&#10;ERROR_BUSY ... reading successful, but values are not valid at the moment. Wait to receive valid data." Name="t_s_SafetyData.ActiveSafeFnctValid"/>
	    ActiveSafeFnctRetCode : DINT;  //! <Type Comment="RetCode of request to read active safe function from hardware class.&#13;&#10;READY ... successful request&#13;&#10;ERROR ... requested failed&#13;&#10;BUSY ... request not finished" Name="t_s_SafetyData.ActiveSafeFnctRetCode"/>
	    SS2Configured : DINT;  //! <Type Comment="Parameter is set, when SS2 is configured on connected axis." Name="t_s_SafetyData.SS2Configured"/>
	    pMasterThis : ^void;  //! <Type Comment="Pointer to connected master of safe axis. Gets set by SetParameter(LMCAXIS_PAR_SET_MASTERPOINTER, ...) by _LMCProfile object." Name="t_s_SafetyData.pMasterThis"/>
	    NIParaCmdStruct : CmdStruct;  //! <Type Comment="CmdStruct to handle NewInst commands directly from _LMCAxis concerning safety features.&#13;&#10;At the moment it is only used to trigger a StopMove in case of SS2 at the connected profile object." Name="t_s_SafetyData.NIParaCmdStruct"/>
	    NIParaCmdResult : results;  //! <Type Comment="Results struct to handle NewInst commands directly from _LMCAxis concerning safety features.&#13;&#10;At the moment it is only used to trigger a StopMove in case of SS2 at the connected profile object." Name="t_s_SafetyData.NIParaCmdResult"/>
	    Flags : BDINT  //! <Type Comment="Bit structure to store the bits linked to SafetyData handling or axis functions linked to a safe axis." Name="t_s_SafetyData.Flags"/>
	    [
	      1 bSBTatPowerOn,  //! <Type Comment="SBT is automatically performed, when a PowerOn() on the axis is done." Name="t_s_SafetyData.Flags.bSBTatPowerOn"/>
	      2 bSBTatPowerOnIgnore,  //! <Type Comment="SBT will not be triggered the next time a PowerOn() is done regardless of the general setting. It is also ignored if the last SBT failed or was successful." Name="t_s_SafetyData.Flags.bSBTatPowerOnIgnore"/>
	      3 bSBTTriggered,  //! <Type Comment="SBT is currently active and it is triggered with an automatic SBT at PowerOn()." Name="t_s_SafetyData.Flags.bSBTTriggered"/>
	      4 bSBTValidTimeMark,  //! <Type Comment="Flag marking if the stored time mark for last automatic SBT is valid. If the time mark is invalid SBT is triggered at next PowerOn() when feature is active." Name="t_s_SafetyData.Flags.bSBTValidTimeMark"/>
	      5 bSBTatPowerOnErrReact,  //! <Type Comment="Flag marking the error reaction when SBT fails when it is automatically triggered at a PowerOn().&#13;&#10;FALSE ... (Default) Axis is in operation mode ERROR_LMCAXIS when SBT fails.&#13;&#10;TRUE ... PowerOn() routine is performed normally even, when SBT fails at PowerOn()." Name="t_s_SafetyData.Flags.bSBTatPowerOnErrReact"/>
	      6 bNoAutomaticSS2,  //! <Type Comment="Flag which defines if an automatic SS2 should be done or not. The feature is active by default. When the feature is deactivated the application must handle SS2 by itself.&#13;&#10;0 ... automatic SS2 active&#13;&#10;1 ... automatic SS2 inactive" Name="t_s_SafetyData.Flags.bNoAutomaticSS2"/>
	      7 bSBTatPowerOnDeactivated,  //! <Type Comment="Flag which stores when the user actively deactived automatic SBT feature in init before the the SBT values are read from the axis. When the user actively deactived feature it is not activated later." Name="t_s_SafetyData.Flags.bSBTatPowerOnDeactivated"/>
	      9 bFuncReferenced,  //! <Type Comment="Temporary flag to store either,&#13;&#10;the state of the functional reference, when a safety reference is done or,&#13;&#10;the result of the functional reference, when a safety reference is performed directly after functional reference finished successful." Name="t_s_SafetyData.Flags.bFuncReferenced"/>
	      10 bReadVerifyState,  //! <Type Comment="Local marking flag to read the verify state in background, when it should be updated automatically.&#13;&#10;The verify state is automatically read when a SetVerify or a ClearVerify is performed." Name="t_s_SafetyData.Flags.bReadVerifyState"/>
	      11 bReadReferenceState,  //! <Type Comment="Local marking flag to read the reference state in background, when it should be updated automatically.&#13;&#10;The reference state is automatically read when a ClearReference is performed." Name="t_s_SafetyData.Flags.bReadReferenceState"/>
	      12 bSafeAxisLogin,  //! <Type Comment="Local marking flag that login to safe drive axis class worked. Call back is active and data handling works." Name="t_s_SafetyData.Flags.bSafeAxisLogin"/>
	      13 bSafeErrorQuitActive,  //! <Type Comment="Flag marking that a safey error quit must be performed. The flag is set as long as the safety error quit is done or it is marked, that a safe error quit should be done.&#13;&#10;Only active when bit bDoSafeErrorQuit is set." Name="t_s_SafetyData.Flags.bSafeErrorQuitActive"/>
	      14 bReReadReferenceState,  //! <Type Comment="Local marking flag to mark that a reread of the reference state is triggered." Name="t_s_SafetyData.Flags.bReReadReferenceState"/>
	      15 bReadSS2State,  //! <Type Comment="Flag marking that configuration state of SS2 safe function should get queried from hardware class." Name="t_s_SafetyData.Flags.bReadSS2State"/>
	      17 bSBTMinTorqueRead,  //! <Type Comment="Local flag marking that the minimal torque value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTMinTorqueRead"/>
	      18 bSBTTestTimeRead,  //! <Type Comment="Local flag marking that the test time value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTTestTimeRead"/>
	      19 bSBTTestIntervalRead,  //! <Type Comment="Local flag marking that the test interval value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTTestIntervalRead"/>
	      20 bSBTMinTorqueError,  //! <Type Comment="Local flag marking that reading the minimal torque value of SBT failed." Name="t_s_SafetyData.Flags.bSBTMinTorqueError"/>
	      21 bSBTTestTimeError,  //! <Type Comment="Local flag marking that reading the test time value of SBT failed." Name="t_s_SafetyData.Flags.bSBTTestTimeError"/>
	      22 bSBTTestIntervalError,  //! <Type Comment="Local flag marking that reading the test interval value of SBT failed." Name="t_s_SafetyData.Flags.bSBTTestIntervalError"/>
	      23 bSafeErrorCodeError,  //! <Type Comment="Reading the safety error code from SC1 failed. Stored value is invalid." Name="t_s_SafetyData.Flags.bSafeErrorCodeError"/>
	      24 bAxisHWError,  //! <Type Comment="Value of AxisError.HWError from one cycle before the actual cycle. Used to trigger reading the safety error code from the axis, when a hw error occured." Name="t_s_SafetyData.Flags.bAxisHWError"/>
	      25 bSS2ConfiguredRead,  //! <Type Comment="Flag marking that reading of configuration state of SS2 is done. That can mean successfully or unsuccessfully but finished." Name="t_s_SafetyData.Flags.bSS2ConfiguredRead"/>
	      26 bSBTTestIntervalByUser,  //! <Type Comment="Flag marks that SBT test interval time is set by the user and not automatically." Name="t_s_SafetyData.Flags.bSBTTestIntervalByUser"/>
	    ];
	    SBTData : t_s_SBTData;  //! <Type Comment="Substructure storing relevant data of SBT handling and setting values." Name="t_s_SafetyData.SBTData"/>
	  END_STRUCT;
