#pragma using _AxisBase

_LMCAxisBase : CLASS
: _AxisBase
	TYPE
#pragma pack(push, 4)
	  _AxisAccDec : STRUCT
	    A_MaxInt : DINT;  //! <Type Comment="Maximum acceleration [ Internal Units / s^2 ]" Name="_AxisAccDec.A_MaxInt"/>
	    A_EmergInt : DINT;  //! <Type Comment="Maximum of AMax and AEmergency [IntUnits / sec^2]" Name="_AxisAccDec.A_EmergInt"/>
	    A_Set : DINT;  //! <Type Comment="Acceleration Setpoint in Physical Units (before Factor)" Name="_AxisAccDec.A_Set"/>
