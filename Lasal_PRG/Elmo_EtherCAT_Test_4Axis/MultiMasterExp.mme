				<Function Name="IPRSetAxesPositionsG92" Comment="Set the start position(s) for the following moves.&#13;&#10;&#13;&#10;This function is used by the interpreter when performing a SetAxesPositions from the cyclic task. In this case a buffer entry with the command type &quot;_LMCMT_SetProfPos&quot; and the given start positions is inserted into the profile buffer.">
					<InputParameter>
						<Parameter Name="pAxPos"/>
					</InputParameter>
					<OutputParameter>
						<Parameter Name="enRetCode"/>
					</OutputParameter>
				</Function>
