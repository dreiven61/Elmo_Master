		<RemoteServer Name="_LMCRobotBase1.Position9" Name_DESC="Name" GUID_Svr="{5EC9D165-75FA-4C50-90E4-E649B3B528FF}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated position set value of axis 9 [Application units]." Comment_DESC="Comment of server"/>
