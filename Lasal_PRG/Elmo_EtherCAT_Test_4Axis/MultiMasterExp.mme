		<RemoteServer Name="_LMCRobotBase1.Destination3" Name_DESC="Name" GUID_Svr="{2E33DC49-5CBA-4DB5-BEBC-0B06950BBF85}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 3 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination4" Name_DESC="Name" GUID_Svr="{E09384B4-5250-482E-9B9F-55B1B3B2A15D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 4 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination5" Name_DESC="Name" GUID_Svr="{EA6285EE-B626-4485-AD87-85CC4D5D2D7B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 5 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination6" Name_DESC="Name" GUID_Svr="{D01889CA-3DF2-449B-9D8D-4D646B72D5F6}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 6 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination7" Name_DESC="Name" GUID_Svr="{E813B2B9-964C-45AD-9815-9EB9CDC3399B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 7 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination8" Name_DESC="Name" GUID_Svr="{FE5329CF-3B1B-4669-BF24-D1111443585D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 8 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Destination9" Name_DESC="Name" GUID_Svr="{657CBEE9-2800-4232-89A5-0627E7A93BC1}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Actual calculated target position of axis 9 [Application units]." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.Resolution" Name_DESC="Name" GUID_Svr="{9AEB3D1A-07D8-4EE6-BA95-4809B3656348}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The resolution factor, which is applied to position, speed and acceleration values, is read over this server.&#13;&#10;All inputs are internally multiplied with this resolution factor. The LMCProfile class and the connected LMCAxis objects must have the same resolution factor.&#13;&#10;This server must be initialized." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.MoveType" Name_DESC="Name" GUID_Svr="{79C05DC3-6DB8-4C6F-987B-542F38196821}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFMOVEPROFILE" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" Comment="With this server a motion-type can be selected:&#13;&#10;RAMP_PROFILE -&gt; the motion is defined by a ramp limiting velocity and acceleraation / deceleration&#13;&#10;JERK_PROFILE -&gt; the motion is defined by a smooth function limiting velocity, acceleraation / deceleration and jerk &#13;&#10;This server must be initialized.&#13;&#10; " Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ErrorConfig" Name_DESC="Name" GUID_Svr="{C926A1B5-3FE9-495F-8D16-6690F0A1CF2E}" GUID_Svr_DESC="GUID of the server" DataType="_LMCPROFERRWARNCONFIG" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="By setting or clearing individual bits, error messages can be enabled or&#13;&#10;disabled. This server must be initialized.&#13;&#10;============================================================================&#13;&#10;&#13;&#10;Case: a movement-command carries out no movement of the axis&#13;&#10;Bit 1: bPosChangeWarning&#13;&#10;FALSE ... error is ignored&#13;&#10;TRUE  ... a warning is displayed&#13;&#10;&#13;&#10;Case: while calculating a parameter with the intern resolution-factor, an overflow error occurred&#13;&#10;Bit 2: bResolutionError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: an axis has achieved a limiting position or a Safety-Position&#13;&#10;Bit 3: bPosLimitError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: the definition of circle-parameters is erroneous &#13;&#10;Bit 4: bCircleError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: one of the parameters: Velocity, Acceleration or Jerk is less than 1  &#13;&#10;Bit 5: bCmdLimitError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: while calculating the coupling-factors of an axis, an overflow error occurred&#13;&#10;Bit 6: bKoFacError&#13;&#10;TRUE  ... an error is displayed&#13;&#10;FALSE ... a warning is displayed&#13;&#10;&#13;&#10;Case: the endpoint of a movement is inside of a safety zone&#13;&#10;Bit 7: bSafetyZonesError&#13;&#10;FALSE: a warning is issued when the endpoint of a movement is inside of a safety zone&#13;&#10;TRUE : an error is issued when the endpoint of a movement is inside of a safety zone" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ResidualPath" Name_DESC="Name" GUID_Svr="{59F4AC50-1674-4403-B5FB-86361EF27BDF}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Residual path is the sum of all loaded path length minus &#13;&#10;the distance travelled so far." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ActProfileVelocity" Name_DESC="Name" GUID_Svr="{A05E320B-3AFF-4631-98CE-97C6E633B93C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="The velocity of the profile is announced in mm/sec" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.ActiveCoordSystem" Name_DESC="Name" GUID_Svr="{630C7F19-2906-4C76-B3DE-DF8474D0B19D}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Displaying the CoordSystem of the active movement." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_LMCRobotBase1.SetCoordSystem" Name_DESC="Name" GUID_Svr="{651BA6FC-61A6-45A3-9ACE-2C3286956105}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A01C18CD-FE1E-432E-B14F-EF0871CE3576}" GUID_Obj_DESC="GUID of the object" Comment="Choose the coordinate system for commiting new commands." Comment_DESC="Comment of server"/>
