	VAR_INPUT
		Syncmodes 	: BSINT;
	END_VAR
   
  bs_syncmodes := Syncmodes;

END_FUNCTION

FUNCTION _SyncMeasureECAT::Calculate_LLFP_Offset
  VAR
    retval :DINT;
  END_VAR
    
   //actual Timestamp Linklayer
  retval := OS_ECATM_ll_get_time(pECAT, ecatmhdl, #s_Measure.LL_Timestamp1);
  if retval then
    a_ERRORCodes[0]     := retval;
    bs_ERRORS.ReadLLTS1 := TRUE;
  end_if;
  
  //Timestamp from genIRQ (20ns Counter)
  retval := OS_ECATM_GIRQ_READ_TIMESTAMPS(pECAT, #s_Measure.GIRQ_ts_Akt , #s_Measure.GIRQ_ts_RtIRQ
                                               , #s_Measure.GIRQ_ts_Send, cyccontext);
  if retval then
    a_ERRORCodes[2]       := retval;
    bs_ERRORS.ReadGIRQTSs := TRUE;
  end_if;
  
  //actual Timestamp Linklayer
  retval := OS_ECATM_ll_get_time(pECAT, ecatmhdl, #s_Measure.LL_Timestamp2);
  if retval then
    a_ERRORCodes[1]     := retval;
    bs_ERRORS.ReadLLTS2 := TRUE;
  end_if;
  
  //convert 20ns Counter to ns
  s_Measure.GIRQ_ts_RTIRQ_ns := s_Measure.GIRQ_ts_RtIRQ * 20;//Realtime Start Timestamp
  s_Measure.GIRQ_ts_Akt_ns   := s_Measure.GIRQ_ts_Akt   * 20;//Actual Timestamp value
  s_Measure.GIRQ_ts_Send_ns  := s_Measure.GIRQ_ts_Send  * 20;//Timestamp before Send of OS
  
  //Time between both read Accesses
  s_Measure.LL_Delta := s_Measure.LL_Timestamp2 - s_Measure.LL_Timestamp1;
  
  //filter
  FilterOffset((#s_Measure.LL_Delta_Filt)$^DINT, s_Measure.LL_Delta$DINT, _SYNCMECAT_FilterSize_LL_Measure_Delta);
  
  //generate Limit value
  if s_Measure.LL_delta_Filt_max < s_Measure.LL_Delta_Filt then
    s_Measure.LL_delta_Filt_max := s_Measure.LL_Delta_Filt;
  end_if;
  
  
  //sometimes the read access to the LL counter takes too long.
  //The result: the measuremant of the LL-FPGA Offset is invalide!
  //so we discard the actual offset and use the old Offset
  //the reason for this behavor is unclear.
  if (s_Measure.LL_Delta      > s_Measure.LL_delta_Filt_max) //invalide Mesurement
   | (s_Measure.LL_Timestamp2 < s_Measure.LL_Timestamp1) then //Cntr overflow
  
    if (s_Measure.LL_Delta > s_Measure.LL_delta_Filt_max) then
      Counter.LLDelta_tooHigh += 1;
    else
      Counter.LLDelta_overflow += 1;
    end_if;

    //If the Value is too High or a overrun during the Measurment happend, the measurment is invalid
    //we proceed with the old offset
    
  else
    Counter.LLDelta_OK += 1;
    
    //calc the time offset between GenIRQ counter and LinkLayer Counter
    //we take the average value to calculate out the access time.
    
    //because the jitter can be quite high.
    FilterOffset(#s_Offsets32.LLFPGA, (s_Measure.LL_Timestamp1/2)$DINT
                                   + (s_Measure.LL_Timestamp2/2)$DINT
                                   -  s_Measure.GIRQ_ts_Akt_ns$DINT, _SYNCMECAT_FilterSize_LLFP_Offset);

    
    if bs_First_measurement_done.LLFP then
    
      //Calc the difference between the last and the actual
      s_Offsets64.LLFPGA_diff := s_Offsets32.LLFPGA - s_Offsets64.LLFPGA[0]$DINT;
      
      //readjusting the 64Bit offset
      AddOffs64Bit(p_timestamp64_ns:=#s_Offsets64.LLFPGA[0], AddOffset:=s_Offsets64.LLFPGA_diff);
      
    else
      //set startvalue 64Bit
      bs_First_measurement_done.LLFP := TRUE;
      s_Offsets64.LLFPGA[0]$DINT := s_Offsets32.LLFPGA;
    end_if;
  end_if;
      
END_FUNCTION


FUNCTION _SyncMeasureECAT::Calculate_RCLL_Offset
  VAR
 	  retval :DINT;
  END_VAR
  
  //read send and receive LinkLayer timestamp of the last "Sync Frame"
  retval := OS_ECATM_cyc_get_ll_ts(pECAT, ecatmhdl, cyccontext, #s_Measure.sndts_ns, #s_Measure.rcvts_ns);
  if retval then
    a_ERRORCodes[5] := retval;
    bs_Errors.ReadTS_LL := TRUE;
  end_if;
  
  //Timestamp of the Ecat DC RefClock when receiving the ECAT frame
  retval := OS_ECATM_DC_GET_LAST_SOF(pECAT, ecatmhdl, (#s_Measure.SOF[0])$^DINT);
  if retval then
    a_ERRORCodes[6] := retval;
    bs_Errors.ReadLastSOF := TRUE;
  end_if;
  
  if s_Measure.rcvts_ns < s_Measure.sndts_ns then
    //counter overrun during measurement -> skip this cycle
    Counter.RCLL_overflow += 1;
  else
    //two calculation methods to reduce Jitter
    s_Offsets32.RCLL1 := (s_Measure.SOF[0] - s_Measure.sndts_ns + s_Measure.PropDel_RC)$DINT;
    s_Offsets32.RCLL2 := (s_Measure.SOF[0] - s_Measure.rcvts_ns
                        - s_Measure.PropDel_RC + s_Measure.roundtriptime_LL)$DINT;
   
   // s_Offsets32.RCLL :=  (s_Offsets32.RCLL1/2) + (s_Offsets32.RCLL2/2);
    FilterOffset(#s_Offsets32.RCLL, (s_Offsets32.RCLL1/2) + (s_Offsets32.RCLL2/2), _SYNCMECAT_FilterSize_RCLL_Offset);
    
    if bs_First_measurement_done.RCLL then
      
      s_Offsets64.RCLL_diff := s_Offsets32.RCLL - s_Offsets64.RCLL[0]$DINT;
      
      //readjusting the 64Bit offset
      AddOffs64Bit(p_Timestamp64_ns:=#s_Offsets64.RCLL[0], AddOffset:=s_Offsets64.RCLL_diff);
    else
    
      bs_First_measurement_done.RCLL := TRUE;
      s_Offsets64.RCLL[0]$DINT := s_Offsets32.RCLL;
      
    end_if;
  end_if;
      
END_FUNCTION
