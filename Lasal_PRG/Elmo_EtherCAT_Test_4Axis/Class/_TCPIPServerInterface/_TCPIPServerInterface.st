FUNCTION VIRTUAL GLOBAL _TCPIPServerInterface::ReadSocketParameter
	VAR_INPUT
		dSock 	: DINT;
		Cmd 	: DINT;
		SubCmd 	: DINT;
		pParaValue 	: ^DINT;
	END_VAR
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
  
  Retcode := ReadSocketParameter(dSock, Cmd, SubCmd, pParaValue);
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL _TCPIPServerInterface::MainSocketError
	VAR_INPUT
		FSM_TCP 	: _TCPIPServer::_FSM_TCPIP_SERVER;
		ErrGroup 	: DINT;
		ErrCode 	: DINT;
	END_VAR

  ErrorState    := FSM_TCP;
  ErrorGroup    := ErrGroup;
  ErrorCode     := ErrCode;
  ErrorSocket   := -1;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _TCPIPServerInterface::ConnSocketInfo
	VAR_INPUT
		dSock 	: DINT;
		InfoPara1 	: DINT;
		InfoPara2 	: DINT;
	END_VAR

  case InfoPara1 of
    TCP_SVR_SOCK_INFO_CONNECT : 
      ConnectedClients +=1;
    
    TCP_SVR_SOCK_INFO_DISCONNECT :
      ConnectedClients -=1;
      if ConnectedClients < 0 then
        ConnectedClients :=0;
      end_if;
  end_case;



END_FUNCTION

FUNCTION VIRTUAL GLOBAL _TCPIPServerInterface::ConnSocketError
	VAR_INPUT
		dSock 	: DINT;
		FSM_TCP 	: _TCPIPServer::_FSM_TCPIP_SERVER;
		ErrGroup 	: DINT;
		ErrCode 	: DINT;
	END_VAR

  ErrorState    := FSM_TCP;
  ErrorGroup    := ErrGroup;
  ErrorCode     := ErrCode;
  ErrorSocket   := dSock;

END_FUNCTION

FUNCTION _TCPIPServerInterface::ResetErrorStates

  ErrorState    := _TCPIPServer::_FSM_TCPIP_SERVER::_STATE_NONE;
  ErrorGroup    := 0;
  ErrorCode     := 0;
  ErrorSocket   := 0;

END_FUNCTION

