FUNCTION VIRTUAL GLOBAL _TCPIPServerInterface::Init

  if _FirstScan then
    
    case _TCPIPServer.AddInterface(thispointer:=this) of
    
      1 : // registration ok
          state := _STATE_RUNNING;
      
      -1: // there is already an Interface Connected
          state := _STATE_ERROR_ALREADY_INSTALLED;
      -2: // Pointer not Valid
          State := _STATE_ERROR_POINTER;
    end_case;

  end_if;

END_FUNCTION

