		ExpectedAxisMask 	: UDINT;
		OwnerKind 	: UINT;
		ResourceKind 	: UINT;
		AdmissionMode 	: UINT;
		CallerSessionEpoch 	: UDINT;
		RequestSequence 	: UDINT;
		AdmissionToken 	: UDINT;
		OwnerGeneration 	: UDINT;
		RequiredPhase 	: UINT;
		pIdentity 	: ^void;
		IdentitySize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		axisIndex : DINT;
		axisBit : UDINT;
		referenceAxisMask : UDINT;
		recordBase : DINT;
