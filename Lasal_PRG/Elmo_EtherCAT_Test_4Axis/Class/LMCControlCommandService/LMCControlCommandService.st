	   LMC_OWNER_PREEMPT_IDENTITY_MAGIC then
		repeatRootPresent := TRUE;
	else
		stateIndex := 0;
		while stateIndex <= 323 do
			if OwnershipPreemptedState[stateIndex] <> 0 then
