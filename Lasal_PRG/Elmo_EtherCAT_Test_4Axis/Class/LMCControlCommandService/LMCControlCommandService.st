    if (diagnosticsSdoTupleValid = FALSE) |
       (AdmissionMode <> LMC_OWNER_ADMISSION_LIFECYCLE) |
       (referenceAxisMask = 0) |
       (referenceAxisMask > 0x00000008) |
       (RequestedAxisMask <> referenceAxisMask) then
