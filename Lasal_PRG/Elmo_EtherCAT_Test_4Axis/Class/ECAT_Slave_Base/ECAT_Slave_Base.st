FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::ConnectEvent

  // overwrite this, if initmodule is used, so _NotInitialized can be shown during initialisation
  ClassState      := _ClassOk;
  
  // Reset SDO Handling
  sSDOData.bSDODataValid := FALSE;
  sigclib_atomic_setU32(pValue:=#sSDOData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
  // Clear Pipe 
  if sSDOData.pPipe then
  
    while cPipe_Get(pd:=#sSDOData.Buffer, p:=sSDOData.pPipe) = 1 do
    end_while;

  end_if;
  
  sAsyncComData.bSDODataValid := FALSE;
  sigclib_atomic_setU32(pValue:=#sAsyncComData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
  // Clear Pipe 
  if sAsyncComData.pPipe then
  
    while cPipe_Get(pd:=#sAsyncComData.Buffer, p:=sAsyncComData.pPipe) = 1 do
    end_while;

  end_if;
  
  // Reset FoE Handling
  sFoEData.bFoEDataValid := FALSE;
  sigclib_atomic_setU32(pValue:=#sFoEData.udIsFoEActive, value:=ECAT_SB_SDO_FREE);
  
  // Reset SSC Handling
  sSSCData.bSSCDataValid := FALSE;
  sigclib_atomic_setU32(pValue:=#sSSCData.udIsSSCActive, value:=ECAT_SB_SDO_FREE);
  // Clear Pipe 
  if sSSCData.pPipe then
  
    while cPipe_Get(pd:=#sSSCData.Buffer, p:=sSSCData.pPipe) = 1 do
    end_while;

  end_if;

END_FUNCTION

