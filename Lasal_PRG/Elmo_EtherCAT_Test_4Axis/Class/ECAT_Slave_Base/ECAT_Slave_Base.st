END_FUNCTION

FUNCTION ECAT_Slave_Base::Write32Bit
	VAR_INPUT
		p_cycctx 	: ^t_st_ecatm_cycctx;
		iovar 	: ^t_st_eceni_iovar;
		Data 	: HDINT;
	END_VAR
  VAR
  	pFrame    : pVoid;    
    iovarval  : ^HSINT;
  END_VAR

#ifdef ECAT_DEBUG_PDO_MAPPING
  // check if it is an output
  if (iovar^.dir <> ECAT_ECENI_IOVAR_OUTPUT) then
  
  end_if;
    
  // check if a variable of the own cyclic task is accessed
  if (iovar^.cycidx <> p_cycctx^.cycidx) then
    
  end_if;
#endif    
    
  // get pointer to Data in process image (outgoing frame)
  pFrame := p_cycctx^.sndfrm^$^HSINT + (iovar^.frmidx * sizeof(pVoid) );  
  iovarval  := (pFrame)$^HSINT + iovar^.frmoff;  
   
  if iovar^.bitshift = 0 then
    iovarval^       :=  (Data AND 16#000000FF)$HSINT;
    (iovarval + 1)^ := ((Data AND 16#0000FF00) shr  8)$HSINT;
    (iovarval + 2)^ := ((Data AND 16#00FF0000) shr 16)$HSINT;
    (iovarval + 3)^ := ((Data AND 16#FF000000) shr 24)$HSINT;
  else
    
    iovarval^ := iovarval^ AND                      ((1 shl iovar^.bitshift) -1);   // Clear Bits
    iovarval^ := iovarval^ OR   ((Data AND 16#000000FF) shl iovar^.bitshift)$HSINT; // Set Bits
    
    iovarval += 1;
    iovarval^ := (((Data shl iovar^.bitshift) AND 16#0000FF00) shr  8)$HSINT;
    iovarval += 1;
    iovarval^ := (((Data shl iovar^.bitshift) AND 16#00FF0000) shr 16)$HSINT;
    iovarval += 1;
    iovarval^ := (((Data shl iovar^.bitshift) AND 16#FF000000) shr 24)$HSINT;
    
    iovarval += 1;
    iovarval^ := iovarval^ AND (NOT((1 shl iovar^.bitshift) -1));         // Clear Bits
    iovarval^ := iovarval^ OR    (Data shr (32 - iovar^.bitshift))$HSINT; // Set Bits
  
  end_if;
  
END_FUNCTION

FUNCTION ECAT_Slave_Base::Write16Bit
	VAR_INPUT
		p_cycctx 	: ^t_st_ecatm_cycctx;
		iovar 	: ^t_st_eceni_iovar;
		Data 	: HINT;
	END_VAR
  VAR
  	pFrame    : pVoid;    
    iovarval  : ^HSINT;
  END_VAR

#ifdef ECAT_DEBUG_PDO_MAPPING
  // check if it is an output
  if (iovar^.dir <> ECAT_ECENI_IOVAR_OUTPUT) then
  
  end_if;
    
  // check if a variable of the own cyclic task is accessed
  if (iovar^.cycidx <> p_cycctx^.cycidx) then
    
  end_if;
#endif    
    
  // get pointer to Data in process image (outgoing frame)
  pFrame := p_cycctx^.sndfrm^$^HSINT + (iovar^.frmidx * sizeof(pVoid) );  
  iovarval  := (pFrame)$^HSINT + iovar^.frmoff;  
  
  if iovar^.bitshift = 0 then
    iovarval^       :=  (Data AND 16#00FF)$HSINT;
    (iovarval+ 1)^  := ((Data AND 16#FF00) shr 8)$HSINT;
  else
    
    iovarval^ := iovarval^ AND                  ((1 shl iovar^.bitshift) -1);   // Clear Bits
    iovarval^ := iovarval^ OR   ((Data AND 16#00FF) shl iovar^.bitshift)$HSINT; // Set Bits
    
    iovarval += 1;
    iovarval^ := (((Data shl iovar^.bitshift) AND 16#FF00) shr 8)$HSINT; 
    
    iovarval += 1;
    iovarval^ := iovarval^ AND (NOT((1 shl iovar^.bitshift) -1));         // Clear Bits
    iovarval^ := iovarval^ OR    (Data shr (16 - iovar^.bitshift))$HSINT; // Set Bits
  
  end_if;
   
  
END_FUNCTION

FUNCTION ECAT_Slave_Base::Write8Bit
	VAR_INPUT
		p_cycctx 	: ^t_st_ecatm_cycctx;
