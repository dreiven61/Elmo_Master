FUNCTION ECAT_Slave_Base::CyclicSDOHandling
  VAR
    UserPara  : CmdStruct;
    UserResult: Results;
    sd_retval : DINT;
    retcode : iprStates;
    hindex : HDINT;
  END_VAR
  
  case sSDOData.eSSW of
  
//*******************************************************************************************************************************************************
    0:  //Start SDO Request
    
        if (sSDOData.pPipe) & 
           (sSDOData.bSDODataValid = FALSE) then
          
          if cPipe_Get(pd:=#sSDOData.Buffer, p:=sSDOData.pPipe) = 1 then
            
            sSDOData.bSDODataValid := TRUE;
            
          end_if;
        
        end_if;
    
        if sSDOData.bSDODataValid then
        
          if sSDOData.Buffer.bReadOrWriteSDO = FALSE then  // Read
            //Start SDO Upload via OS  
            sd_retval := OS_ECATM_SDO_UPL_START(pECAT
                                              , ecatmhdl
                                              , SlaveIndex
                                              , sSDOData.Buffer.hIndex
                                              , sSDOData.Buffer.hsSubIndex
                                              , sSDOData.Buffer.dCompleteAccess
                                              , sSDOData.Buffer.pData$^USINT
                                              , sSDOData.Buffer.udLength
                                              , sSDOData.Buffer.udTimeout
                                              , #sSDOData.pSDOHandle
                                              );
          else  // Write
            //Start SDO Download via OS
            sd_retval := OS_ECATM_SDO_DLD_START(pECAT
                                              , ecatmhdl
                                              , SlaveIndex
                                              , sSDOData.Buffer.hIndex
                                              , sSDOData.Buffer.hsSubIndex
                                              , sSDOData.Buffer.dCompleteAccess
                                              , sSDOData.Buffer.pData$^USINT
                                              , sSDOData.Buffer.udLength
                                              , sSDOData.Buffer.udTimeout
                                              , #sSDOData.pSDOHandle);
          
          end_if;

          if sd_retval = ECATM_OK then
            retcode := READY;
            
            sSDOData.eSSW := 1; //Go on, wait for answer in next step
            
          elsif sd_retval <> ECATM_EVTC_BUSY$DINT then
            retcode := ERROR;
            
            LogValue("@0598 (ECAT_Slave_Base::CyclicSDOHandling) SDO Error 0x{0} at Slave 0x{1} while starting SDO",sd_retval$UDINT,SlaveIndex);
            
            // Reset before udIsSDOActive
            sSDOData.bSDODataValid    := FALSE;
            sigclib_atomic_setU32(pValue:=#sSDOData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
            
            if sSDOData.Buffer.pSDOCallback then
              UserPara.uiCmd           := ECAT_M_SDO_CALLBACK;
              UserPara.aPara[0]$DINT   := 1;           //Version
              UserPara.aPara[1]$DINT   := sd_retval;   //Return code
              UserPara.aPara[2]$BOOL   := sSDOData.Buffer.bReadOrWriteSDO;  //Read or Write (0 ... Read , 1 ... Write)
              UserPara.aPara[3]$HINT   := sSDOData.Buffer.hIndex;           //Index
              UserPara.aPara[4]$HSINT  := sSDOData.Buffer.hsSubIndex;       //Subindex
              UserPara.aPara[5]$UDINT  := sSDOData.Buffer.udLength;         //Datalength
              UserPara.aPara[6]$UDINT  := 0x08000000;                //Errorcode from the SDO (general error)
  
              sSDOData.Buffer.pSDOCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
            end_if;
          end_if;
        end_if;

//*******************************************************************************************************************************************************
    1:  //Receive SDO Response
  
      if sSDOData.Buffer.bReadOrWriteSDO = FALSE then  // Read
        sd_retval := OS_ECATM_SDO_UPL_POLL(pECAT, ecatmhdl, sSDOData.pSDOHandle, #sSDOData.Buffer.udLength, #sSDOData.udErrorCode);
      else  // Write
        sd_retval := OS_ECATM_SDO_DLD_POLL(pECAT, ecatmhdl, sSDOData.pSDOHandle, #sSDOData.udErrorCode);
      end_if;
  
      if sd_retval = ECATM_OK then
        retcode := READY;
      elsif sd_retval = ECATM_EVTC_BUSY$DINT then
        retcode := BUSY;
        return;
      else
        hindex := to_udint(sSDOData.Buffer.hIndex);
        HWC_LogPrintf(this, "@0599 (ECAT_Slave_Base::CyclicSDOHandling) SDO Error %d at Slave %u while receiving response for index: 0x%X, subindex %v1"
                    , #sd_retval, #SlaveIndex, #hindex, #sSDOData.Buffer.hsSubIndex);
        retcode := ERROR;
      end_if;
      
      // Reset before udIsSDOActive
      sSDOData.bSDODataValid    := FALSE;
      sSDOData.pSDOHandle       := NIL;   // The SDO transfer handle is invalid after a result unequal to ECATM_EVTC_BUSY was returned. (icECAT-ECATM_Reference_Manual.pdf)
      sigclib_atomic_setU32(pValue:=#sSDOData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
      
      sSDOData.eSSW := 0; //Reset SSW
  
      if sSDOData.Buffer.pSDOCallback then
        UserPara.uiCmd          := ECAT_M_SDO_CALLBACK;
        UserPara.aPara[0]$DINT  := 1;                               //Version
        UserPara.aPara[1]$DINT  := sd_retval;                       //Return code
        UserPara.aPara[2]$BOOL  := sSDOData.Buffer.bReadOrWriteSDO; //Read or Write (0 ... Read , 1 ... Write)
        UserPara.aPara[3]$HINT  := sSDOData.Buffer.hIndex;          //Index
        UserPara.aPara[4]$HSINT := sSDOData.Buffer.hsSubIndex;      //Subindex
        UserPara.aPara[5]$UDINT := sSDOData.Buffer.udLength;        //Datalength
        UserPara.aPara[6]$UDINT := sSDOData.udErrorCode;            //Errorcode from the SDO
       
        sSDOData.Buffer.pSDOCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
      end_if;
      
//*******************************************************************************************************************************************************      
  end_case;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::ClassState::NewInst
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^Results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR
  VAR
    TmpRetCode : iprStates;
    pNewElement   : t_pHWCGetHardwareDiagnosisOutDynExt;
    pTemp : ^void;
  END_VAR
  
  //Return with error if command is unknown or not supported
  ret_code := ERROR;

  case pPara^.uiCmd of
  
//**********************************************************************************************************************************************************
    ECAT_M_SET_SLAVE_INFO:
        
      pResult^.uiLng := 4;
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[0]$DINT := ECAT_RETERR_CMD_PARAMETER;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        pSlaveInfo := pPara^.aPara[1]$^t_st_eceni_slv_info;
        
        //Check for valid pointer
        if pSlaveInfo then
          
          ret_code := READY;
          
          //Show slave info data on server
          DeviceAdress  := pSlaveInfo^.physaddr;
          VendorID      := pSlaveInfo^.vendorid;
          SerialNo      := pSlaveInfo^.serialno;
          ProductCode   := pSlaveInfo^.productcode;
          RevisionNo    := pSlaveInfo^.revisionno;
          
          pResult^.aData[0]$DINT := ECATM_OK;
          
          if pSlaveInfo^.name then
            DeviceNameStr.WriteDataOff(udLen:=_StrLen(pSlaveInfo^.name), udOff:=0, pData:=pSlaveInfo^.name);
          else
            LogValue("@059A (ECAT_Slave_Base::ClassState::NewInst) Invalid name in Slave-info data of Slave 0x{0}",SlaveIndex);
          end_if;

          if pSlaveInfo^.productrev then
            ProductRevStr.WriteDataOff(udLen:=_StrLen(pSlaveInfo^.productrev), udOff:=0, pData:=pSlaveInfo^.productrev);
          else
            LogValue("@059B (ECAT_Slave_Base::ClassState::NewInst) Invalid product revision in Slave-info data of Slave 0x{0}",SlaveIndex);
          end_if;
        else
          
        end_if;
      else
        LogError("@059C (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_SET_SLAVE_INFO");
        ret_code := ERROR;
      end_if;
  
//**********************************************************************************************************************************************************
    ECAT_M_GET_SLAVE_CYCIDX:
      
      pResult^.uiLng := 4;
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        pResult^.aData[0]$DINT := ECAT_RETERR_CMD_WRONG_SLV_STATE;
        if us_InitCnt >= 12 & ClassState = _ClassOk then
          
          pResult^.uiLng := 12;
          pResult^.aData[8]$DINT := to_dint(usCycIDX);
          pResult^.aData[0]$DINT := ECAT_RETOK;
          
          ret_code := READY;
          
//        else
//          // CYCIDX not set 
        end_if;
        
      else
        LogError("@059D (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_GET_SLAVE_CYCIDX");
        ret_code := ERROR;
      end_if;

//**********************************************************************************************************************************************************
    ECAT_M_EVENT_CALLBACK:
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[0]$DINT := ECAT_RETOK;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        EvtCallBack(pPara^.aPara[1]$pVoid, pPara^.aPara[2]$^t_st_ecatm_evt, pPara^.aPara[3],pPara^.aPara[4]$UINT);
        
        ret_code := READY;
      else
        LogError("@059E (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_EVENT_CALLBACK");
        ret_code := ERROR;
      end_if;
      
//**********************************************************************************************************************************************************
    ECAT_M_CHECK_SLAVE:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        pResult^.aData[0]$DINT := ECAT_RETERR;
        if CheckProductCode(udProductCodeToCheck:= pPara^.aPara[1]$UDINT
                          , udVendorIDToCheck   := pPara^.aPara[3]$UDINT) = TRUE then

          pResult^.aData[0]$DINT := ECAT_RETOK;
          ret_code := READY;
        
        end_if;
        
      else
        LogError("@059F (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_CHECK_SLAVE");
        ret_code := ERROR;
      end_if;
      
//**********************************************************************************************************************************************************
    ECAT_M_CALL_INIT_MODULE:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        ret_code := InitModule(pPara^.aPara[1]$t_e_ECAT_STATE);
        
      else
        LogError("@05A1 (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_CHECK_SLAVE");
        ret_code := ERROR;
      end_if;
    
//**********************************************************************************************************************************************************
    ECAT_M_SDO_CALLBACK:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
      
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number

        ret_code := READY;
        pResult^.aData[0]$DINT := ECAT_RETOK;

        ReceiveSDOResponse(sd_retval        := pPara^.aPara[1]
                         , bReadOrWriteSDO  := pPara^.aPara[2]$BOOL
                         , hIndex           := pPara^.aPara[3]$HINT
                         , hsSubIndex       := pPara^.aPara[4]$HSINT
                         , usLength         := pPara^.aPara[5]$USINT
                         , udErrorCode      := pPara^.aPara[6]$UDINT
                         );
      else
        LogError("@05A2 (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_SDO_CALLBACK");
        ret_code := ERROR;
      end_if;

//**********************************************************************************************************************************************************
    ECAT_M_GET_HW_PATH:
    
      ret_code  := ERROR;
      pTemp     := NIL;
      
      //Check version
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;
      if (pPara^.aPara[0]$DINT = 2) then
      
        pTemp := GetPointer2ObjectPath(NIL);
        
        if pTemp then
          pResult^.aData[0]$DINT := ECAT_RETOK;
          ret_code := READY;
        else
          pResult^.aData[0]$DINT  := ECAT_RETERR;
        end_if;
        
        pResult^.uiLng := 14;
        pResult^.aData[4]$DINT    := 2; //Version
        pResult^.aData[8]$^void   := pTemp;
        pResult^.aData[12]$HSINT  := 0; // 0 This is Slave, Value is set by EtherCAT_Hub_Base
        pResult^.aData[13]$HINT   := 0; // 0 This is Slave, Value is set by EtherCAT_Hub_Base
      
      else
        // Version 1 is handled directly by Master Class
        // Passes on the NewInst command
        ret_code := toMaster.NewInst(pPara,pResult);
      end_if;

//**********************************************************************************************************************************************************
    ECAT_M_SET_CLASSSTATE:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        ret_code := READY;
        pResult^.aData[0]$DINT := ECAT_RETOK;
      
        ClassState := pPara^.aPara[1]$t_e_VaranErrors;
        Online     := pPara^.aPara[2]$DINT;
      else
        LogError("@084C (ECAT_Slave_Base::ClassState::NewInst) Unsupported NewInst version ECAT_M_SET_CLASSSTATE");
        ret_code := ERROR;
      end_if;

//**********************************************************************************************************************************************************
    ECAT_M_START_SDO:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        if pPara^.aPara[1] = 0 then
          ret_code := StartReadSDO( hIndex          := pPara^.aPara[2]$HINT
                                  , hsSubIndex      := pPara^.aPara[3]$HSINT
                                  , dCompleteAccess := pPara^.aPara[4]
                                  , pReadData       := pPara^.aPara[5]$^USINT
                                  , udMaxDataLength := pPara^.aPara[6]$UDINT
                                  , udTimeout       := pPara^.aPara[7]$UDINT
                                  , pCallback       := pPara^.aPara[8]$pVoid);
        else
          ret_code := StartWriteSDO(hIndex          := pPara^.aPara[2]$HINT
                                  , hsSubIndex      := pPara^.aPara[3]$HSINT
                                  , dCompleteAccess := pPara^.aPara[4]
                                  , pWriteData      := pPara^.aPara[5]$^USINT
                                  , udWriteLength   := pPara^.aPara[6]$UDINT
                                  , udTimeout       := pPara^.aPara[7]$UDINT
                                  , pCallback       := pPara^.aPara[8]$pVoid);
        end_if;
        
        if ret_code = READY then
          pResult^.aData[0]$DINT := ECAT_RETOK;
        elsif ret_code = BUSY then
          pResult^.aData[0]$DINT := ECAT_RETBUSY;
        else
          pResult^.aData[0]$DINT := ECAT_RETERR_CMD_PARAMETER;
        end_if;
        
      end_if;

//*********************************************************************************************************************************************************
    ECAT_M_START_ASYCOM:
      
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        if pPara^.aPara[1] = 0 then // Read
          
          ret_code := StartAsyncComRead(Address     := pPara^.aPara[2]$HDINT
                                      , pReadData   := pPara^.aPara[3]$^USINT
                                      , DataLength  := pPara^.aPara[4]$UINT
                                      , udTimeout   := pPara^.aPara[5]$UDINT
                                      , pCallback   := pPara^.aPara[6]$pVoid);
        else  // Write
          
          ret_code := StartAsyncComWrite( Address       := pPara^.aPara[2]$HDINT
                                        , pWriteData    := pPara^.aPara[3]$^USINT
                                        , udWriteLength := pPara^.aPara[4]$UINT
                                        , udTimeout     := pPara^.aPara[5]$UDINT
                                        , pCallback     := pPara^.aPara[6]$pVoid);
        end_if;
        
        if ret_code = READY then
          pResult^.aData[0]$DINT := ECAT_RETOK;
        elsif ret_code = BUSY then
          pResult^.aData[0]$DINT := ECAT_RETBUSY;
        else
          pResult^.aData[0]$DINT := ECAT_RETERR_CMD_PARAMETER;
        end_if;
        
      end_if;

//*********************************************************************************************************************************************************
    ECAT_M_START_FOE:

      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        if pPara^.aPara[1] = 0 then // Read
          ret_code := StartFileRead(FileName      := pPara^.aPara[2]$^Char
                                  , PassWord      := pPara^.aPara[3]$UDINT
                                  , pFileBuffer   := pPara^.aPara[4]$pVoid
                                  , FileBufferSize:= pPara^.aPara[5]$UDINT
                                  , udTimeout     := pPara^.aPara[6]$UDINT
                                  , pCallback     := pPara^.aPara[7]$pVoid
                                  );
        elsif pPara^.aPara[1] = 1 then // Write
          ret_code := StartFileWrite( FileName  := pPara^.aPara[2]$^Char
                                    , PassWord  := pPara^.aPara[3]$UDINT
                                    , pFile     := pPara^.aPara[4]$pVoid
                                    , FileSize  := pPara^.aPara[5]$UDINT
                                    , udTimeout := pPara^.aPara[6]$UDINT
                                    , pCallback := pPara^.aPara[7]$pVoid
                                    );
        elsif pPara^.aPara[1] = -1 then // Abort
          ret_code := AbortFileAccess();
        else
          // Unkown
          ret_code := ERROR;
        end_if;
        
        if ret_code = READY then
          pResult^.aData[0]$DINT := ECAT_RETOK;
        elsif ret_code = BUSY then
          pResult^.aData[0]$DINT := ECAT_RETBUSY;
        else
          pResult^.aData[0]$DINT := ECAT_RETERR_CMD_PARAMETER;
        end_if;
        
      end_if;

//*********************************************************************************************************************************************************
    ECAT_M_START_SSC:
    
      pResult^.uiLng := 4;
      
      pResult^.aData[0]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := 1;  //Return version number
        
        if pPara^.aPara[1] = 0 then // Read
          
          ret_code := StartReadSoESSC(driveno         := pPara^.aPara[2]
                                    , elementflags    := pPara^.aPara[3]$USINT
                                    , idn             := pPara^.aPara[4]
                                    , pReadData       := pPara^.aPara[5]$^USINT
                                    , udMaxDataLength := pPara^.aPara[6]$UDINT
                                    , udTimeout       := pPara^.aPara[7]$UDINT
                                    , pCallback       := pPara^.aPara[8]$pVoid
                                    );
        else  // Write
          ret_code := StartWriteSoESSC( driveno       := pPara^.aPara[2]
                                      , elementflags  := pPara^.aPara[3]$USINT
                                      , idn           := pPara^.aPara[4]
                                      , pWriteData    := pPara^.aPara[5]$^USINT
                                      , udWriteLength := pPara^.aPara[6]$UDINT
                                      , udTimeout     := pPara^.aPara[7]$UDINT
                                      , pCallback     := pPara^.aPara[8]$pVoid
                                      );
        end_if;
        
        if ret_code = READY then
          pResult^.aData[0]$DINT := ECAT_RETOK;
        elsif ret_code = BUSY then
          pResult^.aData[0]$DINT := ECAT_RETBUSY;
        else
          pResult^.aData[0]$DINT := ECAT_RETERR_CMD_PARAMETER;
        end_if;
        
      end_if;
      
//*********************************************************************************************************************************************************
    CMD_GET_HARDWARE_TREE_ENTRY :
      
      //Set Errors
      ret_code := ERROR;
      pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_ERROR;
      pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.pStr_NextHardewareTreeEntry := NIL;

      if pObjectPath then
        //Copy Length of p_objectpath (is on 1st byte) on first byte of our array, length is 2 byte so set the 2nd byte manual
        a_HWTEntryStr[0] := pObjectPath^$USINT;
        a_HWTEntryStr[1] := 0;
        
        //a_HWTEntryStr + 2 because first 2 bytes are lenght, ObjectPath 1st byte is length, copy as long as the object path is
        _memcpy(ptr1:=#a_HWTEntryStr+2, ptr2:=pObjectPath+1, cntr:=a_HWTEntryStr[0]);
        
        //Return Hardware Tree Entry and set return codes
        pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.pStr_NextHardewareTreeEntry := #a_HWTEntryStr[0];
        ret_code := READY;
        pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.retcode := _HWC_RETVAL_OK_HWTSTR_RETURNED;
        
        // Compare Module string with passed string
        if pPara^.aPara[0]$t_HWCGetHardwareTreeEntryIn.pStr_LastHardewareTreeEntry then 
        
          if pPara^.aPara[0]$t_HWCGetHardwareDiagnosisIn.pStr_HardewareTreeEntry$^USINT^ =
             pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.pStr_NextHardewareTreeEntry$^USINT^ then // Compare Length
             
            if _memcmp( ptr1:= pPara^.aPara[0]$t_HWCGetHardwareDiagnosisIn.pStr_HardewareTreeEntry // Compare Data
                      , ptr2:= pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.pStr_NextHardewareTreeEntry
                      , cntr:= pResult^.aData[0]$t_HWCGetHardwareTreeEntryOut.pStr_NextHardewareTreeEntry$^USINT^ + 2) = 0 then   // + 2 for 2 Byte Length
                      
              pResult^.aData$t_HWCGetHardwareTreeEntryOut.retcode :=  _HWC_RETVAL_OK_MODULE_FOUND; 
            end_if;
          end_if;
        end_if;
      end_if;  
      
//**********************************************************************************************************************************************************
    CMD_GET_HARDWARE_DIAGNOSIS:
    
      pResult^.aData$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR;
      ret_code := ERROR;
      
      //Return State and Device ID and set retcode ----------------------------------------------------------
      pResult^.aData$t_HWCGetHardwareDiagnosisOut.ClassState  := ClassState;
      pResult^.aData$t_HWCGetHardwareDiagnosisOut.ud_DeviceID := GetDeviceID();
                  
      if ClassState = _NoHardware then
        pResult^.aData$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_NO_HARDWARE;
        return;
      elsif ClassState = _WrongHardware then
        pResult^.aData$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_WRONG_HARDWARE;
        return;
      elsif ClassState = _NoCalibDataFound then
        pResult^.aData$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_NO_CALIB_DATA_FOUND;
        return;
      elsif ClassState <> _ClassOk then
        pResult^.aData$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_NO_HARDWARE;
        return;
      end_if;
       
      //------------------------------------------------------------------------------------------------------
       
      if this <> p_this then
        //Reset statemachine
        eSDOSSW := _GetDeviceName;
        //Save This pointer
        p_this := this;
        
        // Reset Flags
        bDiagnosisDataAvailableFlags.HWVersion        := FALSE;
        bDiagnosisDataAvailableFlags.IdentityObject   := FALSE;
        bDiagnosisDataAvailableFlags.DeviceName       := FALSE;
        bDiagnosisDataAvailableFlags.SoftwareVersion  := FALSE;
      end_if;

      case eSDOSSW of
      
        //***********************************************************************************************************************************
        t_e_SDOSSW::_GetDeviceName:
      
          ret_code := BUSY;
          
          case eResponseStateHardwareTreeDiagnosis of
            //*****************************************************************************************
            t_e_ResponseStateSDO::_idle:
              
              TmpRetCode := StartReadSDO(hIndex          := ECAT_SB_INDEX_DEVICE_NAME
                                       , hsSubIndex      := ECAT_SB_SUBINDEX_DEVICE_NAME
                                       , dCompleteAccess := 0
                                       , pReadData       := #a_DeviceName[0]
                                       , udMaxDataLength := sizeof(a_DeviceName)
                                       , udTimeout       := ECAT_SB_DEFAULT_SDO_TIMEOUT
                                       , pCallback       := THIS
                                       );
              
              if TmpRetCode = READY then
                eResponseStateHardwareTreeDiagnosis := _wait;
                udSDOTimeout := ops.tAbsolute;
                
              elsif TmpRetCode = ERROR then
                ret_code := ERROR;
                eSDOSSW := _DataReady;
              end_if;
            
            //*****************************************************************************************
            t_e_ResponseStateSDO::_wait:
            
              //Timeout-Check
              if ((ops.tAbsolute - udSDOTimeout) > ECAT_SB_DEFAULT_SDO_TIMEOUT) then
                LogError("@02D1 (ECAT_Slave_Base::ClassState::NewInst) SDO Response timeout read state at HWT Diagnosis");
                ret_code := ERROR;
              end_if;
              
            //*****************************************************************************************
            t_e_ResponseStateSDO::_valid:
              
              eResponseStateHardwareTreeDiagnosis := t_e_ResponseStateSDO::_idle;
            
              //Check for an SDO error
              if sSDOData.sd_retval = 0 then
                eSDOSSW := _GetIdentityObject;
                bDiagnosisDataAvailableFlags.DeviceName := TRUE;
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_DeviceName  := (#a_DeviceName)$^CHAR;
              
              else
                ret_code := ERROR;
                //Error
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_ECAT_SDO_ACCESS_FAILED;
              end_if;
            
          end_case;

        //***********************************************************************************************************************************
        t_e_SDOSSW::_GetIdentityObject:

          ret_code := BUSY;
          
          case eResponseStateHardwareTreeDiagnosis of
            //*****************************************************************************************
            t_e_ResponseStateSDO::_idle:
              
              TmpRetCode := StartReadSDO(hIndex          := ECAT_SB_INDEX_IDENTITY_OBJECT
                                       , hsSubIndex      := ECAT_SB_SUBINDEX_IDENTITY_OBJECT
                                       , dCompleteAccess := 1
                                       , pReadData       := #s_IdentityObject[0]
                                       , udMaxDataLength := sizeof(s_IdentityObject)
                                       , udTimeout       := ECAT_SB_DEFAULT_SDO_TIMEOUT
                                       , pCallback       := THIS
                                       );
              
              if TmpRetCode = READY then
                eResponseStateHardwareTreeDiagnosis := _wait;
                udSDOTimeout := ops.tAbsolute;
              elsif TmpRetCode = ERROR then
                ret_code := ERROR;
                eSDOSSW := _DataReady;
              end_if;
            
            //*****************************************************************************************
            t_e_ResponseStateSDO::_wait:
            
              //Timeout-Check
              if ((ops.tAbsolute - udSDOTimeout) > ECAT_SB_DEFAULT_SDO_TIMEOUT) then          
                LogError("@02D1 (ECAT_Slave_Base::ClassState::NewInst) SDO Response timeout read state at HWT Diagnosis");
                ret_code := ERROR;
              end_if;
              
            //*****************************************************************************************
            t_e_ResponseStateSDO::_valid:
                    
              eResponseStateHardwareTreeDiagnosis := t_e_ResponseStateSDO::_idle;
            
              //Check for an SDO error
              if sSDOData.sd_retval = 0 then
                eSDOSSW := _GetSoftwareVersion;
                bDiagnosisDataAvailableFlags.IdentityObject := TRUE;
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.ud_VendorID := s_IdentityObject$t_s_IdentityObject.udVendorID;
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.ud_DeviceID := s_IdentityObject$t_s_IdentityObject.udProductCode;
              else
                ret_code := ERROR;
                //Error
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_ECAT_SDO_ACCESS_FAILED;
              end_if;
            
          end_case;      
        //***********************************************************************************************************************************
        t_e_SDOSSW::_GetSoftwareVersion:
        
          ret_code := BUSY;
          
          case eResponseStateHardwareTreeDiagnosis of
            //*****************************************************************************************
            t_e_ResponseStateSDO::_idle:
              
              TmpRetCode := StartReadSDO(hIndex          := ECAT_SB_INDEX_SOFTWARE_VERSION
                                       , hsSubIndex      := ECAT_SB_SUBINDEX_SOFTWARE_VERSION
                                       , dCompleteAccess := 0
                                       , pReadData       := #a_FWVersion[0]
                                       , udMaxDataLength := sizeof(a_FWVersion)
                                       , udTimeout       := ECAT_SB_DEFAULT_SDO_TIMEOUT
                                       , pCallback       := THIS
                                       );
              
              if TmpRetCode = READY then
                eResponseStateHardwareTreeDiagnosis := _wait;
                udSDOTimeout := ops.tAbsolute;
              elsif TmpRetCode = ERROR then
                ret_code := ERROR;
                eSDOSSW := _DataReady;
              end_if;
            
            //*****************************************************************************************
            t_e_ResponseStateSDO::_wait:
            
              //Timeout-Check
              if ((ops.tAbsolute - udSDOTimeout) > ECAT_SB_DEFAULT_SDO_TIMEOUT) then          
                LogError("@02D1 (ECAT_Slave_Base::ClassState::NewInst) SDO Response timeout read state at HWT Diagnosis");
                ret_code := ERROR;
              end_if;
              
            //*****************************************************************************************
            t_e_ResponseStateSDO::_valid:
            
              eResponseStateHardwareTreeDiagnosis := t_e_ResponseStateSDO::_idle;
            
              //Check for an SDO error
              if sSDOData.sd_retval = 0 then
                eSDOSSW := _GetHardwareVersion;
                bDiagnosisDataAvailableFlags.SoftwareVersion := TRUE;
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_FWVersion  := (#a_FWVersion)$^CHAR;
              
              else
                ret_code := ERROR;
                //Error
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_ECAT_SDO_ACCESS_FAILED;
              end_if;
          end_case;

        //***********************************************************************************************************************************
        t_e_SDOSSW::_GetHardwareVersion:
        
          ret_code := BUSY;
          
          case eResponseStateHardwareTreeDiagnosis of
            //*****************************************************************************************
            t_e_ResponseStateSDO::_idle:
              
              TmpRetCode := StartReadSDO(hIndex          := ECAT_SB_INDEX_HARDWARE_VERSION
                                       , hsSubIndex      := ECAT_SB_SUBINDEX_HARDWARE_VERSION
                                       , dCompleteAccess := 0
                                       , pReadData       := #a_HwVersion[0]
                                       , udMaxDataLength := sizeof(a_HwVersion)
                                       , udTimeout       := ECAT_SB_DEFAULT_SDO_TIMEOUT
                                       , pCallback       := THIS
                                       );
              
              if TmpRetCode = READY then
                eResponseStateHardwareTreeDiagnosis := _wait;
                udSDOTimeout := ops.tAbsolute;
              elsif TmpRetCode = ERROR then
                ret_code := ERROR;
                eSDOSSW := _DataReady;
              end_if;
            
            //*****************************************************************************************
            t_e_ResponseStateSDO::_wait:
            
              //Timeout-Check
              if ((ops.tAbsolute - udSDOTimeout) > ECAT_SB_DEFAULT_SDO_TIMEOUT) then
                LogError("@02D1 (ECAT_Slave_Base::ClassState::NewInst) SDO Response timeout read state at HWT Diagnosis");
                ret_code := ERROR;
              end_if;
              
            //*****************************************************************************************
            t_e_ResponseStateSDO::_valid:
            
              eResponseStateHardwareTreeDiagnosis := t_e_ResponseStateSDO::_idle;
            
              //Check for an SDO error
              if sSDOData.sd_retval = 0 then
                eSDOSSW := _DataReady;
                bDiagnosisDataAvailableFlags.HWVersion := TRUE;
              else
                ret_code := ERROR;
                //Error
                pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_ERROR_ECAT_SDO_ACCESS_FAILED;
              end_if;
          end_case;
                  
        //***********************************************************************************************************************************
        t_e_SDOSSW::_DataReady:

          //Not available for EtherCAT modules
          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_VendorName := NIL;  
          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_OrderingNo := NIL;
          
          // first free the old then create the memory (linked list) for the additional information
          if pAdditionalDiagInfo then
            HwDiagFreeDynExtList(pList:=pAdditionalDiagInfo);
          end_if;
          pAdditionalDiagInfo      := NIL;

          //Data which is already available in HWK
          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.ud_Place := SlaveIndex;

          if bDiagnosisDataAvailableFlags.DeviceName then
            pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_DeviceName  := (#a_DeviceName)$^CHAR;
          end_if;

          if bDiagnosisDataAvailableFlags.SoftwareVersion then
            pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.pStr_FWVersion  := (#a_FWVersion)$^CHAR;
          end_if;
          
          if bDiagnosisDataAvailableFlags.IdentityObject then
            pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.ud_VendorID := s_IdentityObject$t_s_IdentityObject.udVendorID;
            pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.ud_DeviceID := s_IdentityObject$t_s_IdentityObject.udProductCode;
            
            // add the serialnumber
            pNewElement := HwDiagAddDynExt2List(ppList:=#pAdditionalDiagInfo, EntryID:=_HWC_DIAG_ID_UDINT_SERIAL_NUMBER, udVersion:=1, udDataLength:=sizeof(t_s_IdentityObject.udSerialnumber));
            
            if pNewElement then
              (pNewElement$^HDINT + sizeof(t_HWCGetHardwareDiagnosisOutDynExt))^ := s_IdentityObject$t_s_IdentityObject.udSerialnumber;
            end_if;
            
          end_if;

          if bDiagnosisDataAvailableFlags.HWVersion then
          // add the hardware version
            pNewElement := HwDiagAddDynExt2List(ppList:=#pAdditionalDiagInfo, EntryID:=_HWC_DIAG_ID_STRING_HARDWARE_VERSION, udVersion:=1, udDataLength:=_strlen(src:=#a_HWVersion[0]));
            
            if pNewElement then
              // add the data in the reserved memory
              _strcpy(dest:=(pNewElement$^HDINT + sizeof(t_HWCGetHardwareDiagnosisOutDynExt))$^CHAR, src:=#a_HWVersion[0]);
            end_if;
          end_if;

          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.p_DynExtList := pAdditionalDiagInfo;

          ret_code := READY;
          pResult^.aData[0]$t_HWCGetHardwareDiagnosisOut.retcode := _HWC_RETVAL_OK;
        
      end_case;
        
//**********************************************************************************************************************************************************
    ECAT_SB_GET_SLVIDX:
      pResult^.uiLng := 8;
      
      pResult^.aData[0]$DINT := 1;  //Return version number
      pResult^.aData[4]$DINT := ECAT_RETERR_CMD_VERSION;
        
      //Check version number
      if pPara^.aPara[0]$DINT = 1 then
        
        pResult^.uiLng := 12;
        pResult^.aData[4]$DINT := ECAT_RETOK;
        pResult^.aData[8]$UDINT := SlaveIndex;

        ret_code := READY;
      end_if;
      
//**********************************************************************************************************************************************************        
    else  
      // Passes on the NewInst command
      ret_code := toMaster.NewInst(pPara,pResult);
  end_case;
  
END_FUNCTION

FUNCTION __CDECL ECAT_Slave_Base::EvtCallBack
  VAR_INPUT
    pecatmhdl       : pVoid;
    evt             : ^t_st_ecatm_evt;
    EventType       : DINT;
    uiCallbackInfo  : UINT;
  END_VAR
 
  case evt^.evtcode of

//*******************************************************************************************************************************************************
  	ECATM_EVTC_SLV_STATE_CHANGE:
        
      EvtCallBackStateChange(evt^.arg3$UDINT);
    
//*******************************************************************************************************************************************************
  	ECATM_EVTC_SLV_TRANS_FAILED:

      EvtCallBackStateChange(evt^.arg3$UDINT);

      ClassState := _ClientNotready;
      Online     := 0;
      
      if uiCallbackInfo = LSL_ECATM_ACYCLIC_TASK then
        LogValue("@05A3 (ECAT_Slave_Base::EvtCallBack) ECATM_EVTC_SLV_TRANS_FAILED error code = 0x{0}", evt^.arg4$UDINT);
      else
        bd_LogRtMessagesInCy.PostIt.EvtCallSlvTransFailed := TRUE;
        bd_LogRtMessagesInCy.aLogValue1[0]                := evt^.arg4$UDINT;
      end_if;
        
//*******************************************************************************************************************************************************
  	ECATM_EVTC_SLV_ACKERR_FAILED:


//*******************************************************************************************************************************************************
  	ECATM_EVTC_INITC_RCV_TMO:

      ClassState := _ClientNotready;
      Online     := 0;
      //Logging is done in master

//*******************************************************************************************************************************************************
  	ECATM_EVTC_INITC_VALID_WKC:

      ClassState := _ClientNotready;
      Online     := 0;
      //Logging is done in master

//*******************************************************************************************************************************************************
  	ECATM_EVTC_INITC_VALID_LEN:

      ClassState := _ClientNotready;
      Online     := 0;
      //Logging is done in master

//*******************************************************************************************************************************************************
  	ECATM_EVTC_INITC_VALID_DATA:
    
      ClassState := _ClientNotready;
      Online     := 0;
      //Logging is done in master

//*******************************************************************************************************************************************************    
  	ECATM_EVTC_SUP_SLV_STATE_CHG:      
  
      EvtCallBackStateChange(evt^.arg3$UDINT);
    
//*******************************************************************************************************************************************************    
  	ECATM_EVTC_SUP_SLV_ALSTATUS_CHG:
    
      // arg2 is correct, compare debug log in ECAT_Master_Base::EvtCallBack -> ECATM_EVTC_SUP_SLV_ALSTATUS_CHG
      EvtCallBackStateChange(evt^.arg2$UDINT);

      
//*******************************************************************************************************************************************************
    ECATM_EVTC_SUP_SLV_COMM_CHG:
      
      EvtCallBackStateChange(evt^.arg3$UDINT);
      
  end_case;
  
END_FUNCTION

FUNCTION VIRTUAL ECAT_Slave_Base::EvtCallBackStateChange
	VAR_INPUT
		NewEtherCATState 	: UDINT;
	END_VAR
  VAR
  	retcode : DINT;
  END_VAR
  
  //Get slave status information
  retcode := OS_ECATM_SLV_GET_STATUS(pECAT, ecatmhdl, SlaveIndex, #sSlaveState);

  if retcode = ECATM_OK then
    AL_StatusCode := sSlaveState.alstatuscode;
  end_if;
  
#ifdef ECAT_DEBUG_EVENT_CALLBACKS    
  if retcode = 0 then
    LogValue(pString:="ECAT-DEBUG: (ECAT_Slave_Base::EvtCallBackStateChange) CurrState: 0x{0}, ExpectedState: 0x{1} ", Value:= sSlaveState.curstate, Value2 := sSlaveState.expstate);  
    LogValue(pString:="ECAT-DEBUG: (ECAT_Slave_Base::EvtCallBackStateChange) alstatuscode: 0x{0}, flags: 0x{1} ", Value:= sSlaveState.alstatuscode, Value2 := sSlaveState.flags);  
  end_if;
#endif
      
  EtherCATState$UDINT := (NewEtherCATState AND 16#0F);  //Only show

  SlaveState          := NewEtherCATState;
  
  if (EtherCATState = ECAT_STATE_OP) & (ClassState = _ClassOk) then
    Online := 1;
  else
    Online := 0;
  end_if;
  
END_FUNCTION

