FUNCTION ECAT_Slave_Base::ECAT_Slave_Base
	VAR_OUTPUT
		ret_code 	: ConfStates;
	END_VAR

  EtherCATState := ECAT_STATE_INIT;  
  ClassState    := _NotInitialized;
  
  // reset pointer used for additional diagnosis information
  pAdditionalDiagInfo := NIL;  
  
  // Get interface for hardwaretree functions
  // Must be done in constructor, because interface may be used before 1st init is called
  // 1st Init Other Class => Call GetPointer2ObjectPath => Call SetObjectThisp
  pHardwareTree := GetCILInterface_ECAT.GetCILHardwareTree();
  
  if pHardwareTree = NIL then
    LogError("@0584 (ECAT_Slave_Base::ECAT_Slave_Base) Hardwaretree-Interface not found.");
  end_if;
  
	ret_code := C_OK;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::Init
VAR
  _Para 	                  : CmdStruct;  
  _Result 	                : Results;
  ret_code 	                : IprStates;
  retcode                   : DINT;
  pActScanMappingInfo       : ^t_st_eceni_iovar;
  ppActPreServerDataPointer : pVoid;
  ppActPostServerDataPointer: pVoid;
  bSetCheckCycIDX           : BOOL;
  pListHelp                 : ^t_s_PDOList;
  tmpCntPre                 : UDINT;
  tmpCntPost                : UDINT;
  hlogVal1                  : HDINT;
  hlogVal2                  : HDINT;
END_VAR

#ifdef DEACTIVATED_LSL
  IF SlaveIndex = DEACTIVATED_LSL THEN //dont call the read(), must be set as init value, because the information is needed at compile time
    EtherCATState := ECAT_STATE_NONE;
    return;
  END_IF;
#endif

  us_InitCnt += 1;
  
  if ClassState = _NotInitialized & EtherCATState <> ECAT_STATE_NONE then
  
    case us_InitCnt of
//**********************************************************************************************************************************************************    
      1: 
      
        //get pointer for ECAT function
        pECAT := GetCILInterface_ECAT.GetCILECAT();

        if pECAT = NIL then
          LogError("@0543 (ECAT_Slave_Base::ECAT_Slave_Base) Failed to get ECATM OS-Interface. A newer OS is necessary to use ECAT");
          // Disable Class
          EtherCATState := ECAT_STATE_NONE;
        end_if;
        
        // Init SDO Lock
        sigclib_atomic_setU32(pValue:=#sSDOData.udIsSDOActive     , value:=ECAT_SB_SDO_FREE);
        sigclib_atomic_setU32(pValue:=#sAsyncComData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
        sigclib_atomic_setU32(pValue:=#sFoEData.udIsFoEActive     , value:=ECAT_SB_SDO_FREE);
        sigclib_atomic_setU32(pValue:=#sSSCData.udIsSSCActive     , value:=ECAT_SB_SDO_FREE);
        
//**********************************************************************************************************************************************************            
      // 2: //Login slave slots to slot manager ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

//**********************************************************************************************************************************************************    
      3:
        //Get slave settings
        //SlaveIndex    := SlaveIndex.Read(); dont call the read(), must be set as init value, because the information is needed at compile time
        Required      := Required.Read();
      
        //Login EtherCAT slave to master ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        _Para.uiCmd := ECAT_M_LOGIN_SLAVE;
        
        _Para.aPara[0]$DINT               := 1;                     // Command Version
        _Para.aPara[1]$UDINT              := SlaveIndex;            // Index of Slave
        _Para.aPara[2]$^ECAT_Slave_Base   := This;                  // This Pointer
        _Para.aPara[3]$DINT               := Required;              // Module is required or not
        _Para.aPara[4]$BDINT              := GetInitModuleFlags();  // Flags if and when the InitModule should be called from master
        
        //Login to Ethercat master
        ret_code := toMaster.NewInst(#_Para,#_Result);
        
        //Check if login was successful
        if ret_code = READY & _Result.aData[0] = ECAT_RETOK then
                    
          //Check version    
          if _Result.aData[4]$DINT = 1 then
            
            //Login was successful, save handle of the Ethercat master stack instance
            ecatmhdl := _Result.aData[8]$pVoid;
          
          else
            //Not supported version
            ClassState := _RootError;
            LogValue("@0585 (ECAT_Slave_Base::Init) The used version 0x{0} of the command ECAT_M_LOGIN_SLAVE ist not supported by the master! SlaveIndex:0x{1}",_Para.aPara[0]$UDINT,SlaveIndex);
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
        else
          //Login failed.
          HWC_LogPrintf(pThis:=this, format:="@0586 (ECAT_Slave_Base::Init) Login Ethercat Slave Module %V4 failed with retcode %d!", p0:=#SlaveIndex, p1:= #_Result.aData[0]);
          EtherCATState := ECAT_STATE_NONE;
          return;
        end_if;

//**********************************************************************************************************************************************************            
      // 4 : // Master distributes EtherCAT Slave Info from Eni File
        
//**********************************************************************************************************************************************************    
      11:
      
      //Check if we have PDOs
      if sPreScanData.udPDOCount | sPostScanData.udPDOCount then
      
        //Allocate enough memory for the mapping info and the server data pointers +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        if sPreScanData.udPDOCount then
        
          sPreScanData.pMappingInfo$pVoid := ToStdLib.Malloc( size:= sPreScanData.udPDOCount * sizeof(t_st_eceni_iovar));
          if sPreScanData.pMappingInfo = NIL then
            LogValue("@0587 (ECAT_Slave_Base::Init) Failed to allocate memory for Prescan mapping info for Slave 0x{0}", SlaveIndex);
            ClassState := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
          
          sPreScanData.ppServerDataPointers$pVoid := toStdLib.Malloc(size:=sPreScanData.udPDOCount * sizeof(DINT));
          if sPreScanData.ppServerDataPointers = NIL then
            LogValue("@0588 (ECAT_Slave_Base::Init) Failed to allocate memory for Prescan server data pointers for Slave 0x{0}", SlaveIndex);
            ClassState := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
        end_if;
        
        if sPostScanData.udPDOCount then
        
          sPostScanData.pMappingInfo$pVoid := ToStdLib.Malloc( size:= sPostScanData.udPDOCount * sizeof(t_st_eceni_iovar));
          if sPostScanData.pMappingInfo = NIL then
            LogValue("@0589 (ECAT_Slave_Base::Init) Failed to allocate memory for Postscan mapping info for Slave 0x{0}", SlaveIndex);
            ClassState := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;     
          
          sPostScanData.ppServerDataPointers$pVoid := toStdLib.Malloc(size:=sPostScanData.udPDOCount * sizeof(DINT));
          if sPostScanData.ppServerDataPointers = NIL then
            LogValue("@058A (ECAT_Slave_Base::Init) Failed to allocate memory for Postscan server data pointers for Slave 0x{0}", SlaveIndex);
            ClassState := _MemoryFault;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;          
        end_if;

        //Get Mapping info for all the PDOs ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        pListHelp                 :=  pPDOList;
        ppActPreServerDataPointer :=  sPreScanData.ppServerDataPointers;
        ppActPostServerDataPointer:=  sPostScanData.ppServerDataPointers;
        bSetCheckCycIDX           :=  FALSE;
        tmpCntPre                 :=  0;
        tmpCntPost                :=  0;

        //Go through all PDOs which are added
        while pListHelp do
        
          retcode := GetIOVarByPdo(hIndex:=pListHelp^.hIndex, hsSubIndex:=pListHelp^.hsSubIndex, pIOVar:=(#pActScanMappingInfo)$^t_st_eceni_iovar);
            
          if retcode <> 0 then
            hlogVal1 := to_udint(pListHelp^.hIndex);
            hlogVal2 := to_udint(pListHelp^.hsSubIndex);
            HWC_LogPrintf(pThis:=this, format:="@058B (ECAT_Slave_Base::Init) GetIOVarByPdo failed with retcode %d for Slave %d, Index: %X, SubIndex %X", p0:=#retcode, p1:= #SlaveIndex, p2:= #hlogVal1, p3:= #hlogVal2);
            ClassState    := _ClientNotready;
            EtherCATState := ECAT_STATE_NONE;
            return;
          end_if;
          
          //Check if all PDOs have set the same CycIDX (different ones are not allowed)
          if bSetCheckCycIDX = FALSE then
            bSetCheckCycIDX := TRUE;

            usCycIDX := pActScanMappingInfo^.cycidx;
          else
            if usCycIDX <> pActScanMappingInfo^.cycidx then
              ClassState    := _InvalidConfguration;
              LogValue("@058D (ECAT_Slave_Base::Init) Different CycIDX for one slave are not supported. Slave 0x{0}", SlaveIndex);
              EtherCATState := ECAT_STATE_NONE;
              return;
            end_if;
          end_if;
        
          if pListHelp^.bPreScanOrPostScan then
            //Postscan
            
            //Copy IO Var Data to our mapping info
            _memcpy(ptr1:=sPostScanData.pMappingInfo + (tmpCntPost * sizeof(t_st_eceni_iovar)), ptr2:=pActScanMappingInfo, cntr:=sizeof(t_st_eceni_iovar));
            tmpCntPost += 1;
            
            ppActPostServerDataPointer^$^DINT := pListHelp^.pSvrDataPointer;
            ppActPostServerDataPointer += sizeof(pVoid);
            
          else
            //Prescan
            
            //Copy IO Var Data to our mapping info
            _memcpy(ptr1:=sPreScanData.pMappingInfo + (tmpCntPre * sizeof(t_st_eceni_iovar)), ptr2:=pActScanMappingInfo, cntr:=sizeof(t_st_eceni_iovar));
            tmpCntPre += 1;
            
            ppActPreServerDataPointer^$^DINT := pListHelp^.pSvrDataPointer;
            ppActPreServerDataPointer  += sizeof(pVoid);
            
          end_if;
          
          pListHelp := pListHelp^.pNext; 
          
        end_while;
        
        //Check if derivation wants to use other callback functions (only set default ones if user do not set own functions)
        if bCallBackFunctionSet = FALSE then          
          sPreScanData.pCallbackFunc  := #ECAT_SB_MapPDODataRd_C();
          sPostScanData.pCallbackFunc := #ECAT_SB_MapPDODataWr_C();
        end_if;        
        
        
        //Install Callback at master +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        _Para.uiCmd := ECAT_M_INSTALL_CALLBACK;
        
        _Para.aPara[0]$DINT               := 2;                                   // Command Version
        _Para.aPara[1]                    := to_DINT(usCycIDX);                   // ECAT cyc Task ID, from which to call the passed callbacks
        _Para.aPara[2]$pVirtualBase       := This;                                // This Pointer
        _Para.aPara[3]$pVoid              := sPreScanData.pCallbackFunc;          // Pointer callbackmethod PreScan
        _Para.aPara[4]$UDINT              := sPreScanData.udPDOCount;             // Number of data PreScan
        _Para.aPara[5]$^t_st_eceni_iovar  := sPreScanData.pMappingInfo;           // Pointer to mapping info PreScan, points to Para[3] elements!
        _Para.aPara[6]$pVoid              := sPreScanData.ppServerDataPointers;   // Pointer to destination Data PreScan, points to Para[3] elements!
        _Para.aPara[7]$pVoid              := sPostScanData.pCallbackFunc;         // Pointer callbackmethod PostScan  
        _Para.aPara[8]$UDINT              := sPostScanData.udPDOCount;            // Number of data PostScan
        _Para.aPara[9]$^t_st_eceni_iovar  := sPostScanData.pMappingInfo;          // Pointer to mapping info PostScan, points to Para[7] elements!
        _Para.aPara[10]$pVoid             := sPostScanData.ppServerDataPointers;  // Pointer to source  Data PostScan, points to Para[7] elements!
        _Para.aPara[11]$^t_e_ECAT_STATE   := #EtherCATState.dData;                // Pointer t_e_ECAT_STATE of the ECAT Module. Used to check if callbacks in UpdateRt (>= ECAT_STATE_SAFEOP), UpdateRtPostScan (>= ECAT_STATE_OP) should be done.

        //Login to Ethercat master
        ret_code := toMaster.NewInst(#_Para,#_Result);
        
        //Check if callback installation was successful
        if ret_code = READY & _Result.aData[0]$DINT = ECATM_OK then

          //Check version    
          if _Result.aData[4]$DINT = 2 then
            //Callback installation was successful.

          else
            //Not supported version
            ClassState := _RootError;
            LogValue("@0590 (ECAT_Slave_Base::Init) Version 0x{0} of ECAT_M_INSTALL_CALLBACK not supported by master,Slave 0x{1}",_Para.aPara[0]$UDINT,SlaveIndex);
            EtherCATState := ECAT_STATE_NONE;      
          end_if;
        else
          //Callback installation at master failed.
          ClassState := _CallBackError;
          HWC_LogPrintf(pThis:=this, format:="@0591 (ECAT_Slave_Base::Init) Failed to install callback at Ethercat master. Errorcode %d,Slave %V4", p0:=#_Result.aData[0], p1:= #SlaveIndex);
          EtherCATState := ECAT_STATE_NONE;      
        end_if;
      else
        //No PDO Data --> Log
#ifdef ECAT_DEBUG_PDO_MAPPING
        LogValue("@0592 (ECAT_Slave_Base::Init) No PDO Data configured for Slave 0x{0}", SlaveIndex);
#endif
        //Berste1 muss nicht zu einem Fehler führen
//        ClassState    := _InvalidConfguration;
//        EtherCATState := ECAT_STATE_NONE;
//        return;
      end_if;
      
      InitSDOBuffers();
      
      // Called in last init so that not default calls will not be overwritten by this call.
      GetPointer2ObjectPath(pThisPointerOverride:=nil);
    
    end_case;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::UpdateCy
  
  //SDO communication is only available if Ethercat is in PreOperational state or higher
  if (EtherCATState >= ECAT_STATE_PREOP) then
    //SDO Handling
    CyclicSDOHandling();
    CyclicAsyncComHandling();
    CyclicFoEHandling();
    CyclicSoESSCHandling();
  end_if;

  //Log messages from realtime in cyclic
  LogRtMessages();
  
END_FUNCTION


FUNCTION VIRTUAL GLOBAL __CDECL ECAT_Slave_Base::MapPDODataRd
	VAR_INPUT
    pThis     : pVirtualBase;
		p_cycctx 	: ^t_st_ecatm_cycctx;
		noData 	  : DINT;
		iovar 	  : ^t_st_eceni_iovar;
		pData 	  : ^DINT;
	END_VAR
  VAR
    i : DINT;        
  END_VAR
  
  // __CDECL necessary for compatibility with c callback functions!
  
  // Not needed because  Class members variables are not accessed in this method!
#ifdef ECAT_DEBUG_PDO_MAPPING
  THIS := pThis$^ECAT_Slave_Base;
#endif
  
  noData -= 1;
  
  for i := 0 to noData do
    case iovar^.bitsize of
    
      1:  Read1Bit (p_cycctx := p_cycctx, iovar:= iovar, pData := pData^$^DINT);
      8:  Read8Bit (p_cycctx := p_cycctx, iovar:= iovar, pData := pData^$^DINT);
      16: Read16Bit(p_cycctx := p_cycctx, iovar:= iovar, pData := pData^$^DINT);
      32: Read32Bit(p_cycctx := p_cycctx, iovar:= iovar, pData := pData^$^DINT);

#ifdef ECAT_DEBUG_PDO_MAPPING    
    else
      
#endif    
    end_case; 
    
    iovar += sizeof(t_st_eceni_iovar);
    pData += sizeof(DINT);
  
  end_for;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL __CDECL ECAT_Slave_Base::MapPDODataWr
	VAR_INPUT
    pThis     : pVirtualBase;
		p_cycctx 	: ^t_st_ecatm_cycctx;
		noData 	  : DINT;
		iovar 	  : ^t_st_eceni_iovar;
		pData 	  : ^DINT;
	END_VAR
  VAR
    i : DINT;        
  END_VAR
  
  // __CDECL necessary for compatibility with c callback functions!
  
  // Not needed because  Class members variables are not accessed in this method!
  // THIS := pThis$^ECAT_Slave_Base;
  
  noData -= 1;
  
  for i := 0 to noData do  
    
    case iovar^.bitsize of
    
      1:  Write1Bit (p_cycctx := p_cycctx, iovar:= iovar, Data := pData^$^DINT^);
      8:  Write8Bit (p_cycctx := p_cycctx, iovar:= iovar, Data := pData^$^USINT^);
      16: Write16Bit(p_cycctx := p_cycctx, iovar:= iovar, Data := pData^$^UINT^);
      32: Write32Bit(p_cycctx := p_cycctx, iovar:= iovar, Data := pData^$^UDINT^);

#ifdef ECAT_DEBUG_PDO_MAPPING    
    else
      
#endif    
    end_case;
    
    iovar += sizeof(t_st_eceni_iovar);
    pData += sizeof(DINT);
  
  end_for;

END_FUNCTION

