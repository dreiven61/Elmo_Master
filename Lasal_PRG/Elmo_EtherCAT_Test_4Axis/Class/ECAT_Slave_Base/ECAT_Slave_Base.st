FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::GetPointer2ObjectPath
	VAR_INPUT
		pThisPointerOverride 	: pVirtualBase;
	END_VAR
	VAR_OUTPUT
		p_us_ObjectPath 	: ^USINT;
	END_VAR
  VAR
  	MyPara   : CmdStruct;
    MyResult : results;
    p_us_PreviousPath : ^USINT;
    PrevLength : UINT;
    i : DINT;
    pLastEscSeq : ^HSINT;
    LastEscSeq : HSINT;
    NextEscSeq : HSINT;
    NextPortNo : USINT;
  END_VAR

  if ( pObjectPath = NIL ) then
    
    MyPara.aPara[0]$DINT := 2; //Version of command
    
    MyPara.uiCmd := ECAT_M_GET_HW_PATH;
    if toMaster.NewInst(#MyPara, #MyResult) <> READY then
      if bd_SingleLog.GetHwPathFailed = FALSE then
        bd_SingleLog.GetHwPathFailed := TRUE;
        LogError("@05A4 (ECAT_Slave_Base::GetPointer2ObjectPath) [SL] Failed to get hardware path of preceding module");
      end_if;
    else
    
      // Find last escape Sequence
      p_us_PreviousPath := MyResult.aData[8]$^USINT;
      NextEscSeq  := MyResult.aData[12]$HSINT;
      NextPortNo  := MyResult.aData[13]$USINT;
      PrevLength  := p_us_PreviousPath^$UINT;
      
      LastEscSeq := 0;  // Last EscSeq in the HW Tree of the Previous Module
      pLastEscSeq := p_us_PreviousPath + p_us_PreviousPath^ + 1;
      for i := PrevLength to 0 by -1 do      
        
        if (pLastEscSeq^ AND HWT_ESCAPE_SEQU) then
          LastEscSeq := pLastEscSeq^;
          exit;
        end_if;
        
        pLastEscSeq -= sizeof(HSINT);
        
      end_for;
      
      if (LastEscSeq = 0) | (LastEscSeq <> NextEscSeq) then
        // Insert NextEscSeq 
        //alloc memory
        pObjectPath := ( ToStdLib.Malloc( size := p_us_PreviousPath^ + 1 + 2) )$^USINT; // + 1 Length HWPath, + 2 (EscSeq + PortNo)
        
        // Length of HW-Path is 1 Byte and does not include length itself
        ToStdLib.MemCpy ( dest   := pObjectPath
                        , source := p_us_PreviousPath
                        , size   := p_us_PreviousPath^ + 1  // Include length in memcpy
                        );
      
        // increase length
        pObjectPath^ += 2; // 1 Byte Escape sequence + 1 Byte Port
        (pObjectPath + pObjectPath^ - 1)^ := NextEscSeq;
        (pObjectPath + pObjectPath^ + 0)^ := NextPortNo;
      else
        // No change of EscSeq 
        // alloc memory
        pObjectPath := ( ToStdLib.Malloc( size := p_us_PreviousPath^ + 1 + 1 ) )$^USINT;  // + 1 Length HWPath, + 1 PortNo
        
        // Length of HW-Path is 1 Byte and does not include length itself
        ToStdLib.MemCpy ( dest   := pObjectPath
                        , source := p_us_PreviousPath
                        , size   := p_us_PreviousPath^ + 1  // Include length in memcpy
                        );
        
        // increase length
        pObjectPath^ += 1; //1 Byte Port
        (pObjectPath + pObjectPath^)^ := NextPortNo;
      end_if;
      
      if pThisPointerOverride then
        //register object path in OS
        SetObjectThisp(pObjectPath:=pObjectPath, pthis:=pThisPointerOverride$UDINT);
      else
        //register object path in OS
        SetObjectThisp(pObjectPath:=pObjectPath, pthis:=this$UDINT);
      end_if;
    end_if;
  end_if;
  
  p_us_ObjectPath := pObjectPath;

END_FUNCTION


