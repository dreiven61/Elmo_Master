FUNCTION ECAT_Slave_Base::AddPDOEntry
	VAR_INPUT
		bPrescanOrPostScan 	: BOOL;
		pServerData 	: pVoid;
		hIndex 	: HINT;
		hsSubIndex 	: HSINT;
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  VAR
  	pListHelp : ^t_s_PDOList;
  END_VAR

  //Check if we already have a PDO or not
  if pPDOList = NIL then
  
    //Allocate memory for first entry in PDO List
    pPDOList$pVoid := toStdLib.Malloc(size:=sizeof(t_s_PDOList));
    
    pListHelp := pPDOList;
    
    if pListHelp then
    
      //Save PDO Data
      pListHelp^.pNext              := NIL;
      pListHelp^.pSvrDataPointer    := pServerData$^DINT;
      pListHelp^.hIndex             := hIndex;
      pListHelp^.hsSubIndex         := hsSubIndex;
      pListHelp^.bPreScanOrPostScan := bPrescanOrPostScan;
      
      //Remember how many PDOs we have to install callback later
      if bPrescanOrPostScan then
        sPostScanData.udPDOCount += 1;
      else
        sPreScanData.udPDOCount += 1;
      end_if;
      
      retcode := 0;
      
    else
      // failed to allocate memory
      retcode := -1;
      LogValue("@0597 (ECAT_Slave_Base::AddPDOEntry) Failed to allocate memory for PDO List for Slave 0x{0}!", SlaveIndex);
      return;
    end_if;

  else
  
    pListHelp := pPDOList;
    
    //Go to next free entry in PDO List
    while (pListHelp^.pNext <> NIL) do
      pListHelp := pListHelp^.pNext;
    end_while;
    
    //Allocate memory for entry in PDO List
    pListHelp^.pNext$pVoid := toStdLib.Malloc(size:=sizeof(t_s_PDOList));
    pListHelp := pListHelp^.pNext;
    
    if pListHelp then

      //Save PDO Data
      pListHelp^.pNext              := NIL;
      pListHelp^.pSvrDataPointer    := pServerData$^DINT;
      pListHelp^.hIndex             := hIndex;
      pListHelp^.hsSubIndex         := hsSubIndex;
      pListHelp^.bPreScanOrPostScan := bPrescanOrPostScan;
      
      //Remember how many PDOs we have to install callback later
      if bPrescanOrPostScan then
        sPostScanData.udPDOCount += 1;
      else
        sPreScanData.udPDOCount += 1;
      end_if;
    
      retcode := 0;
      
    else
      // failed to allocate memory
      retcode := -1;
      LogValue("@0597 (ECAT_Slave_Base::AddPDOEntry) Failed to allocate memory for PDO List for Slave 0x{0}!", SlaveIndex);
      return;
    end_if;
  end_if;

END_FUNCTION

