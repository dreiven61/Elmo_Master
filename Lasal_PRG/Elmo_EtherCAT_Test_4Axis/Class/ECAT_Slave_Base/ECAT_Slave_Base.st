	VAR_INPUT
		hIndex 	: HINT;
		hsSubIndex 	: HSINT;
		dCompleteAccess 	: DINT;
		pWriteData 	: ^USINT;
		udWriteLength 	: UDINT;
		udTimeout 	: UDINT;
		pCallback 	: pVoid;
	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  VAR
    PipeSDOData : t_s_SDOBufferEntry;
  END_VAR
  
  //Mailbox communication is available when State is Pre-Op or higher
  if EtherCATState < ECAT_STATE_PREOP then
    retcode := ERROR;
    return;
  end_if;

  //Check input parameters
  if pWriteData = NIL then
    retcode := ERROR;
    return;
  end_if;

  if pCallback = NIL then
    retcode := ERROR;
    return;
  end_if;
    
  retcode := BUSY;
  // Check if pipe buffer used 
  if sSDOData.pPipe then
  
    // Copy data to local memory before passing it to buffer
    PipeSDOData.hIndex          := hIndex;
    PipeSDOData.hsSubIndex      := hsSubIndex;
    PipeSDOData.bReadOrWriteSDO := 1; //write SDO
    PipeSDOData.dCompleteAccess := dCompleteAccess;
    PipeSDOData.pData           := pWriteData;
    PipeSDOData.udLength        := udWriteLength;
    PipeSDOData.udTimeout       := udTimeout;
    PipeSDOData.pSDOCallback    := pCallback;
    
    // Add the SDO Data to buffer
    if (cPipe_Add(sSDOData.pPipe, #PipeSDOData, sizeof(t_s_SDOBufferEntry) ) = 1) then
      retcode := READY;
    end_if;
  
  // Check if currently a SDO is active, if not get lock on variables
  elsif (sigclib_atomic_cmpxchgU32(pValue:= #sSDOData.udIsSDOActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then

    // Copy data to variables
    sSDOData.Buffer.bReadOrWriteSDO  := 1; //write SDO

    sSDOData.Buffer.hIndex          := hIndex;
    sSDOData.Buffer.hsSubIndex      := hsSubIndex;
    sSDOData.Buffer.dCompleteAccess := dCompleteAccess;
    sSDOData.Buffer.pData           := pWriteData;
    sSDOData.Buffer.udLength        := udWriteLength;
    sSDOData.Buffer.udTimeout       := udTimeout;
    sSDOData.Buffer.pSDOCallback    := pCallback;

    sSDOData.eSSW             := 0;
    
    // Set when all other data is set
    sSDOData.bSDODataValid    := TRUE;

    retcode := READY;
  
  end_if;

END_FUNCTION


