FUNCTION ECAT_Slave_Base::CyclicAsyncComHandling
VAR
	UserPara  : CmdStruct;
  UserResult: Results;
  sd_retval : DINT;
  retcode : iprStates;
END_VAR
  
  case sAsyncComData.eSSW of
  
//*******************************************************************************************************************************************************
    0:  //Start SDO Request
    
        if (sAsyncComData.pPipe) & 
           (sAsyncComData.bSDODataValid = FALSE) then
          
          if cPipe_Get(pd:=#sAsyncComData.Buffer, p:=sAsyncComData.pPipe) = 1 then
            
            sAsyncComData.bSDODataValid := TRUE;
            
          end_if;
          
        end_if;

        if sAsyncComData.bSDODataValid then
        
          if sAsyncComData.Buffer.bReadOrWriteCommand = FALSE then  // Read 
            //Start SDO Upload via OS  
            sd_retval := OS_ECATM_ASYNC_START( pECAT
                                             , ecatmhdl                           // ecatm : pVoid; (* Struct: _ecatm_hdl *)
                                             , ECATM_CMD_FPRD                     // configured physical read //cmd : USINT;
                                             , sAsyncComData.Buffer.Address       // addr : UDINT;
                                             , sAsyncComData.Buffer.pData$^USINT  // datasndrcv : ^USINT;
                                             , sAsyncComData.Buffer.uiLength      // size : UINT;
                                             , sAsyncComData.Buffer.udTimeout     // tmo_ms : UDINT;
                                             , #sAsyncComData.pSDOHandle          // asynchdlp : pVoid; (* Struct: _ecatm_asynchdl *)
                                             );
          else  // Write
          
            //Start SDO Upload via OS  
            sd_retval := OS_ECATM_ASYNC_START( pECAT
                                             , ecatmhdl                           // ecatm : pVoid; (* Struct: _ecatm_hdl *)
                                             , ECATM_CMD_FPWR                     // configured physical write //cmd : USINT;
                                             , sAsyncComData.Buffer.Address       // addr : UDINT;
                                             , sAsyncComData.Buffer.pData$^USINT  // datasndrcv : ^USINT;
                                             , sAsyncComData.Buffer.uiLength      // size : UINT;    
                                             , sAsyncComData.Buffer.udTimeout     // tmo_ms : UDINT;
                                             , #sAsyncComData.pSDOHandle          // asynchdlp : pVoid; (* Struct: _ecatm_asynchdl *)
                                             );
          
          end_if;

          if sd_retval = ECATM_OK then
            retcode := READY;
            
            sAsyncComData.eSSW := 1; //Go on, wait for answer in next step
            
          elsif sd_retval <> ECATM_EVTC_BUSY$DINT then
            retcode := ERROR;
            
            LogValue("@06B3 (ECAT_Slave_Base::CyclicAsyncComHandling) Async Com Error 0x{0} at Slave 0x{1} while starting Async Com",sd_retval$UDINT,SlaveIndex);
            
            // Reset before udIsSDOActive
            sAsyncComData.bSDODataValid    := FALSE;
            sigclib_atomic_setU32(pValue:=#sAsyncComData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
            
            if sAsyncComData.Buffer.pSDOCallback then
              UserPara.uiCmd           := ECAT_M_ASYCOM_CALLBACK;
              UserPara.aPara[0]$DINT   := 1;                                        //Version
              UserPara.aPara[1]$DINT   := sd_retval;                                //Return code
              UserPara.aPara[2]$BOOL   := sAsyncComData.Buffer.bReadOrWriteCommand; //Read or Write (0 ... Read , 1 ... Write)
              UserPara.aPara[3]        := to_dint(sAsyncComData.Buffer.Address);    //register adress
              UserPara.aPara[4]        := 0;                                        //0 (not used)
              UserPara.aPara[5]        := to_dint(sAsyncComData.Buffer.uiLength);   //Datalength
              UserPara.aPara[6]$UDINT  := sAsyncComData.uiWorkingCounter;           //Working counter (gets incremented with every successful read or write)
             
              sAsyncComData.Buffer.pSDOCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
            end_if;
          end_if;
        end_if;

//*******************************************************************************************************************************************************
    1:  //Receive SDO Response
    
      
      sd_retval := OS_ECATM_ASYNC_POLL(pECAT
                                     , ecatmhdl                         // ecatm : pVoid; (* Struct: _ecatm_hdl *)
                                     , sAsyncComData.pSDOHandle         // asynchdl : pVoid; (* Struct: _ecatm_asynchdl *)
                                     , #sAsyncComData.uiWorkingCounter  // wkc : ^UINT;
                                     );

  
  
      if sd_retval = ECATM_OK then
        retcode := READY;
      elsif sd_retval = ECATM_EVTC_BUSY$DINT then
        retcode := BUSY;
        return;
      else
        LogValue("@06B4 (ECAT_Slave_Base::CyclicAsyncComHandling) Async Com Error 0x{0} at Slave 0x{1} while receiving response for Address: 0x{2}",sd_retval$UDINT,SlaveIndex, to_udint(sAsyncComData.Buffer.Address) );      
        retcode := ERROR;
      end_if;
      
      // Reset before udIsSDOActive
      sAsyncComData.bSDODataValid   := FALSE;
      sAsyncComData.pSDOHandle      := NIL;
      sigclib_atomic_setU32(pValue:=#sAsyncComData.udIsSDOActive, value:=ECAT_SB_SDO_FREE);
      
      sAsyncComData.eSSW := 0; //Reset SSW      
  
      if sAsyncComData.Buffer.pSDOCallback then
        UserPara.uiCmd          := ECAT_M_ASYCOM_CALLBACK;
        UserPara.aPara[0]$DINT  := 1;                                         // Version
        UserPara.aPara[1]$DINT  := sd_retval;                                 // Return code
        UserPara.aPara[2]$BOOL  := sAsyncComData.Buffer.bReadOrWriteCommand;  // Read or Write (0 ... Read , 1 ... Write)
        UserPara.aPara[3]       := to_dint(sAsyncComData.Buffer.Address);     // register adress
        UserPara.aPara[4]       := 0;                                         // 0 (not used)
        UserPara.aPara[5]       := to_dint(sAsyncComData.Buffer.uiLength);    // Datalength
        UserPara.aPara[6]$UDINT := sAsyncComData.uiWorkingCounter;            // Working counter (gets incremented with every successful read or write)
       
        sAsyncComData.Buffer.pSDOCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
      end_if;
      
//*******************************************************************************************************************************************************      
  end_case;
  
END_FUNCTION




FUNCTION VIRTUAL ECAT_Slave_Base::InitSDOBuffers

  // Init SDO Buffers
  NoSDOBuffer := NoSDOBuffer.Read();
  
  sSDOData.pPipe := NIL;
  if NoSDOBuffer >= 1 then
    
    sSDOData.pPipe := cPipe_CTor(record_size:=sizeof(t_s_SDOBufferEntry), record_no:=NoSDOBuffer$UDINT);
    
    if sSDOData.pPipe = NIL then
      ClassState := _MemoryFault;
      LogError("@0926 (ECAT_Slave_Base::InitSDOBuffers) Failed to allocate memory for SDO-Buffer-pipe");
      EtherCATState := ECAT_STATE_NONE;
      return;
    end_if;

  end_if;
  
  NoAsyncBuffer := NoAsyncBuffer.Read();
  
  if NoAsyncBuffer >= 1 then
    
    sAsyncComData.pPipe := cPipe_CTor(record_size:=sizeof(t_s_AsyncBufferEntry), record_no:=NoAsyncBuffer$UDINT);
    
    if sAsyncComData.pPipe = NIL then
      ClassState := _MemoryFault;
      LogError("@0927 (ECAT_Slave_Base::InitSDOBuffers) Failed to allocate memory for AsyncComData-Buffer-pipe");
      EtherCATState := ECAT_STATE_NONE;
      return;
    end_if;

  end_if;
  
  NoSSCBuffer := NoSSCBuffer.Read();
  
  if NoSSCBuffer >= 1 then
  
    if (pECAT^.version < ECATM_CIL_SOE_SUPPORT) then
      NoSSCBuffer := 0;
      ClassState := _InvalidConfguration;
      LogError("@0928 (ECAT_Slave_Base::InitSDOBuffers) SSC is not suppored by current OS!");
      EtherCATState := ECAT_STATE_NONE;
      return;
    else
    
      sSSCData.pPipe := cPipe_CTor(record_size:=sizeof(t_s_SoESSCBufferEntry), record_no:=NoSSCBuffer$UDINT);
    
      if sSSCData.pPipe = NIL then
        ClassState := _MemoryFault;
        LogError("@0929 (ECAT_Slave_Base::InitSDOBuffers) Failed to allocate memory for SSC-Buffer-pipe");
        EtherCATState := ECAT_STATE_NONE;
        return;
      end_if;
    
    end_if;

  end_if;
      
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::StartFileWrite
	VAR_INPUT
		FileName 	: ^Char;
		PassWord 	: UDINT;
		pFile 	: pVoid;
		FileSize 	: UDINT;
		udTimeout 	: UDINT;
		pCallback 	: pVoid;
	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  
  //Mailbox communication is available when State is Pre-Op or higher
  if EtherCATState < ECAT_STATE_PREOP then
    retcode := ERROR;
    return;
  end_if;

  //Check input parameters
  if (FileName = NIL) |
     (pFile = NIL)    |
     (FileSize = 0) then
    retcode := ERROR;
    return;
  end_if;

  if pCallback = NIL then
    retcode := ERROR;
    return;
  end_if;  
  
  retcode := BUSY;
  // Check if currently a FoE is active, if not get lock on variables
  if (sigclib_atomic_cmpxchgU32(pValue:= #sFoEData.udIsFoEActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then    

    // Copy data to variables
    sFoEData.Buffer.ReadWriteAbortFoE := 1; //write
    sFoEData.Buffer.FileName          := FileName;
    sFoEData.Buffer.PassWord          := PassWord;
    sFoEData.Buffer.pFile             := pFile;
    sFoEData.Buffer.FileSize          := FileSize;
    sFoEData.Buffer.udTimeout         := udTimeout;
    sFoEData.Buffer.pFoECallback      := pCallback;

    sFoEData.eSSW             := t_e_FoESSW::_Idle;
    
    // Set when all other data is set
    sFoEData.bFoEDataValid    := TRUE;

    retcode := READY;
  
  end_if;
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::StartFileRead
	VAR_INPUT
		FileName        : ^Char;
		PassWord        : UDINT;
		pFileBuffer     : pVoid;
    FileBufferSize  : UDINT;
		udTimeout       : UDINT;
		pCallback       : pVoid;
	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR

  //Mailbox communication is available when State is Pre-Op or higher
  if EtherCATState < ECAT_STATE_PREOP then
    retcode := ERROR;
    return;
  end_if;

  //Check input parameters
  if (FileName = NIL)     |
     (pFileBuffer = NIL)  |
     (FileBufferSize = 0) then
    retcode := ERROR;
    return;
  end_if;

  if pCallback = NIL then
    retcode := ERROR;
    return;
  end_if;
  
  //Check if currently a FoE is active
  retcode := BUSY;
  
  // Check if currently a FoE is active, if not get lock on variables
  if (sigclib_atomic_cmpxchgU32(pValue:= #sFoEData.udIsFoEActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then
    
    // Copy data to variables
    sFoEData.Buffer.ReadWriteAbortFoE := 0; //Read
    sFoEData.Buffer.FileName          := FileName;
    sFoEData.Buffer.PassWord          := PassWord;
    sFoEData.Buffer.pFile             := pFileBuffer;
    sFoEData.Buffer.FileSize          := FileBufferSize;
    sFoEData.Buffer.udTimeout         := udTimeout;
    sFoEData.Buffer.pFoECallback      := pCallback;
    
    sFoEData.eSSW             := t_e_FoESSW::_Idle;
    
    // Set when all other data is set
    sFoEData.bFoEDataValid    := TRUE;
    
    retcode := READY;
  
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::AbortFileAccess
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  
  retcode := BUSY;
  
  if (sigclib_atomic_cmpxchgU32(pValue:= #sFoEData.udIsFoEActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then
  
    // No File acces was active, nothing to to.
    retcode := READY;
    sigclib_atomic_setU32(pValue:=#sFoEData.udIsFoEActive, value:=ECAT_SB_SDO_FREE);
    
  else
  
    sFoEData.bAbortAccess := TRUE;
  
  end_if;
  
END_FUNCTION

FUNCTION ECAT_Slave_Base::CyclicFoEHandling
  
  if sFoEData.bAbortAccess then
  
    sFoEData.bAbortAccess := FALSE;
    
    case sFoEData.eSSW of
    
      t_e_FoESSW::_Idle,          //Start FoE Request
      t_e_FoESSW::_StartReadFile,
      t_e_FoESSW::_StartWriteFile:      
        // File access has not been started yet
        // Set Values that are passed by callback
        sFoEData.sd_retval := ECATM_OK;
        sFoEData.Buffer.FileName    := NIL;  // Clear string, may be old
        sFoEData.FileSizeTransferred := 0;
        _memset(dest:=#sFoEData.FoEStatus, usByte:=0, cntr:=sizeof(sFoEData.FoEStatus));  // Reset Status as it is used in callback and my not be filled in error
        
        sFoEData.Buffer.ReadWriteAbortFoE := -1;  // Set to -1 for abort callback
        sFoEData.eSSW := t_e_FoESSW::_Finish; // FoE Was not active, Nothing to do, set Finish for callback info
        
      t_e_FoESSW::_ReadFile,
      t_e_FoESSW::_WriteFile:
      
        // File access has is active => abort
        sFoEData.Buffer.ReadWriteAbortFoE := -1;  // Set to -1 for abort callback
        sFoEData.eSSW := t_e_FoESSW::_AbortFileAccess; // FoE is active, set SSW to abort
        
      t_e_FoESSW::_Finish,
      t_e_FoESSW::_Error:
      
        // File access already done, nothing todo
    
    end_case;
  end_if;
  
  case sFoEData.eSSW of
  
//*******************************************************************************************************************************************************
   t_e_FoESSW::_Idle:  //Start FoE Request
    
        if sFoEData.bFoEDataValid then
        
          if sFoEData.Buffer.ReadWriteAbortFoE = 0 then  // Read
            sFoEData.eSSW := t_e_FoESSW::_StartReadFile;
          elsif sFoEData.Buffer.ReadWriteAbortFoE > 0 then  // Write
            sFoEData.eSSW := t_e_FoESSW::_StartWriteFile;
          else // Abort < 0
            
          end_if;
            
        end_if;
        
//*******************************************************************************************************************************************************
    t_e_FoESSW::_StartReadFile:
    
        //Start FoE Upload via OS
        sFoEData.sd_retval := OS_ECATM_FOE_UPL_START( pECAT
                                                    , ecatmhdl                  // ecatm     : pVoid; (* Struct: _ecatm_hdl *)
                                                    , SlaveIndex                // slvidx    : UDINT;
                                                    , sFoEData.Buffer.FileName  // file      : ^char; (* const *)
                                                    , sFoEData.Buffer.PassWord  // password  : UDINT;
                                                    , sFoEData.Buffer.udTimeout // tmo_ms    : UDINT;
                                                    , #sFoEData.BlockSize       // blocksize : ^UDINT;
                                                    , #sFoEData.pFoEHandle      // trfhdlp   : pVoid; (* Struct: pointer to _ecatm_foe_trfhdl *)
                                                    );
                                          
        if sFoEData.sd_retval = ECATM_OK then
        
          sFoEData.eSSW := _ReadFile; //Go on, wait for answer in next step              
          sFoEData.FileSizeTransferred := 0;
          _memset(dest:=#sFoEData.FoEStatus, usByte:=0, cntr:=sizeof(sFoEData.FoEStatus));  // Reset Status as it is used in callback and my not be filled in error
          
          if sFoEData.BlockSize > sFoEData.RdBlockBufferSize then
          
            if sFoEData.pRdBlockBuffer then
              
              sFoEData.pRdBlockBuffer     := toStdLib.ReAlloc(mptr:=sFoEData.pRdBlockBuffer, newsize:=sFoEData.BlockSize);
              sFoEData.RdBlockBufferSize  := sFoEData.BlockSize;
              
            else
            
              sFoEData.pRdBlockBuffer     := toStdLib.Malloc(size:=sFoEData.BlockSize);
              sFoEData.RdBlockBufferSize  := sFoEData.BlockSize;
            
            end_if;
            
            if sFoEData.pRdBlockBuffer = NIL then
            
              sFoEData.RdBlockBufferSize := 0;
              HWC_LogPrintf(pThis:=this, format:="@092A (ECAT_Slave_Base::CyclicFoEHandling) Failed to allocate memory for File read buffer.");
              sFoEData.eSSW := t_e_FoESSW::_Error;
              
            end_if;
          
          end_if;
          
        elsif sFoEData.sd_retval <> ECATM_EVTC_BUSY$DINT then
        
          sFoEData.eSSW := t_e_FoESSW::_Error;
          HWC_LogPrintf(pThis:=this, format:="@092B (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_UPL_START returned %d.", p0:=#sFoEData.sd_retval);
         
        end_if;
    
//*******************************************************************************************************************************************************
    t_e_FoESSW::_ReadFile:
  
        sFoEData.sd_retval := OS_ECATM_FOE_UPL_POLL(pECAT
                                                  , ecatmhdl                        // ecatm   : pVoid; (* Struct: _ecatm_hdl *)
                                                  , sFoEData.pFoEHandle             // trfhdlp : pVoid; (* Struct: _ecatm_foe_trfhdl *)
                                                  , sFoEData.pRdBlockBuffer$^USINT  // data    : ^USINT;
                                                  , #sFoEData.FoEStatus             // status  : pVoid; (* Struct: pointer to _ecatm_foe_status *)
                                                  );
                                          
        if sFoEData.sd_retval = ECATM_OK then
        
          case sFoEData.FoEStatus.state of
          
            ECATM_FOE_IDLE:           // transfer completed; handle freed
            
              sFoEData.eSSW := t_e_FoESSW::_Finish; //Go on
              
            ECATM_FOE_DATA_READY:     // data chunk filled
              
              // Check if chunck fits in dest. pointer
              if ((sFoEData.FileSizeTransferred + sFoEData.FoEStatus.lastsize$UDINT) <= sFoEData.Buffer.FileSize) then
                
                // Copy chunk
                _memcpy(ptr1:=sFoEData.Buffer.pFile + sFoEData.FileSizeTransferred, ptr2:=sFoEData.pRdBlockBuffer, cntr:=sFoEData.FoEStatus.lastsize$UDINT);
                sFoEData.FileSizeTransferred += sFoEData.FoEStatus.lastsize$UDINT;
                
                // Send Update to user with new sFoEData.FileSizeTransferred 
                SendFOECallback(FOEState:=BUSY);
              
              else
              
                sFoEData.eSSW := t_e_FoESSW::_AbortFileAccessError;  // Abort FoE Current File Access
                sFoEData.sd_retval := ECATM_EVTC_ERR_BUFSIZE;
                
                sFoEData.Buffer.ReadWriteAbortFoE := -1;  // Set to -1 for abort callback
                sFoEData.FileSizeTransferred += sFoEData.FoEStatus.lastsize$UDINT; // Only for callback
                HWC_LogPrintf(pThis:=this, format:="@092D (ECAT_Slave_Base::CyclicFoEHandling) Receive buffer for file %d is to small. At least %v Bytes are required.", p0:=#sFoEData.Buffer.FileSize, p1:=#sFoEData.FileSizeTransferred);
              end_if;
              
            ECATM_FOE_WAIT_BUFFER:    // buffer transferred 
            
              // Nothing to do
              
            ECATM_FOE_BUSY:           // FoE transfer is busy
            
              // Nothing to do
              
            ECATM_FOE_ERROR:          // FoE transfer failed; handle freed
            
              sFoEData.eSSW := t_e_FoESSW::_Error;
              if sFoEData.FoEStatus.error_str[0] then
                sFoEData.FoEStatus.error_str[ECATM_FOE_MAXSTRLEN-1] := 0;   //Ensure 0 Terminaton
                HWC_LogPrintf(pThis:=this, format:="@092E (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_UPL_POLL returned ErrorCode; %V2, Error Msg: %s", p0:=#sFoEData.FoEStatus.error_code, p1:=#sFoEData.FoEStatus.error_str[0]);
              else                
                HWC_LogPrintf(pThis:=this, format:="@092E (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_UPL_POLL returned ErrorCode %V2", p0:=#sFoEData.FoEStatus.error_code);
              end_if;
          
          end_case;
        
        else
          sFoEData.eSSW := t_e_FoESSW::_Error;
          HWC_LogPrintf(pThis:=this, format:="@092E (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_UPL_POLL returned %d", p0:=#sFoEData.sd_retval);
        end_if;

//*******************************************************************************************************************************************************                  
    t_e_FoESSW::_StartWriteFile:
      
        sFoEData.sd_retval := OS_ECATM_FOE_DLD_START( pECAT            
                                                    , ecatmhdl                  // ecatm     : pVoid; (* Struct: _ecatm_hdl *)
                                                    , SlaveIndex                // slvidx    : UDINT;
                                                    , sFoEData.Buffer.FileName  // file      : ^char; (* const *)
                                                    , sFoEData.Buffer.PassWord  // password  : UDINT;
                                                    , sFoEData.Buffer.udTimeout // tmo_ms    : UDINT;
                                                    , #sFoEData.BlockSize       // blocksize : ^UDINT;
                                                    , #sFoEData.pFoEHandle      // trfhdlp   : pVoid; (* Struct: pointer to _ecatm_foe_trfhdl *)
                                                    );
        
        if sFoEData.sd_retval = ECATM_OK then
          
          sFoEData.eSSW := _Wait4StartWriteFile; //Go on, wait for answer in next step
              
          sFoEData.FileSizeTransferred := 0;
          _memset(dest:=#sFoEData.FoEStatus, usByte:=0, cntr:=sizeof(sFoEData.FoEStatus));  // Reset Status as it is used in callback and my not be filled in error
          
          if (sFoEData.Buffer.FileSize >= sFoEData.BlockSize) then
            sFoEData.WrBlockSize := sFoEData.BlockSize;
          else
            sFoEData.WrBlockSize := sFoEData.Buffer.FileSize;
          end_if;
            
        elsif sFoEData.sd_retval <> ECATM_EVTC_BUSY$DINT then
          
          sFoEData.eSSW := t_e_FoESSW::_Error;
          HWC_LogPrintf(pThis:=this, format:="@092F (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_START returned %V4", p0:=#sFoEData.sd_retval);
         
        end_if;
        
//*******************************************************************************************************************************************************                  
    t_e_FoESSW::_Wait4StartWriteFile:
        
        // Extra step os needed, wait till OS_ECATM_FOE_DLD_POLL returns ECATM_FOE_WAIT_BUFFER, then the 1st buffer must be set.
        sFoEData.sd_retval := OS_ECATM_FOE_DLD_POLL(pECAT
                                                  , ecatmhdl                                                      // ecatm   : pVoid; (* Struct: _ecatm_hdl *)
                                                  , sFoEData.pFoEHandle                                           // trfhdlp : pVoid; (* Struct: _ecatm_foe_trfhdl *)
                                                  , (sFoEData.Buffer.pFile + sFoEData.FileSizeTransferred)$^USINT  // data    : ^USINT;
                                                  , sFoEData.WrBlockSize                                          // size    : UDINT;
                                                  , #sFoEData.FoEStatus                                           // status  : pVoid; (* Struct: pointer to _ecatm_foe_status *)
                                                  );
                
        if sFoEData.sd_retval = ECATM_OK then
          
          case sFoEData.FoEStatus.state of
            
            ECATM_FOE_IDLE:           // transfer completed; handle freed
            
              sFoEData.eSSW := t_e_FoESSW::_Error;  // Error because no Files have been transferred  yet
              
            ECATM_FOE_DATA_READY:     // data chunk filled
            
              sFoEData.eSSW := _WriteFile;
            
            ECATM_FOE_WAIT_BUFFER:    // Ready for buffer move to next step
            
              sFoEData.eSSW := _WriteFile;
            
            ECATM_FOE_BUSY:           // FoE transfer is busy
            
              // Nothing to do
              
            ECATM_FOE_ERROR:          // FoE transfer failed; handle freed
              
              sFoEData.eSSW := t_e_FoESSW::_Error;
              if sFoEData.FoEStatus.error_str[0] = 0 then
                HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned ErrorCode %V2", p0:=#sFoEData.FoEStatus.error_code);
              else
                sFoEData.FoEStatus.error_str[ECATM_FOE_MAXSTRLEN-1] := 0;   //Ensure 0 Terminaton
                HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned ErrorCode; %V2, Error Msg: %s", p0:=#sFoEData.FoEStatus.error_code, p1:=#sFoEData.FoEStatus.error_str[0]);
              end_if;
          
          end_case;
          
        else
          sFoEData.eSSW := t_e_FoESSW::_Error;
          HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned %d", p0:=#sFoEData.sd_retval);
        end_if;
        
//*******************************************************************************************************************************************************          
    t_e_FoESSW::_WriteFile:
    
        sFoEData.sd_retval := OS_ECATM_FOE_DLD_POLL(pECAT
                                                  , ecatmhdl                                                      // ecatm   : pVoid; (* Struct: _ecatm_hdl *)
                                                  , sFoEData.pFoEHandle                                           // trfhdlp : pVoid; (* Struct: _ecatm_foe_trfhdl *)
                                                  , (sFoEData.Buffer.pFile + sFoEData.FileSizeTransferred)$^USINT  // data    : ^USINT;
                                                  , sFoEData.WrBlockSize                                          // size    : UDINT;
                                                  , #sFoEData.FoEStatus                                           // status  : pVoid; (* Struct: pointer to _ecatm_foe_status *)
                                                  );
                
        if sFoEData.sd_retval = ECATM_OK then
          
          case sFoEData.FoEStatus.state of
            
            ECATM_FOE_IDLE:           // transfer completed; handle freed
            
              sFoEData.FileSizeTransferred += sFoEData.WrBlockSize;  // Update for user Callback info
              sFoEData.eSSW := t_e_FoESSW::_Finish; //Go on
              
            ECATM_FOE_DATA_READY:     // data chunk filled
            
              // Nothing to do
            
            ECATM_FOE_WAIT_BUFFER:    // buffer transferred move to next
            
              sFoEData.FileSizeTransferred += sFoEData.WrBlockSize;
              if ((sFoEData.Buffer.FileSize - sFoEData.FileSizeTransferred) >= sFoEData.BlockSize) then
                sFoEData.WrBlockSize := sFoEData.BlockSize;
              else
                sFoEData.WrBlockSize := (sFoEData.Buffer.FileSize - sFoEData.FileSizeTransferred);
              end_if;
              
              // Send Update to user with new sFoEData.FileSizeTransferred 
              SendFOECallback(FOEState:=BUSY);
            
            ECATM_FOE_BUSY:           // FoE transfer is busy
            
              // Nothing to do
              
            ECATM_FOE_ERROR:          // FoE transfer failed; handle freed
              
              sFoEData.eSSW := t_e_FoESSW::_Error;
              if sFoEData.FoEStatus.error_str[0] = 0 then
                HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned ErrorCode %V2", p0:=#sFoEData.FoEStatus.error_code);
              else
                sFoEData.FoEStatus.error_str[ECATM_FOE_MAXSTRLEN-1] := 0;   //Ensure 0 Terminaton
                HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned ErrorCode; %V2, Error Msg: %s", p0:=#sFoEData.FoEStatus.error_code, p1:=#sFoEData.FoEStatus.error_str[0]);
              end_if;
          
          end_case;
          
        else
          sFoEData.eSSW := t_e_FoESSW::_Error;
          HWC_LogPrintf(pThis:=this, format:="@0930 (ECAT_Slave_Base::CyclicFoEHandling) Call OS_ECATM_FOE_DLD_POLL returned %d", p0:=#sFoEData.sd_retval);
        end_if;
        
//*******************************************************************************************************************************************************          
    t_e_FoESSW::_AbortFileAccess:
        
        sFoEData.eSSW := t_e_FoESSW::_Error;  // Should be impossible
        if sFoEData.pFoEHandle then
          
          sFoEData.sd_retval := OS_ECATM_FOE_ABORT( pECAT
                                                  , ecatmhdl            // ecatm   : pVoid; (* Struct: _ecatm_hdl *)
                                                  , sFoEData.pFoEHandle // trfhdlp : pVoid; (* Struct: _ecatm_foe_trfhdl *)
                                                  );
          sFoEData.eSSW := t_e_FoESSW::_Finish;
        end_if;
        
//*******************************************************************************************************************************************************          
    t_e_FoESSW::_AbortFileAccessError:
        
        sFoEData.eSSW := t_e_FoESSW::_Error;  // Should be impossible
        if sFoEData.pFoEHandle then
          
          sFoEData.sd_retval := OS_ECATM_FOE_ABORT( pECAT
                                                  , ecatmhdl            // ecatm   : pVoid; (* Struct: _ecatm_hdl *)
                                                  , sFoEData.pFoEHandle // trfhdlp : pVoid; (* Struct: _ecatm_foe_trfhdl *)
                                                  );
          sFoEData.eSSW := t_e_FoESSW::_Error;
        end_if;
    
//*******************************************************************************************************************************************************          
    t_e_FoESSW::_Finish:        
    
        SendFOECallback(FOEState:=READY);
        
        // Reset before udIsSDOActive
        sFoEData.bFoEDataValid        := FALSE;
        sFoEData.pFoEHandle           := NIL;
        sFoEData.Buffer.pFoECallback  := NIL;
        sigclib_atomic_setU32(pValue:=#sFoEData.udIsFoEActive, value:=ECAT_SB_SDO_FREE);
        
        sFoEData.eSSW := t_e_FoESSW::_Idle; //Reset SSW
    
//*******************************************************************************************************************************************************          
    t_e_FoESSW::_Error:
    
        SendFOECallback(FOEState:=ERROR);
        
        // Reset before udIsSDOActive
        sFoEData.bFoEDataValid        := FALSE;
        sFoEData.pFoEHandle           := NIL;
        sFoEData.Buffer.pFoECallback  := NIL;
        sigclib_atomic_setU32(pValue:=#sFoEData.udIsFoEActive, value:=ECAT_SB_SDO_FREE);
        
        sFoEData.eSSW := t_e_FoESSW::_Idle; //Reset SSW

  end_case;

END_FUNCTION

FUNCTION ECAT_Slave_Base::SendFOECallback
	VAR_INPUT
		FOEState 	: iprStates;
	END_VAR
  VAR
    UserPara  : CmdStruct;
    UserResult: Results;
  END_VAR
  
  if sFoEData.Buffer.pFoECallback then
    UserPara.uiCmd              := ECAT_M_FOE_CALLBACK;
    UserPara.aPara[0]           := 1;                                 //Version          
    UserPara.aPara[1]$iprStates := FOEState;                          //
    UserPara.aPara[2]           := sFoEData.Buffer.ReadWriteAbortFoE; // Read or Write or arbort (0 ... Read , 1 ... Write, -1 abort)
    UserPara.aPara[3]$^CHAR     := sFoEData.Buffer.FileName;          // Filename
    UserPara.aPara[4]$UDINT     := sFoEData.FileSizeTransferred;      // FileSizeTransferred
    UserPara.aPara[5]$UDINT     := TO_UDINT(sFoEData.FoEStatus.error_code);     // Errorcode from the Slave
    sFoEData.FoEStatus.error_str[ECATM_FOE_MAXSTRLEN-1] := 0;         // Ensure 0 Terminaton
    UserPara.aPara[6]$^CHAR     := #sFoEData.FoEStatus.error_str[0];  // ErrorString from the Slave (optional)
    UserPara.aPara[7]           := sFoEData.sd_retval;                // Return code from OS Interface
   
    sFoEData.Buffer.pFoECallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_Slave_Base::StartWriteSoESSC
	VAR_INPUT
		driveno 	: DINT;
		elementflags 	: BSINT;
		IDN 	: DINT;
		pWriteData 	: ^USINT;
		udWriteLength 	: UDINT;
		udTimeout 	: UDINT;
		pCallback 	: pVoid;
	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  VAR
    PipeSSCData : t_s_SoESSCBufferEntry;
  END_VAR

  if (pECAT^.version < ECATM_CIL_SOE_SUPPORT) then
    retcode := ERROR;
    return;
  end_if;
  
  //Mailbox communication is available when State is Pre-Op or higher
  if EtherCATState < ECAT_STATE_PREOP then
    retcode := ERROR;
    return;
  end_if;

  //Check input parameters
  if pWriteData = NIL then
    retcode := ERROR;
    return;
  end_if;

  if pCallback = NIL then
    retcode := ERROR;
    return;
  end_if;
  
  retcode := BUSY;
  // Check if pipe buffer used 
  if sSSCData.pPipe then
  
    PipeSSCData.bWriteSSC := TRUE; //write SSC
    
    // Copy data to local memory before passing it to buffer
    PipeSSCData.driveno         := driveno;
    PipeSSCData.elementflags    := elementflags;    
    PipeSSCData.IDN             := IDN;
    PipeSSCData.pData           := pWriteData;
    PipeSSCData.udLength        := udWriteLength;
    PipeSSCData.udTimeout       := udTimeout;
    PipeSSCData.pSSCCallback    := pCallback;
    
    // Add the SSC Data to buffer
    if (cPipe_Add(sSSCData.pPipe, #PipeSSCData, sizeof(t_s_SoESSCBufferEntry) ) = 1) then
      retcode := READY;
    end_if;
  
  // Check if currently a SSC is active, if not get lock on variables
  elsif (sigclib_atomic_cmpxchgU32(pValue:= #sSSCData.udIsSSCActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then    

    // Copy data to variables
    sSSCData.Buffer.bWriteSSC := TRUE; //write SSC

    sSSCData.Buffer.driveno         := driveno;
    sSSCData.Buffer.elementflags    := elementflags;
    sSSCData.Buffer.IDN             := IDN;
    sSSCData.Buffer.pData           := pWriteData;
    sSSCData.Buffer.udLength        := udWriteLength;
    sSSCData.Buffer.udTimeout       := udTimeout;
    sSSCData.Buffer.pSSCCallback    := pCallback;

    sSSCData.eSSW             := t_e_SoESSC::_StartSSCReq;
    
    // Set when all other data is set
    sSSCData.bSSCDataValid    := TRUE;

    retcode := READY;
  
  end_if;

END_FUNCTION


