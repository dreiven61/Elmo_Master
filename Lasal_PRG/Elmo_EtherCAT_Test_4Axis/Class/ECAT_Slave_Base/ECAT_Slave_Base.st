  //Mailbox communication is available when State is Pre-Op or higher
  if EtherCATState < ECAT_STATE_PREOP then
    retcode := ERROR;
    return;
  end_if;

  //Check input parameters
  if pReadData = NIL then
    retcode := ERROR;
    return;
  end_if;

  if pCallback = NIL then
    retcode := ERROR;
    return;
  end_if;
  
  retcode := BUSY;
  // Check if pipe buffer used 
  if sSSCData.pPipe then
  
    // Copy data to local memory before passing it to buffer
    PipeSSCData.bWriteSSC := FALSE; //read SSC
    
    PipeSSCData.driveno         := driveno;
    PipeSSCData.elementflags    := elementflags;    
    PipeSSCData.IDN             := IDN;
    PipeSSCData.pData           := pReadData;
    PipeSSCData.udLength        := udMaxDataLength;
    PipeSSCData.udTimeout       := udTimeout;
    PipeSSCData.pSSCCallback    := pCallback;
    
    // Add the SSC Data to buffer
    if (cPipe_Add(sSSCData.pPipe, #PipeSSCData, sizeof(t_s_SoESSCBufferEntry) ) = 1) then
      retcode := READY;
    end_if;
  
  // Check if currently a SSC is active, if not get lock on variables
  elsif (sigclib_atomic_cmpxchgU32(pValue:= #sSSCData.udIsSSCActive, cmpVal:=ECAT_SB_SDO_FREE, newVal:=ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then
    
    // Copy data to variables
    sSSCData.Buffer.bWriteSSC  := FALSE; //read SSC
    
    sSSCData.Buffer.driveno         := driveno;
    sSSCData.Buffer.elementflags    := elementflags;
    sSSCData.Buffer.IDN             := IDN;
    sSSCData.Buffer.pData           := pReadData;
    sSSCData.Buffer.udLength        := udMaxDataLength;
    sSSCData.Buffer.udTimeout       := udTimeout;
    sSSCData.Buffer.pSSCCallback    := pCallback;
    
    sSSCData.eSSW             := t_e_SoESSC::_StartSSCReq;
    
    // Set when all other data is set
    sSSCData.bSSCDataValid    := TRUE;
    
    retcode := READY;
  
  end_if;

END_FUNCTION

FUNCTION ECAT_Slave_Base::CyclicSoESSCHandling
  VAR
    UserPara  : CmdStruct;
    UserResult: Results;
  END_VAR
  
  if (pECAT^.version < ECATM_CIL_SOE_SUPPORT) then
    return;
  end_if;
  
  case sSSCData.eSSW of
  
//*******************************************************************************************************************************************************
    t_e_SoESSC::_StartSSCReq:  //Start SSC Request
    
        if (sSSCData.pPipe) & 
           (sSSCData.bSSCDataValid = FALSE) then
          
          if cPipe_Get(pd:=#sSSCData.Buffer, p:=sSSCData.pPipe) = 1 then
            
            sSSCData.bSSCDataValid := TRUE;
            
          end_if;
        
        end_if;
    
        if sSSCData.bSSCDataValid then
        
          if sSSCData.Buffer.bWriteSSC = FALSE then  // Read
            //Start SSC Upload via OS
            sSSCData.sd_retval := OS_ECATM_SSC_READ_START(  pECAT
                                                          , ecatmhdl                      // ecatm           : pVoid; (* Struct: _ecatm_hdl *)
                                                          , SlaveIndex                    // slvidx          : UDINT;
                                                          , sSSCData.Buffer.driveno       // driveno         : DINT;
                                                          , sSSCData.Buffer.elementflags  // elementflags    : DINT;
                                                          , sSSCData.Buffer.IDN           // IDN             : DINT;
                                                          , sSSCData.Buffer.pData         // data            : ^USINT;    (* const *)
                                                          , sSSCData.Buffer.udLength$DINT // datamax         : DINT;
                                                          , sSSCData.Buffer.udTimeout     // tmo_ms          : UDINT;
                                                          , #sSSCData.pSSCHandle          // sschdlp         : pVoid; (* Struct: pointer to _ecatm_sschdl *)
                                                          );
  
          else  // Write
            //Start SSC Download via OS
            sSSCData.sd_retval := OS_ECATM_SSC_WRITE_START( pECAT
                                                          , ecatmhdl                      // ecatm           : pVoid; (* Struct: _ecatm_hdl *)
                                                          , SlaveIndex                    // slvidx          : UDINT;
                                                          , sSSCData.Buffer.driveno       // driveno         : DINT;
                                                          , sSSCData.Buffer.elementflags  // elementflags    : DINT;
                                                          , sSSCData.Buffer.IDN           // IDN             : DINT;
                                                          , sSSCData.Buffer.pData         // data            : ^USINT;    (* const *)
                                                          , sSSCData.Buffer.udLength      // datasize        : UDINT;
                                                          , sSSCData.Buffer.udTimeout     // tmo_ms          : UDINT;
                                                          , #sSSCData.pSSCHandle          // sschdlp         : pVoid; (* Struct: pointer to _ecatm_sschdl *)
                                                          );
          
          end_if;

          if sSSCData.sd_retval = ECATM_OK then
            
            sSSCData.eSSW := t_e_SoESSC::_Wait4SSCRsp; //Go on, wait for answer in next step
            
          elsif sSSCData.sd_retval <> ECATM_EVTC_BUSY$DINT then
            
            if sSSCData.Buffer.bWriteSSC = FALSE then
              HWC_LogPrintf(pThis:=this, format:="@0931 (ECAT_Slave_Base::CyclicSoESSCHandling) Call OS_ECATM_SSC_READ_START returned %d, DriveNo: %d, IDN: %d.", p0:=#sSSCData.sd_retval, p1:=#sSSCData.Buffer.driveno, p2:=#sSSCData.Buffer.IDN);
            else
              HWC_LogPrintf(pThis:=this, format:="@0932 (ECAT_Slave_Base::CyclicSoESSCHandling) Call OS_ECATM_SSC_WRITE_START returned %d, DriveNo: %d, IDN: %d.", p0:=#sSSCData.sd_retval, p1:=#sSSCData.Buffer.driveno, p2:=#sSSCData.Buffer.IDN);
            end_if;
            
            // Reset before udIsSDOActive
            sSSCData.bSSCDataValid    := FALSE;
            sigclib_atomic_setU32(pValue:=#sSSCData.udIsSSCActive, value:=ECAT_SB_SDO_FREE);
            
            if sSSCData.Buffer.pSSCCallback then
              UserPara.uiCmd          := ECAT_M_SSC_CALLBACK;
              UserPara.aPara[0]$DINT  := 1;                               // Version
              UserPara.aPara[1]$DINT  := sSSCData.sd_retval;              // Return code
              UserPara.aPara[2]$BOOL  := sSSCData.Buffer.bWriteSSC;       // Read or Write (0 ... Read , 1 ... Write)
              UserPara.aPara[3]$DINT  := sSSCData.Buffer.driveno;         // driveno
              UserPara.aPara[4]$USINT := sSSCData.Buffer.elementflags;    // elementflags
              UserPara.aPara[5]$DINT  := sSSCData.Buffer.IDN;             // IDN
              UserPara.aPara[6]$UDINT := sSSCData.Buffer.udLength;        // Datalength
              UserPara.aPara[7]$UINT  := 0;                               // SoE transfer errocode or 0 on success.
  
              sSSCData.Buffer.pSSCCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
            end_if;
          end_if;
        end_if;

//*******************************************************************************************************************************************************
    t_e_SoESSC::_Wait4SSCRsp:  //Receive SDO Response
  
      if sSSCData.Buffer.bWriteSSC = FALSE then  // Read
        sSSCData.sd_retval := OS_ECATM_SSC_READ_POLL( pECAT 
                                                    , ecatmhdl                  // ecatm       : pVoid; (* Struct: _ecatm_hdl *)
                                                    , sSSCData.pSSCHandle       // sschdlp     : pVoid; (* Struct: _ecatm_sschdl *)
                                                    , #sSSCData.Buffer.udLength // datasize    : ^UDINT;
                                                    , #sSSCData.uiErrorCode     // errorcode   : ^UINT; 
                                                    );
      else  // Write
        sSSCData.sd_retval := OS_ECATM_SSC_WRITE_POLL(pECAT
                                                    , ecatmhdl              // ecatm       : pVoid; (* Struct: _ecatm_hdl *)
                                                    , sSSCData.pSSCHandle   // sschdlp     : pVoid; (* Struct: _ecatm_sschdl *)
                                                    , #sSSCData.uiErrorCode // errorcode   : ^UINT;
                                                     );
        
      end_if;
  
      if sSSCData.sd_retval = ECATM_OK then
        
        if sSSCData.uiErrorCode <> 0 then
          sSSCData.sd_retval := -1; // Set to Not Ok if an Error code was returned
        end_if;

      elsif sSSCData.sd_retval = ECATM_EVTC_BUSY$DINT then
        return;
      else
      
        if sSSCData.Buffer.bWriteSSC = FALSE then
          HWC_LogPrintf(pThis:=this, format:="@0933 (ECAT_Slave_Base::CyclicSoESSCHandling) Call OS_ECATM_SSC_READ_POLL returned %d, DriveNo: %d, IDN: %d, ErrorCode: %V2.", p0:=#sSSCData.sd_retval, p1:=#sSSCData.Buffer.driveno, p2:=#sSSCData.Buffer.IDN, p3:=#sSSCData.uiErrorCode);
        else
          HWC_LogPrintf(pThis:=this, format:="@0934 (ECAT_Slave_Base::CyclicSoESSCHandling) Call OS_ECATM_SSC_WRITE_POLL returned %d, DriveNo: %d, IDN: %d, ErrorCode: %V2.", p0:=#sSSCData.sd_retval, p1:=#sSSCData.Buffer.driveno, p2:=#sSSCData.Buffer.IDN, p3:=#sSSCData.uiErrorCode);
        end_if;

      end_if;
      
      // Reset before udIsSDOActive
      sSSCData.bSSCDataValid    := FALSE;
      sSSCData.pSSCHandle       := NIL;   // The SDO transfer handle is invalid after a result unequal to ECATM_EVTC_BUSY was returned. (icECAT-ECATM_Reference_Manual.pdf)
      sSSCData.eSSW := t_e_SoESSC::_StartSSCReq; //Reset SSW
      
      sigclib_atomic_setU32(pValue:=#sSSCData.udIsSSCActive, value:=ECAT_SB_SDO_FREE);
  
      if sSSCData.Buffer.pSSCCallback then
        UserPara.uiCmd          := ECAT_M_SSC_CALLBACK;
        UserPara.aPara[0]$DINT  := 1;                               // Version
        UserPara.aPara[1]$DINT  := sSSCData.sd_retval;              // Return code
        UserPara.aPara[2]$BOOL  := sSSCData.Buffer.bWriteSSC;       // Read or Write (0 ... Read , 1 ... Write)
        UserPara.aPara[3]$DINT  := sSSCData.Buffer.driveno;         // driveno
        UserPara.aPara[4]$USINT := sSSCData.Buffer.elementflags;    // elementflags
        UserPara.aPara[5]$DINT  := sSSCData.Buffer.IDN;             // IDN
        UserPara.aPara[6]$UDINT := sSSCData.Buffer.udLength;        // Datalength
        UserPara.aPara[7]$UINT  := sSSCData.uiErrorCode;            // SoE transfer errocode or 0 on success.
       
        sSSCData.Buffer.pSSCCallback$^VirtualBase^.NewInst(#UserPara, #UserResult);
      end_if;
      
//*******************************************************************************************************************************************************      
  end_case;

END_FUNCTION

