FUNCTION ECAT_Slave_Base::Read32Bit
	VAR_INPUT
		p_cycctx 	: ^t_st_ecatm_cycctx;
		iovar 	: ^t_st_eceni_iovar;
		pData 	: ^DINT;
	END_VAR
  VAR
  	pFrame    : pVoid;
    lastrcvfrm : ^HSINT;
    iovarval  : ^HSINT;
    iovarval2 : ^UDINT;
    dataTemp : DINT;
  END_VAR

  
#ifdef ECAT_DEBUG_PDO_MAPPING
  // check if a variable of the own cyclic task is accessed
  if (iovar^.cycidx <> p_cycctx^.cycidx) then
    
  end_if;
#endif    
    
  // check if a valid receive frame is present
  pFrame := p_cycctx^.rcvfrm^$^HSINT + (iovar^.frmidx * sizeof(pVoid) );
  lastrcvfrm := pFrame$^USINT;

#ifdef ECAT_DEBUG_PDO_MAPPING
  if lastrcvfrm = NIL then
  
  end_if;
#endif

  // get pointer to Data in process image
  iovarval  := lastrcvfrm + iovar^.frmoff;  
  
  dataTemp := iovarval^$DINT;
  
  if iovar^.bitshift = 0 then
    pData^ := to_dint(dataTemp);
  else    
    iovarval2 := lastrcvfrm + iovar^.frmoff + 4;
    pData^ := to_dint( (dataTemp shr iovar^.bitshift)$UDINT OR
                       (iovarval2^ shl (32 - iovar^.bitshift)) );
  end_if;    
  
END_FUNCTION

