    iovarval^ := iovarval^ AND    ((1 shl iovar^.bitshift) -1);   // Clear Bits
    iovarval^ := iovarval^ OR   (Data shl iovar^.bitshift);       // Set Bits
    
    iovarval += 1;
    iovarval^ := iovarval^ AND  (NOT((1 shl iovar^.bitshift) -1));  // Clear Bits
    iovarval^ := iovarval^ OR     (Data shr (8 - iovar^.bitshift)); // Set Bits
  
  end_if;

  
  
END_FUNCTION

FUNCTION ECAT_Slave_Base::Write1Bit
	VAR_INPUT
		p_cycctx 	: ^t_st_ecatm_cycctx;
		iovar 	: ^t_st_eceni_iovar;
		Data 	: DINT;
	END_VAR
  VAR
  	pFrame    : pVoid;    
    iovarval  : ^HSINT;
  END_VAR

#ifdef ECAT_DEBUG_PDO_MAPPING
  // check if it is an output
  if (iovar^.dir <> ECAT_ECENI_IOVAR_OUTPUT) then
  
  end_if;
    

  // check if a variable of the own cyclic task is accessed
  if (iovar^.cycidx <> p_cycctx^.cycidx) then
    
  end_if;
#endif    
    
  // get pointer to Data in process image (outgoing frame)
  pFrame := p_cycctx^.sndfrm^$^HSINT + (iovar^.frmidx * sizeof(pVoid) );  
  iovarval  := (pFrame)$^HSINT + iovar^.frmoff;  
  
  if Data then
    iovarval^ := iovarval^ OR (     1 shl iovar^.bitshift);
  else
    iovarval^ := iovarval^ AND (NOT(1 shl iovar^.bitshift));
  end_if;  
    
END_FUNCTION // VTMS021::EndianSwap_4Byte


