					(pResponse + 36)^$UINT := snapshot[12]$UINT;
					(pResponse + 38)^$UINT := snapshot[40]$UINT;
					(pResponse + 40)^$UDINT := snapshot[16]$UDINT;
					(pResponse + 44)^$UDINT := snapshot[20]$UDINT;
					(pResponse + 48)^$UDINT := snapshot[24]$UDINT;
					(pResponse + 52)^$UDINT := snapshot[28]$UDINT;
					(pResponse + 56)^$UDINT := snapshot[32]$UDINT;
					(pResponse + 60)^$UDINT := snapshot[36]$UDINT;
