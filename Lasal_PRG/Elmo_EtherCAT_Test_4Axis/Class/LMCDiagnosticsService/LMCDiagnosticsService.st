		(LMC_DIAG_D1_ENABLED = FALSE)) |
		(((CommandId >= 0x7E30) & (CommandId <= 0x7E33)) &
		(LMC_DIAG_D2_ENABLED = FALSE)) |
		(((CommandId >= 0x7E40) & (CommandId <= 0x7E4D)) &
