FUNCTION GLOBAL LMCDiagnosticsService::GetDiagnosticsBootId
	VAR_OUTPUT
		BootId 	: UDINT;
	END_VAR
	VAR
		nextBootId : UDINT;
	END_VAR

	// Retentive servers are restored after class construction. Initialize the
	// runtime generation lazily on the first diagnostics request so the restored
	// counter is incremented exactly once for this service instance.
	if BootIdInitialized = FALSE then
		nextBootId := DiagnosticsBootCounter.Read();
		if nextBootId = 0xFFFFFFFF then
			BootIdFault := TRUE;
			DiagnosticsBootId := 0;
		else
			nextBootId += 1;
			if nextBootId = 0 then
				BootIdFault := TRUE;
				DiagnosticsBootId := 0;
			else
				DiagnosticsBootCounter.Write(input:=nextBootId);
				if DiagnosticsBootCounter.Read() = nextBootId then
					DiagnosticsBootId := nextBootId;
				else
					BootIdFault := TRUE;
					DiagnosticsBootId := 0;
				end_if;
			end_if;
		end_if;
		BootIdInitialized := TRUE;
	end_if;

	if BootIdFault then
		BootId := 0;
	else
		BootId := DiagnosticsBootId;
	end_if;

END_FUNCTION


FUNCTION LMCDiagnosticsService::BuildCatalogEntry
	VAR_INPUT
		pEntry 	: ^USINT;
		CatalogIndex 	: UINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		physicalAxis : UINT;
		signalCode : UINT;
		signalId : UDINT;
		sourceKind : USINT;
		valueType : USINT;
		byteWidth : USINT;
		unitCode : UINT;
		pdoIndex : UINT;
		pdoSubIndex : USINT;
		pdoDirection : USINT;
		minimumRaw : UDINT;
		maximumRaw : UDINT;
		topologyCount : UINT;
		pTopologyEntry : ^USINT;
		aliasText : ARRAY [0..39] OF CHAR;
	END_VAR

	Result := -1;
	if pEntry = NIL then
		RETURN;
	end_if;
	if CatalogIndex = 0x0200 then
		_memset(dest:=pEntry, usByte:=0, cntr:=28);
		pEntry^$UDINT := LMC_DIAG_TOPOLOGY_REVISION;
		(pEntry + 4)^$UINT := 7;
		(pEntry + 6)^$UINT := 96;
		(pEntry + 8)^$UINT := 1;
		(pEntry + 10)^$UINT := 5;
		(pEntry + 12)^$UINT := 2;
		(pEntry + 14)^$UINT := 4;
		(pEntry + 16)^$UDINT := 0x0000000F;
		(pEntry + 20)^$UDINT := 1;
		Result := 0;
		RETURN;
	end_if;
	// Reuse this private serializer for the seven fixed topology records. The
	// 0x0100 discriminator keeps the existing D1 catalog index ABI unchanged.
	if ((CatalogIndex >= 0x0100) & (CatalogIndex <= 0x0106)) |
		(CatalogIndex >= 0x8000) then
		if CatalogIndex >= 0x8000 then
			physicalAxis := (CatalogIndex shr 8) and 0x007F;
			topologyCount := CatalogIndex and 0x00FF;
			if (topologyCount = 0) | (physicalAxis >= 7) |
				((physicalAxis + topologyCount) > 7) then
				RETURN;
			end_if;
			(pEntry + 16)^$UDINT := LMC_DIAG_TOPOLOGY_REVISION;
			(pEntry + 20)^$UINT := physicalAxis;
			(pEntry + 22)^$UINT := topologyCount;
			(pEntry + 24)^$UINT := 7;
			(pEntry + 26)^$UINT := 96;
			if (physicalAxis + topologyCount) = 7 then
				(pEntry + 2)^$UINT := 2;
			end_if;
			pTopologyEntry := pEntry + 28;
		else
			physicalAxis := CatalogIndex - 0x0100;
			topologyCount := 1;
			pTopologyEntry := pEntry;
		end_if;

		for signalCode := 0 to topologyCount - 1 do
			pdoIndex := physicalAxis + signalCode;
			_memset(dest:=pTopologyEntry, usByte:=0, cntr:=96);
			(pTopologyEntry + 8)^$UINT := pdoIndex;
			if pdoIndex = 0 then
				pTopologyEntry^$UDINT := 0xEC000001;
				(pTopologyEntry + 10)^$UINT := 0;
				(pTopologyEntry + 12)^$USINT := 1;
				(pTopologyEntry + 14)^$UINT := 0x0041;
				(pTopologyEntry + 20)^$UINT := 0xFFFF;
				(pTopologyEntry + 24)^$UDINT := 669;
				(pTopologyEntry + 28)^$UDINT := 1196200070;
				(pTopologyEntry + 32)^$UDINT := 65536;
				_strcpy(dest:=pTopologyEntry + 44, src:="GL_9086_11");
			elsif pdoIndex <= 4 then
				pTopologyEntry^$UDINT := 0xEC000100 + TO_UDINT(pdoIndex);
				(pTopologyEntry + 10)^$UINT := pdoIndex;
				(pTopologyEntry + 12)^$USINT := 1;
				(pTopologyEntry + 14)^$UINT := 0x0027;
				(pTopologyEntry + 16)^$UINT := pdoIndex;
				(pTopologyEntry + 18)^$UINT := pdoIndex;
				(pTopologyEntry + 20)^$UINT := 0xFFFF;
				(pTopologyEntry + 24)^$UDINT := 154;
				(pTopologyEntry + 28)^$UDINT := 198948;
				(pTopologyEntry + 32)^$UDINT := 66592;
				_strcpy(dest:=pTopologyEntry + 44, src:="Elmo_11");
				(pTopologyEntry + 49)^$USINT := TO_USINT(48 + pdoIndex);
			else
				pTopologyEntry^$UDINT := 0xEC00FFFC + TO_UDINT(pdoIndex);
				(pTopologyEntry + 4)^$UDINT := 0xEC000001;
				(pTopologyEntry + 10)^$UINT := 0xFFFF;
				(pTopologyEntry + 12)^$USINT := 2;
				(pTopologyEntry + 20)^$UINT := pdoIndex - 5;
				(pTopologyEntry + 24)^$UDINT := 669;
				(pTopologyEntry + 92)^$UDINT := 0x0000FFFC + TO_UDINT(pdoIndex);
				if pdoIndex = 5 then
					(pTopologyEntry + 14)^$UINT := 0x0088;
					(pTopologyEntry + 28)^$UDINT := 1196692218;
					(pTopologyEntry + 40)^$UINT := 4;
					_strcpy(dest:=pTopologyEntry + 44, src:="GL_9086_1_Slot001");
				else
					(pTopologyEntry + 14)^$UINT := 0x0090;
					(pTopologyEntry + 28)^$UDINT := 1196696250;
					(pTopologyEntry + 42)^$UINT := 4;
					_strcpy(dest:=pTopologyEntry + 44, src:="GL_9086_1_Slot011");
				end_if;
			end_if;
			pTopologyEntry += 96;
		end_for;
		Result := 0;
		RETURN;
	end_if;

	if CatalogIndex >= 24 then
		RETURN;
	end_if;

	physicalAxis := (CatalogIndex / 6) + 1;
	signalCode := (CatalogIndex mod 6) + 1;
	signalId := 0x00100000 or (TO_UDINT(physicalAxis) shl 8) or TO_UDINT(signalCode);
	sourceKind := 5;
	valueType := 8;
	byteWidth := 4;
	unitCode := 0;
	pdoIndex := 0;
	pdoSubIndex := 0;
	pdoDirection := 1;
	minimumRaw := 0;
	maximumRaw := 0xFFFFFFFF;

	_memset(dest:=#aliasText[0], usByte:=0, cntr:=sizeof(aliasText));
	_strcpy(dest:=#aliasText[0], src:="axis");
	case physicalAxis of
		1: aliasText[4] := 49;
		2: aliasText[4] := 50;
		3: aliasText[4] := 51;
		4: aliasText[4] := 52;
	end_case;
	aliasText[5] := 46;
	aliasText[6] := 0;

	case signalCode of
		1:
			valueType := 4;
			unitCode := 1;
			pdoIndex := 0x607A;
			minimumRaw := 0x80000000;
			maximumRaw := 0x7FFFFFFF;
			_strcat(dest:=#aliasText[0], src:="target_position_last_tx");
		2:
			pdoIndex := 0x60FE;
			pdoSubIndex := 1;
			_strcat(dest:=#aliasText[0], src:="digital_outputs_last_tx");
		3:
			valueType := 7;
			byteWidth := 2;
			pdoIndex := 0x6040;
			maximumRaw := 65535;
			_strcat(dest:=#aliasText[0], src:="control_word_last_tx");
		4:
			sourceKind := 4;
			valueType := 4;
			unitCode := 1;
			pdoIndex := 0x6064;
			pdoDirection := 2;
			minimumRaw := 0x80000000;
			maximumRaw := 0x7FFFFFFF;
			_strcat(dest:=#aliasText[0], src:="actual_position");
		5:
			sourceKind := 4;
			pdoIndex := 0x60FD;
			pdoDirection := 2;
			_strcat(dest:=#aliasText[0], src:="digital_inputs");
		6:
			sourceKind := 4;
			valueType := 7;
			byteWidth := 2;
			pdoIndex := 0x6041;
			pdoDirection := 2;
			maximumRaw := 65535;
			_strcat(dest:=#aliasText[0], src:="status_word");
	end_case;

	_memset(dest:=pEntry, usByte:=0, cntr:=80);
	pEntry^$UDINT := signalId;
	(pEntry + 4)^$UINT := CatalogIndex;
	(pEntry + 6)^$USINT := sourceKind;
	(pEntry + 7)^$USINT := TO_USINT(physicalAxis);
	(pEntry + 8)^$USINT := valueType;
	(pEntry + 9)^$USINT := byteWidth;
	(pEntry + 10)^$UINT := unitCode;
	(pEntry + 12)^$UINT := 0x000D;
	(pEntry + 14)^$UINT := 0x000B;
	(pEntry + 16)^$UINT := pdoIndex;
	(pEntry + 18)^$USINT := pdoSubIndex;
	(pEntry + 19)^$USINT := pdoDirection;
	(pEntry + 20)^$DINT := 1;
	(pEntry + 24)^$DINT := 1;
	(pEntry + 28)^$UDINT := minimumRaw;
	(pEntry + 32)^$UDINT := maximumRaw;
	_memcpy(ptr1:=pEntry + 36, ptr2:=#aliasText[0], cntr:=40);
	(pEntry + 76)^$UDINT := 0;
	Result := 0;

END_FUNCTION


FUNCTION LMCDiagnosticsService::IsSdoReadReady
	VAR_INPUT
		SlaveReference 	: UINT;
	END_VAR
	VAR_OUTPUT
		Ready 	: BOOL;
	END_VAR

	Ready := FALSE;
	if (LMC_DIAG_D5_SDO_READ_ENABLED = FALSE) &
		(LMC_DIAG_D5_SDO_WRITE_GLOBAL_ENABLED = FALSE) then
		RETURN;
	end_if;

	case SlaveReference of
		1:
			if IsClientConnected(#SdoAxis1) then
				Ready := SdoAxis1.IsReusable();
			end_if;
		2:
			if IsClientConnected(#SdoAxis2) then
				Ready := SdoAxis2.IsReusable();
			end_if;
		3:
			if IsClientConnected(#SdoAxis3) then
				Ready := SdoAxis3.IsReusable();
			end_if;
		4:
			if IsClientConnected(#SdoAxis4) then
				Ready := SdoAxis4.IsReusable();
			end_if;
	end_case;

END_FUNCTION


FUNCTION LMCDiagnosticsService::GetSdoWritePolicyDetail
	VAR_INPUT
		SlaveReference : UINT;
		ObjectIndex : UINT;
		SubIndex : USINT;
		ValueType : USINT;
		DataLength : UINT;
		WriteData : UDINT;
		CheckAxisState : BOOL;
		pSnapshot : ^USINT;
		SnapshotSize : UDINT;
	END_VAR
	VAR_OUTPUT
		DetailCode : UDINT;
	END_VAR
	VAR
		axisHealthOffset : UDINT;
		statusWord : UDINT;
		writeValue : DINT;
	END_VAR

	DetailCode := 0;
	// 0x6060 is owned exclusively by the SetOperationMode lifecycle.
	// Generic D5 must never bypass its owner/outcome/no-replay contract.
	if (ObjectIndex = 0x6040) | (ObjectIndex = 0x6060) |
			(ObjectIndex = 0x607A) | (ObjectIndex = 0x60FF) |
			(ObjectIndex = 0x6071) | (ObjectIndex = 0x3204) |
			(ObjectIndex = 0x20FC) then
		DetailCode := 8;
		RETURN;
	end_if;

		// Generic scalar D5 Write is admitted by request shape and semantic
		// ownership, not by a compile-time address list. Dedicated encoder
		// maintenance remains available only through 0x7E53.
		if LMC_DIAG_D5_SDO_WRITE_GLOBAL_ENABLED = FALSE then
			DetailCode := 7;
			RETURN;
		end_if;
		if (SlaveReference < 1) | (SlaveReference > 4) |
			(ObjectIndex = 0) then
			DetailCode := 7;
			RETURN;
		end_if;

		case ValueType of
			1, 9, 10, 11:
				if DataLength <> 1 then
					DetailCode := 7;
					RETURN;
				end_if;
			2, 3, 7:
				if DataLength <> 2 then
					DetailCode := 7;
					RETURN;
				end_if;
			4, 5, 6, 8:
				if DataLength <> 4 then
					DetailCode := 7;
					RETURN;
				end_if;
		else
			DetailCode := 7;
			RETURN;
		end_case;

		if (ValueType = 1) & (WriteData <> 0) & (WriteData <> 1) then
			DetailCode := 12;
			RETURN;
		end_if;

		// UI[24] is a known preset with a conservative qualification range.
		// The range does not make UI[24] the generic address admission gate.
		if (ObjectIndex = 0x2F00) & (SubIndex = 24) &
			(ValueType = 4) & (DataLength = 4) then
			writeValue := WriteData$DINT;
			if (writeValue < -1073741823) | (writeValue > 1073741823) then
				DetailCode := 12;
				RETURN;
			end_if;
		end_if;
	if CheckAxisState = FALSE then
		RETURN;
	end_if;

	if (pSnapshot = NIL) | (SnapshotSize < 304) then
		DetailCode := 19;
		RETURN;
	end_if;
	axisHealthOffset := 64 + TO_UDINT(SlaveReference - 1) * 36;
	statusWord := (pSnapshot + axisHealthOffset + 20)^$UDINT;
	if (pSnapshot^$UDINT = 0) |
		((pSnapshot + 12)^$UDINT <> 8) |
		((pSnapshot + 16)^$UDINT <> 0) |
		(((pSnapshot + 40)^$UDINT and 3) <> 1) |
		((pSnapshot + axisHealthOffset)^$DINT = 0) |
		((pSnapshot + axisHealthOffset + 4)^$UDINT <> 8) |
		((pSnapshot + axisHealthOffset + 12)^$UDINT <> 0) |
		((pSnapshot + axisHealthOffset + 28)^$UDINT <> pSnapshot^$UDINT) then
		DetailCode := 19;
	elsif ((pSnapshot + axisHealthOffset + 24)^$DINT <> 0) |
		((statusWord and 0x0000006F) <> 0x00000040) then
		DetailCode := 19;
	end_if;

END_FUNCTION


FUNCTION GLOBAL LMCDiagnosticsService::ProcessOperations
	VAR
		snapshot : ARRAY [0..303] OF USINT;
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		copyResult : DINT;
		completionResult : DINT;
		orphanResult : DINT;
		currentCycle : UDINT;
		elapsedCycles : UDINT;
		remainingCycles : UDINT;
		startResult : iprStates;
		executorConnected : BOOL;
		wasRunning : BOOL;
		writePolicyDetail : UDINT;
	END_VAR

	// Dedicated lifecycles own the same per-axis SDO executor as generic D5
	// operations. Pump them before the generic feature-gate return so cleanup
	// cannot be skipped while their public feature gates remain disabled.
	ProcessEncoderMaintenance();
	ProcessAxisDs402Home();
	ProcessAxisDs402HomeEx();
	ProcessAxisSetOperationMode();
	ProcessAxisOwnershipStartup();

	if (LMC_DIAG_D5_SDO_READ_ENABLED = FALSE) &
		(LMC_DIAG_D5_SDO_WRITE_GLOBAL_ENABLED = FALSE) then
		RETURN;
	end_if;

	if (TicketId = 0) & (SdoInternalDrainState = 0) then
		RETURN;
	end_if;

	// A timed-out or disconnected operation keeps the adapter reserved until
	// its late callback has been drained by the executor.
	if SdoInternalDrainState <> 0 then
		// Timeout or disconnect can race a just-published normal completion.
		// Consume and discard that publication so the adapter can become reusable.
		if IsSdoReadReady(SlaveReference:=SdoSlaveReference) = FALSE then
			case SdoSlaveReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						completionResult := SdoAxis1.CopyCompletion(
							ExpectedToken:=OperationToken,
							pDest:=#completion, DestSize:=sizeof(completion));
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						completionResult := SdoAxis2.CopyCompletion(
							ExpectedToken:=OperationToken,
							pDest:=#completion, DestSize:=sizeof(completion));
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						completionResult := SdoAxis3.CopyCompletion(
							ExpectedToken:=OperationToken,
							pDest:=#completion, DestSize:=sizeof(completion));
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						completionResult := SdoAxis4.CopyCompletion(
							ExpectedToken:=OperationToken,
							pDest:=#completion, DestSize:=sizeof(completion));
					end_if;
			end_case;
		end_if;
		if IsSdoReadReady(SlaveReference:=SdoSlaveReference) then
			if SdoInternalDrainState = LMC_DIAG_SDO_DRAIN_ORPHAN then
				TicketId := 0;
				OwnerSessionEpoch := 0;
				TicketBootId := 0;
				TicketMapRevision := 0;
				OperationToken := 0;
				OperationKind := 0;
				OperationState := 0;
				OperationOutcome := 0;
				SdoSlaveReference := 0;
				SdoObjectIndex := 0;
				SdoSubIndex := 0;
				SdoValueType := 0;
				SdoRequestedLength := 0;
				SdoTimeoutCycles := 0;
				SdoSubmitCycle := 0;
				SdoCompletionCycle := 0;
				SdoLastProcessedCycle := 0;
				SdoOperationErrorId := 0;
				SdoOperationDetail := 0;
				SdoResultLength := 0;
				SdoResultData := 0;
				SdoWriteData := 0;
			end_if;
			SdoInternalDrainState := 0;
		end_if;
		RETURN;
	end_if;

	if (OperationState <> LMC_DIAG_SDO_STATE_QUEUED) &
		(OperationState <> LMC_DIAG_SDO_STATE_RUNNING) then
		RETURN;
	end_if;

	if (OperationState = LMC_DIAG_SDO_STATE_QUEUED) &
	   (SdoSlaveReference >= 1) & (SdoSlaveReference <= 4) &
	   ((((AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] <> 0) &
	      (AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS] =
	       TO_DINT(SdoSlaveReference))) |
	     (AxisOperationModeState[TO_DINT(SdoSlaveReference - 1) *
	      LMC_DIAG_MODE_RECORD_STRIDE] = LMC_DIAG_MODE_RECORD_RUNNING) |
	     (AxisOperationModeState[TO_DINT(SdoSlaveReference - 1) *
	      LMC_DIAG_MODE_RECORD_STRIDE] = LMC_DIAG_MODE_RECORD_QUARANTINED))) then
		OperationState := LMC_DIAG_SDO_STATE_FAILED;
		OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
		SdoCompletionCycle := SdoSubmitCycle;
		SdoOperationErrorId := LMC_DIAG_ERROR_ID;
		SdoOperationDetail := 9;
		SdoWriteData := 0;
		RETURN;
	end_if;

	// The RT latch cycle is the only operation clock. CyWork scans are not
	// treated as EtherCAT cycles.
	copyResult := -1;
	if IsClientConnected(#InputLatch) then
		copyResult := InputLatch.CopySnapshot(
			pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
	end_if;
	if copyResult <> 0 then
		wasRunning := OperationState = LMC_DIAG_SDO_STATE_RUNNING;
		if wasRunning then
			orphanResult := -1;
			case SdoSlaveReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						orphanResult := SdoAxis1.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						orphanResult := SdoAxis2.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						orphanResult := SdoAxis3.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						orphanResult := SdoAxis4.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
			end_case;
		end_if;
		SdoCompletionCycle := SdoSubmitCycle;
		OperationState := LMC_DIAG_SDO_STATE_FAILED;
		OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
		SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
		SdoOperationDetail := 11;
		SdoWriteData := 0;
		if wasRunning then
			SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
		end_if;
		RETURN;
	end_if;
	currentCycle := snapshot[0]$UDINT;

	if OperationState = LMC_DIAG_SDO_STATE_RUNNING then
		executorConnected := FALSE;
		completionResult := -2;
		case SdoSlaveReference of
			1:
				executorConnected := IsClientConnected(#SdoAxis1) <> 0;
				if executorConnected then
					completionResult := SdoAxis1.CopyCompletion(
						ExpectedToken:=OperationToken,
						pDest:=#completion, DestSize:=sizeof(completion));
				end_if;
			2:
				executorConnected := IsClientConnected(#SdoAxis2) <> 0;
				if executorConnected then
					completionResult := SdoAxis2.CopyCompletion(
						ExpectedToken:=OperationToken,
						pDest:=#completion, DestSize:=sizeof(completion));
				end_if;
			3:
				executorConnected := IsClientConnected(#SdoAxis3) <> 0;
				if executorConnected then
					completionResult := SdoAxis3.CopyCompletion(
						ExpectedToken:=OperationToken,
						pDest:=#completion, DestSize:=sizeof(completion));
				end_if;
			4:
				executorConnected := IsClientConnected(#SdoAxis4) <> 0;
				if executorConnected then
					completionResult := SdoAxis4.CopyCompletion(
						ExpectedToken:=OperationToken,
						pDest:=#completion, DestSize:=sizeof(completion));
				end_if;
		end_case;
		elapsedCycles := currentCycle - SdoSubmitCycle;

		if executorConnected = FALSE then
			OperationState := LMC_DIAG_SDO_STATE_FAILED;
			OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
			SdoCompletionCycle := currentCycle;
			SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
			SdoOperationDetail := 11;
			SdoWriteData := 0;
			SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
			RETURN;
		end_if;

		// A completion observed on the deadline wins over timeout. A result
		// consumed after the deadline is discarded even though the adapter has
		// already returned to Idle.
		if (completionResult = 0) &
			(elapsedCycles > SdoTimeoutCycles) then
			OperationState := LMC_DIAG_SDO_STATE_EXPIRED;
			OperationOutcome := LMC_DIAG_SDO_OUTCOME_TIMED_OUT;
			SdoCompletionCycle := currentCycle;
			SdoOperationErrorId := 0;
			SdoOperationDetail := LMC_DIAG_SDO_ABORT_TIMEOUT;
			SdoResultLength := 0;
			SdoResultData := 0;
			SdoWriteData := 0;
			RETURN;
		elsif completionResult = 0 then
			SdoCompletionCycle := currentCycle;
			if completion.ValidationCode <> 0 then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				if completion.ValidationCode = 7 then
					SdoOperationDetail := 5;
				else
					SdoOperationDetail := 24;
				end_if;
			elsif (completion.OsResult <> 0) &
				(completion.AbortCode = 0x08000000) then
				// ECAT_Slave_Base synthesizes general abort together with the
				// raw OS error when an SDO cannot be started.
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				SdoOperationDetail := completion.OsResult$UDINT;
			elsif completion.AbortCode <> 0 then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_ERROR_ID;
				SdoOperationDetail := completion.AbortCode;
			elsif completion.OsResult <> 0 then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				SdoOperationDetail := completion.OsResult$UDINT;
			elsif completion.ActualLength <> TO_UDINT(SdoRequestedLength) then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				SdoOperationDetail := 5;
			elsif (completion.ObjectIndex <> SdoObjectIndex) |
				(completion.SubIndex <> SdoSubIndex) |
				((OperationKind = 2) & (completion.IsWrite <> 0)) |
				((OperationKind = 3) & (completion.IsWrite = 0)) then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				SdoOperationDetail := 24;
			else
				OperationState := LMC_DIAG_SDO_STATE_COMPLETED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_SUCCESS;
				SdoOperationErrorId := 0;
				SdoOperationDetail := 0;
				if OperationKind = 2 then
					SdoResultLength := completion.ActualLength;
					SdoResultData := completion.Data;
				else
					SdoResultLength := 0;
					SdoResultData := 0;
				end_if;
			end_if;
			if IsSdoReadReady(SlaveReference:=SdoSlaveReference) = FALSE then
				SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
			end_if;
			SdoWriteData := 0;
			RETURN;
		elsif (completionResult <> -2) & (completionResult <> -3) then
			OperationState := LMC_DIAG_SDO_STATE_FAILED;
			OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
			SdoCompletionCycle := currentCycle;
			SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
			SdoOperationDetail := 24;
			SdoWriteData := 0;
			if IsSdoReadReady(SlaveReference:=SdoSlaveReference) = FALSE then
				SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
			end_if;
			RETURN;
		end_if;

		if elapsedCycles >= SdoTimeoutCycles then
			orphanResult := -1;
			case SdoSlaveReference of
				1:
					orphanResult := SdoAxis1.MarkOrphan(
						ExpectedToken:=OperationToken);
				2:
					orphanResult := SdoAxis2.MarkOrphan(
						ExpectedToken:=OperationToken);
				3:
					orphanResult := SdoAxis3.MarkOrphan(
						ExpectedToken:=OperationToken);
				4:
					orphanResult := SdoAxis4.MarkOrphan(
						ExpectedToken:=OperationToken);
			end_case;
			if (orphanResult = 0) | (orphanResult = -2) then
				OperationState := LMC_DIAG_SDO_STATE_EXPIRED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_TIMED_OUT;
				SdoCompletionCycle := currentCycle;
				SdoOperationErrorId := 0;
				SdoOperationDetail := LMC_DIAG_SDO_ABORT_TIMEOUT;
				SdoResultLength := 0;
				SdoResultData := 0;
				SdoWriteData := 0;
				SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
			elsif orphanResult = -1 then
				OperationState := LMC_DIAG_SDO_STATE_FAILED;
				OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
				SdoCompletionCycle := currentCycle;
				SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
				SdoOperationDetail := 24;
				SdoWriteData := 0;
				SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_EXPIRED;
			end_if;
		end_if;
		RETURN;
	end_if;

	// Queued start attempts are limited to one per new published RT cycle.
	if currentCycle = SdoLastProcessedCycle then
		RETURN;
	end_if;
	SdoLastProcessedCycle := currentCycle;
	elapsedCycles := currentCycle - SdoSubmitCycle;
	if elapsedCycles >= SdoTimeoutCycles then
		OperationState := LMC_DIAG_SDO_STATE_EXPIRED;
		OperationOutcome := LMC_DIAG_SDO_OUTCOME_TIMED_OUT;
		SdoCompletionCycle := currentCycle;
		SdoOperationErrorId := 0;
		SdoOperationDetail := LMC_DIAG_SDO_ABORT_TIMEOUT;
		SdoWriteData := 0;
		RETURN;
	end_if;
	if OperationKind = 3 then
		writePolicyDetail := GetSdoWritePolicyDetail(
			SdoSlaveReference, SdoObjectIndex, SdoSubIndex, SdoValueType,
			SdoRequestedLength, SdoWriteData, TRUE, #snapshot[0],
			sizeof(snapshot));
		if writePolicyDetail <> 0 then
			OperationState := LMC_DIAG_SDO_STATE_FAILED;
			OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
			SdoCompletionCycle := currentCycle;
			SdoOperationErrorId := LMC_DIAG_ERROR_ID;
			SdoOperationDetail := writePolicyDetail;
			SdoResultLength := 0;
			SdoResultData := 0;
			SdoWriteData := 0;
			RETURN;
		end_if;
	end_if;

	remainingCycles := SdoTimeoutCycles - elapsedCycles;
	startResult := ERROR;
	executorConnected := FALSE;
	case SdoSlaveReference of
		1:
			executorConnected := IsClientConnected(#SdoAxis1) <> 0;
			if executorConnected then
				if OperationKind = 3 then
					startResult := SdoAxis1.TryStartWrite(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						pWriteData:=(#SdoWriteData)$^USINT,
						WriteLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				else
					startResult := SdoAxis1.TryStartRead(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						ReadLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				end_if;
			end_if;
		2:
			executorConnected := IsClientConnected(#SdoAxis2) <> 0;
			if executorConnected then
				if OperationKind = 3 then
					startResult := SdoAxis2.TryStartWrite(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						pWriteData:=(#SdoWriteData)$^USINT,
						WriteLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				else
					startResult := SdoAxis2.TryStartRead(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						ReadLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				end_if;
			end_if;
		3:
			executorConnected := IsClientConnected(#SdoAxis3) <> 0;
			if executorConnected then
				if OperationKind = 3 then
					startResult := SdoAxis3.TryStartWrite(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						pWriteData:=(#SdoWriteData)$^USINT,
						WriteLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				else
					startResult := SdoAxis3.TryStartRead(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						ReadLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				end_if;
			end_if;
		4:
			executorConnected := IsClientConnected(#SdoAxis4) <> 0;
			if executorConnected then
				if OperationKind = 3 then
					startResult := SdoAxis4.TryStartWrite(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						pWriteData:=(#SdoWriteData)$^USINT,
						WriteLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				else
					startResult := SdoAxis4.TryStartRead(
						OperationToken:=OperationToken,
						ObjectIndex:=SdoObjectIndex,
						SubIndex:=SdoSubIndex,
						ReadLength:=SdoRequestedLength,
						TimeoutMs:=remainingCycles);
				end_if;
			end_if;
	end_case;

	if executorConnected = FALSE then
		OperationState := LMC_DIAG_SDO_STATE_FAILED;
		OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
		SdoCompletionCycle := currentCycle;
		SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
		SdoOperationDetail := 11;
		SdoWriteData := 0;
	elsif startResult = READY then
		OperationState := LMC_DIAG_SDO_STATE_RUNNING;
		if OperationKind = 3 then
			SdoWriteData := 0;
		end_if;
	elsif startResult = ERROR then
		OperationState := LMC_DIAG_SDO_STATE_FAILED;
		OperationOutcome := LMC_DIAG_SDO_OUTCOME_FAILED;
		SdoCompletionCycle := currentCycle;
		SdoOperationErrorId := LMC_DIAG_SDO_LOCAL_ERROR_ID;
		SdoOperationDetail := 24;
		SdoWriteData := 0;
	end_if;

END_FUNCTION


FUNCTION GLOBAL LMCDiagnosticsService::NotifySessionClosed
	VAR_INPUT
		SessionEpoch 	: UDINT;
	END_VAR
	VAR
		orphanResult : DINT;
	END_VAR

	if SessionEpoch = 0 then
		RETURN;
	end_if;

	if SessionEpoch = BulkOwnerSessionEpoch then
		BulkId := 0;
		BulkConfigRevision := 0;
		BulkOwnerSessionEpoch := 0;
		BulkConfiguredCycle := 0;
		BulkActivationCycle := 0;
		BulkState := 0;
		BulkSignalCount := 0;
		_memset(dest:=#BulkSignalIds[0], usByte:=0,
			cntr:=sizeof(BulkSignalIds));
	end_if;

	if ((LMC_DIAG_D5_SDO_READ_ENABLED = TRUE) |
		(LMC_DIAG_D5_SDO_WRITE_GLOBAL_ENABLED = TRUE)) &
		(SessionEpoch = OwnerSessionEpoch) then
		if OperationState = LMC_DIAG_SDO_STATE_RUNNING then
			orphanResult := -1;
			case SdoSlaveReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						orphanResult := SdoAxis1.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						orphanResult := SdoAxis2.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						orphanResult := SdoAxis3.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						orphanResult := SdoAxis4.MarkOrphan(
							ExpectedToken:=OperationToken);
					end_if;
			end_case;
			TicketId := 0;
			OwnerSessionEpoch := 0;
			TicketBootId := 0;
			TicketMapRevision := 0;
			SdoWriteData := 0;
			SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_ORPHAN;
		elsif (OperationState = LMC_DIAG_SDO_STATE_QUEUED) |
			(SdoInternalDrainState = 0) then
			TicketId := 0;
			OwnerSessionEpoch := 0;
			TicketBootId := 0;
			TicketMapRevision := 0;
			OperationToken := 0;
			OperationKind := 0;
			OperationState := 0;
			OperationOutcome := 0;
			SdoSlaveReference := 0;
			SdoObjectIndex := 0;
			SdoSubIndex := 0;
			SdoValueType := 0;
			SdoRequestedLength := 0;
			SdoTimeoutCycles := 0;
			SdoSubmitCycle := 0;
			SdoCompletionCycle := 0;
			SdoLastProcessedCycle := 0;
			SdoOperationErrorId := 0;
			SdoOperationDetail := 0;
			SdoResultLength := 0;
			SdoResultData := 0;
			SdoWriteData := 0;
			SdoInternalDrainState := 0;
		else
			// A terminal timed-out operation still owns a draining adapter. Hide
			// the public ticket but retain the token until the callback arrives.
			TicketId := 0;
			OwnerSessionEpoch := 0;
			TicketBootId := 0;
			TicketMapRevision := 0;
			SdoWriteData := 0;
			SdoInternalDrainState := LMC_DIAG_SDO_DRAIN_ORPHAN;
		end_if;
	end_if;

	if IsClientConnected(#RecorderStore) then
		RecorderStore.NotifySessionClosed(SessionEpoch:=SessionEpoch);
	end_if;

END_FUNCTION


FUNCTION GLOBAL LMCDiagnosticsService::HandleRequest
	VAR_INPUT
		CommandId 	: UINT;
		Reference 	: UINT;
		pRequest 	: ^USINT;
		RequestSize 	: UDINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CallerSessionEpoch 	: UDINT;
		RequestSequence 	: UDINT;
		AdmissionToken 	: UDINT;
		OwnerGeneration 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags, physicalAxis, signalCode : UINT;
		catalogIndex, startIndex, maxEntries, returnedCount : UINT;
		entryIndex, sdoOperationFlags : UINT;
		sdoDataLength, sdoReserved, requestSdoSlaveReference : UINT;
		requestSdoObjectIndex : UINT;
		requestId, detailCode, expectedMapRevision, signalId : UDINT;
		entryOffset, healthOffset, valueOffset : UDINT;
		expectedRequestSize : UDINT;
		entryDetailCode, currentBootId, requestSdoTimeoutCycles : UDINT;
		requestSdoWriteData, writePolicyDetail, sdoBootId : UDINT;
		sdoTicketId, currentCycle : UDINT;
		expectedType, valueType, entryStatus, requestSdoSubIndex : USINT;
		requestSdoValueType : USINT;
		copyResult : DINT;
		snapshot : ARRAY [0..303] OF USINT;
		executorConnected, executorReusable : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	if (CommandId = 0x7E00) & (ResponseCapacity < 68) then
		RETURN;
	end_if;
	currentBootId := GetDiagnosticsBootId();

	_memset(dest:=pResponse, usByte:=0, cntr:=ResponseCapacity);
	schemaVersion := 0;
	requestFlags := 0;
	requestId := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		schemaVersion := pRequest^$UINT;
		requestFlags := (pRequest + 2)^$UINT;
		requestId := (pRequest + 4)^$UDINT;
	end_if;

	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 2)^$UINT := 0;
	(pResponse + 4)^$UINT := 0;
	(pResponse + 6)^$INT := 0;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := 0;
	detailCode := 0;

	// Home lifecycles use physical axis references 1..4.
	if CommandId = 0x7D1B then
		ResponseSize := HandleAxisDs402HomeExStart(
			Reference:=Reference, pRequest:=pRequest, pResponse:=pResponse,
			ResponseCapacity:=ResponseCapacity,
			CallerSessionEpoch:=CallerSessionEpoch,
			RequestSequence:=RequestSequence,
			AdmissionToken:=AdmissionToken,
			OwnerGeneration:=OwnerGeneration,
			RequestSize:=RequestSize);
		RETURN;
	elsif CommandId = 0x7D1C then
		ResponseSize := HandleAxisDs402HomeExOutcome(
			Reference:=Reference, pRequest:=pRequest, pResponse:=pResponse,
			ResponseCapacity:=ResponseCapacity,
			CallerSessionEpoch:=CallerSessionEpoch, RequestSize:=RequestSize);
		RETURN;
	elsif CommandId = 0x7D1D then
		ResponseSize := HandleAxisDs402HomeExRetire(
			Reference:=Reference, pRequest:=pRequest, pResponse:=pResponse,
			ResponseCapacity:=ResponseCapacity,
			CallerSessionEpoch:=CallerSessionEpoch, RequestSize:=RequestSize);
		RETURN;
	elsif CommandId = 0x7D15 then
		ResponseSize := HandleAxisDs402HomeStart(
			Reference:=Reference, pRequest:=pRequest, pResponse:=pResponse,
			ResponseCapacity:=ResponseCapacity,
