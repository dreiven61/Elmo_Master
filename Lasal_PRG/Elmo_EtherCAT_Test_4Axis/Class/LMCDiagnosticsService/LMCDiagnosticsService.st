			detailCode := 5;
		else
			recordBase := TO_DINT(Reference - 1) * LMC_DIAG_HOMEEX_RECORD_STRIDE;
			tombstoneBase := LMC_DIAG_HOMEEX_RETIRED_BASE +
				TO_DINT(Reference - 1) * LMC_DIAG_HOMEEX_RETIRED_STRIDE;
			recordState := Ds402HomeExState[recordBase];
			if recordState = 0 then
				tombstoneDirty := FALSE;
				recordIndex := 0;
				while recordIndex < LMC_DIAG_HOMEEX_RETIRED_STRIDE do
					if Ds402HomeExState[tombstoneBase + recordIndex] <> 0 then
						tombstoneDirty := TRUE;
					end_if;
					recordIndex += 1;
				end_while;
				if tombstoneDirty = FALSE then
					detailCode := LMC_DIAG_HOMEEX_DETAIL_NOT_FOUND;
				else
					rawRetiredState := Ds402HomeExState[tombstoneBase]$UDINT;
					retiredState := TO_DINT(rawRetiredState and 0x00007FFF);
					tombstoneValid :=
						((rawRetiredState = 0x00008002) |
						 (rawRetiredState = 0x00008003) |
						 (rawRetiredState = 0x00008004)) &
						(Ds402HomeExState[tombstoneBase + 1]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 2]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 3]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 4]$UDINT <> 0) &
						((Ds402HomeExState[tombstoneBase + 5] <> 0) |
						 (Ds402HomeExState[tombstoneBase + 6] <> 0) |
						 (Ds402HomeExState[tombstoneBase + 7] <> 0) |
						 (Ds402HomeExState[tombstoneBase + 8] <> 0)) &
						(Ds402HomeExState[tombstoneBase + 9] = TO_DINT(Reference)) &
						(Ds402HomeExState[tombstoneBase + 11]$UDINT <> 0x80000000) &
						(Ds402HomeExState[tombstoneBase + 18] = 1) &
						(Ds402HomeExState[tombstoneBase + 19]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 20]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 21] = 0) &
						(Ds402HomeExState[tombstoneBase + 22] = 0) &
						(Ds402HomeExState[tombstoneBase + 23] = 0) &
						(Ds402HomeExState[tombstoneBase + 24] = 0) &
						(Ds402HomeExState[tombstoneBase + 25] = 0) &
						(Ds402HomeExState[tombstoneBase + 26] = 0) &
						(Ds402HomeExState[tombstoneBase + 27] = 0) &
						(Ds402HomeExState[tombstoneBase + 28] = 0) &
						(Ds402HomeExState[tombstoneBase + 34]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 35]$UDINT >=
						 Ds402HomeExState[tombstoneBase + 34]$UDINT) &
						(Ds402HomeExState[tombstoneBase + 36] = 0) &
						(Ds402HomeExState[tombstoneBase + 37]$UDINT <> 0) &
						(Ds402HomeExState[tombstoneBase + 38]$UDINT =
						 LMC_DIAG_HOMEEX_CLEANUP_PROOF_REQUIRED) &
						(Ds402HomeExState[tombstoneBase + 39]$UDINT <> 0);
					if tombstoneValid = FALSE then
						detailCode := LMC_DIAG_HOMEEX_DETAIL_STORE_CORRUPT;
					else
						tombstoneMatches :=
							(Ds402HomeExState[tombstoneBase + 1]$UDINT = diagnosticsBuild) &
							(Ds402HomeExState[tombstoneBase + 2]$UDINT = bootId) &
							(Ds402HomeExState[tombstoneBase + 3]$UDINT = mapRevision) &
							(Ds402HomeExState[tombstoneBase + 4]$UDINT = originalRequestId) &
							(Ds402HomeExState[tombstoneBase + 5]$UDINT = intent0) &
							(Ds402HomeExState[tombstoneBase + 6]$UDINT = intent1) &
							(Ds402HomeExState[tombstoneBase + 7]$UDINT = intent2) &
							(Ds402HomeExState[tombstoneBase + 8]$UDINT = intent3) &
							(Ds402HomeExState[tombstoneBase + 9] = TO_DINT(Reference)) &
							(Ds402HomeExState[tombstoneBase + 10] = homingMethod) &
							(Ds402HomeExState[tombstoneBase + 11] = (pRequest + 44)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 12] = (pRequest + 48)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 13] = (pRequest + 52)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 14] = (pRequest + 56)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 15] = (pRequest + 60)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 16] = (pRequest + 64)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 17] = (pRequest + 68)^$DINT) &
							(Ds402HomeExState[tombstoneBase + 18] = TO_DINT(bufferMode)) &
							(Ds402HomeExState[tombstoneBase + 19]$UDINT = overallTimeout) &
							(Ds402HomeExState[tombstoneBase + 20]$UDINT = detectionTimeout) &
							(Ds402HomeExState[tombstoneBase + 37]$UDINT = expectedGeneration);
						if tombstoneMatches then
							if ResponseCapacity < 176 then
								ResponseSize := -1;
								RETURN;
							end_if;
							responseBase := tombstoneBase;
							retireSuccess := TRUE;
						else
							detailCode := LMC_DIAG_HOMEEX_DETAIL_KEY_MISMATCH;
						end_if;
					end_if;
				end_if;
			else
				recordValid :=
					(recordState >= 1) & (recordState <= 4) &
					(Ds402HomeExState[recordBase + 1]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 2]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 3]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 4]$UDINT <> 0) &
					((Ds402HomeExState[recordBase + 5] <> 0) |
					 (Ds402HomeExState[recordBase + 6] <> 0) |
					 (Ds402HomeExState[recordBase + 7] <> 0) |
					 (Ds402HomeExState[recordBase + 8] <> 0)) &
					(Ds402HomeExState[recordBase + 9] = TO_DINT(Reference)) &
					(Ds402HomeExState[recordBase + 11]$UDINT <> 0x80000000) &
					(Ds402HomeExState[recordBase + 18] = 1) &
					(Ds402HomeExState[recordBase + 19]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 20]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 21] = 0) &
					(Ds402HomeExState[recordBase + 22] = 0) &
					(Ds402HomeExState[recordBase + 23] = 0) &
					(Ds402HomeExState[recordBase + 24] = 0) &
					(Ds402HomeExState[recordBase + 25] = 0) &
					(Ds402HomeExState[recordBase + 26] = 0) &
					(Ds402HomeExState[recordBase + 27] = 0) &
					(Ds402HomeExState[recordBase + 28] = 0) &
					(Ds402HomeExState[recordBase + 34]$UDINT <> 0) &
					(Ds402HomeExState[recordBase + 37]$UDINT <> 0);
				if recordValid then
					if recordState = 1 then
						recordValid := recordValid &
							(Ds402HomeExState[recordBase + 35] = 0) &
							(Ds402HomeExState[recordBase + 36] = 0) &
							(Ds402HomeExState[recordBase + 38] = 0);
					else
						recordValid := recordValid &
							(Ds402HomeExState[recordBase + 35]$UDINT >=
							 Ds402HomeExState[recordBase + 34]$UDINT) &
							(Ds402HomeExState[recordBase + 36] = 0) &
							(Ds402HomeExState[recordBase + 39]$UDINT <> 0);
					end_if;
				end_if;
				if recordValid = FALSE then
					detailCode := LMC_DIAG_HOMEEX_DETAIL_STORE_CORRUPT;
				else
					keyMatches :=
						(Ds402HomeExState[recordBase + 1]$UDINT = diagnosticsBuild) &
						(Ds402HomeExState[recordBase + 2]$UDINT = bootId) &
						(Ds402HomeExState[recordBase + 3]$UDINT = mapRevision) &
						(Ds402HomeExState[recordBase + 4]$UDINT = originalRequestId) &
						(Ds402HomeExState[recordBase + 5]$UDINT = intent0) &
						(Ds402HomeExState[recordBase + 6]$UDINT = intent1) &
						(Ds402HomeExState[recordBase + 7]$UDINT = intent2) &
						(Ds402HomeExState[recordBase + 8]$UDINT = intent3) &
						(Ds402HomeExState[recordBase + 9] = TO_DINT(Reference)) &
						(Ds402HomeExState[recordBase + 10] = homingMethod) &
						(Ds402HomeExState[recordBase + 11] = (pRequest + 44)^$DINT) &
						(Ds402HomeExState[recordBase + 12] = (pRequest + 48)^$DINT) &
						(Ds402HomeExState[recordBase + 13] = (pRequest + 52)^$DINT) &
						(Ds402HomeExState[recordBase + 14] = (pRequest + 56)^$DINT) &
						(Ds402HomeExState[recordBase + 15] = (pRequest + 60)^$DINT) &
						(Ds402HomeExState[recordBase + 16] = (pRequest + 64)^$DINT) &
						(Ds402HomeExState[recordBase + 17] = (pRequest + 68)^$DINT) &
						(Ds402HomeExState[recordBase + 18] = TO_DINT(bufferMode)) &
						(Ds402HomeExState[recordBase + 19]$UDINT = overallTimeout) &
						(Ds402HomeExState[recordBase + 20]$UDINT = detectionTimeout);
					if keyMatches = FALSE then
						detailCode := LMC_DIAG_HOMEEX_DETAIL_KEY_MISMATCH;
					elsif recordState = 1 then
						detailCode := LMC_DIAG_HOMEEX_DETAIL_INDETERMINATE;
					elsif Ds402HomeExState[recordBase + 38]$UDINT <>
						LMC_DIAG_HOMEEX_CLEANUP_PROOF_REQUIRED then
						detailCode := LMC_DIAG_HOMEEX_DETAIL_CLEANUP_INCOMPLETE;
					elsif expectedGeneration <>
						Ds402HomeExState[recordBase + 37]$UDINT then
						detailCode := LMC_DIAG_HOMEEX_DETAIL_KEY_MISMATCH;
					elsif ResponseCapacity < 176 then
						ResponseSize := -1;
						RETURN;
					else
						Ds402HomeExState[tombstoneBase] := 0;
						recordIndex := 1;
						while recordIndex < LMC_DIAG_HOMEEX_RETIRED_STRIDE do
							Ds402HomeExState[tombstoneBase + recordIndex] :=
								Ds402HomeExState[recordBase + recordIndex];
							recordIndex += 1;
						end_while;
						Ds402HomeExState[tombstoneBase] :=
							TO_DINT(TO_UDINT(recordState) or LMC_DIAG_HOMEEX_RETIRED_STATE_MASK);
						responseBase := tombstoneBase;
						retiredState := recordState;
						retireSuccess := TRUE;
						recordIndex := 0;
						while recordIndex < LMC_DIAG_HOMEEX_RECORD_STRIDE do
							Ds402HomeExState[recordBase + recordIndex] := 0;
							recordIndex += 1;
						end_while;
					end_if;
				end_if;
			end_if;
		end_if;
	end_if;

	if retireSuccess then
		(pResponse + 4)^$UINT := 0;
		(pResponse + 6)^$INT := 0;
		(pResponse + 12)^$UDINT := 0;
		(pResponse + 16)^$UINT := TO_UINT(retiredState);
		(pResponse + 18)^$UINT := 0;
		(pResponse + 20)^$UDINT := Ds402HomeExState[responseBase + 1]$UDINT;
		(pResponse + 24)^$UDINT := Ds402HomeExState[responseBase + 2]$UDINT;
		(pResponse + 28)^$UDINT := Ds402HomeExState[responseBase + 3]$UDINT;
		(pResponse + 32)^$UDINT := Ds402HomeExState[responseBase + 4]$UDINT;
		(pResponse + 36)^$UDINT := Ds402HomeExState[responseBase + 5]$UDINT;
		(pResponse + 40)^$UDINT := Ds402HomeExState[responseBase + 6]$UDINT;
		(pResponse + 44)^$UDINT := Ds402HomeExState[responseBase + 7]$UDINT;
		(pResponse + 48)^$UDINT := Ds402HomeExState[responseBase + 8]$UDINT;
		(pResponse + 52)^$UINT := TO_UINT(Ds402HomeExState[responseBase + 9]);
		(pResponse + 54)^$UINT := 0;
		(pResponse + 56)^$DINT := Ds402HomeExState[responseBase + 10];
		(pResponse + 60)^$DINT := Ds402HomeExState[responseBase + 11];
		(pResponse + 64)^$DINT := Ds402HomeExState[responseBase + 12];
		(pResponse + 68)^$DINT := Ds402HomeExState[responseBase + 13];
		(pResponse + 72)^$DINT := Ds402HomeExState[responseBase + 14];
		(pResponse + 76)^$DINT := Ds402HomeExState[responseBase + 15];
		(pResponse + 80)^$DINT := Ds402HomeExState[responseBase + 16];
		(pResponse + 84)^$DINT := Ds402HomeExState[responseBase + 17];
		(pResponse + 88)^$UINT := TO_UINT(Ds402HomeExState[responseBase + 18]);
		(pResponse + 90)^$UINT := 0;
		(pResponse + 92)^$UDINT := Ds402HomeExState[responseBase + 19]$UDINT;
		(pResponse + 96)^$UDINT := Ds402HomeExState[responseBase + 20]$UDINT;
		(pResponse + 132)^$UDINT := Ds402HomeExState[responseBase + 29]$UDINT;
		(pResponse + 136)^$UDINT := Ds402HomeExState[responseBase + 30]$UDINT;
		(pResponse + 140)^$UDINT := Ds402HomeExState[responseBase + 31]$UDINT;
		(pResponse + 144)^$DINT := Ds402HomeExState[responseBase + 32];
		(pResponse + 148)^$DINT := Ds402HomeExState[responseBase + 33];
		(pResponse + 152)^$UDINT := Ds402HomeExState[responseBase + 34]$UDINT;
		(pResponse + 156)^$UDINT := Ds402HomeExState[responseBase + 35]$UDINT;
		(pResponse + 160)^$UDINT := Ds402HomeExState[responseBase + 36]$UDINT;
		(pResponse + 164)^$UDINT := Ds402HomeExState[responseBase + 37]$UDINT;
		(pResponse + 168)^$UDINT := Ds402HomeExState[responseBase + 38]$UDINT;
		(pResponse + 172)^$UDINT := Ds402HomeExState[responseBase + 39]$UDINT;
		ResponseSize := 176;
	else
		(pResponse + 12)^$UDINT := detailCode;
	end_if;

END_FUNCTION

FUNCTION LMCDiagnosticsService::ProcessAxisDs402HomeEx
	// HOMEEX-07 adds exact ownership only. SDO, RT mailbox, controlword,
	// mode, setpoint and motion execution remain forbidden until HOMEEX-08.
	RETURN;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisDs402HomeStart
	VAR_INPUT
		Reference 	: UINT;
		pRequest 	: ^USINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CallerSessionEpoch 	: UDINT;
		RequestSequence 	: UDINT;
		AdmissionToken 	: UDINT;
		OwnerGeneration 	: UDINT;
		RequestSize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags : UINT;
		homingMethod, homePosition, velocity, acceleration : DINT;
		distanceLimit, torqueLimit : DINT;
		bufferMode, reservedValue : UINT;
		requestId, diagnosticsBuild, bootId, mapRevision : UDINT;
		intent0, intent1, intent2, intent3 : UDINT;
		timeoutMs, executeToken, currentBootId, detailCode : UDINT;
		nextGeneration, currentCycle, serviceStart, healthOffset, valueOffset : UDINT;
		axisMask : UDINT;
		rawStartState, baseStartState : UDINT;
		statusWord : UDINT;
		recordBase : DINT;
		copyResult, ownerResult, rollbackResult : DINT;
		intentBodyCompareResult, intentTailCompareResult : UDINT;
		snapshot : ARRAY [0..303] OF USINT;
		executorConnected, executorReusable : BOOL;
		journalEligible, journalPrepared, preflightOnly : BOOL;
		intentMatches : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 24) then
		RETURN;
	end_if;

	_memset(dest:=pResponse, usByte:=0, cntr:=24);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	detailCode := 9;
	requestId := 0;
	homingMethod := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	if (pRequest <> NIL) & (RequestSize >= 40) then
		homingMethod := (pRequest + 36)^$DINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 16)^$DINT := homingMethod;
	ResponseSize := 24;

	if (pRequest = NIL) | (RequestSize <> 72) then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;

	schemaVersion := pRequest^$UINT;
	requestFlags := (pRequest + 2)^$UINT;
	diagnosticsBuild := (pRequest + 8)^$UDINT;
	bootId := (pRequest + 12)^$UDINT;
	mapRevision := (pRequest + 16)^$UDINT;
	intent0 := (pRequest + 20)^$UDINT;
	intent1 := (pRequest + 24)^$UDINT;
	intent2 := (pRequest + 28)^$UDINT;
	intent3 := (pRequest + 32)^$UDINT;
	homePosition := (pRequest + 40)^$DINT;
	velocity := (pRequest + 44)^$DINT;
	acceleration := (pRequest + 48)^$DINT;
	distanceLimit := (pRequest + 52)^$DINT;
	torqueLimit := (pRequest + 56)^$DINT;
	bufferMode := (pRequest + 60)^$UINT;
	reservedValue := (pRequest + 62)^$UINT;
	timeoutMs := (pRequest + 64)^$UDINT;
	executeToken := (pRequest + 68)^$UDINT;
	currentBootId := GetDiagnosticsBootId();
	rawStartState := 0xFFFFFFFF;
	baseStartState := 0xFFFFFFFF;
	axisMask := 0;
	journalEligible := FALSE;
	journalPrepared := FALSE;
	preflightOnly := (AdmissionToken = 0) & (OwnerGeneration = 0);
	if (Reference >= 1) & (Reference <= 4) then
		recordBase := TO_DINT(Reference - 1) * 23;
		axisMask := TO_UDINT(1) shl TO_UDINT(Reference - 1);
		rawStartState := Ds402HomeState[recordBase]$UDINT;
		baseStartState := rawStartState and 0x00007FFF;
	end_if;
	if preflightOnly then
		// Publish the request intent before TCP may create a common reservation.
		// Stage 87 is the final publication word and can only resolve to rollback.
		if (Reference < 1) | (Reference > 4) |
			(schemaVersion <> 1) | (requestFlags <> 0) | (requestId = 0) |
			((intent0 = 0) & (intent1 = 0) & (intent2 = 0) & (intent3 = 0)) |
			(homingMethod <> 37) | (homePosition <> 0) |
			(velocity <> 0) | (acceleration <> 0) |
			(distanceLimit <> 0) | (torqueLimit <> 0) |
			(bufferMode <> 1) | (reservedValue <> 0) | (timeoutMs = 0) |
			(executeToken <> 0x32303448) then
			detailCode := 9;
		elsif diagnosticsBuild <> 1 then
			detailCode := 16;
		elsif (currentBootId = 0) | (bootId <> currentBootId) then
			detailCode := 17;
		elsif mapRevision <> LMC_DIAG_MAP_REVISION then
			detailCode := 18;
		elsif (CallerSessionEpoch = 0) | (RequestSequence = 0) |
			(sizeof(Ds402HomeState) <> 512) |
			(Ds402HomeState[92] <> 0) |
			(Ds402HomeState[109]$UDINT = 0xFFFFFFFF) then
			detailCode := 10;
		elsif (rawStartState = 2) | (rawStartState = 3) |
			(rawStartState = 4) then
			detailCode := 32;
		elsif (rawStartState <> 0) & (rawStartState <> 0x00008002) &
			(rawStartState <> 0x00008003) &
			(rawStartState <> 0x00008004) then
			detailCode := 10;
		else
			recordBase := TO_DINT(Reference - 1) * 23;
			// Slot 109 is the last committed operation generation. Intent
			// publication must not consume it.
			_memset(dest:=#Ds402HomeState[92], usByte:=0, cntr:=68);
			_memset(dest:=#Ds402HomeState[110], usByte:=0, cntr:=72);
			Ds402HomeState[93] := TO_DINT(Reference - 1);
			_memcpy(ptr1:=#Ds402HomeState[94], ptr2:=pRequest, cntr:=60);
			_memcpy(ptr1:=#Ds402HomeState[110], ptr2:=pRequest + 60,
				cntr:=12);
			Ds402HomeState[113] := CallerSessionEpoch$DINT;
			Ds402HomeState[114] := RequestSequence$DINT;
			Ds402HomeState[115] := rawStartState$DINT;
			Ds402HomeState[116]$UDINT := LMC_DIAG_DS402_INTENT_MAGIC;
			Ds402HomeState[117] := Ds402HomeState[109];
			currentCycle := ops.tAbsolute;
			if currentCycle = 0 then
				currentCycle := 1;
			end_if;
			Ds402HomeState[118] := currentCycle$DINT;
			Ds402HomeState[119] := 0;
			intentBodyCompareResult := _memcmp(ptr1:=#Ds402HomeState[94],
				ptr2:=pRequest, cntr:=60);
			intentTailCompareResult := _memcmp(ptr1:=#Ds402HomeState[110],
				ptr2:=pRequest + 60, cntr:=12);
			if (intentBodyCompareResult = 0) &
				(intentTailCompareResult = 0) &
				(Ds402HomeState[93] = TO_DINT(Reference - 1)) &
				(Ds402HomeState[113]$UDINT = CallerSessionEpoch) &
				(Ds402HomeState[114]$UDINT = RequestSequence) &
				(Ds402HomeState[115]$UDINT = rawStartState) &
				(Ds402HomeState[116]$UDINT =
				 LMC_DIAG_DS402_INTENT_MAGIC) &
				(Ds402HomeState[117] = Ds402HomeState[109]) &
				(Ds402HomeState[118] <> 0) &
				(Ds402HomeState[recordBase]$UDINT = rawStartState) then
				Ds402HomeState[92] :=
					LMC_DIAG_DS402_STAGE_RESERVE_INTENT;
				if Ds402HomeState[92] =
					LMC_DIAG_DS402_STAGE_RESERVE_INTENT then
					ResponseSize := LMC_DIAG_DS402_PREFLIGHT_READY;
					RETURN;
				end_if;
			end_if;
			detailCode := 10;
		end_if;
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;
	intentMatches := FALSE;
	if (Reference >= 1) & (Reference <= 4) &
		(Ds402HomeState[92] = LMC_DIAG_DS402_STAGE_RESERVE_INTENT) then
		recordBase := TO_DINT(Reference - 1) * 23;
		intentBodyCompareResult := _memcmp(ptr1:=#Ds402HomeState[94],
			ptr2:=pRequest, cntr:=60);
		intentTailCompareResult := _memcmp(ptr1:=#Ds402HomeState[110],
			ptr2:=pRequest + 60, cntr:=12);
		intentMatches := (intentBodyCompareResult = 0) &
			(intentTailCompareResult = 0) &
			(Ds402HomeState[93] = TO_DINT(Reference - 1)) &
			(Ds402HomeState[113]$UDINT = CallerSessionEpoch) &
			(Ds402HomeState[114]$UDINT = RequestSequence) &
			((Ds402HomeState[115]$UDINT = 0) |
			 (Ds402HomeState[115]$UDINT = 0x00008002) |
			 (Ds402HomeState[115]$UDINT = 0x00008003) |
			 (Ds402HomeState[115]$UDINT = 0x00008004)) &
			(Ds402HomeState[116]$UDINT = LMC_DIAG_DS402_INTENT_MAGIC) &
			(Ds402HomeState[117] = Ds402HomeState[109]) &
			(Ds402HomeState[118] <> 0) &
			(Ds402HomeState[119] = 0) &
			(Ds402HomeState[120] = 0) &
			(Ds402HomeState[121] = 0) &
			(Ds402HomeState[122] = 0) &
			(Ds402HomeState[123] = 0) &
			(Ds402HomeState[124] = 0) &
			(Ds402HomeState[125] = 0) &
			(Ds402HomeState[126] = 0) &
			(Ds402HomeState[127] = 0) &
			(Ds402HomeState[recordBase]$UDINT =
			 Ds402HomeState[115]$UDINT);
	end_if;

	if (Reference < 1) | (Reference > 4) |
		(schemaVersion <> 1) | (requestFlags <> 0) | (requestId = 0) |
		((intent0 = 0) & (intent1 = 0) & (intent2 = 0) & (intent3 = 0)) |
		(homingMethod <> 37) | (homePosition <> 0) |
		(velocity <> 0) | (acceleration <> 0) |
		(distanceLimit <> 0) | (torqueLimit <> 0) |
		(bufferMode <> 1) | (reservedValue <> 0) | (timeoutMs = 0) |
		(executeToken <> 0x32303448) then
		detailCode := 9;
	elsif diagnosticsBuild <> 1 then
		detailCode := 16;
	elsif (currentBootId = 0) | (bootId <> currentBootId) then
		detailCode := 17;
	elsif mapRevision <> LMC_DIAG_MAP_REVISION then
		detailCode := 18;
	elsif (LMC_DIAG_DS402_HOME_ENABLED = FALSE) |
		(CallerSessionEpoch = 0) | (RequestSequence = 0) |
		(AdmissionToken = 0) | (OwnerGeneration = 0) |
		(IsClientConnected(#AxisOwnership) = FALSE) |
		(sizeof(Ds402HomeState) <> 512) |
		(intentMatches = FALSE) |
		(Ds402HomeState[109]$UDINT = 0xFFFFFFFF) |
		(EncoderMaintenanceState[LMC_DIAG_ENCODER_RUNTIME_BASE] <> 0) |
		(OperationState = LMC_DIAG_SDO_STATE_QUEUED) |
		(OperationState = LMC_DIAG_SDO_STATE_RUNNING) |
		(SdoInternalDrainState <> 0) then
		detailCode := 10;
	elsif (rawStartState = 2) | (rawStartState = 3) |
		(rawStartState = 4) then
		detailCode := 32;
	elsif (rawStartState <> 0) & (rawStartState <> 0x00008002) &
		(rawStartState <> 0x00008003) &
		(rawStartState <> 0x00008004) then
		detailCode := 10;
	else
		detailCode := 0;
	end_if;

	// Promote only the exact pre-reservation intent into a RESERVED rollback
	// journal. Stage 88 can only roll back; stage 89 may commit.
	journalEligible :=
		(Reference >= 1) & (Reference <= 4) &
		(schemaVersion = 1) & (requestFlags = 0) & (requestId <> 0) &
		((intent0 <> 0) | (intent1 <> 0) | (intent2 <> 0) | (intent3 <> 0)) &
		(homingMethod = 37) & (homePosition = 0) &
		(velocity = 0) & (acceleration = 0) &
		(distanceLimit = 0) & (torqueLimit = 0) &
		(bufferMode = 1) & (reservedValue = 0) & (timeoutMs <> 0) &
		(executeToken = 0x32303448) &
		(CallerSessionEpoch <> 0) & (RequestSequence <> 0) &
		(AdmissionToken <> 0) & (OwnerGeneration <> 0) &
		(sizeof(Ds402HomeState) = 512) &
		intentMatches &
		((rawStartState = 0) | (rawStartState = 0x00008002) |
		 (rawStartState = 0x00008003) | (rawStartState = 0x00008004));
	if journalEligible then
		nextGeneration := Ds402HomeState[117]$UDINT;
		if nextGeneration = 0xFFFFFFFF then
			journalEligible := FALSE;
		else
			nextGeneration += 1;
			if nextGeneration = 0 then
				journalEligible := FALSE;
			end_if;
		end_if;
	end_if;
	if journalEligible & IsClientConnected(#AxisOwnership) then
		ownerResult := AxisOwnership.ValidateAxisOwnershipIdentity(
			CommandId:=0x7D15,
			Reference:=Reference,
			ExpectedAxisMask:=axisMask,
			OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
			ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
			AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
			CallerSessionEpoch:=CallerSessionEpoch,
			RequestSequence:=RequestSequence,
			AdmissionToken:=AdmissionToken,
			OwnerGeneration:=OwnerGeneration,
			RequiredPhase:=LMC_DIAG_OWNER_PHASE_RESERVED,
			pIdentity:=pRequest$^void,
			IdentitySize:=RequestSize);
		if ownerResult = -1 then
			// A transient validation response still owns an exact local rollback
			// journal, but it must never progress to the commit-ready stage.
			detailCode := 10;
		elsif ownerResult <> 0 then
			journalEligible := FALSE;
		end_if;
	end_if;
	if journalEligible then
		recordBase := TO_DINT(Reference - 1) * 23;
		currentCycle := ops.tAbsolute;
		if currentCycle = 0 then
			currentCycle := 1;
		end_if;
		serviceStart := Ds402HomeState[118]$UDINT;
		if serviceStart = 0 then
			serviceStart := currentCycle;
		end_if;
		// Publish the adopted tuple before a retained tombstone can be cleared.
		// Slot 119 is the bridge commit word and is written last.
		Ds402HomeState[120] := CallerSessionEpoch$DINT;
		Ds402HomeState[121] := RequestSequence$DINT;
		Ds402HomeState[122] := AdmissionToken$DINT;
		Ds402HomeState[123] := OwnerGeneration$DINT;
		Ds402HomeState[124] := axisMask$DINT;
		Ds402HomeState[125] := LMC_DIAG_DS402_RECEIPT_PREPARED;
		Ds402HomeState[119]$UDINT := LMC_DIAG_DS402_INTENT_ADOPT_MAGIC;
		// Stage87 plus the adopted tuple remains authoritative while the selected
		// record is rebuilt. Publish state 0 as a DINT commit before byte-clearing
		// the body so a torn clear remains a replayable adopted raw intent.
		Ds402HomeState[recordBase] := 0;
		_memset(dest:=#Ds402HomeState[recordBase + 1], usByte:=0, cntr:=88);
		Ds402HomeState[recordBase + 1] := diagnosticsBuild$DINT;
		Ds402HomeState[recordBase + 2] := bootId$DINT;
		Ds402HomeState[recordBase + 3] := mapRevision$DINT;
		Ds402HomeState[recordBase + 4] := requestId$DINT;
		Ds402HomeState[recordBase + 5] := intent0$DINT;
		Ds402HomeState[recordBase + 6] := intent1$DINT;
		Ds402HomeState[recordBase + 7] := intent2$DINT;
		Ds402HomeState[recordBase + 8] := intent3$DINT;
		Ds402HomeState[recordBase + 9] := homingMethod;
		Ds402HomeState[recordBase + 10] := homePosition;
		Ds402HomeState[recordBase + 11] := velocity;
		Ds402HomeState[recordBase + 12] := acceleration;
		Ds402HomeState[recordBase + 13] := timeoutMs$DINT;
		Ds402HomeState[recordBase + 19] := currentCycle$DINT;
		Ds402HomeState[recordBase + 22] := nextGeneration$DINT;
		// Record state commits the exact body and target metadata before the WAL
		// request bytes are reused.
		Ds402HomeState[recordBase] := 1;
		_memset(dest:=#Ds402HomeState[94], usByte:=0, cntr:=60);
		_memset(dest:=#Ds402HomeState[110], usByte:=0, cntr:=36);
		_memset(dest:=#Ds402HomeState[126], usByte:=0, cntr:=8);
		Ds402HomeState[99] := nextGeneration$DINT;
		Ds402HomeState[101] := nextGeneration$DINT;
		Ds402HomeState[103] := 1;
		Ds402HomeState[105] := 8;
		Ds402HomeState[109] := nextGeneration$DINT;
		Ds402HomeState[110] := currentCycle$DINT;
		Ds402HomeState[118]$UDINT := serviceStart;
		// This publication word means rollback-only until all start gates pass.
		Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED;
		journalPrepared := TRUE;
		// Stage88 now replaces the adoption proof for the synchronous Start path.
		Ds402HomeState[119] := 0;
	elsif detailCode = 0 then
		detailCode := 10;
	end_if;
	if journalPrepared & (detailCode = 0) &
		(IsClientConnected(#AxisOwnership) = FALSE) then
		// Preserve the exact rollback-only journal across a transient owner-client
		// disconnect. The cyclic processor validates the common tuple later.
		detailCode := 10;
	end_if;

	if detailCode = 0 then
		copyResult := -1;
		if IsClientConnected(#InputLatch) then
			copyResult := InputLatch.CopySnapshot(
				pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
		end_if;
		if copyResult <> 0 then
			detailCode := 10;
		else
			currentCycle := snapshot[0]$UDINT;
			serviceStart := ops.tAbsolute;
			if serviceStart = 0 then
				serviceStart := 1;
			end_if;
			healthOffset := 64 + TO_UDINT(Reference - 1) * 36;
			valueOffset := 208 + TO_UDINT(Reference - 1) * 24;
			statusWord := snapshot[TO_DINT(valueOffset + 20)]$UDINT;
			if (currentCycle = 0) | (snapshot[12]$UDINT <> 8) |
				(snapshot[16]$UDINT <> 0) |
				((snapshot[40]$UDINT and 3) <> 1) |
				(snapshot[TO_DINT(healthOffset)]$DINT = 0) |
				(snapshot[TO_DINT(healthOffset + 4)]$UDINT <> 8) |
				(snapshot[TO_DINT(healthOffset + 12)]$UDINT <> 0) |
				(snapshot[TO_DINT(healthOffset + 16)]$UDINT = 0xFFFFFFFF) |
				(snapshot[TO_DINT(healthOffset + 24)]$DINT <> 0) |
				(snapshot[TO_DINT(healthOffset + 28)]$UDINT <> currentCycle) |
				((statusWord and 0x0008) <> 0) |
				(((statusWord and 0x006F) <> 0x0040) &
				 ((statusWord and 0x006F) <> 0x0021) &
				 ((statusWord and 0x006F) <> 0x0023) &
				 ((statusWord and 0x006F) <> 0x0027)) then
				 detailCode := 10;
			else
				Ds402HomeState[recordBase + 17] := statusWord$DINT;
				Ds402HomeState[recordBase + 18] :=
					snapshot[TO_DINT(valueOffset + 12)]$DINT;
				Ds402HomeState[recordBase + 19] := currentCycle$DINT;
				Ds402HomeState[102] :=
					snapshot[TO_DINT(valueOffset + 12)]$DINT;
				Ds402HomeState[110] := currentCycle$DINT;
				Ds402HomeState[114] := statusWord$DINT;
				Ds402HomeState[115] :=
					snapshot[TO_DINT(valueOffset + 12)]$DINT;
				Ds402HomeState[118]$UDINT := serviceStart;
			end_if;
		end_if;
	end_if;

	if detailCode = 0 then
		executorConnected := FALSE;
		executorReusable := FALSE;
		case Reference of
			1:
				executorConnected := IsClientConnected(#SdoAxis1) <> 0;
				if executorConnected then
					executorReusable := SdoAxis1.IsReusable();
				end_if;
			2:
				executorConnected := IsClientConnected(#SdoAxis2) <> 0;
				if executorConnected then
					executorReusable := SdoAxis2.IsReusable();
				end_if;
			3:
				executorConnected := IsClientConnected(#SdoAxis3) <> 0;
				if executorConnected then
					executorReusable := SdoAxis3.IsReusable();
				end_if;
			4:
				executorConnected := IsClientConnected(#SdoAxis4) <> 0;
				if executorConnected then
					executorReusable := SdoAxis4.IsReusable();
				end_if;
		end_case;
		if (executorConnected = FALSE) | (executorReusable = FALSE) then
			detailCode := 10;
		end_if;
	end_if;

	if detailCode = 0 then
		if journalPrepared = FALSE then
			detailCode := 10;
		else
			// From this publication onward a warm recovery may finish Commit.
			Ds402HomeState[92] := 89;
		end_if;
	end_if;

	if (detailCode = 0) &
		(IsClientConnected(#AxisOwnership) = FALSE) then
		// Stage 89 permits warm Commit. Revoke that permission before exposing
		// the disconnect error so rejected Start cleanup remains rollback-only.
		Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED;
		detailCode := 10;
	end_if;
	if detailCode = 0 then
		ownerResult := AxisOwnership.CommitAxisOwnership(
			CommandId:=0x7D15,
			Reference:=Reference,
			ExpectedAxisMask:=axisMask,
			CallerSessionEpoch:=CallerSessionEpoch,
			RequestSequence:=RequestSequence,
			AdmissionToken:=AdmissionToken,
			OwnerGeneration:=OwnerGeneration);
		if ownerResult = 0 then
			Ds402HomeState[125] := 2;
			Ds402HomeState[92] := 1;
		else
			// A lost Commit response is accepted only after exact ACTIVE proof.
			ownerResult := AxisOwnership.ValidateAxisOwnership(
				CommandId:=0x7D15,
				Reference:=Reference,
				ExpectedAxisMask:=axisMask,
				OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
				ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
				AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
				CallerSessionEpoch:=CallerSessionEpoch,
				RequestSequence:=RequestSequence,
				AdmissionToken:=AdmissionToken,
				OwnerGeneration:=OwnerGeneration,
				RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
			if ownerResult = 0 then
				Ds402HomeState[125] := 2;
				Ds402HomeState[92] := 1;
			else
				// Commit is uncertain but the handler has not run. Downgrade to the
				// rollback-only publication word before returning an error.
				Ds402HomeState[92] :=
					LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED;
				detailCode := 10;
			end_if;
		end_if;
	end_if;

	if detailCode = 0 then
		(pResponse + 4)^$UINT := 0;
		(pResponse + 6)^$INT := 0;
	end_if;
	if (detailCode <> 0) & (AdmissionToken <> 0) &
		(OwnerGeneration <> 0) & (CallerSessionEpoch <> 0) &
		(RequestSequence <> 0) then
		if (Reference >= 1) & (Reference <= 4) &
			((Ds402HomeState[92] =
			  LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED) |
			 (Ds402HomeState[92] = 89)) &
			(Ds402HomeState[93] = TO_DINT(Reference - 1)) &
			(Ds402HomeState[120]$UDINT = CallerSessionEpoch) &
			(Ds402HomeState[121]$UDINT = RequestSequence) &
			(Ds402HomeState[122]$UDINT = AdmissionToken) &
			(Ds402HomeState[123]$UDINT = OwnerGeneration) &
			(Ds402HomeState[124]$UDINT = axisMask) then
			// The local journal now owns rollback completion across task restarts.
			rollbackResult := -1;
			if IsClientConnected(#AxisOwnership) then
				rollbackResult :=
					AxisOwnership.PublishAxisOwnershipDs402Receipt(
						AxisMask:=axisMask,
						AdmissionToken:=AdmissionToken,
						OwnerGeneration:=OwnerGeneration,
						ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
						ReportValue0:=0,
						ReportValue1:=0,
						ObservationCycle:=Ds402HomeState[110]$UDINT,
						pDs402State:=#Ds402HomeState[0],
						Ds402StateSize:=sizeof(Ds402HomeState));
			end_if;
			if rollbackResult = 0 then
				if Ds402HomeState[125] =
					LMC_DIAG_DS402_RECEIPT_PREPARED then
					Ds402HomeState[125] := 2;
				end_if;
				// Finish owner cleanup before a rejected Start response can race a
				// session-close quarantine of the still-RESERVED tuple.
				rollbackResult := -1;
				if IsClientConnected(#AxisOwnership) then
					rollbackResult :=
						AxisOwnership.PublishAxisOwnershipDs402Receipt(
							AxisMask:=axisMask,
							AdmissionToken:=AdmissionToken,
							OwnerGeneration:=OwnerGeneration,
							ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
							ReportValue0:=0,
							ReportValue1:=0,
							ObservationCycle:=Ds402HomeState[110]$UDINT,
							pDs402State:=#Ds402HomeState[0],
							Ds402StateSize:=sizeof(Ds402HomeState));
				end_if;
				if rollbackResult = 1 then
					Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
				else
					if (rollbackResult <> -1) |
						(Ds402HomeState[92] <>
						 LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED) then
						Ds402HomeState[92] := 101;
					end_if;
					detailCode := 42;
				end_if;
			elsif rollbackResult = 1 then
				Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
			else
				if (rollbackResult <> -1) |
					(Ds402HomeState[92] <>
					 LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED) then
					Ds402HomeState[92] := 101;
				end_if;
				detailCode := 42;
			end_if;
		elsif Ds402HomeState[92] =
			LMC_DIAG_DS402_STAGE_RESERVE_INTENT then
			// Stage 87 has no trusted token tuple yet. Only the cyclic tokenless
			// provider may prove and resolve it; never issue a blind rollback here.
			if intentMatches = FALSE then
				Ds402HomeState[92] := 101;
			end_if;
			detailCode := 42;
		else
			// Errors before local journal publication still use exact reservation
			// rollback. No runtime record exists to recover in this branch.
			rollbackResult := -1;
			if IsClientConnected(#AxisOwnership) then
				rollbackResult := AxisOwnership.RollbackAxisOwnership(
					AdmissionToken:=AdmissionToken,
					OwnerGeneration:=OwnerGeneration,
					CallerSessionEpoch:=CallerSessionEpoch,
					RequestSequence:=RequestSequence,
					Reason:=0);
			end_if;
			if rollbackResult <> 0 then
				detailCode := 42;
			end_if;
		end_if;
	end_if;

	(pResponse + 12)^$UDINT := detailCode;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisDs402HomeOutcome
	VAR_INPUT
		Reference 	: UINT;
		pRequest 	: ^USINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CallerSessionEpoch 	: UDINT;
		RequestSize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags : UINT;
		requestId, diagnosticsBuild, bootId, mapRevision : UDINT;
		originalRequestId, intent0, intent1, intent2, intent3 : UDINT;
		currentBootId, detailCode, startCycle, completionCycle : UDINT;
		rawOutcomeState, baseOutcomeState : UDINT;
		homingMethod : DINT;
		recordBase : DINT;
		recordValid, outcomeStateValid : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	_memset(dest:=pResponse, usByte:=0, cntr:=ResponseCapacity);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	detailCode := 28;
	requestId := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	ResponseSize := 16;

	if (pRequest = NIL) | (RequestSize <> 44) |
		(Reference < 1) | (Reference > 4) then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;

	schemaVersion := pRequest^$UINT;
	requestFlags := (pRequest + 2)^$UINT;
	diagnosticsBuild := (pRequest + 8)^$UDINT;
	bootId := (pRequest + 12)^$UDINT;
	mapRevision := (pRequest + 16)^$UDINT;
	originalRequestId := (pRequest + 20)^$UDINT;
	intent0 := (pRequest + 24)^$UDINT;
	intent1 := (pRequest + 28)^$UDINT;
	intent2 := (pRequest + 32)^$UDINT;
	intent3 := (pRequest + 36)^$UDINT;
	homingMethod := (pRequest + 40)^$DINT;
	currentBootId := GetDiagnosticsBootId();

	if (schemaVersion <> 1) | (requestFlags <> 0) | (requestId = 0) |
		(originalRequestId = 0) |
		((intent0 = 0) & (intent1 = 0) & (intent2 = 0) & (intent3 = 0)) |
		(homingMethod <> 37) then
		detailCode := 28;
	elsif diagnosticsBuild <> 1 then
		detailCode := 16;
	elsif (currentBootId = 0) | (bootId <> currentBootId) then
		detailCode := 17;
	elsif mapRevision <> LMC_DIAG_MAP_REVISION then
		detailCode := 18;
	elsif (sizeof(Ds402HomeState) <> 512) |
		(CallerSessionEpoch = 0) then
		detailCode := 29;
	else
		recordBase := TO_DINT(Reference - 1) * 23;
		rawOutcomeState := Ds402HomeState[recordBase]$UDINT;
		baseOutcomeState := rawOutcomeState and 0x00007FFF;
		outcomeStateValid :=
			(rawOutcomeState = 1) | (rawOutcomeState = 2) |
			(rawOutcomeState = 3) | (rawOutcomeState = 4) |
			(rawOutcomeState = 0x00008002) |
			(rawOutcomeState = 0x00008003) |
			(rawOutcomeState = 0x00008004);
		if rawOutcomeState = 0 then
			detailCode := 25;
		elsif outcomeStateValid = FALSE then
			detailCode := 27;
		elsif (Ds402HomeState[recordBase + 1]$UDINT <> diagnosticsBuild) |
			(Ds402HomeState[recordBase + 2]$UDINT <> bootId) |
			(Ds402HomeState[recordBase + 3]$UDINT <> mapRevision) |
			(Ds402HomeState[recordBase + 4]$UDINT <> originalRequestId) |
			(Ds402HomeState[recordBase + 5]$UDINT <> intent0) |
			(Ds402HomeState[recordBase + 6]$UDINT <> intent1) |
			(Ds402HomeState[recordBase + 7]$UDINT <> intent2) |
			(Ds402HomeState[recordBase + 8]$UDINT <> intent3) |
			(Ds402HomeState[recordBase + 9] <> homingMethod) then
			detailCode := 28;
		elsif (baseOutcomeState = 1) & (Ds402HomeState[92] = 101) &
			(Ds402HomeState[93] = TO_DINT(Reference - 1)) then
			detailCode := 26;
		else
			startCycle := Ds402HomeState[recordBase + 19]$UDINT;
			completionCycle := Ds402HomeState[recordBase + 20]$UDINT;
			recordValid := (startCycle <> 0) &
				(Ds402HomeState[recordBase + 22]$UDINT <> 0);
			if baseOutcomeState = 1 then
				recordValid := recordValid & (completionCycle = 0) &
					(Ds402HomeState[recordBase + 14] = 0) &
					(Ds402HomeState[recordBase + 15] = 0) &
					(Ds402HomeState[recordBase + 16] = 0) &
					(Ds402HomeState[recordBase + 21] = 0);
			elsif baseOutcomeState = 2 then
				recordValid := recordValid & (completionCycle >= startCycle) &
					(Ds402HomeState[recordBase + 14] = 0) &
					(Ds402HomeState[recordBase + 15] = 0) &
					(Ds402HomeState[recordBase + 16] = 0) &
					(Ds402HomeState[recordBase + 21] = 0) &
					(Ds402HomeState[recordBase + 18] = 0) &
					((Ds402HomeState[recordBase + 17]$UDINT and
					  0x0008) = 0) &
					((Ds402HomeState[recordBase + 17]$UDINT and
					  0x2000) = 0) &
					(((Ds402HomeState[recordBase + 17]$UDINT and
					   0x006F) = 0x0040) |
					 ((Ds402HomeState[recordBase + 17]$UDINT and
					   0x006F) = 0x0021) |
					 ((Ds402HomeState[recordBase + 17]$UDINT and
					   0x006F) = 0x0023) |
					 ((Ds402HomeState[recordBase + 17]$UDINT and
					   0x006F) = 0x0027));
			elsif baseOutcomeState = 3 then
				recordValid := recordValid & (completionCycle >= startCycle) &
					(Ds402HomeState[recordBase + 14] = 1) &
					(((Ds402HomeState[recordBase + 16] = 11) &
					  (Ds402HomeState[recordBase + 15] = -6) &
					  (Ds402HomeState[recordBase + 21] <> 0)) |
					 ((Ds402HomeState[recordBase + 16] = 10) &
					  (Ds402HomeState[recordBase + 15] = LMC_DIAG_ADMIN_ERROR_ID) &
					  (Ds402HomeState[recordBase + 21] = 0)) |
					 ((Ds402HomeState[recordBase + 16] = 30) &
					  (Ds402HomeState[recordBase + 15] = LMC_DIAG_ADMIN_ERROR_ID)));
			elsif baseOutcomeState = 4 then
				recordValid := recordValid & (completionCycle >= startCycle) &
					(Ds402HomeState[recordBase + 14] = 1) &
					(Ds402HomeState[recordBase + 15] = LMC_DIAG_ADMIN_ERROR_ID) &
					(Ds402HomeState[recordBase + 16] = 31) &
					(Ds402HomeState[recordBase + 21] = 0);
			else
				recordValid := FALSE;
			end_if;
			if recordValid then
				detailCode := 0;
			else
				detailCode := 27;
			end_if;
		end_if;
	end_if;

	if detailCode <> 0 then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;
	if ResponseCapacity < 92 then
		ResponseSize := -1;
		RETURN;
	end_if;

	(pResponse + 4)^$UINT := 0;
	(pResponse + 6)^$INT := 0;
	(pResponse + 12)^$UDINT := 0;
	(pResponse + 16)^$UINT := baseOutcomeState$UINT;
	(pResponse + 20)^$UDINT := Ds402HomeState[recordBase + 1]$UDINT;
	(pResponse + 24)^$UDINT := Ds402HomeState[recordBase + 2]$UDINT;
	(pResponse + 28)^$UDINT := Ds402HomeState[recordBase + 3]$UDINT;
	(pResponse + 32)^$UDINT := Ds402HomeState[recordBase + 4]$UDINT;
	(pResponse + 36)^$UDINT := Ds402HomeState[recordBase + 5]$UDINT;
	(pResponse + 40)^$UDINT := Ds402HomeState[recordBase + 6]$UDINT;
	(pResponse + 44)^$UDINT := Ds402HomeState[recordBase + 7]$UDINT;
	(pResponse + 48)^$UDINT := Ds402HomeState[recordBase + 8]$UDINT;
	(pResponse + 52)^$UINT := Reference;
	(pResponse + 56)^$DINT := Ds402HomeState[recordBase + 9];
	(pResponse + 60)^$UINT := Ds402HomeState[recordBase + 14]$UINT;
	(pResponse + 62)^$INT := Ds402HomeState[recordBase + 15]$INT;
	(pResponse + 64)^$UDINT := Ds402HomeState[recordBase + 16]$UDINT;
	(pResponse + 68)^$UINT := Ds402HomeState[recordBase + 17]$UINT;
	(pResponse + 72)^$DINT := Ds402HomeState[recordBase + 18];
	(pResponse + 76)^$UDINT := Ds402HomeState[recordBase + 19]$UDINT;
	(pResponse + 80)^$UDINT := Ds402HomeState[recordBase + 20]$UDINT;
	(pResponse + 84)^$UDINT := Ds402HomeState[recordBase + 21]$UDINT;
	(pResponse + 88)^$UDINT := Ds402HomeState[recordBase + 22]$UDINT;
	ResponseSize := 92;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisDs402HomeRetire
	VAR_INPUT
		Reference 	: UINT;
		pRequest 	: ^USINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CallerSessionEpoch 	: UDINT;
		RequestSize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags : UINT;
		requestId, diagnosticsBuild, bootId, mapRevision : UDINT;
		originalRequestId, intent0, intent1, intent2, intent3 : UDINT;
		recordGeneration, detailCode, currentBootId : UDINT;
		rawRetireState, baseRetireState : UDINT;
		homingMethod, recordBase : DINT;
		retireStateValid : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	_memset(dest:=pResponse, usByte:=0, cntr:=ResponseCapacity);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	requestId := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	ResponseSize := 16;
	detailCode := 28;
	if (pRequest = NIL) | (RequestSize <> 48) |
		(Reference < 1) | (Reference > 4) then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;

	schemaVersion := pRequest^$UINT;
	requestFlags := (pRequest + 2)^$UINT;
	requestId := (pRequest + 4)^$UDINT;
	diagnosticsBuild := (pRequest + 8)^$UDINT;
	bootId := (pRequest + 12)^$UDINT;
	mapRevision := (pRequest + 16)^$UDINT;
	originalRequestId := (pRequest + 20)^$UDINT;
	intent0 := (pRequest + 24)^$UDINT;
	intent1 := (pRequest + 28)^$UDINT;
	intent2 := (pRequest + 32)^$UDINT;
	intent3 := (pRequest + 36)^$UDINT;
	homingMethod := (pRequest + 40)^$DINT;
	recordGeneration := (pRequest + 44)^$UDINT;
	currentBootId := GetDiagnosticsBootId();

	if (schemaVersion <> 1) | (requestFlags <> 0) | (requestId = 0) |
		(originalRequestId = 0) | (recordGeneration = 0) |
		((intent0 = 0) & (intent1 = 0) & (intent2 = 0) & (intent3 = 0)) |
		(homingMethod <> 37) then
		detailCode := 28;
	elsif diagnosticsBuild <> 1 then
		detailCode := 16;
	elsif (currentBootId = 0) | (bootId <> currentBootId) then
		detailCode := 17;
	elsif mapRevision <> LMC_DIAG_MAP_REVISION then
		detailCode := 18;
	elsif (sizeof(Ds402HomeState) <> 512) |
		(CallerSessionEpoch = 0) then
		detailCode := 29;
	else
		recordBase := TO_DINT(Reference - 1) * 23;
		rawRetireState := Ds402HomeState[recordBase]$UDINT;
		baseRetireState := rawRetireState and 0x00007FFF;
		retireStateValid :=
			(rawRetireState = 2) | (rawRetireState = 3) |
			(rawRetireState = 4) | (rawRetireState = 0x00008002) |
			(rawRetireState = 0x00008003) |
			(rawRetireState = 0x00008004);
		if rawRetireState = 0 then
			detailCode := 25;
		elsif rawRetireState = 1 then
			detailCode := 26;
		elsif retireStateValid = FALSE then
			detailCode := 27;
		elsif (Ds402HomeState[recordBase + 1]$UDINT <> diagnosticsBuild) |
			(Ds402HomeState[recordBase + 2]$UDINT <> bootId) |
			(Ds402HomeState[recordBase + 3]$UDINT <> mapRevision) |
			(Ds402HomeState[recordBase + 4]$UDINT <> originalRequestId) |
			(Ds402HomeState[recordBase + 5]$UDINT <> intent0) |
			(Ds402HomeState[recordBase + 6]$UDINT <> intent1) |
			(Ds402HomeState[recordBase + 7]$UDINT <> intent2) |
			(Ds402HomeState[recordBase + 8]$UDINT <> intent3) |
			(Ds402HomeState[recordBase + 9] <> homingMethod) |
			(Ds402HomeState[recordBase + 22]$UDINT <> recordGeneration) then
			detailCode := 28;
		else
			detailCode := 0;
		end_if;
	end_if;

	if detailCode = 0 then
		ResponseSize := HandleAxisDs402HomeOutcome(
			Reference:=Reference, pRequest:=pRequest, pResponse:=pResponse,
			ResponseCapacity:=ResponseCapacity,
			CallerSessionEpoch:=CallerSessionEpoch, RequestSize:=44);
		if ResponseSize <> 92 then
			RETURN;
		end_if;
		if (pResponse + 88)^$UDINT <> recordGeneration then
			detailCode := 28;
		end_if;
		if detailCode = 0 then
			if rawRetireState = baseRetireState then
				Ds402HomeState[recordBase] :=
					TO_DINT(baseRetireState or 0x00008000);
			end_if;
		end_if;
	end_if;
	if detailCode <> 0 then
		(pResponse + 4)^$UINT := 1;
		(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
		(pResponse + 12)^$UDINT := detailCode;
		ResponseSize := 16;
	end_if;

END_FUNCTION


FUNCTION LMCDiagnosticsService::ProcessAxisDs402Home
	VAR
		snapshot : ARRAY [0..303] OF USINT;
		preemptionSnapshot : ARRAY [0..215] OF USINT;
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		stage, nextStage, activeIndex, recordBase : DINT;
		axisReference, preemptionCleanupKind : UINT;
		currentCycle, previousCycle, startCycle, elapsedCycles : UDINT;
		serviceNow, serviceStart, cleanupStart : UDINT;
		timeoutMs, remainingMs, healthOffset, valueOffset : UDINT;
		statusWord, baseState, sdoToken, sdoData, failureDetail, failureNative : UDINT;
		axisMask, admissionToken, ownerGeneration : UDINT;
		ds402ProcessOwnerSessionEpoch, ownerRequestSequence : UDINT;
		safetyAdmissionToken, safetyOwnerGeneration : UDINT;
		sdoIndex, sdoLength : UINT;
		homeSdoSubIndex : USINT;
		actualPosition : DINT;
		copyResult, completionResult, mailboxResult, orphanResult : DINT;
		preemptionResult : DINT;
		ownerResult : DINT;
		receiptResult : DINT;
		receiptKind : DINT;
		receiptPhase : DINT;
		receiptGeneration : UDINT;
		terminalRecordState : DINT;
		startResult : iprStates;
		snapshotValid, newCycle, executorConnected, executorReusable : BOOL;
		startSdo, waitSdo, sdoIsWrite, failure : BOOL;
		preemptionSnapshotValid, preemptionCleanup, cleanupExpired : BOOL;
	END_VAR

	stage := Ds402HomeState[92];
	receiptResult := HandleAxisDs402HomeReceiptStages(Stage:=stage);
	if receiptResult <> 0 then
		RETURN;
	end_if;
	activeIndex := Ds402HomeState[93];
	admissionToken := Ds402HomeState[122]$UDINT;
	ownerGeneration := Ds402HomeState[123]$UDINT;
	_memset(dest:=#preemptionSnapshot[0], usByte:=0,
		cntr:=sizeof(preemptionSnapshot));
	preemptionResult := -1;
	if IsClientConnected(#AxisOwnership) & (admissionToken <> 0) &
		(ownerGeneration <> 0) then
		preemptionResult := AxisOwnership.CopyAxisOwnershipPreemption(
			PreemptedAdmissionToken:=admissionToken,
			PreemptedOwnerGeneration:=ownerGeneration,
			pDest:=#preemptionSnapshot[0],
			DestSize:=sizeof(preemptionSnapshot));
	end_if;
	if preemptionResult = LMC_DIAG_PREEMPT_PENDING_FREEZE then
		// A RESERVED safety owner may freeze any normal stage for at most one
		// second from the DS402 service start; neither owner is mutated here.
		serviceStart := Ds402HomeState[118]$UDINT;
		cleanupExpired := (serviceStart <> 0) &
			((ops.tAbsolute - serviceStart) >= 1000);
		if cleanupExpired then
			Ds402HomeState[92] := 101;
		end_if;
		RETURN;
	end_if;
	if (preemptionResult < 0) |
		(preemptionResult > LMC_DIAG_PREEMPT_CLEANUP_QUARANTINED) then
		Ds402HomeState[92] := 101;
		RETURN;
	end_if;
	if (activeIndex < 0) | (activeIndex > 3) |
		(sizeof(Ds402HomeState) <> 512) then
		Ds402HomeState[92] := 101;
		RETURN;
	end_if;

	axisReference := TO_UINT(activeIndex + 1);
	recordBase := activeIndex * 23;
	axisMask := Ds402HomeState[124]$UDINT;
	ds402ProcessOwnerSessionEpoch := Ds402HomeState[120]$UDINT;
	ownerRequestSequence := Ds402HomeState[121]$UDINT;
	if (axisMask <> (TO_UDINT(1) shl TO_UDINT(activeIndex))) |
		(ds402ProcessOwnerSessionEpoch = 0) | (ownerRequestSequence = 0) |
		(admissionToken = 0) | (ownerGeneration = 0) |
		(Ds402HomeState[125] <> 2) then
		Ds402HomeState[92] := 101;
		RETURN;
	end_if;
	serviceNow := ops.tAbsolute;
	serviceStart := Ds402HomeState[118]$UDINT;
	cleanupStart := Ds402HomeState[119]$UDINT;
	currentCycle := Ds402HomeState[110]$UDINT;
	previousCycle := currentCycle;
	statusWord := Ds402HomeState[114]$UDINT;
	actualPosition := Ds402HomeState[115];
	preemptionCleanup := FALSE;
	if preemptionResult <> 0 then
		preemptionSnapshotValid :=
			(preemptionSnapshot[0]$UDINT =
			 LMC_DIAG_PREEMPT_SNAPSHOT_MAGIC) &
			(preemptionSnapshot[4]$UDINT =
			 LMC_DIAG_PREEMPT_SNAPSHOT_VERSION) &
			(preemptionSnapshot[8]$UDINT =
			 LMC_DIAG_PREEMPT_SNAPSHOT_HEADER_SIZE) &
			(preemptionSnapshot[12]$UDINT =
			 LMC_DIAG_PREEMPT_SNAPSHOT_TOTAL_SIZE) &
			(preemptionSnapshot[16]$DINT = preemptionResult) &
			(preemptionSnapshot[32]$UDINT = axisMask) &
			(preemptionSnapshot[36]$UDINT = admissionToken) &
			(preemptionSnapshot[40]$UDINT = ownerGeneration) &
			(preemptionSnapshot[44]$UDINT =
			 ds402ProcessOwnerSessionEpoch) &
			(preemptionSnapshot[48]$UDINT = ownerRequestSequence) &
			(preemptionSnapshot[52]$UDINT = 0x7D15) &
			(preemptionSnapshot[56]$UDINT = TO_UDINT(axisReference)) &
			(preemptionSnapshot[60]$UDINT =
			 LMC_DIAG_OWNER_KIND_DS402_HOME) &
			(preemptionSnapshot[64]$UDINT =
			 LMC_DIAG_RESOURCE_DS402_HOME) &
			(preemptionSnapshot[68]$UDINT =
			 LMC_DIAG_ADMISSION_LIFECYCLE) &
			(Ds402HomeState[recordBase] = 1) &
			(Ds402HomeState[101]$UDINT <> 0) &
			(((stage >= 1) & (stage <= 34)) |
			 ((stage >= 90) & (stage <= 101))) &
			(preemptionSnapshot[72]$UDINT =
			 LMC_DIAG_OWNER_STATE_DS402_HOME_ACTIVE) &
			(preemptionSnapshot[76]$UDINT = 72) &
			((preemptionSnapshot[104]$UDINT and axisMask) = axisMask) &
			(preemptionSnapshot[108]$UDINT <> 0) &
			(preemptionSnapshot[112]$UDINT <> 0) &
			((preemptionSnapshot[124]$UDINT =
			  LMC_DIAG_OWNER_STATE_SAFETY_PREEMPTING) |
			 (preemptionSnapshot[124]$UDINT =
			  LMC_DIAG_OWNER_STATE_QUARANTINED)) &
			(preemptionSnapshot[136]$UDINT =
			 LMC_DIAG_ADMISSION_SAFETY) &
			(preemptionSnapshot[144]$UINT = LMC_DIAG_SCHEMA_VERSION) &
			(preemptionSnapshot[146]$UINT = 0) &
			(preemptionSnapshot[148]$UDINT =
			 Ds402HomeState[recordBase + 4]$UDINT) &
			(preemptionSnapshot[152]$UDINT =
			 Ds402HomeState[recordBase + 1]$UDINT) &
			(preemptionSnapshot[156]$UDINT =
			 Ds402HomeState[recordBase + 2]$UDINT) &
			(preemptionSnapshot[160]$UDINT =
			 Ds402HomeState[recordBase + 3]$UDINT) &
			(preemptionSnapshot[164]$UDINT =
			 Ds402HomeState[recordBase + 5]$UDINT) &
			(preemptionSnapshot[168]$UDINT =
			 Ds402HomeState[recordBase + 6]$UDINT) &
			(preemptionSnapshot[172]$UDINT =
			 Ds402HomeState[recordBase + 7]$UDINT) &
			(preemptionSnapshot[176]$UDINT =
			 Ds402HomeState[recordBase + 8]$UDINT) &
			(preemptionSnapshot[180]$DINT =
			 Ds402HomeState[recordBase + 9]) &
			(preemptionSnapshot[184]$DINT =
			 Ds402HomeState[recordBase + 10]) &
			(preemptionSnapshot[188]$DINT =
			 Ds402HomeState[recordBase + 11]) &
			(preemptionSnapshot[192]$DINT =
			 Ds402HomeState[recordBase + 12]) &
			(preemptionSnapshot[196]$DINT = 0) &
			(preemptionSnapshot[200]$DINT = 0) &
			(preemptionSnapshot[204]$UINT = 1) &
			(preemptionSnapshot[206]$UINT = 0) &
			(preemptionSnapshot[208]$UDINT =
			 Ds402HomeState[recordBase + 13]$UDINT) &
			(preemptionSnapshot[212]$UDINT = 0x32303448);
		if preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_REQUIRED then
			preemptionSnapshotValid := preemptionSnapshotValid &
				((preemptionSnapshot[24]$UDINT and axisMask) = axisMask) &
				((preemptionSnapshot[28]$UDINT and axisMask) = 0) &
				(preemptionSnapshot[124]$UDINT <>
				 LMC_DIAG_OWNER_STATE_RESERVED);
		elsif preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_COMPLETE then
			preemptionSnapshotValid := preemptionSnapshotValid &
				((preemptionSnapshot[28]$UDINT and axisMask) = axisMask);
		end_if;
		if preemptionSnapshotValid = FALSE then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		if preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_COMPLETE then
			if currentCycle < Ds402HomeState[recordBase + 19]$UDINT then
				currentCycle := Ds402HomeState[recordBase + 19]$UDINT;
			end_if;
			Ds402HomeState[recordBase + 14] := 1;
			Ds402HomeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			Ds402HomeState[recordBase + 16] := 31;
			Ds402HomeState[recordBase + 20] := currentCycle$DINT;
			Ds402HomeState[recordBase + 21] := 0;
			Ds402HomeState[101] := 0;
			Ds402HomeState[recordBase] := 4;
			Ds402HomeState[92] := 0;
			RETURN;
		elsif preemptionResult =
			LMC_DIAG_PREEMPT_CLEANUP_QUARANTINED then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		safetyAdmissionToken := preemptionSnapshot[108]$UDINT;
		safetyOwnerGeneration := preemptionSnapshot[112]$UDINT;
		preemptionCleanup := TRUE;
	end_if;
	snapshotValid := FALSE;
	newCycle := FALSE;
	copyResult := -1;
	if IsClientConnected(#InputLatch) then
		copyResult := InputLatch.CopySnapshot(
			pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
	end_if;
	if (copyResult = 0) & (snapshot[0]$UDINT <> 0) then
		snapshotValid := TRUE;
		currentCycle := snapshot[0]$UDINT;
		newCycle := currentCycle <> previousCycle;
		healthOffset := 64 + TO_UDINT(activeIndex) * 36;
		valueOffset := 208 + TO_UDINT(activeIndex) * 24;
		statusWord := snapshot[TO_DINT(valueOffset + 20)]$UDINT;
		baseState := statusWord and 0x006F;
		actualPosition := snapshot[TO_DINT(valueOffset + 12)]$DINT;
		Ds402HomeState[recordBase + 17] := statusWord$DINT;
		Ds402HomeState[recordBase + 18] := actualPosition;
		Ds402HomeState[114] := statusWord$DINT;
		Ds402HomeState[115] := actualPosition;
		if newCycle then
			Ds402HomeState[110] := currentCycle$DINT;
		end_if;
	end_if;

	failure := FALSE;
	failureDetail := 30;
	failureNative := 0;
	if preemptionCleanup & (stage < 90) then
		// Skip every normal Home transition and enter only owner cleanup.
		failure := TRUE;
		failureDetail := 31;
		failureNative := preemptionSnapshot[116]$UDINT;
	elsif stage < 90 then
		if LMC_DIAG_DS402_HOME_ENABLED = FALSE then
			failure := TRUE;
			failureNative := 10;
		elsif (Ds402HomeState[recordBase] <> 1) |
			(Ds402HomeState[recordBase + 2]$UDINT <> GetDiagnosticsBootId()) |
			(Ds402HomeState[recordBase + 3]$UDINT <> LMC_DIAG_MAP_REVISION) then
			failure := TRUE;
			failureNative := 17;
		elsif snapshotValid = FALSE then
			failure := TRUE;
			failureNative := 11;
		elsif (snapshot[12]$UDINT <> 8) | (snapshot[16]$UDINT <> 0) |
			((snapshot[40]$UDINT and 3) <> 1) |
			(snapshot[TO_DINT(healthOffset)]$DINT = 0) |
			(snapshot[TO_DINT(healthOffset + 4)]$UDINT <> 8) |
			(snapshot[TO_DINT(healthOffset + 12)]$UDINT <> 0) |
			(snapshot[TO_DINT(healthOffset + 16)]$UDINT = 0xFFFFFFFF) |
			(snapshot[TO_DINT(healthOffset + 24)]$DINT <> 0) |
			(snapshot[TO_DINT(healthOffset + 28)]$UDINT <> currentCycle) |
			((statusWord and 0x0008) <> 0) |
			((baseState <> 0x0040) & (baseState <> 0x0021) &
			 (baseState <> 0x0023) & (baseState <> 0x0027)) then
			failure := TRUE;
			failureNative := 19;
		end_if;
		startCycle := Ds402HomeState[recordBase + 19]$UDINT;
		timeoutMs := Ds402HomeState[recordBase + 13]$UDINT;
		if (serviceNow - serviceStart) >= timeoutMs then
			failure := TRUE;
			failureNative := LMC_DIAG_SDO_ABORT_TIMEOUT;
		end_if;
	end_if;

	if (failure = FALSE) & (stage < 90) then
		case stage of
			1:
				if newCycle then
					if ((statusWord and 0x0008) <> 0) |
						((baseState <> 0x0040) & (baseState <> 0x0021) &
						 (baseState <> 0x0023) & (baseState <> 0x0027)) then
						failure := TRUE;
						failureNative := 10;
					elsif actualPosition = Ds402HomeState[102] then
						Ds402HomeState[103] += 1;
					else
						Ds402HomeState[102] := actualPosition;
						Ds402HomeState[103] := 1;
					end_if;
					if Ds402HomeState[103] >= 3 then
						Ds402HomeState[92] := 2;
					end_if;
				end_if;

			14:
				mailboxResult := InputLatch.SubmitDs402HomeControl(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference, Command:=1);
				if mailboxResult = 0 then
					// Runtime slot 117 means the RT control-word owner may be held.
					Ds402HomeState[117] := 1;
					Ds402HomeState[92] := 16;
				elsif mailboxResult = 1 then
					Ds402HomeState[117] := 1;
					Ds402HomeState[92] := 15;
				else
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			15:
				mailboxResult := InputLatch.GetDs402HomeControlState(
					OperationToken:=Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[117] := 1;
					Ds402HomeState[92] := 16;
				elsif mailboxResult <> 1 then
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			20:
				if newCycle then
					if (statusWord and 0x3000) = 0 then
						Ds402HomeState[111] := 1;
						Ds402HomeState[92] := 21;
					else
						failure := TRUE;
						failureNative := statusWord;
					end_if;
				end_if;

			21:
				mailboxResult := InputLatch.SubmitDs402HomeControl(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference, Command:=2);
				if mailboxResult = 0 then
					Ds402HomeState[104] := currentCycle$DINT;
					Ds402HomeState[102] := actualPosition;
					Ds402HomeState[103] := 0;
					Ds402HomeState[92] := 23;
				elsif mailboxResult = 1 then
					// Once SetHigh is queued, the drive coordinate may change before
					// its result is observed. Cleanup must therefore require alignment.
					Ds402HomeState[104] := currentCycle$DINT;
					Ds402HomeState[102] := actualPosition;
					Ds402HomeState[103] := 0;
					Ds402HomeState[92] := 22;
				else
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			22:
				mailboxResult := InputLatch.GetDs402HomeControlState(
					OperationToken:=Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[104] := currentCycle$DINT;
					Ds402HomeState[92] := 23;
				elsif mailboxResult <> 1 then
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			23:
				if newCycle then
					if (statusWord and 0x2000) <> 0 then
						failure := TRUE;
						failureNative := statusWord;
					elsif (Ds402HomeState[111] <> 0) &
						((statusWord and 0x1000) <> 0) &
						((statusWord and 0x0400) <> 0) then
						if actualPosition = Ds402HomeState[recordBase + 10] then
							if actualPosition = Ds402HomeState[102] then
								Ds402HomeState[103] += 1;
							else
								Ds402HomeState[102] := actualPosition;
								Ds402HomeState[103] := 1;
							end_if;
							if Ds402HomeState[103] >= 3 then
								Ds402HomeState[92] := 24;
							end_if;
						else
							Ds402HomeState[103] := 0;
						end_if;
					else
						Ds402HomeState[103] := 0;
					end_if;
				end_if;

			24:
				mailboxResult := InputLatch.SubmitDs402HomeControl(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference, Command:=3);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 26;
				elsif mailboxResult = 1 then
					Ds402HomeState[92] := 25;
				else
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			25:
				mailboxResult := InputLatch.GetDs402HomeControlState(
					OperationToken:=Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 26;
				elsif mailboxResult <> 1 then
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			26:
				mailboxResult := InputLatch.SubmitDs402HomeSetpointAlignment(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference,
					ActualPosition:=actualPosition);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 28;
				elsif mailboxResult = 1 then
					Ds402HomeState[92] := 27;
				else
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			27:
				mailboxResult := InputLatch.GetDs402HomeControlState(
					OperationToken:=Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 28;
				elsif mailboxResult <> 1 then
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			32:
				mailboxResult := InputLatch.SubmitDs402HomeControl(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference, Command:=4);
				if mailboxResult = 0 then
					Ds402HomeState[117] := 0;
					Ds402HomeState[112] := currentCycle$DINT;
					Ds402HomeState[92] := 34;
				elsif mailboxResult = 1 then
					Ds402HomeState[92] := 33;
				else
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			33:
				mailboxResult := InputLatch.GetDs402HomeControlState(
					OperationToken:=Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[117] := 0;
					Ds402HomeState[112] := currentCycle$DINT;
					Ds402HomeState[92] := 34;
				elsif mailboxResult <> 1 then
					failure := TRUE;
					failureDetail := 11;
					failureNative := TO_UDINT(0 - mailboxResult);
				end_if;

			34:
				if newCycle &
					(currentCycle <> Ds402HomeState[112]$UDINT) then
					if (Ds402HomeState[94] <> 0) |
						(Ds402HomeState[113] <> 0) |
						(Ds402HomeState[116] <> 0) |
						(Ds402HomeState[117] <> 0) |
						(Ds402HomeState[127] <> 0) |
						((statusWord and 0x0008) <> 0) |
						((statusWord and 0x2000) <> 0) |
						((baseState <> 0x0040) & (baseState <> 0x0021) &
						 (baseState <> 0x0023) & (baseState <> 0x0027)) |
						(actualPosition <> 0) then
						failure := TRUE;
						failureNative := 24;
					else
						Ds402HomeState[106] := 2;
						Ds402HomeState[107] := 0;
						Ds402HomeState[108] := 0;
						Ds402HomeState[recordBase + 14] := 0;
						Ds402HomeState[recordBase + 15] := 0;
						Ds402HomeState[recordBase + 16] := 0;
						Ds402HomeState[recordBase + 20] := currentCycle$DINT;
						Ds402HomeState[recordBase + 21] := 0;
						ownerResult := -1;
						if IsClientConnected(#AxisOwnership) then
							ownerResult :=
								AxisOwnership.PublishAxisOwnershipDs402Receipt(
								AxisMask:=axisMask,
								AdmissionToken:=admissionToken,
								OwnerGeneration:=ownerGeneration,
								ReportKind:=
									LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS,
								ReportValue0:=0,
								ReportValue1:=0,
								ObservationCycle:=currentCycle,
								pDs402State:=#Ds402HomeState[0],
								Ds402StateSize:=sizeof(Ds402HomeState));
						end_if;
						if ownerResult = 0 then
							Ds402HomeState[125] := 2;
							ownerResult :=
								AxisOwnership.PublishAxisOwnershipDs402Receipt(
									AxisMask:=axisMask,
									AdmissionToken:=admissionToken,
									OwnerGeneration:=ownerGeneration,
									ReportKind:=
										LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS,
									ReportValue0:=0,
									ReportValue1:=0,
									ObservationCycle:=currentCycle,
									pDs402State:=#Ds402HomeState[0],
									Ds402StateSize:=sizeof(Ds402HomeState));
							if ownerResult = 1 then
								Ds402HomeState[92] :=
									LMC_DIAG_DS402_STAGE_FINALIZE;
							elsif ownerResult <> 0 then
								Ds402HomeState[92] := 101;
							end_if;
							RETURN;
						elsif ownerResult = 1 then
							Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
							RETURN;
						else
							Ds402HomeState[92] := 101;
						end_if;
					end_if;
				end_if;
		end_case;
	end_if;

	// SDO start stages use one persistent executor at a time.
	stage := Ds402HomeState[92];
	startSdo := FALSE;
	sdoIsWrite := FALSE;
	sdoIndex := 0;
	homeSdoSubIndex := 0;
	sdoLength := 0;
	sdoData := 0;
	nextStage := stage;
	if (failure = FALSE) & (stage < 90) then
		case stage of
			2:
				startSdo := TRUE; sdoIndex := 0x6061;
				sdoLength := 1; nextStage := 3;
			4:
				startSdo := TRUE; sdoIsWrite := TRUE; sdoIndex := 0x607C;
				sdoLength := 4; sdoData := Ds402HomeState[recordBase + 10]$UDINT;
				nextStage := 5;
			6:
				startSdo := TRUE; sdoIsWrite := TRUE; sdoIndex := 0x6098;
				sdoLength := 1; sdoData := Ds402HomeState[recordBase + 9]$UDINT;
				nextStage := 7;
			16:
				startSdo := TRUE; sdoIsWrite := TRUE; sdoIndex := 0x6060;
				sdoLength := 1; sdoData := 6; nextStage := 17;
			18:
				startSdo := TRUE; sdoIndex := 0x6061;
				sdoLength := 1; nextStage := 19;
			28:
				startSdo := TRUE; sdoIsWrite := TRUE; sdoIndex := 0x6060;
				sdoLength := 1; sdoData := 8; nextStage := 29;
			30:
				startSdo := TRUE; sdoIndex := 0x6061;
				sdoLength := 1; nextStage := 31;
		end_case;
	end_if;

	if startSdo then
		if IsClientConnected(#AxisOwnership) = FALSE then
			failure := TRUE;
			failureNative := 24;
		else
			ownerResult := AxisOwnership.ValidateAxisOwnership(
				CommandId:=0x7D15,
				Reference:=axisReference,
				ExpectedAxisMask:=axisMask,
				OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
				ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
				AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
				CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
				RequestSequence:=ownerRequestSequence,
				AdmissionToken:=admissionToken,
				OwnerGeneration:=ownerGeneration,
				RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
			if ownerResult <> 0 then
				failure := TRUE;
				failureNative := TO_UDINT(0 - ownerResult);
			elsif Ds402HomeState[126] = 0 then
					ownerResult := AxisOwnership.PublishAxisOwnership(
						AxisMask:=axisMask,
						AdmissionToken:=admissionToken,
						OwnerGeneration:=ownerGeneration,
						ReportKind:=LMC_DIAG_OWNER_REPORT_DISPATCH,
						ReportValue0:=TO_UDINT(sdoIndex),
						ReportValue1:=Ds402HomeState[101]$UDINT,
						ObservationCycle:=currentCycle);
				if ownerResult = 0 then
					Ds402HomeState[126] := 1;
				else
					failure := TRUE;
					failureNative := TO_UDINT(0 - ownerResult);
				end_if;
			end_if;
		end_if;
	end_if;

	if startSdo & (failure = FALSE) then
		executorConnected := FALSE;
		executorReusable := FALSE;
		case axisReference of
			1:
				executorConnected := IsClientConnected(#SdoAxis1) <> 0;
				if executorConnected then
					executorReusable := SdoAxis1.IsReusable();
				end_if;
			2:
				executorConnected := IsClientConnected(#SdoAxis2) <> 0;
				if executorConnected then
					executorReusable := SdoAxis2.IsReusable();
				end_if;
			3:
				executorConnected := IsClientConnected(#SdoAxis3) <> 0;
				if executorConnected then
					executorReusable := SdoAxis3.IsReusable();
				end_if;
			4:
				executorConnected := IsClientConnected(#SdoAxis4) <> 0;
				if executorConnected then
					executorReusable := SdoAxis4.IsReusable();
				end_if;
		end_case;
		if (executorConnected = FALSE) | (executorReusable = FALSE) then
			failure := TRUE;
			failureNative := 24;
		else
			sdoToken := Ds402HomeState[99]$UDINT + 1;
			if sdoToken = 0 then
				sdoToken := 1;
			end_if;
			Ds402HomeState[99] := sdoToken$DINT;
			Ds402HomeState[95] := 0;
			if sdoIsWrite then
				Ds402HomeState[95] := 1;
			end_if;
			Ds402HomeState[96] := sdoIndex$DINT;
			Ds402HomeState[97] := homeSdoSubIndex$DINT;
			Ds402HomeState[98] := sdoLength$DINT;
			Ds402HomeState[100] := sdoData$DINT;
			startCycle := Ds402HomeState[recordBase + 19]$UDINT;
			timeoutMs := Ds402HomeState[recordBase + 13]$UDINT;
			elapsedCycles := serviceNow - serviceStart;
			remainingMs := 1;
			if elapsedCycles < timeoutMs then
				remainingMs := timeoutMs - elapsedCycles;
			end_if;
			if remainingMs > 60000 then
				remainingMs := 60000;
			end_if;
			startResult := ERROR;
			case axisReference of
				1:
					if sdoIsWrite then
						startResult := SdoAxis1.TryStartWrite(sdoToken, sdoIndex,
							homeSdoSubIndex, (#sdoData)$^USINT, sdoLength, remainingMs);
					else
						startResult := SdoAxis1.TryStartRead(sdoToken, sdoIndex,
							homeSdoSubIndex, sdoLength, remainingMs);
					end_if;
				2:
					if sdoIsWrite then
						startResult := SdoAxis2.TryStartWrite(sdoToken, sdoIndex,
							homeSdoSubIndex, (#sdoData)$^USINT, sdoLength, remainingMs);
					else
						startResult := SdoAxis2.TryStartRead(sdoToken, sdoIndex,
							homeSdoSubIndex, sdoLength, remainingMs);
					end_if;
				3:
					if sdoIsWrite then
						startResult := SdoAxis3.TryStartWrite(sdoToken, sdoIndex,
							homeSdoSubIndex, (#sdoData)$^USINT, sdoLength, remainingMs);
					else
						startResult := SdoAxis3.TryStartRead(sdoToken, sdoIndex,
							homeSdoSubIndex, sdoLength, remainingMs);
					end_if;
				4:
					if sdoIsWrite then
						startResult := SdoAxis4.TryStartWrite(sdoToken, sdoIndex,
							homeSdoSubIndex, (#sdoData)$^USINT, sdoLength, remainingMs);
					else
						startResult := SdoAxis4.TryStartRead(sdoToken, sdoIndex,
							homeSdoSubIndex, sdoLength, remainingMs);
					end_if;
			end_case;
			if startResult = READY then
				// Once the mode-6 write is accepted, cleanup must assume it may
				// have reached the drive even if its callback is later lost.
				if stage = 16 then
					Ds402HomeState[116] := 1;
				end_if;
				Ds402HomeState[94] := 1;
				Ds402HomeState[92] := nextStage;
			else
				failure := TRUE;
				failureNative := 24;
			end_if;
		end_if;
	end_if;

	stage := Ds402HomeState[92];
	waitSdo := (stage = 3) | (stage = 5) | (stage = 7) |
		(stage = 17) | (stage = 19) | (stage = 29) | (stage = 31);
	if (failure = FALSE) & waitSdo then
		completionResult := -2;
		case axisReference of
			1:
				if IsClientConnected(#SdoAxis1) then
					completionResult := SdoAxis1.CopyCompletion(
						Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
				end_if;
			2:
				if IsClientConnected(#SdoAxis2) then
					completionResult := SdoAxis2.CopyCompletion(
						Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
				end_if;
			3:
				if IsClientConnected(#SdoAxis3) then
					completionResult := SdoAxis3.CopyCompletion(
						Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
				end_if;
			4:
				if IsClientConnected(#SdoAxis4) then
					completionResult := SdoAxis4.CopyCompletion(
						Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
				end_if;
		end_case;
		if completionResult = 0 then
			Ds402HomeState[94] := 0;
			if (completion.ValidationCode <> 0) | (completion.OsResult <> 0) |
				(completion.AbortCode <> 0) |
				(completion.ObjectIndex <> Ds402HomeState[96]$UINT) |
				(completion.SubIndex <> Ds402HomeState[97]$USINT) |
				(completion.ActualLength <> Ds402HomeState[98]$UDINT) |
				(completion.IsWrite <> Ds402HomeState[95]$USINT) then
				failure := TRUE;
				if completion.AbortCode <> 0 then
					failureNative := completion.AbortCode;
				elsif completion.OsResult <> 0 then
					failureNative := completion.OsResult$UDINT;
				else
					failureNative := completion.ValidationCode;
				end_if;
			else
				case stage of
					3:
						if (completion.Data and 0xFF) <> 8 then
							failure := TRUE; failureNative := completion.Data;
						else
							Ds402HomeState[105] := 8; Ds402HomeState[92] := 4;
						end_if;
					5: Ds402HomeState[92] := 6;
					7: Ds402HomeState[92] := 14;
					17:
						Ds402HomeState[116] := 1; Ds402HomeState[92] := 18;
					19:
						if (completion.Data and 0xFF) <> 6 then
							failure := TRUE; failureNative := completion.Data;
						else
							Ds402HomeState[92] := 20;
						end_if;
					29: Ds402HomeState[92] := 30;
					31:
						if (completion.Data and 0xFF) <> 8 then
							failure := TRUE; failureNative := completion.Data;
						else
							Ds402HomeState[116] := 0; Ds402HomeState[92] := 32;
						end_if;
				end_case;
			end_if;
		elsif (completionResult <> -2) & (completionResult <> -3) then
			failure := TRUE;
			failureNative := TO_UDINT(0 - completionResult);
		end_if;
	end_if;

	if failure then
		if Ds402HomeState[94] <> 0 then
			orphanResult := -1;
			case axisReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						orphanResult := SdoAxis1.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						orphanResult := SdoAxis2.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						orphanResult := SdoAxis3.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						orphanResult := SdoAxis4.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
			end_case;
			// -2 can mean that the exact result won the timeout race. Keep the
			// executor in the cleanup drain path so a ready result is consumed.
			if (orphanResult = 0) | (orphanResult = -2) then
				Ds402HomeState[94] := 0;
				Ds402HomeState[113] := 1;
				Ds402HomeState[127] := 0;
			else
				// Keep the pending token and remember that exact retirement failed.
				Ds402HomeState[127] := 1;
			end_if;
		end_if;
		if preemptionCleanup then
			Ds402HomeState[106] := 4;
		else
			Ds402HomeState[106] := 3;
		end_if;
		Ds402HomeState[107] := failureDetail$DINT;
		Ds402HomeState[108] := failureNative$DINT;
		Ds402HomeState[112] := currentCycle$DINT;
		Ds402HomeState[119]$UDINT := serviceNow;
		Ds402HomeState[92] := 90;
		RETURN;
	end_if;

	// Failure cleanup attempts bit 4 low, setpoint alignment, CSP restore and RT
	// release. Timeout never claims that any of those cleanup steps completed.
	stage := Ds402HomeState[92];
	if stage < 90 then
		RETURN;
	end_if;
	if preemptionCleanup then
		HandleAxisDs402HomeCleanupStages(
			Stage:=stage,
			AxisReference:=axisReference,
			AxisMask:=axisMask,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			Ds402ProcessOwnerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
			OwnerRequestSequence:=ownerRequestSequence,
			SafetyAdmissionToken:=safetyAdmissionToken,
			SafetyOwnerGeneration:=safetyOwnerGeneration,
			InitialCurrentCycle:=currentCycle,
			ServiceNow:=serviceNow,
			ActualPosition:=actualPosition,
			PreemptionCleanup:=TRUE);
	else
		HandleAxisDs402HomeCleanupStages(
			Stage:=stage,
			AxisReference:=axisReference,
			AxisMask:=axisMask,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			Ds402ProcessOwnerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
			OwnerRequestSequence:=ownerRequestSequence,
			SafetyAdmissionToken:=0,
			SafetyOwnerGeneration:=0,
			InitialCurrentCycle:=currentCycle,
			ServiceNow:=serviceNow,
			ActualPosition:=actualPosition,
			PreemptionCleanup:=FALSE);
	end_if;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisDs402HomeReceiptStages
	VAR_INPUT
		Stage 	: DINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		activeIndex, recordBase : DINT;
		axisReference : UINT;
		axisMask, admissionToken, ownerGeneration : UDINT;
		ds402ProcessOwnerSessionEpoch, ownerRequestSequence : UDINT;
		receiptGeneration : UDINT;
		ownerResult, receiptResult, receiptKind, receiptPhase : DINT;
		terminalRecordState : DINT;
	END_VAR

	Result := 1;
	if stage = LMC_DIAG_DS402_STAGE_INTENT_DISCARD_CLEAR then
		activeIndex := Ds402HomeState[93];
		if (activeIndex < 0) | (activeIndex > 3) |
			(sizeof(Ds402HomeState) <> 512) then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		recordBase := activeIndex * 23;
		// Stage 86 keeps the axis selector authoritative until this idempotent
		// record clear is complete. Runtime WAL bytes remain invalid under stage 0
		// and are replaced by the next preflight.
		_memset(dest:=#Ds402HomeState[recordBase], usByte:=0, cntr:=92);
		Ds402HomeState[92] := 0;
		RETURN;
	end_if;
	if stage = LMC_DIAG_DS402_STAGE_RESERVE_INTENT then
		activeIndex := Ds402HomeState[93];
		if (activeIndex < 0) | (activeIndex > 3) |
			(sizeof(Ds402HomeState) <> 512) then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		recordBase := activeIndex * 23;
		axisMask := TO_UDINT(1) shl TO_UDINT(activeIndex);
		if IsClientConnected(#AxisOwnership) = FALSE then
			RETURN;
		end_if;
		// Tokenless mode is confined to stage 87 rollback resolution. The
		// provider either adopts one exact RESERVED tuple, proves absence/later
		// ownership, or leaves the intent fail-closed.
		receiptResult := AxisOwnership.PublishAxisOwnershipDs402Receipt(
			AxisMask:=axisMask,
			AdmissionToken:=0,
			OwnerGeneration:=0,
			ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
			ReportValue0:=0,
			ReportValue1:=0,
			ObservationCycle:=Ds402HomeState[118]$UDINT,
			pDs402State:=#Ds402HomeState[0],
			Ds402StateSize:=sizeof(Ds402HomeState));
		if receiptResult = 1 then
			// Commit record cleanup before touching any selector or WAL byte.
			Ds402HomeState[92] :=
				LMC_DIAG_DS402_STAGE_INTENT_DISCARD_CLEAR;
		elsif receiptResult = 2 then
			// Preserve only an untouched raw tombstone. Once adoption or the record
			// bridge was published, commit a durable record-clear cleanup first.
			if (Ds402HomeState[119]$UDINT =
				LMC_DIAG_DS402_INTENT_ADOPT_MAGIC) |
				(Ds402HomeState[recordBase] = 1) then
				Ds402HomeState[92] :=
					LMC_DIAG_DS402_STAGE_INTENT_DISCARD_CLEAR;
			elsif Ds402HomeState[recordBase]$UDINT <>
				Ds402HomeState[115]$UDINT then
				Ds402HomeState[92] := 101;
				RETURN;
			else
				// No local record changed. Stage 0 invalidates the retained WAL in one
				// commit; the next preflight overwrites it before reuse.
				Ds402HomeState[92] := 0;
			end_if;
		elsif receiptResult = -1 then
			// A transient result retains the durable intent indefinitely.
		elsif receiptResult <> 0 then
			Ds402HomeState[92] := 101;
		end_if;
		RETURN;
	end_if;
	if stage = 0 then
		RETURN;
	end_if;
	activeIndex := Ds402HomeState[93];
	admissionToken := Ds402HomeState[122]$UDINT;
	ownerGeneration := Ds402HomeState[123]$UDINT;
	if (activeIndex < 0) | (activeIndex > 3) |
		(sizeof(Ds402HomeState) <> 512) then
		Ds402HomeState[92] := 101;
		RETURN;
	end_if;
	recordBase := activeIndex * 23;
	axisMask := TO_UDINT(1) shl TO_UDINT(activeIndex);
	receiptPhase := Ds402HomeState[125];
	receiptGeneration := Ds402HomeState[127]$UDINT;

	if stage = LMC_DIAG_DS402_STAGE_FINALIZE then
		receiptKind := Ds402HomeState[126];
		if (Ds402HomeState[124]$UDINT <> LMC_DIAG_DS402_RECEIPT_MAGIC) |
			(receiptPhase <> LMC_DIAG_DS402_RECEIPT_COMPLETE) |
			(receiptGeneration = 0) |
			(receiptGeneration <> Ds402HomeState[109]$UDINT) |
			(admissionToken = 0) | (ownerGeneration = 0) then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		case receiptKind of
			LMC_DIAG_DS402_RECEIPT_ROLLBACK:
				if (Ds402HomeState[106] <> 0) |
					((Ds402HomeState[recordBase] <> 0) &
					 (Ds402HomeState[recordBase] <> 1)) |
					((Ds402HomeState[recordBase + 22]$UDINT <> 0) &
					 (Ds402HomeState[recordBase + 22]$UDINT <>
					  receiptGeneration)) then
					Ds402HomeState[92] := 101;
					RETURN;
				end_if;
				_memset(dest:=#Ds402HomeState[recordBase],
					usByte:=0, cntr:=92);
			LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS,
			LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE:
				terminalRecordState := Ds402HomeState[106];
				if (((receiptKind = LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS) &
					  (terminalRecordState <> 2)) |
					 ((receiptKind =
					   LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE) &
					  (terminalRecordState <> 3))) |
					(Ds402HomeState[recordBase + 22]$UDINT <>
					 receiptGeneration) |
					((Ds402HomeState[recordBase] <> 1) &
					 (Ds402HomeState[recordBase] <> terminalRecordState)) then
					Ds402HomeState[92] := 101;
					RETURN;
				end_if;
				Ds402HomeState[101] := 0;
				Ds402HomeState[recordBase] := terminalRecordState;
		else
			Ds402HomeState[92] := 101;
			RETURN;
		end_case;
		// The local lifecycle stage is the final publication word.
		Ds402HomeState[92] := 0;
		RETURN;
	end_if;

	if Ds402HomeState[124]$UDINT = LMC_DIAG_DS402_RECEIPT_MAGIC then
		if receiptGeneration = 0 then
			case stage of
				LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED:
					receiptKind := LMC_DIAG_DS402_RECEIPT_ROLLBACK;
				89: receiptKind := LMC_DIAG_DS402_RECEIPT_ROLLBACK;
				34: receiptKind := LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS;
				100: receiptKind :=
					LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE;
			else
				Ds402HomeState[92] := 101;
				RETURN;
			end_case;
		else
			receiptKind := Ds402HomeState[126];
		end_if;
		receiptResult := -1;
		if IsClientConnected(#AxisOwnership) = FALSE then
			RETURN;
		end_if;
		receiptResult := AxisOwnership.PublishAxisOwnershipDs402Receipt(
			AxisMask:=axisMask,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			ReportKind:=TO_UINT(receiptKind),
			ReportValue0:=Ds402HomeState[107]$UDINT,
			ReportValue1:=Ds402HomeState[108]$UDINT,
			ObservationCycle:=Ds402HomeState[110]$UDINT,
			pDs402State:=#Ds402HomeState[0],
			Ds402StateSize:=sizeof(Ds402HomeState));
		if receiptResult = 0 then
			if Ds402HomeState[125] = LMC_DIAG_DS402_RECEIPT_PREPARED then
				Ds402HomeState[125] := 2;
			end_if;
			if IsClientConnected(#AxisOwnership) = FALSE then
				RETURN;
			end_if;
			receiptResult :=
				AxisOwnership.PublishAxisOwnershipDs402Receipt(
					AxisMask:=axisMask,
					AdmissionToken:=admissionToken,
					OwnerGeneration:=ownerGeneration,
					ReportKind:=TO_UINT(receiptKind),
					ReportValue0:=Ds402HomeState[107]$UDINT,
					ReportValue1:=Ds402HomeState[108]$UDINT,
					ObservationCycle:=Ds402HomeState[110]$UDINT,
					pDs402State:=#Ds402HomeState[0],
					Ds402StateSize:=sizeof(Ds402HomeState));
			if receiptResult = 1 then
				Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
			elsif (receiptResult <> 0) & (receiptResult <> -1) then
				Ds402HomeState[92] := 101;
			end_if;
		elsif receiptResult = 1 then
			Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
		elsif receiptResult <> -1 then
			Ds402HomeState[92] := 101;
		end_if;
		RETURN;
	end_if;

	if stage = LMC_DIAG_DS402_STAGE_ROLLBACK_PREPARED then
		// This state is rollback-only. It must never warm-resume into Commit.
		receiptResult := -1;
		if IsClientConnected(#AxisOwnership) = FALSE then
			RETURN;
		end_if;
		receiptResult := AxisOwnership.PublishAxisOwnershipDs402Receipt(
			AxisMask:=axisMask,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
			ReportValue0:=0,
			ReportValue1:=0,
			ObservationCycle:=Ds402HomeState[110]$UDINT,
			pDs402State:=#Ds402HomeState[0],
			Ds402StateSize:=sizeof(Ds402HomeState));
		if receiptResult = 0 then
			if Ds402HomeState[125] =
				LMC_DIAG_DS402_RECEIPT_PREPARED then
				Ds402HomeState[125] := 2;
			end_if;
			if IsClientConnected(#AxisOwnership) = FALSE then
				RETURN;
			end_if;
			receiptResult :=
				AxisOwnership.PublishAxisOwnershipDs402Receipt(
					AxisMask:=axisMask,
					AdmissionToken:=admissionToken,
					OwnerGeneration:=ownerGeneration,
					ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
					ReportValue0:=0,
					ReportValue1:=0,
					ObservationCycle:=Ds402HomeState[110]$UDINT,
					pDs402State:=#Ds402HomeState[0],
					Ds402StateSize:=sizeof(Ds402HomeState));
			if receiptResult = 1 then
				Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
			elsif (receiptResult <> 0) & (receiptResult <> -1) then
				Ds402HomeState[92] := 101;
			end_if;
		elsif receiptResult = 1 then
			Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
		elsif receiptResult <> -1 then
			Ds402HomeState[92] := 101;
		end_if;
		RETURN;
	end_if;

	if stage = 101 then
		// Quarantine is terminal for this cyclic processor.
		RETURN;
	end_if;
	if stage = 89 then
		if (activeIndex < 0) | (activeIndex > 3) |
			(sizeof(Ds402HomeState) <> 512) then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		axisReference := TO_UINT(activeIndex + 1);
		recordBase := activeIndex * 23;
		axisMask := Ds402HomeState[124]$UDINT;
		ds402ProcessOwnerSessionEpoch := Ds402HomeState[120]$UDINT;
		ownerRequestSequence := Ds402HomeState[121]$UDINT;
		if (axisMask <> (TO_UDINT(1) shl TO_UDINT(activeIndex))) |
			(ds402ProcessOwnerSessionEpoch = 0) |
			(ownerRequestSequence = 0) | (admissionToken = 0) |
			(ownerGeneration = 0) |
			(Ds402HomeState[recordBase] <> 1) |
			(Ds402HomeState[recordBase + 1] <> 1) |
			(Ds402HomeState[recordBase + 2]$UDINT <>
			 GetDiagnosticsBootId()) |
			(Ds402HomeState[recordBase + 3]$UDINT <>
			 LMC_DIAG_MAP_REVISION) |
			(Ds402HomeState[recordBase + 4] = 0) |
			((Ds402HomeState[recordBase + 5] = 0) &
			 (Ds402HomeState[recordBase + 6] = 0) &
			 (Ds402HomeState[recordBase + 7] = 0) &
			 (Ds402HomeState[recordBase + 8] = 0)) |
			(Ds402HomeState[recordBase + 9] <> 37) |
			(Ds402HomeState[recordBase + 10] <> 0) |
			(Ds402HomeState[recordBase + 11] <> 0) |
			(Ds402HomeState[recordBase + 12] <> 0) |
			(Ds402HomeState[recordBase + 13] = 0) |
			(Ds402HomeState[recordBase + 14] <> 0) |
			(Ds402HomeState[recordBase + 15] <> 0) |
			(Ds402HomeState[recordBase + 16] <> 0) |
			(Ds402HomeState[recordBase + 19] = 0) |
			(Ds402HomeState[recordBase + 20] <> 0) |
			(Ds402HomeState[recordBase + 21] <> 0) |
			(Ds402HomeState[recordBase + 22] = 0) |
			(Ds402HomeState[94] <> 0) |
			(Ds402HomeState[95] <> 0) |
			(Ds402HomeState[96] <> 0) |
			(Ds402HomeState[97] <> 0) |
			(Ds402HomeState[98] <> 0) |
			(Ds402HomeState[100] <> 0) |
			(Ds402HomeState[109] <>
			 Ds402HomeState[recordBase + 22]) |
			(Ds402HomeState[99] <>
			 Ds402HomeState[recordBase + 22]) |
			(Ds402HomeState[101] <>
			 Ds402HomeState[recordBase + 22]) |
			(Ds402HomeState[102] <>
			 Ds402HomeState[recordBase + 18]) |
			(Ds402HomeState[103] <> 1) |
			(Ds402HomeState[104] <> 0) |
			(Ds402HomeState[105] <> 8) |
			(Ds402HomeState[106] <> 0) |
			(Ds402HomeState[107] <> 0) |
			(Ds402HomeState[108] <> 0) |
			(Ds402HomeState[110] <>
			 Ds402HomeState[recordBase + 19]) |
			(Ds402HomeState[111] <> 0) |
			(Ds402HomeState[112] <> 0) |
			(Ds402HomeState[113] <> 0) |
			(Ds402HomeState[114] <>
			 Ds402HomeState[recordBase + 17]) |
			(Ds402HomeState[115] <>
			 Ds402HomeState[recordBase + 18]) |
			(Ds402HomeState[116] <> 0) |
			(Ds402HomeState[117] <> 0) |
			(Ds402HomeState[119] <> 0) |
			(Ds402HomeState[126] <> 0) |
			(Ds402HomeState[127] <> 0) |
			((Ds402HomeState[125] <> 1) &
			 (Ds402HomeState[125] <> 2)) then
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		if IsClientConnected(#AxisOwnership) = FALSE then
			RETURN;
		end_if;

		// Commit may already have completed before the local phase was advanced.
		ownerResult := AxisOwnership.ValidateAxisOwnership(
			CommandId:=0x7D15,
			Reference:=axisReference,
			ExpectedAxisMask:=axisMask,
			OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
			ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
			AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
			CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
			RequestSequence:=ownerRequestSequence,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
		if ownerResult = 0 then
			Ds402HomeState[125] := 2;
			Ds402HomeState[92] := 1;
			RETURN;
		end_if;

		ownerResult := AxisOwnership.ValidateAxisOwnership(
			CommandId:=0x7D15,
			Reference:=axisReference,
			ExpectedAxisMask:=axisMask,
			OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
			ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
			AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
			CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
			RequestSequence:=ownerRequestSequence,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			RequiredPhase:=LMC_DIAG_OWNER_PHASE_RESERVED);
		if (ownerResult = 0) & (Ds402HomeState[125] = 1) then
			ownerResult := AxisOwnership.CommitAxisOwnership(
				CommandId:=0x7D15,
				Reference:=axisReference,
				ExpectedAxisMask:=axisMask,
				CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
				RequestSequence:=ownerRequestSequence,
				AdmissionToken:=admissionToken,
				OwnerGeneration:=ownerGeneration);
			if ownerResult = 0 then
				Ds402HomeState[125] := 2;
				Ds402HomeState[92] := 1;
				RETURN;
			end_if;
			ownerResult := AxisOwnership.ValidateAxisOwnership(
				CommandId:=0x7D15,
				Reference:=axisReference,
				ExpectedAxisMask:=axisMask,
				OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
				ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
				AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
				CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
				RequestSequence:=ownerRequestSequence,
				AdmissionToken:=admissionToken,
				OwnerGeneration:=ownerGeneration,
				RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
			if ownerResult = 0 then
				Ds402HomeState[125] := 2;
				Ds402HomeState[92] := 1;
				RETURN;
			end_if;
		end_if;

		receiptResult := AxisOwnership.PublishAxisOwnershipDs402Receipt(
			AxisMask:=axisMask,
			AdmissionToken:=admissionToken,
			OwnerGeneration:=ownerGeneration,
			ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
			ReportValue0:=0,
			ReportValue1:=0,
			ObservationCycle:=Ds402HomeState[110]$UDINT,
			pDs402State:=#Ds402HomeState[0],
			Ds402StateSize:=sizeof(Ds402HomeState));
		if receiptResult = 0 then
			if Ds402HomeState[125] =
				LMC_DIAG_DS402_RECEIPT_PREPARED then
				Ds402HomeState[125] := 2;
			end_if;
			receiptResult := AxisOwnership.PublishAxisOwnershipDs402Receipt(
				AxisMask:=axisMask,
				AdmissionToken:=admissionToken,
				OwnerGeneration:=ownerGeneration,
				ReportKind:=LMC_DIAG_DS402_RECEIPT_ROLLBACK,
				ReportValue0:=0,
				ReportValue1:=0,
				ObservationCycle:=Ds402HomeState[110]$UDINT,
				pDs402State:=#Ds402HomeState[0],
				Ds402StateSize:=sizeof(Ds402HomeState));
			if receiptResult = 1 then
				Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
			elsif (receiptResult <> 0) & (receiptResult <> -1) then
				Ds402HomeState[92] := 101;
			end_if;
		elsif receiptResult = 1 then
			Ds402HomeState[92] := LMC_DIAG_DS402_STAGE_FINALIZE;
		elsif receiptResult <> -1 then
			Ds402HomeState[92] := 101;
		end_if;
		RETURN;
	end_if;
	Result := 0;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisDs402HomeCleanupStages
	VAR_INPUT
		Stage 	: DINT;
		AxisReference 	: UINT;
		AxisMask 	: UDINT;
		AdmissionToken 	: UDINT;
		OwnerGeneration 	: UDINT;
		Ds402ProcessOwnerSessionEpoch 	: UDINT;
		OwnerRequestSequence 	: UDINT;
		SafetyAdmissionToken 	: UDINT;
		SafetyOwnerGeneration 	: UDINT;
		InitialCurrentCycle 	: UDINT;
		ServiceNow 	: UDINT;
		ActualPosition 	: DINT;
		PreemptionCleanup 	: BOOL;
	END_VAR
	VAR
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		recordBase : DINT;
		preemptionCleanupKind : UINT;
		currentCycle, cleanupStart, sdoToken, sdoData : UDINT;
		completionResult, mailboxResult, orphanResult, ownerResult : DINT;
		startResult : iprStates;
		executorConnected, executorReusable, cleanupExpired : BOOL;
	END_VAR

	currentCycle := InitialCurrentCycle;
	recordBase := TO_DINT(AxisReference - 1) * 23;
	cleanupStart := Ds402HomeState[119]$UDINT;
	cleanupExpired := (cleanupStart <> 0) & (stage >= 90) & (stage <= 99) &
		((serviceNow - cleanupStart) >= 1000);
	if cleanupExpired then
		if Ds402HomeState[94] <> 0 then
			orphanResult := -1;
			case axisReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						orphanResult := SdoAxis1.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						orphanResult := SdoAxis2.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						orphanResult := SdoAxis3.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						orphanResult := SdoAxis4.MarkOrphan(Ds402HomeState[99]$UDINT);
					end_if;
			end_case;
			// MarkOrphan acceptance is not executor retirement proof. Keep every
			// pending flag and retain exact-token uncertainty in quarantine.
			Ds402HomeState[127] := 1;
		end_if;
		if Ds402HomeState[113] <> 0 then
			Ds402HomeState[127] := 1;
		end_if;
		ownerResult := -1;
		if IsClientConnected(#AxisOwnership) then
			if preemptionCleanup then
				ownerResult :=
					AxisOwnership.PublishAxisOwnershipPreemptionCleanup(
						ExpectedAxisMask:=axisMask,
						PreemptedAdmissionToken:=admissionToken,
						PreemptedOwnerGeneration:=ownerGeneration,
						SafetyAdmissionToken:=safetyAdmissionToken,
						SafetyOwnerGeneration:=safetyOwnerGeneration,
						CleanupKind:=
							LMC_DIAG_PREEMPT_CLEANUP_INCOMPLETE_QUARANTINE,
						ReportValue0:=Ds402HomeState[107]$UDINT,
						ReportValue1:=Ds402HomeState[108]$UDINT,
						ObservationCycle:=currentCycle);
				if (ownerResult <> 0) & (ownerResult <> 1) then
					Ds402HomeState[119] := ownerResult;
					Ds402HomeState[118]$UDINT :=
						LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
					Ds402HomeState[92] := 101;
					RETURN;
				end_if;
			else
				ownerResult := AxisOwnership.PublishAxisOwnership(
					AxisMask:=axisMask,
					AdmissionToken:=admissionToken,
					OwnerGeneration:=ownerGeneration,
					ReportKind:=LMC_DIAG_OWNER_REPORT_QUARANTINE,
					ReportValue0:=Ds402HomeState[107]$UDINT,
					ReportValue1:=Ds402HomeState[108]$UDINT,
					ObservationCycle:=currentCycle);
				if ownerResult <> 0 then
					Ds402HomeState[119] := ownerResult;
					Ds402HomeState[118]$UDINT :=
						LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
					Ds402HomeState[92] := 101;
					RETURN;
				end_if;
			end_if;
		else
			Ds402HomeState[119] := ownerResult;
			Ds402HomeState[118]$UDINT :=
				LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
			Ds402HomeState[92] := 101;
			RETURN;
		end_if;
		Ds402HomeState[92] := 101;
		RETURN;
	end_if;

	case stage of
		90:
			if IsClientConnected(#InputLatch) then
				mailboxResult := InputLatch.RequestDs402HomeSafetyDrain(
					OperationToken:=Ds402HomeState[101]$UDINT,
					AxisReference:=axisReference);
				if mailboxResult = 0 then
					Ds402HomeState[117] := 0;
					Ds402HomeState[92] := 92;
				elsif mailboxResult <> 1 then
					// Stay in bounded cleanup until timeout; never infer LOW.
					Ds402HomeState[108] := TO_DINT(0 - mailboxResult);
				end_if;
			end_if;
		91:
			// Recover an older cleanup stage through the durable drain path.
			Ds402HomeState[92] := 90;
		92:
			if Ds402HomeState[116] = 0 then
				// Stage 94 also drains a timeout-raced SDO before any terminal record.
				Ds402HomeState[92] := 94;
			elsif Ds402HomeState[104] = 0 then
				Ds402HomeState[92] := 94;
			elsif IsClientConnected(#InputLatch) then
				mailboxResult := InputLatch.SubmitDs402HomeSetpointAlignment(
					Ds402HomeState[101]$UDINT, axisReference, actualPosition);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 94;
				elsif mailboxResult = 1 then
					Ds402HomeState[92] := 93;
				else
					Ds402HomeState[108] := TO_DINT(0 - mailboxResult);
					Ds402HomeState[92] := 98;
				end_if;
			end_if;
		93:
			if IsClientConnected(#InputLatch) then
				mailboxResult := InputLatch.GetDs402HomeControlState(
					Ds402HomeState[101]$UDINT);
				if mailboxResult = 0 then
					Ds402HomeState[92] := 94;
				elsif mailboxResult <> 1 then
					Ds402HomeState[108] := TO_DINT(0 - mailboxResult);
					Ds402HomeState[92] := 98;
				end_if;
			end_if;
		94:
			// MarkOrphan returns -2 when completion may already be ready. Drain
			// that exact token before waiting for IsReusable and restoring CSP.
			if Ds402HomeState[113] <> 0 then
				completionResult := -2;
				case axisReference of
					1:
						if IsClientConnected(#SdoAxis1) then
							completionResult := SdoAxis1.CopyCompletion(
								Ds402HomeState[99]$UDINT, #completion,
								sizeof(completion));
						end_if;
					2:
						if IsClientConnected(#SdoAxis2) then
							completionResult := SdoAxis2.CopyCompletion(
								Ds402HomeState[99]$UDINT, #completion,
								sizeof(completion));
						end_if;
					3:
						if IsClientConnected(#SdoAxis3) then
							completionResult := SdoAxis3.CopyCompletion(
								Ds402HomeState[99]$UDINT, #completion,
								sizeof(completion));
						end_if;
					4:
						if IsClientConnected(#SdoAxis4) then
							completionResult := SdoAxis4.CopyCompletion(
								Ds402HomeState[99]$UDINT, #completion,
								sizeof(completion));
						end_if;
				end_case;
				if completionResult = 0 then
					Ds402HomeState[94] := 0;
					Ds402HomeState[113] := 0;
					Ds402HomeState[127] := 0;
				end_if;
			end_if;
			executorConnected := FALSE;
			executorReusable := FALSE;
			case axisReference of
				1:
					executorConnected := IsClientConnected(#SdoAxis1) <> 0;
					if executorConnected then
						executorReusable := SdoAxis1.IsReusable();
					end_if;
				2:
					executorConnected := IsClientConnected(#SdoAxis2) <> 0;
					if executorConnected then
						executorReusable := SdoAxis2.IsReusable();
					end_if;
				3:
					executorConnected := IsClientConnected(#SdoAxis3) <> 0;
					if executorConnected then
						executorReusable := SdoAxis3.IsReusable();
					end_if;
				4:
					executorConnected := IsClientConnected(#SdoAxis4) <> 0;
					if executorConnected then
						executorReusable := SdoAxis4.IsReusable();
					end_if;
			end_case;
			if executorConnected = FALSE then
				Ds402HomeState[92] := 98;
			elsif executorReusable then
				Ds402HomeState[113] := 0;
				if Ds402HomeState[116] = 0 then
					Ds402HomeState[92] := 98;
				else
					ownerResult := -3;
					if preemptionCleanup then
						// The coordinator snapshot authorizes only this cleanup SDO.
						ownerResult := 0;
					end_if;
					if IsClientConnected(#AxisOwnership) &
						(preemptionCleanup = FALSE) then
						ownerResult := AxisOwnership.ValidateAxisOwnership(
							CommandId:=0x7D15,
							Reference:=axisReference,
							ExpectedAxisMask:=axisMask,
							OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
							ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
							AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
							CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
							RequestSequence:=ownerRequestSequence,
							AdmissionToken:=admissionToken,
							OwnerGeneration:=ownerGeneration,
							RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
					end_if;
					if ownerResult <> 0 then
						Ds402HomeState[108] := TO_DINT(0 - ownerResult);
						Ds402HomeState[92] := 98;
					else
						sdoToken := Ds402HomeState[99]$UDINT + 1;
						if sdoToken = 0 then
							sdoToken := 1;
						end_if;
						Ds402HomeState[99] := sdoToken$DINT;
						sdoData := 8;
						startResult := ERROR;
						case axisReference of
							1: startResult := SdoAxis1.TryStartWrite(sdoToken, 0x6060, 0, (#sdoData)$^USINT, 1, 1000);
							2: startResult := SdoAxis2.TryStartWrite(sdoToken, 0x6060, 0, (#sdoData)$^USINT, 1, 1000);
							3: startResult := SdoAxis3.TryStartWrite(sdoToken, 0x6060, 0, (#sdoData)$^USINT, 1, 1000);
							4: startResult := SdoAxis4.TryStartWrite(sdoToken, 0x6060, 0, (#sdoData)$^USINT, 1, 1000);
						end_case;
						if startResult = READY then
							Ds402HomeState[112] := currentCycle$DINT;
							Ds402HomeState[94] := 1;
							Ds402HomeState[92] := 95;
						elsif startResult = ERROR then
							Ds402HomeState[92] := 98;
						end_if;
					end_if;
				end_if;
			end_if;
		95:
			completionResult := -2;
			case axisReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						completionResult := SdoAxis1.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						completionResult := SdoAxis2.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						completionResult := SdoAxis3.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						completionResult := SdoAxis4.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
			end_case;
			if completionResult = 0 then
				Ds402HomeState[94] := 0;
				if (completion.ValidationCode = 0) & (completion.OsResult = 0) &
					(completion.AbortCode = 0) & (completion.ObjectIndex = 0x6060) &
					(completion.IsWrite <> 0) & (completion.ActualLength = 1) then
					Ds402HomeState[92] := 96;
				else
					Ds402HomeState[92] := 98;
				end_if;
			elsif (completionResult <> -2) & (completionResult <> -3) then
				// Token mismatch or executor quarantine is not retirement proof.
				Ds402HomeState[127] := 1;
				Ds402HomeState[92] := 98;
			end_if;
		96:
			executorReusable := FALSE;
			case axisReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						executorReusable := SdoAxis1.IsReusable();
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						executorReusable := SdoAxis2.IsReusable();
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						executorReusable := SdoAxis3.IsReusable();
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						executorReusable := SdoAxis4.IsReusable();
					end_if;
			end_case;
			if executorReusable then
				ownerResult := -3;
				if preemptionCleanup then
					// The old active tuple is intentionally hidden by safety overlay.
					ownerResult := 0;
				end_if;
				if IsClientConnected(#AxisOwnership) &
					(preemptionCleanup = FALSE) then
					ownerResult := AxisOwnership.ValidateAxisOwnership(
						CommandId:=0x7D15,
						Reference:=axisReference,
						ExpectedAxisMask:=axisMask,
						OwnerKind:=LMC_DIAG_OWNER_KIND_DS402_HOME,
						ResourceKind:=LMC_DIAG_RESOURCE_DS402_HOME,
						AdmissionMode:=LMC_DIAG_ADMISSION_LIFECYCLE,
						CallerSessionEpoch:=ds402ProcessOwnerSessionEpoch,
						RequestSequence:=ownerRequestSequence,
						AdmissionToken:=admissionToken,
						OwnerGeneration:=ownerGeneration,
						RequiredPhase:=LMC_DIAG_OWNER_PHASE_ACTIVE);
				end_if;
				if ownerResult <> 0 then
					Ds402HomeState[108] := TO_DINT(0 - ownerResult);
					Ds402HomeState[92] := 98;
				else
					sdoToken := Ds402HomeState[99]$UDINT + 1;
					if sdoToken = 0 then
						sdoToken := 1;
					end_if;
					Ds402HomeState[99] := sdoToken$DINT;
					startResult := ERROR;
					case axisReference of
						1: startResult := SdoAxis1.TryStartRead(sdoToken, 0x6061, 0, 1, 1000);
						2: startResult := SdoAxis2.TryStartRead(sdoToken, 0x6061, 0, 1, 1000);
						3: startResult := SdoAxis3.TryStartRead(sdoToken, 0x6061, 0, 1, 1000);
						4: startResult := SdoAxis4.TryStartRead(sdoToken, 0x6061, 0, 1, 1000);
					end_case;
					if startResult = READY then
						Ds402HomeState[112] := currentCycle$DINT;
						Ds402HomeState[94] := 1;
						Ds402HomeState[92] := 97;
					elsif startResult = ERROR then
						Ds402HomeState[92] := 98;
					end_if;
				end_if;
			end_if;
		97:
			completionResult := -2;
			case axisReference of
				1:
					if IsClientConnected(#SdoAxis1) then
						completionResult := SdoAxis1.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				2:
					if IsClientConnected(#SdoAxis2) then
						completionResult := SdoAxis2.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				3:
					if IsClientConnected(#SdoAxis3) then
						completionResult := SdoAxis3.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
				4:
					if IsClientConnected(#SdoAxis4) then
						completionResult := SdoAxis4.CopyCompletion(
							Ds402HomeState[99]$UDINT, #completion, sizeof(completion));
					end_if;
			end_case;
			if completionResult = 0 then
				Ds402HomeState[94] := 0;
				if (completion.ValidationCode = 0) & (completion.OsResult = 0) &
					(completion.AbortCode = 0) & (completion.ObjectIndex = 0x6061) &
					(completion.IsWrite = 0) & (completion.ActualLength = 1) &
					((completion.Data and 0xFF) = 8) then
					Ds402HomeState[116] := 0;
				end_if;
				Ds402HomeState[92] := 98;
			elsif (completionResult <> -2) & (completionResult <> -3) then
				// Preserve the pending tuple and force incomplete quarantine.
				Ds402HomeState[127] := 1;
				Ds402HomeState[92] := 98;
			end_if;
		98:
			if Ds402HomeState[117] = 0 then
				Ds402HomeState[92] := 100;
			else
				Ds402HomeState[92] := 90;
			end_if;
		99:
			Ds402HomeState[92] := 90;
		100:
			if preemptionCleanup then
				// SAFE requires bit 4 low, CSP readback, RT release and an idle
				// exact SDO executor. Every weaker outcome stays quarantined.
				executorConnected := FALSE;
				executorReusable := FALSE;
				case axisReference of
					1:
						executorConnected := IsClientConnected(#SdoAxis1) <> 0;
						if executorConnected then
							executorReusable := SdoAxis1.IsReusable();
						end_if;
					2:
						executorConnected := IsClientConnected(#SdoAxis2) <> 0;
						if executorConnected then
							executorReusable := SdoAxis2.IsReusable();
						end_if;
					3:
						executorConnected := IsClientConnected(#SdoAxis3) <> 0;
						if executorConnected then
							executorReusable := SdoAxis3.IsReusable();
						end_if;
					4:
						executorConnected := IsClientConnected(#SdoAxis4) <> 0;
						if executorConnected then
							executorReusable := SdoAxis4.IsReusable();
						end_if;
				end_case;
				preemptionCleanupKind :=
					LMC_DIAG_PREEMPT_CLEANUP_INCOMPLETE_QUARANTINE;
				if (Ds402HomeState[117] = 0) &
					(Ds402HomeState[94] = 0) &
					(Ds402HomeState[113] = 0) &
					(Ds402HomeState[116] = 0) &
					(Ds402HomeState[127] = 0) &
					executorConnected & executorReusable then
					preemptionCleanupKind :=
						LMC_DIAG_PREEMPT_CLEANUP_SAFE;
				end_if;
				ownerResult :=
					AxisOwnership.PublishAxisOwnershipPreemptionCleanup(
						ExpectedAxisMask:=axisMask,
						PreemptedAdmissionToken:=admissionToken,
						PreemptedOwnerGeneration:=ownerGeneration,
						SafetyAdmissionToken:=safetyAdmissionToken,
						SafetyOwnerGeneration:=safetyOwnerGeneration,
						CleanupKind:=preemptionCleanupKind,
						ReportValue0:=Ds402HomeState[107]$UDINT,
						ReportValue1:=Ds402HomeState[108]$UDINT,
						ObservationCycle:=currentCycle);
				if (ownerResult <> 0) & (ownerResult <> 1) then
					Ds402HomeState[119] := ownerResult;
					Ds402HomeState[118]$UDINT :=
						LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
					Ds402HomeState[92] := 101;
					RETURN;
				end_if;
				if preemptionCleanupKind =
					LMC_DIAG_PREEMPT_CLEANUP_SAFE then
					if currentCycle <
						Ds402HomeState[recordBase + 19]$UDINT then
						currentCycle :=
							Ds402HomeState[recordBase + 19]$UDINT;
					end_if;
					Ds402HomeState[recordBase + 14] := 1;
					Ds402HomeState[recordBase + 15] :=
						LMC_DIAG_ADMIN_ERROR_ID;
					Ds402HomeState[recordBase + 16] := 31;
					Ds402HomeState[recordBase + 20] := currentCycle$DINT;
					Ds402HomeState[recordBase + 21] := 0;
					Ds402HomeState[101] := 0;
					Ds402HomeState[recordBase] := 4;
					Ds402HomeState[92] := 0;
				else
					Ds402HomeState[92] := 101;
				end_if;
				RETURN;
			elsif Ds402HomeState[117] <> 0 then
				// Never publish a terminal record while RT ownership is uncertain.
				Ds402HomeState[92] := 99;
			elsif (Ds402HomeState[94] <> 0) |
				(Ds402HomeState[113] <> 0) |
				(Ds402HomeState[116] <> 0) |
				(Ds402HomeState[127] <> 0) then
				// A non-reusable executor or unverified CSP mode is quarantined.
				Ds402HomeState[92] := 101;
			else
				ownerResult := -1;
				if Ds402HomeState[126] = 0 then
					if currentCycle <
						Ds402HomeState[recordBase + 19]$UDINT then
						currentCycle :=
							Ds402HomeState[recordBase + 19]$UDINT;
					end_if;
					Ds402HomeState[106] := 3;
					Ds402HomeState[recordBase + 14] := 1;
					if Ds402HomeState[107] = 11 then
						Ds402HomeState[recordBase + 15] := -6;
					else
						Ds402HomeState[recordBase + 15] :=
							LMC_DIAG_ADMIN_ERROR_ID;
					end_if;
					Ds402HomeState[recordBase + 16] :=
						Ds402HomeState[107];
					Ds402HomeState[recordBase + 20] := currentCycle$DINT;
					Ds402HomeState[recordBase + 21] :=
						Ds402HomeState[108];
					if IsClientConnected(#AxisOwnership) then
						ownerResult :=
							AxisOwnership.PublishAxisOwnershipDs402Receipt(
								AxisMask:=axisMask,
								AdmissionToken:=admissionToken,
								OwnerGeneration:=ownerGeneration,
								ReportKind:=
									LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE,
								ReportValue0:=Ds402HomeState[107]$UDINT,
								ReportValue1:=Ds402HomeState[108]$UDINT,
								ObservationCycle:=currentCycle,
								pDs402State:=#Ds402HomeState[0],
								Ds402StateSize:=sizeof(Ds402HomeState));
					end_if;
					if ownerResult = 0 then
						Ds402HomeState[125] := 2;
						ownerResult :=
							AxisOwnership.PublishAxisOwnershipDs402Receipt(
								AxisMask:=axisMask,
								AdmissionToken:=admissionToken,
								OwnerGeneration:=ownerGeneration,
								ReportKind:=
									LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE,
								ReportValue0:=Ds402HomeState[107]$UDINT,
								ReportValue1:=Ds402HomeState[108]$UDINT,
								ObservationCycle:=currentCycle,
								pDs402State:=#Ds402HomeState[0],
								Ds402StateSize:=sizeof(Ds402HomeState));
						if ownerResult = 1 then
							Ds402HomeState[92] :=
								LMC_DIAG_DS402_STAGE_FINALIZE;
						elsif ownerResult <> 0 then
							Ds402HomeState[92] := 101;
						end_if;
						RETURN;
					elsif ownerResult = 1 then
						Ds402HomeState[92] :=
							LMC_DIAG_DS402_STAGE_FINALIZE;
						RETURN;
					else
						Ds402HomeState[92] := 101;
					end_if;
				else
					ownerResult := -1;
					if IsClientConnected(#AxisOwnership) then
						// Once an SDO dispatch was reported, a non-success path
						// remains quarantined instead of claiming safe release.
						ownerResult := AxisOwnership.PublishAxisOwnership(
							AxisMask:=axisMask,
							AdmissionToken:=admissionToken,
							OwnerGeneration:=ownerGeneration,
							ReportKind:=LMC_DIAG_OWNER_REPORT_QUARANTINE,
							ReportValue0:=Ds402HomeState[107]$UDINT,
							ReportValue1:=Ds402HomeState[108]$UDINT,
							ObservationCycle:=currentCycle);
						if ownerResult <> 0 then
							Ds402HomeState[119] := ownerResult;
							Ds402HomeState[118]$UDINT :=
								LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
							Ds402HomeState[92] := 101;
							RETURN;
						end_if;
					else
						Ds402HomeState[119] := ownerResult;
						Ds402HomeState[118]$UDINT :=
							LMC_DIAG_DS402_PUBLISH_FAILURE_MAGIC;
						Ds402HomeState[92] := 101;
						RETURN;
					end_if;
				end_if;
				if Ds402HomeState[126] <> 0 then
					Ds402HomeState[92] := 101;
				end_if;
			end_if;
		101:
			// Fail-closed quarantine. A PLC restart or a future explicit recovery
			// command is required; generic D5 remains excluded while stage is nonzero.
			RETURN;
	end_case;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleDiagnosticsCapabilities
	VAR_INPUT
		RequestSize 	: UDINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CurrentDiagnosticsBootId 	: UDINT;
		DetailCode 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		localDetailCode : UDINT;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 68) then
		RETURN;
	end_if;

	localDetailCode := DetailCode;
	if RequestSize <> 8 then
		localDetailCode := 12;
	end_if;
	if localDetailCode <> 0 then
		(pResponse + 4)^$UINT := 1;
		(pResponse + 6)^$INT := LMC_DIAG_ERROR_ID;
		(pResponse + 12)^$UDINT := localDetailCode;
	end_if;
	(pResponse + 16)^$UDINT := 1;
	(pResponse + 20)^$UDINT := 0x00004007;
	(pResponse + 24)^$UDINT := LMC_DIAG_MAP_REVISION;
	(pResponse + 28)^$UINT := 24;
	(pResponse + 30)^$UINT := 0;
	(pResponse + 32)^$UINT := 0;
	(pResponse + 34)^$UINT := 0;
	(pResponse + 36)^$UDINT := 0;
	(pResponse + 40)^$UDINT := 1000;
	(pResponse + 44)^$UINT := 1320;
	(pResponse + 46)^$UINT := 2040;
	(pResponse + 48)^$UINT := 1280;
	(pResponse + 50)^$UINT := 80;
	(pResponse + 52)^$UINT := 16;
	(pResponse + 54)^$UINT := 0;
	(pResponse + 56)^$UDINT := 0;
	(pResponse + 60)^$UINT := 0;
	(pResponse + 62)^$UINT := 0;
	(pResponse + 64)^$UDINT := CurrentDiagnosticsBootId;
	if CurrentDiagnosticsBootId <> 0 then
		(pResponse + 20)^$UDINT := 0x0000613F;
		(pResponse + 30)^$UINT := 24;
		(pResponse + 32)^$UINT := 24;
		(pResponse + 34)^$UINT := 1;
		(pResponse + 36)^$UDINT := 320000;
		(pResponse + 56)^$UDINT := 1280000;
		(pResponse + 60)^$UINT := 4;
		if LMC_DIAG_D5_SDO_WRITE_GLOBAL_ENABLED = TRUE then
			(pResponse + 20)^$UDINT :=
				(pResponse + 20)^$UDINT OR 0x00000200;
		end_if;
		if LMC_DIAG_ENCODER_TW20_ENABLED = TRUE then
			(pResponse + 20)^$UDINT :=
				(pResponse + 20)^$UDINT OR 0x00040000;
		end_if;
		if LMC_DIAG_ENCODER_TW19_ENABLED = TRUE then
			(pResponse + 20)^$UDINT :=
				(pResponse + 20)^$UDINT OR 0x00080000;
		end_if;
	end_if;
	ResponseSize := 68;

END_FUNCTION




FUNCTION LMCDiagnosticsService::HandleDiagnosticsBulkRequest
	VAR_INPUT
		CommandId 	: UINT;
		pRequest 	: ^USINT;
		RequestSize 	: UDINT;
		pResponse 	: ^USINT;
		ResponseCapacity 	: UDINT;
		CallerSessionEpoch 	: UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize 	: DINT;
	END_VAR
	VAR
		physicalAxis, signalCode, catalogIndex, signalCount : UINT;
		duplicateIndex, entryIndex : UINT;
		expectedMapRevision, requestedBulkId, signalId : UDINT;
		expectedRequestSize, requestBulkId, requestConfigRevision : UDINT;
		healthOffset, valueOffset, entryOffset, entryDetailCode : UDINT;
		detailCode : UDINT;
		valueType, entryStatus : USINT;
		copyResult : DINT;
		snapshot : ARRAY [0..303] OF USINT;
		hasInvalidEntry : BOOL;
	END_VAR

	ResponseSize := -1;
	detailCode := 0;

	case CommandId of
		0x7E30:
			if RequestSize < 20 then
				detailCode := 12;
			else
				expectedMapRevision := (pRequest + 8)^$UDINT;
				requestedBulkId := (pRequest + 12)^$UDINT;
				signalCount := (pRequest + 16)^$UINT;
				expectedRequestSize := 20 + TO_UDINT(signalCount) * 4;
				if expectedMapRevision <> LMC_DIAG_MAP_REVISION then
					detailCode := 3;
				elsif (CallerSessionEpoch = 0) | (signalCount = 0) |
					(signalCount > LMC_DIAG_MAX_BULK_SIGNALS) |
					((pRequest + 18)^$UINT <> 0) |
					(RequestSize <> expectedRequestSize) then
					detailCode := 12;
				elsif ResponseCapacity < 36 then
					detailCode := 20;
				end_if;

				if detailCode = 0 then
					for entryIndex := 0 to signalCount - 1 do
						signalId := (pRequest + 20 + TO_UDINT(entryIndex) * 4)^$UDINT;
						physicalAxis := TO_UINT((signalId shr 8) and 0xFF);
						signalCode := TO_UINT(signalId and 0xFF);
						if (physicalAxis < 1) | (physicalAxis > 4) |
							(signalCode < 1) | (signalCode > 6) |
							(signalId <> (0x00100000 or
							 (TO_UDINT(physicalAxis) shl 8) or TO_UDINT(signalCode))) then
							detailCode := 4;
						elsif entryIndex > 0 then
							for duplicateIndex := 0 to entryIndex - 1 do
								if signalId =
									(pRequest + 20 + TO_UDINT(duplicateIndex) * 4)^$UDINT then
									detailCode := 12;
								end_if;
							end_for;
						end_if;
					end_for;
				end_if;

				if (detailCode = 0) & (BulkState <> 0) &
					(BulkOwnerSessionEpoch <> CallerSessionEpoch) then
					BulkId := 0;
					BulkConfigRevision := 0;
					BulkOwnerSessionEpoch := 0;
					BulkConfiguredCycle := 0;
					BulkActivationCycle := 0;
					BulkState := 0;
					BulkSignalCount := 0;
					_memset(dest:=#BulkSignalIds[0], usByte:=0,
						cntr:=sizeof(BulkSignalIds));
				end_if;

				if (detailCode = 0) & (BulkState <> 0) then
					if requestedBulkId = 0 then
						detailCode := 9;
					elsif requestedBulkId <> BulkId then
						detailCode := 10;
					end_if;
				end_if;
				if (detailCode = 0) &
					((NextBulkConfigRevision = 0xFFFFFFFF) |
					 ((BulkState = 0) & (requestedBulkId = 0) &
					  (NextBulkId = 0xFFFFFFFF))) then
					detailCode := 19;
				end_if;

				if detailCode = 0 then
					if IsClientConnected(#InputLatch) = FALSE then
						detailCode := 11;
					else
						copyResult := InputLatch.CopySnapshot(
							pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
						if copyResult <> 0 then
							detailCode := 9;
						end_if;
					end_if;
				end_if;

				if detailCode = 0 then
					if BulkState = 0 then
						if requestedBulkId = 0 then
							NextBulkId += 1;
							BulkId := NextBulkId;
						else
							BulkId := requestedBulkId;
						end_if;
					end_if;

					NextBulkConfigRevision += 1;
					BulkConfigRevision := NextBulkConfigRevision;
					BulkOwnerSessionEpoch := CallerSessionEpoch;
					BulkConfiguredCycle := snapshot[0]$UDINT;
					BulkActivationCycle := 0;
					BulkState := 1;
					BulkSignalCount := signalCount;
					_memset(dest:=#BulkSignalIds[0], usByte:=0,
						cntr:=sizeof(BulkSignalIds));
					for entryIndex := 0 to signalCount - 1 do
						BulkSignalIds[entryIndex] :=
							(pRequest + 20 + TO_UDINT(entryIndex) * 4)^$UDINT;
					end_for;

					(pResponse + 16)^$UDINT := BulkId;
					(pResponse + 20)^$UDINT := BulkConfigRevision;
					(pResponse + 24)^$UDINT := LMC_DIAG_MAP_REVISION;
					(pResponse + 28)^$UINT := BulkState;
					(pResponse + 30)^$UINT := BulkSignalCount;
					(pResponse + 32)^$UDINT := BulkActivationCycle;
					ResponseSize := 36;
				end_if;
			end_if;

		0x7E31:
			if RequestSize <> 20 then
				detailCode := 12;
			else
				requestBulkId := (pRequest + 8)^$UDINT;
				requestConfigRevision := (pRequest + 12)^$UDINT;
				expectedMapRevision := (pRequest + 16)^$UDINT;
				if expectedMapRevision <> LMC_DIAG_MAP_REVISION then
					detailCode := 3;
				elsif (requestBulkId = 0) | (requestConfigRevision = 0) then
					detailCode := 12;
				elsif (BulkState = 0) | (requestBulkId <> BulkId) |
					(requestConfigRevision <> BulkConfigRevision) |
					(CallerSessionEpoch <> BulkOwnerSessionEpoch) then
					detailCode := 10;
				elsif IsClientConnected(#InputLatch) = FALSE then
					detailCode := 11;
				else
					copyResult := InputLatch.CopySnapshot(
						pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
					if copyResult <> 0 then
						detailCode := 9;
					elsif (BulkState = 1) &
						(snapshot[0]$UDINT <> BulkConfiguredCycle) then
						BulkState := 2;
						BulkActivationCycle := snapshot[0]$UDINT;
					end_if;
				end_if;

				if detailCode = 0 then
					if ResponseCapacity < 36 then
						detailCode := 20;
					else
						(pResponse + 16)^$UDINT := BulkId;
						(pResponse + 20)^$UDINT := BulkConfigRevision;
						(pResponse + 24)^$UDINT := LMC_DIAG_MAP_REVISION;
						(pResponse + 28)^$UINT := BulkState;
						(pResponse + 30)^$UINT := BulkSignalCount;
						(pResponse + 32)^$UDINT := BulkActivationCycle;
						ResponseSize := 36;
					end_if;
				end_if;
			end_if;

		0x7E32:
			if RequestSize <> 20 then
				detailCode := 12;
			else
				requestBulkId := (pRequest + 8)^$UDINT;
				requestConfigRevision := (pRequest + 12)^$UDINT;
				expectedMapRevision := (pRequest + 16)^$UDINT;
				if expectedMapRevision <> LMC_DIAG_MAP_REVISION then
					detailCode := 3;
				elsif (requestBulkId = 0) | (requestConfigRevision = 0) then
					detailCode := 12;
				elsif (BulkState = 0) | (requestBulkId <> BulkId) |
					(requestConfigRevision <> BulkConfigRevision) |
					(CallerSessionEpoch <> BulkOwnerSessionEpoch) then
					detailCode := 10;
				elsif IsClientConnected(#InputLatch) = FALSE then
					detailCode := 11;
				else
					copyResult := InputLatch.CopySnapshot(
						pDest:=#snapshot[0], DestSize:=sizeof(snapshot));
					if copyResult <> 0 then
						detailCode := 9;
					elsif (BulkState = 1) &
						(snapshot[0]$UDINT <> BulkConfiguredCycle) then
						BulkState := 2;
						BulkActivationCycle := snapshot[0]$UDINT;
					end_if;
				end_if;

				if (detailCode = 0) & (BulkState <> 2) then
					detailCode := 11;
				end_if;
				if (detailCode = 0) &
					(ResponseCapacity < (56 + TO_UDINT(BulkSignalCount) * 16)) then
					detailCode := 20;
				end_if;

				if detailCode = 0 then
					(pResponse + 16)^$UDINT := BulkId;
					(pResponse + 20)^$UDINT := BulkConfigRevision;
					(pResponse + 24)^$UDINT := LMC_DIAG_MAP_REVISION;
					(pResponse + 28)^$UDINT := snapshot[0]$UDINT;
					(pResponse + 32)^$UDINT := snapshot[4]$UDINT;
					(pResponse + 36)^$UDINT := snapshot[8]$UDINT;
					(pResponse + 40)^$UINT := BulkSignalCount;
					(pResponse + 42)^$UINT := 16;
					(pResponse + 44)^$USINT := 1;
					(pResponse + 48)^$UDINT := snapshot[44]$UDINT;
					(pResponse + 52)^$UDINT := 3;
					hasInvalidEntry := FALSE;

					for entryIndex := 0 to BulkSignalCount - 1 do
						signalId := BulkSignalIds[entryIndex];
						physicalAxis := TO_UINT((signalId shr 8) and 0xFF);
						signalCode := TO_UINT(signalId and 0xFF);
						catalogIndex := (physicalAxis - 1) * 6 + (signalCode - 1);
						healthOffset := 64 + TO_UDINT(physicalAxis - 1) * 36;
						valueOffset := 208 + TO_UDINT(catalogIndex) * 4;
						entryOffset := 56 + TO_UDINT(entryIndex) * 16;
						valueType := 8;
						if (signalCode = 1) | (signalCode = 4) then
							valueType := 4;
						elsif (signalCode = 3) | (signalCode = 6) then
							valueType := 7;
						end_if;

						entryStatus := 0;
						if snapshot[12]$UDINT <> 8 then
							entryStatus := entryStatus or 4;
						end_if;
						if snapshot[16]$UDINT <> 0 then
							entryStatus := entryStatus or 2;
						end_if;
						if snapshot[TO_DINT(healthOffset)]$DINT = 0 then
							entryStatus := entryStatus or 8;
						end_if;
						if snapshot[TO_DINT(healthOffset + 4)]$UDINT <> 8 then
							entryStatus := entryStatus or 16;
						end_if;
						if snapshot[TO_DINT(healthOffset + 12)]$UDINT <> 0 then
							entryStatus := entryStatus or 32;
						end_if;
						if snapshot[TO_DINT(healthOffset + 16)]$UDINT = 0xFFFFFFFF then
							entryStatus := entryStatus or 128;
						end_if;

						entryDetailCode := 0;
						if entryStatus = 0 then
							entryStatus := 1;
						else
							hasInvalidEntry := TRUE;
							if (entryStatus and 8) <> 0 then
								entryDetailCode := 18;
							else
								entryDetailCode := 11;
							end_if;
						end_if;

						(pResponse + entryOffset)^$UDINT := signalId;
						(pResponse + entryOffset + 4)^$UDINT :=
							snapshot[TO_DINT(valueOffset)]$UDINT;
						(pResponse + entryOffset + 8)^$USINT := valueType;
						(pResponse + entryOffset + 9)^$USINT := entryStatus;
						(pResponse + entryOffset + 12)^$UDINT := entryDetailCode;
					end_for;

					if hasInvalidEntry then
						(pResponse + 2)^$UINT := 1;
					end_if;
					ResponseSize := 56 + TO_DINT(BulkSignalCount) * 16;
				end_if;
			end_if;

		0x7E33:
			if RequestSize <> 20 then
				detailCode := 12;
			else
				requestBulkId := (pRequest + 8)^$UDINT;
				requestConfigRevision := (pRequest + 12)^$UDINT;
				expectedMapRevision := (pRequest + 16)^$UDINT;
				if expectedMapRevision <> LMC_DIAG_MAP_REVISION then
					detailCode := 3;
				elsif (requestBulkId = 0) | (requestConfigRevision = 0) then
					detailCode := 12;
				elsif (BulkState = 0) | (requestBulkId <> BulkId) |
					(requestConfigRevision <> BulkConfigRevision) |
					(CallerSessionEpoch <> BulkOwnerSessionEpoch) then
					detailCode := 10;
				else
					BulkId := 0;
					BulkConfigRevision := 0;
					BulkOwnerSessionEpoch := 0;
					BulkConfiguredCycle := 0;
					BulkActivationCycle := 0;
					BulkState := 0;
					BulkSignalCount := 0;
					_memset(dest:=#BulkSignalIds[0], usByte:=0,
						cntr:=sizeof(BulkSignalIds));
					ResponseSize := 16;
				end_if;
			end_if;

		else
			detailCode := 2;
	end_case;

	if detailCode <> 0 then
		_memset(dest:=pResponse + 16, usByte:=0, cntr:=ResponseCapacity - 16);
		(pResponse + 2)^$UINT := 0;
		(pResponse + 4)^$UINT := 1;
		(pResponse + 6)^$INT := LMC_DIAG_ERROR_ID;
		(pResponse + 12)^$UDINT := detailCode;
		ResponseSize := 16;
	end_if;

END_FUNCTION


FUNCTION LMCDiagnosticsService::ProcessAxisOwnershipStartup
	VAR
		startupSnapshot : ARRAY [0..11] OF UDINT;
		copyResult : DINT;
		reconcileResult : DINT;
		currentBootId : UDINT;
		reportCycle : UDINT;
		drainFlags : UDINT;
		executorsReusable : BOOL;
	END_VAR

	if (IsClientConnected(#InputLatch) = FALSE) |
		(IsClientConnected(#AxisOwnership) = FALSE) then
		RETURN;
	end_if;
	copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
		pDest:=#startupSnapshot[0], DestSize:=48);
	if copyResult <> 0 then
		RETURN;
	end_if;
	if (startupSnapshot[0] <> LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) |
		(startupSnapshot[1] = 0) | (startupSnapshot[11] <> 0) then
		RETURN;
	end_if;

	drainFlags := LMC_OWNER_STARTUP_DIAG_SNAPSHOT;
	if Ds402HomeState[92] = 0 then
		drainFlags := drainFlags or LMC_OWNER_STARTUP_DIAG_DS402;
	end_if;
	if EncoderMaintenanceState[152] = 0 then
		drainFlags := drainFlags or LMC_OWNER_STARTUP_DIAG_ENCODER;
	end_if;
	if (OperationState <> LMC_DIAG_SDO_STATE_QUEUED) &
		(OperationState <> LMC_DIAG_SDO_STATE_RUNNING) &
		(SdoInternalDrainState = 0) then
		drainFlags := drainFlags or LMC_OWNER_STARTUP_DIAG_GENERIC;
	end_if;

	executorsReusable := (IsClientConnected(#SdoAxis1) <> 0) &
		(IsClientConnected(#SdoAxis2) <> 0) &
		(IsClientConnected(#SdoAxis3) <> 0) &
		(IsClientConnected(#SdoAxis4) <> 0);
	if executorsReusable then
		executorsReusable := SdoAxis1.IsReusable() & SdoAxis2.IsReusable() &
			SdoAxis3.IsReusable() & SdoAxis4.IsReusable();
	end_if;
	if executorsReusable then
		drainFlags := drainFlags or LMC_OWNER_STARTUP_DIAG_EXECUTOR;
	end_if;

	currentBootId := GetDiagnosticsBootId();
	if currentBootId = 0 then
		RETURN;
	end_if;
	reportCycle := ops.tAbsolute;
	if reportCycle = 0 then
		reportCycle := 1;
	end_if;
	reconcileResult := AxisOwnership.ReconcileAxisOwnershipStartup(
		DiagnosticsBootId:=currentBootId,
		ObservationCycle:=startupSnapshot[1],
		ReportCycle:=reportCycle,
		DiagnosticsDrainFlags:=drainFlags);

END_FUNCTION


FUNCTION GLOBAL LMCDiagnosticsService::TryTakeD5TerminalWake
	VAR_INPUT
		pTicketId 	: ^UDINT;
		pTicketBootId 	: ^UDINT;
		pOwnerSessionEpoch 	: ^UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR

	Result := -1;
	if (pTicketId = NIL) | (pTicketBootId = NIL) |
		(pOwnerSessionEpoch = NIL) then
		RETURN;
	end_if;

	pTicketId^$UDINT := 0;
	pTicketBootId^$UDINT := 0;
	pOwnerSessionEpoch^$UDINT := 0;
	Result := 0;

	if (TicketId = 0) | (TicketBootId = 0) |
		(OwnerSessionEpoch = 0) then
		RETURN;
	end_if;
	if (OperationState <> LMC_DIAG_SDO_STATE_COMPLETED) &
		(OperationState <> LMC_DIAG_SDO_STATE_FAILED) &
		(OperationState <> LMC_DIAG_SDO_STATE_CANCELLED) &
		(OperationState <> LMC_DIAG_SDO_STATE_EXPIRED) then
		RETURN;
	end_if;
	if (D5TerminalWakeLastAttemptTicketId = TicketId) &
		(D5TerminalWakeLastAttemptTicketBootId = TicketBootId) &
		(D5TerminalWakeLastAttemptOwnerSessionEpoch = OwnerSessionEpoch) then
		RETURN;
	end_if;

	D5TerminalWakeLastAttemptTicketId := TicketId;
	D5TerminalWakeLastAttemptTicketBootId := TicketBootId;
	D5TerminalWakeLastAttemptOwnerSessionEpoch := OwnerSessionEpoch;
	pTicketId^$UDINT := TicketId;
	pTicketBootId^$UDINT := TicketBootId;
	pOwnerSessionEpoch^$UDINT := OwnerSessionEpoch;
	Result := 1;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisSetOperationModeStart
	VAR_INPUT
		Reference : UINT;
		pRequest : ^USINT;
		pResponse : ^USINT;
		ResponseCapacity : UDINT;
		CallerSessionEpoch : UDINT;
		RequestSequence : UDINT;
		AdmissionToken : UDINT;
		OwnerGeneration : UDINT;
		RequestSize : UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize : DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags, keySchema, keyReserved : UINT;
		requestId, diagnosticsBuild, bootId, mapRevision : UDINT;
		originalRequestId, intent0, intent1, intent2, intent3 : UDINT;
		timeoutMilliseconds, operationFlags, currentBootId, detailCode : UDINT;
		axisMask, nextRecordGeneration, nextOperationToken : UDINT;
		currentCycle, contextCheck, ds402StatusWord : UDINT;
		requestedMode : SINT;
		axisReference : UINT;
		reservedByte : USINT;
		recordBase : DINT;
		ownerResult, rollbackResult, publishResult, copyResult : DINT;
		startupSnapshot : ARRAY [0..11] OF UDINT;
		executorReady, ownerCommitted : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	_memset(dest:=pResponse, usByte:=0, cntr:=16);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	detailCode := 5;
	requestId := 0;
	requestedMode := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := detailCode;
	ResponseSize := 16;

	if (pRequest = NIL) | (RequestSize <> 56) then
		RETURN;
	end_if;

	schemaVersion := pRequest^$UINT;
	requestFlags := (pRequest + 2)^$UINT;
	keySchema := (pRequest + 8)^$UINT;
	keyReserved := (pRequest + 10)^$UINT;
	diagnosticsBuild := (pRequest + 12)^$UDINT;
	bootId := (pRequest + 16)^$UDINT;
	mapRevision := (pRequest + 20)^$UDINT;
	originalRequestId := (pRequest + 24)^$UDINT;
	intent0 := (pRequest + 28)^$UDINT;
	intent1 := (pRequest + 32)^$UDINT;
	intent2 := (pRequest + 36)^$UDINT;
	intent3 := (pRequest + 40)^$UDINT;
	axisReference := (pRequest + 44)^$UINT;
	requestedMode := (pRequest + 46)^$SINT;
	reservedByte := (pRequest + 47)^$USINT;
	timeoutMilliseconds := (pRequest + 48)^$UDINT;
	operationFlags := (pRequest + 52)^$UDINT;
	currentBootId := GetDiagnosticsBootId();

	if (schemaVersion <> 1) | (keySchema <> 1) then
		detailCode := 1;
	elsif requestFlags <> 0 then
		detailCode := 2;
	elsif requestId = 0 then
		detailCode := 3;
	elsif (Reference < 1) | (Reference > 4) |
	      (axisReference <> Reference) then
		detailCode := 4;
	elsif (keyReserved <> 0) | (reservedByte <> 0) |
	      (originalRequestId = 0) | (originalRequestId <> requestId) |
	      ((intent0 = 0) & (intent1 = 0) &
	       (intent2 = 0) & (intent3 = 0)) |
	      (timeoutMilliseconds = 0) | (operationFlags <> 0) then
		detailCode := 5;
	else
		detailCode := 0;
	end_if;

	if detailCode <> 0 then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;
	if ResponseCapacity < 24 then
		ResponseSize := -1;
		RETURN;
	end_if;

	if diagnosticsBuild <> 1 then
		detailCode := 16;
	elsif (currentBootId = 0) | (bootId <> currentBootId) then
		detailCode := 17;
	elsif mapRevision <> LMC_DIAG_MAP_REVISION then
		detailCode := 18;
	elsif (requestedMode <> 8) &
	      ((LMC_DIAG_SET_OPERATION_MODE_SOFTWARE_MODES = FALSE) |
	       ((requestedMode <> 1) & (requestedMode <> 3) & (requestedMode <> 7))) then
		detailCode := LMC_DIAG_MODE_DETAIL_UNSUPPORTED;
	elsif LMC_DIAG_SET_OPERATION_MODE_ENABLED = FALSE then
		detailCode := LMC_DIAG_MODE_DETAIL_STORAGE;
	end_if;

	axisMask := 0;
	case axisReference of
		1: axisMask := 0x00000001;
		2: axisMask := 0x00000002;
		3: axisMask := 0x00000004;
		4: axisMask := 0x00000008;
	else
	end_case;
	recordBase := TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE;

	if detailCode = 0 then
		if sizeof(AxisOperationModeState) <> 768 then
			detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
		elsif (AxisOperationModeState[recordBase] = LMC_DIAG_MODE_RECORD_EMPTY) &
		      (AxisOperationModeState[recordBase + 31] <> 0) then
			detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
		elsif AxisOperationModeState[recordBase] <> LMC_DIAG_MODE_RECORD_EMPTY then
			if AxisOperationModeState[recordBase + 31]$UDINT <>
			   LMC_DIAG_MODE_RECORD_MAGIC then
				detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
			else
				detailCode := LMC_DIAG_MODE_DETAIL_SLOT_OCCUPIED;
			end_if;
		elsif AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] <> 0 then
			detailCode := LMC_DIAG_MODE_DETAIL_SLOT_OCCUPIED;
		elsif (Ds402HomeState[92] <> 0) |
		      (EncoderMaintenanceState[152] <> 0) |
		      ((((OperationState = LMC_DIAG_SDO_STATE_QUEUED) |
		         (OperationState = LMC_DIAG_SDO_STATE_RUNNING) |
		         (SdoInternalDrainState <> 0)) &
		        (SdoSlaveReference = axisReference))) then
			detailCode := LMC_DIAG_MODE_DETAIL_UNSAFE;
		end_if;
	end_if;

	if detailCode = 0 then
		executorReady := FALSE;
		case axisReference of
			1:
				if IsClientConnected(#SdoAxis1) then
					executorReady := SdoAxis1.IsReusable();
				end_if;
			2:
				if IsClientConnected(#SdoAxis2) then
					executorReady := SdoAxis2.IsReusable();
				end_if;
			3:
				if IsClientConnected(#SdoAxis3) then
					executorReady := SdoAxis3.IsReusable();
				end_if;
			4:
				if IsClientConnected(#SdoAxis4) then
					executorReady := SdoAxis4.IsReusable();
				end_if;
		end_case;
		if executorReady = FALSE then
			detailCode := LMC_DIAG_MODE_DETAIL_UNSAFE;
		end_if;
	end_if;

	_memset(dest:=#startupSnapshot[0], usByte:=0, cntr:=sizeof(startupSnapshot));
	if detailCode = 0 then
		copyResult := -1;
		if IsClientConnected(#InputLatch) then
			copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
				pDest:=#startupSnapshot[0], DestSize:=sizeof(startupSnapshot));
		end_if;
		if (copyResult <> 0) |
		   (startupSnapshot[0] <> LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) |
		   (startupSnapshot[1] = 0) | (startupSnapshot[11] <> 0) then
			detailCode := LMC_DIAG_MODE_DETAIL_UNSAFE;
		end_if;
	end_if;

	currentCycle := startupSnapshot[1];
	contextCheck := startupSnapshot[10];
	ds402StatusWord := 0;
	case axisReference of
		1: ds402StatusWord := startupSnapshot[6];
		2: ds402StatusWord := startupSnapshot[7];
		3: ds402StatusWord := startupSnapshot[8];
		4: ds402StatusWord := startupSnapshot[9];
	else
	end_case;

	ownerCommitted := FALSE;
	if detailCode = 0 then
		if (CallerSessionEpoch = 0) | (RequestSequence = 0) |
		   (AdmissionToken = 0) | (OwnerGeneration = 0) |
		   (IsClientConnected(#AxisOwnership) = FALSE) then
			detailCode := LMC_DIAG_MODE_DETAIL_STORAGE;
		else
			ownerResult := AxisOwnership.ValidateAxisOwnershipIdentity(
				CommandId:=0x7D23,
				Reference:=axisReference,
				ExpectedAxisMask:=axisMask,
				OwnerKind:=LMC_DIAG_MODE_OWNER_KIND,
				ResourceKind:=LMC_DIAG_MODE_RESOURCE_KIND,
				AdmissionMode:=LMC_DIAG_MODE_ADMISSION_MODE,
				CallerSessionEpoch:=CallerSessionEpoch,
				RequestSequence:=RequestSequence,
				AdmissionToken:=AdmissionToken,
				OwnerGeneration:=OwnerGeneration,
				RequiredPhase:=LMC_DIAG_MODE_OWNER_PHASE_RESERVED,
				pIdentity:=pRequest$^void,
				IdentitySize:=RequestSize);
			if ownerResult <> 0 then
				detailCode := 42;
			end_if;
		end_if;
	end_if;

	if detailCode = 0 then
		nextRecordGeneration :=
			AxisOperationModeState[LMC_DIAG_MODE_META_RECORD_GENERATION]$UDINT + 1;
		if nextRecordGeneration = 0 then
			nextRecordGeneration := 1;
		end_if;
		nextOperationToken :=
			AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT + 1;
		if nextOperationToken = 0 then
			nextOperationToken := 1;
		end_if;
		ownerResult := AxisOwnership.CommitAxisOwnership(
			CommandId:=0x7D23,
			Reference:=axisReference,
			ExpectedAxisMask:=axisMask,
			CallerSessionEpoch:=CallerSessionEpoch,
			RequestSequence:=RequestSequence,
			AdmissionToken:=AdmissionToken,
			OwnerGeneration:=OwnerGeneration);
		if ownerResult <> 0 then
			detailCode := 42;
		else
			ownerCommitted := TRUE;
		end_if;
	end_if;

	if detailCode <> 0 then
		if (ownerCommitted = FALSE) & (AdmissionToken <> 0) &
		   (OwnerGeneration <> 0) & (CallerSessionEpoch <> 0) &
		   (RequestSequence <> 0) & IsClientConnected(#AxisOwnership) then
			rollbackResult := AxisOwnership.RollbackAxisOwnership(
				AdmissionToken:=AdmissionToken,
				OwnerGeneration:=OwnerGeneration,
				CallerSessionEpoch:=CallerSessionEpoch,
				RequestSequence:=RequestSequence,
				Reason:=0);
			if rollbackResult <> 0 then
				publishResult := AxisOwnership.PublishAxisOwnership(
					AxisMask:=axisMask,
					AdmissionToken:=AdmissionToken,
					OwnerGeneration:=OwnerGeneration,
					ReportKind:=LMC_DIAG_OWNER_REPORT_QUARANTINE,
					ReportValue0:=TO_UDINT(0 - rollbackResult),
					ReportValue1:=detailCode,
					ObservationCycle:=currentCycle);
				detailCode := 42;
			end_if;
		end_if;
		_memset(dest:=pResponse, usByte:=0, cntr:=24);
		pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
		(pResponse + 4)^$UINT := 1;
		(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
		(pResponse + 8)^$UDINT := requestId;
		(pResponse + 12)^$UDINT := detailCode;
		(pResponse + 16)^$DINT := TO_DINT(requestedMode);
		(pResponse + 20)^$UDINT := 0;
		ResponseSize := 24;
		RETURN;
	end_if;

	_memset(dest:=#AxisOperationModeState[recordBase], usByte:=0,
		cntr:=LMC_DIAG_MODE_RECORD_STRIDE * 4);
	_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
		usByte:=0, cntr:=32 * 4);
	AxisOperationModeState[recordBase + 1]$UDINT := diagnosticsBuild;
	AxisOperationModeState[recordBase + 2]$UDINT := bootId;
	AxisOperationModeState[recordBase + 3]$UDINT := mapRevision;
	AxisOperationModeState[recordBase + 4]$UDINT := originalRequestId;
	AxisOperationModeState[recordBase + 5]$UDINT := intent0;
	AxisOperationModeState[recordBase + 6]$UDINT := intent1;
	AxisOperationModeState[recordBase + 7]$UDINT := intent2;
	AxisOperationModeState[recordBase + 8]$UDINT := intent3;
	AxisOperationModeState[recordBase + 9] := TO_DINT(axisReference);
	AxisOperationModeState[recordBase + 10] := TO_DINT(requestedMode);
	AxisOperationModeState[recordBase + 11] := 0;
	AxisOperationModeState[recordBase + 12]$UDINT := timeoutMilliseconds;
	AxisOperationModeState[recordBase + 13]$UDINT := operationFlags;
	AxisOperationModeState[recordBase + 17]$UDINT := nextOperationToken;
	AxisOperationModeState[recordBase + 19]$UDINT := currentCycle;
	AxisOperationModeState[recordBase + 22]$UDINT := nextRecordGeneration;
	AxisOperationModeState[recordBase + 25]$UDINT := ds402StatusWord;
	AxisOperationModeState[recordBase + 26]$UDINT := contextCheck;
	AxisOperationModeState[recordBase + 27]$UDINT := AdmissionToken;
	AxisOperationModeState[recordBase + 28]$UDINT := OwnerGeneration;
	AxisOperationModeState[recordBase + 29]$UDINT := CallerSessionEpoch;
	AxisOperationModeState[recordBase + 30]$UDINT := RequestSequence;
	AxisOperationModeState[recordBase + 31]$UDINT := LMC_DIAG_MODE_RECORD_MAGIC;
	AxisOperationModeState[LMC_DIAG_MODE_META_RECORD_GENERATION]$UDINT :=
		nextRecordGeneration;
	AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT :=
		nextOperationToken;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
		LMC_DIAG_MODE_STAGE_PREFLIGHT_START;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS] := TO_DINT(axisReference);
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_RECORD_BASE] := recordBase;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT :=
		nextOperationToken;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_ADMISSION_TOKEN]$UDINT :=
		AdmissionToken;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_OWNER_GENERATION]$UDINT :=
		OwnerGeneration;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SESSION]$UDINT :=
		CallerSessionEpoch;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SEQUENCE]$UDINT :=
		RequestSequence;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_START_MS]$UDINT := ops.tAbsolute;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_TIMEOUT_MS]$UDINT :=
		timeoutMilliseconds;
	AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA] := TO_DINT(requestedMode);
	AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_RUNNING;

	_memset(dest:=pResponse, usByte:=0, cntr:=24);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 0;
	(pResponse + 6)^$INT := 0;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := 0;
	(pResponse + 16)^$DINT := TO_DINT(requestedMode);
	(pResponse + 20)^$UDINT := 0;
	ResponseSize := 24;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisSetOperationModeOutcome
	VAR_INPUT
		Reference : UINT;
		pRequest : ^USINT;
		pResponse : ^USINT;
		ResponseCapacity : UDINT;
		CallerSessionEpoch : UDINT;
		RequestSize : UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize : DINT;
	END_VAR
	VAR
		schemaVersion, requestFlags, keySchema, keyReserved : UINT;
		requestId, diagnosticsBuild, bootId, mapRevision : UDINT;
		originalRequestId, intent0, intent1, intent2, intent3 : UDINT;
		timeoutMilliseconds, operationFlags, currentBootId, detailCode : UDINT;
		evidenceFlags, startCycle, completionCycle : UDINT;
		requestedMode : SINT;
		axisReference : UINT;
		reservedByte : USINT;
		recordBase : DINT;
		recordState : DINT;
		recordValid, keyValid, stateValid : BOOL;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	_memset(dest:=pResponse, usByte:=0, cntr:=16);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	detailCode := 5;
	requestId := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := detailCode;
	ResponseSize := 16;

	if (pRequest = NIL) | (RequestSize <> 56) then
		RETURN;
	end_if;

	schemaVersion := pRequest^$UINT;
	requestFlags := (pRequest + 2)^$UINT;
	keySchema := (pRequest + 8)^$UINT;
	keyReserved := (pRequest + 10)^$UINT;
	diagnosticsBuild := (pRequest + 12)^$UDINT;
	bootId := (pRequest + 16)^$UDINT;
	mapRevision := (pRequest + 20)^$UDINT;
	originalRequestId := (pRequest + 24)^$UDINT;
	intent0 := (pRequest + 28)^$UDINT;
	intent1 := (pRequest + 32)^$UDINT;
	intent2 := (pRequest + 36)^$UDINT;
	intent3 := (pRequest + 40)^$UDINT;
	axisReference := (pRequest + 44)^$UINT;
	requestedMode := (pRequest + 46)^$SINT;
	reservedByte := (pRequest + 47)^$USINT;
	timeoutMilliseconds := (pRequest + 48)^$UDINT;
	operationFlags := (pRequest + 52)^$UDINT;
	currentBootId := GetDiagnosticsBootId();

	if (schemaVersion <> 1) | (keySchema <> 1) then
		detailCode := 1;
	elsif requestFlags <> 0 then
		detailCode := 2;
	elsif requestId = 0 then
		detailCode := 3;
	elsif (Reference < 1) | (Reference > 4) |
	      (axisReference <> Reference) then
		detailCode := 4;
	elsif (keyReserved <> 0) | (reservedByte <> 0) |
	      (originalRequestId = 0) |
	      ((intent0 = 0) & (intent1 = 0) &
	       (intent2 = 0) & (intent3 = 0)) |
	      (timeoutMilliseconds = 0) | (operationFlags <> 0) then
		detailCode := 5;
	elsif diagnosticsBuild <> 1 then
		detailCode := 16;
	elsif (currentBootId = 0) | (bootId <> currentBootId) then
		detailCode := 17;
	elsif mapRevision <> LMC_DIAG_MAP_REVISION then
		detailCode := 18;
	elsif (requestedMode <> 8) &
	      ((LMC_DIAG_SET_OPERATION_MODE_SOFTWARE_MODES = FALSE) |
	       ((requestedMode <> 1) & (requestedMode <> 3) & (requestedMode <> 7))) then
		detailCode := LMC_DIAG_MODE_DETAIL_KEY_MISMATCH;
	else
		detailCode := 0;
	end_if;

	if detailCode <> 0 then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;

	recordBase := TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE;
	recordState := AxisOperationModeState[recordBase];
	recordValid :=
		(sizeof(AxisOperationModeState) = 768) &
		(AxisOperationModeState[recordBase + 31]$UDINT =
		 LMC_DIAG_MODE_RECORD_MAGIC) &
		(AxisOperationModeState[recordBase + 22]$UDINT <> 0) &
		(AxisOperationModeState[recordBase + 17]$UDINT <> 0) &
		(AxisOperationModeState[recordBase + 19]$UDINT <> 0);
	if recordState = LMC_DIAG_MODE_RECORD_EMPTY then
		detailCode := LMC_DIAG_MODE_DETAIL_NOT_FOUND;
	elsif recordValid = FALSE then
		detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
	end_if;

	keyValid := FALSE;
	if detailCode = 0 then
		keyValid :=
			(AxisOperationModeState[recordBase + 1]$UDINT = diagnosticsBuild) &
			(AxisOperationModeState[recordBase + 2]$UDINT = bootId) &
			(AxisOperationModeState[recordBase + 3]$UDINT = mapRevision) &
			(AxisOperationModeState[recordBase + 4]$UDINT = originalRequestId) &
			(AxisOperationModeState[recordBase + 5]$UDINT = intent0) &
			(AxisOperationModeState[recordBase + 6]$UDINT = intent1) &
			(AxisOperationModeState[recordBase + 7]$UDINT = intent2) &
			(AxisOperationModeState[recordBase + 8]$UDINT = intent3) &
			(AxisOperationModeState[recordBase + 9]$UINT = axisReference) &
			(AxisOperationModeState[recordBase + 10]$SINT = requestedMode) &
			(AxisOperationModeState[recordBase + 12]$UDINT = timeoutMilliseconds) &
			(AxisOperationModeState[recordBase + 13]$UDINT = operationFlags);
		if keyValid = FALSE then
			detailCode := LMC_DIAG_MODE_DETAIL_KEY_MISMATCH;
		end_if;
	end_if;

	if detailCode = 0 then
		if recordState = LMC_DIAG_MODE_RECORD_QUARANTINED then
			detailCode := LMC_DIAG_MODE_DETAIL_INDETERMINATE;
		elsif (recordState <> LMC_DIAG_MODE_RECORD_RUNNING) &
		      (recordState <> LMC_DIAG_MODE_RECORD_SUCCEEDED) &
		      (recordState <> LMC_DIAG_MODE_RECORD_FAILED) &
		      (recordState <> LMC_DIAG_MODE_RECORD_ABORTED) then
			detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
		end_if;
	end_if;

	if detailCode = 0 then
		evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT;
		startCycle := AxisOperationModeState[recordBase + 19]$UDINT;
		completionCycle := AxisOperationModeState[recordBase + 20]$UDINT;
		stateValid := (evidenceFlags and 0xFFFFFFC0) = 0;
		if (evidenceFlags and LMC_DIAG_MODE_EVIDENCE_WRITE_DISPATCHED) <> 0 then
			stateValid := stateValid &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_WRITE_REQUESTED) <> 0);
		end_if;
		if (evidenceFlags and LMC_DIAG_MODE_EVIDENCE_VERIFY_COMPLETED) <> 0 then
			stateValid := stateValid &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_VERIFY_DISPATCHED) <> 0);
		end_if;
		if recordState = LMC_DIAG_MODE_RECORD_RUNNING then
			stateValid := stateValid & (completionCycle = 0) &
				(AxisOperationModeState[recordBase + 14] = 0) &
				(AxisOperationModeState[recordBase + 15] = 0) &
				(AxisOperationModeState[recordBase + 16] = 0) &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED) = 0) &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE) = 0) &
				(AxisOperationModeState[recordBase + 24] = 0);
		else
			stateValid := stateValid & (completionCycle >= startCycle) &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED) <> 0) &
				((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE) <> 0) &
				(AxisOperationModeState[recordBase + 24] = 0);
			if recordState = LMC_DIAG_MODE_RECORD_SUCCEEDED then
				stateValid := stateValid &
					(AxisOperationModeState[recordBase + 11]$SINT = requestedMode) &
					(AxisOperationModeState[recordBase + 14] = 0) &
					(AxisOperationModeState[recordBase + 15] = 0) &
					(AxisOperationModeState[recordBase + 16] = 0) &
					((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_VERIFY_DISPATCHED) <> 0) &
					((evidenceFlags and LMC_DIAG_MODE_EVIDENCE_VERIFY_COMPLETED) <> 0);
			else
				stateValid := stateValid &
					(AxisOperationModeState[recordBase + 14] = 1) &
					(AxisOperationModeState[recordBase + 15]$INT = LMC_DIAG_ADMIN_ERROR_ID) &
					((AxisOperationModeState[recordBase + 16]$UDINT =
					  LMC_DIAG_MODE_DETAIL_UNSAFE) |
					 (AxisOperationModeState[recordBase + 16]$UDINT =
					  LMC_DIAG_MODE_DETAIL_EXECUTION));
			end_if;
		end_if;
		if stateValid = FALSE then
			detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
		end_if;
	end_if;

	if detailCode <> 0 then
		(pResponse + 12)^$UDINT := detailCode;
		RETURN;
	end_if;
	if ResponseCapacity < 112 then
		ResponseSize := -1;
		RETURN;
	end_if;

	_memset(dest:=pResponse, usByte:=0, cntr:=112);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 0;
	(pResponse + 6)^$INT := 0;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := 0;
	(pResponse + 16)^$UINT := AxisOperationModeState[recordBase]$UINT;
	(pResponse + 20)^$UDINT := AxisOperationModeState[recordBase + 1]$UDINT;
	(pResponse + 24)^$UDINT := AxisOperationModeState[recordBase + 2]$UDINT;
	(pResponse + 28)^$UDINT := AxisOperationModeState[recordBase + 3]$UDINT;
	(pResponse + 32)^$UDINT := AxisOperationModeState[recordBase + 4]$UDINT;
	(pResponse + 36)^$UDINT := AxisOperationModeState[recordBase + 5]$UDINT;
	(pResponse + 40)^$UDINT := AxisOperationModeState[recordBase + 6]$UDINT;
	(pResponse + 44)^$UDINT := AxisOperationModeState[recordBase + 7]$UDINT;
	(pResponse + 48)^$UDINT := AxisOperationModeState[recordBase + 8]$UDINT;
	(pResponse + 52)^$UINT := AxisOperationModeState[recordBase + 9]$UINT;
	(pResponse + 54)^$SINT := AxisOperationModeState[recordBase + 10]$SINT;
	(pResponse + 55)^$SINT := AxisOperationModeState[recordBase + 11]$SINT;
	(pResponse + 56)^$UDINT := AxisOperationModeState[recordBase + 12]$UDINT;
	(pResponse + 60)^$UDINT := AxisOperationModeState[recordBase + 13]$UDINT;
	(pResponse + 64)^$UINT := AxisOperationModeState[recordBase + 14]$UINT;
	(pResponse + 66)^$INT := AxisOperationModeState[recordBase + 15]$INT;
	(pResponse + 68)^$UDINT := AxisOperationModeState[recordBase + 16]$UDINT;
	(pResponse + 72)^$UDINT := AxisOperationModeState[recordBase + 17]$UDINT;
	(pResponse + 76)^$UDINT := AxisOperationModeState[recordBase + 18]$UDINT;
	(pResponse + 80)^$UDINT := AxisOperationModeState[recordBase + 19]$UDINT;
	(pResponse + 84)^$UDINT := AxisOperationModeState[recordBase + 20]$UDINT;
	(pResponse + 88)^$UDINT := 0;
	(pResponse + 92)^$UDINT := AxisOperationModeState[recordBase + 22]$UDINT;
	(pResponse + 96)^$SINT := AxisOperationModeState[recordBase + 23]$SINT;
	(pResponse + 100)^$UDINT := AxisOperationModeState[recordBase + 24]$UDINT;
	(pResponse + 104)^$UINT := AxisOperationModeState[recordBase + 25]$UINT;
	(pResponse + 108)^$UDINT := AxisOperationModeState[recordBase + 26]$UDINT;
	ResponseSize := 112;

END_FUNCTION


FUNCTION LMCDiagnosticsService::HandleAxisSetOperationModeRetire
	VAR_INPUT
		Reference : UINT;
		pRequest : ^USINT;
		pResponse : ^USINT;
		ResponseCapacity : UDINT;
		CallerSessionEpoch : UDINT;
		RequestSize : UDINT;
	END_VAR
	VAR_OUTPUT
		ResponseSize : DINT;
	END_VAR
	VAR
		requestId, expectedRecordGeneration, returnedGeneration, detailCode : UDINT;
		axisReference, returnedState : UINT;
		recordBase : DINT;
	END_VAR

	ResponseSize := -1;
	if (pResponse = NIL) | (ResponseCapacity < 16) then
		RETURN;
	end_if;
	_memset(dest:=pResponse, usByte:=0, cntr:=16);
	pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
	(pResponse + 4)^$UINT := 1;
	(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
	requestId := 0;
	if (pRequest <> NIL) & (RequestSize >= 8) then
		requestId := (pRequest + 4)^$UDINT;
	end_if;
	(pResponse + 8)^$UDINT := requestId;
	(pResponse + 12)^$UDINT := 5;
	ResponseSize := 16;

	if (pRequest = NIL) | (RequestSize <> 60) then
		RETURN;
	end_if;
	expectedRecordGeneration := (pRequest + 56)^$UDINT;
	if expectedRecordGeneration = 0 then
		RETURN;
	end_if;
	if ResponseCapacity < 112 then
		ResponseSize := -1;
		RETURN;
	end_if;

	ResponseSize := HandleAxisSetOperationModeOutcome(
		Reference:=Reference,
		pRequest:=pRequest,
		pResponse:=pResponse,
		ResponseCapacity:=ResponseCapacity,
		CallerSessionEpoch:=CallerSessionEpoch,
		RequestSize:=56);
	if ResponseSize <> 112 then
		RETURN;
	end_if;

	returnedState := (pResponse + 16)^$UINT;
	returnedGeneration := (pResponse + 92)^$UDINT;
	if returnedGeneration <> expectedRecordGeneration then
		detailCode := LMC_DIAG_MODE_DETAIL_KEY_MISMATCH;
	elsif returnedState = LMC_DIAG_MODE_RECORD_RUNNING then
		detailCode := LMC_DIAG_MODE_DETAIL_INDETERMINATE;
	elsif (returnedState <> LMC_DIAG_MODE_RECORD_SUCCEEDED) &
	      (returnedState <> LMC_DIAG_MODE_RECORD_FAILED) &
	      (returnedState <> LMC_DIAG_MODE_RECORD_ABORTED) then
		detailCode := LMC_DIAG_MODE_DETAIL_STORE_CORRUPT;
	else
		detailCode := 0;
	end_if;

	if detailCode <> 0 then
		_memset(dest:=pResponse, usByte:=0, cntr:=16);
		pResponse^$UINT := LMC_DIAG_SCHEMA_VERSION;
		(pResponse + 4)^$UINT := 1;
		(pResponse + 6)^$INT := LMC_DIAG_ADMIN_ERROR_ID;
		(pResponse + 8)^$UDINT := requestId;
		(pResponse + 12)^$UDINT := detailCode;
		ResponseSize := 16;
		RETURN;
	end_if;

	axisReference := (pRequest + 44)^$UINT;
	recordBase := TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE;
	_memset(dest:=#AxisOperationModeState[recordBase], usByte:=0,
		cntr:=LMC_DIAG_MODE_RECORD_STRIDE * 4);
	ResponseSize := 112;

END_FUNCTION


FUNCTION LMCDiagnosticsService::ProcessAxisSetOperationMode
	VAR
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		startupSnapshot : ARRAY [0..11] OF UDINT;
		preemptionSnapshot : ARRAY [0..199] OF USINT;
		stage, recordBase, finalRecordState : DINT;
		recoveryScanAxis, recoveryScanBase : DINT;
		axisReference, preemptionCleanupKind : UINT;
		axisMask, currentToken, evidenceFlags, serviceNow : UDINT;
		startMs, timeoutMs, elapsedMs, remainingMs : UDINT;
		currentCycle, selectedAxisStatus, selectedStatusWord : UDINT;
		contextCheck, failureDetail, quarantineReason, nextToken : UDINT;
		safetyAdmissionToken, safetyOwnerGeneration, preemptionStartMs : UDINT;
		copyResult, completionResult, orphanResult, ownerResult : DINT;
		preemptionResult : DINT;
		startResult : iprStates;
		observedMode : SINT;
		executorConnected, executorReusable, safetyReady, expired : BOOL;
		recoveryCandidateFound, preemptionSnapshotValid : BOOL;
		writeDispatched, publishPreemptionCleanup : BOOL;
	END_VAR

	stage := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE];
	if stage = 0 then
		// Warm-start recovery is admitted only for one exact Running record that
		// proves the 0x6060 write was already dispatched. Never reconstruct a
		// pre-write stage because that could replay the mutation.
		recoveryCandidateFound := FALSE;
		recoveryScanAxis := 1;
		while recoveryScanAxis <= 4 do
			recoveryScanBase :=
				(recoveryScanAxis - 1) * LMC_DIAG_MODE_RECORD_STRIDE;
			if (AxisOperationModeState[recoveryScanBase] =
			    LMC_DIAG_MODE_RECORD_RUNNING) &
			   (AxisOperationModeState[recoveryScanBase + 31]$UDINT =
			    LMC_DIAG_MODE_RECORD_MAGIC) &
			   ((AxisOperationModeState[recoveryScanBase + 18]$UDINT and
			     LMC_DIAG_MODE_EVIDENCE_WRITE_DISPATCHED) <> 0) &
			   ((AxisOperationModeState[recoveryScanBase + 18]$UDINT and
			     LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED) = 0) &
			   (AxisOperationModeState[recoveryScanBase + 9] = recoveryScanAxis) &
			   ((AxisOperationModeState[recoveryScanBase + 10]$SINT = 8) |
			    ((LMC_DIAG_SET_OPERATION_MODE_SOFTWARE_MODES <> FALSE) &
			     ((AxisOperationModeState[recoveryScanBase + 10]$SINT = 1) |
			      (AxisOperationModeState[recoveryScanBase + 10]$SINT = 3) |
			      (AxisOperationModeState[recoveryScanBase + 10]$SINT = 7)))) &
			   (AxisOperationModeState[recoveryScanBase + 22]$UDINT <> 0) &
			   (AxisOperationModeState[recoveryScanBase + 27]$UDINT <> 0) &
			   (AxisOperationModeState[recoveryScanBase + 28]$UDINT <> 0) &
			   (AxisOperationModeState[recoveryScanBase + 29]$UDINT <> 0) &
			   (AxisOperationModeState[recoveryScanBase + 30]$UDINT <> 0) then
				if recoveryCandidateFound then
					// More than one candidate violates the singleton SDO owner model.
					// Clear the first staged candidate before returning so a later cycle
					// cannot continue recovery from an ambiguous retained set.
					_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
						usByte:=0, cntr:=32 * 4);
					RETURN;
				end_if;
				recoveryCandidateFound := TRUE;
				_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
					usByte:=0, cntr:=32 * 4);
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_START;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS] := recoveryScanAxis;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_RECORD_BASE] := recoveryScanBase;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 17]$UDINT;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_ADMISSION_TOKEN]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 27]$UDINT;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_OWNER_GENERATION]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 28]$UDINT;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SESSION]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 29]$UDINT;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SEQUENCE]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 30]$UDINT;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_START_MS]$UDINT := ops.tAbsolute;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_TIMEOUT_MS]$UDINT :=
					LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA] :=
					AxisOperationModeState[recoveryScanBase + 10];
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON]$UDINT :=
					AxisOperationModeState[recoveryScanBase + 24]$UDINT;
			end_if;
			recoveryScanAxis += 1;
		end_while;
		if recoveryCandidateFound = FALSE then
			RETURN;
		end_if;
		stage := LMC_DIAG_MODE_STAGE_RECOVERY_START;
	end_if;
	axisReference := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS]$UINT;
	recordBase := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_RECORD_BASE];
	if (axisReference < 1) | (axisReference > 4) |
	   (recordBase < 0) | (recordBase > 96) |
	   (recordBase <> TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE) then
		// Runtime metadata is corrupt and no trustworthy owner identity can be
		// reconstructed here. Keep the operation inert for startup recovery.
		RETURN;
	end_if;
	if (AxisOperationModeState[recordBase + 31]$UDINT <>
	    LMC_DIAG_MODE_RECORD_MAGIC) |
	   (AxisOperationModeState[recordBase] = LMC_DIAG_MODE_RECORD_EMPTY) then
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
			LMC_DIAG_MODE_QUARANTINE_CALLBACK;
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
			LMC_DIAG_MODE_STAGE_QUARANTINE;
		RETURN;
	end_if;

	axisMask := TO_UDINT(1) shl TO_UDINT(axisReference - 1);
	currentToken := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT;
	evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT;
	serviceNow := ops.tAbsolute;

	// Safety preemption has priority over feature activation and over every
	// normal SetOperationMode stage. PENDING_FREEZE changes no local runtime.
	// After the 0x6060 irreversible-dispatch boundary, cleanup never starts a
	// new SDO; it only drains the exact outstanding token and quarantines.
	_memset(dest:=#preemptionSnapshot[0], usByte:=0,
		cntr:=sizeof(preemptionSnapshot));
	preemptionResult := -1;
	if IsClientConnected(#AxisOwnership) &
	   (AxisOperationModeState[recordBase + 27]$UDINT <> 0) &
	   (AxisOperationModeState[recordBase + 28]$UDINT <> 0) then
		preemptionResult := AxisOwnership.CopyAxisOwnershipPreemption(
			PreemptedAdmissionToken:=AxisOperationModeState[recordBase + 27]$UDINT,
			PreemptedOwnerGeneration:=AxisOperationModeState[recordBase + 28]$UDINT,
			pDest:=#preemptionSnapshot[0],
			DestSize:=sizeof(preemptionSnapshot));
	end_if;
	if preemptionResult = LMC_DIAG_PREEMPT_PENDING_FREEZE then
		RETURN;
	end_if;
	if (preemptionResult < 0) |
	   (preemptionResult > LMC_DIAG_PREEMPT_CLEANUP_QUARANTINED) then
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
			LMC_DIAG_MODE_QUARANTINE_SAFETY_PREEMPT;
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
			LMC_DIAG_MODE_STAGE_QUARANTINE;
		RETURN;
	end_if;
	if preemptionResult = 0 then
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_PREEMPT_START_MS] := 0;
	else
		preemptionSnapshotValid :=
			(preemptionSnapshot[0]$UDINT = LMC_DIAG_PREEMPT_SNAPSHOT_MAGIC) &
			(preemptionSnapshot[4]$UDINT = LMC_DIAG_PREEMPT_SNAPSHOT_VERSION) &
			(preemptionSnapshot[8]$UDINT = LMC_DIAG_PREEMPT_SNAPSHOT_HEADER_SIZE) &
			(preemptionSnapshot[12]$UDINT = LMC_DIAG_MODE_PREEMPT_SNAPSHOT_SIZE) &
			(preemptionSnapshot[16]$DINT = preemptionResult) &
			(preemptionSnapshot[32]$UDINT = axisMask) &
			(preemptionSnapshot[36]$UDINT = AxisOperationModeState[recordBase + 27]$UDINT) &
			(preemptionSnapshot[40]$UDINT = AxisOperationModeState[recordBase + 28]$UDINT) &
			(preemptionSnapshot[44]$UDINT = AxisOperationModeState[recordBase + 29]$UDINT) &
			(preemptionSnapshot[48]$UDINT = AxisOperationModeState[recordBase + 30]$UDINT) &
			(preemptionSnapshot[52]$UDINT = 0x7D23) &
			(preemptionSnapshot[56]$UDINT = TO_UDINT(axisReference)) &
			(preemptionSnapshot[60]$UDINT = LMC_DIAG_MODE_OWNER_KIND) &
			(preemptionSnapshot[64]$UDINT = LMC_DIAG_MODE_RESOURCE_KIND) &
			(preemptionSnapshot[68]$UDINT = LMC_DIAG_MODE_ADMISSION_MODE) &
			(preemptionSnapshot[72]$UDINT = LMC_DIAG_OWNER_STATE_AXIS_OPERATION_MODE_ACTIVE) &
			(preemptionSnapshot[76]$UDINT = 56) &
			((preemptionSnapshot[104]$UDINT and axisMask) = axisMask) &
			(preemptionSnapshot[108]$UDINT <> 0) &
			(preemptionSnapshot[112]$UDINT <> 0) &
			((preemptionSnapshot[124]$UDINT = LMC_DIAG_OWNER_STATE_SAFETY_PREEMPTING) |
			 (preemptionSnapshot[124]$UDINT = LMC_DIAG_OWNER_STATE_QUARANTINED)) &
			(preemptionSnapshot[136]$UDINT = LMC_DIAG_ADMISSION_SAFETY) &
			(preemptionSnapshot[144]$UINT = LMC_DIAG_SCHEMA_VERSION) &
			(preemptionSnapshot[146]$UINT = 0) &
			(preemptionSnapshot[148]$UDINT = AxisOperationModeState[recordBase + 4]$UDINT) &
			(preemptionSnapshot[152]$UINT = LMC_DIAG_SCHEMA_VERSION) &
			(preemptionSnapshot[154]$UINT = 0) &
			(preemptionSnapshot[156]$UDINT = AxisOperationModeState[recordBase + 1]$UDINT) &
			(preemptionSnapshot[160]$UDINT = AxisOperationModeState[recordBase + 2]$UDINT) &
			(preemptionSnapshot[164]$UDINT = AxisOperationModeState[recordBase + 3]$UDINT) &
			(preemptionSnapshot[168]$UDINT = AxisOperationModeState[recordBase + 4]$UDINT) &
			(preemptionSnapshot[172]$UDINT = AxisOperationModeState[recordBase + 5]$UDINT) &
			(preemptionSnapshot[176]$UDINT = AxisOperationModeState[recordBase + 6]$UDINT) &
			(preemptionSnapshot[180]$UDINT = AxisOperationModeState[recordBase + 7]$UDINT) &
			(preemptionSnapshot[184]$UDINT = AxisOperationModeState[recordBase + 8]$UDINT) &
			(preemptionSnapshot[188]$UINT = axisReference) &
			(preemptionSnapshot[190]$SINT = AxisOperationModeState[recordBase + 10]$SINT) &
			(preemptionSnapshot[191]$USINT = 0) &
			(preemptionSnapshot[192]$UDINT = AxisOperationModeState[recordBase + 12]$UDINT) &
			(preemptionSnapshot[196]$UDINT = AxisOperationModeState[recordBase + 13]$UDINT);
		if preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_REQUIRED then
			preemptionSnapshotValid := preemptionSnapshotValid &
				((preemptionSnapshot[24]$UDINT and axisMask) = axisMask) &
				((preemptionSnapshot[28]$UDINT and axisMask) = 0);
		elsif preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_COMPLETE then
			preemptionSnapshotValid := preemptionSnapshotValid &
				((preemptionSnapshot[28]$UDINT and axisMask) = axisMask);
		end_if;
		if preemptionSnapshotValid = FALSE then
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
				LMC_DIAG_MODE_QUARANTINE_SAFETY_PREEMPT;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
				LMC_DIAG_MODE_STAGE_QUARANTINE;
			RETURN;
		end_if;

		currentCycle := AxisOperationModeState[recordBase + 19]$UDINT;
		_memset(dest:=#startupSnapshot[0], usByte:=0, cntr:=sizeof(startupSnapshot));
		copyResult := -1;
		if IsClientConnected(#InputLatch) then
			copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
				pDest:=#startupSnapshot[0], DestSize:=sizeof(startupSnapshot));
		end_if;
		if (copyResult = 0) &
		   (startupSnapshot[0] = LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) &
		   (startupSnapshot[1] >= currentCycle) then
			currentCycle := startupSnapshot[1];
			AxisOperationModeState[recordBase + 25]$UDINT :=
				startupSnapshot[TO_DINT(5 + axisReference)];
			AxisOperationModeState[recordBase + 26]$UDINT := startupSnapshot[10];
		end_if;
		if currentCycle = 0 then currentCycle := 1; end_if;

		if preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_COMPLETE then
			evidenceFlags := evidenceFlags or
				LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED or
				LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] := LMC_DIAG_MODE_DETAIL_UNSAFE;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			AxisOperationModeState[recordBase + 24] := 0;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_ABORTED;
			_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
				usByte:=0, cntr:=32 * 4);
			RETURN;
		elsif preemptionResult = LMC_DIAG_PREEMPT_CLEANUP_QUARANTINED then
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] := LMC_DIAG_MODE_DETAIL_INDETERMINATE;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			AxisOperationModeState[recordBase + 24] :=
				LMC_DIAG_MODE_QUARANTINE_SAFETY_PREEMPT;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_QUARANTINED;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
				LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD;
			RETURN;
		end_if;

		safetyAdmissionToken := preemptionSnapshot[108]$UDINT;
		safetyOwnerGeneration := preemptionSnapshot[112]$UDINT;
		preemptionStartMs := AxisOperationModeState[
			LMC_DIAG_MODE_RUNTIME_PREEMPT_START_MS]$UDINT;
		if preemptionStartMs = 0 then
			preemptionStartMs := serviceNow;
			if preemptionStartMs = 0 then preemptionStartMs := 1; end_if;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_PREEMPT_START_MS]$UDINT :=
				preemptionStartMs;
		end_if;
		writeDispatched :=
			(evidenceFlags and LMC_DIAG_MODE_EVIDENCE_WRITE_DISPATCHED) <> 0;

		executorConnected := FALSE;
		executorReusable := FALSE;
		case axisReference of
			1:
				executorConnected := IsClientConnected(#SdoAxis1) <> 0;
				if executorConnected then executorReusable := SdoAxis1.IsReusable(); end_if;
			2:
				executorConnected := IsClientConnected(#SdoAxis2) <> 0;
				if executorConnected then executorReusable := SdoAxis2.IsReusable(); end_if;
			3:
				executorConnected := IsClientConnected(#SdoAxis3) <> 0;
				if executorConnected then executorReusable := SdoAxis3.IsReusable(); end_if;
			4:
				executorConnected := IsClientConnected(#SdoAxis4) <> 0;
				if executorConnected then executorReusable := SdoAxis4.IsReusable(); end_if;
		end_case;
		completionResult := -2;
		if executorConnected & (executorReusable = FALSE) then
			case axisReference of
				1: completionResult := SdoAxis1.CopyCompletion(currentToken, #completion, sizeof(completion));
				2: completionResult := SdoAxis2.CopyCompletion(currentToken, #completion, sizeof(completion));
				3: completionResult := SdoAxis3.CopyCompletion(currentToken, #completion, sizeof(completion));
				4: completionResult := SdoAxis4.CopyCompletion(currentToken, #completion, sizeof(completion));
			end_case;
			if completionResult = 0 then
				executorReusable := TRUE;
				evidenceFlags := evidenceFlags or
					LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
				AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
			elsif ((completionResult = -2) | (completionResult = -3)) &
			      ((serviceNow - preemptionStartMs) >=
			       LMC_DIAG_MODE_PREEMPT_DRAIN_TIMEOUT_MS) then
				orphanResult := -1;
				case axisReference of
					1: orphanResult := SdoAxis1.MarkOrphan(currentToken);
					2: orphanResult := SdoAxis2.MarkOrphan(currentToken);
					3: orphanResult := SdoAxis3.MarkOrphan(currentToken);
					4: orphanResult := SdoAxis4.MarkOrphan(currentToken);
				end_case;
			end_if;
		end_if;

		publishPreemptionCleanup := executorReusable |
			(executorConnected = FALSE) | (completionResult < -3) |
			((serviceNow - preemptionStartMs) >=
			 LMC_DIAG_MODE_PREEMPT_DRAIN_TIMEOUT_MS);
		if publishPreemptionCleanup = FALSE then
			RETURN;
		end_if;
		if (writeDispatched = FALSE) & executorReusable then
			preemptionCleanupKind := LMC_DIAG_PREEMPT_CLEANUP_SAFE;
		else
			if executorReusable then
				preemptionCleanupKind :=
					LMC_DIAG_PREEMPT_CLEANUP_COMPLETE_QUARANTINE;
			else
				preemptionCleanupKind :=
					LMC_DIAG_PREEMPT_CLEANUP_INCOMPLETE_QUARANTINE;
			end_if;
		end_if;

		ownerResult := AxisOwnership.PublishAxisOwnershipPreemptionCleanup(
			ExpectedAxisMask:=axisMask,
			PreemptedAdmissionToken:=AxisOperationModeState[recordBase + 27]$UDINT,
			PreemptedOwnerGeneration:=AxisOperationModeState[recordBase + 28]$UDINT,
			SafetyAdmissionToken:=safetyAdmissionToken,
			SafetyOwnerGeneration:=safetyOwnerGeneration,
			CleanupKind:=preemptionCleanupKind,
			ReportValue0:=AxisOperationModeState[recordBase + 22]$UDINT,
			ReportValue1:=currentToken,
			ObservationCycle:=currentCycle);
		if (ownerResult <> 0) & (ownerResult <> 1) then
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] := LMC_DIAG_MODE_DETAIL_INDETERMINATE;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			AxisOperationModeState[recordBase + 24] :=
				LMC_DIAG_MODE_QUARANTINE_SAFETY_PREEMPT;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_QUARANTINED;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
				LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD;
			RETURN;
		end_if;

		if preemptionCleanupKind = LMC_DIAG_PREEMPT_CLEANUP_SAFE then
			evidenceFlags := evidenceFlags or
				LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED or
				LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] := LMC_DIAG_MODE_DETAIL_UNSAFE;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			AxisOperationModeState[recordBase + 24] := 0;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_ABORTED;
			_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
				usByte:=0, cntr:=32 * 4);
		else
			if executorReusable then
				AxisOperationModeState[recordBase + 18]$UDINT :=
					evidenceFlags or LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			end_if;
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] := LMC_DIAG_MODE_DETAIL_INDETERMINATE;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			AxisOperationModeState[recordBase + 24] :=
				LMC_DIAG_MODE_QUARANTINE_SAFETY_PREEMPT;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_QUARANTINED;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
				LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD;
		end_if;
		RETURN;
	end_if;

	// Once dispatch evidence exists, no state repair is allowed to return to
	// the 0x6060 write stage. Torn/restarted pre-write metadata is normalized
	// directly into the read-only recovery path.
	if (evidenceFlags and LMC_DIAG_MODE_EVIDENCE_WRITE_DISPATCHED) <> 0 then
		if (stage = LMC_DIAG_MODE_STAGE_PREFLIGHT_START) |
		   (stage = LMC_DIAG_MODE_STAGE_PREFLIGHT_WAIT) |
		   (stage = LMC_DIAG_MODE_STAGE_WRITE_START) then
			stage := LMC_DIAG_MODE_STAGE_RECOVERY_START;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] := stage;
		end_if;
		if (LMC_DIAG_SET_OPERATION_MODE_ENABLED = FALSE) &
		   ((stage = LMC_DIAG_MODE_STAGE_WRITE_WAIT) |
		    (stage = LMC_DIAG_MODE_STAGE_VERIFY_START) |
		    (stage = LMC_DIAG_MODE_STAGE_VERIFY_WAIT)) then
			stage := LMC_DIAG_MODE_STAGE_RECOVERY_START;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] := stage;
		end_if;
	elsif (LMC_DIAG_SET_OPERATION_MODE_ENABLED = FALSE) &
	      ((stage = LMC_DIAG_MODE_STAGE_PREFLIGHT_START) |
	       (stage = LMC_DIAG_MODE_STAGE_PREFLIGHT_WAIT) |
	       (stage = LMC_DIAG_MODE_STAGE_WRITE_START) |
	       (stage = LMC_DIAG_MODE_STAGE_WRITE_WAIT) |
	       (stage = LMC_DIAG_MODE_STAGE_VERIFY_START) |
	       (stage = LMC_DIAG_MODE_STAGE_VERIFY_WAIT)) then
		// OFF builds never dispatch a new mutation. Existing terminal/quarantine
		// cleanup remains available below.
		RETURN;
	end_if;

	case stage of
		LMC_DIAG_MODE_STAGE_PREFLIGHT_START,
		LMC_DIAG_MODE_STAGE_PREFLIGHT_WAIT,
		LMC_DIAG_MODE_STAGE_WRITE_START,
		LMC_DIAG_MODE_STAGE_WRITE_WAIT,
		LMC_DIAG_MODE_STAGE_VERIFY_START,
		LMC_DIAG_MODE_STAGE_VERIFY_WAIT:
			ProcessAxisSetOperationModeMutationStages();
		LMC_DIAG_MODE_STAGE_RECOVERY_START,
		LMC_DIAG_MODE_STAGE_RECOVERY_WAIT,
		LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS,
		LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE,
		LMC_DIAG_MODE_STAGE_QUARANTINE,
		LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD:
			ProcessAxisSetOperationModeRecoveryStages();
	else
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
			LMC_DIAG_MODE_QUARANTINE_CALLBACK;
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
			LMC_DIAG_MODE_STAGE_QUARANTINE;
	end_case;

END_FUNCTION


FUNCTION LMCDiagnosticsService::ProcessAxisSetOperationModeMutationStages
	VAR
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		startupSnapshot : ARRAY [0..11] OF UDINT;
		stage, recordBase, finalRecordState : DINT;
		axisReference : UINT;
		axisMask, currentToken, evidenceFlags, serviceNow : UDINT;
		startMs, timeoutMs, elapsedMs, remainingMs : UDINT;
		currentCycle, selectedAxisStatus, selectedStatusWord : UDINT;
		contextCheck, failureDetail, quarantineReason, nextToken : UDINT;
		copyResult, completionResult, orphanResult, ownerResult : DINT;
		startResult : iprStates;
		observedMode : SINT;
		executorConnected, executorReusable, safetyReady, expired : BOOL;
	END_VAR

	stage := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE];
	axisReference := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS]$UINT;
	recordBase := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_RECORD_BASE];
	if (axisReference < 1) | (axisReference > 4) |
	   (recordBase < 0) | (recordBase > 96) |
	   (recordBase <> TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE) then
		RETURN;
	end_if;
	axisMask := TO_UDINT(1) shl TO_UDINT(axisReference - 1);
	currentToken := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT;
	evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT;
	serviceNow := ops.tAbsolute;
	startMs := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_START_MS]$UDINT;
	timeoutMs := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_TIMEOUT_MS]$UDINT;
	elapsedMs := serviceNow - startMs;
	expired := elapsedMs >= timeoutMs;
	if expired then
		remainingMs := 1;
	else
		remainingMs := timeoutMs - elapsedMs;
		if remainingMs > 60000 then
			remainingMs := 60000;
		end_if;
		if remainingMs = 0 then
			remainingMs := 1;
		end_if;
	end_if;

	executorConnected := FALSE;
	executorReusable := FALSE;
	case axisReference of
		1:
			executorConnected := IsClientConnected(#SdoAxis1) <> 0;
			if executorConnected then executorReusable := SdoAxis1.IsReusable(); end_if;
		2:
			executorConnected := IsClientConnected(#SdoAxis2) <> 0;
			if executorConnected then executorReusable := SdoAxis2.IsReusable(); end_if;
		3:
			executorConnected := IsClientConnected(#SdoAxis3) <> 0;
			if executorConnected then executorReusable := SdoAxis3.IsReusable(); end_if;
		4:
			executorConnected := IsClientConnected(#SdoAxis4) <> 0;
			if executorConnected then executorReusable := SdoAxis4.IsReusable(); end_if;
	end_case;

	case stage of
		LMC_DIAG_MODE_STAGE_PREFLIGHT_START:
			if executorConnected = FALSE then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
					LMC_DIAG_MODE_DETAIL_EXECUTION;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
				RETURN;
			end_if;
			if executorReusable = FALSE then
				if expired then
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
						LMC_DIAG_MODE_DETAIL_UNSAFE;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
				end_if;
				RETURN;
			end_if;
			startResult := ERROR;
			case axisReference of
				1: startResult := SdoAxis1.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				2: startResult := SdoAxis2.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				3: startResult := SdoAxis3.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				4: startResult := SdoAxis4.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
			end_case;
			if startResult = READY then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_PREFLIGHT_WAIT;
			elsif startResult = ERROR then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
					LMC_DIAG_MODE_DETAIL_EXECUTION;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
			end_if;

		LMC_DIAG_MODE_STAGE_PREFLIGHT_WAIT:
			completionResult := -2;
			case axisReference of
				1: if executorConnected then completionResult := SdoAxis1.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				2: if executorConnected then completionResult := SdoAxis2.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				3: if executorConnected then completionResult := SdoAxis3.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				4: if executorConnected then completionResult := SdoAxis4.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
			end_case;
			if completionResult = 0 then
				executorReusable := TRUE;
				if (completion.ValidationCode <> 0) | (completion.OsResult <> 0) |
				   (completion.AbortCode <> 0) | (completion.ActualLength <> 1) |
				   (completion.ObjectIndex <> 0x6061) | (completion.SubIndex <> 0) |
				   (completion.IsWrite <> 0) then
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
						LMC_DIAG_MODE_DETAIL_EXECUTION;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
					RETURN;
				end_if;
				observedMode := (completion.Data and 0x000000FF)$SINT;
				AxisOperationModeState[recordBase + 11] := TO_DINT(observedMode);
				AxisOperationModeState[recordBase + 23] := TO_DINT(observedMode);
				if observedMode = AxisOperationModeState[recordBase + 10]$SINT then
					evidenceFlags := evidenceFlags or
						LMC_DIAG_MODE_EVIDENCE_VERIFY_DISPATCHED or
						LMC_DIAG_MODE_EVIDENCE_VERIFY_COMPLETED;
					AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS;
					RETURN;
				end_if;

				_memset(dest:=#startupSnapshot[0], usByte:=0, cntr:=sizeof(startupSnapshot));
				copyResult := -1;
				if IsClientConnected(#InputLatch) then
					copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
						pDest:=#startupSnapshot[0], DestSize:=sizeof(startupSnapshot));
				end_if;
				safetyReady := (copyResult = 0) &
					(startupSnapshot[0] = LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) &
					(startupSnapshot[1] <> 0) & (startupSnapshot[11] = 0) &
					((startupSnapshot[10] and LMC_DIAG_MODE_CONTEXT_PHYSICAL_VALID) <> 0) &
					(Ds402HomeState[92] = 0) &
					(EncoderMaintenanceState[152] = 0) &
					(((OperationState <> LMC_DIAG_SDO_STATE_QUEUED) &
					  (OperationState <> LMC_DIAG_SDO_STATE_RUNNING) &
					  (SdoInternalDrainState = 0)) |
					 (SdoSlaveReference <> axisReference)) & executorReusable;
				case axisReference of
					1: selectedAxisStatus := startupSnapshot[2]; selectedStatusWord := startupSnapshot[6];
					2: selectedAxisStatus := startupSnapshot[3]; selectedStatusWord := startupSnapshot[7];
					3: selectedAxisStatus := startupSnapshot[4]; selectedStatusWord := startupSnapshot[8];
					4: selectedAxisStatus := startupSnapshot[5]; selectedStatusWord := startupSnapshot[9];
				end_case;
				safetyReady := safetyReady &
					((selectedAxisStatus and LMC_DIAG_MODE_AXIS_STANDSTILL) <> 0) &
					((selectedStatusWord and LMC_DIAG_MODE_DS402_FAULT) = 0) &
					((selectedStatusWord and LMC_DIAG_MODE_DS402_OPERATION_ENABLED) = 0);
				AxisOperationModeState[recordBase + 25]$UDINT := selectedStatusWord;
				AxisOperationModeState[recordBase + 26]$UDINT := startupSnapshot[10];
				if safetyReady then
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_WRITE_START;
				else
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
						LMC_DIAG_MODE_DETAIL_UNSAFE;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
				end_if;
			elsif (completionResult = -2) | (completionResult = -3) then
				if expired then
					orphanResult := -1;
					case axisReference of
						1: if executorConnected then orphanResult := SdoAxis1.MarkOrphan(currentToken); end_if;
						2: if executorConnected then orphanResult := SdoAxis2.MarkOrphan(currentToken); end_if;
						3: if executorConnected then orphanResult := SdoAxis3.MarkOrphan(currentToken); end_if;
						4: if executorConnected then orphanResult := SdoAxis4.MarkOrphan(currentToken); end_if;
					end_case;
					if orphanResult <> -2 then
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
							LMC_DIAG_MODE_QUARANTINE_CALLBACK;
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
							LMC_DIAG_MODE_STAGE_QUARANTINE;
					end_if;
				end_if;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_CALLBACK;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE;
			end_if;

		LMC_DIAG_MODE_STAGE_WRITE_START:
			_memset(dest:=#startupSnapshot[0], usByte:=0, cntr:=sizeof(startupSnapshot));
			copyResult := -1;
			if IsClientConnected(#InputLatch) then
				copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
					pDest:=#startupSnapshot[0], DestSize:=sizeof(startupSnapshot));
			end_if;
			safetyReady := (copyResult = 0) &
				(startupSnapshot[0] = LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) &
				(startupSnapshot[1] <> 0) & (startupSnapshot[11] = 0) &
				((startupSnapshot[10] and LMC_DIAG_MODE_CONTEXT_PHYSICAL_VALID) <> 0) &
				(Ds402HomeState[92] = 0) & (EncoderMaintenanceState[152] = 0) &
				(((OperationState <> LMC_DIAG_SDO_STATE_QUEUED) &
				  (OperationState <> LMC_DIAG_SDO_STATE_RUNNING) &
				  (SdoInternalDrainState = 0)) |
				 (SdoSlaveReference <> axisReference)) & executorReusable;
			case axisReference of
				1: selectedAxisStatus := startupSnapshot[2]; selectedStatusWord := startupSnapshot[6];
				2: selectedAxisStatus := startupSnapshot[3]; selectedStatusWord := startupSnapshot[7];
				3: selectedAxisStatus := startupSnapshot[4]; selectedStatusWord := startupSnapshot[8];
				4: selectedAxisStatus := startupSnapshot[5]; selectedStatusWord := startupSnapshot[9];
			end_case;
			safetyReady := safetyReady &
				((selectedAxisStatus and LMC_DIAG_MODE_AXIS_STANDSTILL) <> 0) &
				((selectedStatusWord and LMC_DIAG_MODE_DS402_FAULT) = 0) &
				((selectedStatusWord and LMC_DIAG_MODE_DS402_OPERATION_ENABLED) = 0);
			AxisOperationModeState[recordBase + 25]$UDINT := selectedStatusWord;
			AxisOperationModeState[recordBase + 26]$UDINT := startupSnapshot[10];
			if safetyReady = FALSE then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
					LMC_DIAG_MODE_DETAIL_UNSAFE;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
				RETURN;
			end_if;
			if expired then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
					LMC_DIAG_MODE_DETAIL_EXECUTION;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
				RETURN;
			end_if;
			evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_WRITE_REQUESTED;
			AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
			nextToken := AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT + 1;
			if nextToken = 0 then nextToken := 1; end_if;
			AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[recordBase + 17]$UDINT := nextToken;
			currentToken := nextToken;
			startResult := ERROR;
			case axisReference of
				1: startResult := SdoAxis1.TryStartWrite(OperationToken:=currentToken, ObjectIndex:=0x6060, SubIndex:=0, pWriteData:=(#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA])$^USINT, WriteLength:=1, TimeoutMs:=remainingMs);
				2: startResult := SdoAxis2.TryStartWrite(OperationToken:=currentToken, ObjectIndex:=0x6060, SubIndex:=0, pWriteData:=(#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA])$^USINT, WriteLength:=1, TimeoutMs:=remainingMs);
				3: startResult := SdoAxis3.TryStartWrite(OperationToken:=currentToken, ObjectIndex:=0x6060, SubIndex:=0, pWriteData:=(#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA])$^USINT, WriteLength:=1, TimeoutMs:=remainingMs);
				4: startResult := SdoAxis4.TryStartWrite(OperationToken:=currentToken, ObjectIndex:=0x6060, SubIndex:=0, pWriteData:=(#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_WRITE_DATA])$^USINT, WriteLength:=1, TimeoutMs:=remainingMs);
			end_case;
			if startResult = READY then
				evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_WRITE_DISPATCHED;
				AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_WRITE_WAIT;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL] :=
					LMC_DIAG_MODE_DETAIL_EXECUTION;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE;
			end_if;

		LMC_DIAG_MODE_STAGE_WRITE_WAIT:
			completionResult := -2;
			case axisReference of
				1: if executorConnected then completionResult := SdoAxis1.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				2: if executorConnected then completionResult := SdoAxis2.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				3: if executorConnected then completionResult := SdoAxis3.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				4: if executorConnected then completionResult := SdoAxis4.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
			end_case;
			if completionResult = 0 then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_VERIFY_START;
			elsif (completionResult = -2) | (completionResult = -3) then
				if expired then
					orphanResult := -1;
					case axisReference of
						1: if executorConnected then orphanResult := SdoAxis1.MarkOrphan(currentToken); end_if;
						2: if executorConnected then orphanResult := SdoAxis2.MarkOrphan(currentToken); end_if;
						3: if executorConnected then orphanResult := SdoAxis3.MarkOrphan(currentToken); end_if;
						4: if executorConnected then orphanResult := SdoAxis4.MarkOrphan(currentToken); end_if;
					end_case;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_WRITE_TIMEOUT;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_RECOVERY_START;
				end_if;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_CALLBACK;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_START;
			end_if;

		LMC_DIAG_MODE_STAGE_VERIFY_START:
			if expired | (executorConnected = FALSE) then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_VERIFY_START;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_START;
				RETURN;
			end_if;
			if executorReusable = FALSE then RETURN; end_if;
			nextToken := AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT + 1;
			if nextToken = 0 then nextToken := 1; end_if;
			AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[recordBase + 17]$UDINT := nextToken;
			currentToken := nextToken;
			startResult := ERROR;
			case axisReference of
				1: startResult := SdoAxis1.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				2: startResult := SdoAxis2.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				3: startResult := SdoAxis3.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
				4: startResult := SdoAxis4.TryStartRead(
					OperationToken:=currentToken,
					ObjectIndex:=0x6061,
					SubIndex:=0,
					ReadLength:=1,
					TimeoutMs:=remainingMs);
			end_case;
			if startResult = READY then
				evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_VERIFY_DISPATCHED;
				AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_VERIFY_WAIT;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_VERIFY_START;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_START;
			end_if;

		LMC_DIAG_MODE_STAGE_VERIFY_WAIT:
			completionResult := -2;
			case axisReference of
				1: if executorConnected then completionResult := SdoAxis1.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				2: if executorConnected then completionResult := SdoAxis2.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				3: if executorConnected then completionResult := SdoAxis3.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				4: if executorConnected then completionResult := SdoAxis4.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
			end_case;
			if completionResult = 0 then
				if (completion.ValidationCode = 0) & (completion.OsResult = 0) &
				   (completion.AbortCode = 0) & (completion.ActualLength = 1) &
				   (completion.ObjectIndex = 0x6061) & (completion.SubIndex = 0) &
				   (completion.IsWrite = 0) then
					evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_VERIFY_COMPLETED;
					AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
					observedMode := (completion.Data and 0x000000FF)$SINT;
					AxisOperationModeState[recordBase + 11] := TO_DINT(observedMode);
					if observedMode = AxisOperationModeState[recordBase + 10]$SINT then
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
							LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS;
					else
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
							LMC_DIAG_MODE_QUARANTINE_VERIFY_MISMATCH;
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
							LMC_DIAG_MODE_STAGE_QUARANTINE;
					end_if;
				else
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_CALLBACK;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_RECOVERY_START;
				end_if;
			elsif (completionResult = -2) | (completionResult = -3) then
				if expired then
					orphanResult := -1;
					case axisReference of
						1: if executorConnected then orphanResult := SdoAxis1.MarkOrphan(currentToken); end_if;
						2: if executorConnected then orphanResult := SdoAxis2.MarkOrphan(currentToken); end_if;
						3: if executorConnected then orphanResult := SdoAxis3.MarkOrphan(currentToken); end_if;
						4: if executorConnected then orphanResult := SdoAxis4.MarkOrphan(currentToken); end_if;
					end_case;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_VERIFY_TIMEOUT;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_RECOVERY_START;
				end_if;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_CALLBACK;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_START;
			end_if;
	else
	end_case;

END_FUNCTION


FUNCTION LMCDiagnosticsService::ProcessAxisSetOperationModeRecoveryStages
	VAR
		completion : LMCSdoExecutor::LMCSdoExecutorResult;
		startupSnapshot : ARRAY [0..11] OF UDINT;
		stage, recordBase, finalRecordState : DINT;
		axisReference : UINT;
		axisMask, currentToken, evidenceFlags, serviceNow : UDINT;
		startMs, timeoutMs, elapsedMs, remainingMs : UDINT;
		currentCycle, selectedAxisStatus, selectedStatusWord : UDINT;
		contextCheck, failureDetail, quarantineReason, nextToken : UDINT;
		copyResult, completionResult, orphanResult, ownerResult : DINT;
		startResult : iprStates;
		observedMode : SINT;
		executorConnected, executorReusable, safetyReady, expired : BOOL;
	END_VAR

	stage := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE];
	axisReference := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_AXIS]$UINT;
	recordBase := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_RECORD_BASE];
	if (axisReference < 1) | (axisReference > 4) |
	   (recordBase < 0) | (recordBase > 96) |
	   (recordBase <> TO_DINT(axisReference - 1) * LMC_DIAG_MODE_RECORD_STRIDE) then
		RETURN;
	end_if;
	axisMask := TO_UDINT(1) shl TO_UDINT(axisReference - 1);
	currentToken := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT;
	evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT;
	serviceNow := ops.tAbsolute;
	startMs := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_START_MS]$UDINT;
	timeoutMs := AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_TIMEOUT_MS]$UDINT;
	elapsedMs := serviceNow - startMs;
	expired := elapsedMs >= timeoutMs;
	if expired then
		remainingMs := 1;
	else
		remainingMs := timeoutMs - elapsedMs;
		if remainingMs > 60000 then
			remainingMs := 60000;
		end_if;
		if remainingMs = 0 then
			remainingMs := 1;
		end_if;
	end_if;

	executorConnected := FALSE;
	executorReusable := FALSE;
	case axisReference of
		1:
			executorConnected := IsClientConnected(#SdoAxis1) <> 0;
			if executorConnected then executorReusable := SdoAxis1.IsReusable(); end_if;
		2:
			executorConnected := IsClientConnected(#SdoAxis2) <> 0;
			if executorConnected then executorReusable := SdoAxis2.IsReusable(); end_if;
		3:
			executorConnected := IsClientConnected(#SdoAxis3) <> 0;
			if executorConnected then executorReusable := SdoAxis3.IsReusable(); end_if;
		4:
			executorConnected := IsClientConnected(#SdoAxis4) <> 0;
			if executorConnected then executorReusable := SdoAxis4.IsReusable(); end_if;
	end_case;

	case stage of
		LMC_DIAG_MODE_STAGE_RECOVERY_START:
			// Recovery after a dispatched mutation is read-only. Wait for the
			// executor to reconnect and drain; never fall back to WRITE_START.
			if executorConnected = FALSE then
				RETURN;
			end_if;
			if executorReusable = FALSE then
				RETURN;
			end_if;
			nextToken := AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT + 1;
			if nextToken = 0 then nextToken := 1; end_if;
			AxisOperationModeState[LMC_DIAG_MODE_META_OPERATION_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_SDO_TOKEN]$UDINT := nextToken;
			AxisOperationModeState[recordBase + 17]$UDINT := nextToken;
			currentToken := nextToken;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_START_MS]$UDINT := serviceNow;
			AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_TIMEOUT_MS]$UDINT :=
				LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS;
			startResult := ERROR;
			case axisReference of
				1: startResult := SdoAxis1.TryStartRead(OperationToken:=currentToken, ObjectIndex:=0x6061, SubIndex:=0, ReadLength:=1, TimeoutMs:=LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS);
				2: startResult := SdoAxis2.TryStartRead(OperationToken:=currentToken, ObjectIndex:=0x6061, SubIndex:=0, ReadLength:=1, TimeoutMs:=LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS);
				3: startResult := SdoAxis3.TryStartRead(OperationToken:=currentToken, ObjectIndex:=0x6061, SubIndex:=0, ReadLength:=1, TimeoutMs:=LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS);
				4: startResult := SdoAxis4.TryStartRead(OperationToken:=currentToken, ObjectIndex:=0x6061, SubIndex:=0, ReadLength:=1, TimeoutMs:=LMC_DIAG_MODE_RECOVERY_READ_TIMEOUT_MS);
			end_case;
			if startResult = READY then
				evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_VERIFY_DISPATCHED;
				AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_RECOVERY_WAIT;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_VERIFY_START;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE;
			end_if;

		LMC_DIAG_MODE_STAGE_RECOVERY_WAIT:
			completionResult := -2;
			case axisReference of
				1: if executorConnected then completionResult := SdoAxis1.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				2: if executorConnected then completionResult := SdoAxis2.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				3: if executorConnected then completionResult := SdoAxis3.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
				4: if executorConnected then completionResult := SdoAxis4.CopyCompletion(currentToken, #completion, sizeof(completion)); end_if;
			end_case;
			if completionResult = 0 then
				if (completion.ValidationCode = 0) & (completion.OsResult = 0) &
				   (completion.AbortCode = 0) & (completion.ActualLength = 1) &
				   (completion.ObjectIndex = 0x6061) & (completion.SubIndex = 0) &
				   (completion.IsWrite = 0) then
					evidenceFlags := evidenceFlags or LMC_DIAG_MODE_EVIDENCE_VERIFY_COMPLETED;
					AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
					observedMode := (completion.Data and 0x000000FF)$SINT;
					AxisOperationModeState[recordBase + 11] := TO_DINT(observedMode);
					if observedMode = AxisOperationModeState[recordBase + 10]$SINT then
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
							LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS;
					else
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
							LMC_DIAG_MODE_QUARANTINE_VERIFY_MISMATCH;
						AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
							LMC_DIAG_MODE_STAGE_QUARANTINE;
					end_if;
				else
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_CALLBACK;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_QUARANTINE;
				end_if;
			elsif (completionResult = -2) | (completionResult = -3) then
				if expired then
					orphanResult := -1;
					case axisReference of
						1: if executorConnected then orphanResult := SdoAxis1.MarkOrphan(currentToken); end_if;
						2: if executorConnected then orphanResult := SdoAxis2.MarkOrphan(currentToken); end_if;
						3: if executorConnected then orphanResult := SdoAxis3.MarkOrphan(currentToken); end_if;
						4: if executorConnected then orphanResult := SdoAxis4.MarkOrphan(currentToken); end_if;
					end_case;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_VERIFY_TIMEOUT;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_QUARANTINE;
				end_if;
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_CALLBACK;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE;
			end_if;

		LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS,
		LMC_DIAG_MODE_STAGE_TERMINAL_FAILURE:
			if executorReusable = FALSE then
				if expired then
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
						LMC_DIAG_MODE_QUARANTINE_CALLBACK;
					AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
						LMC_DIAG_MODE_STAGE_QUARANTINE;
				end_if;
				RETURN;
			end_if;
			_memset(dest:=#startupSnapshot[0], usByte:=0, cntr:=sizeof(startupSnapshot));
			copyResult := -1;
			if IsClientConnected(#InputLatch) then
				copyResult := InputLatch.CopyAxisOwnershipStartupSnapshot(
					pDest:=#startupSnapshot[0], DestSize:=sizeof(startupSnapshot));
			end_if;
			currentCycle := AxisOperationModeState[recordBase + 19]$UDINT;
			if (copyResult = 0) &
			   (startupSnapshot[0] = LMC_OWNER_STARTUP_SNAPSHOT_MAGIC) &
			   (startupSnapshot[1] >= currentCycle) then
				currentCycle := startupSnapshot[1];
				contextCheck := startupSnapshot[10];
				case axisReference of
					1: selectedStatusWord := startupSnapshot[6];
					2: selectedStatusWord := startupSnapshot[7];
					3: selectedStatusWord := startupSnapshot[8];
					4: selectedStatusWord := startupSnapshot[9];
				end_case;
				AxisOperationModeState[recordBase + 25]$UDINT := selectedStatusWord;
				AxisOperationModeState[recordBase + 26]$UDINT := contextCheck;
			end_if;
			AxisOperationModeState[recordBase + 20]$UDINT := currentCycle;
			evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT or
				LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
			if stage = LMC_DIAG_MODE_STAGE_TERMINAL_SUCCESS then
				finalRecordState := LMC_DIAG_MODE_RECORD_SUCCEEDED;
				failureDetail := 0;
				AxisOperationModeState[recordBase + 14] := 0;
				AxisOperationModeState[recordBase + 15] := 0;
				AxisOperationModeState[recordBase + 16] := 0;
			else
				finalRecordState := LMC_DIAG_MODE_RECORD_FAILED;
				failureDetail := AxisOperationModeState[
					LMC_DIAG_MODE_RUNTIME_FAILURE_DETAIL]$UDINT;
				if (failureDetail <> LMC_DIAG_MODE_DETAIL_UNSAFE) &
				   (failureDetail <> LMC_DIAG_MODE_DETAIL_EXECUTION) then
					failureDetail := LMC_DIAG_MODE_DETAIL_EXECUTION;
				end_if;
				AxisOperationModeState[recordBase + 14] := 1;
				AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
				AxisOperationModeState[recordBase + 16]$UDINT := failureDetail;
			end_if;
			AxisOperationModeState[recordBase + 24] := 0;

			// Stage the complete terminal payload and read back its immutable
			// identity before releasing the common owner. RecordState remains
			// Running until the owner release receipt succeeds.
			if (AxisOperationModeState[recordBase + 31]$UDINT <>
			    LMC_DIAG_MODE_RECORD_MAGIC) |
			   (AxisOperationModeState[recordBase + 22]$UDINT = 0) |
			   (AxisOperationModeState[recordBase + 27]$UDINT <>
			    AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_ADMISSION_TOKEN]$UDINT) |
			   (AxisOperationModeState[recordBase + 28]$UDINT <>
			    AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_OWNER_GENERATION]$UDINT) then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_OWNER_PUBLISH;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE;
				RETURN;
			end_if;

			ownerResult := -1;
			if IsClientConnected(#AxisOwnership) then
				if finalRecordState = LMC_DIAG_MODE_RECORD_SUCCEEDED then
					ownerResult := AxisOwnership.PublishAxisOwnership(
						AxisMask:=axisMask,
						AdmissionToken:=AxisOperationModeState[recordBase + 27]$UDINT,
						OwnerGeneration:=AxisOperationModeState[recordBase + 28]$UDINT,
						ReportKind:=LMC_DIAG_OWNER_REPORT_TERMINAL_SUCCESS,
						ReportValue0:=AxisOperationModeState[recordBase + 22]$UDINT,
						ReportValue1:=0,
						ObservationCycle:=currentCycle);
				else
					ownerResult := AxisOwnership.PublishAxisOwnership(
						AxisMask:=axisMask,
						AdmissionToken:=AxisOperationModeState[recordBase + 27]$UDINT,
						OwnerGeneration:=AxisOperationModeState[recordBase + 28]$UDINT,
						ReportKind:=LMC_DIAG_OWNER_REPORT_TERMINAL_SAFE_FAILURE,
						ReportValue0:=AxisOperationModeState[recordBase + 22]$UDINT,
						ReportValue1:=failureDetail,
						ObservationCycle:=currentCycle);
				end_if;
			end_if;
			if ownerResult = 0 then
				evidenceFlags := AxisOperationModeState[recordBase + 18]$UDINT or
					LMC_DIAG_MODE_EVIDENCE_OWNER_RELEASED;
				AxisOperationModeState[recordBase + 18]$UDINT := evidenceFlags;
				AxisOperationModeState[recordBase] := finalRecordState;
				_memset(dest:=#AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_BASE],
					usByte:=0, cntr:=32 * 4);
			else
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
					LMC_DIAG_MODE_QUARANTINE_OWNER_PUBLISH;
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE;
			end_if;

		LMC_DIAG_MODE_STAGE_QUARANTINE:
			quarantineReason := AxisOperationModeState[
				LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON]$UDINT;
			if quarantineReason = 0 then
				quarantineReason := LMC_DIAG_MODE_QUARANTINE_CALLBACK;
			end_if;
			AxisOperationModeState[recordBase + 14] := 1;
			AxisOperationModeState[recordBase + 15] := LMC_DIAG_ADMIN_ERROR_ID;
			AxisOperationModeState[recordBase + 16] :=
				LMC_DIAG_MODE_DETAIL_INDETERMINATE;
			AxisOperationModeState[recordBase + 24]$UDINT := quarantineReason;
			AxisOperationModeState[recordBase] := LMC_DIAG_MODE_RECORD_QUARANTINED;
			if executorReusable then
				AxisOperationModeState[recordBase + 18]$UDINT :=
					AxisOperationModeState[recordBase + 18]$UDINT or
					LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			end_if;
			ownerResult := -1;
			if IsClientConnected(#AxisOwnership) then
				ownerResult := AxisOwnership.PublishAxisOwnership(
					AxisMask:=axisMask,
					AdmissionToken:=AxisOperationModeState[recordBase + 27]$UDINT,
					OwnerGeneration:=AxisOperationModeState[recordBase + 28]$UDINT,
					ReportKind:=LMC_DIAG_OWNER_REPORT_QUARANTINE,
					ReportValue0:=quarantineReason,
					ReportValue1:=AxisOperationModeState[recordBase + 17]$UDINT,
					ObservationCycle:=AxisOperationModeState[recordBase + 19]$UDINT);
			end_if;
			if ownerResult = 0 then
				AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
					LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD;
			end_if;

		LMC_DIAG_MODE_STAGE_QUARANTINE_HOLD:
			if executorReusable then
				AxisOperationModeState[recordBase + 18]$UDINT :=
					AxisOperationModeState[recordBase + 18]$UDINT or
					LMC_DIAG_MODE_EVIDENCE_EXECUTOR_REUSABLE;
			end_if;

	else
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_QUARANTINE_REASON] :=
			LMC_DIAG_MODE_QUARANTINE_CALLBACK;
		AxisOperationModeState[LMC_DIAG_MODE_RUNTIME_STAGE] :=
			LMC_DIAG_MODE_STAGE_QUARANTINE;
	end_case;

END_FUNCTION
