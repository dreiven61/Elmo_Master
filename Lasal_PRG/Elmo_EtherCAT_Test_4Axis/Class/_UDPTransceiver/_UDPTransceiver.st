FUNCTION GLOBAL _UDPTransceiver::SendDataBlocked
	VAR_INPUT
		dHandle 	: DINT;
		pData 	: ^void;
		udSize 	: UDINT;
		udIpAddress 	: UDINT;
		udPort 	: UDINT;
		udTimeout 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Retcode 	: DINT;
	END_VAR
VAR
	bRet          : BOOL;
  dRet          : DINT;
  pSocket       : ^_SOCKET;
END_VAR

  Retcode := UDP_CLT_SEND_FAILED;

  bRet := CheckHandleValid(dHandle := dHandle);

  if (bRet = false) then
    Retcode := UDP_CLT_INVALID_HANDLE;
    return;
  end_if;

  pSocket := dHandle$^_SOCKET;

  if (pSocket^.bdStates.Allocated = false) then
    Retcode := UDP_CLT_NOT_OPEN;
    return;
  end_if;

  if (pData = NIL) then
    Retcode := UDP_CLT_INVALID_DATA;
    return;
  end_if;

  dRet := SendUDP(pSocket     := pSocket,
                  pData       := pData$^CHAR,
                  udSize      := udSize,
                  udTimeout   := udTimeout,
                  udIpAddress := udIpAddress,
                  udPort      := udPort);

  if (dRet$UDINT = udSize) then
    Retcode := UDP_CLT_SEND_OK;
  end_if;

END_FUNCTION


FUNCTION GLOBAL _UDPTransceiver::GetLastError
	VAR_OUTPUT
		LastError 	: _UDP_ERROR;
	END_VAR

  LastError := sErrorMessage;

END_FUNCTION
