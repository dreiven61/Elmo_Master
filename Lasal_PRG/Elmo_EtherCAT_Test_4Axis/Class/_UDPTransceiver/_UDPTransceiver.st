FUNCTION VIRTUAL GLOBAL _UDPTransceiver::Init

  //##################################################################################
  //### Initialization
  //##################################################################################

  if (bdStates.Initialized = false) then

    bdStates.Initialized := true;

    if OS_CILGET("TCP_USER", #lsl_tcp_user) then
      bdStates.GlobalError := true;
      lsl_tcp_user := NIL;
      SetError(bError:= 1, ErrorMessage:= _INIT_TCP_USER_UDP_ERROR, dError:= 0);
    end_if;


    // -----------------------------------------------------
    // - READ SIZE OF SEND BUFFER                          -
    // -----------------------------------------------------

    cSizeOfTXBuffer := cSizeOfTXBuffer.Read();

    if (cSizeOfTXBuffer = 0) then
      cSizeOfTXBuffer := UDP_MAXIMUM_SEGMENT_SIZE;
    end_if;

    // -----------------------------------------------------
    // - CREATE GENERAL SEND BUFFER                        -
    // -----------------------------------------------------

    pSendBuffer := coStdLib.Malloc(size := UDP_MAXIMUM_SEGMENT_SIZE);

    if (pSendBuffer = NIL) then
      bdStates.GlobalError := true;
      SetError(bError := true, ErrorMessage := _NO_MEMORY_SENDBUFFER_UDP_ERROR, dError := 0);
    end_if;


    // -----------------------------------------------------
    // - READ SIZE OF RECEIVE BUFFER                       -
    // -----------------------------------------------------

    cSizeOfRXBuffer := cSizeOfRXBuffer.Read();

    if (cSizeOfRXBuffer = 0) then
      cSizeOfRXBuffer := UDP_MAXIMUM_SEGMENT_SIZE;
    end_if;

    // -----------------------------------------------------
    // - CREATE GENERAL RECEIVE BUFFER                     -
    // -----------------------------------------------------

    pRecvBuffer := coStdLib.Malloc(size := cSizeOfRXBuffer);

    if (pRecvBuffer = NIL) then
      bdStates.GlobalError := true;
      SetError(bError := true, ErrorMessage := _NO_MEMORY_RECVBUFFER_UDP_ERROR, dError := 0);
    end_if;

  end_if;

END_FUNCTION

FUNCTION _UDPTransceiver::INITSocket
	VAR_INPUT
		pSocket 	: ^_SOCKET;
	END_VAR

  //##################################################################################
  //### Initialize socket structure
  //##################################################################################

  //pSocket^.bInUse := false;
  _memset(dest:= #pSocket^.szIPAddress[0], usByte:= 0x00, cntr:= 0x10);
  pSocket^.udIPAddress   := 0;
  pSocket^.udPort        := 0;
  pSocket^.bdStates$DINT := 0;
  pSocket^.dSocket       := 0;
  pSocket^.FSM_UDP       := _STATE_IDLE_UDP;
  pSocket^.pCallbackThis := NIL;
  pSocket^.pNextSocket   := NIL;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::AddSocket
	VAR_INPUT
		thisp 	: ^void;
	END_VAR
	VAR_OUTPUT
		dHandle 	: DINT;
	END_VAR
VAR
  i             : SINT;     // help variable for loop
  pSocket       : ^_SOCKET; // help pointer
  pSearchSocket : ^_SOCKET; // help pointer
END_VAR

  //##################################################################################
  //### Add socket
  //##################################################################################

  dHandle := 0;

  if (thisp = NIL) then
    SetError(bError:= 1, ErrorMessage:= _INSTALL_CALLBACK_UDP_ERROR, dError:= 0);
    return;
  end_if;

  if (Sockets.dActSocket < UDP_MAX_SOCKETS) then

    //###################################################################################
    //### Allocate memory for socket structure
    //###################################################################################
    pSocket$^void := coStdLib.Malloc(size:= sizeof(_SOCKET));

    if (pSocket = NIL) then
      SetError(bError:= 1, ErrorMessage:= _NO_MEMORY_SOCKET_UDP_ERROR, dError:= 0);
      return;
    else
      SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
    end_if;


    //###################################################################################
    //### Allocate memory for send buffer (RINGBUFFER)
    //###################################################################################

    if (cSizeOfTXBuffer) then

      pSocket^.SendBuffer.pMem := coStdLib.Malloc(size:= cSizeOfTXBuffer);

      if (pSocket^.SendBuffer.pMem = NIL) then
        coStdLib.Free(mptr:= pSocket);
        SetError(bError:= 1, ErrorMessage:= _NO_MEMORY_SENDBUFFER_UDP_ERROR, dError:= 0);
        return;
      else
        SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
      end_if;

    else

      pSocket^.SendBuffer.pMem := NIL;

    end_if;


    //###################################################################################
    //### Initialize send buffer (RINGBUFFER)
    //###################################################################################
    pSocket^.SendBuffer.udSize := cSizeOfTXBuffer;
    pSocket^.SendBuffer.udUsed := 0;
    pSocket^.SendBuffer.pRead  := pSocket^.SendBuffer.pMem;
    pSocket^.SendBuffer.pWrite := pSocket^.SendBuffer.pMem;


    //###################################################################################
    //### Initialize socket structure
    //###################################################################################
    INITSocket(pSocket:= pSocket);

    // set callback-pointer
    pSocket^.pCallbackThis := thisp;

    Sockets.dActSocket += 1;

    dHandle := pSocket$DINT;


    //###################################################################################
    //### Add socket
    //###################################################################################
    if (Sockets.pSockets = NIL) then

      Sockets.pSockets     := pSocket;
      pSocket^.pNextSocket := pSocket;

    else

      i             := 1;
      pSearchSocket := Sockets.pSockets;

      while i < (Sockets.dActSocket - 1) do
        pSearchSocket := pSearchSocket^.pNextSocket;
        i += 1;
      end_while;

      pSearchSocket^.pNextSocket := pSocket;
      pSocket^.pNextSocket       := Sockets.pSockets;

    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::BindSocket
	VAR_INPUT
		dHandle 	: DINT;
		pIpAddress 	: ^CHAR;
		udPort 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR
VAR
  pSocket         : ^_SOCKET; // help pointer
  bRet            : BOOL;
  dRet            : DINT;
END_VAR

  // --------------------------------------------------------------------------------
  // - INIT RETCODE                                                                 -
  // --------------------------------------------------------------------------------

  dRetcode := _NO_ERROR_UDP_ERROR;


  // --------------------------------------------------------------------------------
  // - CHECK INPUT VARIABLES FOR VALIDITY                                           -
  // --------------------------------------------------------------------------------

  bRet := CheckHandleValid(dHandle := dHandle);

  if (bRet = false) then
    SetError(bError:= 1, ErrorMessage:= _INVALID_HANDLE_UDP_ERROR, dError:= 0);
    dRetcode := _INVALID_HANDLE_UDP_ERROR;
    return;
  else
    pSocket := dHandle$^_SOCKET;
    SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
  end_if;

  if (pIpAddress = NIL) then
    SetError(bError:= 1, ErrorMessage:= _NO_IP_ADDRESS_UDP_ERROR, dError:= 0);
    dRetcode := _NO_IP_ADDRESS_UDP_ERROR;
    return;
  else
    SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
  end_if;

  // --------------------------------------------------------------------------------
  // - STORE IP ADDRESS TO INTERNAL STRUCTURE (STRING AND UDINT FORMAT)             -
  // --------------------------------------------------------------------------------

  _strcpy(dest := #pSocket^.szIPAddress[0],
          src  := pIpAddress);

  pSocket^.udIPAddress := ConvertStrToUdint(pIpAddress := #pSocket^.szIPAddress[0]);


  // --------------------------------------------------------------------------------
  // - STORE PORT NUMBER TO INTERNAL STRUCTURE                                      -
  // --------------------------------------------------------------------------------

  pSocket^.udPort        := udPort;

  // --------------------------------------------------------------------------------
  // - BIND SOCKET IF SOCKET IS ALLOCATED                                           -
  // --------------------------------------------------------------------------------

  if (pSocket^.bdStates.Allocated = true) then

    dRet := OS_UDP_USER_BIND(pSocket^.dSocket,
                             pSocket^.udIPAddress,
                             pSocket^.udPort);

    if (dRet = 0) then

      SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
      pSocket^.bdStates.Binded := true; // changed from pActSocket to pSocket - SprDie - v1.2
      pSocket^.FSM_UDP         := _STATE_RECV_UDP;  //changed from pActSocket to pSocket - FurLuk - V1.1

      dRetcode := 1;

    else

      SetError(bError:= 1, ErrorMessage:= _SET_BIND_UDP_ERROR, dError:= dRet);
      dRetcode := _SET_BIND_UDP_ERROR;
      //if (dRetcode <> TCP_NOT_READY) then
        pSocket^.FSM_UDP := _STATE_SHUTDOWN_UDP;
      //end_if;

    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::DelSocket
	VAR_INPUT
		dHandle 	: DINT;
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
VAR
  pSocket       : ^_SOCKET; // help pointer
  pSearchSocket : ^_SOCKET; // help pointer
  i             : SINT;     // help variable for loop
  dRet          : DINT;     // help variable for return value
END_VAR

  //##################################################################################
  //### Delete socket
  //##################################################################################
  retcode := _NO_ERROR_UDP_ERROR;

  if (CheckHandleValid(dHandle) = false) then //### invalid handle
    SetError(bError:= 1, ErrorMessage:= _INVALID_HANDLE_UDP_ERROR, dError:= 0);
    retcode := _INVALID_HANDLE_UDP_ERROR;
    RETURN;
  else
    SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
  end_if;

  pSocket       := dHandle$^_SOCKET;
  pSearchSocket := Sockets.pSockets;

  for i := 0 to (Sockets.dActSocket - 1) do

    if (pSearchSocket^.pNextSocket = pSocket) then

      //###################################################################################
      //### Correct socket pointer
      //###################################################################################
      pSearchSocket^.pNextSocket := pSocket^.pNextSocket;
      if (pSocket = Sockets.pSockets) then
        Sockets.pSockets := pSocket^.pNextSocket;
      end_if;

      dRet := OS_TCP_USER_CLOSESOCKET(pSocket^.dSocket, 0);
      if (dRet < 0) then
        SetError(bError:= 1, ErrorMessage:= _CLOSESOCKET_UDP_ERROR, dError:= dRet);
      else
        SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
      end_if;

      //###################################################################################
      //### Free memory for send buffer & connection structure
      //###################################################################################
      if (pSocket^.SendBuffer.pMem <> NIL) then
        coStdLib.Free(mptr:= pSocket^.SendBuffer.pMem);
      end_if;

      coStdLib.Free(mptr:= pSocket);

      Sockets.dActSocket -= 1;
      if (Sockets.dActSocket = 0) then
        Sockets.pSockets := NIL;
        FSM_UDP  := _STATE_INIT;
        sControl := _STATE_INIT_UDP;
      end_if;

      EXIT;

    end_if;

    pSearchSocket := pSearchSocket^.pNextSocket;

  end_for;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::CyclicCall
VAR
  dRet            : DINT;               // help variable for return value
  BufferHeader    : _BUFFER_HEADER;     // help variable for header
  Source_IP       : UDINT;
  Source_Port     : UDINT;
  i               : USINT;
END_VAR

  //##################################################################################
  //### Main programm
  //##################################################################################

  //**********************************************************************************
  // Start FSM_UDP
  //**********************************************************************************
  case FSM_UDP of

    //--------------------------------------------------------------------------------
    _STATE_INIT: // initialization state
    //--------------------------------------------------------------------------------

      if (lsl_tcp_user <> NIL) then
        if (bdStates.GlobalError = false) then
          if (Sockets.dActSocket) then
            pActSocket := Sockets.pSockets;
            FSM_UDP    := _STATE_WORK;
          else
            pActSocket := NIL;
          end_if;
        end_if;
      end_if;


    //--------------------------------------------------------------------------------
    _STATE_WORK: // work state
    //--------------------------------------------------------------------------------

      //##############################################################################
      //##                                                                          ##
      //##    this finite state machine is used for the main UDP socket:            ##
      //##                                                                          ##
      //##    -> allocate sockets                                                   ##
      //##    -> build a connection to a specified socket????????????????           ##
      //##    -> receive data from server                                           ##
      //##    -> disable receives and sends on socket                               ##
      //##    -> close socket                                                       ##
      //##                                                                          ##
      //##############################################################################

      //******************************************************************************
      // Start pActSocket^.FSM_UDP
      //******************************************************************************
      case pActSocket^.FSM_UDP of

        //----------------------------------------------------------------------------
        _STATE_IDLE_UDP: // idle state
        //----------------------------------------------------------------------------

          if (pActSocket^.bdStates.Allocated = false) then
            pActSocket^.FSM_UDP := _STATE_SOCK_UDP;
          end_if;


        //----------------------------------------------------------------------------
        _STATE_SOCK_UDP: // allocate socket
        //----------------------------------------------------------------------------

          pActSocket^.dSocket := OS_UDP_USER_SOCKET();

          if (pActSocket^.dSocket < 0) then
          // Error add socket
            SetError(bError:= 1, ErrorMessage:= _ALLOCATE_SOCKET_UDP_ERROR, dError:= pActSocket^.dSocket, pActSocket);
            pActSocket^.FSM_UDP := _STATE_ERROR_UDP;

          else
          // Add socket OK
            SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);

            pActSocket^.bdStates.Allocated := true;

            if (pActSocket^.udIPAddress <> 0) then
              pActSocket^.FSM_UDP := _STATE_BIND_SOCK_UDP;
            else
              pActSocket^.FSM_UDP := _STATE_SEND_UDP;
            end_if;

            pActSocket^.pCallbackThis$^_UDPTransceiverInterface^.InfoCallback(pActSocket^.FSM_UDP, UDP_CLT_INFO_ADDED, 0);

          end_if;


        //----------------------------------------------------------------------------
        _STATE_BIND_SOCK_UDP: // bind socket
        //----------------------------------------------------------------------------

          dRet := OS_UDP_USER_BIND(pActSocket^.dSocket,
                                   pActSocket^.udIPAddress,
                                   pActSocket^.udPort);

          if (dRet = 0) then
            SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
            pActSocket^.bdStates.Binded := true;
            pActSocket^.FSM_UDP := _STATE_RECV_UDP;

            pActSocket^.pCallbackThis$^_UDPTransceiverInterface^.InfoCallback(pActSocket^.FSM_UDP, UDP_CLT_INFO_BOUND, 0);

          else
            SetError(bError:= 1, ErrorMessage:= _SET_BIND_UDP_ERROR, dError:= dRet, pActSocket);
            pActSocket^.FSM_UDP := _STATE_SHUTDOWN_UDP;
          end_if;


        //----------------------------------------------------------------------------
        _STATE_ONLY_SEND_UDP: // only send state
        //----------------------------------------------------------------------------

          if (pActSocket^.SendBuffer.udUsed) then
            pActSocket^.FSM_UDP := _STATE_SEND_UDP;
          end_if;


        //----------------------------------------------------------------------------
        _STATE_RECV_UDP: // receive state
        //----------------------------------------------------------------------------

          if (pRecvBuffer = NIL) then
            SetError(bError := 1, ErrorMessage := _NO_MEMORY_RECVBUFFER_UDP_ERROR, dError := 0);
            bdStates.GlobalError := true;
            pActSocket^.FSM_UDP  := _STATE_ERROR_UDP;
            return;
          end_if;

          for i := 0 to (MAX_MSG_CYC_RECV - 1) do

            dRet := OS_TCP_USER_RECVFROM(pActSocket^.dSocket,
                                         pRecvBuffer$^CHAR,
                                         cSizeOfRXBuffer,
                                         0,
                                         0,
                                         #Source_IP,
                                         #Source_Port);

            if (dRet > 0) then
              // Receive data OK
              pActSocket^.pCallbackThis$^_UDPTransceiverInterface^.Response(pRecvBuffer, dRet$UDINT, Source_IP, Source_Port);

              SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);

            else
            // Error receive data
              if (dRet <> TCP_NOT_READY) then
                SetError(bError:= 1, ErrorMessage:= _RECV_UDP_ERROR, dError:= dRet, pActSocket);
              end_if;

              exit;

            end_if;

          end_for;

          //##########################################################
          //### Send data from ringbuffer
          //##########################################################
          if (pActSocket^.FSM_UDP = _STATE_RECV_UDP) then
            if (pActSocket^.SendBuffer.udUsed) then
              pActSocket^.FSM_UDP := _STATE_SEND_UDP;
            end_if;
          end_if;


        //----------------------------------------------------------------------------
        _STATE_SEND_UDP: // send data
        //----------------------------------------------------------------------------

          if (pSendBuffer = NIL) then
            SetError(bError := 1, ErrorMessage := _NO_MEMORY_SENDBUFFER_UDP_ERROR, dError := 0);
            bdStates.GlobalError := true;
            pActSocket^.FSM_UDP  := _STATE_ERROR_UDP;
            return;
          end_if;

          for i := 0 to (MAX_MSG_CYC_SEND - 1) do

            if (pActSocket^.SendBuffer.udUsed) then

              CriticalSection_UDP.SectionStart();

              //##########################################################
              //### read message header from ringbuffer
              //##########################################################
              RingbufferRead(pBuffer:= #pActSocket^.SendBuffer,
                             pData  := #BufferHeader,
                             udSize := sizeof(_BUFFER_HEADER));

              //##########################################################
              //### read message from ringbuffer
              //##########################################################
              RingbufferRead(pBuffer:= #pActSocket^.SendBuffer,
                             pData  := pSendBuffer,
                             udSize := BufferHeader.DataSize);

              CriticalSection_UDP.SectionStop();


              //##########################################################
              //### send data via OS function
              //##########################################################
              dRet := SendUDP(pSocket    := pActSocket,
                              pData      := pSendBuffer$^CHAR,
                              udSize     := BufferHeader.DataSize,
                              udTimeout  := 0,
                              udIpAddress:= BufferHeader.Dest_IP,
                              udPort     := BufferHeader.Dest_Port);

              if (dRet <> BufferHeader.DataSize$DINT) then
                SetError(bError := 1, ErrorMessage := _SEND_UDP_ERROR, dError := dRet, pActSocket);
              end_if;

            else
              exit;
            end_if;

          end_for;

          if (pActSocket^.bdStates.Binded = true) then
            pActSocket^.FSM_UDP := _STATE_RECV_UDP;
          else
            pActSocket^.FSM_UDP := _STATE_SEND_UDP;
          end_if;


        //----------------------------------------------------------------------------
        _STATE_SHUTDOWN_UDP: // disable receives and sends on socket
        //----------------------------------------------------------------------------

          dRet :=  OS_TCP_USER_SHUTDOWN(pActSocket^.dSocket, 2);
          if (dRet < 0) then
          // Error shutdown socket
            SetError(bError:= 1, ErrorMessage:= _SHUTDOWN_UDP_ERROR, dError:= dRet, pActSocket);
          else
          // Shutdown socket OK
            SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
          end_if;
          pActSocket^.FSM_UDP := _STATE_CLOSE_SOCK_UDP;

          pActSocket^.pCallbackThis$^_UDPTransceiverInterface^.InfoCallback(pActSocket^.FSM_UDP, UDP_CLT_INFO_CLOSED, 0);


        //----------------------------------------------------------------------------
        _STATE_CLOSE_SOCK_UDP: // close socket
        //----------------------------------------------------------------------------

          dRet := OS_TCP_USER_CLOSESOCKET(pActSocket^.dSocket, 0);

          if (dRet < 0) then
          // Error close socket
            SetError(bError:= 1, ErrorMessage:= _CLOSESOCKET_UDP_ERROR, dError:= dRet, pActSocket);
          else
          // Close socket OK
            SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);
          end_if;

          pActSocket^.dSocket            := 0;
          pActSocket^.bdStates.Allocated := false;
          pActSocket^.bdStates.Binded    := false;
          pActSocket^.FSM_UDP            := _STATE_IDLE_UDP;


        //----------------------------------------------------------------------------
        _STATE_ERROR_UDP: // error state
        //----------------------------------------------------------------------------


      end_case;
      //******************************************************************************
      // End pActSocket^.FSM_UDP
      //******************************************************************************

      // Actual state
      sControl := pActSocket^.FSM_UDP;
      // Set pointer to next socket
      pActSocket := pActSocket^.pNextSocket;

  end_case;
  //**********************************************************************************
  // End FSMUDP
  //**********************************************************************************

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::SendData
	VAR_INPUT
		dHandle 	: DINT;
		pData 	: ^void;
		udSize 	: UDINT;
		bDirect 	: BOOL;
		udIpAddress 	: UDINT;
		udPort 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR
VAR
  pSocket       : ^_SOCKET;       // help pointer
  BufferHeader  : _BUFFER_HEADER; // help variable for header
  dRet          : DINT;           // help variable for return value
END_VAR

  //##################################################################################
  //### Send data
  //##################################################################################

  dRetcode := UDP_CLT_SEND_FAILED;

  if (udSize > cSizeOfTXBuffer) | (udSize > UDP_MAXIMUM_SEGMENT_SIZE) then
    dRetcode := UDP_CLT_DATA_TO_BIG;
    return;
  end_if;

  if (CheckHandleValid(dHandle) = false) then         // Check handle
    dRetcode := UDP_CLT_INVALID_HANDLE;
    return;
  end_if;

  pSocket := dHandle$^_SOCKET;

  if (pSocket^.bdStates.Allocated = false) then                    // Check socket
    dRetcode := UDP_CLT_NOT_OPEN;
    return;
  end_if;

  if (bDirect = true) then

    //#########################################################################################
    //### send data via OS function
    //#########################################################################################
    dRet := SendUDP(pSocket     := pSocket,
                    pData       := pData$^CHAR,
                    udSize      := udSize,
                    udTimeout   := 0,
                    udIpAddress := udIpAddress,
                    udPort      := udPort);

    if (dRet = udSize$DINT) then
      dRetcode := UDP_CLT_SEND_OK;
    end_if;

  else

    //#########################################################################################
    //### put data into send buffer and send it in next cycle
    //#########################################################################################
    if ((pSocket^.SendBuffer.udSize - pSocket^.SendBuffer.udUsed) < (udSize + sizeof(_BUFFER_HEADER))) then
      dRetcode := UDP_CLT_SEND_BUFFER_FULL;
      RETURN;
    end_if;

    BufferHeader.DataSize  := udSize;         // - DATA SIZE [BYTE] -
    BufferHeader.Dest_IP   := udIpAddress;    // - DESTINATION IP ADDRESS -
    BufferHeader.Dest_Port := udPort;         // - DESTINATION PORT -


    CriticalSection_UDP.SectionStart();

    dRet := RingbufferWrite(pBuffer:= #pSocket^.SendBuffer,
                            pData  := #BufferHeader,
                            udSize := sizeof(_BUFFER_HEADER));

    if (dRet = sizeof(_BUFFER_HEADER)) then

      dRet := RingbufferWrite(pBuffer:= #pSocket^.SendBuffer,
                              pData  := pData,
                              udSize := BufferHeader.DataSize);

      if (dRet = BufferHeader.DataSize$DINT) then
        dRetcode := UDP_CLT_SEND_OK;
      end_if;

    end_if;

    CriticalSection_UDP.SectionStop();

  end_if;

END_FUNCTION

FUNCTION _UDPTransceiver::RingbufferRead
	VAR_INPUT
		pBuffer 	: ^_TX_RINGBUFFER;
		pData 	: ^void;
		udSize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR
VAR
  udBytes2End : UDINT;  // help variable
  udBytesTmp  : UDINT;  // help variable
END_VAR

  //##################################################################################
  //### Ring buffer read
  //##################################################################################

  dRetcode := 0;

  if (pBuffer = NIL) | (pData = NIL) | (pBuffer^.pMem = NIL) then
    RETURN; //### invalid pointer
  end_if;

  udBytes2End := (pBuffer^.pMem$UDINT + pBuffer^.udSize) - pBuffer^.pRead$UDINT;

  if (udSize > udBytes2End) then

    //##########################################################################################
    //### we must read the data in 2 blocks (|second|...........other data...........|first|)
    //##########################################################################################
    _memcpy(ptr1:= pData, ptr2:= pBuffer^.pRead, cntr:= udBytes2End); //### copy the first block
    pData          += udBytes2End;
    pBuffer^.pRead := pBuffer^.pMem$^USINT;
    udBytesTmp     := udSize - udBytes2End;
    _memcpy(ptr1:= pData, ptr2:= pBuffer^.pRead, cntr:= udBytesTmp); //### copy the second block
    pBuffer^.pRead += udBytesTmp;

  else

    //##########################################################################################
    //### read data in one block
    //##########################################################################################
    _memcpy(ptr1:= pData, ptr2:= pBuffer^.pRead, cntr:= udSize);
    pBuffer^.pRead += udSize;

  end_if;

  pBuffer^.udUsed -= udSize;        // decrease the number of bytes in ringbuffer
  dRetcode        := udSize$DINT;

END_FUNCTION

FUNCTION _UDPTransceiver::RingbufferWrite
	VAR_INPUT
		pBuffer 	: ^_TX_RINGBUFFER;
		pData 	: ^void;
		udSize 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR
VAR
  udBytes2End : UDINT;  // help variable
  udBytesTmp  : UDINT;  // help variable
END_VAR

  //##################################################################################
  //### Ring buffer write
  //##################################################################################

  dRetcode := 0;

  if (pBuffer = NIL) | (pData = NIL) | (pBuffer^.pMem = NIL) then
    RETURN; //### invalid pointer
  end_if;

  if ((udSize) > (pBuffer^.udSize - pBuffer^.udUsed)) then
    RETURN; //### buffer full
  end_if;

  udBytes2End := (pBuffer^.pMem$UDINT + pBuffer^.udSize) - pBuffer^.pWrite$UDINT; // calculate number of bytes till the end of SENDbuffer

  if (udSize > udBytes2End) then

    //##########################################################################################
    //### we must write the data in 2 blocks  (|second|...........other data...........|first|)
    //##########################################################################################
    _memcpy(ptr1:= pBuffer^.pWrite, ptr2:= pData, cntr:= udBytes2End); // copy the first block
    pData           += udBytes2End;
    pBuffer^.pWrite := pBuffer^.pMem$^USINT;
    udBytesTmp      := udSize - udBytes2End;
    _memcpy(ptr1:= pBuffer^.pWrite, ptr2:= pData, cntr:= udBytesTmp); // copy the second block
    pBuffer^.pWrite += udBytesTmp;

  else

    //##########################################################################################
    //### store data in one block
    //##########################################################################################
    _memcpy(ptr1:= pBuffer^.pWrite, ptr2:= pData, cntr:= udSize);
    pBuffer^.pWrite += udSize;

  end_if;

  pBuffer^.udUsed += udSize; // increase the number of bytes in ringbuffer
  dRetcode        := udSize$DINT;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::FLUSHRingbuffer
	VAR_INPUT
		dHandle 	: DINT;
	END_VAR
VAR
  pBuffer : ^_TX_RINGBUFFER;  // help pointer
END_VAR

  //##################################################################################
  //### Delete entry in send buffer
  //##################################################################################

  //*******************************************************
  if (CheckHandleValid(dHandle) = true) then

    pBuffer         := #dHandle$^_SOCKET^.SendBuffer;
    pBuffer^.pRead  := pBuffer^.pMem;
    pBuffer^.pWrite := pBuffer^.pMem;
    pBuffer^.udUsed := 0;

  end_if;
  //********************************************************

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::CyWork
	VAR_INPUT
		EAX 	: UDINT;
	END_VAR
	VAR_OUTPUT
		state (EAX) 	: UDINT;
	END_VAR

  //##################################################################################
  //### Cyclic call for main programm
  //##################################################################################

  CyclicCall();

	state := READY;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _UDPTransceiver::IsOpen
	VAR_INPUT
		dHandle 	: DINT;
	END_VAR
	VAR_OUTPUT
		bRetcode 	: BOOL;
	END_VAR

  //##################################################################################
  //### Socket state
  //##################################################################################

  bRetcode := false;

  if (CheckHandleValid(dHandle) = true) then
    bRetcode := dHandle$^_SOCKET^.bdStates.Allocated;
  end_if;

END_FUNCTION

FUNCTION _UDPTransceiver::CheckHandleValid
	VAR_INPUT
		dHandle 	: DINT;
	END_VAR
	VAR_OUTPUT
		bRetcode 	: BOOL;
	END_VAR
VAR
  i       : USINT;    // help variable for loop
  pSocket : ^_SOCKET; // help pointer
END_VAR

  //##################################################################################
  //### Check handle
  //##################################################################################

  bRetcode := false;

  if (dHandle = 0) then //### NIL pointer
    RETURN;
  end_if;

  pSocket := Sockets.pSockets;

  i := 0;
  while i < Sockets.dActSocket do

    if (pSocket = dHandle$^_SOCKET) then
      bRetcode := true;
      EXIT;
    end_if;

    pSocket := pSocket^.pNextSocket;
    i       += 1;

  end_while;

END_FUNCTION

FUNCTION _UDPTransceiver::SendUDP
	VAR_INPUT
		pSocket 	: ^_SOCKET;
		pData 	: ^CHAR;
		udSize 	: UDINT;
		udTimeout 	: UDINT;
		udIpAddress 	: UDINT;
		udPort 	: UDINT;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR

  //##################################################################################
  //### Send data
  //##################################################################################

  dRetcode := OS_TCP_USER_SENDTO(pSocket^.dSocket,
                                 pData,
                                 udSize,
                                 0, //### flags ... not used
                                 udTimeout,
                                 udIpAddress,
                                 udPort);

  if (dRetcode = udSize$DINT) then
  // Send ok
    SetError(bError:= 0, ErrorMessage:= _NO_ERROR_UDP_ERROR, dError:= 0);

  else
  // Error send
    udSendError += 1;
    SetError(bError:= 1, ErrorMessage:= _SEND_UDP_ERROR, dError:= dRetcode);
  end_if;

END_FUNCTION

FUNCTION _UDPTransceiver::SetError
	VAR_INPUT
		bError 	: BOOL;
		ErrorMessage 	: _UDP_ERROR;
		dError 	: DINT;
		pSocket 	: ^_SOCKET;(* := NIL *)
	END_VAR

  //##################################################################################
  //### Set error bit, message and OS error
  //##################################################################################

    sError        := bError;
    sErrorMessage := ErrorMessage;
    sErrorNoOS    := dError;

    if pSocket <> NIL then
      pSocket^.pCallbackThis$^_UDPTransceiverInterface^.ErrorCallback(pSocket^.FSM_UDP, ErrorMessage, dError);
    end_if;

END_FUNCTION

