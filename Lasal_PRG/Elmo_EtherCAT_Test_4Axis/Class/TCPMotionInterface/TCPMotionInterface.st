FUNCTION TCPMotionInterface::MoveLinearAbsEx

  VAR
    powerIsOn : DINT;
    profileLockState : DINT;
    profileLocked : BOOL;
  END_VAR

  GroupMoveRetCode := _LMCPROF_MOVECMD_ERROR;
  GroupReadErrorId := -7;

  if GroupCommandInputValid = TRUE then
    GroupReadErrorId := -2;
    if (IsClientConnected(#LMCRobot) = 1) &
       (IsClientConnected(#LMCAxis1) = 1) &
       (IsClientConnected(#LMCAxis2) = 1) &
       (IsClientConnected(#LMCAxis3) = 1) &
       (IsClientConnected(#LMCAxis4) = 1) then
      GroupReadErrorId := -6;
      powerIsOn := LMCRobot.RobotIsOn();
      profileLockState := LMCRobot.ReadProfileParameter(
        ParNo:=_LMCPROF_LockState);
      if profileLockState <> 0 then
        profileLocked := TRUE;
      else
        profileLocked := FALSE;
      end_if;

      if (GroupKinematicReady = TRUE) &
         (powerIsOn <> 0) &
         (profileLocked = TRUE) then
        GroupMoveRetCode := LMCRobot.MoveLinearCoord(
                                   pPositions:=#GroupMovePos,
                                   CmdConfig:=GroupCommandConfig,
                                   Velocity:=GroupVelocity,
                                   Accel:=GroupAccel,
                                   Decel:=GroupDecel,
                                   TransMode:=GroupTransitionMode,
                                   TransRadius:=GroupTransitionRadius,
                                   CoordSystem:=0,
                                   Jerk:=GroupJerk);
        if GroupMoveRetCode = _LMCPROF_NoError then
          GroupReadErrorId := 0;
        elsif GroupMoveRetCode$UDINT <= 32767 then
          GroupReadErrorId := GroupMoveRetCode$DINT;
        end_if;
      end_if;
    end_if;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  Sendbuf[0]$UINT := 0;
  Sendbuf[2]$UINT := 8;
  Sendbuf[4]$UDINT := 0;
  Sendbuf[8]$UDINT := AxisRef$UDINT;

  if GroupReadErrorId = 0 then
    Sendbuf[12]$UINT := 0;
    Sendbuf[14]$INT := 0;
  else
    Sendbuf[12]$UINT := 1;
    Sendbuf[14]$INT := GroupReadErrorId$INT;
  end_if;

  SendData(pData:=#Sendbuf[0], udSize:=16,
           dSocket:=CurrentSock, bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::GroupReadStatus

  VAR
    msgLen           : UDINT;
    robotState       : DINT;
    profileErrorInfo : _LMCPROFERRORDEF;
    powerIsOn        : DINT;
    profileLockState : DINT;
    profileLocked    : BOOL;
  END_VAR

  GroupReadErrorId := 0;
  GroupReadState := 0x40000000;
  GroupReadInPosition := 0;

  GroupReadInPosition := LMCRobot.ProfileInPosition(Mode:=_LMCPROF_ProfileFinished);
  powerIsOn := LMCRobot.RobotIsOn();
  profileLockState := LMCRobot.ReadProfileParameter(
    ParNo:=_LMCPROF_LockState);
  if profileLockState <> 0 then
    profileLocked := TRUE;
  else
    profileLocked := FALSE;
  end_if;
  robotState := LMCRobot.ReadRobotParameter(ParNo:=_ROBOT_STATE, Mode:=0);

  if powerIsOn <> 0 then
    // Project-local extension: robot power transition reached ready state.
    GroupReadState := GroupReadState or 0x00040000;
  end_if;

  if (powerIsOn <> 0) &
     (profileLocked = TRUE) &
     (GroupReadInPosition <> 0) then
    GroupReadState := GroupReadState or 0x00020000;
  elsif profileLocked = FALSE then
    GroupReadState := GroupReadState or 0x00010000;
  end_if;

  if robotState = _ROBOT_ERROR$DINT then
    profileErrorInfo := LMCRobot.ReadProfileError();
    GroupReadErrorId := profileErrorInfo.ErrorNo$DINT;
    if GroupReadErrorId = 0 then
      // Never report success while the robot says it is in an error state.
      GroupReadErrorId := -6;
    end_if;
  elsif (robotState < _ROBOT_PASSIVE$DINT) |
        (robotState > _ROBOT_MODE_CHANGE$DINT) then
    GroupReadErrorId := -6;
  end_if;

  msgLen := 0;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

  Sendbuf[0]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[2]$UINT := 0x000C;
  msgLen := msgLen + 2;

  Sendbuf[4]$UDINT := 0x00000000;
  msgLen := msgLen + 4;

  Sendbuf[8]$UDINT := GroupReadState;
  msgLen := msgLen + 4;

  Sendbuf[12]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[14]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[16]$UINT := GroupReadErrorId$UINT;
  msgLen := msgLen + 2;

  Sendbuf[18]$UINT := 0x0000;
  msgLen := msgLen + 2;

  SendData(pData:=#Sendbuf[0],
           udSize:=msgLen,
           dSocket:=CurrentSock,
           bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::ClampLRealToDint
	VAR_INPUT
		Value 	: LREAL;
	END_VAR
	VAR_OUTPUT
		ValueOut 	: DINT;
	END_VAR

  if Value > 2147483647.0 then
    ValueOut := 2147483647;
  elsif Value < -2147483647.0 then
    ValueOut := -2147483647;
  else
    ValueOut := TO_DINT(Value);
  end_if;

END_FUNCTION


