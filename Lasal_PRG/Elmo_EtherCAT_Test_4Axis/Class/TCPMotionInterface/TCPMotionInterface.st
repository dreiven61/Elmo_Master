          ActiveRequestValid := TRUE;
          state := READY;
          RETURN;
        end_if;
      end_if;
      ActiveRequest.Reserved := 0;
      ActiveRequestValid := FALSE;
    end_if;
    Diagnostics.NotifySessionClosed(
      SessionEpoch:=PendingClosedSessionEpoch);
    ControlCommands.NotifyAxisOwnershipSessionClosed(
      SessionEpoch:=PendingClosedSessionEpoch);
    if ActiveRequest.SessionEpoch = PendingClosedSessionEpoch then
      _memset(dest:=#ActiveRequest, usByte:=0, cntr:=sizeof(ActiveRequest));
    end_if;
    PendingClosedSessionEpoch := 0;
  end_if;

  currentEpoch := SessionEpoch;

  setPositionPendingTailPresent := FALSE;
  if (ActiveRequest.CommandId = 0x7D12) &
     (ActiveRequest.PayloadLength = 48) &
     ((ActiveRequest.PayloadData[
        LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT =
       LMC_ADMIN_SET_POSITION_PENDING_MAGIC) |
      (ActiveRequest.PayloadData[
        LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT =
       LMC_ADMIN_SET_POSITION_PENDING_MAGIC)) then
    setPositionPendingTailPresent := TRUE;
  elsif (ActiveRequestValid = TRUE) &
        (ActiveRequest.CommandId = 0x7D12) &
        (ActiveRequest.PayloadLength = 48) then
    setPositionPendingTailIndex :=
      LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET;
    while setPositionPendingTailIndex <=
          LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET do
      if ActiveRequest.PayloadData[
           setPositionPendingTailIndex]$UDINT <> 0 then
        setPositionPendingTailPresent := TRUE;
      end_if;
      setPositionPendingTailIndex += 4;
    end_while;
  end_if;

  // Retained owner and Home watchdogs continue across TCP session loss.
  if IsClientConnected(#ControlCommands) then
    ControlCommands.ProcessAxisZeroHome();
    ControlCommands.ProcessAxisOwnership();
  end_if;

  // Finish retained diagnostics receipts before admitting a new request that
  // could legally acquire the same axis after the old common owner is cleared.
  if IsClientConnected(#Diagnostics) then
    Diagnostics.ProcessOperations();
    PublishD5TerminalWake();
  end_if;

  if ActiveRequest.Reserved >= 2 then
    state := READY;
    RETURN;
  end_if;

  // ControlCommands resolves object names on demand through MsgPaser in this
  // CyWork context. CyWork performs no periodic discovery or retry loop.

  if (PendingClosedSessionEpoch = 0) &
     (ActiveRequestValid = TRUE) &
     (ActiveRequest.SessionEpoch <> currentEpoch) then
    if setPositionPendingTailPresent then
      cleanupPrimaryValid :=
        (ActiveRequest.PayloadData[
          LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT =
         LMC_ADMIN_SET_POSITION_PENDING_MAGIC) &
        (ActiveRequest.PayloadData[
          LMC_ADMIN_SET_POSITION_PENDING_CHECK_OFFSET]$UDINT =
         (LMC_ADMIN_SET_POSITION_PENDING_MAGIC xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SOCKET_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_COMMAND_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_LENGTH_OFFSET]$UDINT));
      cleanupCopyValid :=
        (ActiveRequest.PayloadData[
          LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT =
         LMC_ADMIN_SET_POSITION_PENDING_MAGIC) &
        (ActiveRequest.PayloadData[
          LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET]$UDINT =
         (LMC_ADMIN_SET_POSITION_PENDING_MAGIC xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_COPY_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_SOCKET_COPY_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_COMMAND_COPY_OFFSET]$UDINT xor
          ActiveRequest.PayloadData[
            LMC_ADMIN_SET_POSITION_PENDING_LENGTH_COPY_OFFSET]$UDINT));
      cleanupSessionEpoch := ActiveRequest.SessionEpoch;
      if cleanupPrimaryValid & cleanupCopyValid &
         (ActiveRequest.PayloadData[
           LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT <>
          0) &
         (ActiveRequest.PayloadData[
           LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT =
          ActiveRequest.PayloadData[
           LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT) then
        cleanupSessionEpoch := ActiveRequest.PayloadData[
          LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT;
      end_if;
      if cleanupSessionEpoch = 0 then
        cleanupSessionEpoch := currentEpoch;
      end_if;
      PendingClosedSessionEpoch := cleanupSessionEpoch;
      setPositionCallbackDisarmResult := DisarmRpcCallbackEndpoint();
      IngressBlocked := TRUE;
      IngressFaultPending := FALSE;
      IngressFaultCloseRequired := TRUE;
      RpcSocket := 0;
      RpcInitialized := FALSE;
      publishFailureCloseSocket := ActiveRequest.Socket;
      if publishFailureCloseSocket <> 0 then
        LastOwnerDisconnectRequestRet :=
          _TCPIPServerInterface::SetSocketParameter(
            dSock:=publishFailureCloseSocket,
            Cmd:=100,
            SubCmd:=0,
            ParaValue:=0
          );
      end_if;
      _memset(
        dest:=#ActiveRequest.PayloadData[
         LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET],
        usByte:=0,
        cntr:=56);
      ActiveRequestValid := FALSE;
    else
      ActiveRequestValid := FALSE;
    end_if;
  end_if;

  // The queue has one cyclic owner, so enum states use direct transitions.
  if (PendingClosedSessionEpoch = 0) & (ActiveRequestValid = FALSE) then
    if RequestQueue[QueueReadIndex$DINT].State = TCPMI_QUEUE_READY then
      RequestQueue[QueueReadIndex$DINT].State := TCPMI_QUEUE_ACTIVE;
      _StdLib.MemCpy(
        dest:=#ActiveRequest,
        source:=#RequestQueue[QueueReadIndex$DINT],
        size:=sizeof(ActiveRequest)
      );
      RequestQueue[QueueReadIndex$DINT].State := TCPMI_QUEUE_FREE;
      QueueReadIndex := (QueueReadIndex + 1) mod 8;
      ActiveRequestValid := TRUE;
    end_if;
  end_if;

  if (PendingClosedSessionEpoch = 0) & (ActiveRequestValid = TRUE) then
    if ActiveRequest.SessionEpoch = currentEpoch then
      _memset(dest:=#RequestBuf, usByte:=0, cntr:=sizeof(RequestBuf));
      RequestBuf[0]$UINT := ActiveRequest.CommandId;
      RequestBuf[4]$UINT := ActiveRequest.PayloadLength;
      RequestBuf[6]$UINT := ActiveRequest.Reference;
      if ActiveRequest.PayloadLength > 0 then
        _StdLib.MemCpy(
          dest:=#RequestBuf[8],
          source:=#ActiveRequest.PayloadData[0],
          size:=ActiveRequest.PayloadLength
        );
      end_if;

      CommandID := TO_DINT(ActiveRequest.CommandId);
      AxisRef := TO_DINT(ActiveRequest.Reference);
      Payload := TO_DINT(ActiveRequest.PayloadLength);
      CurrentSock := ActiveRequest.Socket;
	  // Reserved remains one only while the same authenticated safety tuple is
	  // waiting for the RT LOW/readback drain. MsgPaser clears it on terminal.
      MsgPaser();
    end_if;
	if (ActiveRequest.Reserved = 0) &
	   (((ActiveRequest.CommandId <> 0x7D12) |
	     (ActiveRequest.PayloadLength <> 48)) |
	    ((ActiveRequest.PayloadData[
	      LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT <>
	     LMC_ADMIN_SET_POSITION_PENDING_MAGIC) &
	     (ActiveRequest.PayloadData[
	      LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT <>
	     LMC_ADMIN_SET_POSITION_PENDING_MAGIC))) then
	  ActiveRequestValid := FALSE;
	end_if;
  end_if;

  // Fault responses are ordered after every request accepted before the fault.
  if (ActiveRequestValid = FALSE) & (IngressFaultPending = TRUE) &
     (RequestQueue[QueueReadIndex$DINT].State <> TCPMI_QUEUE_READY) then
    if IngressFaultEpoch <> currentEpoch then
      IngressFaultPending := FALSE;
      if (IngressFaultCloseRequired = FALSE) &
         (IngressDiscardRemaining = 0) then
        IngressBlocked := FALSE;
      end_if;
    else
      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 1;

      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := IngressFaultError;
      sendRet := SendData(
        pData:=#Sendbuf[0],
        udSize:=12,
        dSocket:=IngressFaultSocket,
        bDirect:=TRUE
      );
      if sendRet = 12 then
        IngressFaultPending := FALSE;
        if (IngressFaultCloseRequired = FALSE) &
           (IngressDiscardRemaining = 0) then
          IngressBlocked := FALSE;
        end_if;
      else

        IngressFaultPending := FALSE;
        IngressBlocked := TRUE;
        IngressFaultCloseRequired := TRUE;
      end_if;
    end_if;
  end_if;
	state := READY;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::ConnSocketInfo
	VAR_INPUT
		dSock 	: DINT;
		InfoPara1 	: DINT;
		InfoPara2 	: DINT;
	END_VAR
	VAR
		takeCandidate 	: BOOL;
		takeover 	: BOOL;
		candidatePeerValid 	: BOOL;
		preservePendingActive : BOOL;
		setPositionPendingTailIndex : DINT;
		setPositionPendingTailPresent : BOOL;
		candidatePeerIPv4 	: UDINT;
		activePeerIPv4 	: UDINT;
		callbackDisarmResult : DINT;
		ownerLossRetireResult : DINT;
	END_VAR

  case InfoPara1 of
    TCP_SVR_SOCK_INFO_CONNECT :
      // A duplicate callback for the current descriptor is not a new client.
      if CurrentSock = dSock then
        LastTakeoverResult := -7;
        RETURN;
      end_if;

      ConnectedClients +=1;
      if ActiveRequest.Reserved >= 2 then
        LastCandidateDisconnectRequestRet :=
          _TCPIPServerInterface::SetSocketParameter(
            dSock:=dSock,
            Cmd:=100,
            SubCmd:=0,
            ParaValue:=0
          );
        RETURN;
      end_if;
      takeCandidate := FALSE;
      takeover := FALSE;
      candidatePeerValid := FALSE;
      candidatePeerIPv4 := 0;
      activePeerIPv4 := 0;
      LastCandidateSock := dSock;
      LastCandidatePeerIPv4 := 0;
      LastOwnerDisconnectRequestRet := 0;
      LastCandidateDisconnectRequestRet := 0;

      // TCP_USER is used only to read peer addresses. Socket close ownership
      // remains in TCPIPServer and its inherited _TCPIPServer FSM.
      if lsl_tcp_user = NIL then
        LastCilTcpUserRet := OS_CILGET("TCP_USER", #lsl_tcp_user);
        if LastCilTcpUserRet <> SYS_ERR_NONE then
          lsl_tcp_user := NIL;
        end_if;
      else
        LastCilTcpUserRet := SYS_ERR_NONE;
      end_if;

      if lsl_tcp_user <> NIL then
        LastCandidatePeerLookupRet := OS_TCP_USER_GETPEERIP(
          dSock,
          #candidatePeerIPv4
        );
        if LastCandidatePeerLookupRet >= 0 then
          candidatePeerValid := TRUE;
          LastCandidatePeerIPv4 := candidatePeerIPv4;
        end_if;
      else
        LastCandidatePeerLookupRet := -90;
      end_if;

      if CurrentSock = 0 then
        // The first socket is allowed even if peer lookup is unavailable. A
        // later candidate will retry the active socket lookup before takeover.
        takeCandidate := TRUE;
        LastTakeoverResult := 1;
      else
        if CurrentPeerValid = FALSE then
          if lsl_tcp_user <> NIL then
            LastActivePeerLookupRet := OS_TCP_USER_GETPEERIP(
              CurrentSock,
              #activePeerIPv4
            );
            if LastActivePeerLookupRet >= 0 then
              CurrentPeerIPv4 := activePeerIPv4;
              CurrentPeerValid := TRUE;
            end_if;
          else
            LastActivePeerLookupRet := -90;
          end_if;
        else
          LastActivePeerLookupRet := SYS_ERR_NONE;
        end_if;

        if candidatePeerValid = FALSE then
          LastTakeoverResult := -2;
        elsif CurrentPeerValid = FALSE then
          LastTakeoverResult := -3;
        elsif candidatePeerIPv4 <> CurrentPeerIPv4 then
          LastTakeoverResult := -4;
        else
          // Custom command 100 is implemented only by editable TCPIPServer.
          // It marks the old slot for inherited base-FSM shutdown.
          LastOwnerDisconnectRequestRet :=
            _TCPIPServerInterface::SetSocketParameter(
              dSock:=CurrentSock,
              Cmd:=100,
              SubCmd:=0,
              ParaValue:=0
            );
          if LastOwnerDisconnectRequestRet = TCP_SVR_NO_ERROR then
            RetiringSock := CurrentSock;
            takeCandidate := TRUE;
            takeover := TRUE;
            TakeoverCount += 1;
            LastTakeoverResult := 2;
          else
            LastTakeoverResult := -5;
          end_if;
        end_if;
      end_if;

      if takeCandidate = FALSE then
        // Reject unknown or different peers and keep the current owner.
        TakeoverRejectCount += 1;
        LastCandidateDisconnectRequestRet :=
          _TCPIPServerInterface::SetSocketParameter(
            dSock:=dSock,
            Cmd:=100,
            SubCmd:=0,
            ParaValue:=0
          );
      else
        if takeover = TRUE then
          if (SessionEpoch <> 0) &
             (PendingClosedSessionEpoch = 0) then
            PendingClosedSessionEpoch := SessionEpoch;
          end_if;
        end_if;

        // A fresh owner must not inherit transport state from a closed epoch.
        ActiveRequestValid := FALSE;
        _memset(dest:=#RequestQueue[0], usByte:=0, cntr:=sizeof(RequestQueue));
        QueueWriteIndex := 0;
        QueueReadIndex := 0;
        setPositionPendingTailPresent := FALSE;
        if (ActiveRequest.CommandId = 0x7D12) &
           (ActiveRequest.PayloadLength = 48) then
          if (ActiveRequest.PayloadData[
              LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT =
              LMC_ADMIN_SET_POSITION_PENDING_MAGIC) |
             (ActiveRequest.PayloadData[
              LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT =
              LMC_ADMIN_SET_POSITION_PENDING_MAGIC) then
            setPositionPendingTailPresent := TRUE;
          else
            setPositionPendingTailIndex :=
              LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET;
            while setPositionPendingTailIndex <=
                  LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET do
              if ActiveRequest.PayloadData[
                 setPositionPendingTailIndex]$UDINT <> 0 then
                setPositionPendingTailPresent := TRUE;
              end_if;
              setPositionPendingTailIndex += 4;
            end_while;
          end_if;
        end_if;
        // Preserve authenticated safety or SetPosition close evidence.
        preservePendingActive :=
          (ActiveRequest.Reserved = 1) |
          ((ActiveRequest.PayloadData[
              LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT =
              LMC_OWNER_SAFETY_PENDING_MAGIC) &
           (((ActiveRequest.CommandId = 0x2022) &
             (ActiveRequest.PayloadLength = 16)) |
            ((ActiveRequest.CommandId = 0x2023) &
             (ActiveRequest.PayloadLength = 8)) |
            ((ActiveRequest.CommandId = 0x2048) &
             (ActiveRequest.PayloadLength = 1)) |
            ((ActiveRequest.CommandId = 0x204B) &
             (ActiveRequest.PayloadLength = 1)) |
            ((ActiveRequest.CommandId = 0x2085) &
             (ActiveRequest.PayloadLength = 16)))) |
          ((ActiveRequest.CommandId = 0x7D12) &
           (ActiveRequest.PayloadLength = 48) &
           setPositionPendingTailPresent);
        if preservePendingActive = FALSE then
          _memset(dest:=#ActiveRequest, usByte:=0, cntr:=sizeof(ActiveRequest));
        end_if;
        _memset(dest:=#RequestBuf, usByte:=0, cntr:=sizeof(RequestBuf));
        CommandID := 0;
        AxisRef := 0;
        Payload := 0;

        ReceiveFill := 0;
        ReceiveSocket := 0;
        _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));

		RpcSocket := 0;
		RpcInitialized := FALSE;

        IngressFaultPending := FALSE;
        IngressBlocked := FALSE;
        IngressFaultCloseRequired := FALSE;
        IngressFaultSocket := 0;
        IngressFaultEpoch := 0;
        IngressFaultError := 0;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;

		// Preserve PendingClosedSessionEpoch until CyWork notifies Diagnostics.
		// Reset the Watch latch before this exact owner-loss boundary.
		RpcCallbackLastDisarmResult := 1;
		callbackDisarmResult := DisarmRpcCallbackEndpoint();
		if (callbackDisarmResult = -8) &
		   IsClientConnected(#CallbackSender) then
		  ownerLossRetireResult := CallbackSender.DisarmEndpoint(
			ExpectedSessionEpoch:=0,
			ExpectedCookieLo:=0,
			ExpectedCookieHi:=0);
		  if (ownerLossRetireResult = 0) |
			 (ownerLossRetireResult = 1) then
			callbackDisarmResult := DisarmRpcCallbackEndpoint();
			if (callbackDisarmResult = 0) |
			   (callbackDisarmResult = 1) then
			  // Exact -8 means sentinel and confirmation both completed.
			  RpcCallbackLastDisarmResult := -8;
			end_if;
		  else
			// Preserve the actual sentinel failure for tuple-correlated evidence.
			RpcCallbackLastDisarmResult := ownerLossRetireResult;
		  end_if;
		elsif callbackDisarmResult = -8 then
		  // The sender link vanished before the sentinel could run.
		  RpcCallbackLastDisarmResult := -9;
		end_if;
		SessionEpoch += 1;
        if SessionEpoch = 0 then
          SessionEpoch := 1;
        end_if;
        CurrentSock := dSock;
        CurrentPeerIPv4 := candidatePeerIPv4;
        CurrentPeerValid := candidatePeerValid;
      end_if;

    TCP_SVR_SOCK_INFO_DISCONNECT :
      ConnectedClients -=1;
      if ConnectedClients < 0 then
        ConnectedClients :=0;
      end_if;
      if RetiringSock = dSock then
        RetiringSock := 0;
      end_if;
      if CurrentSock = dSock then
        CurrentSock := 0;
        CurrentPeerIPv4 := 0;
        CurrentPeerValid := FALSE;
		if (SessionEpoch <> 0) & (PendingClosedSessionEpoch = 0) then
		  PendingClosedSessionEpoch := SessionEpoch;
		end_if;
		// Reset the Watch latch before this exact owner-loss boundary.
		RpcCallbackLastDisarmResult := 1;
		callbackDisarmResult := DisarmRpcCallbackEndpoint();
		if (callbackDisarmResult = -8) &
		   IsClientConnected(#CallbackSender) then
		  ownerLossRetireResult := CallbackSender.DisarmEndpoint(
			ExpectedSessionEpoch:=0,
			ExpectedCookieLo:=0,
			ExpectedCookieHi:=0);
		  if (ownerLossRetireResult = 0) |
			 (ownerLossRetireResult = 1) then
			callbackDisarmResult := DisarmRpcCallbackEndpoint();
			if (callbackDisarmResult = 0) |
			   (callbackDisarmResult = 1) then
			  // Exact -8 means sentinel and confirmation both completed.
			  RpcCallbackLastDisarmResult := -8;
			end_if;
		  else
			// Preserve the actual sentinel failure for tuple-correlated evidence.
			RpcCallbackLastDisarmResult := ownerLossRetireResult;
		  end_if;
		elsif callbackDisarmResult = -8 then
		  // The sender link vanished before the sentinel could run.
		  RpcCallbackLastDisarmResult := -9;
		end_if;
		SessionEpoch += 1;
        if SessionEpoch = 0 then
          SessionEpoch := 1;
        end_if;
        if ActiveRequest.Reserved < 2 then
          IngressBlocked := FALSE;
          IngressFaultPending := FALSE;
          IngressFaultCloseRequired := FALSE;
        end_if;
      end_if;
		if RpcSocket = dSock then
		  RpcSocket := 0;
		  RpcInitialized := FALSE;
		end_if;
      if ReceiveSocket = dSock then
        ReceiveFill := 0;
        ReceiveSocket := 0;
        _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      end_if;
      if IngressFaultSocket = dSock then
        if ActiveRequest.Reserved < 2 then
          IngressFaultPending := FALSE;
          IngressFaultCloseRequired := FALSE;
          IngressBlocked := FALSE;
        end_if;
      end_if;
  end_case;


END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::DataHandling
	VAR_INPUT
		dSocket 	: DINT;
		udAvailableData 	: UDINT;
	END_VAR
	VAR_OUTPUT
		udReadAvailableDataBytes 	: UDINT;
	END_VAR
	VAR
		freeSize 	: UDINT;
	END_VAR

  udReadAvailableDataBytes := 0;
  // A retiring or rejected connection is drained without entering the owner
  // receive accumulator. First CONNECT publishes CurrentSock before recv.
  if dSocket <> CurrentSock then
    if udAvailableData < sizeof(ReceiveBuf) then
      udReadAvailableDataBytes := udAvailableData;
    else
      udReadAvailableDataBytes := sizeof(ReceiveBuf);
    end_if;
    RETURN;
  elsif (IngressDiscardRemaining > 0) &
     (IngressDiscardSocket = dSocket) then
    freeSize := IngressDiscardRemaining;
    if freeSize > sizeof(ReceiveBuf) then
      freeSize := sizeof(ReceiveBuf);
    end_if;
    if udAvailableData < freeSize then
      udReadAvailableDataBytes := udAvailableData;
    else
      udReadAvailableDataBytes := freeSize;
    end_if;
  elsif (IngressBlocked = FALSE) & (ReceiveFill < sizeof(ReceiveBuf)) then
    freeSize := sizeof(ReceiveBuf) - ReceiveFill;
    if udAvailableData < freeSize then
      udReadAvailableDataBytes := udAvailableData;
    else
      udReadAvailableDataBytes := freeSize;
    end_if;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::SendData
	VAR_INPUT
		pData 	: ^void;
		udSize 	: UDINT;
		dSocket 	: DINT;
		bDirect 	: BOOL;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR
	VAR
		callbackDisarmResult : DINT;
	END_VAR

  dRetcode := _TCPIPServerInterface::SendData(
    pData:=pData,
    udSize:=udSize,
    dSocket:=dSocket,
    bDirect:=bDirect
  );

  // A direct partial send cannot be retried without corrupting the stream.
  // Quarantine the session and require a clean TCP reconnect.
	if dRetcode <> udSize$DINT then
	  if (SessionEpoch <> 0) & (PendingClosedSessionEpoch = 0) then
		PendingClosedSessionEpoch := SessionEpoch;
	  end_if;
	  callbackDisarmResult := DisarmRpcCallbackEndpoint();
	  SessionEpoch += 1;
    if SessionEpoch = 0 then
      SessionEpoch := 1;
    end_if;
    IngressBlocked := TRUE;
    IngressFaultPending := FALSE;
	  IngressFaultCloseRequired := TRUE;
	  RpcSocket := 0;
	  RpcInitialized := FALSE;
	end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::Response
	VAR_INPUT
		pData 	: ^void;
		udSize 	: UDINT;
		dSock 	: DINT;
	END_VAR
  VAR
	usPayloadLength : UINT;
	usReference : UINT;
	usCommandId : UINT;
	udFrameSize : UDINT;
	udRemainingSize : UDINT;
	END_VAR

  if ActiveRequest.Reserved >= 2 then
    RETURN;
  end_if;

  if udSize = 0 then
    RETURN;
  end_if;

  // Delayed bytes from a retiring socket and data from a rejected candidate
  // must never fault or mutate the active session.
  if dSock <> CurrentSock then
    RETURN;
  end_if;

  // Drain a rejected frame without copying its remaining payload. DataHandling
  // limits each callback to the exact number of bytes still to discard.
  if IngressDiscardRemaining > 0 then
    if IngressDiscardSocket = dSock then
      if udSize >= IngressDiscardRemaining then
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
        if (IngressFaultPending = FALSE) &
           (IngressFaultCloseRequired = FALSE) then
          IngressBlocked := FALSE;
        end_if;
      else
        IngressDiscardRemaining -= udSize;
      end_if;
    end_if;
    RETURN;
  end_if;

  // Response is an ingress callback only. It never sends or calls motion APIs.
  if (RpcInitialized = TRUE) & (RpcSocket <> dSock) then
    if IngressFaultPending = FALSE then
      IngressFaultSocket := dSock;
      IngressFaultEpoch := SessionEpoch;
      IngressFaultError := -1;
      IngressFaultCloseRequired := FALSE;
      IngressFaultPending := TRUE;
    end_if;
    RETURN;
  end_if;

  if ReceiveFill = 0 then
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  elsif ReceiveSocket <> dSock then
    // Before a session exists, let the latest socket restart the phase-1
    // accumulator so an abandoned partial frame cannot block initialization.
    ReceiveFill := 0;
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  end_if;

  if udSize > sizeof(ReceiveBuf) - ReceiveFill then
    if IngressFaultPending = FALSE then
      IngressFaultSocket := dSock;
      IngressFaultEpoch := SessionEpoch;
      IngressFaultError := -8;
      IngressFaultCloseRequired := TRUE;
      IngressFaultPending := TRUE;
    end_if;
    IngressBlocked := TRUE;
    ReceiveFill := 0;
    ReceiveSocket := 0;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    RETURN;
  end_if;

  _StdLib.MemCpy(
    dest:=#ReceiveBuf[ReceiveFill$DINT],
    source:=pData,
    size:=udSize
  );
  ReceiveFill += udSize;

  while ReceiveFill >= 8 do
    usPayloadLength := 0;
    _StdLib.MemCpy(dest:=#usPayloadLength, source:=#ReceiveBuf[4], size:=2);
    udFrameSize := TO_UDINT(usPayloadLength) + 8;

    if usPayloadLength > 1320 then
      if IngressFaultPending = FALSE then
        IngressFaultSocket := ReceiveSocket;
        IngressFaultEpoch := SessionEpoch;
        IngressFaultError := -5;
        IngressFaultPending := TRUE;
      end_if;
      IngressBlocked := TRUE;
      if udFrameSize > ReceiveFill then
        IngressFaultCloseRequired := FALSE;
        IngressDiscardRemaining := udFrameSize - ReceiveFill;
        IngressDiscardSocket := ReceiveSocket;
      elsif udFrameSize = ReceiveFill then
        IngressFaultCloseRequired := FALSE;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      else
        // A following frame is already partially buffered. Reconnect is the
        // only safe P0 resynchronization because its boundary is unknown.
        IngressFaultCloseRequired := TRUE;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      end_if;
      ReceiveFill := 0;
      ReceiveSocket := 0;
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      RETURN;
    end_if;

    if ReceiveFill < udFrameSize then
      RETURN;
    end_if;

    usCommandId := 0;
    usReference := 0;

    _StdLib.MemCpy(dest:=#usCommandId, source:=#ReceiveBuf[0], size:=2);
    _StdLib.MemCpy(dest:=#usReference, source:=#ReceiveBuf[6], size:=2);

    if RequestQueue[QueueWriteIndex$DINT].State = TCPMI_QUEUE_FREE then
      RequestQueue[QueueWriteIndex$DINT].State := TCPMI_QUEUE_WRITING;
      NextSequence += 1;
      if NextSequence = 0 then
        NextSequence := 1;
      end_if;
      RequestQueue[QueueWriteIndex$DINT].Sequence := NextSequence;
      RequestQueue[QueueWriteIndex$DINT].Socket := ReceiveSocket;
      RequestQueue[QueueWriteIndex$DINT].SessionEpoch := SessionEpoch;
      RequestQueue[QueueWriteIndex$DINT].CommandId := usCommandId;
      RequestQueue[QueueWriteIndex$DINT].Reference := usReference;
      RequestQueue[QueueWriteIndex$DINT].PayloadLength := usPayloadLength;
      RequestQueue[QueueWriteIndex$DINT].Reserved := 0;
      _memset(
        dest:=#RequestQueue[QueueWriteIndex$DINT].PayloadData[0],
        usByte:=0,
        cntr:=1320
      );
      if usPayloadLength > 0 then
        _StdLib.MemCpy(
          dest:=#RequestQueue[QueueWriteIndex$DINT].PayloadData[0],
          source:=#ReceiveBuf[8],
          size:=usPayloadLength
        );
      end_if;
      RequestQueue[QueueWriteIndex$DINT].State := TCPMI_QUEUE_READY;
      QueueWriteIndex := (QueueWriteIndex + 1) mod 8;
    else
      if IngressFaultPending = FALSE then
        IngressFaultSocket := ReceiveSocket;
        IngressFaultEpoch := SessionEpoch;
        IngressFaultError := -8;
        IngressFaultCloseRequired := ReceiveFill > udFrameSize;
        IngressFaultPending := TRUE;
      end_if;
      IngressBlocked := TRUE;
      ReceiveFill := 0;
      ReceiveSocket := 0;
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      RETURN;
    end_if;

    udRemainingSize := ReceiveFill - udFrameSize;
    if udRemainingSize > 0 then
      _StdLib.MemMove(
        dest:=#ReceiveBuf[0],
        source:=#ReceiveBuf[udFrameSize$DINT],
        size:=udRemainingSize
      );
      _memset(
        dest:=#ReceiveBuf[udRemainingSize$DINT],
        usByte:=0,
        cntr:=sizeof(ReceiveBuf) - udRemainingSize
      );
    else
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    end_if;

    ReceiveFill := udRemainingSize;
    if ReceiveFill = 0 then
      ReceiveSocket := 0;
    end_if;
  end_while;


END_FUNCTION


FUNCTION TCPMotionInterface::HandleControlSafetyDrainPending
	VAR_INPUT
		Phase 	: UINT;
		EffectiveAxisMask 	: UDINT;
		AdmissionToken 	: UDINT;
		OwnerGeneration 	: UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		pendingRequiredMask : UDINT;
		pendingAxisMask : UDINT;
		pendingAdmissionToken : UDINT;
		pendingOwnerGeneration : UDINT;
		pendingStart : UDINT;
		pendingRollbackResult : DINT;
		pendingPublishResult : DINT;
		pendingResponseSize : DINT;
		pendingShapeValid : BOOL;
		pendingPrimaryValid : BOOL;
		pendingCopyValid : BOOL;
		pendingContextValid : BOOL;
		pendingTimedOut : BOOL;
		pendingCloseRequired : BOOL;
		pendingSendResponse : BOOL;
		pendingAccepted : BOOL;
		pendingFailure : BOOL;
		callbackDisarmResult : DINT;
	END_VAR

	Result := -1;
	pendingRequiredMask := 0;
	pendingAxisMask := 0;
	pendingAdmissionToken := 0;
	pendingOwnerGeneration := 0;
	pendingStart := 0;
	pendingRollbackResult := 0;
	pendingPublishResult := 0;
	pendingResponseSize := 0;
	pendingShapeValid := FALSE;
	pendingPrimaryValid := FALSE;
	pendingCopyValid := FALSE;
	pendingContextValid := FALSE;
	pendingTimedOut := FALSE;
	pendingCloseRequired := FALSE;
	pendingSendResponse := FALSE;
	pendingAccepted := FALSE;
	pendingFailure := FALSE;

	// Only these five authenticated safety forms may retain a RESERVED tuple.
	case CommandID of
		0x2022:
			pendingShapeValid :=
				(Payload = 16) & (AxisRef >= 1) & (AxisRef <= 9) &
				(RequestBuf[8]$DINT > 0) &
				(RequestBuf[12]$DINT >= 0) &
				(RequestBuf[16]$DINT = 1) &
				(RequestBuf[20]$DINT = 1);
		0x2023:
			pendingShapeValid :=
				(Payload = 8) & (AxisRef >= 1) & (AxisRef <= 9) &
				(RequestBuf[8]$UDINT = 1) &
				(RequestBuf[12] = 0) &
				(RequestBuf[13] = 1) & (RequestBuf[14] = 0) &
				(RequestBuf[15] = 1);
		0x2048:
			pendingShapeValid :=
				(Payload = 1) & (AxisRef = 0x0100) &
				(RequestBuf[8] = 1);
			pendingRequiredMask := LMC_OWNER_PROFILE_AXIS_MASK;
		0x204B:
			pendingShapeValid :=
				(Payload = 1) & (AxisRef = 0x0100) &
				(RequestBuf[8] = 1);
			pendingRequiredMask := LMC_OWNER_ROBOT_AXIS_MASK;
		0x2085:
			pendingShapeValid :=
				(Payload = 16) & (AxisRef = 0x0100) &
				(RequestBuf[8]$DINT >= 0) &
				(RequestBuf[12]$DINT >= 0) &
				(RequestBuf[16]$DINT = 1) &
				(RequestBuf[20]$DINT = 1) &
				((RequestBuf[12]$DINT = 0) |
				 (RequestBuf[8]$DINT > 0));
			pendingRequiredMask := LMC_OWNER_PROFILE_AXIS_MASK;
	else
	end_case;
	if pendingShapeValid & (pendingRequiredMask = 0) then
		case AxisRef of
			1: pendingRequiredMask := 0x00000001;
			2: pendingRequiredMask := 0x00000002;
			3: pendingRequiredMask := 0x00000004;
			4: pendingRequiredMask := 0x00000008;
			5: pendingRequiredMask := 0x00000010;
			6: pendingRequiredMask := 0x00000020;
			7: pendingRequiredMask := 0x00000040;
			8: pendingRequiredMask := 0x00000080;
			9: pendingRequiredMask := 0x00000100;
		else
		end_case;
	end_if;

	case Phase of
		LMC_OWNER_SAFETY_PHASE_PREPARE:
			if (ActiveRequest.Reserved <> 1) &
			   (ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT <>
				 LMC_OWNER_SAFETY_PENDING_MAGIC) then
				Result := 0;
			else
				pendingPrimaryValid :=
					(ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT =
					 LMC_OWNER_SAFETY_PENDING_MAGIC) &
					(ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_CHECK_OFFSET]$UDINT =
					 (LMC_OWNER_SAFETY_PENDING_MAGIC xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_START_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_SESSION_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_SEQUENCE_OFFSET]$UDINT));
				pendingCopyValid :=
					(ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT =
					 LMC_OWNER_SAFETY_PENDING_MAGIC) &
					(ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_CHECK_COPY_OFFSET]$UDINT =
					 (LMC_OWNER_SAFETY_PENDING_MAGIC xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_MASK_COPY_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_TOKEN_COPY_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_GENERATION_COPY_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_START_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_SESSION_COPY_OFFSET]$UDINT xor
					  ActiveRequest.PayloadData[
					   LMC_OWNER_SAFETY_PENDING_SEQUENCE_COPY_OFFSET]$UDINT));
				pendingStart := ActiveRequest.PayloadData[
					LMC_OWNER_SAFETY_PENDING_START_OFFSET]$UDINT;
				if pendingPrimaryValid then
					pendingAxisMask := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT;
					pendingAdmissionToken := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT;
					pendingOwnerGeneration := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT;
				else
					pendingAxisMask := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_MASK_COPY_OFFSET]$UDINT;
					pendingAdmissionToken := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_TOKEN_COPY_OFFSET]$UDINT;
					pendingOwnerGeneration := ActiveRequest.PayloadData[
						LMC_OWNER_SAFETY_PENDING_GENERATION_COPY_OFFSET]$UDINT;
				end_if;
				pendingContextValid := pendingShapeValid &
					(pendingPrimaryValid | pendingCopyValid) &
					(pendingAxisMask <> 0) &
					(pendingAxisMask <= LMC_OWNER_ROBOT_AXIS_MASK) &
					((pendingAxisMask and pendingRequiredMask) =
					 pendingRequiredMask) &
					(pendingAdmissionToken <> 0) &
					(pendingOwnerGeneration <> 0) &
					(ActiveRequest.SessionEpoch <> 0) &
					(ActiveRequest.Sequence <> 0);
				if pendingPrimaryValid then
					pendingContextValid := pendingContextValid &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SESSION_OFFSET]$UDINT =
						 ActiveRequest.SessionEpoch) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SEQUENCE_OFFSET]$UDINT =
						 ActiveRequest.Sequence);
				else
					pendingContextValid := pendingContextValid &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SESSION_COPY_OFFSET]$UDINT =
						 ActiveRequest.SessionEpoch) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SEQUENCE_COPY_OFFSET]$UDINT =
						 ActiveRequest.Sequence);
				end_if;
				if pendingPrimaryValid & pendingCopyValid then
					pendingContextValid := pendingContextValid &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT =
						 ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_MASK_COPY_OFFSET]$UDINT) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT =
						 ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_TOKEN_COPY_OFFSET]$UDINT) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT =
						 ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_GENERATION_COPY_OFFSET]$UDINT) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SESSION_OFFSET]$UDINT =
						 ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SESSION_COPY_OFFSET]$UDINT) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SEQUENCE_OFFSET]$UDINT =
						 ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_SEQUENCE_COPY_OFFSET]$UDINT);
				end_if;
				pendingTimedOut := pendingContextValid &
					((ops.tAbsolute - pendingStart) >=
					 LMC_OWNER_SAFETY_DRAIN_TIMEOUT_MS);
				if pendingContextValid & (pendingTimedOut = FALSE) then
					// Canonicalize the primary copy before the parser loads it.
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT := pendingAxisMask;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT :=
						pendingAdmissionToken;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT :=
						pendingOwnerGeneration;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_SESSION_OFFSET]$UDINT :=
						ActiveRequest.SessionEpoch;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_SEQUENCE_OFFSET]$UDINT :=
						ActiveRequest.Sequence;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_CHECK_OFFSET]$UDINT :=
						LMC_OWNER_SAFETY_PENDING_MAGIC xor pendingAxisMask xor
						pendingAdmissionToken xor pendingOwnerGeneration xor
						pendingStart xor ActiveRequest.SessionEpoch xor
						ActiveRequest.Sequence;
					ActiveRequest.Reserved := 1;
					Result := 1;
				else
					if IsClientConnected(#ControlCommands) then
						pendingRollbackResult :=
						  ControlCommands.RollbackAxisOwnership(
							AdmissionToken:=pendingAdmissionToken,
							OwnerGeneration:=pendingOwnerGeneration,
							CallerSessionEpoch:=ActiveRequest.SessionEpoch,
							RequestSequence:=ActiveRequest.Sequence,
							Reason:=0);
					else
						pendingRollbackResult := -3;
					end_if;
					if pendingRollbackResult <> 0 then
						pendingCloseRequired := TRUE;
						pendingPublishResult := -3;
						if IsClientConnected(#ControlCommands) then
						  pendingPublishResult :=
							ControlCommands.PublishAxisOwnership(
								AxisMask:=pendingAxisMask,
								AdmissionToken:=pendingAdmissionToken,
								OwnerGeneration:=pendingOwnerGeneration,
								ReportKind:=4,
								ReportValue0:=TO_UDINT(pendingRollbackResult),
								ReportValue1:=42,
								ObservationCycle:=ActiveRequest.Sequence);
						end_if;
						if pendingPublishResult <> 0 then
							ActiveRequest.Reserved := 2;
							ActiveRequestValid := TRUE;
							RETURN;
						end_if;
					end_if;
					if pendingContextValid = FALSE then
						pendingCloseRequired := TRUE;
					end_if;
					ActiveRequest.Reserved := 0;
					pendingSendResponse := TRUE;
					Result := 0;
				end_if;
			end_if;

		LMC_OWNER_SAFETY_PHASE_RETAIN:
			pendingContextValid := pendingShapeValid &
				(EffectiveAxisMask <> 0) &
				(EffectiveAxisMask <= LMC_OWNER_ROBOT_AXIS_MASK) &
				((EffectiveAxisMask and pendingRequiredMask) =
				 pendingRequiredMask) &
				(AdmissionToken <> 0) & (OwnerGeneration <> 0) &
				(ActiveRequest.SessionEpoch <> 0) &
				(ActiveRequest.Sequence <> 0);
			if pendingContextValid then
				if ActiveRequest.Reserved = 0 then
					pendingStart := ops.tAbsolute;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT := 0;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_RESPONSE_OFFSET]$DINT := 0;
					ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_START_OFFSET]$UDINT := pendingStart;
				else
					pendingStart := ActiveRequest.PayloadData[
					 LMC_OWNER_SAFETY_PENDING_START_OFFSET]$UDINT;
					pendingContextValid :=
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT =
						 LMC_OWNER_SAFETY_PENDING_MAGIC) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT =
						 EffectiveAxisMask) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT =
						 AdmissionToken) &
						(ActiveRequest.PayloadData[
						 LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT =
						 OwnerGeneration);
				end_if;
			end_if;
			if pendingContextValid then
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_MASK_OFFSET]$UDINT := EffectiveAxisMask;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_TOKEN_OFFSET]$UDINT := AdmissionToken;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_GENERATION_OFFSET]$UDINT := OwnerGeneration;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_SESSION_OFFSET]$UDINT :=
					ActiveRequest.SessionEpoch;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_SEQUENCE_OFFSET]$UDINT :=
					ActiveRequest.Sequence;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_MASK_COPY_OFFSET]$UDINT := EffectiveAxisMask;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_TOKEN_COPY_OFFSET]$UDINT := AdmissionToken;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_GENERATION_COPY_OFFSET]$UDINT :=
					OwnerGeneration;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_SESSION_COPY_OFFSET]$UDINT :=
					ActiveRequest.SessionEpoch;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_SEQUENCE_COPY_OFFSET]$UDINT :=
					ActiveRequest.Sequence;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_CHECK_OFFSET]$UDINT :=
					LMC_OWNER_SAFETY_PENDING_MAGIC xor EffectiveAxisMask xor
					AdmissionToken xor OwnerGeneration xor pendingStart xor
					ActiveRequest.SessionEpoch xor ActiveRequest.Sequence;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_CHECK_COPY_OFFSET]$UDINT :=
					LMC_OWNER_SAFETY_PENDING_MAGIC xor EffectiveAxisMask xor
					AdmissionToken xor OwnerGeneration xor pendingStart xor
					ActiveRequest.SessionEpoch xor ActiveRequest.Sequence;
				ActiveRequest.PayloadData[
				 LMC_OWNER_SAFETY_PENDING_MAGIC_OFFSET]$UDINT :=
					LMC_OWNER_SAFETY_PENDING_MAGIC;
				ActiveRequest.Reserved := 1;
				Result := 1;
			else
				if IsClientConnected(#ControlCommands) then
					pendingRollbackResult :=
					  ControlCommands.RollbackAxisOwnership(
						AdmissionToken:=AdmissionToken,
						OwnerGeneration:=OwnerGeneration,
						CallerSessionEpoch:=ActiveRequest.SessionEpoch,
						RequestSequence:=ActiveRequest.Sequence,
						Reason:=0);
				else
					pendingRollbackResult := -3;
				end_if;
				if pendingRollbackResult <> 0 then
					pendingPublishResult := -3;
					if IsClientConnected(#ControlCommands) then
					  pendingPublishResult := ControlCommands.PublishAxisOwnership(
						AxisMask:=EffectiveAxisMask,
						AdmissionToken:=AdmissionToken,
						OwnerGeneration:=OwnerGeneration,
						ReportKind:=4,
						ReportValue0:=TO_UDINT(pendingRollbackResult),
						ReportValue1:=42,
							ObservationCycle:=ActiveRequest.Sequence);
					end_if;
					if pendingPublishResult <> 0 then
						ActiveRequest.Reserved := 2;
						ActiveRequestValid := TRUE;
						RETURN;
					end_if;
				end_if;
				pendingCloseRequired := TRUE;
				ActiveRequest.Reserved := 0;
				pendingSendResponse := TRUE;
				Result := 0;
			end_if;

		LMC_OWNER_SAFETY_PHASE_TERMINAL:
			pendingResponseSize := ActiveRequest.PayloadData[
				LMC_OWNER_SAFETY_PENDING_RESPONSE_OFFSET]$DINT;
			pendingAccepted :=
				(pendingResponseSize = 16) &
				(Sendbuf[0]$UINT = 0) & (Sendbuf[2]$UINT = 8) &
				(Sendbuf[4]$UDINT = 0) &
				(Sendbuf[8]$UDINT = TO_UDINT(AxisRef)) &
				(Sendbuf[12]$UINT = 0) & (Sendbuf[14]$INT = 0);
			pendingFailure :=
				(pendingResponseSize = 16) &
				(Sendbuf[0]$UINT = 0) & (Sendbuf[2]$UINT = 8) &
				(Sendbuf[4]$UDINT = 0) &
				(Sendbuf[8]$UDINT = TO_UDINT(AxisRef)) &
				(Sendbuf[12]$UINT = 1) & (Sendbuf[14]$INT <> 0);
			if (pendingAccepted = FALSE) & (pendingFailure = FALSE) then
				pendingPublishResult := -3;
				if IsClientConnected(#ControlCommands) then
				  pendingPublishResult := ControlCommands.PublishAxisOwnership(
					AxisMask:=EffectiveAxisMask,
					AdmissionToken:=AdmissionToken,
					OwnerGeneration:=OwnerGeneration,
					ReportKind:=4,
					ReportValue0:=TO_UDINT(pendingResponseSize),
					ReportValue1:=42,
						ObservationCycle:=ActiveRequest.Sequence);
				end_if;
				if pendingPublishResult <> 0 then
					ActiveRequest.Reserved := 2;
					ActiveRequestValid := TRUE;
					RETURN;
				end_if;
				pendingCloseRequired := TRUE;
			end_if;
			ActiveRequest.Reserved := 0;
			pendingSendResponse := TRUE;
			Result := 0;
	else
	end_case;

	if pendingSendResponse then
		if (pendingAccepted = FALSE) & (pendingFailure = FALSE) then
			_memset(dest:=#Sendbuf, usByte:=0, cntr:=16);
			Sendbuf[0]$UINT := 0;
			Sendbuf[2]$UINT := 8;
			Sendbuf[8]$UDINT := TO_UDINT(AxisRef);
			Sendbuf[12]$UINT := 1;
			Sendbuf[14]$INT := -8;
		end_if;
		SendData(pData:=#Sendbuf[0], udSize:=16,
			dSocket:=CurrentSock, bDirect:=TRUE);
		if pendingCloseRequired then
			// Fence this epoch before the asynchronous socket-close callback.
			// SendData already owns the fence if its direct send failed.
			if (ActiveRequest.SessionEpoch <> 0) &
			   (PendingClosedSessionEpoch = 0) then
				PendingClosedSessionEpoch := ActiveRequest.SessionEpoch;
				callbackDisarmResult := DisarmRpcCallbackEndpoint();
				SessionEpoch += 1;
				if SessionEpoch = 0 then
					SessionEpoch := 1;
				end_if;
			end_if;
			IngressBlocked := TRUE;
			IngressFaultCloseRequired := TRUE;
			LastOwnerDisconnectRequestRet :=
				_TCPIPServerInterface::SetSocketParameter(
					dSock:=CurrentSock, Cmd:=100, SubCmd:=0, ParaValue:=0);
		end_if;
	end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::HandleAdminSetPositionPending
	VAR_INPUT
		Phase 	: UINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		pendingTailIndex : DINT;
		pendingTailPresent : BOOL;
		pendingPrimaryValid : BOOL;
		pendingCopyValid : BOOL;
		pendingContextValid : BOOL;
		pendingCloseRequired : BOOL;
		pendingCheck : UDINT;
		pendingCloseSession : UDINT;
		pendingCloseSocket : DINT;
		pendingCallbackDisarmResult : DINT;
	END_VAR

	Result := -1;
	pendingTailPresent := FALSE;
	pendingPrimaryValid := FALSE;
	pendingCopyValid := FALSE;
	pendingContextValid := FALSE;
	pendingCloseRequired := FALSE;
	pendingCheck := 0;
	pendingCloseSession := 0;
	pendingCloseSocket := 0;

	if (ActiveRequest.CommandId = 0x7D12) &
	   (ActiveRequest.PayloadLength = 48) &
	   ((ActiveRequest.PayloadData[
	      LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT =
	     LMC_ADMIN_SET_POSITION_PENDING_MAGIC) |
	    (ActiveRequest.PayloadData[
	      LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT =
	     LMC_ADMIN_SET_POSITION_PENDING_MAGIC)) then
		pendingTailPresent := TRUE;
	elsif (CommandID = 0x7D12) & (Payload = 48) then
		pendingTailIndex := LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET;
		while pendingTailIndex <=
		      LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET do
			if ActiveRequest.PayloadData[pendingTailIndex]$UDINT <> 0 then
				pendingTailPresent := TRUE;
			end_if;
			pendingTailIndex += 4;
		end_while;
	end_if;

	if pendingTailPresent then
		pendingCheck := LMC_ADMIN_SET_POSITION_PENDING_MAGIC xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_OFFSET]$UDINT;
		pendingPrimaryValid :=
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT =
			 LMC_ADMIN_SET_POSITION_PENDING_MAGIC) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_CHECK_OFFSET]$UDINT =
			 pendingCheck);
		pendingCheck := LMC_ADMIN_SET_POSITION_PENDING_MAGIC xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_COPY_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_COPY_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_COPY_OFFSET]$UDINT xor
			ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_COPY_OFFSET]$UDINT;
		pendingCopyValid :=
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT =
			 LMC_ADMIN_SET_POSITION_PENDING_MAGIC) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET]$UDINT =
			 pendingCheck);
		pendingContextValid := pendingPrimaryValid & pendingCopyValid &
			(ActiveRequestValid = TRUE) &
			(ActiveRequest.State = TCPMI_QUEUE_ACTIVE) &
			(ActiveRequest.Reserved = 0) &
			(ActiveRequest.CommandId = 0x7D12) &
			(ActiveRequest.PayloadLength = 48) &
			(ActiveRequest.Reference >= 1) &
			(ActiveRequest.Reference <= 4) &
			(ActiveRequest.SessionEpoch <> 0) &
			(ActiveRequest.Sequence <> 0) &
			(ActiveRequest.Socket <> 0) &
			(ActiveRequest.CommandId = CommandID$UINT) &
			(ActiveRequest.Reference = AxisRef$UINT) &
			(ActiveRequest.PayloadLength = Payload$UINT) &
			(ActiveRequest.Socket = CurrentSock) &
			(ActiveRequest.SessionEpoch = SessionEpoch) &
			(PendingClosedSessionEpoch = 0) &
			(RequestBuf[0]$UINT = ActiveRequest.CommandId) &
			(RequestBuf[4]$UINT = ActiveRequest.PayloadLength) &
			(RequestBuf[6]$UINT = ActiveRequest.Reference) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT =
			 ActiveRequest.SessionEpoch) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_OFFSET]$UDINT =
			 ActiveRequest.Sequence) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_OFFSET]$DINT =
			 ActiveRequest.Socket) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_OFFSET]$UINT =
			 ActiveRequest.CommandId) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_REFERENCE_OFFSET]$UINT =
			 ActiveRequest.Reference) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_OFFSET]$UDINT = 48) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT =
			 ActiveRequest.SessionEpoch) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_COPY_OFFSET]$UDINT =
			 ActiveRequest.Sequence) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_COPY_OFFSET]$DINT =
			 ActiveRequest.Socket) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_COPY_OFFSET]$UINT =
			 ActiveRequest.CommandId) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_REFERENCE_COPY_OFFSET]$UINT =
			 ActiveRequest.Reference) &
			(ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_COPY_OFFSET]$UDINT = 48);
		pendingContextValid := pendingContextValid &
			(RpcInitialized = TRUE) &
			(RpcCallbackRegistered = TRUE) &
			(RpcSocket = CurrentSock) &
			(IsClientConnected(#ControlCommands) = 1);
	end_if;

	case Phase of
		LMC_ADMIN_SET_POSITION_PENDING_PHASE_PREPARE:
			if pendingTailPresent = FALSE then
				Result := 0;
			elsif pendingContextValid then
				Result := 1;
			else
				pendingCloseRequired := TRUE;
			end_if;

		LMC_ADMIN_SET_POSITION_PENDING_PHASE_RETAIN:
			if pendingTailPresent then
				if pendingContextValid &
				   (RpcInitialized = TRUE) &
				   (RpcCallbackRegistered = TRUE) &
				   (RpcSocket = CurrentSock) then
					Result := 1;
				else
					pendingCloseRequired := TRUE;
				end_if;
			else
				pendingContextValid :=
					(ActiveRequestValid = TRUE) &
					(ActiveRequest.State = TCPMI_QUEUE_ACTIVE) &
					(ActiveRequest.Reserved = 0) &
					(ActiveRequest.CommandId = 0x7D12) &
					(ActiveRequest.PayloadLength = 48) &
					(ActiveRequest.Reference >= 1) &
					(ActiveRequest.Reference <= 4) &
					(ActiveRequest.SessionEpoch <> 0) &
					(ActiveRequest.Sequence <> 0) &
					(ActiveRequest.Socket <> 0) &
					(ActiveRequest.SessionEpoch = SessionEpoch) &
					(ActiveRequest.CommandId = CommandID$UINT) &
					(ActiveRequest.Reference = AxisRef$UINT) &
					(ActiveRequest.PayloadLength = Payload$UINT) &
					(ActiveRequest.Socket = CurrentSock) &
					(PendingClosedSessionEpoch = 0) &
					(RpcInitialized = TRUE) &
					(RpcCallbackRegistered = TRUE) &
					(RpcSocket = CurrentSock) &
					(RequestBuf[0]$UINT = ActiveRequest.CommandId) &
					(RequestBuf[4]$UINT = ActiveRequest.PayloadLength) &
					(RequestBuf[6]$UINT = ActiveRequest.Reference);
				if pendingContextValid then
					_memset(dest:=#ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET],
					 usByte:=0, cntr:=56);
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT :=
						ActiveRequest.SessionEpoch;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_OFFSET]$UDINT :=
						ActiveRequest.Sequence;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_OFFSET]$DINT :=
						ActiveRequest.Socket;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_OFFSET]$UINT :=
						ActiveRequest.CommandId;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_REFERENCE_OFFSET]$UINT :=
						ActiveRequest.Reference;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_OFFSET]$UDINT := 48;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT :=
						ActiveRequest.SessionEpoch;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SEQUENCE_COPY_OFFSET]$UDINT :=
						ActiveRequest.Sequence;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_SOCKET_COPY_OFFSET]$DINT :=
						ActiveRequest.Socket;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_COPY_OFFSET]$UINT :=
						ActiveRequest.CommandId;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_REFERENCE_COPY_OFFSET]$UINT :=
						ActiveRequest.Reference;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_LENGTH_COPY_OFFSET]$UDINT := 48;
					pendingCheck := LMC_ADMIN_SET_POSITION_PENDING_MAGIC xor
						ActiveRequest.SessionEpoch xor ActiveRequest.Sequence xor
						TO_UDINT(ActiveRequest.Socket) xor
						ActiveRequest.PayloadData[
						 LMC_ADMIN_SET_POSITION_PENDING_COMMAND_OFFSET]$UDINT xor 48;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_CHECK_OFFSET]$UDINT :=
						pendingCheck;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_CHECK_COPY_OFFSET]$UDINT :=
						pendingCheck;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_COPY_OFFSET]$UDINT :=
						LMC_ADMIN_SET_POSITION_PENDING_MAGIC;
					ActiveRequest.PayloadData[
					 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET]$UDINT :=
						LMC_ADMIN_SET_POSITION_PENDING_MAGIC;
					Result := 1;
				else
					pendingCloseRequired := TRUE;
				end_if;
			end_if;

		LMC_ADMIN_SET_POSITION_PENDING_PHASE_TERMINAL:
			_memset(dest:=#ActiveRequest.PayloadData[
			 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET],
			 usByte:=0, cntr:=56);
			Result := 0;

		LMC_ADMIN_SET_POSITION_PENDING_PHASE_QUARANTINE:
			pendingCloseRequired := TRUE;
	else
		pendingCloseRequired := TRUE;
	end_case;

	if pendingCloseRequired then
		pendingCloseSession := ActiveRequest.SessionEpoch;
		pendingCloseSocket := ActiveRequest.Socket;
		if pendingPrimaryValid & pendingCopyValid &
		   (ActiveRequest.PayloadData[
		    LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT <> 0) &
		   (ActiveRequest.PayloadData[
		    LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT =
		    ActiveRequest.PayloadData[
		    LMC_ADMIN_SET_POSITION_PENDING_SESSION_COPY_OFFSET]$UDINT) then
			pendingCloseSession := ActiveRequest.PayloadData[
				LMC_ADMIN_SET_POSITION_PENDING_SESSION_OFFSET]$UDINT;
		end_if;
		if pendingCloseSession = 0 then
			pendingCloseSession := SessionEpoch;
		end_if;
		_memset(dest:=#ActiveRequest.PayloadData[
		 LMC_ADMIN_SET_POSITION_PENDING_MAGIC_OFFSET],
		 usByte:=0, cntr:=56);
		if (pendingCloseSession <> 0) &
		   (PendingClosedSessionEpoch = 0) then
			PendingClosedSessionEpoch := pendingCloseSession;
			pendingCallbackDisarmResult := DisarmRpcCallbackEndpoint();
			SessionEpoch += 1;
			if SessionEpoch = 0 then
				SessionEpoch := 1;
			end_if;
		end_if;
		IngressBlocked := TRUE;
		IngressFaultPending := FALSE;
		IngressFaultCloseRequired := TRUE;
		RpcSocket := 0;
		RpcInitialized := FALSE;
		if pendingCloseSocket <> 0 then
			LastOwnerDisconnectRequestRet :=
				_TCPIPServerInterface::SetSocketParameter(
				 dSock:=pendingCloseSocket, Cmd:=100,
				 SubCmd:=0, ParaValue:=0);
		end_if;
		Result := LMC_ADMIN_SET_POSITION_QUARANTINE_CLOSE;
	end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::HandleRpcLifecycleCommands
	VAR
		callbackEventMask : UDINT;
		callbackPort : DINT;
		callbackIPv4 : UDINT;
		callbackProtocolVersion : UINT;
		callbackAcceptedMaxDatagram : UINT;
		callbackCookieLo : UDINT;
		callbackCookieHi : UDINT;
		callbackFlags : UDINT;
		callbackReserved : UDINT;
		callbackBootId : UDINT;
		callbackArmResult : DINT;
		callbackDisarmResult : DINT;
	END_VAR

  CASE CommandID OF
  0x8080:
    _memset(dest := #Sendbuf, usByte := 0, cntr := sizeof(Sendbuf));
    IF (Payload = 1) AND (RequestBuf[8] = 0) AND
       ((RpcInitialized = FALSE) OR (RpcSocket = CurrentSock)) THEN
      callbackDisarmResult := DisarmRpcCallbackEndpoint();
      IF callbackDisarmResult < 0 THEN
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
        SendData(pData := #Sendbuf[0], udSize := 12,
          dSocket := CurrentSock, bDirect := TRUE);
      ELSE
        RpcSocket := CurrentSock;
        RpcInitialized := TRUE;
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 24;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 64;
        SendData(pData := #Sendbuf[0], udSize := 32,
          dSocket := CurrentSock, bDirect := TRUE);
      END_IF;
    ELSE
      Sendbuf[0]$UINT := 1;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := -1;
      SendData(pData := #Sendbuf[0], udSize := 12,
        dSocket := CurrentSock, bDirect := TRUE);
    END_IF;

  0x405C:
    IF (Payload = 12) AND (RpcInitialized = TRUE) AND
       (RpcSocket = CurrentSock) THEN
      IF RpcCallbackProtocolVersion = 0 THEN
        RpcCallbackProtocolVersion := 1;
      END_IF;
      _memset(dest := #Sendbuf, usByte := 0, cntr := sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      IF RpcCallbackProtocolVersion = 1 THEN
        callbackEventMask := RequestBuf[8]$UDINT;
        callbackPort := RequestBuf[12]$DINT;
        callbackIPv4 := RequestBuf[16]$UDINT;
        IF (RpcInitialized = TRUE) AND (RpcSocket = CurrentSock) AND
           (CurrentPeerValid = TRUE) AND
           (callbackIPv4 = CurrentPeerIPv4) AND
           (callbackPort > 0) AND (callbackPort <= 65535) THEN
          IF RpcCallbackRegistered = FALSE THEN
            RpcCallbackEventMask := callbackEventMask;
            RpcCallbackPort := callbackPort;
            _StdLib.MemCpy(dest := #RpcCallbackIPv4[0],
              source := #RequestBuf[16], size := 4);
            RpcCallbackRegistered := TRUE;
            Sendbuf[8]$UINT := 0;
            Sendbuf[10]$INT := 0;
          ELSIF (RpcCallbackEventMask = callbackEventMask) AND
                (RpcCallbackPort = callbackPort) AND
                (RpcCallbackIPv4[0] = RequestBuf[16]) AND
                (RpcCallbackIPv4[1] = RequestBuf[17]) AND
                (RpcCallbackIPv4[2] = RequestBuf[18]) AND
                (RpcCallbackIPv4[3] = RequestBuf[19]) THEN
            Sendbuf[8]$UINT := 0;
            Sendbuf[10]$INT := 0;
          ELSE
            Sendbuf[8]$UINT := 1;
            Sendbuf[10]$INT := -1;
          END_IF;
        ELSE
          Sendbuf[8]$UINT := 1;
          Sendbuf[10]$INT := -1;
        END_IF;
      ELSE
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
      END_IF;
      SendData(pData := #Sendbuf[0], udSize := 12,
        dSocket := CurrentSock, bDirect := TRUE);

    ELSIF (Payload = 32) AND (RpcInitialized = TRUE) AND
          (RpcSocket = CurrentSock) THEN
      IF RpcCallbackProtocolVersion = 0 THEN
        RpcCallbackProtocolVersion := 2;
      END_IF;
      _memset(dest := #Sendbuf, usByte := 0, cntr := sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 20;
      Sendbuf[4]$UDINT := 0;
      callbackEventMask := RequestBuf[8]$UDINT;
      callbackPort := RequestBuf[12]$DINT;
      callbackIPv4 := RequestBuf[16]$UDINT;
      callbackProtocolVersion := RequestBuf[20]$UINT;
      callbackAcceptedMaxDatagram := RequestBuf[22]$UINT;
      callbackCookieLo := RequestBuf[24]$UDINT;
      callbackCookieHi := RequestBuf[28]$UDINT;
      callbackFlags := RequestBuf[32]$UDINT;
      callbackReserved := RequestBuf[36]$UDINT;
      callbackBootId := 0;
      callbackArmResult := -9;
      IF IsClientConnected(#Diagnostics) THEN
        callbackBootId := Diagnostics.GetDiagnosticsBootId();
      END_IF;
      IF RpcCallbackProtocolVersion = 2 THEN
        IF (callbackProtocolVersion = 2) AND
           ((callbackEventMask AND 1) = 1) AND
           (callbackPort > 0) AND (callbackPort <= 65535) AND
           (callbackIPv4 = CurrentPeerIPv4) AND (CurrentPeerValid = TRUE) AND
           (callbackAcceptedMaxDatagram >= 52) AND
           (callbackAcceptedMaxDatagram <= 512) AND
           ((callbackCookieLo OR callbackCookieHi) <> 0) AND
           (callbackFlags = 0) AND (callbackReserved = 0) AND
           (SessionEpoch <> 0) AND (callbackBootId <> 0) AND
           (RpcInitialized = TRUE) AND (RpcSocket = CurrentSock) AND
           IsClientConnected(#CallbackSender) THEN
          callbackArmResult := CallbackSender.ArmEndpoint(
            ProtocolVersion := callbackProtocolVersion,
            EventMask := callbackEventMask,
            CallbackIPv4 := callbackIPv4,
            CallbackPort := callbackPort,
            SessionEpoch := SessionEpoch,
            BootId := callbackBootId,
            CookieLo := callbackCookieLo,
            CookieHi := callbackCookieHi,
            MaxDatagramBytes := TO_UDINT(callbackAcceptedMaxDatagram)
          );
        END_IF;
      END_IF;
      IF (callbackArmResult = 0) OR (callbackArmResult = 1) THEN
        RpcCallbackEventMask := callbackEventMask;
        RpcCallbackPort := callbackPort;
        _StdLib.MemCpy(dest := #RpcCallbackIPv4[0],
          source := #RequestBuf[16], size := 4);
        RpcCallbackProtocolVersion := callbackProtocolVersion;
        RpcCallbackAcceptedMaxDatagram := callbackAcceptedMaxDatagram;
        RpcCallbackSessionEpoch := SessionEpoch;
        RpcCallbackBootId := callbackBootId;
        RpcCallbackCookieLo := callbackCookieLo;
        RpcCallbackCookieHi := callbackCookieHi;
        RpcCallbackRegistered := TRUE;
        Sendbuf[8]$UINT := 0;
        Sendbuf[10]$INT := 0;
        Sendbuf[12]$UINT := callbackProtocolVersion;
        Sendbuf[14]$UINT := callbackAcceptedMaxDatagram;
        Sendbuf[16]$UDINT := callbackBootId;
        Sendbuf[20]$UDINT := SessionEpoch;
        Sendbuf[24]$UDINT := 0;
      ELSE
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
      END_IF;
      SendData(pData := #Sendbuf[0], udSize := 28,
        dSocket := CurrentSock, bDirect := TRUE);
    ELSE
      _memset(dest := #Sendbuf, usByte := 0, cntr := sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := -1;
      SendData(pData := #Sendbuf[0], udSize := 12,
        dSocket := CurrentSock, bDirect := TRUE);
    END_IF;

  0x405D:
    _memset(dest := #Sendbuf, usByte := 0, cntr := sizeof(Sendbuf));
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    IF (Payload = 1) AND (RpcInitialized = TRUE) AND
       (RpcSocket = CurrentSock) THEN
      callbackDisarmResult := DisarmRpcCallbackEndpoint();
      IF callbackDisarmResult < 0 THEN
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
        SendData(pData := #Sendbuf[0], udSize := 12,
          dSocket := CurrentSock, bDirect := TRUE);
      ELSE
        Sendbuf[8]$UINT := 0;
        Sendbuf[10]$INT := 0;
        IF (SessionEpoch <> 0) AND (PendingClosedSessionEpoch = 0) THEN
          PendingClosedSessionEpoch := SessionEpoch;
        END_IF;
        SendData(pData := #Sendbuf[0], udSize := 12,
          dSocket := CurrentSock, bDirect := TRUE);
        IF (RpcInitialized = TRUE) AND (RpcSocket = CurrentSock) THEN
          RpcSocket := 0;
          RpcInitialized := FALSE;
          SessionEpoch += 1;
          IF SessionEpoch = 0 THEN
            SessionEpoch := 1;
          END_IF;
        END_IF;
      END_IF;
    ELSE
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := -1;
      SendData(pData := #Sendbuf[0], udSize := 12,
        dSocket := CurrentSock, bDirect := TRUE);
    END_IF;
  END_CASE;

END_FUNCTION


FUNCTION TCPMotionInterface::MsgPaser
	VAR
		controlResponseSize : DINT;
		setPositionCloseSocket : DINT;
		callbackDisarmResult : DINT;
		diagnosticsResponseSize : DINT;
		controlAxisMask : UDINT;
		controlEffectiveAxisMask : UDINT;
		controlAdmissionToken : UDINT;
		controlOwnerGeneration : UDINT;
		controlAdmissionResult : DINT;
		controlOwnerKind : UINT;
		controlResourceKind : UINT;
		controlAdmissionMode : UINT;
		controlIdentityIndex : DINT;
		controlInvokeService : BOOL;
		controlReserved : BOOL;
		controlManagedCommand : BOOL;
		controlClassifierValid : BOOL;
		controlExactAccepted : BOOL;
		controlExactFailure : BOOL;
		controlPendingContinuation : BOOL;
		controlPendingResult : DINT;
		diagnosticsAxisMask : UDINT;
		diagnosticsEffectiveAxisMask : UDINT;
		diagnosticsAdmissionToken : UDINT;
		diagnosticsOwnerGeneration : UDINT;
		diagnosticsAdmissionResult : DINT;
		diagnosticsRollbackResult : DINT;
		diagnosticsPublishResult : DINT;
		diagnosticsOwnerReference : UINT;
		diagnosticsOwnerKind : UINT;
		diagnosticsResourceKind : UINT;
		diagnosticsReserved : BOOL;
		diagnosticsDs402StartValid : BOOL;
		diagnosticsOperationModeStartValid : BOOL;
		diagnosticsDs402PreflightAttempted : BOOL;
		diagnosticsDs402PreflightAccepted : BOOL;
		diagnosticsExactAccepted : BOOL;
		diagnosticsExactFailure : BOOL;
		setPositionPendingResult : DINT;
	END_VAR

// LMC_ADMIN_SET_POSITION_PENDING_GATE_BEGIN
setPositionPendingResult := HandleAdminSetPositionPending(
	Phase:=LMC_ADMIN_SET_POSITION_PENDING_PHASE_PREPARE);
if setPositionPendingResult = LMC_ADMIN_SET_POSITION_QUARANTINE_CLOSE then
	RETURN;
end_if;
// LMC_ADMIN_SET_POSITION_PENDING_GATE_END

if (CommandID <> 0x8080) & (CommandID <> 0x405C) &
   (CommandID <> 0x405D) &
   ((RpcInitialized = FALSE) | (RpcCallbackRegistered = FALSE) |
    (RpcSocket <> CurrentSock)) then
  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  Sendbuf[0]$UINT := 1;
  Sendbuf[2]$UINT := 4;
  Sendbuf[4]$UDINT := 0;
  Sendbuf[8]$UINT := 1;
  Sendbuf[10]$INT := -1;

  SendData(
    pData:=#Sendbuf[0],
    udSize:=12,
    dSocket:=CurrentSock,
    bDirect:=TRUE
  );
  RETURN;
end_if;

case CommandID of

  0x7D15, 0x7D16, 0x7D17,
  0x7D23, 0x7D24, 0x7D25,
  0x7E00, 0x7E01, 0x7E02, 0x7E03, 0x7E04,
  0x7E10, 0x7E11, 0x7E12, 0x7E13, 0x7E20, 0x7E21, 0x7E22,
  0x7E30, 0x7E31, 0x7E32, 0x7E33,
  0x7E40, 0x7E41, 0x7E42, 0x7E43, 0x7E44,
  0x7E45, 0x7E46, 0x7E47, 0x7E48, 0x7E49, 0x7E4A, 0x7E4B,
  0x7E4C, 0x7E4D,
  0x7E50, 0x7E51,
  0x7E53, 0x7E54, 0x7E55:
    _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
    diagnosticsResponseSize := -1;
	  diagnosticsAxisMask := 0;
