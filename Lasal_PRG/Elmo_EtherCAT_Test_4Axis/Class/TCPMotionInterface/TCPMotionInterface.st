	udRemainingSize : UDINT;
	END_VAR

  if udSize = 0 then
    RETURN;
  end_if;

  // Once RPC is initialized, only the owner socket may enter the accumulator.
  if (RpcInitialized = TRUE) & (RpcSocket <> dSock) then
    _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -1;

    SendData(
      pData:=#Sendbuf[0],
      udSize:=12,
      dSocket:=dSock,
      bDirect:=TRUE
    );
    RETURN;
  end_if;

  if ReceiveFill = 0 then
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  elsif ReceiveSocket <> dSock then
    // Before a session exists, let the latest socket restart the phase-1
    // accumulator so an abandoned partial frame cannot block initialization.
    ReceiveFill := 0;
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  end_if;

  if udSize > sizeof(ReceiveBuf) - ReceiveFill then
    ReceiveFill := 0;
    ReceiveSocket := 0;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    RETURN;
  end_if;

  _StdLib.MemCpy(
    dest:=#ReceiveBuf[ReceiveFill$DINT],
    source:=pData,
    size:=udSize
  );
  ReceiveFill += udSize;

  while ReceiveFill >= 8 do
    usPayloadLength := 0;
    _StdLib.MemCpy(dest:=#usPayloadLength, source:=#ReceiveBuf[4], size:=2);
    udFrameSize := TO_UDINT(usPayloadLength) + 8;

    if udFrameSize > sizeof(ReceiveBuf) then
      ReceiveFill := 0;
      ReceiveSocket := 0;
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      RETURN;
    end_if;

    if ReceiveFill < udFrameSize then
      RETURN;
    end_if;

    CommandID := 0;
    AxisRef := 0;
    Payload := 0;
    usReference := 0;

    _StdLib.MemCpy(dest:=#CommandID, source:=#ReceiveBuf[0], size:=2);
    _StdLib.MemCpy(dest:=#usReference, source:=#ReceiveBuf[6], size:=2);

    Payload := usPayloadLength$DINT;
    AxisRef := usReference$DINT;
    CurrentSock := ReceiveSocket;

    MsgPaser();

    udRemainingSize := ReceiveFill - udFrameSize;
    if udRemainingSize > 0 then
      _StdLib.MemMove(
        dest:=#ReceiveBuf[0],
        source:=#ReceiveBuf[udFrameSize$DINT],
        size:=udRemainingSize
      );
      _memset(
        dest:=#ReceiveBuf[udRemainingSize$DINT],
        usByte:=0,
        cntr:=sizeof(ReceiveBuf) - udRemainingSize
      );
    else
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    end_if;

    ReceiveFill := udRemainingSize;
    if ReceiveFill = 0 then
      ReceiveSocket := 0;
    end_if;
  end_while;


END_FUNCTION


FUNCTION TCPMotionInterface::MsgPaser

  // Motion/read/lookup commands are accepted only after this socket completed
  // session init and UDP callback registration.
  if (CommandID <> 0x8080) & (CommandID <> 0x405C) &
     (CommandID <> 0x405D) &
     ((RpcInitialized = FALSE) | (RpcCallbackRegistered = FALSE) |
      (RpcSocket <> CurrentSock)) then
    _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -1;

    SendData(
      pData:=#Sendbuf[0],
      udSize:=12,
      dSocket:=CurrentSock,
      bDirect:=TRUE
    );
    RETURN;
  end_if;

  case CommandID of

    // RPC session init. Response payload follows the captured 24-byte shape.
    0x8080:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

      if (Payload = 1) & (ReceiveBuf[8] = 0) &
         ((RpcInitialized = FALSE) | (RpcSocket = CurrentSock)) then
        RpcSocket := CurrentSock;
        RpcInitialized := TRUE;
        RpcCallbackRegistered := FALSE;
        RpcCallbackEventMask := 0;
        RpcCallbackPort := 0;
        RpcCallbackIPv4[0] := 0;
        RpcCallbackIPv4[1] := 0;
        RpcCallbackIPv4[2] := 0;
        RpcCallbackIPv4[3] := 0;

        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 24;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 64;  // Captured opaque value; meaning not confirmed.

        SendData(
          pData:=#Sendbuf[0],
          udSize:=32,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      end_if;

    // Register the PC UDP callback endpoint. Event payload sending is pending
    // a real callback capture/specification.
    0x405C:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;

      if (Payload = 12) & (RpcInitialized = TRUE) &
         (RpcSocket = CurrentSock) then
        _StdLib.MemCpy(dest:=#RpcCallbackEventMask, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#RpcCallbackPort, source:=#ReceiveBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#RpcCallbackIPv4[0], source:=#ReceiveBuf[16], size:=4);

        if (RpcCallbackPort > 0) & (RpcCallbackPort <= 65535) then
          RpcCallbackRegistered := TRUE;
          Sendbuf[8]$UINT := 0;
          Sendbuf[10]$INT := 0;
        else
          RpcCallbackRegistered := FALSE;
          Sendbuf[8]$UINT := 1;
          Sendbuf[10]$INT := -1;
        end_if;
      else
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
      end_if;

      SendData(
        pData:=#Sendbuf[0],
        udSize:=12,
        dSocket:=CurrentSock,
        bDirect:=TRUE
      );

    // Acknowledge before the PC closes the TCP socket, then clear this session.
    0x405D:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;

      if (Payload = 1) & (RpcInitialized = TRUE) &
         (RpcSocket = CurrentSock) then
        Sendbuf[8]$UINT := 0;
        Sendbuf[10]$INT := 0;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );

        RpcSocket := 0;
        RpcInitialized := FALSE;
        RpcCallbackRegistered := FALSE;
        RpcCallbackEventMask := 0;
        RpcCallbackPort := 0;
        RpcCallbackIPv4[0] := 0;
        RpcCallbackIPv4[1] := 0;
        RpcCallbackIPv4[2] := 0;
        RpcCallbackIPv4[3] := 0;
      else
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      end_if;

    // Resolve the public name against names read from the connected LASAL
    // objects.  Returned values are opaque descriptors, never PLC pointers.
    0x103C:

      AxisRef := 0;
      if (Payload = 80) & (ObjectRegistryReady = TRUE) then
        ReceiveBuf[87] := 0;

        if _strcmp(str1:=#ReceiveBuf[8]$CHAR, str2:=#AxisObjectName1[0]) = 0 then
          AxisRef := 1;
        elsif _strcmp(str1:=#ReceiveBuf[8]$CHAR, str2:=#AxisObjectName2[0]) = 0 then
          AxisRef := 2;
        elsif _strcmp(str1:=#ReceiveBuf[8]$CHAR, str2:=#AxisObjectName3[0]) = 0 then
          AxisRef := 3;
        elsif _strcmp(str1:=#ReceiveBuf[8]$CHAR, str2:=#AxisObjectName4[0]) = 0 then
          AxisRef := 4;
        end_if;
      end_if;

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if AxisRef > 0 then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 6;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 0;
        Sendbuf[12]$UINT := AxisRef$UINT;
        SendData(pData:=#Sendbuf[0], udSize:=14,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -2;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x1042:

      AxisRef := 0;
      if (Payload = 80) & (ObjectRegistryReady = TRUE) then
        ReceiveBuf[87] := 0;
        if _strcmp(str1:=#ReceiveBuf[8]$CHAR, str2:=#GroupObjectName[0]) = 0 then
          AxisRef := 0x0100;
        end_if;
      end_if;

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if AxisRef = 0x0100 then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 6;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 0;
        Sendbuf[12]$UINT := AxisRef$UINT;
        SendData(pData:=#Sendbuf[0], udSize:=14,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -2;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x202B:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if (Payload = 12) & (AxisRef >= 1) & (AxisRef <= 4) then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 8;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := AxisRef$UDINT;
        Sendbuf[12]$UINT := 0;
        Sendbuf[14]$INT := 0;
        SendData(pData:=#Sendbuf[0], udSize:=16,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -3;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    // DINT protocol v1 Power. The enable flag is payload byte 4.
    0x2023:

      if (Payload = 8) & (ReceiveBuf[12] <> 0) then
        PowerOn();
      elsif Payload = 8 then
        PowerOff();
      else
        AxisRef := 0;
        PowerOff();
      end_if;

    0x2024:

      if (Payload = 1) & (ReceiveBuf[8] = 1) then
        AxisReset();
      else
        AxisRef := 0;
        AxisReset();
      end_if;

    0x2022:

      if Payload = 16 then
        _StdLib.MemCpy(dest:=#dec, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#jer, source:=#ReceiveBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#bufMode, source:=#ReceiveBuf[16], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[20], size:=4);
        MoveStop();
      else
        AxisRef := 0;
        MoveStop();
      end_if;

    0x2028:

      AxisStatusValue := 0;
      AxisErrorValue := 0;
      PayloadReference := 0;

      if Payload = 8 then
        _StdLib.MemCpy(dest:=#PayloadReference, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[12], size:=4);
      end_if;

      if (PayloadReference = AxisRef) & (Exec <> 0) then
        case AxisRef of
          1:
            AxisStatusValue := LMCAxis.ReadAxisStatus();
            AxisErrorValue := LMCAxis.ReadAxisError();
          2:
            AxisStatusValue := LMCAxis2.ReadAxisStatus();
            AxisErrorValue := LMCAxis2.ReadAxisError();
          3:
            AxisStatusValue := LMCAxis3.ReadAxisStatus();
            AxisErrorValue := LMCAxis3.ReadAxisError();
          4:
            AxisStatusValue := LMCAxis4.ReadAxisStatus();
            AxisErrorValue := LMCAxis4.ReadAxisError();
        else
        end_case;
      end_if;

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if (Payload = 8) & (AxisRef >= 1) & (AxisRef <= 4) &
         (PayloadReference = AxisRef) & (Exec <> 0) then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 12;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := AxisStatusValue$UDINT;
        Sendbuf[12]$UINT := 0;
        Sendbuf[14]$INT := 0;
        Sendbuf[16]$UINT := AxisErrorValue$UINT;
        Sendbuf[18]$UINT := 0;
        SendData(pData:=#Sendbuf[0], udSize:=20,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -3;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x202E:

      ReadActPos();

    0x209F:

      AxisCommandInputValid := FALSE;
      if Payload = 32 then
        _StdLib.MemCpy(dest:=#pos, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#velo, source:=#ReceiveBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#acc, source:=#ReceiveBuf[16], size:=4);
        _StdLib.MemCpy(dest:=#dec, source:=#ReceiveBuf[20], size:=4);
        _StdLib.MemCpy(dest:=#jer, source:=#ReceiveBuf[24], size:=4);
        _StdLib.MemCpy(dest:=#dir, source:=#ReceiveBuf[28], size:=4);
        _StdLib.MemCpy(dest:=#bufMode, source:=#ReceiveBuf[32], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[36], size:=4);
        AxisCommandInputValid := (dir = 2) & (Exec <> 0);
      end_if;
      MoveAbs();

    0x20A0:

      AxisCommandInputValid := FALSE;
      if Payload = 32 then
        _StdLib.MemCpy(dest:=#pos, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#velo, source:=#ReceiveBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#acc, source:=#ReceiveBuf[16], size:=4);
        _StdLib.MemCpy(dest:=#dec, source:=#ReceiveBuf[20], size:=4);
        _StdLib.MemCpy(dest:=#jer, source:=#ReceiveBuf[24], size:=4);
        _StdLib.MemCpy(dest:=#dir, source:=#ReceiveBuf[28], size:=4);
        _StdLib.MemCpy(dest:=#bufMode, source:=#ReceiveBuf[32], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[36], size:=4);
        AxisCommandInputValid := (dir = 2) & (Exec <> 0);
      end_if;
      MoveAbs();

    0x20A2:

      AxisCommandInputValid := FALSE;
      if Payload = 24 then
        pos := 0;
        _StdLib.MemCpy(dest:=#velo, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#acc, source:=#ReceiveBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#dec, source:=#ReceiveBuf[16], size:=4);
        _StdLib.MemCpy(dest:=#jer, source:=#ReceiveBuf[20], size:=4);
        _StdLib.MemCpy(dest:=#dir, source:=#ReceiveBuf[24], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[28], size:=4);
        AxisCommandInputValid :=
          (dec = 0) & (Exec <> 0) &
          (((dir = 1) & (velo >= 0)) | ((dir = 3) & (velo <= 0)));
      end_if;
      MoveAbs();

    0x20D2:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if (Payload = 1) & (ReceiveBuf[8] = 1) & (AxisRef = 0x0100) &
         (ObjectRegistryReady = TRUE) then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 1350;
        Sendbuf[4]$UDINT := 0;

        // Payload +0: opaque references, +32: deployment-local device IDs.
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$UINT := 2;
        Sendbuf[12]$UINT := 3;
        Sendbuf[14]$UINT := 4;
        Sendbuf[40]$UINT := 0;
        Sendbuf[42]$UINT := 1;
        Sendbuf[44]$UINT := 2;
        Sendbuf[46]$UINT := 3;

        Sendbuf[72]$UINT := 0;
        Sendbuf[74]$INT := 0;
        _StdLib.MemCpy(dest:=#Sendbuf[76], source:=#AxisObjectName1[0], size:=80);
        _StdLib.MemCpy(dest:=#Sendbuf[156], source:=#AxisObjectName2[0], size:=80);
        _StdLib.MemCpy(dest:=#Sendbuf[236], source:=#AxisObjectName3[0], size:=80);
        _StdLib.MemCpy(dest:=#Sendbuf[316], source:=#AxisObjectName4[0], size:=80);
        Sendbuf[1356] := 4;
        Sendbuf[1357] := 0;

        SendData(pData:=#Sendbuf[0], udSize:=1358,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -3;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x2047:

      GroupReadErrorId := 1;
      if (Payload = 1) & (ReceiveBuf[8] = 1) & (AxisRef = 0x0100) then
        GroupReadErrorId := LMCRobot.RobotOn(Mode:=_ACTIVE);
      end_if;
      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 8;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UDINT := AxisRef$UDINT;
      Sendbuf[12]$UINT := GroupReadErrorId$UINT;
      Sendbuf[14]$INT := GroupReadErrorId$INT;
      SendData(pData:=#Sendbuf[0], udSize:=16,
               dSocket:=CurrentSock, bDirect:=TRUE);

    0x2048:

      GroupReadErrorId := 1;
      if (Payload = 1) & (ReceiveBuf[8] = 1) & (AxisRef = 0x0100) then
        GroupReadErrorId := LMCRobot.RobotOff();
      end_if;
      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 8;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UDINT := AxisRef$UDINT;
      Sendbuf[12]$UINT := GroupReadErrorId$UINT;
      Sendbuf[14]$INT := GroupReadErrorId$INT;
      SendData(pData:=#Sendbuf[0], udSize:=16,
               dSocket:=CurrentSock, bDirect:=TRUE);

    // No safe LASAL equivalent has been approved for these PMAS operations.
    // Return a deterministic error instead of a false-success/no response.
    0x2049, 0x2085:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 8;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UDINT := AxisRef$UDINT;
      Sendbuf[12]$UINT := 1;
      Sendbuf[14]$INT := -5;
      SendData(pData:=#Sendbuf[0], udSize:=16,
               dSocket:=CurrentSock, bDirect:=TRUE);

    0x20A4:

      GroupExecute := 0;
      if (Payload = 96) & (AxisRef = 0x0100) then
        // _LMCPROF_POS has 9 DINT positions. The remaining protocol slots are
        // preserved for future robots but are not copied into this object.
        _StdLib.MemCpy(dest:=#GroupMovePos, source:=#ReceiveBuf[8], size:=36);
        _StdLib.MemCpy(dest:=#GroupVelocity, source:=#ReceiveBuf[72], size:=4);
        _StdLib.MemCpy(dest:=#GroupAccel, source:=#ReceiveBuf[76], size:=4);
        _StdLib.MemCpy(dest:=#GroupDecel, source:=#ReceiveBuf[80], size:=4);
        _StdLib.MemCpy(dest:=#GroupJerk, source:=#ReceiveBuf[84], size:=4);
        _StdLib.MemCpy(dest:=#GroupCoordSystem, source:=#ReceiveBuf[88], size:=4);
        _StdLib.MemCpy(dest:=#GroupTransitionModeInput, source:=#ReceiveBuf[92], size:=4);
        _StdLib.MemCpy(dest:=#bufMode, source:=#ReceiveBuf[96], size:=4);
        _StdLib.MemCpy(dest:=#GroupExecute, source:=#ReceiveBuf[100], size:=4);
        GroupTransitionRadius := 0;
      end_if;

      case GroupTransitionModeInput of
        0:
          GroupTransitionMode := _LMCPROF_EXACT_STOP;
        1:
          GroupTransitionMode := _LMCPROF_CONT_DIRECT;
        2:
          GroupTransitionMode := _LMCPROF_CONT_DIRECT;
        3:
          GroupTransitionMode := _LMCPROF_SMOOTH_PARAB;
        4:
          GroupTransitionMode := _LMCPROF_SMOOTH_CUBIC;
        5:
          GroupTransitionMode := _LMCPROF_SMOOTH_QUINT;
      else
          GroupTransitionMode := _LMCPROF_EXACT_STOP;
      end_case;

      MoveLinearAbsEx();

    0x2045:

      PayloadReference := 0;
      Exec := 0;
      if Payload = 8 then
        _StdLib.MemCpy(dest:=#PayloadReference, source:=#ReceiveBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#ReceiveBuf[12], size:=4);
      end_if;

      if (Payload = 8) & (AxisRef = 0x0100) &
         (PayloadReference = AxisRef) & (Exec <> 0) then
        GroupReadStatus();
      else
        _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -3;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    else
      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 1;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := -4;
      SendData(pData:=#Sendbuf[0], udSize:=12,
               dSocket:=CurrentSock, bDirect:=TRUE);
  end_case;



END_FUNCTION


FUNCTION TCPMotionInterface::PowerOn

  AxisCommandState := 1;
  case AxisRef of
    1: AxisCommandState := LMCAxis.PowerOn(Mode:=LMCAXIS_MOVE_SHORTEST_WAY);
    2: AxisCommandState := LMCAxis2.PowerOn(Mode:=LMCAXIS_MOVE_SHORTEST_WAY);
    3: AxisCommandState := LMCAxis3.PowerOn(Mode:=LMCAXIS_MOVE_SHORTEST_WAY);
    4: AxisCommandState := LMCAxis4.PowerOn(Mode:=LMCAXIS_MOVE_SHORTEST_WAY);
  else
  end_case;

  AxisCommandStatus := AxisCommandState$UINT;
  AxisCommandErrorId := AxisCommandState$INT;
  if (AxisCommandState$UDINT and 0xFFFF0000) <> 0 then
    // The wire ACK has only 16-bit status/error fields. Never truncate the
    // 32-bit JError/SafeError flags to a false success.
    AxisCommandStatus := 1;
    AxisCommandErrorId := -6;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := AxisCommandStatus;
    Sendbuf[14]$INT := AxisCommandErrorId;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::PowerOff

  AxisCommandState := 1;
  case AxisRef of
    1: AxisCommandState := LMCAxis.PowerOff(Mode:=LMCAXIS_SMOOTH_STOPP);
    2: AxisCommandState := LMCAxis2.PowerOff(Mode:=LMCAXIS_SMOOTH_STOPP);
    3: AxisCommandState := LMCAxis3.PowerOff(Mode:=LMCAXIS_SMOOTH_STOPP);
    4: AxisCommandState := LMCAxis4.PowerOff(Mode:=LMCAXIS_SMOOTH_STOPP);
  else
  end_case;

  AxisCommandStatus := AxisCommandState$UINT;
  AxisCommandErrorId := AxisCommandState$INT;
  if (AxisCommandState$UDINT and 0xFFFF0000) <> 0 then
    AxisCommandStatus := 1;
    AxisCommandErrorId := -6;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := AxisCommandStatus;
    Sendbuf[14]$INT := AxisCommandErrorId;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::MoveAbs

  AxisCommandState := 1;

  if AxisCommandInputValid = TRUE then
    case AxisRef of
      1:
        case CommandID of
          0x209F:
            AxisCommandState := LMCAxis.MoveShortestWay(
              Position:=pos, Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A0:
            AxisCommandState := LMCAxis.MoveRelative(
              Position:=pos, Mode:=LMCAXIS_MOVE_RELATIVE_TO_POSITION,
              Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A2:
            AxisCommandState := LMCAxis.MoveEndless(
              Speed:=velo, Accel:=acc, Jerk:=jer);
        end_case;
      2:
        case CommandID of
          0x209F:
            AxisCommandState := LMCAxis2.MoveShortestWay(
              Position:=pos, Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A0:
            AxisCommandState := LMCAxis2.MoveRelative(
              Position:=pos, Mode:=LMCAXIS_MOVE_RELATIVE_TO_POSITION,
              Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A2:
            AxisCommandState := LMCAxis2.MoveEndless(
              Speed:=velo, Accel:=acc, Jerk:=jer);
        end_case;
      3:
        case CommandID of
          0x209F:
            AxisCommandState := LMCAxis3.MoveShortestWay(
              Position:=pos, Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A0:
            AxisCommandState := LMCAxis3.MoveRelative(
              Position:=pos, Mode:=LMCAXIS_MOVE_RELATIVE_TO_POSITION,
              Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A2:
            AxisCommandState := LMCAxis3.MoveEndless(
              Speed:=velo, Accel:=acc, Jerk:=jer);
        end_case;
      4:
        case CommandID of
          0x209F:
            AxisCommandState := LMCAxis4.MoveShortestWay(
              Position:=pos, Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A0:
            AxisCommandState := LMCAxis4.MoveRelative(
              Position:=pos, Mode:=LMCAXIS_MOVE_RELATIVE_TO_POSITION,
              Speed:=velo, Accel:=acc, Decel:=dec, Jerk:=jer);
          0x20A2:
            AxisCommandState := LMCAxis4.MoveEndless(
              Speed:=velo, Accel:=acc, Jerk:=jer);
        end_case;
  else
  end_case;
  end_if;

  AxisCommandStatus := AxisCommandState$UINT;
  AxisCommandErrorId := AxisCommandState$INT;
  if (AxisCommandState$UDINT and 0xFFFF0000) <> 0 then
    AxisCommandStatus := 1;
    AxisCommandErrorId := -6;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    if AxisCommandInputValid = TRUE then
      Sendbuf[12]$UINT := AxisCommandStatus;
      Sendbuf[14]$INT := AxisCommandErrorId;
    else
      Sendbuf[12]$UINT := 1;
      Sendbuf[14]$INT := -7;
    end_if;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


