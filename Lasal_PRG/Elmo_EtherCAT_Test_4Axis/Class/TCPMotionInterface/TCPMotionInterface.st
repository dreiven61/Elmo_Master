FUNCTION TCPMotionInterface::MoveStop

  AxisCommandState := 1;
  AxisClientConnected := FALSE;
  if AxisCommandInputValid = TRUE then
    case AxisRef of
      1:
        if IsClientConnected(#LMCAxis1) = 1 then
          AxisClientConnected := TRUE;
          AxisCommandState := LMCAxis1.StopMove(Decel:=dec, Jerk:=jer);
        end_if;
      2:
        if IsClientConnected(#LMCAxis2) = 1 then
          AxisClientConnected := TRUE;
          AxisCommandState := LMCAxis2.StopMove(Decel:=dec, Jerk:=jer);
        end_if;
      3:
        if IsClientConnected(#LMCAxis3) = 1 then
          AxisClientConnected := TRUE;
          AxisCommandState := LMCAxis3.StopMove(Decel:=dec, Jerk:=jer);
        end_if;
      4:
        if IsClientConnected(#LMCAxis4) = 1 then
          AxisClientConnected := TRUE;
          AxisCommandState := LMCAxis4.StopMove(Decel:=dec, Jerk:=jer);
        end_if;
    else
    end_case;
  end_if;

  if AxisClientConnected = TRUE then
    AxisCommandStatus := AxisCommandState$UINT;
    AxisCommandErrorId := AxisCommandState$INT;
    if (AxisCommandState$UDINT and 0xFFFF0000) <> 0 then
      AxisCommandStatus := 1;
      AxisCommandErrorId := -6;
    end_if;
  elsif AxisCommandInputValid = TRUE then
    AxisCommandStatus := 1;
    AxisCommandErrorId := -2;
  else
    AxisCommandStatus := 1;
    AxisCommandErrorId := -7;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := AxisCommandStatus;
    Sendbuf[14]$INT := AxisCommandErrorId;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::AxisReset

  AxisCommandStatus := 1;
  AxisCommandErrorId := -2;
  AxisClientConnected := FALSE;
  case AxisRef of
    1:
      if IsClientConnected(#LMCAxis1) = 1 then
        AxisClientConnected := TRUE;
        LMCAxis1.QuitError();
      end_if;
    2:
      if IsClientConnected(#LMCAxis2) = 1 then
        AxisClientConnected := TRUE;
        LMCAxis2.QuitError();
      end_if;
    3:
      if IsClientConnected(#LMCAxis3) = 1 then
        AxisClientConnected := TRUE;
        LMCAxis3.QuitError();
      end_if;
    4:
      if IsClientConnected(#LMCAxis4) = 1 then
        AxisClientConnected := TRUE;
        LMCAxis4.QuitError();
      end_if;
  else
  end_case;

  if AxisClientConnected = TRUE then
    AxisCommandStatus := 0;
    AxisCommandErrorId := 0;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := AxisCommandStatus;
    Sendbuf[14]$INT := AxisCommandErrorId;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::MoveLinearAbsEx

  GroupMoveRetCode := _LMCPROF_MOVECMD_ERROR;

  if (GroupExecute <> 0) & (AxisRef = 0x0100) & (Payload = 96) then
    GroupMoveRetCode := LMCRobot.MoveLinearCoord(pPositions:=#GroupMovePos,
                               CmdConfig:=0,
                               Velocity:=GroupVelocity,
                               Accel:=GroupAccel,
                               Decel:=GroupDecel,
                               TransMode:=GroupTransitionMode,
                               TransRadius:=GroupTransitionRadius,
                               CoordSystem:=GroupCoordSystem,
                               Jerk:=GroupJerk);
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  Sendbuf[0]$UINT := 0;
  Sendbuf[2]$UINT := 8;
  Sendbuf[4]$UDINT := 0;
  Sendbuf[8]$UDINT := AxisRef$UDINT;

  if GroupMoveRetCode = _LMCPROF_NoError then
    Sendbuf[12]$UINT := 0;
    Sendbuf[14]$INT := 0;
  else
    Sendbuf[12]$UINT := 1;
    Sendbuf[14]$INT := GroupMoveRetCode$INT;
  end_if;

  SendData(pData:=#Sendbuf[0], udSize:=16,
           dSocket:=CurrentSock, bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::GroupReadStatus

  VAR
    msgLen           : UDINT;
    robotState       : DINT;
    profileErrorInfo : _LMCPROFERRORDEF;
  END_VAR

  GroupReadErrorId := 0;
  GroupReadState := 0x40000000;
  GroupReadInPosition := 0;

  GroupReadInPosition := LMCRobot.ProfileInPosition(Mode:=_LMCPROF_ProfileFinished);
  robotState := LMCRobot.ReadRobotParameter(ParNo:=_ROBOT_STATE, Mode:=0);

  if GroupReadInPosition <> 0 then
    GroupReadState := GroupReadState or 0x00020000;
  end_if;

  if robotState = _ROBOT_ERROR$DINT then
    profileErrorInfo := LMCRobot.ReadProfileError();
    GroupReadErrorId := profileErrorInfo.ErrorNo$DINT;
    if GroupReadErrorId = 0 then
      // Never report success while the robot says it is in an error state.
      GroupReadErrorId := -6;
    end_if;
  elsif (robotState < _ROBOT_PASSIVE$DINT) |
        (robotState > _ROBOT_MODE_CHANGE$DINT) then
    GroupReadErrorId := -6;
  end_if;

  msgLen := 0;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

  Sendbuf[0]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[2]$UINT := 0x000C;
  msgLen := msgLen + 2;

  Sendbuf[4]$UDINT := 0x00000000;
  msgLen := msgLen + 4;

  Sendbuf[8]$UDINT := GroupReadState;
  msgLen := msgLen + 4;

  Sendbuf[12]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[14]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[16]$UINT := GroupReadErrorId$UINT;
  msgLen := msgLen + 2;

  Sendbuf[18]$UINT := 0x0000;
  msgLen := msgLen + 2;

  SendData(pData:=#Sendbuf[0],
           udSize:=msgLen,
           dSocket:=CurrentSock,
           bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::ClampLRealToDint
	VAR_INPUT
		Value 	: LREAL;
	END_VAR
	VAR_OUTPUT
		ValueOut 	: DINT;
	END_VAR

  if Value > 2147483647.0 then
    ValueOut := 2147483647;
  elsif Value < -2147483647.0 then
    ValueOut := -2147483647;
  else
    ValueOut := TO_DINT(Value);
  end_if;

END_FUNCTION


