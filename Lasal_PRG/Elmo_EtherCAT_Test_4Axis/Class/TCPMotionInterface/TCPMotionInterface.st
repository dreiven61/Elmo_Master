FUNCTION TCPMotionInterface::AxisReset

  AxisCommandState := 1;
  case AxisRef of
    1:
      LMCAxis.QuitError();
      AxisCommandState := 0;
    2:
      LMCAxis2.QuitError();
      AxisCommandState := 0;
    3:
      LMCAxis3.QuitError();
      AxisCommandState := 0;
    4:
      LMCAxis4.QuitError();
      AxisCommandState := 0;
  else
  end_case;

  AxisCommandStatus := AxisCommandState$UINT;
  AxisCommandErrorId := AxisCommandState$INT;
  if (AxisCommandState$UDINT and 0xFFFF0000) <> 0 then
    AxisCommandStatus := 1;
    AxisCommandErrorId := -6;
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  if (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := AxisCommandStatus;
    Sendbuf[14]$INT := AxisCommandErrorId;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::ReadActPos

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

  case AxisRef of
    1: ReadPos := LMCAxis.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
    2: ReadPos := LMCAxis2.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
    3: ReadPos := LMCAxis3.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
    4: ReadPos := LMCAxis4.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
  else
    ReadPos := 0;
  end_case;

  if (Payload = 1) & (AxisRef >= 1) & (AxisRef <= 4) then
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$DINT := ReadPos;
    Sendbuf[12]$UINT := 0;
    Sendbuf[14]$INT := 0;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
  else
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -3;
    SendData(pData:=#Sendbuf[0], udSize:=12,
             dSocket:=CurrentSock, bDirect:=TRUE);
  end_if;

END_FUNCTION


FUNCTION TCPMotionInterface::MoveLinearAbsEx

  GroupMoveRetCode := 1;

  if (GroupExecute <> 0) & (AxisRef = 0x0100) & (Payload = 96) then
    GroupMoveRetCode := LMCRobot.MoveLinearCoord(pPositions:=#GroupMovePos,
                               CmdConfig:=0,
                               Velocity:=GroupVelocity,
                               Accel:=GroupAccel,
                               Decel:=GroupDecel,
                               TransMode:=GroupTransitionMode,
                               TransRadius:=GroupTransitionRadius,
                               CoordSystem:=GroupCoordSystem,
                               Jerk:=GroupJerk);
  end_if;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
  Sendbuf[0]$UINT := 0;
  Sendbuf[2]$UINT := 8;
  Sendbuf[4]$UDINT := 0;
  Sendbuf[8]$UDINT := AxisRef$UDINT;

  if GroupMoveRetCode = _LMCPROF_NoError then
    Sendbuf[12]$UINT := 0;
    Sendbuf[14]$INT := 0;
  else
    Sendbuf[12]$UINT := 1;
    Sendbuf[14]$INT := GroupMoveRetCode$INT;
  end_if;

  SendData(pData:=#Sendbuf[0], udSize:=16,
           dSocket:=CurrentSock, bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::GroupReadStatus

  VAR
    msgLen : UDINT;
  END_VAR

  GroupReadErrorId := 0;
  GroupReadState := 0x40000000;
  GroupReadInPosition := 0;

  GroupReadInPosition := LMCRobot.ProfileInPosition(Mode:=_LMCPROF_ProfileFinished);

  if GroupReadInPosition <> 0 then
    GroupReadState := GroupReadState or 0x00020000;
  end_if;

  if GroupMoveRetCode <> _LMCPROF_NoError then
    GroupReadErrorId := GroupMoveRetCode$DINT;
  end_if;

  msgLen := 0;

  _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

  Sendbuf[0]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[2]$UINT := 0x000C;
  msgLen := msgLen + 2;

  Sendbuf[4]$UDINT := 0x00000000;
  msgLen := msgLen + 4;

  Sendbuf[8]$UDINT := GroupReadState;
  msgLen := msgLen + 4;

  Sendbuf[12]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[14]$UINT := 0x0000;
  msgLen := msgLen + 2;

  Sendbuf[16]$UINT := GroupReadErrorId$UINT;
  msgLen := msgLen + 2;

  Sendbuf[18]$UINT := 0x0000;
  msgLen := msgLen + 2;

  SendData(pData:=#Sendbuf[0],
           udSize:=msgLen,
           dSocket:=CurrentSock,
           bDirect:=TRUE);

END_FUNCTION


FUNCTION TCPMotionInterface::ClampLRealToDint
	VAR_INPUT
		Value 	: LREAL;
	END_VAR
	VAR_OUTPUT
		ValueOut 	: DINT;
	END_VAR

  if Value > 2147483647.0 then
    ValueOut := 2147483647;
  elsif Value < -2147483647.0 then
    ValueOut := -2147483647;
  else
    ValueOut := TO_DINT(Value);
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::RobotPowerOn::Write
	VAR_INPUT
