        (_strlen(#AxisObjectName3[0]) > 0) &
        (_strlen(#AxisObjectName3[0]) <= 79) &
        (_strlen(#AxisObjectName4[0]) > 0) &
        (_strlen(#AxisObjectName4[0]) <= 79) &
        (_strlen(#GroupObjectName[0]) > 0) &
        (_strlen(#GroupObjectName[0]) <= 79);
    end_if;
  end_if;

  if (ActiveRequestValid = TRUE) &
     (ActiveRequest.SessionEpoch <> currentEpoch) then
    ActiveRequestValid := FALSE;
  end_if;

  // The queue has one cyclic owner, so enum states use direct transitions.
  if ActiveRequestValid = FALSE then
    if RequestQueue[QueueReadIndex$DINT].State = TCPMI_QUEUE_READY then
      RequestQueue[QueueReadIndex$DINT].State := TCPMI_QUEUE_ACTIVE;
      _StdLib.MemCpy(
        dest:=#ActiveRequest,
        source:=#RequestQueue[QueueReadIndex$DINT],
        size:=sizeof(ActiveRequest)
      );
      RequestQueue[QueueReadIndex$DINT].State := TCPMI_QUEUE_FREE;
      QueueReadIndex := (QueueReadIndex + 1) mod 8;
      ActiveRequestValid := TRUE;
    end_if;
  end_if;

  if ActiveRequestValid = TRUE then
    if ActiveRequest.SessionEpoch = currentEpoch then
      _memset(dest:=#RequestBuf, usByte:=0, cntr:=sizeof(RequestBuf));
      RequestBuf[0]$UINT := ActiveRequest.CommandId;
      RequestBuf[4]$UINT := ActiveRequest.PayloadLength;
      RequestBuf[6]$UINT := ActiveRequest.Reference;
      if ActiveRequest.PayloadLength > 0 then
        _StdLib.MemCpy(
          dest:=#RequestBuf[8],
          source:=#ActiveRequest.PayloadData[0],
          size:=ActiveRequest.PayloadLength
        );
      end_if;

      CommandID := ActiveRequest.CommandId$DINT;
      AxisRef := ActiveRequest.Reference$DINT;
      Payload := ActiveRequest.PayloadLength$DINT;
      CurrentSock := ActiveRequest.Socket;
      MsgPaser();
    end_if;
    ActiveRequestValid := FALSE;
  end_if;

  // Fault responses are ordered after every request accepted before the fault.
  if (ActiveRequestValid = FALSE) & (IngressFaultPending = TRUE) &
     (RequestQueue[QueueReadIndex$DINT].State <> TCPMI_QUEUE_READY) then
    if IngressFaultEpoch <> currentEpoch then
      IngressFaultPending := FALSE;
      if (IngressFaultCloseRequired = FALSE) &
         (IngressDiscardRemaining = 0) then
        IngressBlocked := FALSE;
      end_if;
    else
      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 1;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;
      Sendbuf[8]$UINT := 1;
      Sendbuf[10]$INT := IngressFaultError;
      sendRet := SendData(
        pData:=#Sendbuf[0],
        udSize:=12,
        dSocket:=IngressFaultSocket,
        bDirect:=TRUE
      );
      if sendRet = 12 then
        IngressFaultPending := FALSE;
        if (IngressFaultCloseRequired = FALSE) &
           (IngressDiscardRemaining = 0) then
          IngressBlocked := FALSE;
        end_if;
      else
        IngressFaultPending := FALSE;
        IngressBlocked := TRUE;
        IngressFaultCloseRequired := TRUE;
      end_if;
    end_if;
  end_if;
	state := READY;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::ConnSocketInfo
	VAR_INPUT
		dSock 	: DINT;
		InfoPara1 	: DINT;
		InfoPara2 	: DINT;
	END_VAR

  case InfoPara1 of
    TCP_SVR_SOCK_INFO_CONNECT :
      ConnectedClients +=1;
      if CurrentSock = 0 then
        CurrentSock := dSock;
        SessionEpoch += 1;
        if SessionEpoch = 0 then
          SessionEpoch := 1;
        end_if;
        IngressBlocked := FALSE;
        IngressFaultPending := FALSE;
        IngressFaultCloseRequired := FALSE;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      end_if;

    TCP_SVR_SOCK_INFO_DISCONNECT :
      ConnectedClients -=1;
      if ConnectedClients < 0 then
        ConnectedClients :=0;
      end_if;
      if CurrentSock = dSock then
        CurrentSock := 0;
        SessionEpoch += 1;
        if SessionEpoch = 0 then
          SessionEpoch := 1;
        end_if;
        IngressBlocked := FALSE;
        IngressFaultPending := FALSE;
        IngressFaultCloseRequired := FALSE;
      end_if;
      if RpcSocket = dSock then
        RpcSocket := 0;
        RpcInitialized := FALSE;
        RpcCallbackRegistered := FALSE;
        RpcCallbackEventMask := 0;
        RpcCallbackPort := 0;
        RpcCallbackIPv4[0] := 0;
        RpcCallbackIPv4[1] := 0;
        RpcCallbackIPv4[2] := 0;
        RpcCallbackIPv4[3] := 0;
      end_if;
      if ReceiveSocket = dSock then
        ReceiveFill := 0;
        ReceiveSocket := 0;
        _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      end_if;
      if IngressFaultSocket = dSock then
        IngressFaultPending := FALSE;
        IngressFaultCloseRequired := FALSE;
        IngressBlocked := FALSE;
      end_if;
      if IngressDiscardSocket = dSock then
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      end_if;
  end_case;


END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::DataHandling
	VAR_INPUT
		dSocket 	: DINT;
		udAvailableData 	: UDINT;
	END_VAR
	VAR_OUTPUT
		udReadAvailableDataBytes 	: UDINT;
	END_VAR
	VAR
		freeSize 	: UDINT;
	END_VAR

  udReadAvailableDataBytes := 0;
  if (IngressDiscardRemaining > 0) &
     (IngressDiscardSocket = dSocket) then
    freeSize := IngressDiscardRemaining;
    if freeSize > sizeof(ReceiveBuf) then
      freeSize := sizeof(ReceiveBuf);
    end_if;
    if udAvailableData < freeSize then
      udReadAvailableDataBytes := udAvailableData;
    else
      udReadAvailableDataBytes := freeSize;
    end_if;
  elsif (IngressBlocked = FALSE) & (ReceiveFill < sizeof(ReceiveBuf)) then
    freeSize := sizeof(ReceiveBuf) - ReceiveFill;
    if udAvailableData < freeSize then
      udReadAvailableDataBytes := udAvailableData;
    else
      udReadAvailableDataBytes := freeSize;
    end_if;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::SendData
	VAR_INPUT
		pData 	: ^void;
		udSize 	: UDINT;
		dSocket 	: DINT;
		bDirect 	: BOOL;
	END_VAR
	VAR_OUTPUT
		dRetcode 	: DINT;
	END_VAR

  dRetcode := _TCPIPServerInterface::SendData(
    pData:=pData,
    udSize:=udSize,
    dSocket:=dSocket,
    bDirect:=bDirect
  );

  // A direct partial send cannot be retried without corrupting the stream.
  // Quarantine the session and require a clean TCP reconnect.
  if dRetcode <> udSize$DINT then
    SessionEpoch += 1;
    if SessionEpoch = 0 then
      SessionEpoch := 1;
    end_if;
    IngressBlocked := TRUE;
    IngressFaultPending := FALSE;
    IngressFaultCloseRequired := TRUE;
    RpcSocket := 0;
    RpcInitialized := FALSE;
    RpcCallbackRegistered := FALSE;
    RpcCallbackEventMask := 0;
    RpcCallbackPort := 0;
    RpcCallbackIPv4[0] := 0;
    RpcCallbackIPv4[1] := 0;
    RpcCallbackIPv4[2] := 0;
    RpcCallbackIPv4[3] := 0;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL TCPMotionInterface::Response
	VAR_INPUT
		pData 	: ^void;
		udSize 	: UDINT;
		dSock 	: DINT;
	END_VAR
  VAR
	usPayloadLength : UINT;
	usReference : UINT;
	usCommandId : UINT;
	udFrameSize : UDINT;
	udRemainingSize : UDINT;
	END_VAR

  if udSize = 0 then
    RETURN;
  end_if;

  // Drain a rejected frame without copying its remaining payload. DataHandling
  // limits each callback to the exact number of bytes still to discard.
  if IngressDiscardRemaining > 0 then
    if IngressDiscardSocket = dSock then
      if udSize >= IngressDiscardRemaining then
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
        if (IngressFaultPending = FALSE) &
           (IngressFaultCloseRequired = FALSE) then
          IngressBlocked := FALSE;
        end_if;
      else
        IngressDiscardRemaining -= udSize;
      end_if;
    end_if;
    RETURN;
  end_if;

  // Response is an ingress callback only. It never sends or calls motion APIs.
  if ((CurrentSock <> 0) & (CurrentSock <> dSock)) |
     ((RpcInitialized = TRUE) & (RpcSocket <> dSock)) then
    if IngressFaultPending = FALSE then
      IngressFaultSocket := dSock;
      IngressFaultEpoch := SessionEpoch;
      IngressFaultError := -1;
      IngressFaultCloseRequired := FALSE;
      IngressFaultPending := TRUE;
    end_if;
    RETURN;
  end_if;

  if ReceiveFill = 0 then
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  elsif ReceiveSocket <> dSock then
    // Before a session exists, let the latest socket restart the phase-1
    // accumulator so an abandoned partial frame cannot block initialization.
    ReceiveFill := 0;
    ReceiveSocket := dSock;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
  end_if;

  if udSize > sizeof(ReceiveBuf) - ReceiveFill then
    if IngressFaultPending = FALSE then
      IngressFaultSocket := dSock;
      IngressFaultEpoch := SessionEpoch;
      IngressFaultError := -8;
      IngressFaultCloseRequired := TRUE;
      IngressFaultPending := TRUE;
    end_if;
    IngressBlocked := TRUE;
    ReceiveFill := 0;
    ReceiveSocket := 0;
    _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    RETURN;
  end_if;

  _StdLib.MemCpy(
    dest:=#ReceiveBuf[ReceiveFill$DINT],
    source:=pData,
    size:=udSize
  );
  ReceiveFill += udSize;

  while ReceiveFill >= 8 do
    usPayloadLength := 0;
    _StdLib.MemCpy(dest:=#usPayloadLength, source:=#ReceiveBuf[4], size:=2);
    udFrameSize := TO_UDINT(usPayloadLength) + 8;

    if usPayloadLength > 96 then
      if IngressFaultPending = FALSE then
        IngressFaultSocket := ReceiveSocket;
        IngressFaultEpoch := SessionEpoch;
        IngressFaultError := -5;
        IngressFaultPending := TRUE;
      end_if;
      IngressBlocked := TRUE;
      if udFrameSize > ReceiveFill then
        IngressFaultCloseRequired := FALSE;
        IngressDiscardRemaining := udFrameSize - ReceiveFill;
        IngressDiscardSocket := ReceiveSocket;
      elsif udFrameSize = ReceiveFill then
        IngressFaultCloseRequired := FALSE;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      else
        // A following frame is already partially buffered. Reconnect is the
        // only safe P0 resynchronization because its boundary is unknown.
        IngressFaultCloseRequired := TRUE;
        IngressDiscardRemaining := 0;
        IngressDiscardSocket := 0;
      end_if;
      ReceiveFill := 0;
      ReceiveSocket := 0;
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      RETURN;
    end_if;

    if ReceiveFill < udFrameSize then
      RETURN;
    end_if;

    usCommandId := 0;
    usReference := 0;

    _StdLib.MemCpy(dest:=#usCommandId, source:=#ReceiveBuf[0], size:=2);
    _StdLib.MemCpy(dest:=#usReference, source:=#ReceiveBuf[6], size:=2);

    if RequestQueue[QueueWriteIndex$DINT].State = TCPMI_QUEUE_FREE then
      RequestQueue[QueueWriteIndex$DINT].State := TCPMI_QUEUE_WRITING;
      NextSequence += 1;
      if NextSequence = 0 then
        NextSequence := 1;
      end_if;
      RequestQueue[QueueWriteIndex$DINT].Sequence := NextSequence;
      RequestQueue[QueueWriteIndex$DINT].Socket := ReceiveSocket;
      RequestQueue[QueueWriteIndex$DINT].SessionEpoch := SessionEpoch;
      RequestQueue[QueueWriteIndex$DINT].CommandId := usCommandId;
      RequestQueue[QueueWriteIndex$DINT].Reference := usReference;
      RequestQueue[QueueWriteIndex$DINT].PayloadLength := usPayloadLength;
      RequestQueue[QueueWriteIndex$DINT].Reserved := 0;
      _memset(
        dest:=#RequestQueue[QueueWriteIndex$DINT].PayloadData[0],
        usByte:=0,
        cntr:=96
      );
      if usPayloadLength > 0 then
        _StdLib.MemCpy(
          dest:=#RequestQueue[QueueWriteIndex$DINT].PayloadData[0],
          source:=#ReceiveBuf[8],
          size:=usPayloadLength
        );
      end_if;
      RequestQueue[QueueWriteIndex$DINT].State := TCPMI_QUEUE_READY;
      QueueWriteIndex := (QueueWriteIndex + 1) mod 8;
    else
      if IngressFaultPending = FALSE then
        IngressFaultSocket := ReceiveSocket;
        IngressFaultEpoch := SessionEpoch;
        IngressFaultError := -8;
        IngressFaultCloseRequired := ReceiveFill > udFrameSize;
        IngressFaultPending := TRUE;
      end_if;
      IngressBlocked := TRUE;
      ReceiveFill := 0;
      ReceiveSocket := 0;
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
      RETURN;
    end_if;

    udRemainingSize := ReceiveFill - udFrameSize;
    if udRemainingSize > 0 then
      _StdLib.MemMove(
        dest:=#ReceiveBuf[0],
        source:=#ReceiveBuf[udFrameSize$DINT],
        size:=udRemainingSize
      );
      _memset(
        dest:=#ReceiveBuf[udRemainingSize$DINT],
        usByte:=0,
        cntr:=sizeof(ReceiveBuf) - udRemainingSize
      );
    else
      _memset(dest:=#ReceiveBuf, usByte:=0, cntr:=sizeof(ReceiveBuf));
    end_if;

    ReceiveFill := udRemainingSize;
    if ReceiveFill = 0 then
      ReceiveSocket := 0;
    end_if;
  end_while;


END_FUNCTION


FUNCTION TCPMotionInterface::MsgPaser

  // Motion/read/lookup commands are accepted only after this socket completed
  // session init and UDP callback registration.
  if (CommandID <> 0x8080) & (CommandID <> 0x405C) &
     (CommandID <> 0x405D) &
     ((RpcInitialized = FALSE) | (RpcCallbackRegistered = FALSE) |
      (RpcSocket <> CurrentSock)) then
    _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
    Sendbuf[0]$UINT := 1;
    Sendbuf[2]$UINT := 4;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UINT := 1;
    Sendbuf[10]$INT := -1;

    SendData(
      pData:=#Sendbuf[0],
      udSize:=12,
      dSocket:=CurrentSock,
      bDirect:=TRUE
    );
    RETURN;
  end_if;

  // Commands without an approved LASAL semantic stay blocked.
  if (CommandID = 0x2049) | (CommandID = 0x2085) |
     (CommandID = 0x20A4) then
    _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
    Sendbuf[0]$UINT := 0;
    Sendbuf[2]$UINT := 8;
    Sendbuf[4]$UDINT := 0;
    Sendbuf[8]$UDINT := AxisRef$UDINT;
    Sendbuf[12]$UINT := 1;
    Sendbuf[14]$INT := -5;
    SendData(pData:=#Sendbuf[0], udSize:=16,
             dSocket:=CurrentSock, bDirect:=TRUE);
    RETURN;
  end_if;

  case CommandID of

    // RPC session init. Response payload follows the captured 24-byte shape.
    0x8080:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));

      if (Payload = 1) & (RequestBuf[8] = 0) &
         ((RpcInitialized = FALSE) | (RpcSocket = CurrentSock)) then
        RpcSocket := CurrentSock;
        RpcInitialized := TRUE;
        RpcCallbackRegistered := FALSE;
        RpcCallbackEventMask := 0;
        RpcCallbackPort := 0;
        RpcCallbackIPv4[0] := 0;
        RpcCallbackIPv4[1] := 0;
        RpcCallbackIPv4[2] := 0;
        RpcCallbackIPv4[3] := 0;

        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 24;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 64;  // Captured opaque value; meaning not confirmed.

        SendData(
          pData:=#Sendbuf[0],
          udSize:=32,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      end_if;

    // Register the PC UDP callback endpoint. Event payload sending is pending
    // a real callback capture/specification.
    0x405C:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;

      if (Payload = 12) & (RpcInitialized = TRUE) &
         (RpcSocket = CurrentSock) then
        _StdLib.MemCpy(dest:=#RpcCallbackEventMask, source:=#RequestBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#RpcCallbackPort, source:=#RequestBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#RpcCallbackIPv4[0], source:=#RequestBuf[16], size:=4);

        if (RpcCallbackPort > 0) & (RpcCallbackPort <= 65535) then
          RpcCallbackRegistered := TRUE;
          Sendbuf[8]$UINT := 0;
          Sendbuf[10]$INT := 0;
        else
          RpcCallbackRegistered := FALSE;
          Sendbuf[8]$UINT := 1;
          Sendbuf[10]$INT := -1;
        end_if;
      else
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;
      end_if;

      SendData(
        pData:=#Sendbuf[0],
        udSize:=12,
        dSocket:=CurrentSock,
        bDirect:=TRUE
      );

    // Acknowledge before the PC closes the TCP socket, then clear this session.
    0x405D:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      Sendbuf[0]$UINT := 0;
      Sendbuf[2]$UINT := 4;
      Sendbuf[4]$UDINT := 0;

      if (Payload = 1) & (RpcInitialized = TRUE) &
         (RpcSocket = CurrentSock) then
        Sendbuf[8]$UINT := 0;
        Sendbuf[10]$INT := 0;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );

        RpcSocket := 0;
        RpcInitialized := FALSE;
        RpcCallbackRegistered := FALSE;
        RpcCallbackEventMask := 0;
        RpcCallbackPort := 0;
        RpcCallbackIPv4[0] := 0;
        RpcCallbackIPv4[1] := 0;
        RpcCallbackIPv4[2] := 0;
        RpcCallbackIPv4[3] := 0;
        SessionEpoch += 1;
        if SessionEpoch = 0 then
          SessionEpoch := 1;
        end_if;
      else
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -1;

        SendData(
          pData:=#Sendbuf[0],
          udSize:=12,
          dSocket:=CurrentSock,
          bDirect:=TRUE
        );
      end_if;

    // Resolve the public name against names read from the connected LASAL
    // objects.  Returned values are opaque descriptors, never PLC pointers.
    0x103C:

      AxisRef := 0;
      if (Payload = 80) & (ObjectRegistryReady = TRUE) then
        RequestBuf[87] := 0;

        if _strcmp(str1:=#RequestBuf[8]$CHAR, str2:=#AxisObjectName1[0]) = 0 then
          AxisRef := 1;
        elsif _strcmp(str1:=#RequestBuf[8]$CHAR, str2:=#AxisObjectName2[0]) = 0 then
          AxisRef := 2;
        elsif _strcmp(str1:=#RequestBuf[8]$CHAR, str2:=#AxisObjectName3[0]) = 0 then
          AxisRef := 3;
        elsif _strcmp(str1:=#RequestBuf[8]$CHAR, str2:=#AxisObjectName4[0]) = 0 then
          AxisRef := 4;
        end_if;
      end_if;

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if AxisRef > 0 then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 6;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 0;
        Sendbuf[12]$UINT := AxisRef$UINT;
        SendData(pData:=#Sendbuf[0], udSize:=14,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -2;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x1042:

      AxisRef := 0;
      if (Payload = 80) & (ObjectRegistryReady = TRUE) then
        RequestBuf[87] := 0;
        if _strcmp(str1:=#RequestBuf[8]$CHAR, str2:=#GroupObjectName[0]) = 0 then
          AxisRef := 0x0100;
        end_if;
      end_if;

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if AxisRef = 0x0100 then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 6;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := 0;
        Sendbuf[12]$UINT := AxisRef$UINT;
        SendData(pData:=#Sendbuf[0], udSize:=14,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -2;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x202B:

      _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
      if (Payload = 12) & (AxisRef >= 1) & (AxisRef <= 4) then
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 8;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := AxisRef$UDINT;
        Sendbuf[12]$UINT := 0;
        Sendbuf[14]$INT := 0;
        SendData(pData:=#Sendbuf[0], udSize:=16,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := -3;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    // DINT protocol v1 Power. The enable flag is payload byte 4.
    0x2023:

      AxisCommandInputValid :=
        (Payload = 8) & (AxisRef >= 1) & (AxisRef <= 4) &
        (RequestBuf[8]$UDINT = 1) &
        ((RequestBuf[12] = 0) | (RequestBuf[12] = 1)) &
        (RequestBuf[13] = 1) & (RequestBuf[14] = 0) &
        (RequestBuf[15] = 1);
      if AxisCommandInputValid = TRUE then
        if RequestBuf[12] = 1 then
          PowerOn();
        else
          PowerOff();
        end_if;
      else
        AxisRef := 0;
        PowerOff();
      end_if;

    0x2024:

      if (Payload = 1) & (RequestBuf[8] = 1) &
         (AxisRef >= 1) & (AxisRef <= 4) then
        AxisReset();
      else
        AxisRef := 0;
        AxisReset();
      end_if;

    0x2022:

      AxisCommandInputValid := FALSE;
      if Payload = 16 then
        _StdLib.MemCpy(dest:=#dec, source:=#RequestBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#jer, source:=#RequestBuf[12], size:=4);
        _StdLib.MemCpy(dest:=#bufMode, source:=#RequestBuf[16], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#RequestBuf[20], size:=4);
        AxisCommandInputValid :=
          (AxisRef >= 1) & (AxisRef <= 4) &
          (bufMode = 1) & (Exec = 1);
      else
        AxisRef := 0;
      end_if;
      MoveStop();

    0x2028:

      // Read-only client calls run in CyWork. Keep this cyclic task on the
      // axis RT core with equal or lower priority than the axis RT task.
      AxisCommandErrorId := -3;
      AxisCommandStatus := 1;
      AxisStatusValue := 0;
      AxisErrorValue := 0;
      PayloadReference := 0;
      Exec := 0;

      if Payload = 8 then
        _StdLib.MemCpy(dest:=#PayloadReference, source:=#RequestBuf[8], size:=4);
        _StdLib.MemCpy(dest:=#Exec, source:=#RequestBuf[12], size:=4);
      end_if;

      if (Payload = 8) & (AxisRef >= 1) & (AxisRef <= 4) &
         (PayloadReference = AxisRef) & (Exec = 1) then
        AxisCommandErrorId := -2;
        case AxisRef of
          1:
            if IsClientConnected(#LMCAxis1) = 1 then
              AxisStatusValue := LMCAxis1.ReadAxisStatus();
              AxisErrorValue := LMCAxis1.ReadAxisError();
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
          2:
            if IsClientConnected(#LMCAxis2) = 1 then
              AxisStatusValue := LMCAxis2.ReadAxisStatus();
              AxisErrorValue := LMCAxis2.ReadAxisError();
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
          3:
            if IsClientConnected(#LMCAxis3) = 1 then
              AxisStatusValue := LMCAxis3.ReadAxisStatus();
              AxisErrorValue := LMCAxis3.ReadAxisError();
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
          4:
            if IsClientConnected(#LMCAxis4) = 1 then
              AxisStatusValue := LMCAxis4.ReadAxisStatus();
              AxisErrorValue := LMCAxis4.ReadAxisError();
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
        else
        end_case;

        _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
        Sendbuf[0]$UINT := 0;
        Sendbuf[2]$UINT := 12;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UDINT := AxisStatusValue$UDINT;
        Sendbuf[12]$UINT := AxisCommandStatus;
        Sendbuf[14]$INT := AxisCommandErrorId;
        Sendbuf[16]$UINT := AxisErrorValue$UINT;
        Sendbuf[18]$UINT := 0;
        SendData(pData:=#Sendbuf[0], udSize:=20,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      else
        _memset(dest:=#Sendbuf, usByte:=0, cntr:=sizeof(Sendbuf));
        Sendbuf[0]$UINT := 1;
        Sendbuf[2]$UINT := 4;
        Sendbuf[4]$UDINT := 0;
        Sendbuf[8]$UINT := 1;
        Sendbuf[10]$INT := AxisCommandErrorId;
        SendData(pData:=#Sendbuf[0], udSize:=12,
                 dSocket:=CurrentSock, bDirect:=TRUE);
      end_if;

    0x202E:

      // The interface has no RT task. This read executes once per CyWork scan.
      AxisCommandErrorId := -3;
      AxisCommandStatus := 1;
      ReadPos := 0;
      if (Payload = 1) & (RequestBuf[8] = 0) &
         (AxisRef >= 1) & (AxisRef <= 4) then
        AxisCommandErrorId := -2;
        case AxisRef of
          1:
            if IsClientConnected(#LMCAxis1) = 1 then
              ReadPos := LMCAxis1.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
          2:
            if IsClientConnected(#LMCAxis2) = 1 then
              ReadPos := LMCAxis2.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
              AxisCommandStatus := 0;
              AxisCommandErrorId := 0;
            end_if;
          3:
            if IsClientConnected(#LMCAxis3) = 1 then
              ReadPos := LMCAxis3.ReadPosition(Mode:=LMCAXIS_ACTPOS_APPUNIT);
