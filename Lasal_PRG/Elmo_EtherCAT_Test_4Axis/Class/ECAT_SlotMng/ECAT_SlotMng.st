FUNCTION VIRTUAL ECAT_SlotMng::EvtCallBackStateChange
	VAR_INPUT
		NewEtherCATState 	: UDINT;
	END_VAR
  VAR
    MyPara 	: CmdStruct;
		MyResult 	: Results;
    pSlotInfo     : ^t_sECSLOTInfo;
  	Modidx : UDINT;
  END_VAR

  
  ECAT_Slave_Base::EvtCallBackStateChange(NewEtherCATState);
  
  // Inform Slot Classes
  MyPara.uiCmd := ECAT_M_SET_CLASSSTATE;
  MyPara.aPara[0]  := 1; // Version
  
  if Online = 1 then
    MyPara.aPara[1]$t_e_VaranErrors := _ClassOk;  // ClassState
    MyPara.aPara[2]$DINT            := Online; // Online  
  elsif ClassState = _ClassOk then
    // Class Ok but not Online
    MyPara.aPara[1]$t_e_VaranErrors := _NotInitialized; // ClassState
    MyPara.aPara[2]$DINT            := 0; // Online  
  else
    MyPara.aPara[1]$t_e_VaranErrors := ClassState;  // ClassState <> _ClassOk
    MyPara.aPara[2]$DINT            := 0; // Online  
  end_if;
  
  // Pass on to all slots
  if (sSlotInfos.NoSlots) & (sSlotInfos.pSlotInfo) then

    pSlotInfo := sSlotInfos.pSlotInfo;
    for Modidx := 1 to sSlotInfos.NoSlots do
          
      // Call all connected Modules        
      if (pSlotInfo^.pThis) then
        pSlotInfo^.pThis^.NewInst(#MyPara, #MyResult);
      end_if;
      
      pSlotInfo += sizeof(t_sECSLOTInfo);
    end_for;    
    
  end_if;

END_FUNCTION


