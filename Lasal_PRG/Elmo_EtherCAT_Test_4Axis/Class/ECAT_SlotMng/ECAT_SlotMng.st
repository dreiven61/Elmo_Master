FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::InitModule
	VAR_INPUT
		MasterState 	: t_e_ECAT_STATE;
	END_VAR
	VAR_OUTPUT
		eModuleInitState 	: iprStates;
	END_VAR
  VAR
    _Para         : CmdStruct;
    _Result       : Results;
    retcode     : iprStates;
    currentInitmodlulFlag : BDINT;
    b_ModulInitComplete : BOOL;
    pSlaveInfo : ^t_sECSLOTInfo;
  	Modidx : UDINT;    
  END_VAR
  
  eModuleInitState := ERROR;
  
  if ClassState <> _NotInitialized then
    return;
  end_if;
  
  // Call for SDO Handling
  ECAT_Slave_Base::UpdateCy();
  
  eModuleInitState := InitModuleMng(MasterState:=MasterState);
  
  if eModuleInitState = READY then  // Mng is Ready
  
    case MasterState of

      //**************************************************************
      t_e_ECAT_STATE::ECAT_STATE_INIT:
        currentInitmodlulFlag := ECAT_INIT_MODULE_CALL_INIT;
        
      //**************************************************************
      t_e_ECAT_STATE::ECAT_STATE_PREOP:      
        currentInitmodlulFlag := ECAT_INIT_MODULE_CALL_PREOP;
        
      //**************************************************************
      t_e_ECAT_STATE::ECAT_STATE_SAFEOP:
        currentInitmodlulFlag := ECAT_INIT_MODULE_CALL_SAFEOP;
      
      //**************************************************************
      t_e_ECAT_STATE::ECAT_STATE_OP:
        currentInitmodlulFlag := ECAT_INIT_MODULE_CALL_OP;
      
    end_case;
    
    // preinitialize the complete marker => is resetted if a module has to be initialized
    b_ModulInitComplete := TRUE;
  
    if (sSlotInfos.NoSlots) & (sSlotInfos.pSlotInfo) then
    
      _Para.uiCmd                   := ECSLOTMNG_CALL_INIT_MODULE;
      _Para.aPara[0]$DINT           := 1;
      _Para.aPara[1]$t_e_ECAT_STATE := EtherCATState;
      
      pSlaveInfo := sSlotInfos.pSlotInfo;
      for Modidx := 1 to sSlotInfos.NoSlots do
      
        //Check if current module has to be called
        if (pSlaveInfo^.bdInitModuleFlags <> ECAT_INIT_MODULE_NO_CALL) &
          ((pSlaveInfo^.bdInitModuleFinished AND MasterState$BDINT) <> MasterState$BDINT ) then
              
          if ((pSlaveInfo^.bdInitModuleFinished AND currentInitmodlulFlag) = 0) then // Check if Init has not been finished for module
            
            // Call InitModule of connected Modules        
            if (pSlaveInfo^.pThis) &          
               ((pSlaveInfo^.bdInitModuleFlags AND currentInitmodlulFlag) = currentInitmodlulFlag) then // Check if currentInitmodlulFlag is needed for this module
              retcode := pSlaveInfo^.pThis^.NewInst(#_Para,#_Result);

  #ifdef ECAT_TRACE_VIEW_LOG  
            OS_MakeTraceEntry(pSystrace, HWCONTROL_SYSTRACE_TYPE, ECAT_SYSTRACE_POSTINIT_CALL_INITSLOTMODULE,Modidx);
  #endif
              //Check retcode            
              if retcode = READY then
                pSlaveInfo^.bdInitModuleFinished := pSlaveInfo^.bdInitModuleFinished OR currentInitmodlulFlag;
              elsif retcode = ERROR then              
                LogValue("@0937 (ECAT_SlotMng::InitModule) Failed to initialize EtherCAT Slot 0x{0} via InitModule-Interface", pSlaveInfo^.Slot);
                
                if pSlaveInfo^.bRequired = TRUE then
                  // Module is Required => EC is required
                  // Return error and cancel 
                  eModuleInitState := ERROR;
                  return;
  //            else
  //              // Ignore Module and move to next
                end_if;
              else
                // Busy
                b_ModulInitComplete := FALSE; //At least one module is not ready yet --> carry on with ModuleInit phase
              end_if;
              
            else
        
              //Module has no need to be called, just set as finished
              pSlaveInfo^.bdInitModuleFinished := pSlaveInfo^.bdInitModuleFinished OR currentInitmodlulFlag;
            end_if;
              
          end_if;
        
        end_if;
        
        pSlaveInfo += sizeof(t_sECSLOTInfo);
      
      end_for;
      
      // Check if all Modules are ready
      eModuleInitState := BUSY;
      if b_ModulInitComplete = TRUE then        
        eModuleInitState := READY;
      end_if;
    
    end_if;
  end_if;
  
  if (eModuleInitState = READY) then
    // Check if InitModule has been completed for all needed MasterState's
    bdInitModuleFlagsSlotMngDone := bdInitModuleFlagsSlotMngDone OR currentInitmodlulFlag;
    
    if bdInitModuleFlagsSlotMng = bdInitModuleFlagsSlotMngDone then
      ClassState := _ClassOk;
    end_if;
    
  end_if;

END_FUNCTION

#pragma warning(disable:73);
FUNCTION VIRTUAL ECAT_SlotMng::InitModuleMng
	VAR_INPUT
		MasterState 	: t_e_ECAT_STATE;
	END_VAR
	VAR_OUTPUT
		eModuleInitState 	: iprStates;
	END_VAR
#pragma warning(default:73);

  eModuleInitState := READY;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::SetPDOSettings
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  VAR
  	pSlaveInfo : ^t_sECSLOTInfo;
  	Modidx : UDINT;    
  END_VAR
  
  retcode := 0;
  
  if (sSlotInfos.NoSlots) then
    
    pSlaveInfo := sSlotInfos.pSlotInfo; //Point to current slot
    
    //Call SetPDOSettings of all logged in slaves
    for Modidx:=1 to sSlotInfos.NoSlots do      
      
      retcode := pSlaveInfo^.pThis^.SetPDOSettings();
      
      if retcode <> 0 then
        LogValue("@0938 (ECAT_SlotMng::SetPDOSettings) SetPDOSettings() failed for Slot 0x{0}", pSlaveInfo^.Slot );
        return;
      end_if;
      
      pSlaveInfo += sizeof(t_sECSLOTInfo);
      
    end_for;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::UpdateCy
  VAR
    pSlotInfo     : ^t_sECSLOTInfo;
  	Modidx : UDINT;
  END_VAR


  // Call Base for SDO HAndling
  ECAT_Slave_Base::UpdateCy();

  //**************************************************************
  // Call update Cy of Slots
    
  //Always call all slots (needed for SDO Handling) 
  if (sSlotInfos.NoSlots) & (sSlotInfos.pSlotInfo) then
    
    pSlotInfo := sSlotInfos.pSlotInfo;
    for Modidx := 1 to sSlotInfos.NoSlots do
          
      // Call all connected Modules        
      if (pSlotInfo^.pThis) & (pSlotInfo^.pThis^.ClassState = _ClassOk) then
        pSlotInfo^.pThis^.UpdateCy();
      end_if;
      
      pSlotInfo += sizeof(t_sECSLOTInfo);
    end_for;
  
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::ConnectEvent
  VAR
    pSlotInfo     : ^t_sECSLOTInfo;
  	Modidx : UDINT;
  END_VAR
  
  bdInitModuleFlagsSlotMngDone := 0;
  
  ECAT_Slave_Base::ConnectEvent();
  
  // Call all slots
  if (sSlotInfos.NoSlots) & (sSlotInfos.pSlotInfo) then
    
    pSlotInfo := sSlotInfos.pSlotInfo;
    for Modidx := 1 to sSlotInfos.NoSlots do
          
      // Call all connected Modules        
      if (pSlotInfo^.pThis) then
        pSlotInfo^.pThis^.ConnectEvent();
      end_if;
      
      pSlotInfo += sizeof(t_sECSLOTInfo);
    end_for;
    
  end_if;

END_FUNCTION


