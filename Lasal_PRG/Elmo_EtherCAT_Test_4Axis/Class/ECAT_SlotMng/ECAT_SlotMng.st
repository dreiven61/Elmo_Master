FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::Init

  usSlotMngInitCnt += 1;
  
  if ClassState = _NotInitialized & EtherCATState <> ECAT_STATE_NONE then
  
    case usSlotMngInitCnt of

      //**********************************************************************************************************************************************************
      1: 
        // Read here. May be overwritten in 2nd Init by connected Slot Modules
        Required      := Required.Read();

      //**********************************************************************************************************************************************************      
      3:
      
        bBlockInitModule := TRUE;
        
        // Reinit Mem to acually needed size
        if (sSlotInfos.pSlotInfo <> NIL) &
           (sSlotInfos.NoSlots) &
           (sSlotInfos.NoSlots < sSlotInfos.MaxNoSlots) then
          
          sSlotInfos.MaxNoSlots       := sSlotInfos.NoSlots;
          sSlotInfos.pSlotInfo$pVoid  := ToStdLib.ReAlloc(mptr    := sSlotInfos.pSlotInfo, 
                                                          newsize := sizeof(t_sECSLOTInfo) * (sSlotInfos.MaxNoSlots));
        end_if;
        
        if sSlotInfos.pSlotInfo = NIL then
          EtherCATState := ECAT_STATE_NONE;
          ClassState    := _MemoryFault;
          LogError("@0935 (ECAT_SlotMng::Init) Failed to reserve memory for slot modules");
          return;
        end_if;
        
    end_case;
  end_if;
  
  ECAT_Slave_Base::Init();

END_FUNCTION


FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::ClassState::NewInst
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^Results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR
  VAR
    pSlotInfo     : ^t_sECSLOTInfo;
  	Modidx : UDINT;
  END_VAR
  
  //Return with error if command is unknown or not supported
  ret_code := ERROR;
  
  case pPara^.uiCmd of
  
//**********************************************************************************************************************************************************        
    ECAT_M_SET_CLASSSTATE:
    
      // Pass on to base
      ret_code := ECAT_Slave_Base::NewInst(pPara, pResult);
      
      // Pass on to all slots
      if (sSlotInfos.NoSlots) & (sSlotInfos.pSlotInfo) then
    
        pSlotInfo := sSlotInfos.pSlotInfo;
        for Modidx := 1 to sSlotInfos.NoSlots do
              
          // Call all connected Modules        
          if (pSlotInfo^.pThis) then
            pSlotInfo^.pThis^.NewInst(pPara, pResult);
          end_if;
          
          pSlotInfo += sizeof(t_sECSLOTInfo);
        end_for;
        
      end_if;

//**********************************************************************************************************************************************************
    ECSLOTMNG_INSTALL_CALLBACK:
    
      // Change command and pass on the ECAT Master
      pPara^.uiCmd := ECAT_M_INSTALL_CALLBACK;
      
      // Check Version Number 
      if (pPara^.aPara[0] = 1) | 
         (pPara^.aPara[0] = 2) then
         
        if pPara^.aPara[0] = 1 then
          // Substitute t_e_ECAT_STATE with server of SlotMng Class
          pPara^.aPara[11]$^t_e_ECAT_STATE  := #EtherCATState.dData;                // Pointer t_e_ECAT_STATE of the ECAT Module. Used to check if callbacks in UpdateRt (>= ECAT_STATE_SAFEOP), UpdateRtPostScan (>= ECAT_STATE_OP) should be done.
          pPara^.aPara[0]                   := 2;  // Update Version number to reflect new Parameter 
        
        // else Calling class has already set pPara^.aPara[11] correctly
        end_if;
      
        ret_code := toMaster.NewInst(pPara,pResult);
        
      end_if;

//**********************************************************************************************************************************************************    
    ECSLOTMNG_LOGIN_SLAVE:
      ret_code := LoginSlaveModule(pPara, pResult);
      
//**********************************************************************************************************************************************************
    ECSLOTMNG_GET_ECATMHDL:
      // Change command and pass on the ECAT Master
      pPara^.uiCmd := ECAT_M_GET_ECATMHDL;
      ret_code := toMaster.NewInst(pPara,pResult);

//**********************************************************************************************************************************************************          
    ECSLOTMNG_GET_ECATSLAVEIDX:
      // Check Version Number 
      if (pPara^.aPara[0] = 1) then        
        
        pResult^.uiLng  := 12;
        pResult^.aData[0]$DINT  := ECAT_RETOK;
        pResult^.aData[4]$DINT  := pPara^.aPara[0];  // Version no
        pResult^.aData[8]$UDINT := SlaveIndex;
        
        ret_code := READY;
        
      end_if;
  
  else
    ret_code := ECAT_Slave_Base::NewInst(pPara, pResult);
  end_case;
  
END_FUNCTION

FUNCTION VIRTUAL ECAT_SlotMng::LoginSlaveModule
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: iprStates;
	END_VAR
  VAR
    pSlotInfo : ^t_sECSLOTInfo;
  END_VAR

  ret_code        := ERROR;
  pResult^.uiLng  := 4;
  
  if (bBlockInitModule = FALSE) then // Must be in init
  
    if (pPara^.aPara[0] = 1) then // Command Version 
      
      pResult^.aData[4]$DINT := pPara^.aPara[0];  //return version number
      
      //Check Parameters      
      if (pPara^.aPara[2]) then                             // This pointer valid?
      
        // Check for space for new slot
        if sSlotInfos.NoSlots < sSlotInfos.MaxNoSlots then
          sSlotInfos.NoSlots += 1;
        else
        
          // Alloc more mem
          if sSlotInfos.pSlotInfo = NIL then
            sSlotInfos.NoSlots          := 1;
            sSlotInfos.MaxNoSlots       := ECAT_SLOTMNG_INC_SLOT_MEM;
            sSlotInfos.pSlotInfo$pVoid  := ToStdLib.Malloc( size    := sizeof(t_sECSLOTInfo) * (sSlotInfos.MaxNoSlots));
          else
            sSlotInfos.NoSlots          += 1;
            sSlotInfos.MaxNoSlots       += ECAT_SLOTMNG_INC_SLOT_MEM;
            sSlotInfos.pSlotInfo$pVoid  := ToStdLib.ReAlloc(mptr    := sSlotInfos.pSlotInfo, 
                                                            newsize := sizeof(t_sECSLOTInfo) * (sSlotInfos.MaxNoSlots));
          end_if;
          
          if sSlotInfos.pSlotInfo = NIL then
            EtherCATState := ECAT_STATE_NONE;  // Deactivat Class
            ClassState    := _MemoryFault;
            pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_OUT_OF_MEM;
            LogValue("@0936 (ECAT_SlotMng::LoginSlaveModule) Failed to login slot module 0x{0} to ECAT_SlotMng. Out of memory!",pPara^.aPara[1]$UDINT);
            return;
          end_if;
        
        end_if;
        
        //Point to next free space 
        pSlotInfo :=  sSlotInfos.pSlotInfo + ((sSlotInfos.NoSlots - 1) * sizeof(t_sECSLOTInfo) );
        
        //Save slave information
        pSlotInfo^.Slot                 := pPara^.aPara[1]$UDINT;
        pSlotInfo^.pThis                := pPara^.aPara[2]$^ECAT_SlotBase;
        pSlotInfo^.bRequired            := pPara^.aPara[3]$BOOL;
        pSlotInfo^.bdInitModuleFlags    := pPara^.aPara[4]$BDINT;
        pSlotInfo^.bdInitModuleFinished := 0;
        
        //Set our required flag if at least one slave is required
        if pSlotInfo^.bRequired then
          Required := 1; // Update client info
        end_if;
        
        bdInitModuleFlagsSlotMng := bdInitModuleFlagsSlotMng OR pSlotInfo^.bdInitModuleFlags;
        
        //Set return values
        ret_code := READY;
        
        pResult^.uiLng  := 12;
        pResult^.aData[0]$DINT  := ECAT_RETOK;
        pResult^.aData[8]$pVoid := NIL;  // ecatmhdl is not valid at this point

      else  //Check parameters
        pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_PARAMETER;
        LogValue("@0936 (ECAT_SlotMng::LoginSlaveModule) Failed to login slot module 0x{0} to ECAT_SlotMng. Invalid Parameters!",pPara^.aPara[1]$UDINT);

        ClassState := _InvalidConfguration;
        EtherCATState := ECAT_STATE_NONE;
        
        //Login failed, check if module is required
        if pPara^.aPara[3]$BOOL = TRUE then
          ClassState := _RequiredError;
        end_if;
      end_if;

    else // if pPara^.aPara[0] = 1 then // Command Version 
      pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_VERSION;
      LogValue("@0936 (ECAT_SlotMng::LoginSlaveModule) Failed to login slot module 0x{0} to ECAT_SlotMng. Not supported version of NewInst command 0x{1}!",pPara^.aPara[1]$UDINT,pPara^.aPara[0]$UDINT);
    end_if;
    
  else  // if (EtherCATState = ECAT_STATE_INIT) then
    pResult^.aData[0]$DINT  := ECAT_RETERR_CMD_WRONG_MST_STATE;
    LogError("@0936 (ECAT_SlotMng::LoginSlaveModule) Failed to login slot module 0x{0} to ECAT_SlotMng. Invalid Init!");
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_SlotMng::GetInitModuleFlags
