FUNCTION VIRTUAL GLOBAL _SyncMeasure::Init
VAR  
	aObjectPath     : ARRAY [0..1] OF USINT;
  retcode         : DINT;  
  aPllProperties  : ARRAY [0..1] OF PLL_PROPERTY_VALUE_PAIR;
END_VAR

  us_InitCnt += 1;
  
  if us_InitCnt = 1 then
  
    // Init Variables
    dSyncMultiplier := 1;
  
    //*****************************************************************************
    //** PLL SETTINGS                                                            **
    //*****************************************************************************
    
    pPLL := GetCILInterfacePLL.GetCILPll();
    
    if pPll = NIL then
      LogError("@034A (_SyncMeasure::Init) Kernel Interface 'pPll' not available with this version/platform");
      SyncRegulationEnable := -1;
      return;
    else
    
      // Get CPU Node Handle
      aObjectPath[0] := 1; // Create CPU HWP
      aObjectPath[1] := 0;

      if  PLL_iGetNodeHandle(pPLL, pszHardwarePath:=#aObjectPath[0], phNodeHandle:=#ud_CPUNodeHandle ) <> PLL_OK then
        LogError("@034B (_SyncMeasure::Init) Failed to Read CPU Node Handle");
        SyncRegulationEnable := -1;
        return;      
      end_if;
      
    end_if;
     
    dMainTimer := _ClockTicks * 1000; // us => ns
    
    PhaseRegDamping := PhaseRegDamping.Read();
    if ( (PhaseRegDamping > 15) | 
         (PhaseRegDamping < 0) ) then
      PhaseRegDamping := 0;
    end_if;
    
// Check OS interface version
#ifdef PLL_TYPE_VERSION
#if PLL_TYPE_VERSION >= 0x00010001

    aPllProperties[0].udPropertyId    := PLL_PROP_MAX_SHIFTED_PHASE;
    aPllProperties[0].udPropertyValue := PhaseRegDamping$UDINT;
    
    retcode := PLL_iSetPLLProperties(pPLL, hNodeHandle:=ud_CPUNodeHandle, udPropertyCount:=1, psPropertyValuePairs:=#aPllProperties[0]);
    if retcode <> PLL_OK then
      LogError(e_msg:="@034C (_SyncMeasure::Init) Error: Failed writing the PLL settings PLL_PROP_MAX_SHIFTED_PHASE. Update OS.");          
      SyncRegulationEnable := -1;
      return;
    end_if;

#else
  LogError(e_msg:="@034D (_SyncMeasure::Init) Error: Pll Property PLL_PROP_MAX_SHIFTED_PHASE is not supported. Update LSL_ST_PLL.H");          
#endif
#else
  LogError(e_msg:="@034D (_SyncMeasure::Init) Error: Pll Property PLL_PROP_MAX_SHIFTED_PHASE is not supported. Update LSL_ST_PLL.H");          
#endif
    
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _SyncMeasure::SyncMeasurement
  
  // Check for Synchron 1
  hs_SyncCheck := hs_SyncCheck shl 1;
  
  // Overwritten if measured
  sSyncMeasurementData.i_DeltaPhase  := 0;

#ifdef _SYNCM_DEBUG  
  sSyncMeasurementData.d_DeltaPeriod := 0;
#endif
        
  // Call from updateRT
  if SyncRegulationEnable >= 1 then
    
    if (pPLLSyncMeasureDataRD) then
      if (pPLLSyncMeasureDataRD^.us_StatusRegister AND _SYNCM_PLLLOCK_MASK) = _SYNCM_PLLLOCK then
      
        // ------------------------------------------------------------
        // Sync Measurment
        // ------------------------------------------------------------

#ifdef _SYNCM_DEBUG
        // Different Buscycles are not handled, d_DeltaPeriod is not used for any regulation => not imprtant.
        sSyncMeasurementData.d_Period_Master := (((pPLLSyncMeasureDataRD^.ud_Period_Master AND 16#FFFFFF00) SHR 8) * 10)$DINT + ((pPLLSyncMeasureDataRD^.ud_Period_Master AND 16#FF) * 10 / 256)$DINT;
        sSyncMeasurementData.d_Period_Own    := (((pPLLSyncMeasureDataRD^.ud_Period_Own    AND 16#FFFFFF00) SHR 8) * 10)$DINT + ((pPLLSyncMeasureDataRD^.ud_Period_Own    AND 16#FF) * 10 / 256)$DINT; 

        sSyncMeasurementData.d_DeltaPeriod := ((sSyncMeasurementData.d_Period_Master) - (sSyncMeasurementData.d_Period_Own));
        sSyncMeasurementData.d_DeltaPeriod := (((sSyncMeasurementData.d_DeltaPeriod) SHL 8))/ 10 + ((sSyncMeasurementData.d_DeltaPeriod mod 10) * 256/10);
#endif

        sSyncMeasurementData.i_DeltaPhase := pPLLSyncMeasureDataRD^.i_DeltaPhase;        
        
        // Check for Synchron 2
        //check if we are in sync with the master in case of allowed phase shift
        if (sSyncMeasurementData.i_DeltaPhase < AllowedPhaseShift) & (sSyncMeasurementData.i_DeltaPhase > (- AllowedPhaseShift)) then
          hs_SyncCheck := hs_SyncCheck OR 1;
        end_if;
        
      end_if;
      
    end_if;    
  end_if;
  
  // Check for Synchron 3
  // use if else so that server value is only set once per function call.
  if hs_SyncCheck = 16#FF then
    Synchron := 1;
  else
    Synchron := 0;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL _SyncMeasure::SyncRegulation
  VAR
    us_PropCount : USINT;
    aPllProperties  : ARRAY [0..3] OF PLL_PROPERTY_VALUE_PAIR;
    retcode : DINT;
  END_VAR
  
  // Call from updateRT  
  if SyncRegulationEnable >= 2 then
    // ------------------------------------------------------------
    // Sync Regulation
    // ------------------------------------------------------------
    
    // Enable Regulation if it is disabled
    us_PropCount := 0;
    if bDeltaRegulationEnabled = FALSE then
      bDeltaRegulationEnabled := TRUE;
      aPllProperties[us_PropCount].udPropertyId    := PLL_PROP_CONTROL_REGISTER;
      aPllProperties[us_PropCount].udPropertyValue := _SYNCM_PLL_DELTAREG_ENABLE; // enable delta regulation
      us_PropCount += 1;
    end_if;
    
    // Phase Regulation
    aPllProperties[us_PropCount].udPropertyId := PLL_PROP_DELTA_PHASE;

    aPllProperties[us_PropCount].udPropertyValue$DINT := to_dint(sSyncMeasurementData.i_DeltaPhase) / dSyncMultiplier;
    us_PropCount += 1;
          
    retcode := PLL_iSetPLLProperties(pPLL, hNodeHandle:=ud_CPUNodeHandle, udPropertyCount:=us_PropCount, psPropertyValuePairs:=#aPllProperties[0]);
    
    if retcode <> PLL_OK then
      SyncRegulationEnable := -1;
      biLogging.syncreg_setProp := TRUE;
    end_if;

    
  elsif bDeltaRegulationEnabled = TRUE then
    
    us_PropCount := 0;
    
    aPllProperties[us_PropCount].udPropertyId    := PLL_PROP_CONTROL_REGISTER;
    aPllProperties[us_PropCount].udPropertyValue := _SYNCM_PLL_DELTAREG_DISABLE; // disable delta regulation
    us_PropCount += 1;
    
    bDeltaRegulationEnabled := FALSE; 
    
    retcode := PLL_iSetPLLProperties(pPLL, hNodeHandle:=ud_CPUNodeHandle, udPropertyCount:=us_PropCount, psPropertyValuePairs:=#aPllProperties[0]);
    
    if retcode <> PLL_OK then
      SyncRegulationEnable := -1;
      biLogging.syncreg_disable := TRUE;
    end_if;
    
  end_if;
      
END_FUNCTION

FUNCTION VIRTUAL GLOBAL _SyncMeasure::CorrectPhase
VAR
	d_ShiftedPhase : DINT;
END_VAR
  
  if SyncRegulationEnable >= 0 then
  
    if pPLLSyncMeasureDataWR then
    
      // Read corrected phase from pll
      if PLL_iGetPLLProperty( pPLL
                            , hNodeHandle       := ud_CPUNodeHandle
                            , udPropertyId      := PLL_PROP_SHIFTED_PHASE
                            , pudPropertyValue  := (#d_ShiftedPhase)$^UDINT ) <> PLL_OK then        
        biLogging.correctPh_getphase := TRUE;
        SyncRegulationEnable := -1;
        return;
      end_if;
      
      // Write corrected phase 
      pPLLSyncMeasureDataWR^ := -(d_ShiftedPhase * dSyncMultiplier)$INT;
    
    end_if;
  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL _SyncMeasure::SyncRegulationEnable::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  if SyncRegulationEnable <> input then

    if ( (SyncRegulationEnable >= 0) & 
         (pPLLSyncMeasureDataRD) & 
         (pPLLSyncMeasureDataWR) )then
       
      if (input >= 2) then
        
        if (hs_MasterTimeCheck = 16#FF) &
           (hs_OwnTimeCheck    = 16#FF) then        
          
          SyncRegulationEnable := input;
          
          hs_SyncCheck := 0;
          //allowed phase shift for synchron data exchange is 0,7% shift from the slower system periode time
          if SystemTimeMaster > SystemTimeOwn then
            AllowedPhaseShift := SystemTimeMaster * 7 / 1000 / 10; // /10 => ns => 10ns
          else
            AllowedPhaseShift := SystemTimeOwn * 7 / 1000 / 10; // /10 => ns => 10ns
          end_if;
          
          dSyncMultiplier := SystemTimeOwn / dMainTimer;
          
        end_if;
        
      else
        SyncRegulationEnable := input;
      end_if;
        
    end_if; 
  end_if;
  
  result := SyncRegulationEnable;

END_FUNCTION

