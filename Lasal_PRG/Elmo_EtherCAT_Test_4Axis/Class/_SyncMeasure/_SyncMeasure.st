FUNCTION VIRTUAL GLOBAL _SyncMeasure::MeasurePeriodTimeMaster
	VAR_OUTPUT
		bMeasureDone 	: BOOL;
	END_VAR
  VAR
  	dPeriodMeasure : DINT;
  END_VAR
  
  bMeasureDone := FALSE;
  
  if pPLLSyncMeasureDataRD then
  
    if (pPLLSyncMeasureDataRD^.us_StatusRegister AND _SYNCM_PLLLOCK_MASK_MASTER) = _SYNCM_PLLLOCK_MASTER then
      
      dPeriodMeasure := (((pPLLSyncMeasureDataRD^.ud_Period_Master AND 16#FFFFFF00) SHR 8) * 10)$DINT + ((pPLLSyncMeasureDataRD^.ud_Period_Master AND 16#FF) * 10 / 256)$DINT;       
      
      // round to 50us
      dPeriodMeasure := ((dPeriodMeasure + _SYNCM_25US) / _SYNCM_50US) * _SYNCM_50US;
      
      hs_MasterTimeCheck := hs_MasterTimeCheck SHL 1;
      
      if SystemTimeMaster = dPeriodMeasure then
        /// Measurment Ok      
        // Set LSB
        hs_MasterTimeCheck := hs_MasterTimeCheck OR 1;
      else
        // LSB remains 0
        // Safe new Period Time 
        SystemTimeMaster := dPeriodMeasure;
      end_if;
      
      if hs_MasterTimeCheck = 16#FF then
        bMeasureDone := TRUE;
      end_if;

    else
      hs_MasterTimeCheck := 0;  // Reset on unlock
    end_if;

  end_if;
  
END_FUNCTION

FUNCTION VIRTUAL GLOBAL _SyncMeasure::MeasurePeriodTimeOwn
  VAR_OUTPUT
		bMeasureDone 	: BOOL;
	END_VAR
  VAR
  	dPeriodMeasure : DINT;
  END_VAR
  
  if pPLLSyncMeasureDataRD then
  
    if (pPLLSyncMeasureDataRD^.us_StatusRegister AND _SYNCM_PLLLOCK_MASK_OWN) = _SYNCM_PLLLOCK_OWN then
      
      dPeriodMeasure := (((pPLLSyncMeasureDataRD^.ud_Period_Own AND 16#FFFFFF00) SHR 8) * 10)$DINT + ((pPLLSyncMeasureDataRD^.ud_Period_Own AND 16#FF) * 10 / 256)$DINT;
      
      // round to 50us
      dPeriodMeasure := ((dPeriodMeasure + _SYNCM_25US) / _SYNCM_50US) * _SYNCM_50US;
                   
      hs_MasterTimeCheck := hs_MasterTimeCheck SHL 1;
      
      if SystemTimeOwn = dPeriodMeasure then
        // Measurment Ok      
        // Set LSB
        hs_MasterTimeCheck := hs_MasterTimeCheck OR 1;
      else
        // LSB remains 0
        // Safe new Period Time 
        SystemTimeOwn := dPeriodMeasure;
      end_if;
      
      if hs_MasterTimeCheck = 16#FF then
        bMeasureDone := TRUE;
      end_if;
      
    else
      hs_OwnTimeCheck := 0;  // Reset on unlock
    end_if;
    
  end_if;
  
END_FUNCTION

