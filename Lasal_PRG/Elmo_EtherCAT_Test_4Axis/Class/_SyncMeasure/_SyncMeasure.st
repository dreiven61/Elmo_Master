FUNCTION VIRTUAL GLOBAL _SyncMeasure::CyWork
	VAR_INPUT
		EAX 	: UDINT;
	END_VAR
	VAR_OUTPUT
		state (EAX) 	: UDINT;
	END_VAR
  
  state := READY;

  if biLogging.syncreg_setProp = TRUE & biLogging.syncreg_setProp_done = FALSE then
    LogError("@034E (_SyncMeasure::SyncRegulation) Failed to set sync regulation parameters");
    biLogging.syncreg_setProp_done := TRUE;
  end_if;
  
  if biLogging.syncreg_disable = TRUE & biLogging.syncreg_disable_done = FALSE then
    LogError("@034F (_SyncMeasure::SyncRegulation) Failed to disable sync regulation");
    biLogging.syncreg_disable_done := TRUE;
  end_if;
  
  if biLogging.correctPh_getphase = TRUE & biLogging.correctPh_getphase_done = FALSE then
    LogError("@0350 (_SyncMeasure::CorrectPhase) Failed reading back the PLL phase shift");    
    biLogging.correctPh_getphase_done := TRUE;
  end_if;

END_FUNCTION



