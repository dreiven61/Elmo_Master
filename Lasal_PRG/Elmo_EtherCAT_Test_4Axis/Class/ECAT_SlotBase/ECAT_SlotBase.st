  end_if;
  
  if UseSlotIndexInc then
    hIndex := hIndex + (Slot$HINT * SlotIndexInc$HINT);
  end_if;
    
  _Para.uiCmd           := ECAT_M_START_SDO;
  _Para.aPara[0]        := 1;               // : Command Version : 1
  _Para.aPara[1]        := 1;               // : Read: 0, Write : 1
  _Para.aPara[2]$HDINT  := hIndex;          // : hIndex
  _Para.aPara[3]$HDINT  := hsSubIndex;      // : hsSubIndex
  _Para.aPara[4]        := dCompleteAccess; // : dCompleteAccess
  _Para.aPara[5]$pVoid  := pWriteData;      // : pReadWriteData
  _Para.aPara[6]$UDINT  := udWriteLength;   // : udReadWriteLength
  _Para.aPara[7]$UDINT  := udTimeout;       // : udTimeout
  _Para.aPara[8]$pVoid  := pCallback;       // : callback this pointer
  
  retcode := ECATSlotIn.NewInst(#_Para, #_Result);
  
END_FUNCTION

