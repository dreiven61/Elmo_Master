FUNCTION ECAT_SlotBase::CyclicSDOHandling
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR

  retcode := BUSY;
    
  case sSDOData.eResponseState of

    //*****************************************************
    _idle:
        retcode := READY;
        
    //*****************************************************
    _wait:
        // wait for response
        if ((ops.tAbsolute - sSDOData.udTimeStamp) > (sSDOData.udTimeout + 50)) then  // Add 50ms because OS Code use the same Timeout
          LogValue(pString:="@093B (SDIASEC_Slave_Base::CyclicSDOHandling) SDO Response timeout after 0x{0}ms", Value:=sSDOData.udTimeout + 50);
          sSDOData.eResponseState:= _idle;
          retcode := ERROR;
        end_if;
    
    //*****************************************************
    _valid:
        
        sSDOData.eResponseState:= _idle;
        retcode := ERROR;
        if (sSDOData.udErrorCode = ECATM_OK) & (sSDOData.sd_retval = 0) then
          retcode := READY;
        end_if;
        
  end_case;

END_FUNCTION

