FUNCTION __CDECL VIRTUAL GLOBAL ECAT_SlotBase::MapPDODataRd
	VAR_INPUT
		pThis 	: pVirtualBase;
		p_cycctx 	: ^t_st_ecatm_cycctx;
		noData 	: DINT;
		iovar 	: ^t_st_eceni_iovar;
