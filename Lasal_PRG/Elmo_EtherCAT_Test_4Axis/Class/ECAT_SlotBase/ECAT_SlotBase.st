FUNCTION ECAT_SlotBase::AddPDOEntry
	VAR_INPUT
		bPrescanOrPostScan 	: BOOL;
		pServerData 	: pVoid;
		hIndex 	: HINT;
		hsSubIndex 	: HSINT;
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  VAR
  	pListHelp : ^t_s_PDOList;
  END_VAR

  if UseSlotIndexInc then
    hIndex := hIndex + (Slot$HINT * SlotIndexInc$HINT);
  end_if;

  //Check if we already have a PDO or not
  if pPDOList = NIL then
  
    //Allocate memory for first entry in PDO List
    pPDOList$pVoid := toStdLib.Malloc(size:=sizeof(t_s_PDOList));
    
    pListHelp := pPDOList;
    
    if pListHelp then
    
      //Save PDO Data
      pListHelp^.pNext := NIL;
      pListHelp^.pSvrDataPointer := pServerData$^DINT;
      pListHelp^.hIndex := hIndex;
      pListHelp^.hsSubIndex  := hsSubIndex;
      pListHelp^.bPreScanOrPostScan := bPrescanOrPostScan;
      
      //Remember how many PDOs we have to install callback later
      if bPrescanOrPostScan then
        sPostScanData.udPDOCount += 1;
      else
        sPreScanData.udPDOCount += 1;
      end_if;
      
      retcode := 0;
      
    else
      // failed to allocate memory
      retcode := -1;
      LogValue("@0597 (ECAT_SlotBase::AddPDOEntry) Failed to allocate memory for PDO List for Slot 0x{0}!", Slot$UDINT);
      return;
    end_if;

  else
  
    pListHelp := pPDOList;
    
    //Go to next free entry in PDO List
    while (pListHelp^.pNext <> NIL) do
      pListHelp := pListHelp^.pNext;
    end_while;
    
    //Allocate memory for entry in PDO List
    pListHelp^.pNext$pVoid := toStdLib.Malloc(size:=sizeof(t_s_PDOList));
    pListHelp := pListHelp^.pNext;
    
    if pListHelp then

      //Save PDO Data
      pListHelp^.pNext := NIL;
      pListHelp^.pSvrDataPointer := pServerData$^DINT;
      pListHelp^.hIndex := hIndex;
      pListHelp^.hsSubIndex  := hsSubIndex;
      pListHelp^.bPreScanOrPostScan := bPrescanOrPostScan;
      
      //Remember how many PDOs we have to install callback later
      if bPrescanOrPostScan then
        sPostScanData.udPDOCount += 1;
      else
        sPreScanData.udPDOCount += 1;
      end_if;
    
      retcode := 0;
      
    else
      // failed to allocate memory
      retcode := -1;
      LogValue("@0597 (ECAT_SlotBase::AddPDOEntry) Failed to allocate memory for PDO List for Slot 0x{0}!", Slot$UDINT);
      return;
    end_if;
  end_if;

END_FUNCTION

FUNCTION ECAT_SlotBase::GetIOVarByPdo
	VAR_INPUT
		hIndex 	: HINT;
		hsSubIndex 	: HSINT;
		pIOVar 	: ^t_st_eceni_iovar;
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  
  if pIOVar = NIL then
    retcode := -1;
    return;
  end_if;
  
  retcode := OS_ECATM_IOVAR_GETBYPDO(pECAT,ecatmhdl,ECATSlotMngSlaveIndex,hIndex,hsSubIndex,pIOVar);

END_FUNCTION

FUNCTION ECAT_SlotBase::SetPDOCallbackFunctions
	VAR_INPUT
		pPreScanFunc 	: pVoid;
		pPostScanFunc 	: pVoid;
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  
  retcode := -1;

  //At least one pointer has to be valid
  if pPreScanFunc | pPostScanFunc then
  
    sPreScanData.pCallbackFunc  := pPreScanFunc;
    sPostScanData.pCallbackFunc := pPostScanFunc;

    bCallBackFunctionSet := TRUE;
    retcode := 0;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_SlotBase::SetPDOSettings
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR

  retcode := SetPDOCallbackFunctions(pPreScanFunc:=#ECAT_SB_MapPDODataRd_C(), pPostScanFunc:=#ECAT_SB_MapPDODataWr_C());
  
END_FUNCTION

