	END_VAR
	VAR_OUTPUT
		retcode 	: iprStates;
	END_VAR
  VAR
    _Para       : CmdStruct;  
    _Result     : Results;
  END_VAR
  
  retcode := ERROR;
  
  if (ClassState <> _ClassOk) & (ClassState <> _NotInitialized) then
    return;
