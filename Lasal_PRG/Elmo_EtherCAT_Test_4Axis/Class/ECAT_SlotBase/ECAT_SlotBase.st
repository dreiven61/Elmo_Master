FUNCTION VIRTUAL GLOBAL ECAT_SlotBase::GetPointer2ObjectPath
	VAR_INPUT
		pThisPointerOverride 	: pVirtualBase;
	END_VAR
	VAR_OUTPUT
		p_us_ObjectPath 	: ^USINT;
	END_VAR
  VAR
  	MyPara   : CmdStruct;
    MyResult : results;
    p_us_PreviousPath : ^USINT;
  END_VAR

  if ( pObjectPath = NIL ) then
    
    if Slot <= ECAT_SLOT_MAXSLOTNO then
    
      MyPara.aPara[0]$DINT := 2; //Version of command
      
      MyPara.uiCmd := ECAT_M_GET_HW_PATH;
      if ECATSlotIn.NewInst(#MyPara, #MyResult) <> READY then
        if bd_SingleLog.GetHwPathFailed = FALSE then
          bd_SingleLog.GetHwPathFailed := TRUE;
          LogError("@05A4 (ECAT_SlotBase::GetPointer2ObjectPath) [SL] Failed to get hardware path of preceding module");
        end_if;
      else
        p_us_PreviousPath := MyResult.aData[8]$^USINT;

        if Slot < HWT_ESCAPE_SEQU then
          // Slot does not interfere with HWT_ESCAPE_SEQU
          
          //alloc memory
          pObjectPath := ( ToStdLib.Malloc( size := p_us_PreviousPath^ + 1 + 2 ) )$^USINT;   // + 1 Length HWPath, + 2 (EscSeq + SlotNo)
          
          // Length of HW-Path is 1 Byte and does not include length itself
          ToStdLib.MemCpy ( dest   := pObjectPath
                          , source := p_us_PreviousPath
                          , size   := p_us_PreviousPath^ + 1  // Include length in memcpy
                          );

          // increase length
          pObjectPath^ += 2; //1 Byte Escape sequence + 1 Byte Slot No
          
          //insert escape sequence for EtherCAT
          ( pObjectPath + pObjectPath^ - 1)^$USINT := HWT_ESCAPE_ECAT_SLOT;

          //insert EtherCAT Slave slot
          ( pObjectPath + pObjectPath^ + 0)^$USINT := Slot$USINT;
        else
          // Slot overlaps with HWT_ESCAPE_SEQU, split slot into 3 Bytes

          //alloc memory
          pObjectPath := ( ToStdLib.Malloc( size := p_us_PreviousPath^ + 1 + 1 + 3) )$^USINT;   // + 1 Length HWPath, + 1 EscSeq + 3 SlotNo
          
          // Length of HW-Path is 1 Byte and does not include length itself
          ToStdLib.MemCpy ( dest   := pObjectPath
                          , source := p_us_PreviousPath
                          , size   := p_us_PreviousPath^ + 1  // Include length in memcpy
                          );

          // increase length
          pObjectPath^ += 4; //1 Byte Escape sequence + 3 Byte Slot No
          
          //insert escape sequence for EtherCAT
          ( pObjectPath + pObjectPath^ - 3)^$USINT := HWT_ESCAPE_ECAT_SLOT;

          //insert EtherCAT Slave slot
          ( pObjectPath + pObjectPath^ - 2)^$USINT := 0xFF$HSINT;
          ( pObjectPath + pObjectPath^ - 1)^$USINT := (Slot SHR 7)$HSINT;
          ( pObjectPath + pObjectPath^ + 0)^$USINT := (Slot AND 0x7F)$HSINT;
        
        end_if;

        if pThisPointerOverride then
          //register object path in OS
          SetObjectThisp(pObjectPath:=pObjectPath, pthis:=pThisPointerOverride$UDINT);
        else
          //register object path in OS
          SetObjectThisp(pObjectPath:=pObjectPath, pthis:=this$UDINT);
        end_if;
        
      end_if;
    else    
      p_us_ObjectPath := NIL;
    end_if;
    
  end_if;
  
  p_us_ObjectPath := pObjectPath;

END_FUNCTION


