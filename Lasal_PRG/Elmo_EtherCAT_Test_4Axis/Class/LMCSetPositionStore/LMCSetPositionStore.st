			end_if;
		elsif RecordState = 3 then
			if (AppliedPosition = 0) &
			   (OriginalCommandStatus = 1) then
				if (OriginalDetailCode = 11) &
				   (OriginalErrorId = -6) &
				   (NativeCommandState <> 0) then
					payloadValid := TRUE;
				elsif (OriginalDetailCode >= 10) &
				      (OriginalDetailCode <= 15) &
				      (OriginalDetailCode <> 11) &
				      (OriginalErrorId = -31000) &
				      (NativeCommandState = 0) then
					payloadValid := TRUE;
				end_if;
			end_if;
		end_if;
		if payloadValid = FALSE then
			continueCommit := FALSE;
		end_if;
	end_if;

	// Build and commit one exact terminal image from the frozen key.
	if continueCommit then
		_memset(dest:=#terminalWords[0], usByte:=0, cntr:=84);
		pTerminal := (#terminalWords[0])$^USINT;
		pTerminal^$UINT := pFrozenKey^$UINT;
		(pTerminal + 4)^$UDINT := frozenTerminalStoreGeneration;
		(pTerminal + 8)^$UINT := RecordState;
		_memcpy(ptr1:=pTerminal + 10,
		        ptr2:=pFrozenKey + 2, cntr:=46);
		(pTerminal + 56)^$DINT := AppliedPosition;
		(pTerminal + 60)^$UINT := OriginalCommandStatus;
		(pTerminal + 62)^$INT := OriginalErrorId;
		(pTerminal + 64)^$UDINT := OriginalDetailCode;
		(pTerminal + 68)^$UDINT := NativeCommandState;
		(pTerminal + 72)^$UDINT := frozenRecordGeneration;
		if IsClientConnected(#CheckSum) = 0 then
			continueCommit := FALSE;
		else
			(pTerminal + 76)^$UDINT :=
				CheckSum.CRC32(pTerminal, 76, 0);
			(pTerminal + 80)^$UDINT := 16#7D12C0DE;
		end_if;
	end_if;

	if continueCommit then
		commitResult := CommitRecord(
			AxisReference:=frozenAxisReference,
			Slot:=frozenTargetSlot,
			pImage:=pTerminal);
		if commitResult = 1 then
			_memcpy(ptr1:=pSnapshot, ptr2:=pTarget + 8, cntr:=68);
			pDetailCode^ := 0;
			Result := 1;
		end_if;
	end_if;

	// Common active-transaction cleanup preserves the fence until completion.
	TransactionActive := FALSE;
	TransactionAxisReference := 0;
	TransactionIntentStoreGeneration := 0;
	TransactionRecordGeneration := 0;
	TransactionTerminalTargetSlot := 0;
	TransactionReservedTerminalTargetSlot := 0;
	TransactionTerminalStoreGeneration := 0;
	TransactionReservedTerminalStoreGeneration := 0;
	_memset(dest:=#TransactionKeyWords[0], usByte:=0, cntr:=48);
	_memset(dest:=#TransactionTerminalTargetBeforeWords[0],
	        usByte:=0, cntr:=84);

END_FUNCTION


FUNCTION GLOBAL LMCSetPositionStore::ReadSetPositionOutcome
	VAR_INPUT
		pKey 	: ^void;
		KeySize 	: UDINT;
		pSnapshot 	: ^void;
		SnapshotCapacity 	: UDINT;
		pDetailCode 	: ^UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		classifications : ARRAY [0..3] OF USINT;
		pKeyBytes 	: ^USINT;
		pRecord 	: ^USINT;
		axisBaseWord 	: UDINT;
		recordBaseWord 	: UDINT;
		maxStoreGeneration 	: UDINT;
		maxRecordGeneration 	: UDINT;
		bestTerminalStoreGeneration 	: UDINT;
		axisReference 	: UINT;
		slot 	: DINT;
		bestTerminalSlot 	: DINT;
		scanResult 	: DINT;
		hasValidRecord 	: BOOL;
	END_VAR

	// Validate and initialize the read-only query boundary.
	Result := -1;
	if pDetailCode <> NIL then
		pDetailCode^ := 0;
	end_if;
	if (pSnapshot <> NIL) & (SnapshotCapacity >= 68) then
		_memset(dest:=pSnapshot, usByte:=0, cntr:=68);
	end_if;
	if (pKey = NIL) | (KeySize <> 48) |
	   (pSnapshot = NIL) | (pDetailCode = NIL) then
		RETURN;
	end_if;

	pKeyBytes := pKey$^USINT;
	axisReference := (pKeyBytes + 36)^$UINT;
	if (pKeyBytes^$UINT <> 1) |
	   ((pKeyBytes + 2)^$UINT <> 1) |
	   ((pKeyBytes + 4)^$UDINT = 0) |
	   ((pKeyBytes + 8)^$UDINT = 0) |
	   ((pKeyBytes + 12)^$UDINT = 0) |
	   ((pKeyBytes + 16)^$UDINT = 0) |
	   (((pKeyBytes + 20)^$UDINT = 0) &
	    ((pKeyBytes + 24)^$UDINT = 0) &
	    ((pKeyBytes + 28)^$UDINT = 0) &
	    ((pKeyBytes + 32)^$UDINT = 0)) |
	   (axisReference < 1) | (axisReference > 4) |
	   ((pKeyBytes + 38)^$UINT <> 0) then
		RETURN;
	end_if;

	Result := 0;
	pDetailCode^ := 24;
	if TransactionActive &
	   (TransactionAxisReference = axisReference) then
		RETURN;
	end_if;
	if SnapshotCapacity < 68 then
		RETURN;
	end_if;

	// Classify this axis once; all remaining work is read-only.
	scanResult := ScanAxisStore(
		AxisReference:=axisReference,
		pClassifications:=#classifications[0],
		pMaxStoreGeneration:=#maxStoreGeneration,
		pMaxRecordGeneration:=#maxRecordGeneration);
	if scanResult < 0 then
		RETURN;
	elsif scanResult = 0 then
		pDetailCode^ := 21;
		RETURN;
	end_if;

	axisBaseWord := (TO_UDINT(axisReference) - 1) * 84;
	hasValidRecord := FALSE;
	bestTerminalSlot := -1;
	bestTerminalStoreGeneration := 0;
	for slot := 0 to 3 do
		if classifications[slot] = 2 then
			hasValidRecord := TRUE;
			recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
			pRecord := (#g_LMCSetPositionStoreWords[
				TO_DINT(recordBaseWord)])$^USINT;
			if (slot >= 1) &
			   (((pRecord + 8)^$UINT = 2) |
			    ((pRecord + 8)^$UINT = 3)) &
			   (RecordMatchesKey(pRecord:=pRecord, pKey:=pKey) = 1) then
				if (bestTerminalSlot < 0) |
				   ((pRecord + 4)^$UDINT >
				    bestTerminalStoreGeneration) then
					bestTerminalSlot := slot;
					bestTerminalStoreGeneration :=
						(pRecord + 4)^$UDINT;
				end_if;
			end_if;
		end_if;
	end_for;

	// The newest exact terminal or tombstone wins the query.
	if bestTerminalSlot >= 1 then
		recordBaseWord := axisBaseWord +
			TO_UDINT(bestTerminalSlot * 21);
		pRecord := (#g_LMCSetPositionStoreWords[
			TO_DINT(recordBaseWord)])$^USINT;
		_memcpy(ptr1:=pSnapshot, ptr2:=pRecord + 8, cntr:=68);
		pDetailCode^ := 0;
		Result := 1;
		RETURN;
	end_if;

	// Only an exact Armed record is indeterminate.
	if classifications[0] = 2 then
		pRecord := (#g_LMCSetPositionStoreWords[
			TO_DINT(axisBaseWord)])$^USINT;
		if ((pRecord + 8)^$UINT = 1) &
		   (RecordMatchesKey(pRecord:=pRecord, pKey:=pKey) = 1) then
			pDetailCode^ := 20;
			RETURN;
		end_if;
	end_if;

	if hasValidRecord then
		pDetailCode^ := 22;
	else
		pDetailCode^ := 19;
	end_if;

END_FUNCTION


FUNCTION GLOBAL LMCSetPositionStore::RetireSetPositionOutcome
	VAR_INPUT
		pKey 	: ^void;
		KeySize 	: UDINT;
		ExpectedRecordGeneration 	: UDINT;
		pSnapshot 	: ^void;
		SnapshotCapacity 	: UDINT;
		pDetailCode 	: ^UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		classifications : ARRAY [0..3] OF USINT;
		rescanClassifications : ARRAY [0..3] OF USINT;
		frozenSourceWords : ARRAY [0..20] OF UDINT;
		tombstoneWords : ARRAY [0..20] OF UDINT;
		pKeyBytes 	: ^USINT;
		pRecord 	: ^USINT;
		pSource 	: ^USINT;
		pFrozenSource 	: ^USINT;
		pTombstone 	: ^USINT;
		pTarget 	: ^USINT;
		axisBaseWord 	: UDINT;
		recordBaseWord 	: UDINT;
		sourceBaseWord 	: UDINT;
		targetBaseWord 	: UDINT;
		maxStoreGeneration 	: UDINT;
		maxRecordGeneration 	: UDINT;
		rescanMaxStoreGeneration 	: UDINT;
		rescanMaxRecordGeneration 	: UDINT;
		nextStoreGeneration 	: UDINT;
		bestTerminalStoreGeneration 	: UDINT;
		axisReference 	: UINT;
		slot 	: DINT;
		bestTerminalSlot 	: DINT;
		sourceSlot 	: DINT;
		targetSlot 	: DINT;
		scanResult 	: DINT;
		commitResult 	: DINT;
		rescanResult 	: DINT;
		hasValidRecord 	: BOOL;
	END_VAR

	// Validate and initialize every output before any retained operation.
	Result := -1;
	if pDetailCode <> NIL then
		pDetailCode^ := 0;
	end_if;
	if (pSnapshot <> NIL) & (SnapshotCapacity >= 68) then
		_memset(dest:=pSnapshot, usByte:=0, cntr:=68);
	end_if;
	if (pKey = NIL) | (KeySize <> 48) |
	   (ExpectedRecordGeneration = 0) |
	   (pSnapshot = NIL) | (pDetailCode = NIL) then
		RETURN;
	end_if;

	pKeyBytes := pKey$^USINT;
	axisReference := (pKeyBytes + 36)^$UINT;
	if (pKeyBytes^$UINT <> 1) |
	   ((pKeyBytes + 2)^$UINT <> 1) |
	   ((pKeyBytes + 4)^$UDINT = 0) |
	   ((pKeyBytes + 8)^$UDINT = 0) |
	   ((pKeyBytes + 12)^$UDINT = 0) |
	   ((pKeyBytes + 16)^$UDINT = 0) |
	   (((pKeyBytes + 20)^$UDINT = 0) &
	    ((pKeyBytes + 24)^$UDINT = 0) &
	    ((pKeyBytes + 28)^$UDINT = 0) &
	    ((pKeyBytes + 32)^$UDINT = 0)) |
	   (axisReference < 1) | (axisReference > 4) |
	   ((pKeyBytes + 38)^$UINT <> 0) then
		RETURN;
	end_if;

	Result := 0;
	pDetailCode^ := 24;
	if TransactionActive &
	   (TransactionAxisReference = axisReference) then
		RETURN;
	end_if;
	if SnapshotCapacity < 68 then
		RETURN;
	end_if;

	// Establish the query winner and generation frontier with one scan.
	scanResult := ScanAxisStore(
		AxisReference:=axisReference,
		pClassifications:=#classifications[0],
		pMaxStoreGeneration:=#maxStoreGeneration,
		pMaxRecordGeneration:=#maxRecordGeneration);
	if scanResult < 0 then
		RETURN;
	elsif scanResult = 0 then
		pDetailCode^ := 21;
		RETURN;
	end_if;

	axisBaseWord := (TO_UDINT(axisReference) - 1) * 84;
	hasValidRecord := FALSE;
	bestTerminalSlot := -1;
	bestTerminalStoreGeneration := 0;
	for slot := 0 to 3 do
		if classifications[slot] = 2 then
			hasValidRecord := TRUE;
			recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
			pRecord := (#g_LMCSetPositionStoreWords[
				TO_DINT(recordBaseWord)])$^USINT;
			if (slot >= 1) &
			   (((pRecord + 8)^$UINT = 2) |
			    ((pRecord + 8)^$UINT = 3)) &
			   (RecordMatchesKey(pRecord:=pRecord, pKey:=pKey) = 1) then
				if (bestTerminalSlot < 0) |
				   ((pRecord + 4)^$UDINT >
				    bestTerminalStoreGeneration) then
					bestTerminalSlot := slot;
					bestTerminalStoreGeneration :=
						(pRecord + 4)^$UDINT;
				end_if;
			end_if;
		end_if;
	end_for;

	if bestTerminalSlot < 1 then
		if classifications[0] = 2 then
			pRecord := (#g_LMCSetPositionStoreWords[
				TO_DINT(axisBaseWord)])$^USINT;
			if ((pRecord + 8)^$UINT = 1) &
			   (RecordMatchesKey(pRecord:=pRecord, pKey:=pKey) = 1) then
				pDetailCode^ := 20;
				RETURN;
			end_if;
		end_if;
		if hasValidRecord then
			pDetailCode^ := 22;
		else
			pDetailCode^ := 19;
		end_if;
		RETURN;
	end_if;

	// Apply the exact RecordGeneration CAS before duplicate retirement.
	sourceSlot := bestTerminalSlot;
	sourceBaseWord := axisBaseWord + TO_UDINT(sourceSlot * 21);
	pSource := (#g_LMCSetPositionStoreWords[
		TO_DINT(sourceBaseWord)])$^USINT;
	if (pSource + 72)^$UDINT <> ExpectedRecordGeneration then
		pDetailCode^ := 22;
		RETURN;
	end_if;
	if (pSource + 2)^$UINT = 1 then
		_memcpy(ptr1:=pSnapshot, ptr2:=pSource + 8, cntr:=68);
		pDetailCode^ := 0;
		Result := 1;
		RETURN;
	end_if;

	// Freeze the exact active terminal before selecting another physical bank.
	_memcpy(ptr1:=#frozenSourceWords[0], ptr2:=pSource, cntr:=84);
	pFrozenSource := (#frozenSourceWords[0])$^USINT;
	if maxStoreGeneration = 16#FFFFFFFF then
		RETURN;
	end_if;
	nextStoreGeneration := maxStoreGeneration + 1;

	targetSlot := SelectTerminalSlot(
		AxisReference:=axisReference,
		ExcludedSlot:=TO_INT(sourceSlot),
		pClassifications:=#classifications[0]);
	if (targetSlot < 1) | (targetSlot > 3) then
		if IsClientConnected(#CheckSum) <> 0 then
			pDetailCode^ := 21;
		end_if;
		RETURN;
	end_if;

	// Preserve bytes 8..75 and publish only a newer tombstone identity.
	_memcpy(ptr1:=#tombstoneWords[0],
	        ptr2:=#frozenSourceWords[0], cntr:=84);
	pTombstone := (#tombstoneWords[0])$^USINT;
	(pTombstone + 2)^$UINT := 1;
	(pTombstone + 4)^$UDINT := nextStoreGeneration;
	if IsClientConnected(#CheckSum) = 0 then
		RETURN;
	end_if;
	(pTombstone + 76)^$UDINT := CheckSum.CRC32(pTombstone, 76, 0);
	(pTombstone + 80)^$UDINT := 16#7D12C0DE;

	targetBaseWord := axisBaseWord + TO_UDINT(targetSlot * 21);
	pTarget := (#g_LMCSetPositionStoreWords[
		TO_DINT(targetBaseWord)])$^USINT;
	commitResult := CommitRecord(
		AxisReference:=axisReference,
		Slot:=TO_UINT(targetSlot),
		pImage:=pTombstone);
	if commitResult = 1 then
		_memcpy(ptr1:=pSnapshot, ptr2:=pTarget + 8, cntr:=68);
		pDetailCode^ := 0;
		Result := 1;
		RETURN;
	end_if;

	// CommitRecord may already have mutated the marker; close by fresh proof.
	rescanResult := ScanAxisStore(
		AxisReference:=axisReference,
		pClassifications:=#rescanClassifications[0],
		pMaxStoreGeneration:=#rescanMaxStoreGeneration,
		pMaxRecordGeneration:=#rescanMaxRecordGeneration);
	if rescanResult < 0 then
		RETURN;
	elsif rescanResult = 0 then
		pDetailCode^ := 21;
		RETURN;
	end_if;

	if rescanClassifications[targetSlot] = 2 then
		pTarget := (#g_LMCSetPositionStoreWords[
			TO_DINT(targetBaseWord)])$^USINT;
		if _memcmp(ptr1:=pTarget, ptr2:=pTombstone, cntr:=84) = 0 then
			_memcpy(ptr1:=pSnapshot, ptr2:=pTarget + 8, cntr:=68);
			pDetailCode^ := 0;
			Result := 1;
			RETURN;
		end_if;
	end_if;

	if rescanClassifications[sourceSlot] = 2 then
		pSource := (#g_LMCSetPositionStoreWords[
			TO_DINT(sourceBaseWord)])$^USINT;
		if _memcmp(
			ptr1:=pSource, ptr2:=pFrozenSource, cntr:=84) = 0 then
			RETURN;
		end_if;
	end_if;
	pDetailCode^ := 21;

END_FUNCTION


FUNCTION LMCSetPositionStore::ScanAxisStore
	VAR_INPUT
		AxisReference 	: UINT;
		pClassifications 	: ^USINT;
		pMaxStoreGeneration 	: ^UDINT;
		pMaxRecordGeneration 	: ^UDINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		axisBaseWord 	: UDINT;
		recordBaseWord 	: UDINT;
		leftBaseWord 	: UDINT;
		rightBaseWord 	: UDINT;
		slot 	: DINT;
		wordIndex 	: DINT;
		leftSlot 	: DINT;
		rightSlot 	: DINT;
		candidateSlot 	: DINT;
		pRecord 	: ^USINT;
		pLeft 	: ^USINT;
		pRight 	: ^USINT;
		pCandidate 	: ^USINT;
		slotClass : ARRAY [0..3] OF USINT;
		retiredShadow : ARRAY [0..3] OF BOOL;
		anyNonzero 	: BOOL;
		validSlot 	: BOOL;
		hasCorrupt 	: BOOL;
		leftTerminal 	: BOOL;
		rightTerminal 	: BOOL;
		leftTombstone 	: BOOL;
		rightTombstone 	: BOOL;
		candidateTombstone 	: BOOL;
		sameKey 	: BOOL;
		sameSnapshot 	: BOOL;
		matchingKey 	: BOOL;
		matchingSnapshot 	: BOOL;
		storeGeneration 	: UDINT;
		recordGeneration 	: UDINT;
		computedCrc 	: UDINT;
		marker 	: UDINT;
		storeFlags 	: UINT;
		recordState 	: UINT;
		unsupersededTerminalCount 	: UINT;
		matchingLowerArmedCount 	: UINT;
	END_VAR

	// Read-only classification and cross-record consistency scan.
	Result := -1;
	if pClassifications <> NIL then
		_memset(dest:=pClassifications, usByte:=0, cntr:=4);
	end_if;
	if pMaxStoreGeneration <> NIL then
		pMaxStoreGeneration^ := 0;
	end_if;
	if pMaxRecordGeneration <> NIL then
		pMaxRecordGeneration^ := 0;
	end_if;

	if (AxisReference >= 1) & (AxisReference <= 4) &
	   (pClassifications <> NIL) &
	   (pMaxStoreGeneration <> NIL) &
	   (pMaxRecordGeneration <> NIL) &
	   (IsClientConnected(#CheckSum) <> 0) then
		axisBaseWord := (TO_UDINT(AxisReference) - 1) * 84;
		hasCorrupt := FALSE;
		unsupersededTerminalCount := 0;

		for slot := 0 to 3 do
			slotClass[slot] := 0;
			retiredShadow[slot] := FALSE;
			recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
			pRecord := (#g_LMCSetPositionStoreWords[TO_DINT(recordBaseWord)])$^USINT;
			anyNonzero := FALSE;
			for wordIndex := 0 to 20 do
				if g_LMCSetPositionStoreWords[
					TO_DINT(recordBaseWord) + wordIndex] <> 0 then
					anyNonzero := TRUE;
				end_if;
			end_for;

			marker := (pRecord + 80)^$UDINT;
			if anyNonzero = FALSE then
				slotClass[slot] := 0;
			elsif marker = 0 then
				slotClass[slot] := 1;
			elsif marker <> 16#7D12C0DE then
				slotClass[slot] := 3;
				hasCorrupt := TRUE;
			else
				validSlot := TRUE;
				computedCrc := CheckSum.CRC32(pRecord, 76, 0);
				storeFlags := (pRecord + 2)^$UINT;
				recordState := (pRecord + 8)^$UINT;

				if computedCrc <> (pRecord + 76)^$UDINT then
					validSlot := FALSE;
				elsif pRecord^$UINT <> 1 then
					validSlot := FALSE;
				elsif (storeFlags <> 0) & (storeFlags <> 1) then
					validSlot := FALSE;
				elsif (pRecord + 4)^$UDINT = 0 then
					validSlot := FALSE;
				elsif (recordState <> 1) &
				      (recordState <> 2) &
				      (recordState <> 3) then
					validSlot := FALSE;
				elsif (pRecord + 10)^$UINT <> 1 then
					validSlot := FALSE;
				elsif ((pRecord + 12)^$UDINT = 0) |
				      ((pRecord + 16)^$UDINT = 0) |
				      ((pRecord + 20)^$UDINT = 0) |
				      ((pRecord + 24)^$UDINT = 0) then
					validSlot := FALSE;
				elsif ((pRecord + 28)^$UDINT = 0) &
				      ((pRecord + 32)^$UDINT = 0) &
				      ((pRecord + 36)^$UDINT = 0) &
				      ((pRecord + 40)^$UDINT = 0) then
					validSlot := FALSE;
				elsif (pRecord + 44)^$UINT <> AxisReference then
					validSlot := FALSE;
				elsif (pRecord + 46)^$UINT <> 0 then
					validSlot := FALSE;
				elsif (pRecord + 72)^$UDINT = 0 then
					validSlot := FALSE;
				elsif (slot = 0) &
				      ((recordState <> 1) | (storeFlags <> 0)) then
					validSlot := FALSE;
				elsif (slot <> 0) &
				      (recordState <> 2) & (recordState <> 3) then
					validSlot := FALSE;
				elsif (recordState = 1) &
				      (((pRecord + 56)^$DINT <> 0) |
				       ((pRecord + 60)^$UINT <> 0) |
				       ((pRecord + 62)^$INT <> 0) |
				       ((pRecord + 64)^$UDINT <> 0) |
				       ((pRecord + 68)^$UDINT <> 0)) then
					validSlot := FALSE;
				elsif (recordState = 2) &
				      (((pRecord + 56)^$DINT <> (pRecord + 48)^$DINT) |
				       ((pRecord + 60)^$UINT <> 0) |
				       ((pRecord + 62)^$INT <> 0) |
				       ((pRecord + 64)^$UDINT <> 0) |
				       ((pRecord + 68)^$UDINT <> 0)) then
					validSlot := FALSE;
				elsif (recordState = 3) &
				      (((pRecord + 56)^$DINT <> 0) |
				       ((pRecord + 60)^$UINT <> 1) |
				       ((pRecord + 64)^$UDINT < 10) |
				       ((pRecord + 64)^$UDINT > 15)) then
					validSlot := FALSE;
				elsif (recordState = 3) &
				      ((pRecord + 64)^$UDINT = 11) &
				      (((pRecord + 62)^$INT <> -6) |
				       ((pRecord + 68)^$UDINT = 0)) then
					validSlot := FALSE;
				elsif (recordState = 3) &
				      ((pRecord + 64)^$UDINT <> 11) &
				      (((pRecord + 62)^$INT <> -31000) |
				       ((pRecord + 68)^$UDINT <> 0)) then
					validSlot := FALSE;
				end_if;

				if validSlot then
					slotClass[slot] := 2;
					storeGeneration := (pRecord + 4)^$UDINT;
					recordGeneration := (pRecord + 72)^$UDINT;
					if storeGeneration > pMaxStoreGeneration^ then
						pMaxStoreGeneration^ := storeGeneration;
					end_if;
					if recordGeneration > pMaxRecordGeneration^ then
						pMaxRecordGeneration^ := recordGeneration;
					end_if;
				else
					slotClass[slot] := 3;
					hasCorrupt := TRUE;
				end_if;
			end_if;
			(pClassifications + slot)^ := slotClass[slot];
		end_for;

		// Pairwise generation, key, snapshot, and ordering invariants.
		for leftSlot := 0 to 2 do
			if slotClass[leftSlot] = 2 then
				leftBaseWord := axisBaseWord + TO_UDINT(leftSlot * 21);
				pLeft := (#g_LMCSetPositionStoreWords[TO_DINT(leftBaseWord)])$^USINT;
				for rightSlot := leftSlot + 1 to 3 do
					if slotClass[rightSlot] = 2 then
						rightBaseWord := axisBaseWord + TO_UDINT(rightSlot * 21);
						pRight := (#g_LMCSetPositionStoreWords[
							TO_DINT(rightBaseWord)])$^USINT;
						sameKey :=
							(_memcmp(ptr1:=pLeft, ptr2:=pRight, cntr:=2) = 0) &
							(_memcmp(ptr1:=pLeft + 10,
							         ptr2:=pRight + 10, cntr:=2) = 0) &
							(_memcmp(ptr1:=pLeft + 12,
							         ptr2:=pRight + 12, cntr:=44) = 0);
						leftTerminal := ((pLeft + 8)^$UINT = 2) |
						                ((pLeft + 8)^$UINT = 3);
						rightTerminal := ((pRight + 8)^$UINT = 2) |
						                 ((pRight + 8)^$UINT = 3);
						leftTombstone := (pLeft + 2)^$UINT = 1;
						rightTombstone := (pRight + 2)^$UINT = 1;

						if (pLeft + 4)^$UDINT = (pRight + 4)^$UDINT then
							hasCorrupt := TRUE;
						end_if;
						if ((pLeft + 72)^$UDINT = (pRight + 72)^$UDINT) &
						   (sameKey = FALSE) then
							hasCorrupt := TRUE;
						end_if;
						if sameKey &
						   ((pLeft + 72)^$UDINT <> (pRight + 72)^$UDINT) then
							hasCorrupt := TRUE;
						end_if;
						if leftTerminal & rightTerminal & sameKey &
						   ((pLeft + 72)^$UDINT = (pRight + 72)^$UDINT) then
							sameSnapshot := _memcmp(
								ptr1:=pLeft + 8, ptr2:=pRight + 8,
								cntr:=68) = 0;
							if sameSnapshot = FALSE then
								hasCorrupt := TRUE;
							end_if;
							if leftTombstone & (rightTombstone = FALSE) &
							   ((pLeft + 4)^$UDINT <= (pRight + 4)^$UDINT) then
								hasCorrupt := TRUE;
							end_if;
							if rightTombstone & (leftTombstone = FALSE) &
							   ((pRight + 4)^$UDINT <= (pLeft + 4)^$UDINT) then
								hasCorrupt := TRUE;
							end_if;
						end_if;
						if ((pLeft + 8)^$UINT = 1) & rightTerminal &
						   sameKey &
						   ((pLeft + 72)^$UDINT = (pRight + 72)^$UDINT) &
						   ((pRight + 4)^$UDINT <= (pLeft + 4)^$UDINT) then
							hasCorrupt := TRUE;
						end_if;
						if ((pRight + 8)^$UINT = 1) & leftTerminal &
						   sameKey &
						   ((pLeft + 72)^$UDINT = (pRight + 72)^$UDINT) &
						   ((pLeft + 4)^$UDINT <= (pRight + 4)^$UDINT) then
							hasCorrupt := TRUE;
						end_if;
					end_if;
				end_for;
			end_if;
		end_for;

		// A non-tombstone terminal is retired only by a newer exact tombstone.
		for slot := 1 to 3 do
			if slotClass[slot] = 2 then
				recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
				pRecord := (#g_LMCSetPositionStoreWords[
					TO_DINT(recordBaseWord)])$^USINT;
				recordState := (pRecord + 8)^$UINT;
				if (((recordState = 2) | (recordState = 3)) &
				    ((pRecord + 2)^$UINT = 0)) then
					for candidateSlot := 1 to 3 do
						if (candidateSlot <> slot) &
						   (slotClass[candidateSlot] = 2) then
							recordBaseWord := axisBaseWord +
								TO_UDINT(candidateSlot * 21);
							pCandidate := (#g_LMCSetPositionStoreWords[
								TO_DINT(recordBaseWord)])$^USINT;
							candidateTombstone :=
								(pCandidate + 2)^$UINT = 1;
							matchingKey :=
								(_memcmp(ptr1:=pRecord, ptr2:=pCandidate,
								         cntr:=2) = 0) &
								(_memcmp(ptr1:=pRecord + 10,
								         ptr2:=pCandidate + 10, cntr:=2) = 0) &
								(_memcmp(ptr1:=pRecord + 12,
								         ptr2:=pCandidate + 12, cntr:=44) = 0);
							matchingSnapshot := _memcmp(
								ptr1:=pRecord + 8,
								ptr2:=pCandidate + 8, cntr:=68) = 0;
							if candidateTombstone & matchingKey &
							   matchingSnapshot &
							   ((pCandidate + 4)^$UDINT >
							    (pRecord + 4)^$UDINT) then
								retiredShadow[slot] := TRUE;
							end_if;
						end_if;
					end_for;
				end_if;
			end_if;
		end_for;

		for slot := 1 to 3 do
			if slotClass[slot] = 2 then
				recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
				pRecord := (#g_LMCSetPositionStoreWords[
					TO_DINT(recordBaseWord)])$^USINT;
				recordState := (pRecord + 8)^$UINT;
				if (((recordState = 2) | (recordState = 3)) &
				    ((pRecord + 2)^$UINT = 0) &
				    (retiredShadow[slot] = FALSE)) then
					unsupersededTerminalCount += 1;
					matchingLowerArmedCount := 0;
					if slotClass[0] = 2 then
						pCandidate := (#g_LMCSetPositionStoreWords[
							TO_DINT(axisBaseWord)])$^USINT;
						matchingKey :=
							(_memcmp(ptr1:=pRecord, ptr2:=pCandidate,
							         cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 10,
							         ptr2:=pCandidate + 10, cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 12,
							         ptr2:=pCandidate + 12, cntr:=44) = 0);
						if ((pCandidate + 8)^$UINT = 1) & matchingKey &
						   ((pCandidate + 72)^$UDINT =
						    (pRecord + 72)^$UDINT) &
						   ((pCandidate + 4)^$UDINT <
						    (pRecord + 4)^$UDINT) then
							matchingLowerArmedCount := 1;
						end_if;
					end_if;
					if matchingLowerArmedCount <> 1 then
						hasCorrupt := TRUE;
					end_if;
				end_if;
			end_if;
		end_for;

		if unsupersededTerminalCount > 1 then
			hasCorrupt := TRUE;
		end_if;

		// Any Armed record must match the one active terminal, when present.
		pCandidate := (#g_LMCSetPositionStoreWords[TO_DINT(axisBaseWord)])$^USINT;
		if (slotClass[0] = 2) &
		   ((pCandidate + 8)^$UINT = 1) &
		   (unsupersededTerminalCount = 1) then
			for slot := 1 to 3 do
				if (slotClass[slot] = 2) &
				   (retiredShadow[slot] = FALSE) then
					recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
					pRecord := (#g_LMCSetPositionStoreWords[
						TO_DINT(recordBaseWord)])$^USINT;
					recordState := (pRecord + 8)^$UINT;
					if ((recordState = 2) | (recordState = 3)) &
					   ((pRecord + 2)^$UINT = 0) then
						matchingKey :=
							(_memcmp(ptr1:=pRecord, ptr2:=pCandidate,
							         cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 10,
							         ptr2:=pCandidate + 10, cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 12,
							         ptr2:=pCandidate + 12, cntr:=44) = 0);
						if (matchingKey = FALSE) |
						   ((pRecord + 72)^$UDINT <>
						    (pCandidate + 72)^$UDINT) then
							hasCorrupt := TRUE;
						end_if;
					end_if;
				end_if;
			end_for;
		end_if;

		if hasCorrupt then
			Result := 0;
		else
			Result := 1;
		end_if;
	end_if;

END_FUNCTION


FUNCTION LMCSetPositionStore::RecordMatchesKey
	VAR_INPUT
		pRecord 	: ^void;
		pKey 	: ^void;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR

	// Compare the persisted recovery key fields without relying on packing.
	Result := 0;
	if (pRecord <> NIL) & (pKey <> NIL) then
		if (_memcmp(ptr1:=pRecord, ptr2:=pKey, cntr:=2) = 0) &
		   (_memcmp(ptr1:=pRecord$^USINT + 10,
		            ptr2:=pKey$^USINT + 2, cntr:=2) = 0) &
		   (_memcmp(ptr1:=pRecord$^USINT + 12,
		            ptr2:=pKey$^USINT + 4, cntr:=32) = 0) &
		   (_memcmp(ptr1:=pRecord$^USINT + 44,
		            ptr2:=pKey$^USINT + 36, cntr:=12) = 0) then
			Result := 1;
		end_if;
	end_if;

END_FUNCTION


FUNCTION LMCSetPositionStore::SelectTerminalSlot
	VAR_INPUT
		AxisReference 	: UINT;
		ExcludedSlot 	: INT;
		pClassifications 	: ^USINT;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		axisBaseWord 	: UDINT;
		recordBaseWord 	: UDINT;
		candidateBaseWord 	: UDINT;
		slot 	: DINT;
		candidateSlot 	: DINT;
		protectedSlot 	: DINT;
		bestSlot 	: DINT;
		pRecord 	: ^USINT;
		pCandidate 	: ^USINT;
		freshClassifications : ARRAY [0..3] OF USINT;
		maxStoreGeneration 	: UDINT;
		maxRecordGeneration 	: UDINT;
		protectedGeneration 	: UDINT;
		bestGeneration 	: UDINT;
		storeGeneration 	: UDINT;
		scanResult 	: DINT;
		retiredShadow 	: BOOL;
		matchingKey 	: BOOL;
		matchingSnapshot 	: BOOL;
	END_VAR

	// Select a safe A/B/C target without mutating retained state.
	Result := -1;
	if (AxisReference < 1) | (AxisReference > 4) |
	   ((ExcludedSlot <> -1) &
	    ((ExcludedSlot < 1) | (ExcludedSlot > 3))) |
	   (pClassifications = NIL) then
		RETURN;
	end_if;

	// Reject corrupt state and stale caller-owned classifications.
	scanResult := ScanAxisStore(
		AxisReference:=AxisReference,
		pClassifications:=#freshClassifications[0],
		pMaxStoreGeneration:=#maxStoreGeneration,
		pMaxRecordGeneration:=#maxRecordGeneration);
	if scanResult <> 1 then
		RETURN;
	end_if;
	for slot := 0 to 3 do
		if (pClassifications + slot)^ <>
		   freshClassifications[slot] then
			RETURN;
		end_if;
	end_for;

	// Every Blank precedes every Incomplete; physical order breaks ties.
	for slot := 1 to 3 do
		if (slot <> ExcludedSlot) &
		   (freshClassifications[slot] = 0) then
			Result := slot;
			RETURN;
		end_if;
	end_for;
	for slot := 1 to 3 do
		if (slot <> ExcludedSlot) &
		   (freshClassifications[slot] = 1) then
			Result := slot;
			RETURN;
		end_if;
	end_for;

	axisBaseWord := (TO_UDINT(AxisReference) - 1) * 84;
	protectedSlot := -1;
	protectedGeneration := 0;
	for slot := 1 to 3 do
		if freshClassifications[slot] = 2 then
			recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
			pRecord := (#g_LMCSetPositionStoreWords[
				TO_DINT(recordBaseWord)])$^USINT;
			storeGeneration := (pRecord + 4)^$UDINT;
			if ((pRecord + 2)^$UINT = 1) &
			   ((protectedSlot < 0) |
			    (storeGeneration > protectedGeneration)) then
				protectedSlot := slot;
				protectedGeneration := storeGeneration;
			end_if;
		end_if;
	end_for;

	// Replace only an older tombstone or an exactly superseded terminal.
	bestSlot := -1;
	bestGeneration := 0;
	for slot := 1 to 3 do
		if (freshClassifications[slot] = 2) &
		   (slot <> ExcludedSlot) &
		   (slot <> protectedSlot) then
			recordBaseWord := axisBaseWord + TO_UDINT(slot * 21);
			pRecord := (#g_LMCSetPositionStoreWords[
				TO_DINT(recordBaseWord)])$^USINT;
			retiredShadow := (pRecord + 2)^$UINT = 1;

			if retiredShadow = FALSE then
				for candidateSlot := 1 to 3 do
					if (candidateSlot <> slot) &
					   (freshClassifications[candidateSlot] = 2) then
						candidateBaseWord := axisBaseWord +
							TO_UDINT(candidateSlot * 21);
						pCandidate := (#g_LMCSetPositionStoreWords[
							TO_DINT(candidateBaseWord)])$^USINT;
						matchingKey :=
							(_memcmp(ptr1:=pRecord, ptr2:=pCandidate,
							         cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 10,
							         ptr2:=pCandidate + 10, cntr:=2) = 0) &
							(_memcmp(ptr1:=pRecord + 12,
							         ptr2:=pCandidate + 12, cntr:=44) = 0);
						matchingSnapshot := _memcmp(
							ptr1:=pRecord + 8,
							ptr2:=pCandidate + 8, cntr:=68) = 0;
						if ((pCandidate + 2)^$UINT = 1) &
						   matchingKey & matchingSnapshot &
						   ((pCandidate + 4)^$UDINT >
						    (pRecord + 4)^$UDINT) then
							retiredShadow := TRUE;
						end_if;
					end_if;
				end_for;
			end_if;

			if retiredShadow then
				storeGeneration := (pRecord + 4)^$UDINT;
				if (bestSlot < 0) |
				   (storeGeneration < bestGeneration) |
				   ((storeGeneration = bestGeneration) &
				    (slot < bestSlot)) then
					bestSlot := slot;
					bestGeneration := storeGeneration;
				end_if;
			end_if;
		end_if;
	end_for;

	Result := bestSlot;

END_FUNCTION


FUNCTION LMCSetPositionStore::CommitRecord
	VAR_INPUT
		AxisReference 	: UINT;
		Slot 	: UINT;
		pImage 	: ^void;
	END_VAR
	VAR_OUTPUT
		Result 	: DINT;
	END_VAR
	VAR
		stagedWords : ARRAY [0..20] OF UDINT;
		readbackWords : ARRAY [0..20] OF UDINT;
		classifications : ARRAY [0..3] OF USINT;
		pStaged : ^USINT;
		pReadback : ^USINT;
		pTarget : ^USINT;
		targetBaseWord : UDINT;
		computedCrc : UDINT;
		readbackCrc : UDINT;
		markerReadback : UDINT;
		maxStoreGeneration : UDINT;
		maxRecordGeneration : UDINT;
		storeFlags : UINT;
		recordState : UINT;
		scanResult : DINT;
		imageValid : BOOL;
	END_VAR

	// Commit one complete 84-byte image using marker-last publication.
	Result := -1;
	if (pImage = NIL) |
	   (AxisReference < 1) | (AxisReference > 4) |
	   (Slot > 3) then
		RETURN;
	end_if;

	if IsClientConnected(#CheckSum) = 0 then
		RETURN;
	end_if;

	// Freeze and validate the complete caller-owned image before mutation.
	_memcpy(ptr1:=#stagedWords[0], ptr2:=pImage, cntr:=84);
	pStaged := (#stagedWords[0])$^USINT;
	pReadback := (#readbackWords[0])$^USINT;
	computedCrc := CheckSum.CRC32(pStaged, 76, 0);
	storeFlags := (pStaged + 2)^$UINT;
	recordState := (pStaged + 8)^$UINT;
	imageValid := TRUE;

	if (pStaged + 80)^$UDINT <> 16#7D12C0DE then
		imageValid := FALSE;
	elsif computedCrc <> (pStaged + 76)^$UDINT then
		imageValid := FALSE;
	elsif pStaged^$UINT <> 1 then
		imageValid := FALSE;
	elsif (storeFlags <> 0) & (storeFlags <> 1) then
		imageValid := FALSE;
	elsif (pStaged + 4)^$UDINT = 0 then
		imageValid := FALSE;
	elsif (recordState <> 1) &
	      (recordState <> 2) &
	      (recordState <> 3) then
		imageValid := FALSE;
	elsif (pStaged + 10)^$UINT <> 1 then
		imageValid := FALSE;
	elsif ((pStaged + 12)^$UDINT = 0) |
	      ((pStaged + 16)^$UDINT = 0) |
	      ((pStaged + 20)^$UDINT = 0) |
	      ((pStaged + 24)^$UDINT = 0) then
		imageValid := FALSE;
	elsif ((pStaged + 28)^$UDINT = 0) &
	      ((pStaged + 32)^$UDINT = 0) &
	      ((pStaged + 36)^$UDINT = 0) &
	      ((pStaged + 40)^$UDINT = 0) then
		imageValid := FALSE;
	elsif (pStaged + 44)^$UINT <> AxisReference then
		imageValid := FALSE;
	elsif (pStaged + 46)^$UINT <> 0 then
		imageValid := FALSE;
	elsif (pStaged + 72)^$UDINT = 0 then
		imageValid := FALSE;
	elsif (Slot = 0) &
	      ((recordState <> 1) | (storeFlags <> 0)) then
		imageValid := FALSE;
	elsif (Slot <> 0) &
	      (recordState <> 2) & (recordState <> 3) then
		imageValid := FALSE;
	elsif (recordState = 1) &
	      (((pStaged + 56)^$DINT <> 0) |
	       ((pStaged + 60)^$UINT <> 0) |
	       ((pStaged + 62)^$INT <> 0) |
	       ((pStaged + 64)^$UDINT <> 0) |
	       ((pStaged + 68)^$UDINT <> 0)) then
		imageValid := FALSE;
	elsif (recordState = 2) &
	      (((pStaged + 56)^$DINT <> (pStaged + 48)^$DINT) |
	       ((pStaged + 60)^$UINT <> 0) |
	       ((pStaged + 62)^$INT <> 0) |
	       ((pStaged + 64)^$UDINT <> 0) |
	       ((pStaged + 68)^$UDINT <> 0)) then
		imageValid := FALSE;
	elsif (recordState = 3) &
	      (((pStaged + 56)^$DINT <> 0) |
	       ((pStaged + 60)^$UINT <> 1) |
	       ((pStaged + 64)^$UDINT < 10) |
	       ((pStaged + 64)^$UDINT > 15)) then
		imageValid := FALSE;
	elsif (recordState = 3) &
	      ((pStaged + 64)^$UDINT = 11) &
	      (((pStaged + 62)^$INT <> -6) |
	       ((pStaged + 68)^$UDINT = 0)) then
		imageValid := FALSE;
	elsif (recordState = 3) &
	      ((pStaged + 64)^$UDINT <> 11) &
	      (((pStaged + 62)^$INT <> -31000) |
	       ((pStaged + 68)^$UDINT <> 0)) then
		imageValid := FALSE;
	end_if;

	if imageValid = FALSE then
		RETURN;
	end_if;

	// Never mutate an axis whose current retained graph is corrupt.
	scanResult := ScanAxisStore(
		AxisReference:=AxisReference,
		pClassifications:=#classifications[0],
		pMaxStoreGeneration:=#maxStoreGeneration,
		pMaxRecordGeneration:=#maxRecordGeneration);
	if scanResult <> 1 then
		RETURN;
	end_if;

	targetBaseWord :=
		((TO_UDINT(AxisReference) - 1) * 84) +
		(TO_UDINT(Slot) * 21);
	pTarget :=
		(#g_LMCSetPositionStoreWords[TO_DINT(targetBaseWord)])$^USINT;

	// Stage 1: invalidate the target marker and prove the readback.
	(pTarget + 80)^$UDINT := 0;
	markerReadback := (pTarget + 80)^$UDINT;
	if markerReadback <> 0 then
		RETURN;
	end_if;

	// Stage 2: write bytes 0..79 while the retained marker remains zero.
	_memcpy(ptr1:=pTarget, ptr2:=pStaged, cntr:=80);
	_memcpy(ptr1:=pReadback, ptr2:=pTarget, cntr:=80);
	if _memcmp(ptr1:=pStaged, ptr2:=pReadback, cntr:=80) <> 0 then
		RETURN;
	end_if;

	if IsClientConnected(#CheckSum) = 0 then
		RETURN;
	end_if;
	readbackCrc := CheckSum.CRC32(pReadback, 76, 0);
	if readbackCrc <> (pReadback + 76)^$UDINT then
		RETURN;
	end_if;

	markerReadback := (pTarget + 80)^$UDINT;
	if markerReadback <> 0 then
		RETURN;
	end_if;

	if IsClientConnected(#CheckSum) = 0 then
		RETURN;
	end_if;

	// Stage 3: publish the exact marker, then prove all 84 bytes.
	(pTarget + 80)^$UDINT := (pStaged + 80)^$UDINT;
	markerReadback := (pTarget + 80)^$UDINT;
	if markerReadback <> 16#7D12C0DE then
		RETURN;
	end_if;

	_memcpy(ptr1:=pReadback, ptr2:=pTarget, cntr:=84);
	if _memcmp(ptr1:=pStaged, ptr2:=pReadback, cntr:=84) <> 0 then
		RETURN;
	end_if;

	// The final image must also satisfy the complete cross-record scan.
	scanResult := ScanAxisStore(
		AxisReference:=AxisReference,
		pClassifications:=#classifications[0],
		pMaxStoreGeneration:=#maxStoreGeneration,
		pMaxRecordGeneration:=#maxRecordGeneration);
	if (scanResult = 1) &
	   (classifications[TO_DINT(Slot)] = 2) then
		Result := 1;
	end_if;

END_FUNCTION
