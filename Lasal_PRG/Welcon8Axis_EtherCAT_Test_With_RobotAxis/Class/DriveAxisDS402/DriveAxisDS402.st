//{{LSL_IMPLEMENTATION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::Init

  // call init of base class
  DriveAxisDS402_Base::Init();

  //=============================================================================================================
  // Last Init-Run
  //=============================================================================================================
  if _FirstScan then

    // check connected clients
    IsClientConnected.CiA_StatusWord := to_bool(IsClientConnected(#CiA_StatusWord));
    IsClientConnected.CiA_ControlWord := to_bool(IsClientConnected(#CiA_ControlWord));
    IsClientConnected.Online := to_bool(IsClientConnected(#Online));

  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::ExecController

  //=============================================================================================================
  // Read StateWord
  //=============================================================================================================
  if IsClientConnected.CiA_StatusWord then
    CiA_StatusWord := CiA_StatusWord.Read();
    StateWord := CiA_StatusWord$DS402_State;
  else
    ControllerError.ClientStatusWordNotConnected := TRUE;
    EnableSequenceSSW := t_e_EnableSequence::ES_ERROR;
  end_if;

  //=============================================================================================================
  // Set HW-Ready Server (The Drive is ready if the OperationEnabled bit of the stateword is true)
  //=============================================================================================================
  OperationEnabled := StateWord.OperationEnabled;

  //=============================================================================================================
  // Set AxError Server
  //=============================================================================================================
  if ( StateWord.Fault = FALSE ) & ( ControllerError = 0) THEN
    if AxError = 1 THEN
      AxError := 0;
    end_if;
    if ControlWord.ResetFault = TRUE then
      ControlWord.ResetFault := FALSE;
    end_if;
  else
    // Don't set AxError Server during Error Quit
    if (AxError = 0) & (ControlWord.ResetFault = FALSE) then
      AxError := 1;
    elsif (ops.tabsolute - TimeStampResetFault) >= 50 then
      AxError := 1;
      ControlWord.ResetFault := FALSE; //HasHan 12.06.2018:
    end_if;
    ControlWord.EnableOperation := FALSE;
  end_if;

  //=============================================================================================================
  // AxEnable/DISABLE SEQUENCE
  //=============================================================================================================
  EnableSequence();
  //Show the actual step on the ClassState server
  ClassState := EnableSequenceSSW;

  //Quit drive error once after start
  if bQuitErrorOnceAfterStartup = FALSE then
    if AxError = 1 then
      AxErrorQuit.write(1);
    end_if;
    bQuitErrorOnceAfterStartup := TRUE;
  end_if;

  //=============================================================================================================
  // Write ControlWord
  //=============================================================================================================
  if IsClientConnected.CiA_ControlWord then
    CiA_ControlWord := ControlWord$DINT;
    CiA_ControlWord.Write (CiA_ControlWord);
  else
    ControllerError.ClientControlWordNotConnected := TRUE;
    EnableSequenceSSW := t_e_EnableSequence::ES_ERROR;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL DriveAxisDS402::EnableSequence

  // Disable the axis if there is an EtherCAT communication breakdown
  if (IsClientConnected.Online) then
    Online := Online.Read();
    if ((Online = 0) & (EnableSequenceSSW >= ES_Disabled) & (EnableSequenceSSW <> ES_ERROR)) then
      ControlWord := 0;
      EnableSequenceSSW := ES_Disabled;
      AxEnable := 0;
    end_if;
  end_if;

  //=============================================================================================================
  // AxEnable/DISABLE SEQUENCE
  //=============================================================================================================
  case EnableSequenceSSW of

    //===========================================================================================================
    // The axis is disabled
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_Disabled:

      // read actual position
      PositionActualValue := PositionActualValue.Read();

      //To prevent a jump, set position must be the same as act position when disabled
      if (TargetPosition <> PositionActualValue) & (InternalPara.TargetPositionResetInactive = 0) then
        TargetPosition := PositionActualValue;
        TargetPosition.Write (TargetPosition);
      end_if;

      //Set torque must be zero when starting the drive
      if (SetTorque <> 0) & (InternalPara.SetTorqueResetInactive = 0) then
        SetTorque := 0;
        TargetTorque := SetTorque;
        TargetTorque.Write (TargetTorque);
      end_if;

      //Set velocity must be zero when starting the drive
      if (SetSpeed <> 0) & (InternalPara.SetSpeedResetInactive = 0)  then
        SetSpeed := 0;
        TargetVelocity := SetSpeed;
        TargetVelocity.Write (TargetVelocity);
      end_if;

      //Set speed offset must be zero when starting the drive
      if (SetSpeedOffset <> 0) & (InternalPara.SetSpeedOffsetResetInactive = 0)  then
        SetSpeedOffset := 0;
        VelocityOffset := SetSpeedOffset;
        VelocityOffset.Write (VelocityOffset);
      end_if;

      //Set torque offset must be zero when starting the drive
      if (SetTorqueOffset <> 0) & (InternalPara.SetTorqueOffsetResetInactive = 0)  then
        SetTorqueOffset := 0;
        TorqueOffset := SetTorqueOffset;
        TorqueOffset.Write (TorqueOffset);
      end_if;

    //===========================================================================================================
    // The axis is enabled
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_Enabled:

      //If the drive state falls back, we also have to reset our states
      if StateWord.OperationEnabled = FALSE | StateWord.SwitchedOn = FALSE | StateWord.ReadyToSwitchOn = FALSE then
        ControlWord := 0;
        EnableSequenceSSW := t_e_EnableSequence::ES_Disabled;
        AxEnable := 0;
      end_if;

    //===========================================================================================================
    // First step of the enable sequence
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_StartEnable:
      ControlWord.SwitchOn      := FALSE;
      ControlWord.EnableVoltage := TRUE;
      ControlWord.QuickStop     := TRUE;

      EnableStartTime := ops.tAbsolute;
      EnableSequenceSSW := t_e_EnableSequence::ES_SwitchOn;

    //===========================================================================================================
    // Second step of the enable sequence
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_SwitchOn:
      if StateWord.QuickStop      &
         StateWord.ReadyToSwitchOn then

        ControlWord.SwitchOn      := TRUE;

        EnableStartTime := ops.tAbsolute;
        EnableSequenceSSW := t_e_EnableSequence::ES_EnableOperation;

      elsif (ops.tAbsolute - EnableStartTime) > ECAT_DRIVE_ENABLE_TIMEOUT | StateWord.Fault = TRUE then
        // after ECAT_DS402_ENABLE_TIMEOUT msec we stop trying => disable
        ControllerError.EnableError := TRUE;
        AxEnable.Write(0);
      end_if;

    //===========================================================================================================
    // Third step of the enable sequence
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_EnableOperation:
      if StateWord.VoltageEnabled   &
         StateWord.QuickStop        &
         StateWord.ReadyToSwitchOn  &
         StateWord.SwitchedOn
      then

        ControlWord.EnableOperation := TRUE;

        EnableStartTime := ops.tAbsolute;
        EnableSequenceSSW := t_e_EnableSequence::ES_CheckOperationEnabled;

      elsif (ops.tAbsolute - EnableStartTime) > ECAT_DRIVE_ENABLE_TIMEOUT | StateWord.Fault = TRUE then
        // after ECAT_DS402_ENABLE_TIMEOUT msec we stop trying => disable
        ControllerError.EnableError := TRUE;
        AxEnable.Write(0);
      end_if;

    //===========================================================================================================
    // Fourth step of the enable sequence
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_CheckOperationEnabled:

      if StateWord.VoltageEnabled   &
         StateWord.QuickStop        &
         StateWord.ReadyToSwitchOn  &
         StateWord.SwitchedOn       &
         StateWord.OperationEnabled then

        AxEnable := 1;
        EnableSequenceSSW := t_e_EnableSequence::ES_Enabled;

      elsif (ops.tAbsolute - EnableStartTime) > ECAT_DRIVE_ENABLE_TIMEOUT | StateWord.Fault = TRUE then
        // after 1 sec we stop trying => disable
        ControllerError.EnableError := TRUE;
        AxEnable.Write(0);
      end_if;

    //===========================================================================================================
    // Disable the axis
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_DisableOperation:

      if StateWord.OperationEnabled = 0 then
        AxEnable := 0;
        EnableSequenceSSW := t_e_EnableSequence::ES_Disabled;
      end_if;

    //===========================================================================================================
    // Error state
    //-----------------------------------------------------------------------------------------------------------
    t_e_EnableSequence::ES_ERROR:
    //The client ControlWord or StatusWord is not connected (see the server ControllerError)

    //===========================================================================================================
  end_case;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::AxEnable::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  if input = 1 then

    //The axis can only be enabled
    if ( EnableSequenceSSW = t_e_EnableSequence::ES_Disabled ) & ( ControllerError = 0 ) then

      ControllerError.EnableError := FALSE;

      if StateWord.VoltageEnabled   &
         StateWord.QuickStop        &
         StateWord.ReadyToSwitchOn  &
         StateWord.SwitchedOn then

        // quick enable after disable
        EnableSequenceSSW := t_e_EnableSequence::ES_EnableOperation;
      else
        // enable from scratch
        EnableSequenceSSW := t_e_EnableSequence::ES_StartEnable;
      end_if;

    end_if;

    result := AxEnable;

  elsif input = 0 then

    // deactivate the drive and the Axis
    if OperationTransitions.Transition9Active = TRUE then

      ControlWord.SwitchOn            := FALSE;
      ControlWord.EnableVoltage       := FALSE;
      ControlWord.EnableOperation     := FALSE;
      ControlWord.OperationModeSpec1  := FALSE;

      result := 0;
      EnableSequenceSSW := t_e_EnableSequence::ES_DisableOperation;

    else
      // disable: clear only operation and opmode specific bits
      ControlWord.EnableOperation     := FALSE;
      ControlWord.OperationModeSpec1  := FALSE;

      result := 0;
      EnableSequenceSSW := t_e_EnableSequence::ES_DisableOperation;
    end_if;
  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::AxErrorQuit::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  if input = 1 then

    AxErrorQuit := input;

    if (StateWord.ReadyToSwitchOn = 1 ) & (StateWord.SwitchedOn = 1) THEN
      ControlWord.SwitchOn      := 1;
      ControlWord.EnableVoltage := 1;
      ControlWord.QuickStop     := 1;
    end_if;

    // Reset Error
    ControllerError.EnableError := FALSE;
    AxError := 0;

    ControlWord.ResetFault := 1;

    // Set timestamp after a defined time again when the AxError set if the error remains
    TimeStampResetFault := ops.tabsolute;

    AxErrorQuit := 0;

    result := AxErrorQuit;

  end_if;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::SetOpMode::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  // The operation mode can only be changed if the drive is disabled
  if EnableSequenceSSW = t_e_EnableSequence::ES_Disabled & AxEnable = 0 then

    SetOpMode := input;
    result := SetOpMode;

    ModesOfOperation := SetOpMode;
    ModesOfOperation.Write (ModesOfOperation);

  else
    result := SetOpMode;
  end_if;

END_FUNCTION


