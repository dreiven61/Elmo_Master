FUNCTION VIRTUAL GLOBAL DriveAxisDS402::GetPara
	VAR_INPUT
		Idx 	: DINT;
		SubIdx 	: DINT;
		pValue 	: ^DINT;
	END_VAR
	VAR_OUTPUT
		RetCode 	: DINT;
	END_VAR

  RetCode := -1;    // not available

  if (pValue = NIL) then
    return;
  end_if;


  case (Idx) of

    //=============================================================================================================
    // 001 ... Task settings
    //=============================================================================================================
    001:

      case (SubIdx) of

        //-----------------------------------------------------------------------------------------------------
        // Sub 000 ... Period time
        //-----------------------------------------------------------------------------------------------------
        000:
          pValue^ := TaskInfo.PeriodTime$DINT;
          RetCode := 0;

        //-----------------------------------------------------------------------------------------------------

      end_case;

    //=============================================================================================================
    // 002 ... Internal Para
    //=============================================================================================================
    002:

      case (SubIdx) of

        0:
          pValue^ := InternalPara.SetSpeedResetInactive;
          RetCode := 0;

        1:
          pValue^ := InternalPara.SetSpeedOffsetResetInactive;
          RetCode := 0;

        2:
          pValue^ := InternalPara.SetTorqueResetInactive;
          RetCode := 0;

        3:
          pValue^ := InternalPara.SetTorqueOffsetResetInactive;
          RetCode := 0;

        4:
          pValue^ := InternalPara.TargetPositionResetInactive;
          RetCode := 0;

      end_case;


    //=============================================================================================================
    // 003 ... Operation Transitions
    //=============================================================================================================
    003:

      case (SubIdx) of

        9:
          pValue^ := OperationTransitions.Transition9Active;
          RetCode := 0;

      end_case;

    //=============================================================================================================

  end_case;

END_FUNCTION


FUNCTION VIRTUAL GLOBAL DriveAxisDS402::SetPara
	VAR_INPUT
		Idx 	: DINT;
		SubIdx 	: DINT;
		Value 	: DINT;
	END_VAR
	VAR_OUTPUT
		RetCode 	: DINT;
	END_VAR

  RetCode := -1;    // not available

  case (Idx) of

    //=============================================================================================================
    // 001 ... Task settings
    //=============================================================================================================
    001:

      case (SubIdx) of

        //-----------------------------------------------------------------------------------------------------
        // Sub 000 ... Period time
        //-----------------------------------------------------------------------------------------------------
        000:
          if ((Value > 0) & (TaskInfo.Status.PeriodOk = FALSE)) then
            TaskInfo.PeriodTime := Value$UDINT;
            TaskInfo.PeriodCnt := 1000 * 1000 / TaskInfo.PeriodTime;
            TaskInfo.Status.PeriodOk      := TRUE;
            TaskInfo.Status.EnableExtTask := TRUE;
            TaskInfo.Status.EnableRtTask  := FALSE;
            TaskInfo.Status.EnableCyTask  := FALSE;
            TaskInfo.Status.EnableBgTask  := FALSE;
            RetCode := 0;
          else
            RetCode := -1;    // value not allowed or time already set
          end_if;

        //-----------------------------------------------------------------------------------------------------

      end_case;

    //=============================================================================================================
    // 002 ... Internal Para
    //=============================================================================================================
    002:

      case (SubIdx) of

        0:
          InternalPara.SetSpeedResetInactive        := Value;
          RetCode := 0;

        1:
          InternalPara.SetSpeedOffsetResetInactive  := Value;
          RetCode := 0;

        2:
          InternalPara.SetTorqueResetInactive       := Value;
          RetCode := 0;

        3:
          InternalPara.SetTorqueOffsetResetInactive := Value;
          RetCode := 0;

        4:
          InternalPara.TargetPositionResetInactive  := Value;
          RetCode := 0;

      end_case;

    //=============================================================================================================
    // 003 ... Operation Transitions
    //=============================================================================================================
    003:

      case (SubIdx) of

        9:
          OperationTransitions.Transition9Active := Value;
          RetCode := 0;

      end_case;
    //=============================================================================================================
  end_case;

END_FUNCTION
