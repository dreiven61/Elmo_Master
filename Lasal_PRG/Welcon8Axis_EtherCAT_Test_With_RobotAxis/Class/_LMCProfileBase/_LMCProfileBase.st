		<Client Name="LMCPostRtWorkTrigger" Required="false" Internal="false" Comment="With this client, a connection to a user object can be established so&#13;&#10;that it can run with the same task time as the _LMCProfile object.&#13;&#10;Over this client, the RtWork method of a user object is called at the&#13;&#10;end of the RtWork method of the _LMCProfile object."/>
		<Client Name="LMCPreRtWorkTrigger" Required="false" Internal="false" Comment="With this client, a connection to a user object can be established so&#13;&#10;that it can run with the same task time as the _LMCProfile object.&#13;&#10;Over this client, the RtWork method of a user object is called at the&#13;&#10;start of the RtWork method of the _LMCProfile object."/>
		<Client Name="LMCProfileBuffer" Required="true" Internal="false" Comment="Object channel for _LMCProfileBuffer to call methods for arranging the databuffer."/>
		<Client Name="LMCSafetyZones" Required="false" Internal="false" Comment="Connection to an object of the class _WatchProtCubes. With this connection, &#13;&#10;a safety zone monitor is activated for linear movements&#13;&#10;============================================================================&#13;&#10;&#13;&#10;PassiveProfile:&#13;&#10;Axis are unlocked in passive mode&#13;&#10;&#13;&#10;IdleProfile:&#13;&#10;Axis are locked in idle mode - no motion sequences are available &#13;&#10;&#13;&#10;RunProfile:&#13;&#10;Axes are in motion to generate a profile&#13;&#10;&#13;&#10;EndProfile:&#13;&#10;The generated profile is finished now&#13;&#10;&#13;&#10;ErrorProfile:&#13;&#10;An error occured"/>
