		END_VAR
		VAR_OUTPUT
			RetCode 	: _LMCPROFERRORTYPES;			//! <Variable Comment="_LMCPROF_NoError ... command successfull&#13;&#10;_LMCPROF_OUT_OF_RANGE ... invalid input parameter StretchFactor. It has to be greater or equal 1.&#13;&#10;_LMCPROF_ERROR_BUSY ... wrong state of _LMCProfile. Command can only be executed, if: &#13;&#10; * all previous move commands are finished &#13;&#10; * the new one is not already started (Control=IdleProfile)&#13;&#10; * there is exact one new command executed by the user." Name="StretchLastMove.RetCode"/>
