			Jerk 	: DINT;			//! <Variable Comment="Deceleration [Application units / s2 ]" Name="MoveCurveSplineBelt.Jerk"/>
			CornerOverdrive 	: DINT;			//! <Variable Comment="Velocity overdrive on the corners of the MoveCurve motion, specified per mill.&#13;&#10;&#13;&#10;Possible Values:&#13;&#10;CornerOverdrive = 0 - Velocity around the corners limited by the allowed Acceleration and Jerk along the path (No exceeding).&#13;&#10;CornerOverdrive &gt; 0 - Velocity around the corners limited by the allowed Acceleration and Jerk  + (CornerOverdrive/1000) * Accel or Jerk) along the path (Possibly exceeding the allowed Acceleration / Jerk along the path).&#13;&#10;CornerOverdrive &lt; 0 - Velocity around the corners limited by the allowed Acceleration and Jerk  - (CornerOverdrive/1000) * Accel or Jerk) along the path (Not exceeding the allowed Acceleration / Jerk along the path).&#13;&#10;&#13;&#10;For further description of the input parameter and the effect thereof on the movement, see the documentation." Name="MoveCurveSplineBelt.CornerOverdrive"/>
			TransMode 	: _LMCPROFTRANSMODES;			//! <Variable Comment="Mode for profile overlaps &#13;&#10;_LMCPROF_EXACT_STOP: Precision Stop. &#13;&#10;_LMCPROF_CONT_DIRECT: rounding&#13;&#10;_LMCPROF_SMOOTH_PARAB: rounding with tolerance sphere&#13;&#10;_LMCPROF_SMOOTH_CUBIC: rounding with cubic spline &#13;&#10;_LMCPROF_SMOOTH_QUINT: rounding with spline 5th order " Name="MoveCurveSplineBelt.TransMode"/>
			TransRadius 	: DINT;			//! <Variable Comment="Radius of the tolerance sphere [application units] for rounding the sequence transitions with tolerance sphere and rounding with a cubic or 5th order spline." Name="MoveCurveSplineBelt.TransRadius"/>
