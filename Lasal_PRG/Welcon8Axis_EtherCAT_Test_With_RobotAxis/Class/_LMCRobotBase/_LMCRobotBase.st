				//! <Function Comment="The method MoveCurve executes a combined motion, whilst coupling to / decoupling from a master (e.g. a Conveyor Belt).&#13;&#10;The motion consists of up to 5 motion phases (see documentation). &#13;&#10;With the transfer parameter pObstacle^.AxisNr the number of the axis has to be selected, which executes the evasive movement. &#13;&#10;&#13;&#10;This method is only allowed to be called from a thread running on the same Core as the Realtime Thread for the _LMCProfile instance which has an equal or lower priority than the Realtime Thread." Name="MoveCurveSplineBelt"/>
	FUNCTION VIRTUAL GLOBAL MoveCurveSplineBelt
		VAR_INPUT
			pPositions 	: ^_LMCPROF_POS;			//! <Variable Comment="Pointer to the absolute path position to which the axes1 - 9 should move. [Application units]" Name="MoveCurveSplineBelt.pPositions"/>
			CmdConfig 	: _LMCPROFCMDCONFIG;			//! <Variable Comment="This input parameter currently has no meaning in the MoveCurveSpline() method call." Name="MoveCurveSplineBelt.CmdConfig"/>
			Velocity 	: DINT;			//! <Variable Comment="Speed [application units/ s]" Name="MoveCurveSplineBelt.Velocity"/>
