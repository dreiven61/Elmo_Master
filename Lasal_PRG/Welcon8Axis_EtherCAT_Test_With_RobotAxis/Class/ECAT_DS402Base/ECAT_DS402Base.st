FUNCTION VIRTUAL GLOBAL ECAT_DS402Base::ClassState::NewInst
	VAR_INPUT
		pPara 	: ^CmdStruct;
		pResult 	: ^Results;
	END_VAR
	VAR_OUTPUT
		ret_code 	: IprStates;
	END_VAR
  VAR
    pPDORead      : ^t_DRIVESAFETYIF_PDOREAD;
    pPDOWrite     : ^t_DRIVESAFETYIF_PDOWRITE;
  END_VAR

  ret_code 	:= ERROR;

  CASE pPara^.uiCmd OF

  //*****************************************************************************
  DRIVESAFETYIF_NEWINSTPDO:

    pResult^.uiLng := 1;

    //We use this as version request in DrivePosControl to ensure that both classes have the same structure type (_DRIVESAFETYIF_PDOREAD, _DRIVESAFETYIF_PDOWRITE)
    //If the structure is changed, we need to increment the version number in pResult^.aData[0]
    pResult^.aData[0] := 1; //Version 1

  //*****************************************************************************
  DRIVESAFETYIF_READPDODATA:
    pPDORead := pPara^.aPara[0]$^t_DRIVESAFETYIF_PDOREAD;
    if ClassState = _ClassOk then
      pPDORead^.Online := TRUE;

      // StatusWord (nur die ersten 4 Bits
      pPdoRead^.StateWord := to_usint(StateWord.Read()) AND 2#00001111;  // Only include the 1st 4 Bits

      // ActPos
      pPdoRead^.ActPos := ActPos.Read();

      // XW
      pPdoRead^.ActXw := ActXw.Read();

    else
      pPdoRead^.Online := FALSE;
    end_if;

  //*****************************************************************************
  DRIVESAFETYIF_WRITEPDODATA:
    pPDOWrite := pPara^.aPara[0]$^t_DRIVESAFETYIF_PDOWRITE;
    if ClassState = _ClassOk then

      // SetPos
      if (pPDOWrite^.SetPos.Active = 1) then
        SetPos.Write(input:=pPDOWrite^.SetPos.Value);
      end_if;

      // Enable
      if (pPDOWrite^.Enable.Active = 1) then
        AxEnable.Write(input:=pPDOWrite^.Enable.Value);
      end_if;

      // SetSpeed
      if (pPDOWrite^.SetSpeed.Active = 1) then
        SetSpeed.Write(input:=pPDOWrite^.SetSpeed.Value);

      end_if;
    end_if;

  //*****************************************************************************
  DRIVESAFETYIF_DOAXERRORQUIT:

      ret_code := ERROR; //unsupported version

      pResult^.uiLng := 4;
      pResult^.aData[0]$DINT := DRIVESAFETYIF_DOAXERRORQUIT_VER_MAX;  //max supported version

      //Check version 1
      if pPara^.aPara[0] = DRIVESAFETYIF_DOAXERRORQUIT_VER_1 then
        pResult^.uiLng := 8;
        pResult^.aData[4]$DINT := AxErrorQuit.Write(input:=pPara^.aPara[1]);
        ret_code := READY;
      else
        HWC_LogPrintf(pThis:=this, format:="@08B2 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando DRIVESAFETYIF_DOAXERRORQUIT detected", #pPara^.aPara[0]);
      end_if;

  //*****************************************************************************
  DRIVESAFETYIF_GET_AXISERROR:
    ret_code := ERROR; //unsupported version

    pResult^.uiLng := 4;
    pResult^.aData[0]$DINT := DRIVESAFETYIF_GET_AXISERROR_VER_MAX;  //max supported version

    //Check version 1
    if pPara^.aPara[0] = DRIVESAFETYIF_GET_AXISERROR_VER_1 then

      pResult^.uiLng := 8;
      pResult^.aData[4]$DINT := AxError.Read();

      ret_code := READY;

    else
      HWC_LogPrintf(pThis:=this, format:="@08B2 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando DRIVESAFETYIF_GET_AXISERROR detected", #pPara^.aPara[0]);
    end_if;

  //*****************************************************************************
  DRIVESAFETYIF_ADD_ASYNC_ENTRY_DS402:

     ret_code := ERROR; //unsupported version

    pResult^.uiLng := 4;
    pResult^.aData[0]$DINT := DRIVESAFETYIF_ADD_ASYNC_ENTRY_DS402_VER_MAX;  //max supported version

    //Check version 1
    if pPara^.aPara[0] = DRIVESAFETYIF_ADD_ASYNC_ENTRY_DS402_VER_1 then

      //Call method
      pResult^.aData[4]$DINT := AddASyncEntryDS402( uiParaID     :=  pPara^.aPara[2]$UINT
                                                  , usParaSubID  :=  pPara^.aPara[3]$USINT
                                                  , usRdWr       :=  pPara^.aPara[4]$USINT
                                                  , pValue       :=  pPara^.aPara[5]$^void
                                                  , bsDataInfo   :=  pPara^.aPara[6]$BSINT
                                                  , pThisObj     :=  pPara^.aPara[7]$^void
                                                  , usEntry      :=  pPara^.aPara[8]$USINT
                                                  , udTimeout    :=  pPara^.aPara[9]$UDINT
                                                  , dCallID      :=  pPara^.aPara[10]$DINT
                                                  );

      pResult^.uiLng := 8;
      ret_code := ERROR;
      if pResult^.aData[4]$DINT = 0 then
        ret_code := READY;
      end_if;

    else
      HWC_LogPrintf(pThis:=this, format:="@08B3 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando DRIVESAFETYIF_ADD_ASYNC_ENTRY_DS402 detected", #pPara^.aPara[0]);
    end_if;

//*****************************************************************************
  DRIVESAFETYIF_GET_CLASS_STATE:

    ret_code := ERROR; //unsupported version

    pResult^.uiLng := 4;
    pResult^.aData[0]$DINT := DRIVESAFETYIF_GET_CLASS_STATE_VER_MAX;  //max supported version

    //Check version 1
    if pPara^.aPara[0] = DRIVESAFETYIF_GET_CLASS_STATE_VER_1 then

      pResult^.uiLng := 8;
      if ClassState = _ClassOk then
        pResult^.aData[4]$iprStates := READY;
      else
        pResult^.aData[4]$iprStates := ERROR;
      end_if;

      ret_code := READY;

    else
      HWC_LogPrintf(pThis:=this, format:="@08B2 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando MDD2000MNG_IF_GET_CLASS_STATE detected", #pPara^.aPara[0]);
    end_if;

//*****************************************************************************
  DRIVESAFETYIF_IS_HARDWARE_AVAILABLE:

    ret_code := ERROR; //unsupported version

    pResult^.uiLng := 4;
    pResult^.aData[0]$DINT := DRIVESAFETYIF_IS_HARDWARE_AVAILABLE_VER_MAX;  //max supported version

    //Check version 1
    if pPara^.aPara[0] = DRIVESAFETYIF_IS_HARDWARE_AVAILABLE_VER_1 then

      pResult^.uiLng := 8;
      if ClassState = _ClassOk then
        pResult^.aData[4]$DINT := 1;
      else
        pResult^.aData[4]$DINT := 0;
      end_if;

      ret_code := READY;

    else
      HWC_LogPrintf(pThis:=this, format:="@08B2 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando MDD2000MNG_IF_IS_HARDWARE_AVAILABLE detected", #pPara^.aPara[0]);
    end_if;

//*****************************************************************************
  DRIVESAFETYIF_IS_AXIS_READY_4_ASYPARA:

    ret_code := ERROR; //unsupported version

    pResult^.uiLng := 4;
    pResult^.aData[0]$DINT := DRIVESAFETYIF_IS_AXIS_READY_4_ASYPARA_VER_MAX;  //max supported version

    //Check version 1
    if pPara^.aPara[0] = DRIVESAFETYIF_IS_AXIS_READY_4_ASYPARA_VER_1 then

      pResult^.uiLng := 8;

      if ClassState = _ClassOk then
        pResult^.aData[4]$DINT := TRUE;
      else
        pResult^.aData[4]$DINT := FALSE;
      end_if;

      ret_code := READY;

    else
      HWC_LogPrintf(pThis:=this, format:="@08B2 (ECAT_DS402AxisBase::CmdState::NewInst) Unsupported version %d of commando MDD2000MNG_IF_IS_AXIS_READY_4_ASYPARA detected", #pPara^.aPara[0]);
    end_if;


  else
    ret_code := ECAT_Slave_Base::NewInst(pPara, pResult);
  end_case;

END_FUNCTION

