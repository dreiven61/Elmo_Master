FUNCTION VIRTUAL ECAT_DS402Base::AddASyncEntryDS402
	VAR_INPUT
		uiParaID 	: UINT;
		usParaSubID 	: USINT;
		usRdWr 	: USINT;
		pValue 	: ^void;
		bsDataInfo 	: BSINT;
		pThisObj 	: ^void;
		usEntry 	: USINT;(* := 0 *)
		udTimeout 	: UDINT;(* := 0 *)
		dCallID 	: DINT;(* := 0 *)
	END_VAR
	VAR_OUTPUT
		retcode 	: DINT;
	END_VAR
  VAR
    ret_code 	: IprStates;
    udSDOLength   : UDINT;
  END_VAR

   retcode := -11;
  if (sigclib_atomic_cmpxchgU32(pValue:= #sDriveIFSDO.udIsSDOActive, cmpVal:= ECAT_SB_SDO_FREE, newVal:= ECAT_SB_SDO_LOCK) = ECAT_SB_SDO_FREE) then

    sDriveIFSDO.SDOData.pThisObj        := pThisObj;
    sDriveIFSDO.SDOData.uiParaIndex     := uiParaID;
    sDriveIFSDO.SDOData.usParaSubIndex  := usParaSubID;
    sDriveIFSDO.SDOData.usRDWR          := usRdWr;
    sDriveIFSDO.SDOData.bsDataInfo      := bsDataInfo;
    sDriveIFSDO.SDOData.usEntry         := usEntry;
    sDriveIFSDO.SDOData.udTimeoutCycles := udTimeout;
    sDriveIFSDO.SDOData.dCallID         := dCallID;

    udSDOLength := ((bsDataInfo) + 1) * sizeof(DINT);  // usEntry 0 = 4Byte, 1 = 8Byte, 2 = 12Byte

    if usRdWr = 0 then // Read

      // Reset Receive Buffer, bsDataInfo does not handle sizes smaller 4 Byte
      _memset(dest:=#sDriveIFSDO.SDOData.dValue[0], usByte:=0, cntr:=sizeof(sDriveIFSDO.SDOData.dValue));

      ret_code := StartReadSDO( hIndex          := sDriveIFSDO.SDOData.uiParaIndex
                              , hsSubIndex      := sDriveIFSDO.SDOData.usParaSubIndex
                              , dCompleteAccess := 0
                              , pReadData       := #sDriveIFSDO.SDOData.dValue[0]
                              , udMaxDataLength := udSDOLength
                              , udTimeout       := sDriveIFSDO.SDOData.udTimeoutCycles
                              , pCallback       := this );  // Change this pointer because we need to change the command of the callback before passing it on
    else  // Write

      if udSDOLength <= 12 then
        _memcpy(ptr1:=#sDriveIFSDO.SDOData.dValue, ptr2:=pValue, cntr:=udSDOLength);
      else
         retcode := -1;
         return;
      end_if;

      ret_code := StartWriteSDO(hIndex          := sDriveIFSDO.SDOData.uiParaIndex
                              , hsSubIndex      := sDriveIFSDO.SDOData.usParaSubIndex
                              , dCompleteAccess := 0
                              , pWriteData      := #sDriveIFSDO.SDOData.dValue[0]
                              , udWriteLength   := udSDOLength
                              , udTimeout       := sDriveIFSDO.SDOData.udTimeoutCycles
                              , pCallback       := this );  // Change this pointer because we need to change the command of the callback before passing it on
    end_if;

    retcode := 0;
    if ret_code <> READY then
      sigclib_atomic_setU32(pValue:=#sDriveIFSDO.udIsSDOActive     , value:=ECAT_SB_SDO_FREE);
      retcode := -12;
    end_if;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL GLOBAL ECAT_DS402Base::ConnectEvent

  ECAT_Slave_Base::ConnectEvent();
  sigclib_atomic_setU32(pValue:=#sDriveIFSDO.udIsSDOActive, value:=ECAT_SB_SDO_FREE);

END_FUNCTION


FUNCTION VIRTUAL ECAT_DS402Base::ReceiveSDOResponse
	VAR_INPUT
		sd_retval 	: DINT;
		bReadOrWriteSDO 	: BOOL;
		hIndex 	: HINT;
		hsSubIndex 	: HSINT;
		usLength 	: USINT;
		udErrorCode 	: UDINT;
	END_VAR
  VAR
	Para 	: CmdStruct;
		Result 	: Results;
  END_VAR

  // Check if SDO was sent with AddASyncEntryDS402
  if sigclib_atomic_getU32(pValue:=#sDriveIFSDO.udIsSDOActive) = ECAT_SB_SDO_LOCK then

    if (hIndex      = sDriveIFSDO.SDOData.uiParaIndex) &
       (hsSubIndex  = sDriveIFSDO.SDOData.usParaSubIndex) then

      // Change Callback
      if sd_retval = ECATM_OK then

        // Asynchronous access is finished
        Para.uiCmd    := DRIVESAFETYIF_ASYNC_READY;
        Para.aPara[0] := DRIVESAFETYIF_ASYNC_READY_VER_1;

      else

        // Asynchronous access is finished
        Para.uiCmd    := DRIVESAFETYIF_ASYNC_ERROR;
        Para.aPara[0] := DRIVESAFETYIF_ASYNC_ERROR_VER_1;

      end_if;

      Para.aPara[1] := sDriveIFSDO.SDOData.uiParaIndex;
      Para.aPara[2] := sDriveIFSDO.SDOData.usParaSubIndex;
      Para.aPara[3] := sDriveIFSDO.SDOData.usRDWR;
      Para.aPara[4] := 0; // Achsennummer;
      Para.aPara[5] := sDriveIFSDO.SDOData.bsDataInfo;
      Para.aPara[6] := (#sDriveIFSDO.SDOData.dValue[0])$DINT;  //Pointer to data
      Para.aPara[7] := sDriveIFSDO.SDOData.dCallID;
      Para.aPara[8] := udErrorCode$DINT;

      sDriveIFSDO.SDOData.pThisObj$^VirtualBase^.NewInst(#Para, #Result);

      sigclib_atomic_SetU32(pValue:=#sDriveIFSDO.udIsSDOActive, ECAT_SB_SDO_FREE);

    end_if;

  end_if;

END_FUNCTION


