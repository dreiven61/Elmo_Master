FUNCTION GLOBAL GetCILInterface::GetBaseAddressByDeviceID
	VAR_INPUT
		DeviceID 	: UINT;
	END_VAR
	VAR_OUTPUT
		ptr 	: pVoid;
	END_VAR
  VAR
	p_sigmatek_devinfo : ^PCICONFDATA;
  END_VAR

  ptr := NIL;

  if pSPCIInfo = NIL then
    GetCilPCIInfo();
  end_if;

  if pSPCIInfo <> NIL then

    p_sigmatek_devinfo := SPCIINFO_FINDDEVICE( DeviceID,0 );

    if p_sigmatek_devinfo = NIL then
      return;
    end_if;

    ptr := SPCIINFO_GETADDRESS( p_sigmatek_devinfo );
    if ptr = NIL then
      return;
    end_if;

  end_if;

END_FUNCTION

