FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTable
	VAR_INPUT
		TabHandle 	: HDINT;
		ptabidx 	: ^DINT;(* := NIL *)
	END_VAR
	VAR_OUTPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
	END_VAR
  VAR
	tabidx : DINT;
  END_VAR

  // Returns the pointer to the routing table corresponding to the passed TabHandle
  // If TabHandle = 0, the pointer to the first routing table is returned
  // Optional the index of the table is returned.
  pSafetyTable := NIL;

  for tabidx := 0 to SRT_MAXIDX do

    if (TableList.TabList[tabidx]) then

      if (TableList.TabList[tabidx]^.Handle = TabHandle) | (TabHandle = 0) then
        pSafetyTable := TableList.TabList[tabidx];
        if ptabidx then
          ptabidx^ := tabidx;
        end_if;

        return;
      end_if;

    end_if;

  end_for;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTableNext
	VAR_INPUT
		TabHandle 	: HDINT;
	END_VAR
	VAR_OUTPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
	END_VAR
  VAR
	tabidx : DINT;
    bFoundHandle : BOOL;
  END_VAR

  // Returns the pointer to the routing table after the table corresponding to the passed TabHandle
  // If TabHandle = 0, the pointer to the first routing table is returned
  pSafetyTable  := NIL;
  bFoundHandle  := FALSE;

  if TabHandle = 0 then // Return the 1st valid handle
    bFoundHandle := TRUE;
  end_if;

  for tabidx := 0 to SRT_MAXIDX do

    if (TableList.TabList[tabidx]) then

      if bFoundHandle then
        pSafetyTable := TableList.TabList[tabidx];
        return;
      elsif TableList.TabList[tabidx]^.Handle = TabHandle then
        bFoundHandle      := TRUE;
      end_if;

    end_if;

  end_for;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::IsTabVersionSupported
	VAR_INPUT
		VersionMajor 	: HINT;
		VersionMinor 	: HINT;
		TableType 	: t_SafetyTableType;
	END_VAR
	VAR_OUTPUT
		bTabVersionSupported 	: BOOL;
	END_VAR

  // Returns true if the passed version of the table is supported
  bTabVersionSupported := FALSE;

  if (VersionMajor = 0x01) & (VersionMinor = 0x00) &
     ((TableType = FSOEROUTINGTABLE ) | (TableType = SCPTABLE)) then
    bTabVersionSupported := TRUE;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::CreateFSoERoutingTable_v01XX
	VAR_INPUT
		VersionMinor 	: HINT;
		NoTabLines 	: UDINT;
	END_VAR
	VAR_OUTPUT
		pFSoERoutingTable 	: ^t_SafetyTableHeader;
	END_VAR
  VAR
    FSoERoutingTableSize : UDINT;
    FSoERoutingTableSubHeaderV01XXSize : UDINT;
    pFSoERoutingTableSubHeader : ^t_SafetyTableSubHeaderV01XX;
  END_VAR

  // Creates a new routing table of the passed Minor Version.
  // The header(s) of the table are filled.
  // if NoTabLines <> 0, the memory for those lines allocated but the content of the lines is not filled. (See CheckAddTabLineToFSoERoutingTable)

  pFSoERoutingTable := NIL;

  FSoERoutingTableSubHeaderV01XXSize := CalcFSoERoutingTableSubHeaderV01XXSize(VersionMinor:=VersionMinor);

  // Calculate Size of the Table
  if VersionMinor = 0x00 then
    FSoERoutingTableSize := sizeof(t_SafetyTableHeader)
                          + FSoERoutingTableSubHeaderV01XXSize
                          + NoTabLines * sizeof(t_FSoETableLine_V0100);
  else
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
    // Not supported, should be impossible because IsTabVersionSupported() must be checked first
    HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::CreateFSoERoutingTable_v01XX) Method called with not supported Versionminor %V2", p0:=#VersionMinor);
#endif
    return;
  end_if;

  pFSoERoutingTable$pVoid := sigclib_malloc(size:=FSoERoutingTableSize);

  if (pFSoERoutingTable = NIL) then
    // Do Log and Error Handling in caller
    return;
  end_if;

  // ************************************************************************************
  // Fill Header
  pFSoERoutingTable^.Size         := FSoERoutingTableSize;
  pFSoERoutingTable^.VersionMajor := 0x01;
  pFSoERoutingTable^.VersionMinor := VersionMinor;
  pFSoERoutingTable^.TableType    := FSOEROUTINGTABLE;
  pFSoERoutingTable^.Handle       := CreateTabHandle();
  pFSoERoutingTable^.ValidMark    := 0;

  // ************************************************************************************
  // Fill Subheader
  pFSoERoutingTableSubHeader := pFSoERoutingTable + sizeof(t_SafetyTableHeader);
  FillSubheaderFSoERoutingTableSubHeaderV01XX(VersionMinor:=VersionMinor, pFSoERoutingTableSubHeader:=pFSoERoutingTableSubHeader);

