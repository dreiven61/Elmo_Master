FUNCTION VIRTUAL SafetyRoutingTables::CreateTabHandle
	VAR_OUTPUT
		TabHandle 	: UDINT;
	END_VAR

  // Returns a new unique Tabhandle value.
  // Does not use pointer to Table as handle, pointer may change due to realloc.
  while (HandleDefault = 0) do
    HandleDefault := OS_GETMICROSEC();
  end_while;

  TabHandle := HandleDefault + NoHandles;
  NoHandles +=1;

  if TabHandle = 0 then // Possible because of UDINT overflow
    TabHandle := HandleDefault + NoHandles;
    NoHandles +=1;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::DeleteTable
	VAR_INPUT
		TabHandle 	: HDINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTable	: ^t_SafetyTableHeader;
    tabidx : DINT;
  END_VAR

  // Frees the memory of the passed table and removes the table from the list.
  if TabHandle = 0 then
    sdRetCode := CMD_SM_TABRETC_PARA_HANDLE;
    return;
  end_if;

  pSafetyTable := GetSafetyTable(TabHandle:=TabHandle, #tabidx);

  sdRetCode := CMD_SM_TABRETC_PARA_HANDLE_NOTFOUND;
  if pSafetyTable then

    sdRetCode := CMD_SM_TABRETC_MARK_TABLE_FINALISE_FAILED;

    pSafetyTable^.ValidMark := -1; // Mark Table as invalid.

    case pSafetyTable^.VersionMajor of

      1:  sdRetCode := DeleteTableV01XX(pSafetyTable:=pSafetyTable);

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
    else
      // Not supported, should be impossible because IsTabVersionSuported() must be checked first
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::DeleteTable) Method called with not supported VersionMajor %V2", p0:=#pSafetyTable^.VersionMajor);
#endif

    end_case;

    if sdRetCode = CMD_SM_TABRETC_OK then
      // Free complete table in one go
      TableList.NoTab -= 1;
      TableList.TabList[tabidx] := NIL;
      sigclib_Free(ptr:=pSafetyTable);
    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::DeleteTableV01XX
	VAR_INPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTableSubHeader : ^t_SafetyTableSubHeaderV01XX;
    pSafety1stEntry       : ^pVoid;
  END_VAR

  // Frees the memory of the passed table, that is not covered by t_SafetyTableHeader^.size
  // (= Pointer in the table that point to other memory areas)

  sdRetCode := CMD_SM_TABRETC_OK;

  pSafetyTableSubHeader := pSafetyTable + sizeof(t_SafetyTableHeader);

  if pSafetyTableSubHeader^.NoTabEntries then

    pSafety1stEntry := pSafetyTableSubHeader + pSafetyTableSubHeader^.Size;

    case pSafetyTable^.VersionMinor of

      0:
          if pSafetyTable^.TableType = FSOEROUTINGTABLE then
            sdRetCode := DeleteRoutingTableContentV0100(pFSoERouting1stEntry := pSafety1stEntry$^t_FSoETableLine_V0100
                                                      , NoTabEntries         := pSafetyTableSubHeader^.NoTabEntries);
          elsif pSafetyTable^.TableType = SCPTABLE then
            sdRetCode := DeleteSCPTableContentV0100(pSCP1stEntry := pSafety1stEntry$^t_SCPTableLine_V0100
                                                  , NoTabEntries := pSafetyTableSubHeader^.NoTabEntries);
          else
            sdRetCode := CMD_SM_TABRETC_PARA_TYPE;
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
            // Should be impossible, TableType is set when creating the table
            HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::DeleteTableV01XX) Invalid Tableype: %V4", p0:=#pSafetyTable^.TableType);
  #endif
          end_if;

    else
      sdRetCode := CMD_SM_TABRETC_PARA_VERSION;
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
      // Not supported, should be impossible because IsTabVersionSuported() must be checked first
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::DeleteTableV01XX) Method called with not supported VersionMinor %V2", p0:=#pSafetyTable^.VersionMinor);
#endif

    end_case;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::DeleteRoutingTableContentV0100
	VAR_INPUT
		pFSoERouting1stEntry 	: ^t_FSoETableLine_V0100;
    NoTabEntries : UDINT;
  END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pFSoERoutingEntry 	: ^t_FSoETableLine_V0100;
    idx : UDINT;
  END_VAR

  // Frees the memory of the passed table, that is not covered by t_SafetyTableHeader^.size
  // (= Pointer to HW-Paths)

  sdRetCode := CMD_SM_TABRETC_OK;

  pFSoERoutingEntry := pFSoERouting1stEntry;

  for idx := 1 to NoTabEntries do

    if (pFSoERoutingEntry^.SrcHWPath) then
      sigclib_Free(ptr:=pFSoERoutingEntry^.SrcHWPath);
      pFSoERoutingEntry^.SrcHWPath := NIL;
    end_if;
    if pFSoERoutingEntry^.DstHWPath then
      sigclib_Free(ptr:=pFSoERoutingEntry^.DstHWPath);
      pFSoERoutingEntry^.DstHWPath := NIL;
    end_if;

    pFSoERoutingEntry += sizeof(t_FSoETableLine_V0100);

  end_for;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::DeleteSCPTableContentV0100
	VAR_INPUT
		pSCP1stEntry 	: ^t_SCPTableLine_V0100;
		NoTabEntries 	: UDINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSCPEntry 	: ^t_SCPTableLine_V0100;
    idx : UDINT;
  END_VAR

  // Frees the memory of the passed table, that is not covered by t_SafetyTableHeader^.size
  // (= Pointer to HW-Paths)

  sdRetCode := CMD_SM_TABRETC_OK;

  pSCPEntry := pSCP1stEntry;

  for idx := 1 to NoTabEntries do

    if (pSCPEntry^.HWPath) then
      sigclib_Free(ptr:=pSCPEntry^.HWPath);
      pSCPEntry^.HWPath := NIL;
    end_if;

    pSCPEntry += sizeof(t_SCPTableLine_V0100);

  end_for;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::CheckAddTabLineToSafetyTable
	VAR_INPUT
		TabHandle 	: HDINT;
		VersionMajor 	: HINT;
		VersionMinor 	: HINT;
    TableType 	: t_SafetyTableType;
		pTabLine 	: pVoid;
		SizeTabLine 	: UDINT;
		bdEntriesValid 	: BDINT;
		bFinaliseTable 	: BOOL;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTable	: ^t_SafetyTableHeader;
    tabidx : DINT;
  END_VAR

  // Adds the passed table line to the table corresponding to TabHandle.
  // VersionMajor, VersionMinor, SizeTabLine must match the selected Table.
  // Entries in the table must be marked as valid in bdEntriesValid, if not that passed entry is ignored and the entry in the table is set to invalid.
  // If bFinaliseTable is set, the table will be locked, and no further lines can be added.

  pSafetyTable := NIL;

  if TabHandle = 0 then
    sdRetCode := CMD_SM_TABRETC_PARA_HANDLE;
    return;
  end_if;

  pSafetyTable := GetSafetyTable(TabHandle:=TabHandle, #tabidx);

  sdRetCode := CMD_SM_TABRETC_PARA_HANDLE_NOTFOUND;
  if pSafetyTable then

    sdRetCode := CMD_SM_TABRETC_PARA_PTABLINE;
    if pTabLine then

      sdRetCode := CMD_SM_TABRETC_PARA_VERSION;
      if (VersionMajor = pSafetyTable^.VersionMajor) &  (VersionMinor = pSafetyTable^.VersionMinor) & (TableType = pSafetyTable^.TableType) then

        sdRetCode := CMD_SM_TABRETC_TABLE_NOT_MARKED_NEWLINE;

        if pSafetyTable^.ValidMark = 0 then

          sdRetCode := CMD_SM_TABRETC_PARA_SIZETABLINE;
          if GetTabLineSize(VersionMajor,VersionMinor,pSafetyTable^.TableType) = SizeTabLine then

            // Store return pointer, AddTabLineToFSoERoutingTable may Realloc data
            TableList.TabList[tabidx] := AddTabLineToSafetyTable( pSafetyTable    := pSafetyTable
                                                                , VersionMajor    := VersionMajor
                                                                , VersionMinor    := VersionMinor
                                                                , pTabLine        := pTabLine
                                                                , SizeTabLine     := SizeTabLine
                                                                , bdEntriesValid  := bdEntriesValid
                                                                , bFinaliseTable  := bFinaliseTable);

            sdRetCode := CMD_SM_TABRETC_ADD_TABLELINE_FAILED;
            if TableList.TabList[tabidx] then
              sdRetCode := CMD_SM_TABRETC_OK;
            end_if;

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
          else
            HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToFSoERoutingTable) SizeTabLine %V4 invalid ", #SizeTabLine);
#endif
          end_if;

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
        else
          HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToFSoERoutingTable) Tables may not be edited");
#endif
        end_if;
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
      else
        HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToFSoERoutingTable) Versions do not Match");
#endif
      end_if;
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
    else
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToFSoERoutingTable) Method called with invalid pTabLine");
#endif
    end_if;
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
  else
    HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToFSoERoutingTable) Method called with invalid pSafetyTable");
#endif
  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::AddTabLineToSafetyTable
	VAR_INPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
		VersionMajor 	: HINT;
		VersionMinor 	: HINT;
		pTabLine 	: pVoid;
		SizeTabLine 	: UDINT;
		bdEntriesValid 	: BDINT;
		bFinaliseTable 	: BOOL;
	END_VAR
	VAR_OUTPUT
		pSafetyTableRet 	: ^t_SafetyTableHeader;
	END_VAR

  // Adds the passed table line to the table corresponding to TabHandle.
  // Entries in the table must be marked as valid in bdEntriesValid, if not that passed entry is ignored and the entry in the table is set to invalid.
  // If bFinaliseTable is set, the table will be locked, and no further lines can be added.

  pSafetyTableRet := NIL;

  case VersionMajor of

    1:

      pSafetyTableRet := AddTabLineToSafetyTableV01XX(pSafetyTable    := pSafetyTable
                                                    , pTabLine        := pTabLine
                                                    , SizeTabLine     := SizeTabLine
                                                    , bdEntriesValid  := bdEntriesValid);

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
    else
      // Not supported, should be impossible because IsTabVersionSuported() must be checked first
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToSafetyTable) Method called with not supported VersionMajor %V2", p0:=#pSafetyTable^.VersionMajor);
#endif
  end_case;

  if bFinaliseTable & pSafetyTableRet then
    pSafetyTableRet^.ValidMark := 1;
  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::AddTabLineToSafetyTableV01XX
	VAR_INPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
		pTabLine 	: pVoid;
		SizeTabLine 	: UDINT;
		bdEntriesValid 	: BDINT;
	END_VAR
	VAR_OUTPUT
		pSafetyTableRet 	: ^t_SafetyTableHeader;
	END_VAR
  VAR
	Offset            : UDINT;
    NewSize           : UDINT;
	pSafetyTableSubHeader : ^t_SafetyTableSubHeaderV01XX;
	pSafetyTableEntryInfo : ^t_SafetyTableEntryInfoV01XX;
    OffsetNewLine     : UDINT;
    idxEntryInfo      : UDINT;
    cpyFct            : e_CompareFct;
    pTab              : pVoid;
    MemHWPath         : UDINT;
  END_VAR

  // Adds the passed table line to the table corresponding to TabHandle.
  // Entries in the table must be marked as valid in bdEntriesValid, if not that passed entry is ignored and the entry in the table is set to invalid.

  pSafetyTableRet := NIL;

  Offset := sizeof(t_SafetyTableHeader);
  pSafetyTableSubHeader := pSafetyTable + Offset;

  // Calc the offset to the end of to current table to insert the new line at this position
  OffsetNewLine := Offset + (pSafetyTableSubHeader^.Size + (pSafetyTableSubHeader^.NoTabEntries * pSafetyTableSubHeader^.SizeTableLine));

  if pSafetyTable^.Size <= OffsetNewLine  + SizeTabLine then
    // Realloc Table
    NewSize := pSafetyTable^.Size + SizeTabLine;
    pSafetyTable$pVoid := sigclib_ReAlloc(ptr:=pSafetyTable, size:=NewSize);

    if pSafetyTable = NIL then
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToSafetyTableV01XX) Failed to ReAlloc memory for Table");
#endif
      return;
    end_if;

    pSafetyTable^.Size := NewSize;

    // Recalculate because of ReAlloc
    pSafetyTableSubHeader := pSafetyTable + Offset;
  end_if;

  // Add the line to the end of the Table
  pSafetyTableEntryInfo := pSafetyTableSubHeader + sizeof(t_SafetyTableSubHeaderV01XX);
  pTab := pSafetyTable + OffsetNewLine;

  for idxEntryInfo := 1 to pSafetyTableSubHeader^.NoTabEntryInfo do

    cpyFct := GetEntryCompareFctV01XX(EntryId:=pSafetyTableEntryInfo^.ID, pSafetyTable^.TableType);

    case cpyFct of

      // *********************************************
	e_CompareFct::Byte4:

        if (bdEntriesValid AND 1) then
          pTab^$DINT := pTabLine^$DINT;
        else
          pTab^$DINT := pSafetyTableEntryInfo^.InvalidVal;
        end_if;

        pTab     += sizeof(HDINT);
        pTabLine += sizeof(HDINT);

      // *********************************************
	e_CompareFct::Byte8:

        if (bdEntriesValid AND 1) then
          sigclib_memcpy(dst0:=pTab, src0:=pTabLine, len0:=8);
        else
          sigclib_memset(dst:=pTab, c:=pSafetyTableEntryInfo^.InvalidVal$USINT, len:=8);
        end_if;

        pTab     += 8;
        pTabLine += 8;

      // *********************************************
	e_CompareFct::HWPath:

        if (bdEntriesValid AND 1) & (pTabLine^$^Char)then
          // Alloc mem for hwPfad, then copy it
          MemHWPath := pTabLine^$^Char^ + 2; // +2 For Len info
          pTab^$pVoid := sigclib_Malloc(size:=MemHWPath);
          if pTab^$pVoid <> NIL then
            sigclib_memcpy(dst0:=pTab^$^Char, src0:=pTabLine^$^Char, len0:=MemHWPath);
          end_if;

        else
          pTab^$DINT := pSafetyTableEntryInfo^.InvalidVal;
        end_if;

        pTab     += sizeof(pVoid);
        pTabLine += sizeof(pVoid);

      // *********************************************
	e_CompareFct::NotSupported:
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
        HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::AddTabLineToSafetyTableV01XX) Unsupported Copy Fct.");
#endif
        return;

    end_case;

    bdEntriesValid := bdEntriesValid shr 1;
    pSafetyTableEntryInfo += sizeof(t_SafetyTableEntryInfoV01XX);

  end_for;

  // Increment no of Tabentries
  pSafetyTableSubHeader^.NoTabEntries += 1;

  pSafetyTableRet := pSafetyTable;  // Return Table, may be different because of realloc

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetTabLineSize
	VAR_INPUT
		VersionMajor 	: HINT;
		VersionMinor 	: HINT;
		TableType 	: t_SafetyTableType;
	END_VAR
	VAR_OUTPUT
		SizeTabLine 	: UDINT;
	END_VAR

  // Returns the size of a table line depending on the passed version.

  SizeTabLine := 0;

  case VersionMajor of

  1:
    case VersionMinor of

    0:
        if TableType = FSOEROUTINGTABLE then
          SizeTabLine := sizeof(t_FSoETableLine_V0100);
        elsif TableType = SCPTABLE then
          SizeTabLine := sizeof(t_SCPTableLine_V0100);
        end_if;

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
    else
      // Not supported, should be impossible because IsTabVersionSuported() must be checked first
      HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::GetTabLineSize) Method called with not supported VersionMinor %V2", p0:=#VersionMinor);
#endif
    end_case;

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
  else
    // Not supported, should be impossible because IsTabVersionSuported() must be checked first
    HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::GetTabLineToSize) Method called with not supported VersionMajor %V2", p0:=#VersionMajor);
#endif
  end_case;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::MarkTableFinalise
	VAR_INPUT
		TabHandle 	: HDINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTable	: ^t_SafetyTableHeader;
  END_VAR

  if TabHandle = 0 then
    sdRetCode := CMD_SM_TABRETC_PARA_HANDLE;
    return;
  end_if;

  // Marks the passed table as finalized.
  // Further calls of CheckAddTabLineToSafetyTable are blocked.
  // GetFSoESafetyRoutingTabEntry and GetFSoESafetyRoutingTabLine may now be used.

  pSafetyTable := GetSafetyTable(TabHandle:=TabHandle);

  sdRetCode := CMD_SM_TABRETC_PARA_HANDLE_NOTFOUND;
  if pSafetyTable then

    sdRetCode := CMD_SM_TABRETC_MARK_TABLE_FINALISE_FAILED;

    if pSafetyTable^.ValidMark = 0 then
      pSafetyTable^.ValidMark := 1;
      sdRetCode := CMD_SM_TABRETC_OK;
    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTabLine
	VAR_INPUT
		TabHandle 	: HDINT;
		EntryId 	: UDINT;
		pEntryValSearch 	: pVoid;
		idxTabLineStart 	: UDINT;
		pVersionMajor 	: ^HINT;
		pVersionMinor 	: ^HINT;
    TableType 	: t_SafetyTableType;
		ppTabLine 	: ^pVoid;
		pidxTabLineFound 	: ^DINT;
		pHandleTabFound 	: ^HDINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTable 	: ^t_SafetyTableHeader;
  END_VAR

  // Searches all the routing Tables for the passed Entry ID and Value and returns a pointer to the line found.
  // TabHandle        : Handle to select the Table to start the search, 0 = Search from 1st Table
  // EntryId          : EntryId to search for
  // pEntryValSearch  : Pointer to Value to search for
  // idxTabLineStart  : Table Line from which to start the search


  // pVersionMajor    : Table VersionMajor
  // pVersionMinor    : Table VersionMinor
  // ppTabLine        : Pointer to Table Line, Structure is defined by VersionMajor and VersionMinor
  // pidxTabLineFound : Index of Table Line that was found, < 0 if not found
  // pHandleTabFound  : Handle of the Table in which the Entry was found, 0 not found

  // sdRetCode    :   : returncode, see SafetyManager.h CMD_SM_RTABRETC_...

  if pEntryValSearch = NIL then
    sdRetCode := CMD_SM_TABRETC_PARA_PENTRYVALSEARCH;
    return;
  end_if;

  sdRetCode := CMD_SM_TABRETC_PARA_HANDLE_NOTFOUND;
  if pHandleTabFound then
    pHandleTabFound^ := 0;  // Set default return value to not found
  end_if;

  pSafetyTable := GetSafetyTable(TabHandle:=TabHandle);

  if pSafetyTable = NIL then
    pSafetyTable := GetSafetyTableNext(TabHandle:=TabHandle);
  end_if;

  while pSafetyTable do

    // Skip Tabletypes that do not match
    if pSafetyTable^.TableType = TableType then

      sdRetCode := CMD_SM_TABRETC_TABLE_NOT_MARKED_GETLINE;
      if pSafetyTable^.ValidMark = 1 then

        case pSafetyTable^.VersionMajor of

          1:
            if pVersionMajor then
              pVersionMajor^ := pSafetyTable^.VersionMajor;
            end_if;
            if pVersionMinor then
              pVersionMinor^ := pSafetyTable^.VersionMinor;
            end_if;

            sdRetCode := GetSafetyTabLineV01XX( pSafetyTable      := pSafetyTable
                                              , EntryId           := EntryId
                                              , pEntryValSearch   := pEntryValSearch
                                              , idxTabLineStart   := idxTabLineStart
                                              , ppTabLine         := ppTabLine
                                              , pidxTabLineFound  := pidxTabLineFound);


  #ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
          else
            // Not supported, should be impossible because IsTabVersionSuported() must be checked first
            HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::GetSafetyTabLine) Method called with not supported VersionMajor %V2", p0:=#pSafetyTable^.VersionMajor);
  #endif
        end_case;

      end_if;

      if sdRetCode = CMD_SM_TABRETC_OK then
        // Found ok
        // Return Handle
        if pHandleTabFound then
          pHandleTabFound^ := pSafetyTable^.Handle;
        end_if;

        exit;

      end_if;

    end_if;

    // Search in next Table
    pSafetyTable := GetSafetyTableNext(TabHandle:=pSafetyTable^.Handle);
    // Search from the start of next Table
    idxTabLineStart := 0;

  end_while;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTabLineV01XX
	VAR_INPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
		EntryId 	: UDINT;
		pEntryValSearch 	: pVoid;
		idxTabLineStart 	: UDINT;
		ppTabLine 	: ^pVoid;
		pidxTabLineFound 	: ^DINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
    idxsearch : UDINT;
    pSafetyTableSubHeader : ^t_SafetyTableSubHeaderV01XX;
    pEntrySearch : pVoid;
    SizeTableLine : UDINT;
    pEntryInfo 	: ^t_SafetyTableEntryInfoV01XX;
    eCompareFct 	: e_CompareFct;
    bFoundIt : BOOL;
    pHWPath  : pVoid;
    HWPathLen : UINT;
  END_VAR

  // Searches the Table for the passed Entry ID and Value and returns a pointer to the line found.
  // pSafetyTable     : Table
  // EntryId          : EntryId to search for
  // pEntryValSearch  : Pointer to Value to search for
  // idxTabLineStart  : Table Line from which to start the search

  // ppTabLine        : Pointer to Table Line, Structure is defined by VersionMajor and VersionMinor
  // pidxTabLineFound : Index of Table Line that was found, < 0 if not found

  // sdRetCode    :   : returncode, see SafetyManager.h CMD_SM_RTABRETC_...

  pSafetyTableSubHeader := pSafetyTable + sizeof(t_SafetyTableHeader);

  pEntryInfo  := GetEntryInfoV01XX(EntryId:=EntryId, pSafetyTableSubHeader:=pSafetyTableSubHeader);
  eCompareFct := GetEntryCompareFctV01XX(EntryId:=EntryId, pSafetyTable^.TableType);

  bFoundIt := FALSE;
  if idxTabLineStart < pSafetyTableSubHeader^.NoTabEntries then

    SizeTableLine := pSafetyTableSubHeader^.SizeTableLine;
    pEntrySearch := pSafetyTableSubHeader + pSafetyTableSubHeader^.Size;  // Points to first line of table = idx 0
    pEntrySearch += idxTabLineStart * SizeTableLine;  // Points to idxTabLineStart line of table

    case eCompareFct of

      // *********************************************
      e_CompareFct::Byte4:

        for idxsearch := idxTabLineStart to (pSafetyTableSubHeader^.NoTabEntries - 1) do

          if (pEntrySearch + pEntryInfo^.Offset)$^DINT^ = pEntryValSearch$^DINT^ then // Use $^DINT^ because comparing a void, compares 1 Byte
            // Found it
            bFoundIt := TRUE;
            exit;
          end_if;

          pEntrySearch += SizeTableLine;

        end_for;

      // *********************************************
      e_CompareFct::Byte8:

        for idxsearch := idxTabLineStart to (pSafetyTableSubHeader^.NoTabEntries - 1) do

          if sigclib_memcmp(m1:=pEntrySearch + pEntryInfo^.Offset, m2:=pEntryValSearch, len:=8) = 0 then
            // Found it
            bFoundIt := TRUE;
            exit;
          end_if;

          pEntrySearch += SizeTableLine;

        end_for;

      // *********************************************
      e_CompareFct::HWPath:

        for idxsearch := idxTabLineStart to (pSafetyTableSubHeader^.NoTabEntries - 1) do

          // Check length of HW-Path
          pHWPath := (pEntrySearch + pEntryInfo^.Offset);
          if pHWPath^$^UINT <> NIL then
            if (pHWPath^$^UINT^ = pEntryValSearch^$UINT) then

              HWPathLen := (pHWPath)^$^UINT^ + 2;
              // Check HW-Path
              if sigclib_memcmp(m1:=(pHWPath)^$pVoid , m2:=pEntryValSearch$pVoid, len:=to_udint(HWPathLen)) = 0 then

                // Found it
                bFoundIt := TRUE;
                exit;

              end_if;
            end_if;
          end_if;

          pEntrySearch += SizeTableLine;

        end_for;

      // *********************************************
      e_CompareFct::NotSupported:

    end_case;
  end_if;

  if bFoundIt then

    sdRetCode := CMD_SM_TABRETC_OK;

    if ppTabLine then
      ppTabLine^ := pEntrySearch;
    end_if;

    if pidxTabLineFound then
      pidxTabLineFound^ := idxsearch$DINT;
    end_if;

  else

    sdRetCode := CMD_SM_TABRETC_ENTRYID_NOT_FOUND;

    if ppTabLine then
      ppTabLine^ := NIL;
    end_if;

    if pidxTabLineFound then
      pidxTabLineFound^ := -1;
    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTabEntry
	VAR_INPUT
		TabHandle 	: HDINT;
		EntryId 	: UDINT;
		pEntryValSearch 	: pVoid;
		idxTabLineStart 	: UDINT;
		ResultEntryId 	: UDINT;
		ppEntryValFound 	: ^pVoid;
		pidxTabLineFound 	: ^DINT;
		pHandleTabFound 	: ^HDINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
	pSafetyTable 	: ^t_SafetyTableHeader;
  END_VAR

  // Searches all the routing Tables for the passed Entry ID and Value and returns a pointer to the value of ResultEntryId.
  // TabHandle        : routing Table
  // EntryId          : EntryId to search for
  // pEntryValSearch  : Pointer to Value to search for
  // idxTabLineStart  : Table Line from which to start the search
  // ResultEntryId    : EntryId to return

  // pEntryValFound   : Pointer to entry data
  // pidxTabLineFound : Index of Table Line that was found, < 0 if not found
  // pHandleTabFound  : Handle of the Table in which the Entry was found, 0 not found

  // sdRetCode    :   : returncode, see SafetyManager.h CMD_SM_RTABRETC_...

  if pEntryValSearch = NIL then
    sdRetCode := CMD_SM_TABRETC_PARA_PENTRYVALSEARCH;
    return;
  end_if;

  sdRetCode := CMD_SM_TABRETC_PARA_HANDLE_NOTFOUND;
  if pHandleTabFound then
    pHandleTabFound^ := 0;  // Set default return value to not found
  end_if;

  pSafetyTable := GetSafetyTable(TabHandle:=TabHandle);

  if pSafetyTable = NIL then
    pSafetyTable := GetSafetyTableNext(TabHandle:=TabHandle);
  end_if;

  while pSafetyTable do

    sdRetCode := CMD_SM_TABRETC_TABLE_NOT_MARKED_GETLINE;
    if pSafetyTable^.ValidMark = 1 then

      case pSafetyTable^.VersionMajor of

      1:
        sdRetCode := GetSafetyTabEntryV01XX(pSafetyTable      := pSafetyTable
                                          , EntryId           := EntryId
                                          , pEntryValSearch   := pEntryValSearch
                                          , idxTabLineStart   := idxTabLineStart
                                          , ResultEntryId     := ResultEntryId
                                          , ppEntryValFound   := ppEntryValFound
                                          , pidxTabLineFound  := pidxTabLineFound
                                          );

#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
      else
        // Not supported, should be impossible because IsTabVersionSuported() must be checked first
        HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::GetSafetyTabEntry) Method called with not supported VersionMajor %V2", p0:=#pSafetyTable^.VersionMajor);
#endif
      end_case;
    end_if;

    if sdRetCode = CMD_SM_TABRETC_OK then
      // Found ok
      // Return Handle
      if pHandleTabFound then
        pHandleTabFound^ := pSafetyTable^.Handle;
      end_if;

      exit;

    end_if;

    // Search in next Table
    pSafetyTable := GetSafetyTableNext(TabHandle:=pSafetyTable^.Handle);
    // Search from the start of next Table
    idxTabLineStart := 0;

  end_while;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetSafetyTabEntryV01XX
	VAR_INPUT
		pSafetyTable 	: ^t_SafetyTableHeader;
		EntryId 	: UDINT;
		pEntryValSearch 	: pVoid;
		idxTabLineStart 	: UDINT;
		ResultEntryId 	: UDINT;
		ppEntryValFound 	: ^pVoid;
		pidxTabLineFound 	: ^DINT;
	END_VAR
	VAR_OUTPUT
		sdRetCode 	: DINT;
	END_VAR
  VAR
    pTabLine : pVoid;
    pSafetyTableSubHeader : ^t_SafetyTableSubHeaderV01XX;
    pEntryInfo 	: ^t_SafetyTableEntryInfoV01XX;
  END_VAR

  // Searches the Table for the passed Entry ID and Value and returns a pointer to the value of ResultEntryId.
  // pSafetyTable     : Table
  // EntryId          : EntryId to search for
  // pEntryValSearch  : Pointer to Value to search for
  // idxTabLineStart  : Table Line from which to start the search
  // ResultEntryId    : EntryId to return

  // pEntryValFound   : Pointer to entry data
  // pidxTabLineFound : Index of Table Line that was found, < 0 if not found
  // pHandleTabFound  : Handle of the Table in which the Entry was found, 0 not found

  // sdRetCode    :   : returncode, see SafetyManager.h CMD_SM_RTABRETC_...

  sdRetCode := GetSafetyTabLineV01XX( pSafetyTable      := pSafetyTable
                                    , EntryId           := EntryId
                                    , pEntryValSearch   := pEntryValSearch
                                    , idxTabLineStart   := idxTabLineStart
                                    , ppTabLine         := #pTabLine
                                    , pidxTabLineFound  := pidxTabLineFound);

  if sdRetCode = CMD_SM_TABRETC_OK then

    pSafetyTableSubHeader := pSafetyTable + sizeof(t_SafetyTableHeader);
    pEntryInfo            := GetEntryInfoV01XX(EntryId:=ResultEntryId, pSafetyTableSubHeader:=pSafetyTableSubHeader);

    sdRetCode := CMD_SM_TABRETC_RETENTRYID_NOT_FOUND;
    if pEntryInfo then
      sdRetCode       := CMD_SM_TABRETC_OK;
      ppEntryValFound^ := (pTabLine + pEntryInfo^.Offset)$pVoid;
    end_if;

  end_if;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetEntryInfoV01XX
	VAR_INPUT
		EntryId 	: UDINT;
		pSafetyTableSubHeader 	: ^t_SafetyTableSubHeaderV01XX;
	END_VAR
	VAR_OUTPUT
		pEntryInfo 	: ^t_SafetyTableEntryInfoV01XX;
	END_VAR
  VAR
	idxsearch : UDINT;
  END_VAR

  // Returns the EntryInfo of the passed EntryId
  // EntryInfo is part of the sub header

  pEntryInfo := pSafetyTableSubHeader + sizeof(t_SafetyTableSubHeaderV01XX);

  for idxsearch := 1 to pSafetyTableSubHeader^.NoTabEntryInfo do

    if pEntryInfo^.ID = EntryId then
      // Found it
      return;
    end_if;

    pEntryInfo += sizeof(t_SafetyTableEntryInfoV01XX);
  end_for;

  // Did not find
  pEntryInfo := NIL;

END_FUNCTION

FUNCTION VIRTUAL SafetyRoutingTables::GetEntryCompareFctV01XX
	VAR_INPUT
		EntryId 	: UDINT;
		TableType 	: t_SafetyTableType;
	END_VAR
	VAR_OUTPUT
		eCompareFct 	: e_CompareFct;
	END_VAR

  // Returns the copy/compare function of the passed EntryId
  eCompareFct := NotSupported;

  if TableType = FSOEROUTINGTABLE then

    case EntryId$t_FSoERoutingTableEntryIDsV01XX of

      FSoERoutingTable_EntryID_ConnectionID:  eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_SrcHWPath:     eCompareFct := e_CompareFct::HWPath;
      FSoERoutingTable_EntryID_SrcHWPathComp: eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_SrcCOEIndex:   eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_DstHWPath:     eCompareFct := e_CompareFct::HWPath;
      FSoERoutingTable_EntryID_DstHWPathComp: eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_DstCOEIndex:   eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_FrameSize:     eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_SlavAdd:       eCompareFct := e_CompareFct::Byte4;
      FSoERoutingTable_EntryID_Flags:         eCompareFct := e_CompareFct::Byte4;

    end_case;

  elsif TableType = SCPTABLE then

    case EntryId$t_SCPTableEntryIDV01XX of

      SCPTable_EntryID_HWPath:      eCompareFct := e_CompareFct::HWPath;
      SCPTable_EntryID_HWPathCRC:   eCompareFct := e_CompareFct::Byte4;
      SCPTable_EntryID_SCP_CRC:     eCompareFct := e_CompareFct::Byte4;
      SCPTable_EntryID_HW_SCP_CRC:  eCompareFct := e_CompareFct::Byte4;
      SCPTable_EntryID_APPL_CRC:    eCompareFct := e_CompareFct::Byte4;

    end_case;

  end_if;

END_FUNCTION
