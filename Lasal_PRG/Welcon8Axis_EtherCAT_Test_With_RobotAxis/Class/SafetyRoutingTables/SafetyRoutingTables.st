FUNCTION VIRTUAL SafetyRoutingTables::CreateFSoERoutingTable
	VAR_INPUT
		VersionMajor 	: HINT;
		VersionMinor 	: HINT;
		NoTabLines 	: UDINT;
	END_VAR
	VAR_OUTPUT
		TabHandle 	: HDINT;
	END_VAR
  VAR
    pFSoERoutingTable 	: ^t_SafetyTableHeader;
	tabidx : DINT;
  END_VAR

  // Creates a new routing table of the passed Version.
  // The header(s) of the table are filled.
  // if NoTabLines <> 0, the memory for those lines allocated but the content of the lines is not filled. (See CheckAddTabLineToFSoERoutingTable)

  pFSoERoutingTable := NIL;
  TabHandle := 0;

  if TableList.NoTab <= SRT_MAXIDX then

    if IsTabVersionSupported(VersionMajor:=VersionMajor, VersionMinor:=VersionMinor, TableType:=FSOEROUTINGTABLE) then

      if VersionMajor = 0x01 then
        pFSoERoutingTable := CreateFSoERoutingTable_v01XX(VersionMinor:=VersionMinor, NoTabLines:=NoTabLines);
#ifdef SAFETY_DEBUG_LOGGING_ACTIVATED
      else
        // Not supported, should be impossible because IsTabVersionSuported() must be checked first
        HWC_LogPrintf(pThis:=this, format:="@DBG (SafetyRoutingTables::CreatFSoERoutingTable) Method called with not supported VersionMajor %V2", p0:=#VersionMajor);
#endif
      end_if;

      if pFSoERoutingTable then

        for tabidx := 0 to SRT_MAXIDX do

          if (TableList.TabList[tabidx] = NIL) then
            TableList.TabList[tabidx] := pFSoERoutingTable;
            TabHandle := pFSoERoutingTable^.Handle;
            TableList.NoTab += 1;
            exit;
          end_if;

        end_for;

      end_if;

    end_if;
  end_if;

END_FUNCTION

