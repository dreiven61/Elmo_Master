      pFSoERoutingTableEntryInfo^.InvalidVal  := FSoERoutingTable_EntryIDInvalid_DstCOEIndex;
      pFSoERoutingTableEntryInfo^.Offset      := t_FSoETableLine_V0100.DstCOEIndex;

