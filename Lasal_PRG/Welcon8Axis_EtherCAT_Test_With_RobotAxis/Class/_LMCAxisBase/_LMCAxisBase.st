	    IPBLCExecute,  //! <Type Comment="NewInst command calling the backlash compensation method.&#13;&#10;In this method the new backlash correction value is calculated, the backlash table is interpolated and a change in the movement direction is detected.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCExecute"/>
	    IPBLCSetPointerSetPosVel,  //! <Type Comment="NewInst command setting a pointer to the &quot;SetPos&quot; and &quot;SetVel&quot; server of the _LMCAxisBase object.&#13;&#10;Used to read the position and velocity to determine the backlash correction value.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = pointer to the SetPos value&#13;&#10;CmdStruct.aPara[2] = pointer to the SetVel value&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCSetPointerSetPosVel"/>
	    IPBLCSetTimeBase,  //! <Type Comment="NewInst command setting the _LMCAxisBase object timebase.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = input time base value in µs&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCSetTimeBase"/>
	    IPBLCDetectMoveDirChange,  //! <Type Comment="NewInst command calling the DetectMoveDirChange() method.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = value of the actual set value&#13;&#10;CmdStruct.aPara[2] = backlash compensation flag variable&#13;&#10;CmdStruct.aPara[2] = old value of the set value to compare actual set value against&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCDetectMoveDirChange"/>
	    IPBLCReset,  //! <Type Comment="NewInst command calling the reset method of the class.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCReset"/>
	    IPBLMGetPointerBacklashValue:=71,  //! <Type Comment="NewInst command returning a pointer to the measured backlash value in positive and negative direction.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.aData[0] = pointer to the positive backlash value&#13;&#10;results.aData[4] = pointer to the negative backlash value&#13;&#10;results.uiLng = 6" Name="te_BLCmdClassSvr.IPBLMGetPointerBacklashValue"/>
	    IPBLMDoMeasurement,  //! <Type Comment="NewInst command calling the backlash measurement procedure method.&#13;&#10;In this method the complete measurement procedure is handled with the complete state machine.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMDoMeasurement"/>
	    IPBLMGetPointerMeasFlags,  //! <Type Comment="NewInst command returning a pointer to the Backlash Measurement flag variable.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.aData[0] = pointer to the backlash flag structure&#13;&#10;results.uiLng = 6" Name="te_BLCmdClassSvr.IPBLMGetPointerMeasFlags"/>
	    IPBLMSetTimeBase,  //! <Type Comment="NewInst command setting the _LMCAxisBase object timebase.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = input time base value in µs&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMSetTimeBase"/>
	    IPBLMSetExtIntUnits,  //! <Type Comment="NewInst command setting the external and internal units defined at the _LMCAxisBase object.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = external units value&#13;&#10;CmdStruct.aPara[2] = internal units value&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMSetExtIntUnits"/>
	    IPBLMSetPlaceAxisNo,  //! <Type Comment="NewInst command taking a pointer to the HWDiagnosisOut data to set the axis number and place of the connected DriveAxis to use _DriveScope measurement.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = pointer to the hardware diagnosis out data structure&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMSetPlaceAxisNo"/>
	    IPBLMSetCurrSign,  //! <Type Comment="NewInst command setting the sign of the current in case the current sign has to be inversed for the backlash measurement cycle.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdStruct.aPara[1] = sign of the current (0 ... + sign, 1 ... - sign (current gets inverted))&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMSetCurrSign"/>
	    IPBLMReset  //! <Type Comment="NewInst command calling the reset method of the class.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLMReset"/>
	  )$UDINT;
