	    IPBLCGetPointerBacklash:=51,  //! <Type Comment="NewInst command returning a pointer to the actual backlash correction value.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;results.aData[0] = pointer to the actual backlash correction value&#13;&#10;results.uiLng = 6" Name="te_BLCmdClassSvr.IPBLCGetPointerBacklash"/>
	    IPBLCSetBacklashAmount,  //! <Type Comment="NewInst command sets the backlash amount of the server &quot;SetBacklashAmount&quot;.&#13;&#10;Is called automatically when _LMCBacklashMeasurement class finishes the measurement procedure and the _LMCBacklashCompensation class is connected.&#13;&#10;CmdStruct.aPara[0] = protocol version used&#13;&#10;CmdSTruct.aPara[1] = set backlash amount value&#13;&#10;results.uiLng = 2" Name="te_BLCmdClassSvr.IPBLCSetBacklashAmount"/>
