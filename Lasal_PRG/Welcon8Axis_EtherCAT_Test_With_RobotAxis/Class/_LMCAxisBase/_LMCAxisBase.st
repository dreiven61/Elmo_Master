	    D_Set : DINT;  //! <Type Comment="Deceleration Setpoint in Physical Units (before Factor)" Name="_AxisAccDec.D_Set"/>
	    aTiksAcc : DINT;  //! <Type Comment="Actual acceleration [ Internal Units / Tiks ]" Name="_AxisAccDec.aTiksAcc"/>
	    aTiksDecc : DINT;  //! <Type Comment="Actual deceleration [ Internal units / Tiks ]" Name="_AxisAccDec.aTiksDecc"/>
	    aAct : DINT;  //! <Type Comment="Actual accelleration [ Internal Units / Tiks]" Name="_AxisAccDec.aAct"/>
	    AMaxInt125 : DINT;  //! <Type Comment="Maximum acceleration with 125% [ Internal Units / s^2 ]" Name="_AxisAccDec.AMaxInt125"/>
	    AccMaxTiks : DINT;  //! <Type Comment="maximum acceleration [ Internal Units / Tiks ]" Name="_AxisAccDec.AccMaxTiks"/>
	    DecMaxTiks : DINT;  //! <Type Comment="maximum deceleration [ Internal units / Tiks ]" Name="_AxisAccDec.DecMaxTiks"/>
	    aTiksdeccVk : DINT;
	    aTiksaccVk : DINT;
	    fAccelTrap : LREAL;  //! <Type Comment="actual set acceleration [int units / tick^2] (for MoveType _JERK_PROFILE only)" Name="_AxisAccDec.fAccelTrap"/>
	    fAccTiks : LREAL;  //! <Type Comment="maximal acceleration for the active command [internal units / tick^2]  (for MoveType _JERK_PROFILE only)" Name="_AxisAccDec.fAccTiks"/>
	    fDecTiks : LREAL;  //! <Type Comment="maximal deceleration for the active command [internal units / tick^2]  (for MoveType _JERK_PROFILE only)" Name="_AxisAccDec.fDecTiks"/>
	    fMasterAccel : LREAL;  //! <Type Comment="actual acceleration of the coupled master axis [internal units / tick^2]  (for MoveType _JERK_PROFILE only)&#13;&#10;" Name="_AxisAccDec.fMasterAccel"/>
	    fAllowedMasterAccel : LREAL;  //! <Type Comment="maximal allowed acceleration of a master axis, when the master lock (synchron movement) is suspended [internal units / tick^2]  (for MoveType _JERK_PROFILE only)" Name="_AxisAccDec.fAllowedMasterAccel"/>
